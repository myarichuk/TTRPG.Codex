@inherits LayoutComponentBase

<a href="#main-content" class="skip-link">Skip to main content</a>
<AppHeader />
<main id="main-content" class="page" tabindex="-1">
    @Body
</main>
@* Rendered only by the interactive circuit, never by prerendering: end-to-end tests wait for it
   before typing, so keystrokes can't land on the static prerender and be lost. *@
@if (RendererInfo.IsInteractive)
{
    <span data-interactive hidden></span>
}
