@namespace Codex.Web.Components.Layout

@* Inline Lucide icons (ISC licence, see wwwroot/lib/lucide/LICENSE). Decorative by default:
   aria-hidden unless a Label is given, in which case it becomes an accessible image. *@
<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="lucide-icon @Class"
     role="@(Label == null ? null : "img")"
     aria-label="@Label"
     aria-hidden="@(Label == null ? "true" : null)"
     focusable="false">
    @((MarkupString)(Paths.TryGetValue(IconName?.ToLowerInvariant() ?? string.Empty, out var markup) ? markup : Paths["circle"]))
</svg>

