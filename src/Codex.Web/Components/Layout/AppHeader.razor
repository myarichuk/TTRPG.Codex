@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

<header class="app-header">
    <a href="/" class="brand" aria-label="@L["Layout.Brand.Home"]">
        <span class="brand-mark" aria-hidden="true"><LucideIcon IconName="scroll" Size="18" /></span>
        <span>TTRPG.Codex</span>
    </a>

    <nav class="app-nav" aria-label="@L["Layout.Nav.Main"]">
        <AuthorizeView>
            <Authorized>
                <NavLink href="" Match="NavLinkMatch.All">
                    <LucideIcon IconName="compass" Size="18" /><span>@L["Layout.Nav.Campaigns"]</span>
                </NavLink>
                <NavLink href="library">
                    <LucideIcon IconName="book-open" Size="18" /><span>@L["Layout.Nav.Library"]</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
        <NavLink href="about">
            <LucideIcon IconName="info" Size="18" /><span>@L["Layout.Nav.About"]</span>
        </NavLink>
    </nav>

    <div class="header-spacer"></div>

    @* Wide screens show language, theme and sign-out in the header; narrow ones fold them into one menu. *@
    <div class="header-actions">
        <div class="header-wide">
            <LanguagePicker Dropdown="true" />
            <button type="button" class="icon-btn theme-toggle" @onclick="ToggleThemeAsync"
                    aria-label="@ThemeAction" title="@(theme == "dark" ? L["Layout.Theme.Parchment"] : L["Layout.Theme.Dark"])">
                @* Keyed on the theme so the icon is re-created, and its entrance animation replays, on each toggle. *@
                <LucideIcon @key="theme" IconName="@ThemeIcon" Size="18" />
            </button>
        </div>

        <AuthorizeView>
            <Authorized>
                @{
                    var username = context.User.Identity?.Name ?? L["Layout.User.Fallback"];
                }
                <a href="/settings/ai" class="user-chip" title="@L["Layout.User.AiSettings"]" aria-label="@L["Layout.User.AiSettingsLabel", username]">
                    <span class="avatar" aria-hidden="true">@Initial(username)</span>
                    <span>@username</span>
                    <LucideIcon IconName="sparkles" Size="14" Class="chip-icon" />
                </a>
                <form method="post" action="/logout" class="d-inline header-wide">
                    <AntiforgeryToken />
                    <button type="submit" class="icon-btn" aria-label="@L["Layout.SignOut"]" title="@L["Layout.SignOut"]">
                        <LucideIcon IconName="log-out" Size="18" />
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="cx-btn cx-plaque cx-sm">@L["Layout.SignIn"]</a>
            </NotAuthorized>
        </AuthorizeView>

        <details class="popover-menu header-narrow">
            <summary class="icon-btn" aria-label="@L["Layout.Menu"]"><LucideIcon IconName="menu" Size="20" /></summary>
            <div class="popover-panel menu-panel">
                <LanguagePicker />
                <button type="button" class="menu-item" @onclick="ToggleThemeAsync">
                    <LucideIcon IconName="@ThemeIcon" Size="18" /><span>@ThemeAction</span>
                </button>
                <AuthorizeView>
                    <Authorized>
                        <form method="post" action="/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="menu-item"><LucideIcon IconName="log-out" Size="18" /><span>@L["Layout.SignOut"]</span></button>
                        </form>
                    </Authorized>
                </AuthorizeView>
            </div>
        </details>
    </div>
</header>

@code {
    private string theme = "dark";

    private string ThemeIcon => theme == "dark" ? "sun" : "moon";

    private string ThemeAction => theme == "dark" ? L["Layout.Theme.ToParchment"] : L["Layout.Theme.ToDark"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                theme = await JS.InvokeAsync<string>("codex.getTheme");
                StateHasChanged();
            }
            catch (JSException)
            {
                // Prerender or JS unavailable: keep the default.
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        theme = theme == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("codex.setTheme", theme);
    }

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1];
}
