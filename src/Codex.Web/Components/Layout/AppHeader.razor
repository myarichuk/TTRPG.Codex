@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

<header class="app-header">
    <a href="/" class="brand" aria-label="TTRPG.Codex home">
        <span class="brand-mark" aria-hidden="true"><LucideIcon IconName="scroll" Size="18" /></span>
        <span>TTRPG.Codex</span>
    </a>

    <nav class="app-nav" aria-label="Main">
        <AuthorizeView>
            <Authorized>
                <NavLink href="" Match="NavLinkMatch.All">
                    <LucideIcon IconName="map" Size="18" /><span>Campaigns</span>
                </NavLink>
                <NavLink href="library">
                    <LucideIcon IconName="book-open" Size="18" /><span>Library</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
        <NavLink href="about">
            <LucideIcon IconName="info" Size="18" /><span>About &amp; licences</span>
        </NavLink>
    </nav>

    <div class="header-spacer"></div>

    <div class="header-actions">
    <button type="button" class="icon-btn theme-toggle" @onclick="ToggleThemeAsync"
            aria-label="@(theme == "dark" ? "Switch to parchment theme" : "Switch to dark theme")"
            title="@(theme == "dark" ? "Parchment theme" : "Dark theme")">
        @* Keyed on the theme so the icon is re-created, and its entrance animation replays, on each toggle. *@
        <LucideIcon @key="theme" IconName="@(theme == "dark" ? "sun" : "moon")" Size="18" />
    </button>

    <AuthorizeView>
        <Authorized>
            @{
                var username = context.User.Identity?.Name ?? "User";
            }
            <a href="/settings/ai" class="user-chip" title="AI settings" aria-label="@username: AI settings">
                <span class="avatar" aria-hidden="true">@Initial(username)</span>
                <span>@username</span>
                <LucideIcon IconName="sparkles" Size="14" Class="chip-icon" />
            </a>
            <form method="post" action="/logout" class="d-inline">
                <AntiforgeryToken />
                <button type="submit" class="icon-btn" aria-label="Sign out" title="Sign out">
                    <LucideIcon IconName="log-out" Size="18" />
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a href="/login" class="btn btn-primary btn-sm">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
    </div>
</header>

@code {
    private string theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                theme = await JS.InvokeAsync<string>("codex.getTheme");
                StateHasChanged();
            }
            catch (JSException)
            {
                // Prerender or JS unavailable: keep the default.
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        theme = theme == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("codex.setTheme", theme);
    }

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1];
}
