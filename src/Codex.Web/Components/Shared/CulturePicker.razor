@using System.Globalization
@inject NavigationManager Nav

@* Culture switcher (6.5): persists the UI language in a cookie and reloads, which starts
   a fresh Blazor circuit under the new culture. English is the fallback - pages without
   a matching .resx render their keys (English) unchanged. *@
<select class="form-select form-select-sm mt-2" value="@CultureInfo.CurrentCulture.TwoLetterISOLanguageName"
        @onchange="OnCultureChanged" data-testid="culture-picker" aria-label="Language">
    <option value="en">English</option>
    <option value="he">עברית</option>
</select>

@code {
    private void OnCultureChanged(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString() ?? "en";
        var returnUrl = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        Nav.NavigateTo($"/culture/{culture}?returnUrl={returnUrl}", forceLoad: true);
    }
}
