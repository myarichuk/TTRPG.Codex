@using Codex.Core
@using Codex.Core.Rules
@using Codex.Plugin.Abstractions

@* What the sheet's features grant (sheetRules.features): a counter per feature with limited uses, with Use / Regain and the
   rests that refill them, then a line per number or list a feature changed, each with the feature it came from. The owner
   says where a change goes, as with the slot tracker. *@

@if (Evaluation is { } evaluation && (evaluation.Counters.Count > 0 || evaluation.Spenders.Count > 0 || Lines.Count > 0))
{
    <section class="panel" aria-labelledby="@(id)-heading" data-testid="features-panel">
        <div class="panel-title"><h2 id="@(id)-heading" class="h5"><LucideIcon IconName="sparkles" Size="18" Class="title-icon" /> @L["Actor.Features.Title"]</h2></div>

        @if (evaluation.Counters.Count > 0)
        {
            <ul class="list-unstyled mb-0" data-testid="feature-counters">
                @foreach (var counter in evaluation.Counters)
                {
                    var max = counter.Max;
                    var current = Math.Clamp(YamlValues.GetInt(Sheet, counter.Key) ?? max, 0, max);
                    <li class="slot-row" data-testid="feature-counter-@counter.Key">
                        <span class="slot-level">@counter.Feature.Name</span>
                        @if (max <= 10)
                        {
                            <span class="slot-pips" aria-hidden="true">
                                @for (var i = 0; i < max; i++)
                                {
                                    <span class="slot-pip @(i < current ? "slot-pip-full" : "")"></span>
                                }
                            </span>
                        }
                        <span class="small" data-testid="feature-count-@counter.Key">@L["Actor.Slots.Count", current, max]</span>
                        @if (!ReadOnly)
                        {
                            <span class="ms-auto d-flex gap-1">
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Disabled="@(current <= 0)" data-testid="@($"feature-use-{counter.Key}")"
                                             aria-label="@L["Actor.Features.UseOther", counter.Feature.Name]" OnClick="() => OnAdjust.InvokeAsync((counter.Key, -1, counter.Feature.Name))">@L["Actor.Slots.Use"]</CodexButton>
                                @if (counter.CanRegain(IsDm))
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Disabled="@(current >= max)" data-testid="@($"feature-regain-{counter.Key}")"
                                                 aria-label="@L["Actor.Features.RegainOther", counter.Feature.Name]" OnClick="() => OnAdjust.InvokeAsync((counter.Key, 1, counter.Feature.Name))">@L["Actor.Slots.Regain"]</CodexButton>
                                }
                            </span>
                        }
                    </li>
                }
            </ul>

        }

        <FeatureSpenders Evaluation="evaluation" Definition="Definition" Value="key => YamlValues.GetInt(Sheet, key)" ReadOnly="ReadOnly" Spend="SpendAsync" TestPrefix="feature" />

        @if (evaluation.Counters.Count > 0)
        {
            @if (!ReadOnly && Rests.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var rest in Rests)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" data-testid="@($"feature-rest-{rest.Replace(' ', '-').ToLowerInvariant()}")"
                                     OnClick="() => OnRest.InvokeAsync(rest)">@SlotTracker.RestName(Definition, rest)</CodexButton>
                    }
                </div>
            }
        }

        @if (Lines.Count > 0)
        {
            <ul class="list-unstyled small mt-2 mb-0" data-testid="feature-grants">
                @foreach (var line in Lines)
                {
                    <li class="@(line.Counted ? null : "text-muted")">
                        @line.Text <span class="small-muted">· @line.Feature@(line.Counted ? string.Empty : " · " + L["Actor.Features.NotCounted"])</span>
                    </li>
                }
            </ul>
        }

        <p class="small-muted mt-2 mb-0">@L["Actor.Features.Note"]</p>
    </section>
}

@code {
    [Parameter, EditorRequired] public SheetEvaluation? Evaluation { get; set; }
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, object> Sheet { get; set; } = new Dictionary<string, object>();
    /// <summary>The system's sheet rules, for the names of its lists and skills; none for a system whose sheets are of a kind (its features
    /// come from the kind's own sources, and its names from the kind's values).</summary>
    [Parameter] public SheetRules? Rules { get; set; }

    /// <summary>The system as the reader reads it, for the names of its fields, lists and rests.</summary>
    [Parameter] public SystemDefinition? Definition { get; set; }

    /// <summary>Names an entry a feature added to a list, in the reader's language; the id when it cannot.</summary>
    [Parameter] public Func<string, string, string>? EntryName { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>(key, delta, the feature's name) for a Use or Regain.</summary>
    [Parameter] public EventCallback<(string Key, int Delta, string Label)> OnAdjust { get; set; }

    /// <summary>The viewer is the GM, who alone may regain a counter marked <c>regain: gm</c>.</summary>
    [Parameter] public bool IsDm { get; set; }

    /// <summary>Spends from a pool for a feature that spends (key, minus the amount, the log label); false when refused.</summary>
    [Parameter] public Func<(string Key, int Delta, string Label), Task<bool>>? Spend { get; set; }

    private Task<bool> SpendAsync((string Key, int Delta, string Label) change) => Spend?.Invoke(change) ?? Task.FromResult(false);

    /// <summary>The rest taken.</summary>
    [Parameter] public EventCallback<string> OnRest { get; set; }

    private readonly string id = $"features-{Guid.NewGuid():N}";

    private sealed record Line(string Text, string Feature, bool Counted);

    private List<string> Rests => Evaluation?.Counters.SelectMany(c => c.RecoversOn).Distinct(StringComparer.OrdinalIgnoreCase).ToList() ?? new List<string>();

    private List<Line> Lines
    {
        get
        {
            var lines = new List<Line>();
            if (Evaluation == null) return lines;
            foreach (var granted in Evaluation.Granted)
            {
                var rule = ModifierStacking.RuleOf(Definition?.ModifierTypes ?? new ModifierTypesDefinition(), granted.Type);
                var text = ModifierStacking.IsCeiling(rule)
                    ? L["Actor.Features.AtMost", TargetLabel(granted.Target), granted.Amount]
                    : ModifierStacking.IsFloor(rule)
                    ? L["Actor.Features.AtLeast", TargetLabel(granted.Target), granted.Amount]
                    : L["Actor.Features.Adds", TargetLabel(granted.Target), (granted.Amount >= 0 ? "+" : "") + granted.Amount];
                lines.Add(new Line(text, granted.Feature.Name, granted.Counted));
            }

            foreach (var feature in Evaluation.Features)
            {
                foreach (var add in feature.Adds)
                {
                    var reached = feature.LevelKey == null ? null : YamlValues.ToNumber(feature.View.GetValueOrDefault(feature.LevelKey));
                    if (add.Level.HasValue && !(reached >= add.Level)) continue;
                    if (add.Entries.Count == 0) continue; // a choice: listed by the sheet's choices, not here
                    var list = Rules?.Lists.FirstOrDefault(l => l.Key == add.To);
                    var names = add.Entries.Select(e => list == null ? Definition?.DisplayValue(e) ?? e : EntryName?.Invoke(list.TargetEntityType, e) ?? e);
                    lines.Add(new Line(L["Actor.Features.Adds", list?.Label ?? TargetLabel(add.To), string.Join(", ", names)], feature.Name, true));
                }
            }

            // A sheet kind's features change its values through the sheet model's own modifiers: each one that reached a value and
            // names an active feature of the kind as its source.
            if (Kind != null && Evaluation.Model != null)
            {
                var names = Evaluation.Features.Where(f => f.OnKind).Select(f => f.Name).ToHashSet(StringComparer.Ordinal);
                foreach (var (target, applied) in Evaluation.Model.Modifiers)
                {
                    foreach (var modifier in applied.Where(m => m.Source != null && names.Contains(m.Source)))
                    {
                        var rule = ModifierStacking.RuleOf(Definition?.ModifierTypes ?? new ModifierTypesDefinition(), modifier.Type);
                        var amount = SheetView.Format(modifier.Amount);
                        var text = ModifierStacking.IsCeiling(rule) ? L["Actor.Features.AtMost", TargetLabel(target), amount]
                            : ModifierStacking.IsFloor(rule) ? L["Actor.Features.AtLeast", TargetLabel(target), amount]
                            : L["Actor.Features.Adds", TargetLabel(target), (modifier.Amount >= 0 ? "+" : "") + amount];
                        lines.Add(new Line(text, modifier.Source!, modifier.Counted));
                    }
                }
            }

            return lines;
        }
    }

    private SheetKindDefinition? Kind => Definition is { SheetKinds.Count: > 0 } ? SheetLayout.KindOf(Definition, Sheet) : null;

    private string TargetLabel(string key) =>
        key == SheetRuleEngine.SavesTarget ? L["Actor.Skills.SavingThrows"].ToString()
        : key == SheetRuleEngine.SkillsTarget && !string.IsNullOrWhiteSpace(Rules?.Skills?.Label) ? Rules.Skills.Label
        : Definition?.ActorFields.FirstOrDefault(f => f.Key == key)?.Label
        ?? Rules?.Derived.FirstOrDefault(d => d.Key == key)?.Label
        ?? Definition?.Resources.FirstOrDefault(r => r.Key == key || r.MaxKey == key)?.Label
        ?? KindLabel(key)
        ?? key;

    // A sheet kind's own words: a value's label, a track's, a keyed entry's (list.entry), a group's (@pools, shown as the bare name).
    private string? KindLabel(string key)
    {
        if (Kind is not { } kind) return null;
        if (kind.Values.FirstOrDefault(v => v.Key == key) is { } value) return value.Label ?? value.Key;
        if (kind.Tracks.FirstOrDefault(t => t.Key == key) is { } track) return track.Label ?? track.Key;
        var dot = key.IndexOf('.');
        if (dot > 0 && kind.KeyedLists.FirstOrDefault(l => l.Key == key[..dot]) is { } keyed)
        {
            return keyed.Keys.FirstOrDefault(e => e.Key == key[(dot + 1)..])?.Label;
        }

        return key.StartsWith('@') ? key[1..] : null;
    }
}
