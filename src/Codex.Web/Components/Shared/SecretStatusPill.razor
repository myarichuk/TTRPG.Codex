@using Codex.Core

@* Who may read a secret block: the party, some characters (named), or the DM alone. The wiki's secrets panel and Lore both
   show it, in the same words and colours. *@
<span class="pill @Class">@Label</span>

@code {
    [Parameter, EditorRequired] public SecretBlock Block { get; set; } = null!;

    /// <summary>The names of the characters a <c>:::for</c> block is for, as this reader may see them.</summary>
    [Parameter] public string Knowers { get; set; } = string.Empty;

    private string Class => Block.Marked switch
    {
        SecretAudience.Party => "pill-success",
        SecretAudience.Some => "pill-accent",
        _ => "pill-warning"
    };

    private string Label => Block.Marked switch
    {
        SecretAudience.Party => L["Common.Secret.Party"],
        SecretAudience.Some => L["Common.Secret.Some", Knowers],
        _ => L["Common.Secret.Dm"]
    };
}
