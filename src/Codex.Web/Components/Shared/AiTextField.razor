@using Codex.Web.Services
@implements IDisposable
@inject ILogger<AiTextField> Logger

@* A description box with an "Enhance with AI" button beside its label. The AI's text replaces the
   box's text and one Undo puts the previous text back, so trying it costs nothing. While it writes, the box is
   read-only and Stop cancels the request. Nothing is saved here: the owning form saves as usual. *@

<div class="ai-field">
    <div class="ai-field-head">
        <label for="@Id" class="field-label">@(Label ?? L["Library.Ai.Description"])</label>
        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" Icon="sparkles" OnClick="EnhanceAsync" Disabled="@busy" data-testid="@($"{TestId}-ai")">
            @(busy ? L["Library.Ai.Writing"] : string.IsNullOrWhiteSpace(Value) ? L["Library.Ai.Write"] : L["Library.Ai.Enhance"])
        </CodexButton>
    </div>
    <MarkdownEditor Id="@Id" Title="@(Label ?? L["Library.Ai.Description"])" Rows="@Rows" Placeholder="@Placeholder" Value="@Value" ValueChanged="OnValueChanged"
                    DescribedBy="@($"{Id}-hint")" Mentions="@Mentions" Preview="Preview" TestId="@TestId" Class="mb-0" Secrets="Secrets"
                    Busy="busy" BusyText="@L["Library.Ai.Writing"]" OnStop="call.Stop" />
    <div class="ai-field-foot">
        <label for="@(Id)-ask" class="visually-hidden">@L["Library.Ai.AskLabel"]</label>
        <input id="@(Id)-ask" class="field-input field-sm" placeholder="@L["Library.Ai.AskPlaceholder"]" @bind="instruction" @bind:event="oninput" />
        @if (previous != null)
        {
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="undo-2" OnClick="UndoAsync" data-testid="@($"{TestId}-undo")">@L["Library.Ai.Undo"]</CodexButton>
        }
    </div>
    <div id="@(Id)-hint" class="field-hint">@(Hint ?? L["Library.Ai.Hint"])</div>
    @if (error != null)
    {
        <p class="text-danger small mb-0 mt-1" role="alert">@error @if (notConfigured) { <a href="/settings/ai">@L["Library.Ai.OpenSettings"]</a> }</p>
    }
    else if (stopped)
    {
        <p class="small-muted mb-0 mt-1" role="status">@L["Common.Ai.Stopped"]</p>
    }
    else if (previous != null)
    {
        <p class="small-muted mb-0 mt-1" role="status">@L["Library.Ai.Draft"]</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 5;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? TestId { get; set; }

    /// <summary>The box's @, # and $ suggestions as JSON (see <c>MentionLinks.Json</c>); null for a box that takes none.</summary>
    [Parameter] public string? Mentions { get; set; }

    /// <summary>The text as the reader will see it (see <see cref="MarkdownEditor.Preview"/>); null renders plain Markdown.</summary>
    [Parameter] public Func<string, string>? Preview { get; set; }

    /// <summary>The text takes secret blocks (see <see cref="MarkdownEditor.Secrets"/>).</summary>
    [Parameter] public bool Secrets { get; set; }

    /// <summary>Produces the new text from the current text and the optional instruction; the token is cancelled by Stop.</summary>
    [Parameter, EditorRequired] public Func<string, string, CancellationToken, Task<string>> Generate { get; set; } = null!;

    private readonly AiCall call = new();

    private bool busy;
    private bool notConfigured;
    private string? error;
    private string? previous;
    private bool stopped;
    private string instruction = string.Empty;

    private Task OnValueChanged(string? value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(Value);
    }

    private async Task EnhanceAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        notConfigured = false;
        stopped = false;
        var ct = call.Begin();
        try
        {
            var before = Value ?? string.Empty;
            var text = await Generate(before, instruction, ct);
            previous = before;
            Value = text;
            await ValueChanged.InvokeAsync(Value);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            stopped = true;
        }
        catch (AiNotConfiguredException)
        {
            notConfigured = true;
            error = L["Library.Ai.NotConfigured"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI description failed for field {FieldId}", Id);
            error = L["Library.Ai.Failed", AiFailureText.For(L, ex)];
        }
        finally
        {
            call.End(ct);
            busy = false;
        }
    }

    public void Dispose() => call.Dispose();

    private async Task UndoAsync()
    {
        Value = previous;
        previous = null;
        await ValueChanged.InvokeAsync(Value);
    }
}
