@using System.Text.Json
@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Components.Campaign
@using Codex.Web.Services
@inject IHomebrewRepository Homebrew
@inject CampaignLibrary Library
@inject AiFeatures Ai
@inject ArtService Art
@inject IJSRuntime JS

@* The DM's homebrew editor as a step-by-step modal, after the character creators of CRPGs: the
   steps down the left (the system's field categories become steps), the current step in the
   middle, and the entry as players will read it on the right, updating as you type. Back and
   Next walk the steps; Save is there on every step once the entry has a type and a name. The
   draft is a copy, so Cancel never leaves half-edited values behind. *@

<dialog id="@dialogId" class="codex-dialog wizard-dialog" aria-labelledby="@(dialogId)-title" @oncancel="CancelAsync" data-testid="homebrew-editor">
    @if (draft != null)
    {
        <form class="wizard" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
            <header class="wizard-head">
                <div>
                    <div class="label-caps">@(isNew ? L["Wizard.New"] : L["Wizard.Edit"]) @(TypeDef is { } t ? "· " + t.Label : "")</div>
                    <h2 id="@(dialogId)-title">@(string.IsNullOrWhiteSpace(draft.Name) ? (TypeDef is { } td ? L["Wizard.Unnamed", td.Label.ToLowerInvariant()] : L["Wizard.Untitled"]) : draft.Name)</h2>
                </div>
                <CodexButton Variant="CodexButtonVariant.Rune" Icon="x" Label="@L["Wizard.CloseWithoutSaving"]" OnClick="CancelAsync" />
            </header>

            <nav class="wizard-steps" aria-label="@L["Wizard.Steps"]">
                <ol>
                    @for (var i = 0; i < Steps.Count; i++)
                    {
                        var index = i;
                        var step = Steps[index];
                        var state = index == current ? "current" : StepDone(step) ? "done" : "";
                        <li>
                            <button type="button" class="wizard-step @state" aria-current="@(index == current ? "step" : null)" disabled="@(index > 0 && !BasicsValid)" @onclick="() => GoTo(index)" data-testid="wizard-step-@step.Key">
                                <span class="wizard-step-num" aria-hidden="true">@if (state == "done") { <LucideIcon IconName="check" Size="14" /> } else { @(index + 1) }</span>
                                <span class="wizard-step-label">@step.Label</span>
                            </button>
                        </li>
                    }
                </ol>
            </nav>

            <section class="wizard-body" aria-labelledby="@(dialogId)-step">
                <h3 id="@(dialogId)-step" class="wizard-step-title"><LucideIcon IconName="@CurrentStep.Icon" Size="18" Class="title-icon" /> @CurrentStep.Label</h3>
                @if (CurrentStep.Intro != null)
                {
                    <p class="small-muted">@CurrentStep.Intro</p>
                }

                @switch (CurrentStep.Key)
                {
                    case "basics":
                        <div class="field-grid mb-3">
                            <div>
                                <label for="@(dialogId)-type" class="field-label">@L["Wizard.Type"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Wizard.Required"]</span></label>
                                <select id="@(dialogId)-type" class="field-select" value="@draft.Type" @onchange="OnTypeChangedAsync" required data-testid="homebrew-type">
                                    <option value="">@L["Wizard.ChooseType"]</option>
                                    @foreach (var type in types)
                                    {
                                        <option value="@type.Type">@type.Label</option>
                                    }
                                </select>
                                @if (TypeDef?.Description is { Length: > 0 } typeHelp)
                                {
                                    <div class="field-hint">@typeHelp</div>
                                }
                            </div>
                            <div>
                                <label for="@(dialogId)-name" class="field-label">@L["Wizard.Name"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Wizard.Required"]</span></label>
                                <input id="@(dialogId)-name" class="field-input" value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString() ?? string.Empty" required maxlength="120" data-testid="homebrew-name" />
                            </div>
                            <div>
                                <label for="@(dialogId)-tags" class="field-label">@L["Wizard.Tags"]</label>
                                <input id="@(dialogId)-tags" class="field-input" placeholder="@L["Wizard.TagsPlaceholder"]" value="@string.Join(", ", draft.Tags)"
                                       @onchange="e => draft.Tags = (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()" />
                            </div>
                            <div class="field-wide">
                                <div class="field-check">
                                    <input id="@(dialogId)-published" type="checkbox" class="field-box" @bind="draft.IsPublished" />
                                    <label for="@(dialogId)-published">@L["Wizard.Visible"]</label>
                                </div>
                                <div class="field-hint">@(TypeDef?.PlayerFacing == false ? L["Wizard.HiddenTypeHint", TypeDef.PluralOrLabel] : L["Wizard.DraftHint"])</div>
                            </div>
                        </div>
                        break;

                    case "story":
                        <AiTextField Id="@(dialogId + "-desc")" Label="@L["Wizard.Description"]" Rows="7" @bind-Value="draft.Description" TestId="homebrew-description"
                                     Placeholder="@DescriptionPlaceholder" Generate="DescribeAsync"
                                     Hint="@(draft.IsPublished ? L["Wizard.HintPublished"] : L["Wizard.HintDraft"])" />
                        @if (StepSchema(CurrentStep) is { } lore)
                        {
                            <div class="mt-3"><SchemaForm Schema="lore" Values="draft.Properties" ReferenceOptions="referenceOptions" ShowGroupHeadings="false" ValuesChanged="OnValuesChanged" /></div>
                        }
                        break;

                    case "art":
                        <ArtSlot ImageUrl="@(removeArt ? null : StoredArtUrl)" Pending="pendingArt" CanEdit="true" Landscape="@(!IsCreature)"
                                 Label="@(IsCreature ? L["Wizard.Portrait"] : L["Wizard.Art"])" Alt="@L["Wizard.ArtAlt", draft.Name]" TestId="homebrew-art"
                                 OnPicked="img => { pendingArt = img; removeArt = false; }" OnRemove="() => { pendingArt = null; removeArt = true; }"
                                 Generate="GenerateArtAsync" />
                        @if (!draft.Properties.ContainsKey("imagePrompt"))
                        {
                            <p class="field-hint mt-2">@L["Wizard.TipA"] <strong>@L["Wizard.TipB"]</strong> @L["Wizard.TipC"]</p>
                        }
                        break;

                    case "review":
                        <div class="wizard-review">
                            <ul class="wizard-checklist">
                                @foreach (var step in Steps.Where(s => s.Key != "review"))
                                {
                                    <li class="@(StepDone(step) ? "done" : "")">
                                        <LucideIcon IconName="@(StepDone(step) ? "circle-check" : "circle")" Size="16" />
                                        <button type="button" class="link-button" @onclick="() => GoTo(Steps.IndexOf(step))">@step.Label</button>
                                        <span class="small-muted">@StepSummary(step)</span>
                                    </li>
                                }
                            </ul>
                            <p class="small-muted mb-0">@L["Wizard.ReviewNote"]</p>
                        </div>
                        break;

                    default:
                        @if (StepSchema(CurrentStep) is { } stepSchema)
                        {
                            <SchemaForm Schema="stepSchema" Values="draft.Properties" ReferenceOptions="referenceOptions" ShowGroupHeadings="false" ValuesChanged="OnValuesChanged" />
                        }
                        break;
                }

                @if (error != null)
                {
                    <p class="text-danger mt-3 mb-0" role="alert">@error</p>
                }
            </section>

            <aside class="wizard-preview" aria-label="@L["Wizard.Preview"]">
                <div class="label-caps mb-2"><LucideIcon IconName="eye" Size="14" /> @L["Wizard.Preview"]</div>
                @if (PreviewArt is { } src)
                {
                    <img class="wizard-preview-art @(IsCreature ? "art-portrait" : "art-landscape")" src="@src" alt="" />
                }
                @if (BasicsValid)
                {
                    <EntryDetail Item="PreviewItem" Type="TypeDef" />
                }
                else
                {
                    <p class="small-muted mb-0">@L["Wizard.PreviewEmpty"]</p>
                }
            </aside>

            <footer class="wizard-foot">
                <div class="d-flex gap-2">
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CancelAsync">@L["Common.Cancel"]</CodexButton>
                    @if (!isNew)
                    {
                        <CodexButton Variant="CodexButtonVariant.Blood" Icon="trash-2" OnClick="DeleteAsync">@L["Wizard.Delete"]</CodexButton>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="small-muted d-none d-md-inline">@L["Wizard.StepOf", current + 1, Steps.Count]</span>
                    <CodexButton Variant="CodexButtonVariant.Etched" Icon="arrow-left" OnClick="() => GoTo(current - 1)" Disabled="@(current == 0)" data-testid="homebrew-back">@L["Common.Back"]</CodexButton>
                    @if (current < Steps.Count - 1)
                    {
                        @if (BasicsValid)
                        {
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Etched" Icon="check" Disabled="@saving" data-testid="homebrew-save">@L["Common.Save"]</CodexButton>
                        }
                        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="NextAsync" data-testid="homebrew-next">@L["Wizard.Next", Steps[current + 1].Label] <LucideIcon IconName="arrow-right" Size="18" /></CodexButton>
                    }
                    else
                    {
                        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Icon="check" Disabled="@saving" data-testid="homebrew-save">@(saving ? L["Wizard.Saving"] : isNew ? L["Wizard.Create"] : L["Wizard.SaveChanges"])</CodexButton>
                    }
                </div>
            </footer>
        </form>
    }
</dialog>

<ConfirmDialog @ref="confirm" />

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    /// <summary>Called with the stored entry after a successful save.</summary>
    [Parameter] public EventCallback<HomebrewEntryDocument> OnSaved { get; set; }
    [Parameter] public EventCallback<HomebrewEntryDocument> OnDeleted { get; set; }

    private sealed record Step(string Key, string Label, string Icon, string? Intro, string? Category = null);

    private const string LoreCategory = "Lore";

    private readonly string dialogId = "hbw-" + Guid.NewGuid().ToString("N")[..6];
    private ConfirmDialog confirm = null!;
    private HomebrewEntryDocument? draft;
    private bool isNew;
    private string snapshot = string.Empty;
    private int current;
    private string? error;
    private bool saving;
    private ArtImage? pendingArt;
    private bool removeArt;
    private List<ContentTypeDefinition> types = new();
    private Dictionary<string, IReadOnlyList<(string Id, string Name)>> referenceOptions = new();

    /// <summary>Opens the wizard on a copy of <paramref name="entry"/> (a new one when its Id is empty).</summary>
    public async Task OpenAsync(HomebrewEntryDocument entry, string? startAt = null)
    {
        types = (await Library.TypesAsync(Ctx.Campaign, Ctx.Access)).ToList();
        draft = Copy(entry);
        isNew = string.IsNullOrEmpty(entry.Id);
        pendingArt = null;
        removeArt = false;
        error = null;
        saving = false;
        snapshot = Snapshot();
        await LoadReferencesAsync();
        current = startAt != null ? Math.Max(0, Steps.FindIndex(s => s.Key == startAt)) : 0;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("codex.guardModal", dialogId);
        }
        catch (JSException)
        {
            // A browser still running an older app-startup.js: open anyway; Escape just closes without asking.
        }

        await JS.InvokeVoidAsync("codex.showModal", dialogId);
        await JS.InvokeVoidAsync("codex.focus", $"{dialogId}-{(string.IsNullOrEmpty(draft.Type) ? "type" : "name")}");
    }

    private ContentTypeDefinition? TypeDef => draft == null ? null : types.FirstOrDefault(t => string.Equals(t.Type, draft.Type, StringComparison.OrdinalIgnoreCase));
    private bool IsCreature => TypeDef?.ActorBlueprint == true;
    private bool BasicsValid => draft != null && !string.IsNullOrWhiteSpace(draft.Type) && !string.IsNullOrWhiteSpace(draft.Name);

    /// <summary>Basics, Description, one step per field category of the type, Art, Review.</summary>
    private List<Step> Steps
    {
        get
        {
            var steps = new List<Step>
            {
                new("basics", L["Wizard.Step.Basics"], "file-text", L["Wizard.Intro.Basics"]),
                new("story", L["Wizard.Description"], "feather", IsCreature ? L["Wizard.Intro.StoryCreature"] : L["Wizard.Intro.Story"], LoreCategory)
            };

            var categories = (TypeDef?.Fields ?? new List<FieldDefinition>())
                .Select(f => f.Category ?? "General").Where(c => c != LoreCategory).Distinct().ToList();
            foreach (var category in categories)
            {
                var label = category == "General" ? (categories.Count == 1 ? L["Wizard.Step.Details"] : L["Wizard.Step.General"]) : category;
                steps.Add(new Step("cat-" + category, label, StepIcon(category), null, category));
            }

            steps.Add(new Step("art", IsCreature ? L["Wizard.Portrait"] : L["Wizard.Art"], "image", L["Wizard.Intro.Art"]));
            steps.Add(new Step("review", L["Wizard.Step.Review"], "circle-check", L["Wizard.Intro.Review"]));
            return steps;
        }
    }

    private Step CurrentStep => Steps[Math.Clamp(current, 0, Steps.Count - 1)];

    private static string StepIcon(string category) => category.ToLowerInvariant() switch
    {
        "profile" => "user",
        "defenses" => "shield",
        "ability scores" => "dices",
        "senses and skills" => "eye",
        "traits and actions" => "swords",
        _ => "sliders-horizontal"
    };

    private UISchema? StepSchema(Step step)
    {
        if (TypeDef == null || step.Category == null) return null;
        var fields = TypeDef.EditorFields().Where(f => (f.Category ?? "General") == step.Category).ToList();
        return fields.Count == 0 ? null : new UISchema(TypeDef.Type, PreferredEditor.Form, fields);
    }

    private bool StepDone(Step step) => step.Key switch
    {
        "basics" => BasicsValid,
        "story" => !string.IsNullOrWhiteSpace(draft?.Description),
        "art" => pendingArt != null || (!removeArt && draft?.HasArt == true),
        "review" => false,
        _ => StepSchema(step)?.Fields.Any(f => draft!.Properties.ContainsKey(f.Key)) == true
    };

    private string StepSummary(Step step)
    {
        if (draft == null) return string.Empty;
        return step.Key switch
        {
            "basics" => BasicsValid ? L[draft.IsPublished ? "Wizard.Sum.Visible" : "Wizard.Sum.Draft", TypeDef?.Label ?? draft.Type] : L["Wizard.Sum.NeedBasics"],
            "story" => string.IsNullOrWhiteSpace(draft.Description) ? L["Wizard.Sum.NoDescription"] : L["Wizard.Sum.Words", draft.Description.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length],
            "art" => pendingArt != null ? L["Wizard.Sum.NewImage"] : !removeArt && draft.HasArt ? L["Wizard.Sum.HasArt"] : L["Wizard.Sum.NoArt"],
            _ => StepSchema(step) is { } s ? L["Wizard.Sum.Filled", s.Fields.Count(f => draft.Properties.ContainsKey(f.Key)), s.Fields.Count] : string.Empty
        };
    }

    private string DescriptionPlaceholder => IsCreature
        ? L["Wizard.Placeholder.Creature"]
        : L["Wizard.Placeholder.Other"];

    private LibraryItem PreviewItem => new(draft!.ToEntry(), null, draft);

    private string? StoredArtUrl => draft is { HasArt: true } && !isNew ? ArtService.Url(Ctx.Campaign, new LibraryItem(draft.ToEntry(), null, draft)) : null;

    private string? PreviewArt => pendingArt != null
        ? $"data:{pendingArt.ContentType};base64,{Convert.ToBase64String(pendingArt.Bytes)}"
        : removeArt ? null : StoredArtUrl;

    private async Task OnTypeChangedAsync(ChangeEventArgs e)
    {
        draft!.Type = e.Value?.ToString() ?? string.Empty;
        await LoadReferencesAsync();
    }

    private async Task LoadReferencesAsync()
    {
        referenceOptions = new Dictionary<string, IReadOnlyList<(string, string)>>();
        foreach (var target in (TypeDef?.EditorFields() ?? new List<FieldDefinition>()).Where(f => f.Type == FieldType.EntityReference && f.TargetEntityType != null).Select(f => f.TargetEntityType!).Distinct())
        {
            referenceOptions[target] = (await Library.OptionsAsync(Ctx.Campaign, Ctx.Access, target, L.Culture.Name)).Select(i => (i.Entry.Id, i.Entry.Name)).ToList();
        }
    }

    private void OnValuesChanged(Dictionary<string, object> _) => StateHasChanged();

    private void GoTo(int index)
    {
        if (index < 0 || index >= Steps.Count || (index > 0 && !BasicsValid)) return;
        error = null;
        current = index;
    }

    private async Task NextAsync()
    {
        if (!BasicsValid)
        {
            error = L["Wizard.Error.TypeNameFirst"];
            await JS.InvokeVoidAsync("codex.focus", $"{dialogId}-{(string.IsNullOrWhiteSpace(draft?.Type) ? "type" : "name")}");
            return;
        }

        GoTo(current + 1);
    }

    private Task<string> DescribeAsync(string text, string instruction, CancellationToken ct)
    {
        var type = TypeDef;
        var subject = string.IsNullOrWhiteSpace(draft!.Name) ? "an unnamed " + (type?.Label.ToLowerInvariant() ?? "entry") : draft.Name;
        return Ai.DescribeAsync(Ctx.Campaign, subject, KindLabel(type), AiFeatures.EntryFacts(draft.ToEntry(), type), text, instruction,
            draft.IsPublished && type?.PlayerFacing != false ? AiAudience.Players : AiAudience.Dm, Ctx.UserId, ct);
    }

    private Task<ArtImage> GenerateArtAsync(CancellationToken ct)
    {
        var visual = draft!.Properties.TryGetValue("imagePrompt", out var prompt) && !string.IsNullOrWhiteSpace(prompt?.ToString())
            ? prompt.ToString()
            : TextFormatting.Summary(draft.Description, 300);
        return Art.GenerateAsync(Ctx.UserId, draft.Name, KindLabel(TypeDef), visual, IsCreature ? ArtShape.Tall : ArtShape.Wide, ct);
    }

    /// <summary>"homebrew creature (Large dragon)": the type label plus the size and kind when the entry has them.</summary>
    private string KindLabel(ContentTypeDefinition? type)
    {
        // The prompt is for an AI model, so the type is named as system.yaml names it, not as the reader sees it.
        var canonical = type == null ? null : Ctx.System?.Canonical.FindType(type.Type) ?? type;
        var label = "homebrew " + (canonical?.Label.ToLowerInvariant() ?? "entry");
        var detail = string.Join(' ', new[] { "size", "creatureType" }.Select(k => YamlValues.GetString(draft!.Properties, k)).Where(v => !string.IsNullOrWhiteSpace(v)));
        return detail.Length == 0 ? label : $"{label} ({detail})";
    }

    private async Task SaveAsync()
    {
        if (draft == null || saving) return;
        if (!BasicsValid)
        {
            error = L["Wizard.Error.TypeNameRequired"];
            current = 0;
            return;
        }

        saving = true;
        error = null;
        try
        {
            draft.Name = draft.Name.Trim();
            draft.SystemId = Ctx.Campaign.SystemId;
            draft.AuthorUserId = Ctx.UserId;
            if (!await Homebrew.TrySaveAsync(draft, Ctx.Access))
            {
                error = L["Wizard.Error.OnlyDm"];
                return;
            }

            if (pendingArt != null && !await Art.PutHomebrewAsync(draft, Ctx.Access, pendingArt))
            {
                error = L["Wizard.Error.ArtFailed"];
            }
            else if (removeArt && draft.HasArt)
            {
                await Art.RemoveAsync(Ctx.Campaign, Ctx.Access, new LibraryItem(draft.ToEntry(), null, draft));
            }

            snapshot = Snapshot();
            pendingArt = null;
            if (error != null) return;
            await JS.InvokeVoidAsync("codex.closeModal", dialogId);
            var saved = draft;
            draft = null;
            await OnSaved.InvokeAsync(saved);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (draft != null && (pendingArt != null || removeArt || Snapshot() != snapshot)
            && !await confirm.ShowAsync(L["Wizard.DiscardTitle"], L["Wizard.DiscardBody", string.IsNullOrWhiteSpace(draft.Name) ? L["Wizard.ThisEntry"] : draft.Name], L["Wizard.Discard"], isDestructive: true, cancel: L["Wizard.KeepEditing"]))
        {
            // Browsers may close a dialog on Escape regardless (Chrome does without recent user input); put it back.
            await JS.InvokeVoidAsync("codex.showModal", dialogId);
            return;
        }

        await JS.InvokeVoidAsync("codex.closeModal", dialogId);
        draft = null;
    }

    private async Task DeleteAsync()
    {
        if (draft == null || isNew) return;
        if (!await confirm.ShowAsync(L["Wizard.DeleteTitle", draft.Name], L["Wizard.DeleteBody"], L["Wizard.Delete"], isDestructive: true))
        {
            return;
        }

        if (!await Homebrew.TryDeleteAsync(draft.Id, Ctx.Access))
        {
            error = L["Wizard.Error.DeleteFailed"];
            return;
        }

        await JS.InvokeVoidAsync("codex.closeModal", dialogId);
        var deleted = draft;
        draft = null;
        await OnDeleted.InvokeAsync(deleted);
    }

    private string Snapshot() => draft == null ? string.Empty : JsonSerializer.Serialize(new { draft.Type, draft.Name, draft.Description, draft.Tags, draft.IsPublished, draft.Properties });

    private static HomebrewEntryDocument Copy(HomebrewEntryDocument entry) => new()
    {
        Id = entry.Id,
        CampaignId = entry.CampaignId,
        SystemId = entry.SystemId,
        Type = entry.Type,
        EntryId = entry.EntryId,
        Name = entry.Name,
        Description = entry.Description,
        Tags = new List<string>(entry.Tags),
        Properties = entry.Properties.ToDictionary(p => p.Key, p => DeepCopy(p.Value)!),
        IsPublished = entry.IsPublished,
        AuthorUserId = entry.AuthorUserId,
        ImportedFrom = entry.ImportedFrom,
        HasArt = entry.HasArt,
        ArtVersion = entry.ArtVersion,
        CreatedAt = entry.CreatedAt,
        UpdatedAt = entry.UpdatedAt
    };

    private static object? DeepCopy(object? value) => value switch
    {
        IDictionary<string, object> map => map.ToDictionary(p => p.Key, p => DeepCopy(p.Value)!),
        string s => s,
        IEnumerable<object> list => list.Select(DeepCopy).ToList(),
        _ => value
    };
}
