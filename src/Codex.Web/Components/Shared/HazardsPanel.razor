@using Codex.Core.Systems
@using Codex.Persistence
@using Codex.Persistence.Runtime
@inject IJSRuntime JS

@* The game master's Hazards panel (HAZARDS_DESIGN.md 4.1, 7). One list of hazards, each a group with a heading (its name and its state in words, with an icon
   beside the words) and real buttons whose text names the action and the hazard. Who acts is one fieldset of check boxes. The result of the last action is in a
   polite status region. Everything here is the game master's: the console never draws it for a player. *@
<section class="panel" aria-labelledby="hazards-heading" data-testid="hazards-panel">
    <div class="panel-title"><h3 id="hazards-heading">@L["Combat.Hazard.Panel"]</h3></div>

    @if (Places.Count > 0)
    {
        <div class="mb-2">
            <label for="hazard-place" class="field-label">@L["Combat.Hazard.Place"]</label>
            <select id="hazard-place" class="field-select field-sm" data-testid="hazard-place" value="@PlaceId" @onchange="PlaceChosenAsync">
                <option value="">@L["Combat.Hazard.AllPlaces"]</option>
                @foreach (var place in Places)
                {
                    <option value="@place.Id" selected="@(place.Id == PlaceId)">@place.Label</option>
                }
            </select>
        </div>
    }

    <div class="visually-hidden" role="status" aria-live="polite" data-testid="hazard-status">
        @foreach (var line in Status)
        {
            <p>@line</p>
        }
    </div>
    @if (Status.Count > 0)
    {
        <div class="small-muted mb-2" aria-hidden="true" data-testid="hazard-result">
            <strong>@L["Combat.Hazard.Result"]</strong>
            @foreach (var line in Status)
            {
                <div>@line</div>
            }
        </div>
    }

    @if (Hazards.Count == 0)
    {
        <p class="small-muted mb-0" data-testid="hazards-none">@L["Combat.Hazard.None"]</p>
    }
    else
    {
        <fieldset class="mb-2" data-testid="hazard-who" aria-describedby="hazard-who-hint">
            <legend class="field-label">@L["Combat.Hazard.Who"]</legend>
            <p class="small-muted mb-1" id="hazard-who-hint">@L["Combat.Hazard.WhoHint"]</p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var who in Who)
                {
                    var id = who.Id;
                    <CodexCheck Checked="@ticked.Contains(id)" OnChange="e => Tick(id, e)" data-testid="@($"hazard-who-{id}")">@who.Name</CodexCheck>
                }
            </div>
        </fieldset>

        @if (NeedNumber.Count > 0)
        {
            <fieldset class="mb-2" data-testid="hazard-numbers">
                <legend class="field-label">@L["Combat.Hazard.NeedsNumber"]</legend>
                <p class="small-muted mb-1" id="hazard-number-hint">@L["Combat.Hazard.NeedsNumberHint"]</p>
                @for (var n = 0; n < NeedNumber.Count; n++)
                {
                    var need = NeedNumber[n];
                    var key = need.Key;
                    var field = $"hazard-number-{n}";
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <label for="@field" class="field-label mb-0">@NumberLabel(need)</label>
                        <input id="@field" type="number" class="field-input field-sm" style="max-width: 6rem" aria-describedby="hazard-number-hint"
                               value="@(typed.TryGetValue(key, out var shownNumber) ? shownNumber.ToString() : Suggested.TryGetValue(key, out var shownSuggestion) ? shownSuggestion.ToString() : null)" @onchange="e => Typed(key, e)" data-testid="@field" />
                    </div>
                }
            </fieldset>
        }

        <ul class="list-unstyled mb-0">
            @for (var i = 0; i < Hazards.Count; i++)
            {
                var hazard = Hazards[i];
                var at = i;
                var heading = $"hazard-heading-{at}";
                <li class="mb-3" data-testid="@($"hazard-{at}")">
                    <article aria-labelledby="@heading">
                        <h4 id="@heading" class="h6 mb-1" tabindex="-1">
                            @hazard.Name
                            <span class="pill pill-warning ms-1" data-testid="@($"hazard-{at}-state")"><LucideIcon IconName="@StateIcon(hazard.State)" Size="12" /> @L[$"Combat.Hazard.State.{hazard.State}"]</span>
                        </h4>
                        <div class="small-muted mb-1">
                            @hazard.PlaceName
                            @if (hazard.Successes > 0)
                            {
                                <span> · @L["Combat.Hazard.Successes", hazard.Successes]</span>
                            }
                            <span> · @(hazard.NoticedBy.Count == 0 ? L["Combat.Hazard.NoOne"] : L["Combat.Hazard.Noticed", string.Join(", ", hazard.NoticedBy)])</span>
                        </div>

                        @if (hazard.Site == null)
                        {
                            <p class="small-muted mb-0">@L["Combat.Hazard.Gone", hazard.Name]</p>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-end mb-1">
                                <CodexButton Small="true" Disabled="@(ticked.Count == 0)" data-testid="@($"hazard-{at}-notice")" OnClick="() => SendAsync(hazard, HazardAction.Notice)">@L["Combat.Hazard.Notice", hazard.Name]</CodexButton>
                                <CodexButton Small="true" Disabled="@(ticked.Count == 0)" data-testid="@($"hazard-{at}-trigger")" OnClick="() => SendAsync(hazard, HazardAction.Trigger)">@L["Combat.Hazard.Trigger", hazard.Name]</CodexButton>
                            </div>

                            <div class="d-flex flex-wrap gap-2 align-items-end mb-1">
                                <div>
                                    <label for="@($"hazard-{at}-find-way")" class="field-label">@L["Combat.Hazard.FindWay", hazard.Name]</label>
                                    <select id="@($"hazard-{at}-find-way")" class="field-select field-sm" data-testid="@($"hazard-{at}-find-way")" disabled="@(hazard.Detect.Count == 0)"
                                            value="@WayOf(detectWay, hazard, hazard.Detect)" @onchange="e => detectWay[hazard.Id] = e.Value?.ToString() ?? string.Empty">
                                        @foreach (var way in hazard.Detect)
                                        {
                                            <option value="@way.Key" selected="@(way.Key == WayOf(detectWay, hazard, hazard.Detect))">@way.Label</option>
                                        }
                                    </select>
                                </div>
                                <CodexButton Small="true" Disabled="@(ticked.Count == 0 || hazard.Detect.Count == 0)" data-testid="@($"hazard-{at}-find")"
                                             OnClick="() => SendAsync(hazard, HazardAction.Find, WayOf(detectWay, hazard, hazard.Detect))">@L["Combat.Hazard.Find", hazard.Name]</CodexButton>
                            </div>

                            <div class="d-flex flex-wrap gap-2 align-items-end mb-1">
                                <div>
                                    <label for="@($"hazard-{at}-disable-way")" class="field-label">@L["Combat.Hazard.DisableWay", hazard.Name]</label>
                                    <select id="@($"hazard-{at}-disable-way")" class="field-select field-sm" data-testid="@($"hazard-{at}-disable-way")" disabled="@(hazard.Disarm.Count == 0)"
                                            value="@WayOf(disarmWay, hazard, hazard.Disarm)" @onchange="e => disarmWay[hazard.Id] = e.Value?.ToString() ?? string.Empty">
                                        @foreach (var way in hazard.Disarm)
                                        {
                                            <option value="@way.Key" selected="@(way.Key == WayOf(disarmWay, hazard, hazard.Disarm))">@way.Label</option>
                                        }
                                    </select>
                                </div>
                                <CodexButton Small="true" Disabled="@(ticked.Count == 0 || hazard.Disarm.Count == 0)" data-testid="@($"hazard-{at}-disable")"
                                             OnClick="() => SendAsync(hazard, HazardAction.Disable, WayOf(disarmWay, hazard, hazard.Disarm))">@L["Combat.Hazard.Disable", hazard.Name]</CodexButton>
                            </div>

                            @if (hazard.Turn is { } turn)
                            {
                                var routineHeading = $"hazard-{at}-routine-heading";
                                <section class="mb-2" aria-labelledby="@routineHeading" data-testid="@($"hazard-{at}-routine")">
                                    <h5 id="@routineHeading" class="h6 mb-1">
                                        @L["Combat.Hazard.Routine", hazard.Name]
                                        <span class="pill ms-1" data-testid="@($"hazard-{at}-order")">@(turn.InOrder ? L["Combat.Hazard.InOrder"] : L["Combat.Hazard.OutOfOrder"])</span>
                                        @if (turn.ItsTurn)
                                        {
                                            <span class="pill pill-warning ms-1" data-testid="@($"hazard-{at}-its-turn")">@L["Combat.Hazard.ItsTurn"]</span>
                                        }
                                    </h5>
                                    <p class="small-muted mb-1">@L["Combat.Hazard.RoutineAnyTurn"]</p>
                                    <ul class="list-unstyled mb-0">
                                        @for (var s = 0; s < turn.Routine.Count; s++)
                                        {
                                            var step = turn.Routine[s];
                                            var stepAt = s;
                                            <li class="mb-1" data-testid="@($"hazard-{at}-step-{stepAt}")">
                                                <strong>@step.Name</strong> <span class="small-muted">@step.Description</span>
                                                <div class="d-flex flex-wrap gap-2 mt-1">
                                                    <CodexButton Small="true" Disabled="@(!turn.InOrder)" data-testid="@($"hazard-{at}-step-{stepAt}-note")"
                                                                 OnClick="() => StepAsync(hazard, step, false)">@L["Combat.Hazard.StepNote", step.Name, hazard.Name]</CodexButton>
                                                    @if (step.Strikes && turn.HasEffect)
                                                    {
                                                        <CodexButton Small="true" Disabled="@(ticked.Count == 0 || !turn.InOrder)" data-testid="@($"hazard-{at}-step-{stepAt}-on")"
                                                                     OnClick="() => StepAsync(hazard, step, true)">@L["Combat.Hazard.StepOn", step.Name, hazard.Name]</CodexButton>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </section>
                            }

                            @if (hazard.Waiting > 0)
                            {
                                <p class="small-muted mb-1">@L["Combat.Hazard.Waiting", hazard.Waiting]</p>
                            }

                            @if (hazard.Others.Count > 0)
                            {
                                <p class="small-muted mb-1">@L["Combat.Hazard.Others"]: @string.Join(", ", hazard.Others)</p>
                            }

                            @if (PassesFor == hazard.Id && Passes.Count > 0)
                            {
                                <CodexButton Small="true" Variant="CodexButtonVariant.Plaque" data-testid="@($"hazard-{at}-mark")" OnClick="() => MarkAsync(hazard, at)">
                                    @L["Combat.Hazard.MarkNoticed", string.Join(", ", Passes.Select(p => NameOf(p.ActorId)).Distinct())]
                                </CodexButton>
                            }

                            @if (hazard.CanUndo)
                            {
                                <div class="mb-1">
                                    <CodexButton Small="true" data-testid="@($"hazard-{at}-undo")" OnClick="() => UndoAsync(hazard, at)"><LucideIcon IconName="undo-2" Size="14" /> @L["Combat.Hazard.Undo", hazard.Name]</CodexButton>
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2 align-items-end">
                                <div>
                                    <label for="@($"hazard-{at}-state-pick")" class="field-label">@L["Combat.Hazard.StateOf", hazard.Name]</label>
                                    <select id="@($"hazard-{at}-state-pick")" class="field-select field-sm" data-testid="@($"hazard-{at}-state-pick")"
                                            @onchange="e => stateChoice[hazard.Id] = Enum.Parse<HazardState>(e.Value!.ToString()!)">
                                        @foreach (var state in Enum.GetValues<HazardState>())
                                        {
                                            <option value="@state" selected="@(state == StateChoice(hazard))">@L[$"Combat.Hazard.State.{state}"]</option>
                                        }
                                    </select>
                                </div>
                                <CodexButton Small="true" data-testid="@($"hazard-{at}-set-state")" OnClick="() => SendAsync(hazard, HazardAction.SetState, null, StateChoice(hazard))">@L["Combat.Hazard.SetState", hazard.Name]</CodexButton>
                            </div>
                        }
                    </article>
                </li>
            }
        </ul>
        <p class="small-muted mb-0">@L["Combat.Hazard.UndoHint"]</p>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<HazardView> Hazards { get; set; } = Array.Empty<HazardView>();
    [Parameter] public IReadOnlyList<HazardWho> Who { get; set; } = Array.Empty<HazardWho>();
    [Parameter] public IReadOnlyList<HazardPlace> Places { get; set; } = Array.Empty<HazardPlace>();
    [Parameter] public string PlaceId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnPlaceChanged { get; set; }
    [Parameter] public EventCallback<HazardRequest> OnRequest { get; set; }

    /// <summary>Takes back the hazard's own last change with the damage it dealt (all of it or none).</summary>
    [Parameter] public EventCallback<HazardView> OnUndo { get; set; }

    /// <summary>What the last action said, line by line, for the status region and the visible result.</summary>
    [Parameter] public IReadOnlyList<string> Status { get; set; } = Array.Empty<string>();

    /// <summary>Who the last action could do nothing for, for want of a number (a printed creature's save or armor class).</summary>
    [Parameter] public IReadOnlyList<HazardNeed> NeedNumber { get; set; } = Array.Empty<HazardNeed>();

    private string NumberLabel(HazardNeed need) => need.Kind switch
    {
        HazardAskKind.ArmorClass => L["Combat.Hazard.NumberForArmor", need.ActorName],
        HazardAskKind.Passive => L["Combat.Hazard.NumberForScore", need.ActorName, need.Label],
        _ => L["Combat.Hazard.NumberFor", need.ActorName, need.Label]
    };

    /// <summary>The request the numbers were asked for (<c>hazard id|action|route</c>): a typed number goes only with the repeat of that one.</summary>
    [Parameter] public string AskedFor { get; set; } = string.Empty;

    /// <summary>The numbers a printed sheet suggests for the questions that were asked, by <see cref="HazardNeed.Key"/> (4.2); the game master can type another.</summary>
    [Parameter] public IReadOnlyDictionary<string, int> Suggested { get; set; } = new Dictionary<string, int>();

    /// <summary>Who passed which route in the last sweep, and the hazard (<see cref="HazardView.Id"/>) it was for.</summary>
    [Parameter] public IReadOnlyList<HazardPass> Passes { get; set; } = Array.Empty<HazardPass>();
    [Parameter] public string? PassesFor { get; set; }

    private readonly HashSet<string> ticked = new();
    private readonly Dictionary<string, int> typed = new();
    private readonly Dictionary<string, string> detectWay = new();
    private readonly Dictionary<string, string> disarmWay = new();
    private readonly Dictionary<string, HazardState> stateChoice = new();

    private string NameOf(string actorId) => Who.FirstOrDefault(w => w.Id == actorId)?.Name ?? actorId;

    private static string StateIcon(HazardState state) => state switch
    {
        HazardState.Hidden => "eye-off",
        HazardState.Noticed => "eye",
        HazardState.Disabled => "shield-check",
        _ => "zap"
    };

    private static string WayOf(Dictionary<string, string> chosen, HazardView hazard, IReadOnlyList<HazardWay> ways) =>
        chosen.TryGetValue(hazard.Id, out var key) && ways.Any(w => w.Key == key) ? key : ways.FirstOrDefault()?.Key ?? string.Empty;

    private HazardState StateChoice(HazardView hazard) => stateChoice.GetValueOrDefault(hazard.Id, hazard.State);

    private void Tick(string id, ChangeEventArgs e)
    {
        if (e.Value is true) ticked.Add(id);
        else ticked.Remove(id);
    }

    private void Typed(string id, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var number)) typed[id] = number;
        else typed.Remove(id);
    }

    private Task PlaceChosenAsync(ChangeEventArgs e) => OnPlaceChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    // The ticked characters in the order the list shows them: a sweep and a trigger use all of them, a try at one route the first.
    private List<string> Chosen() => Who.Select(w => w.Id).Where(ticked.Contains).ToList();

    private Task SendAsync(HazardView hazard, HazardAction action, string? route = null, HazardState? state = null)
    {
        var chosen = Chosen();
        var actors = action is HazardAction.Find or HazardAction.Disable ? chosen.Take(1).ToList() : chosen;
        var numbers = NumbersFor(hazard, action, route);
        typed.Clear();
        return OnRequest.InvokeAsync(new HazardRequest(hazard, action, actors, route, null, state, numbers));
    }

    // A typed number answers one question ("Goblin needs a number") and goes only with the repeat of that request (the same hazard, action and route or step), for the
    // creatures that were asked: never to a later check of another kind (a save bonus used as a Perception bonus, or on another hazard). A number the printed sheet
    // suggests stands unless the game master typed another.
    private IReadOnlyDictionary<string, int>? NumbersFor(HazardView hazard, HazardAction action, string? route)
    {
        if (AskedFor != $"{hazard.Id}|{action}|{route}") return null;
        var numbers = new Dictionary<string, int>();
        foreach (var asked in NeedNumber.Select(n => n.Key))
        {
            if (typed.TryGetValue(asked, out var own)) numbers[asked] = own;
            else if (Suggested.TryGetValue(asked, out var suggestion)) numbers[asked] = suggestion;
        }

        return numbers.Count == 0 ? null : numbers;
    }

    // One step of the hazard's routine: said in the log, or, set off on the ticked creatures, the hazard's effect on them (the Rolling Stone's Crush on any creature's turn).
    private Task StepAsync(HazardView hazard, HazardStep step, bool onTicked)
    {
        // The repeat of a strike that asked for a number carries it, like a trigger's.
        var numbers = onTicked ? NumbersFor(hazard, HazardAction.Routine, step.Name) : null;
        typed.Clear();
        return OnRequest.InvokeAsync(new HazardRequest(hazard, HazardAction.Routine, onTicked ? Chosen() : Array.Empty<string>(), step.Name, null, null, numbers));
    }

    // The game master marks the characters who passed as having noticed it, and the routes they passed as found.
    private async Task MarkAsync(HazardView hazard, int at)
    {
        focusId = $"hazard-heading-{at}";
        await OnRequest.InvokeAsync(new HazardRequest(hazard, HazardAction.MarkNoticed, Passes.Select(p => p.ActorId).Distinct().ToList(), null, Passes.Select(p => p.RouteKey).Distinct().ToList()));
    }

    private async Task UndoAsync(HazardView hazard, int at)
    {
        focusId = $"hazard-heading-{at}";
        await OnUndo.InvokeAsync(hazard);
    }

    // Focus. A button that takes itself away (undo, mark as noticed) hands focus to its hazard's heading, so a keyboard user is not dropped at the top of the page; a
    // question for a number moves focus to its first box, since it is the next thing to do.
    private string? focusId;
    private int askedCount;

    protected override void OnParametersSet()
    {
        if (NeedNumber.Count > 0 && askedCount == 0) focusId = "hazard-number-0";
        askedCount = NeedNumber.Count;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusId is not { } id) return;
        focusId = null;
        try
        {
            await JS.InvokeVoidAsync("codex.focusById", id);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No focus to move (prerender or a closed circuit): nothing to report.
        }
    }
}
