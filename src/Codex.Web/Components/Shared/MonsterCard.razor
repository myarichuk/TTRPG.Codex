@using Codex.Core
@using Codex.Plugin.Abstractions

@* A creature as a stat block: type line, a red rule, the three vitals, the six scores, then
   banded Traits / Actions / Reactions. Needs the structured properties; see CanShow. *@

<div class="ref-card monster-card" data-testid="monster-card">
    <div class="ref-typeline">
        <DomainIcon Domain="creature" Key="@RefCard.Text(Entry, "creatureType")" Size="DomainIconSize.Small" />
        @TypeLine
    </div>
    <div class="ref-rule" aria-hidden="true"></div>
    <dl class="ref-vitals">
        <div><dt>@L["Actor.Card.ArmorClass"]</dt><dd data-testid="card-ac">@RefCard.Int(Entry, "armorClass")</dd></div>
        <div><dt>@L["Actor.Card.HitPoints"]</dt><dd data-testid="card-hp">@RefCard.Int(Entry, "hitPoints")@(RefCard.Text(Entry, "hitDice") is { } dice ? $" ({dice})" : "")</dd></div>
        <div><dt>@L["Actor.Card.Speed"]</dt><dd>@RefCard.Text(Entry, "speed")</dd></div>
    </dl>
    <div class="ref-rule" aria-hidden="true"></div>
    <table class="ref-scores" aria-label="@L["Actor.Card.AbilityScores"]">
        <thead>
            <tr>@foreach (var (label, _) in Abilities) {<th scope="col">@label</th>}</tr>
        </thead>
        <tbody>
            <tr>
                @foreach (var (label, key) in Abilities)
                {
                    var score = RefCard.Int(Entry, key);
                    <td>@(score is { } s ? $"{s} ({RefCard.Modifier(s)})" : "-")</td>
                }
            </tr>
        </tbody>
    </table>
    <div class="ref-rule" aria-hidden="true"></div>
    <dl class="ref-facts">
        @foreach (var fact in Facts)
        {
            <dt>@fact.Label</dt>
            <dd>@fact.Value</dd>
        }
    </dl>
    @foreach (var section in Sections)
    {
        <section class="ref-band" aria-labelledby="@("band-" + section.Key)">
            <h3 id="@("band-" + section.Key)" class="ref-band-title">@section.Label</h3>
            @foreach (var row in section.Rows)
            {
                <div class="ref-row">
                    <strong>@(row.GetValueOrDefault("name")?.ToString()).</strong>
                    @((MarkupString)TextFormatting.Inline(row.GetValueOrDefault("description")?.ToString() ?? string.Empty))
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public ContentEntry Entry { get; set; } = null!;

    private (string Label, string Key)[] Abilities => new[]
    {
        (L["Actor.Card.Str"], "strength"), (L["Actor.Card.Dex"], "dexterity"), (L["Actor.Card.Con"], "constitution"),
        (L["Actor.Card.Int"], "intelligence"), (L["Actor.Card.Wis"], "wisdom"), (L["Actor.Card.Cha"], "charisma"),
    };

    private static readonly string[] SectionKeys = { "traits", "actions", "bonusActions", "reactions", "legendaryActions" };

    private string SectionLabel(string key) => key switch
    {
        "traits" => L["Actor.Card.Traits"],
        "actions" => L["Actor.Card.Actions"],
        "bonusActions" => L["Actor.Card.BonusActions"],
        "reactions" => L["Actor.Card.Reactions"],
        _ => L["Actor.Card.LegendaryActions"]
    };

    private string FactLabel(string key) => key switch
    {
        "savingThrows" => L["Actor.Card.SavingThrows"],
        "skills" => L["Actor.Card.Skills"],
        "damageVulnerabilities" => L["Actor.Card.DamageVulnerabilities"],
        "damageResistances" => L["Actor.Card.DamageResistances"],
        "damageImmunities" => L["Actor.Card.DamageImmunities"],
        "conditionImmunities" => L["Actor.Card.ConditionImmunities"],
        "senses" => L["Actor.Card.Senses"],
        _ => L["Actor.Card.Languages"]
    };

    /// <summary>True when the entry carries the structured fields a stat block needs.</summary>
    public static bool CanShow(ContentEntry entry) =>
        entry.Type.Equals("monster", StringComparison.OrdinalIgnoreCase)
        && RefCard.Int(entry, "armorClass") != null && RefCard.Int(entry, "hitPoints") != null && RefCard.Int(entry, "strength") != null
        && SectionKeys.Any(s => RefCard.Rows(entry, s).Count > 0);

    private string TypeLine
    {
        get
        {
            var parts = new[] { RefCard.Text(Entry, "size"), RefCard.Text(Entry, "creatureType") is { } t ? CampaignLibrary.Humanize(t) : null }.Where(p => p != null);
            var line = string.Join(" ", parts);
            return RefCard.Text(Entry, "alignment") is { } alignment ? $"{line}, {alignment}" : line;
        }
    }

    private IEnumerable<(string Label, string Value)> Facts
    {
        get
        {
            foreach (var key in new[] { "savingThrows", "skills", "damageVulnerabilities", "damageResistances", "damageImmunities", "conditionImmunities", "senses", "languages" })
            {
                if (RefCard.Text(Entry, key) is { } text) yield return (FactLabel(key), text);
            }

            if (RefCard.Text(Entry, "challengeRating") is { } cr)
            {
                yield return (L["Actor.Card.Challenge"], RefCard.Int(Entry, "xp") is { } xp ? L["Actor.Card.ChallengeXp", cr, xp] : cr);
            }
        }
    }

    private IEnumerable<(string Key, string Label, List<Dictionary<string, object>> Rows)> Sections =>
        SectionKeys.Select(s => (Key: s, Label: SectionLabel(s), Rows: RefCard.Rows(Entry, s))).Where(s => s.Rows.Count > 0);
}
