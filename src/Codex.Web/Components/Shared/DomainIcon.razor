@namespace Codex.Web.Components.Shared

@* The game's own icons: conditions, damage types, schools of magic, item categories, creature types,
   kinds of content and roles. They are drawn for this app (Lucide stays for interface chrome) on the
   same 24-unit grid. Anything without a glyph gets a heraldic placeholder: a shield with its initial.
   Three sizes only: sm 16, md 22, lg 32. Decorative unless a Label is given. *@

<svg xmlns="http://www.w3.org/2000/svg" width="@Pixels" height="@Pixels" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="domain-icon @Class"
     role="@(Label == null ? null : "img")" aria-label="@Label" aria-hidden="@(Label == null ? "true" : null)" focusable="false" data-domain="@Domain" data-key="@Slug">
    @if (Glyphs.TryGetValue(Domain + "/" + Slug, out var markup))
    {
        @((MarkupString)markup)
    }
    else
    {
        <path d="M12 3 4.500 6v6c0 4.500 3 7.500 7.500 9 4.500-1.500 7.500-4.500 7.500-9V6z" />
        @* Razor reserves <text>, so the SVG text element goes in as markup. *@
        @((MarkupString)$"<text x=\"12\" y=\"15.5\" text-anchor=\"middle\" font-size=\"9\" font-family=\"var(--font-display)\" stroke=\"none\" fill=\"currentColor\">{System.Net.WebUtility.HtmlEncode(Initial)}</text>")
    }
</svg>

@code {
    /// <summary>condition, damage, school, item, creature, kind, role or actor.</summary>
    [Parameter, EditorRequired] public string Domain { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string? Key { get; set; }
    [Parameter] public DomainIconSize Size { get; set; } = DomainIconSize.Medium;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Label { get; set; }

    private int Pixels => Size switch { DomainIconSize.Small => 16, DomainIconSize.Large => 32, _ => 22 };
    private string Slug => Normalise(Key);
    private string Initial => string.IsNullOrEmpty(Slug) ? "?" : System.Globalization.StringInfo.GetNextTextElement(Slug).ToUpperInvariant();

    /// <summary>True when there is a drawn glyph, so callers can skip the placeholder in tight spots.</summary>
    public static bool Has(string domain, string? key) => Glyphs.ContainsKey(domain + "/" + Normalise(key));

    private static string Normalise(string? key) => (key ?? string.Empty).Trim().ToLowerInvariant().Replace(' ', '-').Replace('_', '-');

