@using Codex.Plugin.Abstractions
@inject IContentRegistry Registry

@* A browsable list of Library entries to add from: everything is visible straight away, narrowed by a
   name filter and by dropdowns for the type's filter fields (level, school, category...). Used by the
   sheet's pick lists and equipment, and anywhere else an entry is chosen from a known set. *@

@{
    var facets = Facets();
    var matches = Disabled ? new List<ContentEntry>() : Matching();
    var shown = matches.Take(visible).ToList();
}
<div class="entry-browser" data-testid="@TestId-browser">
    <div class="d-flex gap-2 align-items-end flex-wrap">
        <div class="flex-grow-1 search" style="min-width: 220px">
            <LucideIcon IconName="search" Size="18" Class="search-icon" />
            <label for="@(id)-search" class="visually-hidden">@L["Library.Entries.FilterByName", LabelText]</label>
            <input id="@(id)-search" type="search" class="field-input field-sm" placeholder="@(Disabled ? DisabledTextValue : L["Library.Entries.FilterPlaceholder", LabelText.ToLowerInvariant()])"
                   disabled="@Disabled" value="@query" @oninput="e => { query = e.Value?.ToString() ?? string.Empty; visible = PageSize; }" autocomplete="off" data-testid="@TestId-search" />
        </div>
        @foreach (var facet in facets)
        {
            <div>
                <label for="@(id)-f-@facet.Key" class="visually-hidden">@L["Library.Entries.FilterBy", facet.Label]</label>
                <select id="@(id)-f-@facet.Key" class="field-select field-sm" disabled="@Disabled" @onchange="e => SetFacet(facet.Key, e.Value?.ToString())" data-testid="@TestId-filter-@facet.Key">
                    <option value="">@L["Library.Entries.Any", facet.Label.ToLowerInvariant()]</option>
                    @foreach (var value in facet.Values)
                    {
                        <option value="@value" selected="@(filters.GetValueOrDefault(facet.Key) == value)">@DisplayValue(facet.Key, value)</option>
                    }
                </select>
            </div>
        }
    </div>
    @if (!Disabled)
    {
        <p class="small-muted mt-1 mb-0" aria-live="polite">@L["Library.Entries.Available", matches.Count, Options.Count]</p>
        <ul class="list-unstyled mb-0 mt-1 picker-results" data-testid="@TestId-options">
            @if (matches.Count == 0)
            {
                <li class="small-muted">@(Options.Count == 0 ? EmptyTextValue : L["Library.Entries.NoMatch"])</li>
            }
            @foreach (var option in shown)
            {
                <li class="list-row py-1">
                    <span>@option.Name <span class="small-muted">@Summary(option)</span></span>
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => OnAdd.InvokeAsync(option.Id)" aria-label="@(AddLabel == null ? L["Library.Entries.AddNamed", option.Name] : $"{AddLabel} {option.Name}")">@AddLabelValue</CodexButton>
                </li>
            }
            @if (matches.Count > shown.Count)
            {
                <li class="py-1"><CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => visible += PageSize">@L["Library.ShowMore", Math.Min(PageSize, matches.Count - shown.Count)]</CodexButton></li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ContentEntry> Options { get; set; } = Array.Empty<ContentEntry>();
    [Parameter] public ContentTypeDefinition? Type { get; set; }

    /// <summary>What the entries are called, plural ("spells"); used in labels and the placeholder.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Prefix of the data-testid values: {TestId}-search, -options, -filter-{field}.</summary>
    [Parameter] public string TestId { get; set; } = "entries";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledText { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string? AddLabel { get; set; }

    // The entries as the reader sees them (names, and the properties a translation pack words), made once per list of options.
    private IReadOnlyList<ContentEntry>? shownFor;
    private List<(ContentEntry Original, ContentEntry Shown)> shownOptions = new();

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(shownFor, Options)) return;
        shownFor = Options;
        var culture = L.Culture.Name;
        shownOptions = Options.Select(o => (o, Registry.Show(o, culture))).ToList();
    }

    private string DisplayValue(string key, string value) => Type?.Fields.FirstOrDefault(f => f.Key == key)?.Display(value) ?? value;

    private string LabelText => Label ?? L["Library.Entries.Default"];
    private string DisabledTextValue => DisabledText ?? L["Library.Entries.Disabled"];
    private string EmptyTextValue => EmptyText ?? L["Library.Entries.Empty"];
    private string AddLabelValue => AddLabel ?? L["Library.Entries.Add"];

    /// <summary>Called with the id of the entry whose Add button was pressed.</summary>
    [Parameter] public EventCallback<string> OnAdd { get; set; }

    private readonly string id = "eb-" + Guid.NewGuid().ToString("N")[..6];
    private string query = string.Empty;
    private const int PageSize = 30;
    private int visible = PageSize;
    private readonly Dictionary<string, string> filters = new(StringComparer.OrdinalIgnoreCase);

    private sealed record Facet(string Key, string Label, List<string> Values);

    /// <summary>The type's filter fields that actually split these options (2 to 24 distinct values).</summary>
    private List<Facet> Facets()
    {
        var facets = new List<Facet>();
        foreach (var key in Type?.FilterFields ?? new List<string>())
        {
            var values = shownOptions.SelectMany(o => FacetValues(o.Shown, key)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            values = values.All(v => int.TryParse(v, out _))
                ? values.OrderBy(int.Parse).ToList()
                : values.OrderBy(v => v, StringComparer.OrdinalIgnoreCase).ToList();
            if (values.Count < 2 || values.Count > 24) continue;
            var label = Type?.Fields.FirstOrDefault(f => f.Key == key)?.Label ?? key;
            facets.Add(new Facet(key, label, values));
        }

        return facets;
    }

    private static IEnumerable<string> FacetValues(ContentEntry entry, string key)
    {
        if (!entry.Properties.TryGetValue(key, out var value) || value == null) yield break;
        if (value is IEnumerable<object> list && value is not string)
        {
            foreach (var item in list.Select(i => i?.ToString()).Where(i => !string.IsNullOrWhiteSpace(i))) yield return item!;
        }
        else if (!string.IsNullOrWhiteSpace(value.ToString())) yield return value.ToString()!;
    }

    // A translated list still finds "Fireball" by its English name.
    private List<ContentEntry> Matching() =>
        shownOptions.Where(o => (query.Length == 0 || o.Shown.Name.Contains(query, StringComparison.OrdinalIgnoreCase) || o.Original.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
                                && filters.All(f => FacetValues(o.Shown, f.Key).Contains(f.Value, StringComparer.OrdinalIgnoreCase)))
            .Select(o => o.Shown)
            .ToList();

    private void SetFacet(string key, string? value)
    {
        if (string.IsNullOrEmpty(value)) filters.Remove(key);
        else filters[key] = value;
        visible = PageSize;
    }

    private string Summary(ContentEntry entry)
    {
        var parts = new List<string>();
        foreach (var key in Type?.SummaryFields ?? new List<string>())
        {
            if (entry.Properties.TryGetValue(key, out var value) && value != null)
            {
                parts.Add(value is IEnumerable<object> list && value is not string ? string.Join(", ", list.Select(o => DisplayValue(key, o?.ToString() ?? string.Empty))) : DisplayValue(key, value.ToString() ?? string.Empty));
            }
        }

        return parts.Count == 0 ? string.Empty : "· " + string.Join(" · ", parts);
    }
}
