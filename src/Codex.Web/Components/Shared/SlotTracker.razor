@using Codex.Plugin.Abstractions

@* Expendable slot pools (spell slots, pact slots...) declared by the system's sheetRules.slotPools:
   one row per slot level with the remaining count, Use / Regain buttons, and one button per rest
   that refills them. The owner decides where values come from and where changes go, so the same
   tracker serves the sheet (edits the sheet) and the live table (enqueues runtime commands). *@

@{
    var pools = Pools.Select(p => (Rule: p, Levels: Levels(p))).Where(p => p.Levels.Count > 0).ToList();
}
@if (pools.Count > 0)
{
    <div class="slot-tracker" data-testid="slot-tracker" aria-label="@(Title ?? L["Actor.Slots.Title"])" role="group">
        @foreach (var (rule, levels) in pools)
        {
            <div class="mb-2" data-testid="slot-pool-@rule.Key">
                @if (pools.Count > 1)
                {
                    <div class="field-label">@PoolName(rule.Label)</div>
                }
                <ul class="list-unstyled mb-0">
                    @foreach (var level in levels)
                    {
                        var key = rule.KeyFor(level);
                        var max = Value(rule.MaxKeyFor(level)) ?? 0;
                        var current = Math.Clamp(Value(key) ?? max, 0, max);
                        var label = $"level {level} {Singular(rule.Label)}";
                        <li class="slot-row" data-testid="slot-row-@key">
                            <span class="slot-level">@L["Actor.Slots.Level", level]</span>
                            <span class="slot-pips" aria-hidden="true">
                                @for (var i = 0; i < max; i++)
                                {
                                    <span class="slot-pip @(i < current ? "slot-pip-full" : "")"></span>
                                }
                            </span>
                            <span class="small" data-testid="slot-count-@key"><span class="visually-hidden">@L["Actor.Slots.LevelHidden", PoolName(rule.Label), level]</span>@L["Actor.Slots.Count", current, max]</span>
                            @if (!ReadOnly)
                            {
                                <span class="ms-auto d-flex gap-1">
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Disabled="@(current <= 0)" data-testid="@($"slot-use-{key}")"
                                            aria-label="@UseAria(rule.Label, level)" OnClick="() => OnAdjust.InvokeAsync((key, -1, label))">@L["Actor.Slots.Use"]</CodexButton>
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Disabled="@(current >= max)" data-testid="@($"slot-regain-{key}")"
                                            aria-label="@RegainAria(rule.Label, level)" @onclick="() => OnAdjust.InvokeAsync((key, 1, label))">@L["Actor.Slots.Regain"]</CodexButton>
                                </span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (!ReadOnly)
        {
            var rests = pools.SelectMany(p => p.Rule.RecoversOn).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            @if (rests.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var rest in rests)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" data-testid="@($"rest-{rest.Replace(' ', '-').ToLowerInvariant()}")"
                                OnClick="() => OnRest.InvokeAsync((rest, RestoredBy(pools.Select(p => p.Rule), rest)))">@RestName(rest)</CodexButton>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<SlotPoolRule> Pools { get; set; } = Array.Empty<SlotPoolRule>();

    /// <summary>Reads a slot key's value ("slots_3" or "slots_3_Max"), or null when absent.</summary>
    [Parameter, EditorRequired] public Func<string, int?> Value { get; set; } = _ => null;

    /// <summary>All keys present, to find which slot levels exist.</summary>
    [Parameter, EditorRequired] public IEnumerable<string> Keys { get; set; } = Array.Empty<string>();

    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? Title { get; set; }

    /// <summary>(key, delta, readable label) for a Use or Regain.</summary>
    [Parameter] public EventCallback<(string Key, int Delta, string Label)> OnAdjust { get; set; }

    /// <summary>(rest name, keys it refills).</summary>
    [Parameter] public EventCallback<(string Name, List<string> Keys)> OnRest { get; set; }

    private List<int> Levels(SlotPoolRule rule) =>
        Keys.Where(k => rule.Owns(k) && k.EndsWith("_Max", StringComparison.Ordinal))
            .Select(k => int.Parse(k[(rule.Key.Length + 1)..^4]))
            .Where(level => (Value(rule.MaxKeyFor(level)) ?? 0) > 0)
            .Distinct()
            .OrderBy(l => l)
            .ToList();

    private List<string> RestoredBy(IEnumerable<SlotPoolRule> rules, string rest) =>
        rules.Where(r => r.RecoversOn.Contains(rest, StringComparer.OrdinalIgnoreCase))
            .SelectMany(r => Levels(r).Select(r.KeyFor))
            .ToList();

    /// <summary>A panel heading: the pool's own name ("Spell slots") when only one pool applies.</summary>
    public static string Heading(IEnumerable<SlotPoolRule> pools, IEnumerable<string> keys)
    {
        // Static, so it reads the ambient UI culture rather than the injected localizer.
        var text = new Localizer();
        var present = pools.Where(p => keys.Any(p.Owns)).ToList();
        return present.Count == 1 ? PoolName(text, present[0].Label) : text["Actor.Slots.Title"];
    }

    /// <summary>The pool's own name, translated for the two pools the bundled system declares; any other name is the system's own wording.</summary>
    private static string PoolName(Localizer text, string label) => label switch
    {
        "Spell slots" => text["Actor.Slots.SpellSlots"],
        "Pact slots" => text["Actor.Slots.PactSlots"],
        _ => label
    };

    private string PoolName(string label) => PoolName(L, label);

    /// <summary>The rest's name, translated for the two rests the bundled system declares.</summary>
    public static string RestName(Localizer text, string rest) => rest switch
    {
        "Long Rest" => text["Actor.Slots.LongRest"],
        "Short Rest" => text["Actor.Slots.ShortRest"],
        _ => rest
    };

    private string RestName(string rest) => RestName(L, rest);

    private string UseAria(string poolLabel, int level) => poolLabel switch
    {
        "Spell slots" => L["Actor.Slots.UseSpell", level],
        "Pact slots" => L["Actor.Slots.UsePact", level],
        _ => L["Actor.Slots.UseOther", level, Singular(poolLabel)]
    };

    private string RegainAria(string poolLabel, int level) => poolLabel switch
    {
        "Spell slots" => L["Actor.Slots.RegainSpell", level],
        "Pact slots" => L["Actor.Slots.RegainPact", level],
        _ => L["Actor.Slots.RegainOther", level, Singular(poolLabel)]
    };

    /// <summary>"Spell slots" → "spell slot": the canonical English label sent with Use/Regain (it is stored in the table log).</summary>
    private static string Singular(string label)
    {
        var lower = label.ToLowerInvariant();
        return lower.EndsWith('s') ? lower[..^1] : lower;
    }
}
