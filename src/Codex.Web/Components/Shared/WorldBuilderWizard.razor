@using Codex.Core
@using Codex.Core.WorldBuilder
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Components.Campaign
@using Codex.Web.Services
@inject WorldBuilderService Builder
@inject IJSRuntime JS

@* The world builder (docs/WORLD_BUILDER.md) in the homebrew wizard's frame: the recipe's questions, then the drafts the AI
   proposes (tick, rename, write each one in full), then Save. Nothing is stored before Save, and what Save stores starts
   hidden from players. DM only; the caller shows the entry point only when the DM has a text model set up. *@

<dialog id="@dialogId" class="codex-dialog wizard-dialog" aria-labelledby="@(dialogId)-title" @oncancel="CancelAsync" data-testid="world-builder">
    @if (recipe != null)
    {
        <div class="wizard">
            <header class="wizard-head">
                <div>
                    <div class="label-caps"><LucideIcon IconName="@recipe.Icon" Size="14" /> @L["WorldBuilder.Title"]</div>
                    <h2 id="@(dialogId)-title">@RecipeText("Title")</h2>
                </div>
                <CodexButton Variant="CodexButtonVariant.Rune" Icon="x" Label="@L["WorldBuilder.Close"]" OnClick="CancelAsync" />
            </header>

            <nav class="wizard-steps" aria-label="@L["WorldBuilder.Steps"]">
                <ol>
                    @for (var i = 0; i < StepKeys.Length; i++)
                    {
                        var index = i;
                        var state = index == current ? "current" : index < current || (index == 1 && bundle != null) ? "done" : "";
                        <li>
                            <button type="button" class="wizard-step @state" aria-current="@(index == current ? "step" : null)" disabled="@(!CanGoTo(index))" @onclick="() => GoTo(index)" data-testid="world-step-@StepKeys[index]">
                                <span class="wizard-step-num" aria-hidden="true">@if (state == "done") { <LucideIcon IconName="check" Size="14" /> } else { @(index + 1) }</span>
                                <span class="wizard-step-label">@StepLabel(index)</span>
                            </button>
                        </li>
                    }
                </ol>
            </nav>

            <section class="wizard-body" aria-labelledby="@(dialogId)-step" aria-busy="@(busy != null ? "true" : "false")">
                <h3 id="@(dialogId)-step" class="wizard-step-title">@StepLabel(current)</h3>

                @switch (StepKeys[current])
                {
                    case "questions":
                        <p class="small-muted">@RecipeText("Intro")</p>
                        <div class="field-grid mb-3">
                            @foreach (var question in recipe.Questions)
                            {
                                var q = question;
                                var id = $"{dialogId}-q-{q.Key}";
                                var hintKey = $"WorldBuilder.Recipe.{recipe.Key}.{q.Key}.Hint";
                                <div class="@(q.Type is QuestionTypes.LongText or QuestionTypes.Toggle ? "field-wide" : "")">
                                    @if (q.Type == QuestionTypes.Toggle)
                                    {
                                        <div class="field-check">
                                            <input id="@id" type="checkbox" class="field-box" checked="@(Answer(q) == "true")" @onchange="e => SetToggle(q, e)" data-testid="world-q-@q.Key" />
                                            <label for="@id">@QuestionText(q)</label>
                                        </div>
                                    }
                                    else
                                    {
                                        <label for="@id" class="field-label">@QuestionText(q) @if (q.Required) { <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["WorldBuilder.Required"]</span> }</label>
                                        @switch (q.Type)
                                        {
                                            case QuestionTypes.ContentType:
                                                <select id="@id" class="field-select" value="@Answer(q)" @onchange="e => answers[q.Key] = e.Value?.ToString()" required="@q.Required" data-testid="world-q-@q.Key">
                                                    <option value="">@L["WorldBuilder.ChooseType"]</option>
                                                    @foreach (var type in types)
                                                    {
                                                        <option value="@type.Type">@type.Label</option>
                                                    }
                                                </select>
                                                break;
                                            case QuestionTypes.Choice:
                                                <select id="@id" class="field-select" value="@Answer(q)" @onchange="e => answers[q.Key] = e.Value?.ToString()" data-testid="world-q-@q.Key">
                                                    <option value="">@(q.Surprise ? L["WorldBuilder.Surprise"] : L["WorldBuilder.NoPreference"])</option>
                                                    @foreach (var option in q.Options)
                                                    {
                                                        <option value="@option">@OptionText(q, option)</option>
                                                    }
                                                </select>
                                                break;
                                            case QuestionTypes.LongText:
                                                <textarea id="@id" class="field-input" rows="3" value="@Answer(q)" @oninput="e => answers[q.Key] = e.Value?.ToString()" placeholder="@(q.Surprise ? L["WorldBuilder.SurpriseText"] : null)" data-testid="world-q-@q.Key"></textarea>
                                                break;
                                            default:
                                                <input id="@id" class="field-input" value="@Answer(q)" @oninput="e => answers[q.Key] = e.Value?.ToString()" placeholder="@(q.Surprise ? L["WorldBuilder.SurpriseText"] : null)" maxlength="300" data-testid="world-q-@q.Key" />
                                                break;
                                        }
                                    }
                                    @if (L.Has(hintKey))
                                    {
                                        <div class="field-hint">@L[hintKey]</div>
                                    }
                                </div>
                            }
                        </div>
                        break;

                    case "drafts":
                        @if (bundle == null)
                        {
                            <p class="small-muted">@L["WorldBuilder.Drafts.Empty"]</p>
                        }
                        else
                        {
                            <p class="small-muted">@L["WorldBuilder.Drafts.Intro"]</p>
                            <div class="d-flex gap-2 flex-wrap mb-3">
                                <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" Icon="feather" OnClick="WriteAllAsync" Disabled="@(busy != null || !bundle.Drafts.Any(d => d.Selected && !d.Expanded))" data-testid="world-write-all">@L["WorldBuilder.Drafts.WriteAll"]</CodexButton>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="refresh-cw" OnClick="OutlineAsync" Disabled="@(busy != null)" data-testid="world-new-ideas">@L["WorldBuilder.Drafts.NewIdeas"]</CodexButton>
                            </div>
                            <ul class="world-drafts">
                                @foreach (var item in bundle.Drafts)
                                {
                                    var d = item;
                                    var nameId = $"{dialogId}-name-{d.Ref}";
                                    <li class="world-draft @(d.Selected ? "" : "is-off") @(focused == d ? "is-focused" : "")" data-testid="world-draft">
                                        <div class="world-draft-head">
                                            <input type="checkbox" class="field-box" checked="@d.Selected" @onchange="e => d.Selected = (bool)(e.Value ?? false)" aria-label="@L["WorldBuilder.Drafts.Keep", d.Name]" data-testid="world-draft-keep" />
                                            <span class="world-draft-kind label-caps">@KindLabel(d)</span>
                                            @if (d.Expanded)
                                            {
                                                <span class="world-draft-state small-muted"><LucideIcon IconName="circle-check" Size="14" /> @L["WorldBuilder.Drafts.Written"]</span>
                                            }
                                        </div>
                                        <label for="@nameId" class="visually-hidden">@L["WorldBuilder.Drafts.Name"]</label>
                                        <input id="@nameId" class="field-input world-draft-name" value="@d.Name" @oninput="e => d.Name = e.Value?.ToString() ?? string.Empty" maxlength="200" data-testid="world-draft-name" />
                                        <p class="small mb-2">@d.Pitch</p>
                                        @if (d.Kind == DraftKinds.Npc)
                                        {
                                            var castId = $"{dialogId}-cast-{d.Ref}";
                                            <div class="field-check mb-2">
                                                <input id="@castId" type="checkbox" class="field-box" checked="@d.Cast" disabled="@(!d.Selected)" @onchange="e => d.Cast = (bool)(e.Value ?? false)" data-testid="world-draft-cast" />
                                                <label for="@castId" class="small">@L["WorldBuilder.Drafts.Cast"]</label>
                                            </div>
                                        }
                                        <div class="d-flex gap-2 flex-wrap">
                                            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="@(d.Expanded ? "refresh-cw" : "feather")" OnClick="() => WriteAsync(d)" Disabled="@(busy != null || !d.Selected)" data-testid="world-draft-write">
                                                @(busy == d ? L["WorldBuilder.Drafts.Writing"] : d.Expanded ? L["WorldBuilder.Drafts.Rewrite"] : L["WorldBuilder.Drafts.Write"])
                                            </CodexButton>
                                            @if (d.Expanded)
                                            {
                                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="eye" OnClick="() => focused = d">@L["WorldBuilder.Drafts.Show"]</CodexButton>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            @if (bundle.Dropped.Count > 0)
                            {
                                <p class="small-muted mt-2 mb-0" data-testid="world-dropped">@L["WorldBuilder.Drafts.Dropped", bundle.Dropped.Count]</p>
                            }
                        }
                        break;

                    case "save":
                        @if (bundle != null)
                        {
                            <ul class="wizard-checklist">
                                @foreach (var d in bundle.Drafts.Where(d => d.Selected))
                                {
                                    <li class="@(d.Expanded ? "done" : "")">
                                        <LucideIcon IconName="@(d.Expanded ? "circle-check" : "circle")" Size="16" />
                                        <span>@d.Name</span>
                                        <span class="small-muted">@KindLabel(d)@(d.Kind == DraftKinds.Npc && d.Cast ? " · " + L["WorldBuilder.Save.AlsoCast"] : "")@(d.Expanded ? "" : " · " + L["WorldBuilder.Save.PitchOnly"])</span>
                                    </li>
                                }
                            </ul>
                            <p class="small-muted mb-0">@L["WorldBuilder.Save.Note"]</p>
                        }
                        break;
                }

                @if (busy != null)
                {
                    <p class="small-muted mt-3 mb-0" role="status"><LucideIcon IconName="sparkles" Size="14" /> @(busy is WorldDraft writing ? L["WorldBuilder.Busy.Writing", writing.Name] : L["WorldBuilder.Busy.Outline"])</p>
                }
                @if (error != null)
                {
                    <p class="text-danger mt-3 mb-0" role="alert">@error</p>
                }
            </section>

            <aside class="wizard-preview" aria-label="@L["WorldBuilder.Preview"]">
                <div class="label-caps mb-2"><LucideIcon IconName="eye" Size="14" /> @L["WorldBuilder.Preview"]</div>
                @if (focused is { Kind: DraftKinds.Homebrew } shownEntry)
                {
                    <EntryDetail Item="PreviewItem(shownEntry)" Type="PreviewType(shownEntry)" />
                }
                else if (focused is { Kind: DraftKinds.Fact } shownFact)
                {
                    <h2 class="h6">@shownFact.Name</h2>
                    <p class="mb-0">@WorldBundleParser.ResolveLinks(shownFact.Body ?? shownFact.Pitch, bundle!, keepLinks: false)</p>
                }
                else if (focused is { Kind: DraftKinds.Wiki or DraftKinds.Npc } shownPage)
                {
                    <h2 class="h5">@shownPage.Name</h2>
                    @* Links are shown as their text: a link inside the dialog would navigate away from the unsaved drafts. *@
                    <div class="rules-text wiki-body">@((MarkupString)WikiText.ToHtml(WorldBundleParser.ResolveLinks(shownPage.Body ?? shownPage.Pitch, bundle!, keepLinks: false), _ => null))</div>
                }
                else
                {
                    <p class="small-muted mb-0">@L["WorldBuilder.PreviewEmpty"]</p>
                }
            </aside>

            <footer class="wizard-foot">
                <div class="d-flex gap-2">
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CancelAsync">@L["Common.Cancel"]</CodexButton>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <CodexButton Variant="CodexButtonVariant.Etched" Icon="arrow-left" OnClick="() => GoTo(current - 1)" Disabled="@(current == 0 || busy != null)" data-testid="world-back">@L["Common.Back"]</CodexButton>
                    @switch (StepKeys[current])
                    {
                        case "questions":
                            <CodexButton Variant="CodexButtonVariant.Plaque" Class="cx-arcane" Icon="sparkles" OnClick="OutlineAsync" Disabled="@(busy != null)" data-testid="world-outline">@(bundle == null ? L["WorldBuilder.Outline"] : L["WorldBuilder.OutlineAgain"])</CodexButton>
                            @if (bundle != null)
                            {
                                <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => GoTo(1)" Disabled="@(busy != null)">@L["WorldBuilder.Next", StepLabel(1)] <LucideIcon IconName="arrow-right" Size="18" /></CodexButton>
                            }
                            break;
                        case "drafts":
                            <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="() => GoTo(2)" Disabled="@(busy != null || !AnySelected)" data-testid="world-next">@L["WorldBuilder.Next", StepLabel(2)] <LucideIcon IconName="arrow-right" Size="18" /></CodexButton>
                            break;
                        default:
                            <CodexButton Variant="CodexButtonVariant.Plaque" Icon="check" OnClick="SaveAsync" Disabled="@(busy != null || saving || !AnySelected)" data-testid="world-save">@(saving ? L["WorldBuilder.Saving"] : L["WorldBuilder.Save"])</CodexButton>
                            break;
                    }
                </div>
            </footer>
        </div>
    }
</dialog>

<ConfirmDialog @ref="confirm" />

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    /// <summary>Called with what was stored after a successful save.</summary>
    [Parameter] public EventCallback<WorldBuildResult> OnSaved { get; set; }

    private static readonly string[] StepKeys = { "questions", "drafts", "save" };

    private readonly string dialogId = "wbw-" + Guid.NewGuid().ToString("N")[..6];
    private ConfirmDialog confirm = null!;
    private WorldRecipe? recipe;
    private Dictionary<string, string?> answers = new();
    private IReadOnlyList<ContentTypeDefinition> types = Array.Empty<ContentTypeDefinition>();
    private WorldBundle? bundle;
    private WorldDraft? focused;
    private int current;
    private string? error;
    private bool saving;

    /// <summary>The draft being written, or this component itself while the outline is drafted; null when idle.</summary>
    private object? busy;

    /// <summary>Opens the wizard on <paramref name="recipeKey"/>, with answers filled in from the caller (the Library's current type, say).</summary>
    public async Task OpenAsync(string recipeKey, IReadOnlyDictionary<string, string?>? preset = null)
    {
        recipe = WorldRecipes.Find(recipeKey) ?? throw new ArgumentException($"No world-builder recipe \"{recipeKey}\".", nameof(recipeKey));
        types = await Builder.TypesAsync(Ctx.Campaign, Ctx.Access);
        answers = recipe.Questions.ToDictionary(q => q.Key, q => q.Default);
        foreach (var (key, value) in preset ?? new Dictionary<string, string?>())
        {
            if (recipe.Question(key) != null && !string.IsNullOrEmpty(value)) answers[key] = value;
        }

        bundle = null;
        focused = null;
        current = 0;
        error = null;
        saving = false;
        busy = null;
        StateHasChanged();
        await JS.InvokeVoidAsync("codex.showModal", dialogId);
        await JS.InvokeVoidAsync("codex.focus", $"{dialogId}-q-{recipe.Questions[0].Key}");
    }

    private bool AnySelected => bundle?.Drafts.Any(d => d.Selected && !string.IsNullOrWhiteSpace(d.Name)) == true;

    private bool CanGoTo(int index) => busy == null && (index == 0 || (bundle != null && (index == 1 || AnySelected)));

    private void GoTo(int index)
    {
        if (index < 0 || index >= StepKeys.Length || !CanGoTo(index)) return;
        error = null;
        current = index;
    }

    private string StepLabel(int index) => StepKeys[index] switch
    {
        "questions" => L["WorldBuilder.Step.Questions"],
        "drafts" => L["WorldBuilder.Step.Drafts"],
        _ => L["WorldBuilder.Step.Save"]
    };

    // Recipe and question labels are keyed by the recipe's own keys (WorldBuilder.Recipe.<recipe>.<question>[.<option>]);
    // WorldBuilderRecipeTests checks that every one exists in every language.
    private string RecipeText(string part) => L[$"WorldBuilder.Recipe.{recipe!.Key}.{part}"];
    private string QuestionText(RecipeQuestion q) => L[$"WorldBuilder.Recipe.{recipe!.Key}.{q.Key}"];
    private string OptionText(RecipeQuestion q, string option) => L[$"WorldBuilder.Recipe.{recipe!.Key}.{q.Key}.{option}"];

    private void SetToggle(RecipeQuestion q, ChangeEventArgs e) => answers[q.Key] = e.Value is true ? "true" : "false";

    private string? Answer(RecipeQuestion q) => answers.TryGetValue(q.Key, out var value) ? value : null;

    private string KindLabel(WorldDraft draft) => draft.Kind switch
    {
        DraftKinds.Homebrew => types.FirstOrDefault(t => string.Equals(t.Type, draft.Type, StringComparison.OrdinalIgnoreCase))?.Label ?? CampaignLibrary.Humanize(draft.Type ?? string.Empty),
        DraftKinds.Npc => L["WorldBuilder.Kind.Npc"],
        DraftKinds.Fact => L["WorldBuilder.Kind.Fact"],
        _ => L["WorldBuilder.Kind.Wiki"]
    };

    private ContentTypeDefinition? PreviewType(WorldDraft draft) => types.FirstOrDefault(t => string.Equals(t.Type, draft.Type, StringComparison.OrdinalIgnoreCase));

    private LibraryItem PreviewItem(WorldDraft draft)
    {
        var entry = new HomebrewEntryDocument
        {
            CampaignId = Ctx.Campaign.Id,
            SystemId = Ctx.Campaign.SystemId,
            Type = draft.Type ?? string.Empty,
            EntryId = RavenHomebrewRepository.Slugify(draft.Name),
            Name = draft.Name,
            Description = WorldBundleParser.ResolveLinks(draft.Body ?? draft.Pitch, bundle!, keepLinks: false),
            Tags = draft.Tags,
            Properties = draft.Properties,
            IsPublished = false
        };
        return new LibraryItem(entry.ToEntry(), null, entry);
    }

    private async Task OutlineAsync()
    {
        if (recipe == null || busy != null) return;
        var missing = recipe.Questions.FirstOrDefault(q => q.Required && string.IsNullOrWhiteSpace(Answer(q)));
        if (missing != null)
        {
            current = 0;
            error = L["WorldBuilder.Error.Answer", QuestionText(missing)];
            await JS.InvokeVoidAsync("codex.focus", $"{dialogId}-q-{missing.Key}");
            return;
        }

        if (bundle?.Drafts.Any(d => d.Expanded) == true
            && !await confirm.ShowAsync(L["WorldBuilder.Replace.Title"], L["WorldBuilder.Replace.Body"], L["WorldBuilder.Replace.Confirm"], isDestructive: true, cancel: L["WorldBuilder.Replace.Keep"]))
        {
            return;
        }

        await RunAsync(this, async () =>
        {
            bundle = await Builder.OutlineAsync(Ctx.Campaign, Ctx.Access, recipe, answers);
            focused = null;
            current = 1;
        });
    }

    private Task WriteAsync(WorldDraft draft) => RunAsync(draft, async () =>
    {
        await Builder.ExpandAsync(Ctx.Campaign, Ctx.Access, recipe!, answers, bundle!, draft);
        focused = draft;
    });

    private async Task WriteAllAsync()
    {
        foreach (var draft in bundle!.Drafts.Where(d => d.Selected && !d.Expanded).ToList())
        {
            await WriteAsync(draft);
            if (error != null) return;
        }
    }

    private async Task RunAsync(object what, Func<Task> work)
    {
        busy = what;
        error = null;
        StateHasChanged();
        try
        {
            await work();
        }
        catch (AiNotConfiguredException)
        {
            error = L["WorldBuilder.Error.NotConfigured"];
        }
        catch (Exception ex)
        {
            error = L["WorldBuilder.Error.Failed", L.Describe(ex)];
        }
        finally
        {
            busy = null;
        }
    }

    private async Task SaveAsync()
    {
        if (recipe == null || bundle == null || saving) return;
        saving = true;
        error = null;
        try
        {
            var result = await Builder.SaveAsync(Ctx.Campaign, Ctx.Access, recipe, bundle);
            await JS.InvokeVoidAsync("codex.closeModal", dialogId);
            recipe = null;
            bundle = null;
            await OnSaved.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            error = L["WorldBuilder.Error.Failed", L.Describe(ex)];
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (bundle != null && !await confirm.ShowAsync(L["WorldBuilder.Discard.Title"], L["WorldBuilder.Discard.Body"], L["WorldBuilder.Discard.Confirm"], isDestructive: true, cancel: L["WorldBuilder.Discard.Keep"]))
        {
            // Browsers may close a dialog on Escape regardless; put it back.
            await JS.InvokeVoidAsync("codex.showModal", dialogId);
            return;
        }

        await JS.InvokeVoidAsync("codex.closeModal", dialogId);
        recipe = null;
        bundle = null;
    }
}
