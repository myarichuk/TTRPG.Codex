@using Codex.Core
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Services
@inject CampaignLibrary Library
@inject IContentRegistry Registry
@inject ISystemCatalog Catalog
@inject NavigationManager Nav
@inject IJSRuntime JS

@* The content browser: type chips, a search box, a result list and a detail pane. Works for a
   campaign (packs the campaign enabled + homebrew) and for the global, read-only Library (/library)
   when Campaign is null. Selection is kept in the URL via BasePath so entries are linkable. *@

<div class="toolbar">
    <div class="search">
        <LucideIcon IconName="search" Size="18" Class="search-icon" />
        <label for="@searchId" class="visually-hidden">@L["Library.Browser.Search", TypeLabel(selectedType) ?? L["Library.Browser.Content"]]</label>
        <input id="@searchId" type="search" class="field-input" placeholder="@L["Library.Browser.SearchPlaceholder"]"
               value="@query" @oninput="OnQueryChanged" autocomplete="off" data-testid="library-search" />
    </div>
    @if (ShowResultCount)
    {
        <span class="small-muted" role="status">@(results.Count > shown ? L["Library.Browser.Showing", shown, results.Count] : L["Library.Browser.Results", results.Count])</span>
    }
</div>

<div class="chips mb-3" role="group" aria-label="@L["Library.Browser.ContentType"]">
    <button type="button" class="chip" aria-pressed="@((selectedType == null) ? "true" : "false")" @onclick="() => SelectTypeAsync(null)">@L["Library.Browser.All"]</button>
    @foreach (var type in types)
    {
        <button type="button" class="chip" aria-pressed="@((selectedType == type.Type) ? "true" : "false")" data-testid="library-type-@type.Type" @onclick="() => SelectTypeAsync(type.Type)">
            @type.PluralOrLabel
        </button>
    }
</div>

<div class="row g-3">
    <div class="col-lg-5">
        @if (loading)
        {
            <LoadingSkeleton />
        }
        else if (results.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon"><LucideIcon IconName="book-open" Size="28" /></div>
                <h3>@L["Library.Browser.NothingMatches"]</h3>
                <p>@(string.IsNullOrWhiteSpace(query) ? L["Library.Browser.EmptyType"] : L["Library.Browser.TryDifferent"])</p>
            </div>
        }
        else
        {
            <ul class="list-unstyled mb-0" data-testid="library-results">
                @foreach (var item in results.Take(shown))
                {
                    var isSelected = selected != null && selected.Entry.Type == item.Entry.Type && selected.Entry.Id == item.Entry.Id && selected.IsHomebrew == item.IsHomebrew;
                    var ariaCurrent = isSelected ? "true" : null;
                    var link = LinkTo(item);
                    <li class="list-row">
                        <div class="row-main">
                            <div class="row-title">
                                @if (DomainIconMap.Subject(item.Entry) is { } subject)
                                {
                                    <span class="row-glyph" title="@subject.Label"><DomainIcon Domain="@subject.Domain" Key="@subject.Key" Size="DomainIconSize.Small" /></span>
                                }
                                <a href="@link" aria-current="@ariaCurrent" data-testid="library-item">@item.Entry.Name</a>
                                @if (item.IsHomebrew)
                                {
                                    <span class="pill pill-accent ms-1">@L["Library.Homebrew"]</span>
                                }
                            </div>
                            <div class="row-sub">@Summary(item)</div>
                        </div>
                        <span class="pill"><DomainIcon Domain="kind" Key="@item.Entry.Type" Size="DomainIconSize.Small" /> @TypeLabel(item.Entry.Type)</span>
                    </li>
                }
            </ul>
            @if (results.Count > shown)
            {
                <div class="load-more">
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => shown += PageSize" data-testid="library-more">@L["Library.ShowMore", Math.Min(PageSize, results.Count - shown)]</CodexButton>
                </div>
            }
        }
    </div>
    @if (selected != null)
    {
        <div class="col-lg-7 library-detail-col phone-sheet">
            <SheetBar Title="@selected.Entry.Name" CloseHref="@CloseHref" CloseLabel="@L["Library.Browser.CloseDetail"]" />
            <div class="panel" id="@detailId" tabindex="-1" data-testid="library-detail">
                <EntryDetail Item="selected" Type="@TypeDefinition(selected.Entry.Type)" Art="@(DetailArt?.Invoke(selected))">
                    <Actions>
                        @if (DetailActions != null)
                        {
                            @DetailActions(selected)
                        }
                        <a href="@CloseHref" class="cx-btn cx-etched cx-sm" aria-label="@L["Library.Browser.CloseDetail"]">
                            <LucideIcon IconName="x" Size="14" /> @L["Common.Close"]
                        </a>
                    </Actions>
                </EntryDetail>
                @if (DetailFooter != null)
                {
                    @DetailFooter(selected)
                }
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-7 d-none d-lg-block library-detail-col">
            <div class="empty empty-quiet" data-testid="library-placeholder">
                <div class="empty-icon"><LucideIcon IconName="book-open" Size="28" /></div>
                <p>@L["Library.Browser.ChooseEntry"]</p>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Null for the global library (packs only, no homebrew).</summary>
    [Parameter] public CampaignDocument? Campaign { get; set; }
    [Parameter] public CampaignAccess? Access { get; set; }

    /// <summary>System to browse when there is no campaign.</summary>
    [Parameter] public string? SystemId { get; set; }

    /// <summary>URL prefix selections are written under, e.g. "/campaigns/{id}/library".</summary>
    [Parameter, EditorRequired] public string BasePath { get; set; } = string.Empty;

    /// <summary>Type and entry id taken from the route, so the browser can show a deep-linked entry.</summary>
    [Parameter] public string? RouteType { get; set; }
    [Parameter] public string? RouteId { get; set; }

    [Parameter] public RenderFragment<LibraryItem>? DetailActions { get; set; }
    /// <summary>When set, shown in the detail pane instead of the selected entry (the homebrew editor).</summary>
    /// <summary>The art slot for the selected entry (campaign Library only).</summary>
    [Parameter] public RenderFragment<LibraryItem>? DetailArt { get; set; }
    /// <summary>Shown under the selected entry's detail (the session notes that mention it).</summary>
    [Parameter] public RenderFragment<LibraryItem>? DetailFooter { get; set; }
    [Parameter] public bool ShowResultCount { get; set; } = true;

    /// <summary>Incremented by the host to force a reload (e.g. after homebrew changed).</summary>
    [Parameter] public int Version { get; set; }

    private const int PageSize = 150;
    private int shown = PageSize;
    private readonly string searchId = "lib-search-" + Guid.NewGuid().ToString("N")[..6];
    private readonly string detailId = "lib-detail-" + Guid.NewGuid().ToString("N")[..6];
    // The entry the detail last moved focus to, so a re-render of the same entry doesn't move it again.
    private string? focusedKey;
    private List<ContentTypeDefinition> types = new();
    private List<LibraryItem> results = new();
    private LibraryItem? selected;
    private string? selectedType;
    private string query = string.Empty;
    private bool loading = true;
    private int lastVersion = -1;
    private string? lastRouteKey;
    private CancellationTokenSource? debounce;

    private string EffectiveSystemId => Campaign?.SystemId ?? SystemId ?? string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var routeKey = $"{EffectiveSystemId}|{RouteType}|{RouteId}|{Version}";
        if (routeKey == lastRouteKey && Version == lastVersion)
        {
            return;
        }

        lastRouteKey = routeKey;
        lastVersion = Version;

        types = await LoadTypesAsync();
        selectedType = RouteType != null && types.Any(t => t.Type == RouteType) ? RouteType : (RouteType == null ? selectedType : null);
        await SearchAsync();

        selected = null;
        if (RouteType != null && RouteId != null)
        {
            selected = await GetAsync(RouteType, RouteId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = selected == null ? null : $"{selected.Entry.Type}:{selected.Entry.Id}:{selected.IsHomebrew}";
        if (key == focusedKey) return;
        var closed = key == null;
        focusedKey = key;
        await JS.InvokeVoidAsync(closed ? "codex.sheetClosed" : "codex.focusSheet", detailId);
    }

    private async Task<List<ContentTypeDefinition>> LoadTypesAsync()
    {
        if (Campaign != null && Access != null)
        {
            return (await Library.TypesAsync(Campaign, Access)).Where(IsVisibleType).ToList();
        }

        var definition = Catalog.GetLocalizedDefinition(EffectiveSystemId);
        var declared = definition?.EntityTypes.ToList() ?? new List<ContentTypeDefinition>();
        var known = declared.Select(t => t.Type).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var extra = Registry.GetEntryTypes(EffectiveSystemId).Where(t => !known.Contains(t))
            .Select(t => new ContentTypeDefinition { Type = t, Label = CampaignLibrary.Humanize(t) });
        return declared.Concat(extra).Where(IsVisibleType).ToList();
    }

    /// <summary>Players don't get the monster manual in their picker list; the DM and the global library do.</summary>
    private bool IsVisibleType(ContentTypeDefinition type) => type.PlayerFacing || Access == null || Access.IsDm;

    private async Task SearchAsync()
    {
        loading = true;
        shown = PageSize;
        try
        {
            if (Campaign != null && Access != null)
            {
                results = (await Library.SearchAsync(Campaign, Access, query, selectedType, limit: 5000, culture: L.Culture.Name)).ToList();
            }
            else
            {
                results = Registry.Search(EffectiveSystemId, query, selectedType, limit: 5000, culture: L.Culture.Name)
                    .Select(e => new LibraryItem(e, Registry.GetPack(e.PackId), null))
                    .ToList();
            }

            // The rules glossary would bury the spells and creatures when browsing everything; it has its own tab,
            // and a search term still finds its entries.
            if (selectedType == null && string.IsNullOrWhiteSpace(query))
            {
                results = results.Where(r => !r.Entry.Type.Equals("rule", StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (Access is { IsDm: false })
            {
                var hidden = types.Where(t => !t.PlayerFacing).Select(t => t.Type).ToHashSet(StringComparer.OrdinalIgnoreCase);
                results = results.Where(r => !hidden.Contains(r.Entry.Type)).ToList();
            }
        }
        finally
        {
            loading = false;
        }
    }

    private async Task<LibraryItem?> GetAsync(string type, string id)
    {
        if (Campaign != null && Access != null)
        {
            return await Library.GetAsync(Campaign, Access, type, id, L.Culture.Name);
        }

        var entry = Registry.GetEntry(EffectiveSystemId, type, id);
        return entry == null ? null : new LibraryItem(Registry.Localize(entry, L.Culture.Name), Registry.GetPack(entry.PackId), null);
    }

    private async Task OnQueryChanged(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        var token = debounce.Token;
        try
        {
            await Task.Delay(150, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await SearchAsync();
        StateHasChanged();
    }

    private async Task SelectTypeAsync(string? type)
    {
        selectedType = type;
        selected = null;
        await SearchAsync();
        Nav.NavigateTo(BasePath + (type != null ? "/" + type : string.Empty));
    }

    private string CloseHref => BasePath + (selectedType != null ? "/" + selectedType : string.Empty);

    private string LinkTo(LibraryItem item) => $"{BasePath}/{item.Entry.Type}/{Uri.EscapeDataString(item.Entry.Id)}";

    private ContentTypeDefinition? TypeDefinition(string type) =>
        types.FirstOrDefault(t => string.Equals(t.Type, type, StringComparison.OrdinalIgnoreCase));

    private string? TypeLabel(string? type) => type == null ? null : TypeDefinition(type)?.Label ?? CampaignLibrary.Humanize(type);

    private string Summary(LibraryItem item)
    {
        var type = TypeDefinition(item.Entry.Type);
        var parts = new List<string>();
        foreach (var key in type?.SummaryFields ?? new List<string>())
        {
            if (item.Entry.Properties.TryGetValue(key, out var value) && value != null)
            {
                var field = type?.Fields.FirstOrDefault(f => f.Key == key);
                string? Shown(object? o) => o?.ToString() is { } raw ? field?.Display(raw) ?? raw : null;
                var text = value is IEnumerable<object> list ? string.Join(", ", list.Select(Shown)) : Shown(value);
                if (!string.IsNullOrWhiteSpace(text))
                {
                    var label = field?.Label ?? CampaignLibrary.Humanize(key);
                    parts.Add($"{label} {text}");
                }
            }
        }

        if (parts.Count == 0)
        {
            return TextFormatting.Summary(item.Entry.Description, 110);
        }

        return string.Join(" · ", parts);
    }
}
