@* One resolved roll: what it was for, each die as a face (dropped dice struck through), the modifier,
   and the total in display type. A natural 20 or 1 on the roll's one d20 check die is marked in words as well as colour.
   Rolls without a die breakdown (older entries, death saves, hit dice) show their text instead. *@

<div class="@Css" data-testid="dice-result">
    <div class="dice-head">
        @if (!string.IsNullOrEmpty(Label))
        {
            <strong class="dice-label">@Label</strong>
        }
        <span class="dice-expr small-muted"><bdi>@Expression</bdi></span>
        @if (Secret)
        {
            <span class="pill">@L["Actor.Dice.Secret"]</span>
        }
    </div>
    <div class="dice-body">
        @if (Kept.Count > 0 || Dropped.Count > 0)
        {
            <ul class="dice-faces" aria-label="@L["Actor.Dice.Faces"]">
                @for (var i = 0; i < Kept.Count; i++)
                {
                    var at = i;
                    var die = Kept[at];
                    <li class="@FaceClass(at)">@die@if (IsCrit(at)) {<span class="visually-hidden"> @L["Actor.Dice.Nat20"]</span>} else if (IsFumble(at)) {<span class="visually-hidden"> @L["Actor.Dice.Nat1"]</span>}</li>
                }
                @foreach (var die in Dropped)
                {
                    <li class="die die-dropped"><span class="visually-hidden">@L["Actor.Dice.Dropped"] </span>@die</li>
                }
            </ul>
            @if (Modifier != 0)
            {
                <span class="dice-mod" aria-label="@(Modifier > 0 ? L["Actor.Dice.Plus", Modifier] : L["Actor.Dice.Minus", -Modifier])">@(Modifier > 0 ? "+" : "−") @Math.Abs(Modifier)</span>
            }
        }
        else if (!string.IsNullOrEmpty(Text))
        {
            <span class="small-muted">@Text</span>
        }
        <span class="dice-total" aria-label="@L["Actor.Dice.Total", Total]">@Total</span>
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Expression { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<int> Kept { get; set; } = Array.Empty<int>();
    [Parameter] public IReadOnlyList<int> Dropped { get; set; } = Array.Empty<int>();
    [Parameter] public int Modifier { get; set; }
    [Parameter] public int Total { get; set; }
    /// <summary>The plain result text, shown when there are no dice to draw.</summary>
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool Secret { get; set; }
    /// <summary>The smaller row used in the log.</summary>
    [Parameter] public bool Compact { get; set; }

    private string Css => Compact ? "dice-result dice-compact" : "dice-result";

    /// <summary>Where in <see cref="Kept"/> the roll's d20 check die is; null when it has none.</summary>
    [Parameter] public int? CheckDieIndex { get; set; }

    // Rolls logged before the check die was recorded: a lone kept die from a plain d20 roll ("1d20+5", "adv"), never a d200 (R8).
    private static readonly System.Text.RegularExpressions.Regex PlainD20 = new(@"^\s*(?:1?d20(?!\d)|adv|dis)(?:\s*[+-]\s*\d+)*\s*$",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    // Only the d20 a check is read from gets crit/fumble marking; other dice have no such meaning.
    private int? CheckDie => CheckDieIndex ?? (Kept.Count == 1 && PlainD20.IsMatch(Expression) ? 0 : null);
    private bool IsCrit(int index) => index == CheckDie && Kept[index] == 20;
    private bool IsFumble(int index) => index == CheckDie && Kept[index] == 1;
    private string FaceClass(int index) => IsCrit(index) ? "die die-crit" : IsFumble(index) ? "die die-fumble" : "die";
}
