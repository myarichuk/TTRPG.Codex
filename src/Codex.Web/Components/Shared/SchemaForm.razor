@using Codex.Core
@using Codex.Plugin.Abstractions

@* Schema-driven form renderer: the web side of UISchema. Every control is labelled by a unique id
   (two forms on one page never collide), numbers honour min/max, dropdowns and reference pickers
   are real <select>s, tag lists are comma-separated, and Collection fields get a row editor. *@

@if (Schema.PreferredEditor != PreferredEditor.Form)
{
    <p class="small-muted"><em>This entity type is designed for a @Schema.PreferredEditor.ToString().ToLowerInvariant() editor, which is not available here.</em></p>
}
else
{
    @foreach (var group in Schema.Fields.Where(f => !HiddenKeys.Contains(f.Key)).GroupBy(f => f.Category ?? "General"))
    {
        <fieldset class="field-group">
            @if (ShowGroupHeadings)
            {
                <legend>@group.Key</legend>
            }
            <div class="field-grid">
                @foreach (var field in group)
                {
                    var controlId = ControlId(field);
                    var wide = field.Type is FieldType.LongText or FieldType.Collection;
                    <div class="@(wide ? "field-wide" : null)">
                        <label for="@controlId" class="field-label">
                            @field.Label
                            @if (field.IsRequired)
                            {
                                <span class="required-mark" aria-hidden="true">*</span>
                                <span class="visually-hidden">(required)</span>
                            }
                        </label>
                        @RenderField(field, controlId)
                        @if (!string.IsNullOrWhiteSpace(field.Description))
                        {
                            <div id="@(controlId)-help" class="field-hint">@field.Description</div>
                        }
                    </div>
                }
            </div>
        </fieldset>
    }
}

@code {
    [Parameter, EditorRequired]
    public UISchema Schema { get; set; } = null!;

    [Parameter, EditorRequired]
    public Dictionary<string, object> Values { get; set; } = new();

    [Parameter]
    public EventCallback<Dictionary<string, object>> ValuesChanged { get; set; }

    /// <summary>Options for EntityReference fields, by target type. Each option is (id, display name).</summary>
    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<(string Id, string Name)>>? ReferenceOptions { get; set; }

    /// <summary>Options for specific EntityReference fields, by field key; takes precedence over
    /// <see cref="ReferenceOptions"/>. This is how sheet rules narrow a picker (subclasses of the
    /// chosen class, the feat a background grants...).</summary>
    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<(string Id, string Name)>>? FieldOptions { get; set; }

    /// <summary>Field keys rendered elsewhere (e.g. attributes drawn as a grid) and skipped here.</summary>
    [Parameter]
    public IReadOnlySet<string> HiddenKeys { get; set; } = new HashSet<string>();

    [Parameter]
    public bool ShowGroupHeadings { get; set; } = true;

    [Parameter]
    public bool ReadOnly { get; set; }

    private readonly string prefix = "f" + Guid.NewGuid().ToString("N")[..6];

    private string ControlId(FieldDefinition field) => $"{prefix}-{field.Key}";

    private object? GetValue(FieldDefinition field) =>
        Values.TryGetValue(field.Key, out var value) ? value : field.DefaultValue;

    private async Task SetValueAsync(FieldDefinition field, object? value)
    {
        if (value == null || (value is string s && s.Length == 0))
        {
            Values.Remove(field.Key);
        }
        else
        {
            Values[field.Key] = value;
        }

        await ValuesChanged.InvokeAsync(Values);
    }

    private string? Describe(FieldDefinition field, string controlId) =>
        string.IsNullOrWhiteSpace(field.Description) ? null : $"{controlId}-help";

    private RenderFragment RenderField(FieldDefinition field, string controlId) => field.Type switch
    {
        FieldType.Number => @<input id="@controlId" type="number" class="field-input" inputmode="numeric"
                                     min="@field.Min" max="@field.Max" step="1" disabled="@ReadOnly"
                                     aria-describedby="@Describe(field, controlId)"
                                     value="@FormatNumber(GetValue(field))"
                                     @onchange="@(e => SetValueAsync(field, ParseNumber(e.Value?.ToString(), field)))" />,

        FieldType.Boolean => @<div class="field-check">
            <input id="@controlId" type="checkbox" class="field-box" disabled="@ReadOnly"
                   checked="@IsTrue(GetValue(field))"
                   aria-describedby="@Describe(field, controlId)"
                   @onchange="@(e => SetValueAsync(field, (bool)(e.Value ?? false)))" />
            <label class="visually-hidden" for="@controlId">@field.Label</label>
        </div>,

        FieldType.Dropdown => @<select id="@controlId" class="field-select" disabled="@ReadOnly"
                                        aria-describedby="@Describe(field, controlId)"
                                        value="@(GetValue(field)?.ToString() ?? string.Empty)"
                                        @onchange="@(e => SetValueAsync(field, e.Value?.ToString()))">
            <option value="">— none —</option>
            @foreach (var option in field.Options ?? new List<string>())
            {
                <option value="@option">@option</option>
            }
        </select>,

        FieldType.EntityReference => @<select id="@controlId" class="field-select" disabled="@ReadOnly"
                                               aria-describedby="@Describe(field, controlId)"
                                               value="@(GetValue(field)?.ToString() ?? string.Empty)"
                                               @onchange="@(e => SetValueAsync(field, e.Value?.ToString()))">
            <option value="">— none —</option>
            @foreach (var option in OptionsFor(field))
            {
                <option value="@option.Id">@option.Name</option>
            }
        </select>,

        FieldType.LongText => @<textarea id="@controlId" class="field-input" rows="4" disabled="@ReadOnly"
                                          aria-describedby="@Describe(field, controlId)"
                                          value="@(GetValue(field)?.ToString() ?? string.Empty)"
                                          @onchange="@(e => SetValueAsync(field, e.Value?.ToString()))"></textarea>,

        FieldType.TagList => @<input id="@controlId" type="text" class="field-input" disabled="@ReadOnly"
                                      placeholder="Comma-separated"
                                      aria-describedby="@Describe(field, controlId)"
                                      value="@string.Join(", ", GetTags(field))"
                                      @onchange="@(e => SetValueAsync(field, SplitTags(e.Value?.ToString())))" />,

        FieldType.Collection => RenderCollection(field, controlId),

        FieldType.ImagePicker => @<input id="@controlId" type="url" class="field-input" disabled="@ReadOnly"
                                          placeholder="Image URL"
                                          aria-describedby="@Describe(field, controlId)"
                                          value="@(GetValue(field)?.ToString() ?? string.Empty)"
                                          @onchange="@(e => SetValueAsync(field, e.Value?.ToString()))" />,

        _ => @<input id="@controlId" type="text" class="field-input" disabled="@ReadOnly"
                      aria-describedby="@Describe(field, controlId)"
                      value="@(GetValue(field)?.ToString() ?? string.Empty)"
                      @onchange="@(e => SetValueAsync(field, e.Value?.ToString()))" />
    };

    // ---- Collection rows: a list of {name, description, level?} maps ----

    private RenderFragment RenderCollection(FieldDefinition field, string controlId) => @<div id="@controlId" class="collection-editor" role="group" aria-label="@field.Label">
        @{
            var rows = GetRows(field);
        }
        @for (var i = 0; i < rows.Count; i++)
        {
            var index = i;
            var row = rows[index];
            <div class="d-flex gap-2 align-items-start mb-2">
                <input type="text" class="field-input field-sm w-5" placeholder="Level" aria-label="@field.Label row @(index + 1) level" disabled="@ReadOnly"
                       value="@(row.GetValueOrDefault("level")?.ToString())"
                       @onchange="@(e => UpdateRowAsync(field, index, "level", e.Value?.ToString()))" />
                <input type="text" class="field-input" style="max-width: 14rem" placeholder="Name" aria-label="@field.Label row @(index + 1) name" disabled="@ReadOnly"
                       value="@(row.GetValueOrDefault("name")?.ToString())"
                       @onchange="@(e => UpdateRowAsync(field, index, "name", e.Value?.ToString()))" />
                <textarea class="field-input" rows="2" placeholder="Description" aria-label="@field.Label row @(index + 1) description" disabled="@ReadOnly"
                          value="@(row.GetValueOrDefault("description")?.ToString())"
                          @onchange="@(e => UpdateRowAsync(field, index, "description", e.Value?.ToString()))"></textarea>
                @if (!ReadOnly)
                {
                    <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="x" Label="@($"Remove {field.Label} row @(index + 1)")" OnClick="() => RemoveRowAsync(field, index)" />
                }
            </div>
        }
        @if (!ReadOnly)
        {
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => AddRowAsync(field)">
                <LucideIcon IconName="plus" Size="14" /> Add @field.Label.ToLowerInvariant() row
            </CodexButton>
        }
    </div>;

    private List<Dictionary<string, object>> GetRows(FieldDefinition field)
    {
        if (GetValue(field) is IEnumerable<object> list)
        {
            return list.Select(item => item switch
            {
                Dictionary<string, object> map => map,
                IDictionary<string, object> map => new Dictionary<string, object>(map),
                _ => new Dictionary<string, object> { ["name"] = item?.ToString() ?? string.Empty }
            }).ToList();
        }

        return new List<Dictionary<string, object>>();
    }

    private async Task AddRowAsync(FieldDefinition field)
    {
        var rows = GetRows(field);
        rows.Add(new Dictionary<string, object> { ["name"] = string.Empty });
        await SetValueAsync(field, rows.Cast<object>().ToList());
    }

    private async Task RemoveRowAsync(FieldDefinition field, int index)
    {
        var rows = GetRows(field);
        if (index >= 0 && index < rows.Count)
        {
            rows.RemoveAt(index);
        }

        await SetValueAsync(field, rows.Count == 0 ? null : rows.Cast<object>().ToList());
    }

    private async Task UpdateRowAsync(FieldDefinition field, int index, string key, string? value)
    {
        var rows = GetRows(field);
        if (index < 0 || index >= rows.Count) return;
        var row = new Dictionary<string, object>(rows[index]);
        if (string.IsNullOrWhiteSpace(value))
        {
            row.Remove(key);
        }
        else if (key == "level" && long.TryParse(value, out var level))
        {
            row[key] = level;
        }
        else
        {
            row[key] = value;
        }

        rows[index] = row;
        await SetValueAsync(field, rows.Cast<object>().ToList());
    }

    // ---- Helpers ----

    private IReadOnlyList<(string Id, string Name)> OptionsFor(FieldDefinition field)
    {
        if (FieldOptions != null && FieldOptions.TryGetValue(field.Key, out var narrowed))
        {
            // Keep the current (possibly now-invalid) value selectable so the user sees what's wrong
            // instead of the select silently snapping to the first option.
            var current = GetValue(field)?.ToString();
            if (!string.IsNullOrEmpty(current) && narrowed.All(o => o.Id != current) && ReferenceOptions != null
                && field.TargetEntityType != null && ReferenceOptions.TryGetValue(field.TargetEntityType, out var all)
                && all.FirstOrDefault(o => o.Id == current) is { Id.Length: > 0 } stale)
            {
                return narrowed.Append((stale.Id, stale.Name + " (not allowed)")).ToList();
            }

            return narrowed;
        }

        return field.TargetEntityType != null && ReferenceOptions != null && ReferenceOptions.TryGetValue(field.TargetEntityType, out var options)
            ? options
            : Array.Empty<(string, string)>();
    }

    private static string FormatNumber(object? value) => value switch
    {
        null => string.Empty,
        double d => d.ToString(System.Globalization.CultureInfo.InvariantCulture),
        _ => value.ToString() ?? string.Empty
    };

    private static object? ParseNumber(string? raw, FieldDefinition field)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        if (!double.TryParse(raw, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)) return null;
        if (field.Min.HasValue) parsed = Math.Max(field.Min.Value, parsed);
        if (field.Max.HasValue) parsed = Math.Min(field.Max.Value, parsed);
        return parsed % 1 == 0 ? (long)parsed : parsed;
    }

    private static bool IsTrue(object? value) => value switch
    {
        bool b => b,
        string s => bool.TryParse(s, out var parsed) && parsed,
        _ => false
    };

    private IEnumerable<string> GetTags(FieldDefinition field) => GetValue(field) switch
    {
        List<string> list => list,
        IEnumerable<object> objects => objects.Select(o => o.ToString() ?? ""),
        string s => SplitTags(s).Select(o => o.ToString() ?? string.Empty),
        _ => Enumerable.Empty<string>()
    };

    private static List<object> SplitTags(string? raw) =>
        (raw ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Cast<object>().ToList();
}
