@* A labelled form field. The label, the hint and the control are tied together here so every
   screen gets the same spacing and the same accessible wiring. The control comes from the caller and
   receives the generated id, so it must set id="@id" itself:

       <CodexField Label="Name" Hint="Shown on the table" Context="id">
           <input id="@id" class="field-input" @bind="name" />
       </CodexField>

   Use class="field-input" for text and number inputs, "field-select" for selects, and
   CodexCheck for checkboxes. *@

<div class="field @Class">
    <label for="@fieldId" class="@(HideLabel ? "visually-hidden" : "field-label")">@Label</label>
    @ChildContent(fieldId)
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="field-hint">@Hint</div>
    }
</div>

@code {
    private static int next;
    private readonly string generated = "cxf-" + Interlocked.Increment(ref next);

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool HideLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Set when a test or an anchor needs a stable id; otherwise one is generated.</summary>
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public RenderFragment<string> ChildContent { get; set; } = default!;

    private string fieldId => Id ?? generated;
}
