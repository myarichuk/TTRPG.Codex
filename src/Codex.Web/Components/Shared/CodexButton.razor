@using Microsoft.AspNetCore.Components.Web

@* The app's one button. Variants are materials, not Bootstrap colours:
     Plaque  the brass call to action (one per view where possible)
     Etched  the quiet default
     Blood   anything destructive
     Rune    an icon alone (give it a Label; that becomes the accessible name)
   Anything else (data-testid, aria-*, form, title) passes through to the <button>. *@

<button type="@Type" class="@Css" disabled="@Disabled" @onclick="OnClick" aria-label="@AriaLabel" @attributes="Attributes">
    @if (Icon != null)
    {
        <LucideIcon IconName="@Icon" Size="@IconSize" />
    }
    @if (Variant != CodexButtonVariant.Rune)
    {
        @ChildContent
    }
</button>

@code {
    [Parameter] public CodexButtonVariant Variant { get; set; } = CodexButtonVariant.Etched;
    [Parameter] public bool Small { get; set; }
    /// <summary>Extra classes: cx-arcane for the AI helpers.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Icon { get; set; }
    /// <summary>The accessible name of a Rune button; ignored when the button has visible text.</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private int IconSize => Small || Variant == CodexButtonVariant.Rune ? 14 : 18;

    private string? AriaLabel => Variant == CodexButtonVariant.Rune ? Label : null;

    private string Css => string.Join(' ', new[]
    {
        "cx-btn",
        Variant switch
        {
            CodexButtonVariant.Plaque => "cx-plaque",
            CodexButtonVariant.Blood => "cx-blood",
            CodexButtonVariant.Rune => "cx-rune",
            _ => "cx-etched",
        },
        Small ? "cx-sm" : "",
        Class ?? "",
    }.Where(c => c.Length > 0));
}
