@* What a box shows while the AI writes into it or draws for it: an orb, what is happening, and a way to stop. It is a live
   region, so a screen reader hears "Writing…" without moving focus. Compact fits where there is little room (a row of
   badges, over a portrait, over a text box): one tight chip with Stop as an icon. *@

<div class="ai-working @(Compact ? "ai-working-compact" : "") @Class" role="status" data-testid="@TestId">
    <span class="ai-working-orb" aria-hidden="true"><span class="spinner-border spinner-border-sm"></span></span>
    <span class="ai-working-text">@(Text ?? L["Common.Ai.Writing"])</span>
    @if (OnStop.HasDelegate)
    {
        @if (Compact)
        {
            <CodexButton Variant="CodexButtonVariant.Rune" Icon="square" Label="@L["Common.Ai.Stop"]" OnClick="OnStop" title="@L["Common.Ai.Stop"]" data-testid="@($"{TestId}-stop")" />
        }
        else
        {
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="square" OnClick="OnStop" data-testid="@($"{TestId}-stop")">@L["Common.Ai.Stop"]</CodexButton>
        }
    }
    <span class="ai-working-bar" aria-hidden="true"></span>
</div>

@code {
    /// <summary>What is happening; null reads "Writing…".</summary>
    [Parameter] public string? Text { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }
    /// <summary>A tight chip instead of a full-width box, for the places that have little room.</summary>
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TestId { get; set; } = "ai-working";
}
