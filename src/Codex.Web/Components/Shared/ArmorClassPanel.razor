@using Codex.Core
@using Codex.Core.Rules
@using Codex.Plugin.Abstractions
@inject IContentRegistry Registry

@* Armor class: the number, what it is made of, and whether it follows the sheet's equipment and class
   or is typed in. The numbers come from the rule engine. *@

<section class="panel" aria-labelledby="@(id)-heading" data-testid="armor-class-panel">
    <div class="panel-title"><h2 id="@(id)-heading" class="h5"><LucideIcon IconName="shield" Size="18" Class="title-icon" /> @L["Actor.Ac.Heading"]</h2></div>
    <div class="d-flex align-items-baseline gap-2">
        <span class="stat-numeral" data-testid="armor-class">@Value</span>
        @if (Auto)
        {
            <span class="small-muted">@L["Actor.Ac.Auto"]</span>
        }
    </div>

    @if (Auto && Summary != null)
    {
        <ul class="list-unstyled small mt-2 mb-2" aria-label="@L["Actor.Ac.LinesAria"]" data-testid="armor-class-lines">
            @foreach (var line in Summary.Parts)
            {
                <li>@Describe(line)</li>
            }
        </ul>
    }

    @if (CanEdit)
    {
        <div class="field-check mt-2">
            <input id="@(id)-auto" class="field-box" type="checkbox" checked="@Auto" @onchange="e => SetAutoAsync((bool)e.Value!)" data-testid="armor-class-auto" />
            <label for="@(id)-auto" >@L["Actor.Ac.AutoLabel"]</label>
        </div>
        @if (Auto)
        {
            <div class="mt-2">
                <label for="@(id)-misc" class="field-label">@L["Actor.Ac.Misc"]</label>
                <input id="@(id)-misc" type="number" class="field-input field-sm" style="width:6rem" value="@(YamlValues.GetInt(Sheet, Rules.MiscField) ?? 0)"
                       @onchange="e => SetNumberAsync(Rules.MiscField, e.Value?.ToString())" data-testid="armor-class-misc" />
            </div>
        }
        else
        {
            <div class="mt-2">
                <label for="@(id)-manual" class="field-label">@L["Actor.Ac.Heading"]</label>
                <input id="@(id)-manual" type="number" class="field-input field-sm" style="width:6rem" value="@Value"
                       @onchange="e => SetNumberAsync(Rules.Key, e.Value?.ToString())" data-testid="armor-class-input" />
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public ArmorClassRules Rules { get; set; } = null!;
    [Parameter] public ArmorClassSummary? Summary { get; set; }
    [Parameter, EditorRequired] public Dictionary<string, object> Sheet { get; set; } = new();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private readonly string id = "ac-" + Guid.NewGuid().ToString("N")[..6];

    private string Describe(ArmorClassLine line)
    {
        var name = line.Entry == null ? line.Label : Registry.Name(line.Entry, L.Culture.Name);
        var signed = Bidi.Ltr((line.Value >= 0 ? "+" : "") + line.Value);
        return line.Kind switch
        {
            "dex" when line.DexCap.HasValue => L["Actor.Ac.DexCapped", signed, line.DexCap],
            "dex" => L["Actor.Ac.Dex", signed],
            "misc" => $"{L["Actor.Ac.Other"]}: {signed}",
            "bonus" => $"{name}: {signed}",
            "unarmored" => $"{L["Actor.Ac.Unarmored"]}: {Bidi.Ltr(line.Value.ToString())}",
            "defense" => $"{L["Actor.Ac.Defense", name]}: {Bidi.Ltr(line.Value.ToString())}",
            _ => $"{name}: {Bidi.Ltr(line.Value.ToString())}"
        };
    }

    private bool Auto => Summary?.Active == true;
    private int Value => Auto ? Summary!.Total : YamlValues.GetInt(Sheet, Rules.Key) ?? 10;

    private async Task SetAutoAsync(bool auto)
    {
        Sheet[Rules.ModeKey] = auto ? "auto" : "manual";
        await Changed.InvokeAsync();
    }

    private async Task SetNumberAsync(string key, string? raw)
    {
        Sheet[key] = (long)(int.TryParse(raw, out var number) ? number : 0);
        await Changed.InvokeAsync();
    }
}
