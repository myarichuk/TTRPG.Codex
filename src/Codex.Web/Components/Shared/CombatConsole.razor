@using Codex.Core
@using Codex.Core.Components
@using Codex.Core.Rules
@using Codex.Persistence
@using Codex.Persistence.Runtime
@using Codex.Plugin.Abstractions
@implements IAsyncDisposable
@inject CampaignRuntimeManager RuntimeManager
@inject IActorRepository ActorRepo
@inject ISessionRepository SessionRepo
@inject IContentRegistry ContentRegistry
@inject ComponentRegistry Components
@inject CampaignLibrary Library

@* The table loop: initiative, hit points, conditions, dice and quick notes, driven off one live
   CampaignRuntime per campaign. Every mutation goes through runtime.EnqueueAsync onto the campaign's
   single-writer loop; this component never touches ECS state directly. The DM picks one combatant
   at a time and works them from a command panel under their row. *@

<ConfirmDialog @ref="confirm" />

@if (runtime == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="dices" Size="26" /></div>
        @if (Access.IsDm)
        {
            <h3>The table is not running</h3>
            <p>Starting the table opens a live session: initiative, hit points and conditions update for every player as you change them.</p>
            @if (openSessions.Count > 0)
            {
                <div class="d-inline-flex flex-wrap gap-2 align-items-end justify-content-center mb-2">
                    <div class="text-start">
                        <label for="start-session" class="form-label small mb-1">Session</label>
                        <select id="start-session" class="form-select form-select-sm" data-testid="start-session-select" @bind="startSessionId">
                            @foreach (var session in openSessions)
                            {
                                <option value="@session.Id">@SessionLabel(session)</option>
                            }
                            <option value="">New session</option>
                        </select>
                    </div>
                </div>
            }
            <div>
                <button type="button" class="btn btn-primary" data-testid="start-table" @onclick="StartOrJoinAsync">Start the table</button>
            </div>
        }
        else
        {
            <h3>Waiting for the DM</h3>
            <p>This page updates by itself when the DM starts the table.</p>
        }
    </div>
}
else
{
    var encounter = snapshot.Encounter;

    <div class="row g-3">
        <div class="col-lg-8">
            <section class="panel" aria-labelledby="initiative-heading">
                <div class="panel-title">
                    <h3 id="initiative-heading" class="mb-0" data-testid="initiative-header">Initiative@(encounter != null ? $" - Round {encounter.Round}" : "")</h3>
                    @if (Access.IsDm && encounter is { Participants.Count: > 0 })
                    {
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="prev-turn-btn" @onclick="PreviousTurnAsync"><LucideIcon IconName="chevron-left" Size="14" /> Previous</button>
                            <button type="button" class="btn btn-sm btn-primary" data-testid="next-turn-btn" @onclick="NextTurnAsync">Next turn <LucideIcon IconName="chevron-right" Size="14" /></button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-testid="end-encounter-btn" @onclick="EndEncounterAsync">End encounter</button>
                        </div>
                    }
                </div>

                @if (encounter == null || encounter.Participants.Count == 0)
                {
                    <p class="small-muted mb-0">Nobody is in the initiative order yet.</p>
                }
                else
                {
                    @for (var i = 0; i < encounter.Participants.Count; i++)
                    {
                        var participant = encounter.Participants[i];
                        var isCurrent = i == encounter.TurnIndex;
                        var actor = ActorsById.GetValueOrDefault(participant.ActorId);

                        @* A participant this viewer can't see (a Hidden NPC, filtered out of a player's
                           Actors list) must not render at all - not even anonymously - or its existence
                           and turn position would leak. The DM's Actors list is unfiltered. *@
                        if (Access.IsDm || actor != null)
                        {
                            var actorId = participant.ActorId;
                            var name = actor?.Name ?? actorId;
                            var isSelected = Access.IsDm && selectedParticipantId == actorId;
                            var dead = IsDead(actorId);
                            var down = !dead && IsDown(actorId);
                            <div class="participant @(isCurrent ? "current" : "") @(isSelected ? "selected" : "") @(dead ? "dead" : down ? "down" : "")" data-testid="participant-row" data-actor-id="@actorId" aria-current="@(isCurrent ? "true" : null)">
                                <div class="participant-head">
                                    @if (Access.IsDm)
                                    {
                                        <button type="button" class="participant-select" data-testid="select-participant" aria-pressed="@(isSelected ? "true" : "false")" aria-label="@(isSelected ? $"Deselect {name}" : $"Select {name}")" @onclick="() => ToggleSelected(actorId)">
                                            <span class="participant-name">@name</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="participant-name">@name</span>
                                    }
                                    <span class="pill" title="Initiative @participant.InitiativeRoll">Initiative @participant.InitiativeRoll</span>
                                    @if (participant.State != TurnState.Normal)
                                    {
                                        <span class="pill pill-warning">@participant.State</span>
                                    }
                                    else if (participant.HasActed && !isCurrent)
                                    {
                                        <span class="pill" data-testid="acted-badge">Acted</span>
                                    }
                                    @if (dead)
                                    {
                                        <span class="pill pill-danger" data-testid="dead-badge">@DeadCondition</span>
                                    }
                                    else if (down)
                                    {
                                        <span class="pill pill-danger" data-testid="down-badge">@(IsStable(actorId) ? StableCondition : "Down")</span>
                                    }
                                    @HpBadge(actorId)
                                    @TempHpBadge(actorId)
                                    @if (isCurrent)
                                    {
                                        <span class="visually-hidden">(current turn)</span>
                                    }
                                </div>

                                @HpBar(actorId)
                                @DeathSaves(actorId)
                                @ConditionList(actorId, name)

                                @if (isSelected)
                                {
                                    @CommandPanel(actorId, name, participant, dead, down)
                                }
                            </div>
                        }
                    }
                }

                @if (Access.IsDm)
                {
                    <datalist id="conditions-list">
                        @foreach (var condition in PickableConditions)
                        {
                            <option value="@condition"></option>
                        }
                    </datalist>
                    <div class="console-row mt-3 pt-3 border-top">
                        <div>
                            <label for="add-to-initiative" class="form-label small mb-1">Add to initiative</label>
                            <select id="add-to-initiative" class="form-select form-select-sm" data-testid="add-to-initiative-select" @bind="selectedActorId">
                                <option value="">Choose someone…</option>
                                @foreach (var actor in Actors.Where(a => encounter == null || encounter.Participants.All(p => p.ActorId != a.Id)))
                                {
                                    <option value="@actor.Id">@actor.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="initiative-mode" class="form-label small mb-1">Roll</label>
                            <select id="initiative-mode" class="form-select form-select-sm" @bind="initiativeMode">
                                <option value="normal">Normal</option>
                                <option value="adv">Advantage</option>
                                <option value="dis">Disadvantage</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="roll-initiative-btn" @onclick="RollInitiativeForSelectedAsync" disabled="@string.IsNullOrEmpty(selectedActorId)">Roll @InitiativeDice@InitiativeBonusText(selectedActorId)</button>
                        <span class="small-muted pb-1">or</span>
                        <div>
                            <label for="manual-initiative" class="form-label small mb-1">Enter total</label>
                            <input id="manual-initiative" type="number" class="form-control form-control-sm w-5" data-testid="manual-initiative-input"
                                   value="@GetManualInitiative(selectedActorId)"
                                   @onchange="e => SetManualInitiativeInput(selectedActorId, e.Value?.ToString())" />
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="set-initiative-btn" @onclick="SetInitiativeManualAsync" disabled="@string.IsNullOrEmpty(selectedActorId)">Set</button>
                    </div>
                }
            </section>

            @if (Access.IsDm)
            {
                <section class="panel" aria-labelledby="quick-add-heading">
                    <div class="panel-title"><h3 id="quick-add-heading">Quick-add a creature</h3></div>
                    <label for="monster-search" class="visually-hidden">Search creatures</label>
                    <input id="monster-search" type="search" class="form-control form-control-sm mb-2" placeholder="Search creatures in the Library…" @bind="contentSearch" @bind:event="oninput" />
                    @if (contentSearch.Length > 0)
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var definition in SearchBlueprints().Take(12))
                            {
                                <li class="list-row">
                                    <span>@definition.Name</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => QuickAddMonsterAsync(definition)" aria-label="Add @definition.Name to the encounter">Add to encounter</button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small-muted mb-0">Type to search. Creatures are added hidden and hydrated into the live table at once.</p>
                    }
                </section>

                @if (Rests.Count > 0)
                {
                    <section class="panel" aria-labelledby="party-rest-heading">
                        <div class="panel-title"><h3 id="party-rest-heading">Party rest</h3></div>
                        <p class="small-muted">Rests every player character at once. Hit dice are spent per character from their row.</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var rest in Rests)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" data-testid="party-rest-@Slug(rest)" @onclick="() => PartyRestAsync(rest)">@rest for the party</button>
                            }
                        </div>
                    </section>
                }

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="EndTableAsync" data-testid="end-table">End the table</button>
                </div>
            }
        </div>

        <div class="col-lg-4">
            @{
                var slotActors = SlotPoolRules.Count == 0 ? new List<ActorDocument>() : Actors.Where(a => CanTrackSlots(a.Id) && SlotKeys(a.Id).Any()).ToList();
            }
            @if (slotActors.Count > 0)
            {
                <section class="panel" aria-labelledby="slots-heading" data-testid="table-slots">
                    <div class="panel-title"><h3 id="slots-heading">@SlotTracker.Heading(SlotPoolRules, slotActors.SelectMany(a => SlotKeys(a.Id)))</h3></div>
                    @foreach (var actor in slotActors)
                    {
                        var actorId = actor.Id;
                        <div class="mb-3" data-testid="table-slots-actor" data-actor-id="@actorId">
                            <div class="fw-semibold mb-1">@actor.Name</div>
                            <SlotTracker Pools="SlotPoolRules" Keys="SlotKeys(actorId)" Value="key => PoolValue(actorId, key)" Title="@($"{actor.Name}'s slots")"
                                         OnAdjust="change => runtime!.EnqueueAsync(new AdjustResourceCommand(actorId, change.Key, change.Delta, change.Label))"
                                         OnRest="rest => runtime!.EnqueueAsync(new RestCommand(actorId, rest.Name, rest.Keys))" />
                        </div>
                    }
                </section>
            }

            <section class="panel" aria-labelledby="dice-heading">
                <div class="panel-title"><h3 id="dice-heading">Dice</h3></div>
                <form class="input-group input-group-sm mb-2" @onsubmit="RollDiceAsync" @onsubmit:preventDefault="true">
                    <label for="dice-expression" class="visually-hidden">Dice expression</label>
                    <input id="dice-expression" class="form-control" placeholder="2d6+3, 4d6kh3, adv+5…" @bind="diceExpression" data-testid="dice-input" />
                    <button type="submit" class="btn btn-primary" data-testid="dice-roll">Roll</button>
                </form>
                @if (Access.IsDm)
                {
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" id="diceSecret" @bind="diceSecret" />
                        <label class="form-check-label small" for="diceSecret">Secret roll (DM only)</label>
                    </div>
                }
                <div class="log" aria-live="polite" aria-label="Roll log">
                    @foreach (var entry in VisibleRollLog())
                    {
                        <div class="log-entry" data-testid="roll-log-entry">
                            <strong>@ResolveRollerName(entry)</strong>
                            @if (entry.IsSecret)
                            {
                                <span class="pill ms-1">secret</span>
                            }
                            <div class="small-muted">@entry.Expression → @entry.Result</div>
                        </div>
                    }
                </div>
            </section>

            <section class="panel" aria-labelledby="notes-heading">
                <div class="panel-title"><h3 id="notes-heading">Quick notes</h3></div>
                <form @onsubmit="AddNoteAsync" @onsubmit:preventDefault="true">
                    <label for="quick-note" class="visually-hidden">New note</label>
                    <textarea id="quick-note" class="form-control form-control-sm mb-2" rows="2" @bind="noteText" placeholder="Something worth remembering…"></textarea>
                    @if (Access.IsDm)
                    {
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="noteSecret" @bind="noteSecret" />
                            <label class="form-check-label small" for="noteSecret">Secret note (DM only)</label>
                        </div>
                    }
                    <button type="submit" class="btn btn-sm btn-outline-secondary mb-2">Add note</button>
                </form>
                <div class="log">
                    @foreach (var note in VisibleNotes())
                    {
                        <div class="log-entry">@note.Text @if (note.IsSecret) { <span class="pill ms-1">secret</span> }</div>
                    }
                </div>
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public CampaignDocument Campaign { get; set; } = null!;
    [Parameter] public CampaignAccess Access { get; set; } = null!;
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public IEnumerable<ActorDocument> Actors { get; set; } = Enumerable.Empty<ActorDocument>();
    [Parameter] public SystemDefinition? Definition { get; set; }
    [Parameter] public EventCallback OnActorAdded { get; set; }
    [Parameter] public EventCallback<Flash> OnMessage { get; set; }

    private ConfirmDialog confirm = null!;
    private CampaignRuntime? runtime;
    // What this component renders from: an immutable picture the runtime's loop publishes with each
    // StateChanged. Reading the live encounter, roll log or entities during render could collide with
    // the loop mutating them and throw inside render (F13).
    private RuntimeSnapshot snapshot = RuntimeSnapshot.Empty;
    private string diceExpression = "1d20";
    private bool diceSecret;
    private string noteText = "";
    private bool noteSecret;
    private string contentSearch = "";
    private string selectedActorId = "";
    private string? selectedParticipantId;
    private string initiativeMode = "normal";
    private string startSessionId = "";
    private List<SessionDocument> openSessions = new();
    private bool sessionsLoadedFor;
    private readonly Dictionary<string, int> damageInputs = new();
    private readonly Dictionary<string, string> damageTypeInputs = new();
    private readonly Dictionary<string, bool> criticalInputs = new();
    private readonly Dictionary<string, string> conditionInputs = new();
    private readonly Dictionary<string, int> conditionRoundsInputs = new();
    private readonly Dictionary<string, EffectExpiry> conditionExpiryInputs = new();
    private readonly Dictionary<string, int> hitDiceInputs = new();
    private readonly Dictionary<string, int> manualInitiativeInputs = new();
    private bool subscribedToManager;
    // The sheet rule engine resolves initiative bonuses and class hit dice; loaded once per attach.
    private SheetRuleEngine? engine;
    private CachedEntryResolver? resolver;
    private Task? rulesLoading;

    private Dictionary<string, ActorDocument> ActorsById => Actors.ToDictionary(a => a.Id);
    private VitalsRules? Vitals => Definition?.Vitals;
    private IEnumerable<string> PickableConditions => (Definition?.Conditions ?? Enumerable.Empty<string>())
        .Where(c => Vitals?.Exhaustion?.Condition == null || !string.Equals(c, Vitals.Exhaustion.Condition, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<string> DamageTypes => Vitals?.Damage?.Types ?? (IReadOnlyList<string>)Array.Empty<string>();
    private string InitiativeDice => Definition?.Dice.Initiative ?? "1d20";
    private string PrimaryKey => Definition?.PrimaryResource?.Key ?? "HP";
    private string PrimaryMaxKey => Definition?.PrimaryResource?.MaxKey ?? "HP_Max";
    private string PrimaryLabel => Definition?.PrimaryResource?.Label ?? "HP";
    private string TempKey => Vitals?.TemporaryResource ?? "TempHP";
    private string DeadCondition => Vitals?.Down?.DeadCondition ?? "Dead";
    private string StableCondition => Vitals?.Down?.StableCondition ?? "Stable";
    private string DownCondition => Vitals?.Down?.Condition ?? "Unconscious";

    /// <summary>Rest names the table offers: the system's rests plus whatever slot pools recover on.</summary>
    private List<string> Rests => (Vitals?.Rests.Select(r => r.Name) ?? Enumerable.Empty<string>())
        .Concat(SlotPoolRules.SelectMany(p => p.RecoversOn))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private int GetDamageInput(string actorId) => damageInputs.GetValueOrDefault(actorId, 0);
    private void SetDamageInput(string actorId, string? raw) => damageInputs[actorId] = int.TryParse(raw, out var value) ? value : 0;
    private string GetConditionInput(string actorId) => conditionInputs.GetValueOrDefault(actorId, string.Empty);
    private void SetConditionInput(string actorId, string? raw) => conditionInputs[actorId] = raw ?? string.Empty;
    private static string Slug(string text) => text.Replace(' ', '-').ToLowerInvariant();

    protected override async Task OnParametersSetAsync()
    {
        if (!subscribedToManager)
        {
            RuntimeManager.RuntimeChanged += OnRuntimeChanged;
            subscribedToManager = true;
        }

        if (runtime == null && RuntimeManager.TryGet(CampaignId) is { } existing)
        {
            Attach(existing);
        }

        if (runtime == null && Access.IsDm && !sessionsLoadedFor)
        {
            sessionsLoadedFor = true;
            await LoadOpenSessionsAsync();
        }
    }

    /// <summary>Sessions the DM can run: planned ones, and a live one the last table left behind. The
    /// campaign's current session is preselected when it is one of them; otherwise the next planned one.</summary>
    private async Task LoadOpenSessionsAsync()
    {
        openSessions = (await SessionRepo.GetAllForCampaignAsync(CampaignId))
            .Where(s => s.Status != SessionStatus.Completed)
            .OrderBy(s => s.Date)
            .ToList();
        startSessionId = openSessions.Any(s => s.Id == Campaign.CurrentSessionId) ? Campaign.CurrentSessionId! : openSessions.FirstOrDefault()?.Id ?? "";
    }

    private static string SessionLabel(SessionDocument session) =>
        $"{(string.IsNullOrWhiteSpace(session.Title) ? session.Date.ToLocalTime().ToString("d MMM yyyy") : session.Title)} ({session.Status})";

    /// <summary>A player's open table page attaches the moment the DM starts (or ends) the table.</summary>
    private void OnRuntimeChanged(string campaignId)
    {
        if (campaignId != CampaignId) return;
        InvokeAsync(async () =>
        {
            var current = RuntimeManager.TryGet(CampaignId);
            if (current == null)
            {
                Detach();
                if (Access.IsDm) await LoadOpenSessionsAsync();
            }
            else
            {
                Attach(current);
            }

            StateHasChanged();
        });
    }

    private async Task StartOrJoinAsync()
    {
        var existing = RuntimeManager.TryGet(CampaignId);
        if (existing != null)
        {
            Attach(existing);
            return;
        }

        if (!Access.IsDm) return;

        try
        {
            Attach(await RuntimeManager.GetOrStartAsync(Campaign, Access, string.IsNullOrEmpty(startSessionId) ? null : startSessionId));
        }
        catch (InvalidOperationException ex)
        {
            await OnMessage.InvokeAsync(Flash.Error(ex.Message));
        }
    }

    private async Task EndTableAsync()
    {
        if (!Access.IsDm) return;
        var inCombat = snapshot.Encounter is { Participants.Count: > 0 };
        var ok = await confirm.ShowAsync("End the table?",
            inCombat
                ? "The session is marked complete. The initiative order is kept and comes back when this session's table is started again."
                : "The session is marked complete. Players' table pages go back to waiting.",
            "End the table", isDestructive: true);
        if (!ok) return;
        await RuntimeManager.EvictAsync(CampaignId);
        await OnMessage.InvokeAsync(Flash.Success("The table has ended. The session is marked complete."));
    }

    /// <summary>Idempotent: starting the table reaches here twice (once from the manager's
    /// RuntimeChanged notification, once from the click handler), and a second subscription would
    /// outlive DisposeAsync's single unsubscribe (F14).</summary>
    private void Attach(CampaignRuntime started)
    {
        if (ReferenceEquals(runtime, started)) return;

        Detach();
        runtime = started;
        runtime.StateChanged += OnStateChanged;
        snapshot = runtime.Snapshot;
        if (Access.IsDm && Definition != null && rulesLoading == null)
        {
            rulesLoading = LoadRulesAsync();
        }
    }

    private async Task LoadRulesAsync()
    {
        try
        {
            resolver = await CachedEntryResolver.LoadAsync(Library, Campaign, Access, Definition!);
            engine = new SheetRuleEngine(Definition!, resolver);
        }
        catch (Exception)
        {
            // Without the engine, initiative rolls fall back to the bare die and hit dice to the sheet's own count.
            engine = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void Detach()
    {
        if (runtime != null)
        {
            runtime.StateChanged -= OnStateChanged;
            runtime = null;
        }

        snapshot = RuntimeSnapshot.Empty;
        selectedParticipantId = null;
    }

    private void OnStateChanged(IReadOnlyCollection<string> _) => InvokeAsync(() =>
    {
        if (runtime != null) snapshot = runtime.Snapshot;
        StateHasChanged();
    });

    private void ToggleSelected(string actorId) => selectedParticipantId = selectedParticipantId == actorId ? null : actorId;

    // ---- Initiative ----

    /// <summary>The system's initiative bonus for an actor: the named derived field (DEX modifier in
    /// the SRD), evaluated from their sheet. Zero when the system has none or the rules are not loaded.</summary>
    private int InitiativeBonus(string actorId)
    {
        if (engine == null || Definition?.Dice.InitiativeBonus is not { } key || ActorsById.GetValueOrDefault(actorId) is not { } actor) return 0;
        try
        {
            var evaluation = engine.Evaluate(actor.Sheet);
            return evaluation.Derived.TryGetValue(key, out var value) ? Convert.ToInt32(value) : 0;
        }
        catch (Exception)
        {
            return 0;
        }
    }

    private string InitiativeBonusText(string actorId)
    {
        if (string.IsNullOrEmpty(actorId)) return "";
        var bonus = InitiativeBonus(actorId);
        return bonus == 0 ? "" : bonus > 0 ? $" + {bonus}" : $" - {-bonus}";
    }

    /// <summary>The tie-break score: the attribute the system names (DEX), read off the sheet.</summary>
    private int TieBreak(string actorId)
    {
        if (Definition?.Dice.InitiativeTieBreak is not { } key || ActorsById.GetValueOrDefault(actorId) is not { } actor) return 0;
        return YamlValues.GetInt(actor.Sheet, key) ?? Definition.Attributes.FirstOrDefault(a => a.Key == key)?.Default ?? 0;
    }

    private async Task RollInitiativeForSelectedAsync()
    {
        if (string.IsNullOrEmpty(selectedActorId)) return;
        var actorId = selectedActorId;
        selectedActorId = "";
        var expression = initiativeMode == "normal" ? InitiativeDice : initiativeMode;
        var bonus = InitiativeBonus(actorId);
        var result = runtime!.DiceRoller.Roll(expression);
        await runtime.EnqueueAsync(new RollDiceCommand(expression + (bonus == 0 ? "" : bonus > 0 ? $"+{bonus}" : bonus.ToString()), actorId, CurrentUserId, IsSecret: false));
        await runtime.EnqueueAsync(new SetInitiativeCommand(actorId, result.Total + bonus, TieBreak(actorId)));
    }

    private async Task SetInitiativeManualAsync()
    {
        if (string.IsNullOrEmpty(selectedActorId)) return;
        // Clear the picker before awaiting: the round trip through the single-writer loop can be
        // long enough that a DM's next click lands before this resumes.
        var actorId = selectedActorId;
        var roll = GetManualInitiative(actorId);
        selectedActorId = "";
        await runtime!.EnqueueAsync(new SetInitiativeCommand(actorId, roll, TieBreak(actorId)));
    }

    private int GetManualInitiative(string actorId) => manualInitiativeInputs.GetValueOrDefault(actorId, 0);
    private void SetManualInitiativeInput(string actorId, string? raw) => manualInitiativeInputs[actorId] = int.TryParse(raw, out var value) ? value : 0;

    private Task NextTurnAsync() => runtime!.EnqueueAsync(new NextTurnCommand());
    private Task PreviousTurnAsync() => runtime!.EnqueueAsync(new PreviousTurnCommand());
    private Task SetTurnStateAsync(string actorId, TurnState state) => runtime!.EnqueueAsync(new SetTurnStateCommand(actorId, state));
    private Task ActNowAsync(string actorId) => runtime!.EnqueueAsync(new ActNowCommand(actorId));

    private async Task RemoveFromOrderAsync(string actorId)
    {
        if (selectedParticipantId == actorId) selectedParticipantId = null;
        await runtime!.EnqueueAsync(new RemoveParticipantCommand(actorId));
    }

    private async Task EndEncounterAsync()
    {
        var ok = await confirm.ShowAsync("End the encounter?", "The initiative order is cleared and conditions with a round count expire. Conditions that last until removed stay.", "End encounter", isDestructive: true);
        if (!ok) return;
        selectedParticipantId = null;
        await runtime!.EnqueueAsync(new EndEncounterCommand());
    }

    // ---- Reading the snapshot ----

    private IReadOnlyList<EffectSnapshot> GetEffects(string actorId) =>
        snapshot.Actor(actorId)?.Effects ?? Array.Empty<EffectSnapshot>();

    private bool HasEffect(string actorId, string effectId) =>
        GetEffects(actorId).Any(e => string.Equals(e.EffectId, effectId, StringComparison.OrdinalIgnoreCase));

    private bool IsDead(string actorId) => Vitals?.Down != null && HasEffect(actorId, DeadCondition);
    private bool IsDown(string actorId) => Pool(actorId) is { Current: <= 0 } && !IsDead(actorId);
    private bool IsStable(string actorId) => HasEffect(actorId, StableCondition);

    private (int Current, int Max)? Pool(string actorId) =>
        snapshot.Actor(actorId)?.Pools is { } pools
            ? (pools.GetValueOrDefault(PrimaryKey), pools.GetValueOrDefault(PrimaryMaxKey))
            : null;

    private IReadOnlyList<SlotPoolRule> SlotPoolRules => Definition?.SheetRules?.SlotPools ?? (IReadOnlyList<SlotPoolRule>)Array.Empty<SlotPoolRule>();

    /// <summary>The DM tracks everyone's slots; a player tracks their own character's.</summary>
    private bool CanTrackSlots(string actorId) => Access.IsDm || ActorsById.GetValueOrDefault(actorId)?.OwnerUserId == CurrentUserId;

    private IEnumerable<string> SlotKeys(string actorId) =>
        snapshot.Actor(actorId)?.Pools?.Keys.Where(k => SlotPoolRules.Any(r => r.Owns(k))).ToList() ?? Enumerable.Empty<string>();

    private int? PoolValue(string actorId, string key) => snapshot.Actor(actorId)?.Pool(key);

    private bool CanSeeExact(string actorId) => Access.IsDm || ActorsById.GetValueOrDefault(actorId)?.OwnerUserId == CurrentUserId;

    private bool IsOwnCharacter(string actorId) => ActorsById.GetValueOrDefault(actorId) is { Kind: ActorKind.PlayerCharacter } a && a.OwnerUserId == CurrentUserId;

    private RenderFragment HpBadge(string actorId) => builder =>
    {
        if (Pool(actorId) is not { } pool) return;
        var text = CanSeeExact(actorId) ? $"{pool.Current}/{pool.Max} {PrimaryKey}" : HpBand(pool.Current, pool.Max);

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "pill pill-danger hp-text");
        builder.AddAttribute(2, "data-testid", "hp-badge");
        builder.AddContent(3, text);
        builder.CloseElement();
    };

    private RenderFragment TempHpBadge(string actorId) => builder =>
    {
        if (!CanSeeExact(actorId) || PoolValue(actorId, TempKey) is not { } temp || temp <= 0) return;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "pill pill-arcane hp-text");
        builder.AddAttribute(2, "data-testid", "temp-hp-badge");
        builder.AddAttribute(3, "title", "Temporary hit points");
        builder.AddContent(4, $"+{temp} temp");
        builder.CloseElement();
    };

    private RenderFragment HpBar(string actorId) => builder =>
    {
        if (!CanSeeExact(actorId) || Pool(actorId) is not { } pool || pool.Max <= 0) return;
        var pct = Math.Clamp(100.0 * pool.Current / pool.Max, 0, 100);
        var band = pct < 25 ? "hp-low" : pct < 50 ? "hp-mid" : "hp-high";
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "hp-bar " + band);
        builder.AddAttribute(2, "role", "progressbar");
        builder.AddAttribute(3, "aria-label", $"{PrimaryLabel}");
        builder.AddAttribute(4, "aria-valuemin", "0");
        builder.AddAttribute(5, "aria-valuemax", pool.Max.ToString());
        builder.AddAttribute(6, "aria-valuenow", pool.Current.ToString());
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "style", $"width:{pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%");
        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>Death-save tally for a character that is down: filled pips for successes and failures,
    /// and a roll button for the DM or the character's own player.</summary>
    private RenderFragment DeathSaves(string actorId) => builder =>
    {
        if (Vitals?.DeathSaves is not { } rules || !IsDown(actorId) || IsStable(actorId)) return;
        if (ActorsById.GetValueOrDefault(actorId) is not { Kind: ActorKind.PlayerCharacter }) return;
        var successes = PoolValue(actorId, rules.SuccessesKey) ?? 0;
        var failures = PoolValue(actorId, rules.FailuresKey) ?? 0;
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "death-saves");
        builder.AddAttribute(seq++, "data-testid", "death-saves");
        builder.AddAttribute(seq++, "aria-label", $"Death saves: {successes} successes, {failures} failures");
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "death-saves-label");
        builder.AddContent(seq++, "Death saves");
        builder.CloseElement();
        foreach (var (count, needed, cls, label) in new[] { (successes, rules.SuccessesToStabilize, "ok", "successes"), (failures, rules.FailuresToDie, "bad", "failures") })
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "death-save-pips " + cls);
            builder.AddAttribute(seq++, "data-testid", "death-save-" + label);
            builder.AddAttribute(seq++, "title", $"{count} of {needed} {label}");
            for (var i = 0; i < needed; i++)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "pip " + (i < count ? "full" : ""));
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        if (Access.IsDm || IsOwnCharacter(actorId))
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", "btn btn-sm btn-outline-secondary");
            builder.AddAttribute(seq++, "data-testid", "roll-death-save");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => runtime!.EnqueueAsync(new RollDeathSaveCommand(actorId, CurrentUserId))));
            builder.AddContent(seq++, "Roll death save");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private RenderFragment ConditionList(string actorId, string name) => builder =>
    {
        var effects = GetEffects(actorId).Where(e => !IsVitalsMarker(e.EffectId)).ToList();
        var exhaustion = Vitals?.Exhaustion is { } rules ? PoolValue(actorId, rules.Key) ?? 0 : 0;
        if (effects.Count == 0 && exhaustion == 0) return;
        var seq = 0;
        builder.OpenElement(seq++, "ul");
        builder.AddAttribute(seq++, "class", "list-inline mb-0 mt-2");
        builder.AddAttribute(seq++, "aria-label", $"Conditions on {name}");
        if (exhaustion > 0)
        {
            builder.OpenElement(seq++, "li");
            builder.AddAttribute(seq++, "class", "list-inline-item");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "pill pill-warning");
            builder.AddAttribute(seq++, "data-testid", "exhaustion-badge");
            builder.AddContent(seq++, $"{Vitals!.Exhaustion!.Condition ?? "Exhaustion"} {exhaustion}");
            builder.CloseElement();
            builder.CloseElement();
        }

        foreach (var effect in effects)
        {
            builder.OpenElement(seq++, "li");
            builder.AddAttribute(seq++, "class", "list-inline-item");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "pill pill-warning");
            builder.AddAttribute(seq++, "data-testid", "condition-badge");
            builder.AddAttribute(seq++, "data-effect-id", effect.EffectId);
            builder.AddAttribute(seq++, "title", effect.IsIndefinite ? "Until removed" : $"{effect.RoundsRemaining} round(s), ends at the {(effect.Expiry == EffectExpiry.StartOfTurn ? "start" : "end")} of the turn");
            builder.AddContent(seq++, effect.IsIndefinite ? effect.EffectId : $"{effect.EffectId} ({effect.RoundsRemaining})");
            if (Access.IsDm)
            {
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "type", "button");
                builder.AddAttribute(seq++, "class", "btn-link-plain ms-1");
                builder.AddAttribute(seq++, "aria-label", $"Remove {effect.EffectId} from {name}");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => RemoveConditionAsync(actorId, effect.EffectId)));
                builder.OpenComponent<LucideIcon>(seq++);
                builder.AddAttribute(seq++, "IconName", "x");
                builder.AddAttribute(seq++, "Size", 12);
                builder.CloseComponent();
                builder.CloseElement();
            }

            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    /// <summary>Dead, stable and down are shown as the row's state, not as conditions in the list.</summary>
    private bool IsVitalsMarker(string effectId) =>
        Vitals?.Down is { } down &&
        (string.Equals(effectId, down.DeadCondition, StringComparison.OrdinalIgnoreCase) ||
         string.Equals(effectId, down.StableCondition, StringComparison.OrdinalIgnoreCase) ||
         string.Equals(effectId, down.Condition, StringComparison.OrdinalIgnoreCase));

    /// <summary>Players never learn a hostile's exact remaining hit points - only a coarse band.</summary>
    private static string HpBand(int current, int max)
    {
        if (max <= 0) return "Unknown";
        var fraction = (double)current / max;
        return fraction switch
        {
            <= 0 => "Down",
            < 0.25 => "Critical",
            < 0.5 => "Bloodied",
            _ => "Healthy"
        };
    }

    // ---- The DM's command panel ----

    private RenderFragment CommandPanel(string actorId, string name, ParticipantSnapshot participant, bool dead, bool down) => __builder =>
    {
        <div class="command-panel" data-testid="command-panel" data-actor-id="@actorId" aria-label="Commands for @name">
            <div class="console-row mt-0">
                <div>
                    <label for="dmg-@actorId" class="form-label small mb-1">Amount</label>
                    <input id="dmg-@actorId" type="number" min="0" class="form-control form-control-sm w-5" data-testid="damage-input"
                           value="@GetDamageInput(actorId)"
                           @oninput="e => SetDamageInput(actorId, e.Value?.ToString())" />
                </div>
                @if (DamageTypes.Count > 0)
                {
                    <div>
                        <label for="dmg-type-@actorId" class="form-label small mb-1">Type</label>
                        <select id="dmg-type-@actorId" class="form-select form-select-sm" data-testid="damage-type-select"
                                value="@damageTypeInputs.GetValueOrDefault(actorId, "")"
                                @onchange="e => damageTypeInputs[actorId] = e.Value?.ToString() ?? string.Empty">
                            <option value="">Untyped</option>
                            @foreach (var type in DamageTypes)
                            {
                                <option value="@type">@Capitalize(type)</option>
                            }
                        </select>
                    </div>
                }
                <div class="form-check pb-1">
                    <input type="checkbox" class="form-check-input" id="crit-@actorId" data-testid="critical-input"
                           checked="@criticalInputs.GetValueOrDefault(actorId)"
                           @onchange="e => criticalInputs[actorId] = e.Value is true" />
                    <label class="form-check-label small" for="crit-@actorId">Critical hit</label>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger" data-testid="damage-btn" @onclick="() => ApplyDamageAsync(actorId)" aria-label="Damage @name">Damage</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="heal-btn" @onclick="() => ApplyHealingAsync(actorId)" aria-label="Heal @name">Heal</button>
                @if (Vitals?.TemporaryResource != null)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="temp-hp-btn" @onclick="() => GrantTempHpAsync(actorId)" aria-label="Give @name temporary hit points">Temp HP</button>
                }
            </div>

            @if (dead)
            {
                <div class="console-row">
                    <span class="small-muted pb-1">@name is @DeadCondition.ToLowerInvariant().</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="revive-btn" @onclick="() => RemoveConditionAsync(actorId, DeadCondition)" aria-label="Revive @name">Revive (clear @DeadCondition)</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-testid="remove-participant-btn" @onclick="() => RemoveFromOrderAsync(actorId)" aria-label="Remove @name from the order">Remove from order</button>
                </div>
            }
            else if (down && Vitals?.DeathSaves != null)
            {
                <div class="console-row">
                    <span class="small-muted pb-1">@name is at 0 @PrimaryKey.</span>
                    @if (!IsStable(actorId))
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="death-save-success" @onclick="() => runtime!.EnqueueAsync(new RecordDeathSaveCommand(actorId, true))">Success</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="death-save-failure" @onclick="() => runtime!.EnqueueAsync(new RecordDeathSaveCommand(actorId, false))">Failure</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="stabilize-btn" @onclick="() => runtime!.EnqueueAsync(new StabilizeCommand(actorId, CurrentUserId))">Stabilize</button>
                    }
                    else
                    {
                        <span class="pill pill-success">@StableCondition</span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-danger" data-testid="kill-btn" @onclick="() => AddConditionDirectAsync(actorId, DeadCondition)" aria-label="Mark @name dead">Mark dead</button>
                </div>
            }

            <div class="console-row">
                <div>
                    <label for="cond-@actorId" class="form-label small mb-1">Condition</label>
                    <input id="cond-@actorId" class="form-control form-control-sm w-8" list="conditions-list" data-testid="condition-input"
                           value="@GetConditionInput(actorId)"
                           @oninput="e => SetConditionInput(actorId, e.Value?.ToString())" />
                </div>
                <div>
                    <label for="rounds-@actorId" class="form-label small mb-1">Rounds</label>
                    <input id="rounds-@actorId" type="number" min="0" class="form-control form-control-sm w-5" data-testid="condition-rounds-input" placeholder="∞"
                           value="@GetConditionRounds(actorId)" title="0 or blank: until removed"
                           @oninput="e => SetConditionRounds(actorId, e.Value?.ToString())" />
                </div>
                <div>
                    <label for="expiry-@actorId" class="form-label small mb-1">Ends at</label>
                    <select id="expiry-@actorId" class="form-select form-select-sm" data-testid="condition-expiry-select"
                            value="@conditionExpiryInputs.GetValueOrDefault(actorId, EffectExpiry.EndOfTurn).ToString()"
                            @onchange="e => conditionExpiryInputs[actorId] = Enum.TryParse<EffectExpiry>(e.Value?.ToString(), out var x) ? x : EffectExpiry.EndOfTurn">
                        <option value="@EffectExpiry.EndOfTurn">End of their turn</option>
                        <option value="@EffectExpiry.StartOfTurn">Start of their turn</option>
                    </select>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="condition-add-btn" @onclick="() => AddConditionAsync(actorId)" aria-label="Add condition to @name">Add condition</button>
                @if (Vitals?.Exhaustion is { } exhaustion)
                {
                    var level = PoolValue(actorId, exhaustion.Key) ?? 0;
                    <div class="d-flex align-items-end gap-1">
                        <span class="small pb-1">@(exhaustion.Condition ?? "Exhaustion") @level</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="exhaustion-up" disabled="@(level >= exhaustion.MaxLevel)" @onclick="() => runtime!.EnqueueAsync(new AdjustExhaustionCommand(actorId, 1))" aria-label="Raise @name's exhaustion">+</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="exhaustion-down" disabled="@(level <= 0)" @onclick="() => runtime!.EnqueueAsync(new AdjustExhaustionCommand(actorId, -1))" aria-label="Lower @name's exhaustion">−</button>
                    </div>
                }
            </div>

            <div class="console-row">
                <span class="small-muted pb-1">Turn</span>
                @if (participant.State != TurnState.Normal)
                {
                    <button type="button" class="btn btn-sm btn-primary" data-testid="act-now-btn" @onclick="() => ActNowAsync(actorId)" aria-label="@name acts now">Act now</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetTurnStateAsync(actorId, TurnState.Normal)" aria-label="Clear @name's delay or ready state">Clear</button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetTurnStateAsync(actorId, TurnState.Delayed)" aria-label="@name delays their turn">Delay</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetTurnStateAsync(actorId, TurnState.Readied)" aria-label="@name readies an action">Ready</button>
                }
                @if (!dead)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="remove-participant-btn" @onclick="() => RemoveFromOrderAsync(actorId)" aria-label="Remove @name from the order">Remove from order</button>
                }
            </div>

            @if (Rests.Count > 0)
            {
                var hitDice = HitDicePool(actorId);
                <div class="console-row">
                    <span class="small-muted pb-1">Rest</span>
                    @foreach (var rest in Rests)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" data-testid="rest-@Slug(rest)" @onclick="() => RestAsync(actorId, rest)">@rest</button>
                    }
                    @if (hitDice is { Max: > 0 } dice)
                    {
                        <span class="small pb-1" data-testid="hit-dice">Hit dice @dice.Current/@dice.Max@(dice.Sides is { } s ? $" (d{s})" : "")</span>
                        @if (dice.Sides != null)
                        {
                            <input type="number" min="1" max="@dice.Current" class="form-control form-control-sm w-5" data-testid="hit-dice-input" aria-label="Hit dice to spend"
                                   value="@hitDiceInputs.GetValueOrDefault(actorId, 1)"
                                   @oninput="e => hitDiceInputs[actorId] = int.TryParse(e.Value?.ToString(), out var n) && n > 0 ? n : 1" />
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="spend-hit-dice-btn" disabled="@(dice.Current <= 0)" @onclick="() => SpendHitDiceAsync(actorId, dice.Sides.Value)">Spend</button>
                        }
                    }
                </div>
            }
        </div>
    };

    private static string Capitalize(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    private async Task ApplyDamageAsync(string actorId)
    {
        if (!damageInputs.TryGetValue(actorId, out var amount) || amount <= 0) return;
        var type = damageTypeInputs.GetValueOrDefault(actorId, "");
        var critical = criticalInputs.GetValueOrDefault(actorId);
        criticalInputs[actorId] = false;
        await runtime!.EnqueueAsync(new ApplyDamageCommand(actorId, PrimaryKey, amount, CurrentUserId, string.IsNullOrEmpty(type) ? null : type, critical));
    }

    private async Task ApplyHealingAsync(string actorId)
    {
        if (!damageInputs.TryGetValue(actorId, out var amount) || amount <= 0) return;
        await runtime!.EnqueueAsync(new ApplyHealingCommand(actorId, PrimaryKey, amount, CurrentUserId));
    }

    private async Task GrantTempHpAsync(string actorId)
    {
        if (!damageInputs.TryGetValue(actorId, out var amount) || amount <= 0) return;
        await runtime!.EnqueueAsync(new GrantTemporaryHitPointsCommand(actorId, amount, CurrentUserId));
    }

    private async Task AddConditionAsync(string actorId)
    {
        if (!conditionInputs.TryGetValue(actorId, out var effectId) || string.IsNullOrWhiteSpace(effectId)) return;
        var rounds = GetConditionRounds(actorId);
        var expiry = conditionExpiryInputs.GetValueOrDefault(actorId, EffectExpiry.EndOfTurn);
        conditionInputs[actorId] = "";
        await runtime!.EnqueueAsync(new AddStatusEffectCommand(actorId, effectId.Trim(), CurrentUserId, rounds, expiry, actorId));
    }

    private Task AddConditionDirectAsync(string actorId, string effectId) =>
        runtime!.EnqueueAsync(new AddStatusEffectCommand(actorId, effectId, CurrentUserId, 0, EffectExpiry.EndOfTurn, actorId));

    private int GetConditionRounds(string actorId) => conditionRoundsInputs.GetValueOrDefault(actorId, 1);
    private void SetConditionRounds(string actorId, string? raw) => conditionRoundsInputs[actorId] = int.TryParse(raw, out var value) && value > 0 ? value : 0;

    private Task RemoveConditionAsync(string actorId, string effectId) => runtime!.EnqueueAsync(new RemoveStatusEffectCommand(actorId, effectId));

    // ---- Rests and hit dice ----

    private Task RestAsync(string actorId, string rest) => runtime!.EnqueueAsync(new RestCommand(actorId, rest, SlotKeysRestoredBy(actorId, rest)));

    private async Task PartyRestAsync(string rest)
    {
        foreach (var actor in Actors.Where(a => a.Kind == ActorKind.PlayerCharacter && snapshot.Actor(a.Id) != null))
        {
            await RestAsync(actor.Id, rest);
        }
    }

    private List<string> SlotKeysRestoredBy(string actorId, string rest) =>
        SlotKeys(actorId).Where(key => SlotPoolRules.Any(r => r.Owns(key) && r.RecoversOn.Contains(rest, StringComparer.OrdinalIgnoreCase) && !key.EndsWith("_Max", StringComparison.Ordinal))).ToList();

    private (int Current, int Max, int? Sides)? HitDicePool(string actorId)
    {
        if (Vitals?.HitDice is not { } rules || PoolValue(actorId, rules.MaxKey) is not { } max) return null;
        return (PoolValue(actorId, rules.Key) ?? 0, max, HitDieSides(actorId, rules));
    }

    /// <summary>The die to spend: the first class's hit die for a character, the stat block's for a creature.</summary>
    private int? HitDieSides(string actorId, HitDiceRules rules)
    {
        if (ActorsById.GetValueOrDefault(actorId) is not { } actor) return null;
        if (rules.CreatureDiceProperty != null && ActorSheetSync.HitDiceExpression.Parse(YamlValues.GetString(actor.Sheet, rules.CreatureDiceProperty)) is { } creature)
        {
            return creature.Sides;
        }

        var classId = YamlValues.GetString(actor.Sheet, rules.ClassField);
        if (string.IsNullOrWhiteSpace(classId) || resolver?.Resolve("class", classId) is not { } entry) return null;
        return entry.Properties.TryGetValue(rules.DieProperty, out var raw) ? SheetRuleEngine.ParseHitDie(raw) : null;
    }

    private Task SpendHitDiceAsync(string actorId, int sides) =>
        runtime!.EnqueueAsync(new SpendHitDiceCommand(actorId, hitDiceInputs.GetValueOrDefault(actorId, 1), sides));

    // ---- Quick add ----

    private IEnumerable<IActorDefinition> SearchBlueprints()
    {
        var blueprints = ContentRegistry.GetActorsBySystem(Campaign.SystemId);
        if (string.IsNullOrWhiteSpace(contentSearch)) return blueprints;
        return blueprints.Where(a => a.Name.Contains(contentSearch, StringComparison.OrdinalIgnoreCase) ||
            a.Tags.Any(t => t.Contains(contentSearch, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task QuickAddMonsterAsync(IActorDefinition definition)
    {
        var actor = new ActorDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Kind = ActorKind.Monster,
            BlueprintId = $"{definition.SystemId}:{definition.Id}",
            Name = definition.Name,
            Visibility = ActorVisibility.Hidden
        };
        ActorSheetSync.SeedFromBlueprint(actor, definition, Definition, Components);

        if (!await RuntimeManager.TryCreateActorAsync(actor, Access))
        {
            await OnMessage.InvokeAsync(Flash.Error("Only the DM can add creatures."));
            return;
        }

        contentSearch = "";
        await OnMessage.InvokeAsync(Flash.Success($"{actor.Name} added (hidden from players). Add them to initiative when ready."));

        if (OnActorAdded.HasDelegate)
        {
            await OnActorAdded.InvokeAsync();
        }
    }

    // ---- Dice ----

    private async Task RollDiceAsync()
    {
        if (string.IsNullOrWhiteSpace(diceExpression)) return;
        try
        {
            await runtime!.EnqueueAsync(new RollDiceCommand(diceExpression, null, CurrentUserId, diceSecret && Access.IsDm));
        }
        catch (FormatException ex)
        {
            await OnMessage.InvokeAsync(Flash.Error(ex.Message));
        }
    }

    private IEnumerable<RollLogEntry> VisibleRollLog() =>
        snapshot.RollLog
        .Where(entry => Access.IsDm || !entry.IsSecret)
        .OrderByDescending(entry => entry.Timestamp)
        .Take(20);

    private string ResolveRollerName(RollLogEntry entry) =>
        entry.ActorId != null ? ActorsById.GetValueOrDefault(entry.ActorId)?.Name ?? entry.ActorId : (entry.RollerUserId == CurrentUserId ? "You" : entry.RollerUserId == Campaign.OwnerId ? "DM" : "Player");

    // ---- Notes ----

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(noteText)) return;
        var text = noteText;
        noteText = "";
        await runtime!.EnqueueAsync(new AddSessionNoteCommand(CurrentUserId, text, noteSecret && Access.IsDm));
    }

    private IEnumerable<SessionNote> VisibleNotes() =>
        snapshot.Notes
        .Where(note => Access.IsDm || !note.IsSecret)
        .OrderByDescending(note => note.Timestamp);

    public async ValueTask DisposeAsync()
    {
        Detach();

        if (subscribedToManager)
        {
            RuntimeManager.RuntimeChanged -= OnRuntimeChanged;
        }

        await Task.CompletedTask;
    }
}
