@using Codex.Core
@using Codex.Core.Components
@using Codex.Core.Rules
@using Codex.Persistence
@using Codex.Persistence.Runtime
@using Codex.Plugin.Abstractions
@implements IAsyncDisposable
@inject CampaignRuntimeManager RuntimeManager
@inject Codex.Web.Services.ViewerClock ViewerTime
@inject IActorRepository ActorRepo
@inject ISessionRepository SessionRepo
@inject ComponentRegistry Components
@inject CampaignLibrary Library
@inject ILogger<CombatConsole> Logger

@* The table loop: initiative, hit points, conditions and dice, driven off one live
   CampaignRuntime per campaign. Every mutation goes through runtime.EnqueueAsync onto the campaign's
   single-writer loop; this component never touches ECS state directly. The DM picks one combatant
   at a time and works them from a command panel under their row. *@

<ConfirmDialog @ref="confirm" />

@if (runtime == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="dices" Size="28" /></div>
        @if (Access.IsDm)
        {
            <h3>@L["Combat.Console.NotRunning"]</h3>
            <p>@L["Combat.Console.NotRunningHint"]</p>
            @if (openSessions.Count > 0)
            {
                <div class="d-inline-flex flex-wrap gap-2 align-items-end justify-content-center mb-2">
                    <div class="text-start">
                        <label for="start-session" class="field-label">@L["Combat.Console.Session"]</label>
                        <select id="start-session" class="field-select field-sm" data-testid="start-session-select" @bind="startSessionId">
                            @foreach (var session in openSessions)
                            {
                                <option value="@session.Id">@SessionLabel(session)</option>
                            }
                            <option value="">@L["Combat.Console.NewSession"]</option>
                        </select>
                    </div>
                </div>
            }
            <div>
                <CodexButton Variant="CodexButtonVariant.Plaque" data-testid="start-table" Busy="starting" OnClick="StartOrJoinAsync">@L["Combat.Console.StartTable"]</CodexButton>
            </div>
        }
        else
        {
            <h3>@L["Combat.Console.WaitingDm"]</h3>
            <p>@L["Combat.Console.WaitingDmHint"]</p>
        }
    </div>
}
else
{
    var encounter = snapshot.Encounter;

    <div class="row g-3">
        <div class="col-lg-8">
            <section class="panel" aria-labelledby="initiative-heading">
                <div class="panel-title">
                    <h3 id="initiative-heading" class="mb-0" data-testid="initiative-header">@(encounter != null ? L["Combat.InitiativeRound", encounter.Round] : L["Combat.Initiative"])</h3>
                    @if (Access.IsDm && encounter is { Participants.Count: > 0 })
                    {
                        <div class="d-flex flex-wrap gap-1">
                            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" data-testid="prev-turn-btn" OnClick="PreviousTurnAsync"><LucideIcon IconName="chevron-left" Size="14" /> @L["Combat.Previous"]</CodexButton>
                            <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" data-testid="next-turn-btn" OnClick="NextTurnAsync">@L["Combat.NextTurn"] <LucideIcon IconName="chevron-right" Size="14" /></CodexButton>
                            <CodexButton Variant="CodexButtonVariant.Blood" Small="true" data-testid="end-encounter-btn" OnClick="EndEncounterAsync">@L["Combat.EndEncounter"]</CodexButton>
                        </div>
                    }
                </div>

                @if (encounter is { Participants.Count: > 0 } && CurrentTurnName(encounter) is { } turnName)
                {
                    <div class="round-banner turn-banner" data-testid="turn-banner">
                        <div class="turn-callout"><LucideIcon IconName="target" Size="18" /><span class="visually-hidden">@L["Combat.NowActing"]</span><span class="turn-name" aria-live="polite">@turnName</span></div>
                        @if (TurnPosition(encounter) is var (position, count))
                        {
                            <span class="small-muted">@L["Combat.TurnOfCount", position, count]</span>
                        }
                    </div>
                }

                @if (encounter == null || encounter.Participants.Count == 0)
                {
                    <p class="small-muted mb-0">@L["Combat.NobodyInOrder"]</p>
                }
                else
                {
                    @for (var i = 0; i < encounter.Participants.Count; i++)
                    {
                        var participant = encounter.Participants[i];
                        var isCurrent = i == encounter.TurnIndex;
                        var actor = ActorsById.GetValueOrDefault(participant.ActorId);

                        @* A participant this viewer can't see (a Hidden NPC, filtered out of a player's
                           Actors list) must not render at all - not even anonymously - or its existence
                           and turn position would leak. The DM's Actors list is unfiltered. *@
                        if (Access.IsDm || actor != null)
                        {
                            var actorId = participant.ActorId;
                            var name = actor?.Name ?? actorId;
                            var isSelected = Access.IsDm && selectedParticipantId == actorId;
                            var dead = IsDead(actorId);
                            var down = !dead && IsDown(actorId);
                            <InitiativeRow Campaign="Campaign" Participant="participant" Actor="actor" Name="@name" State="snapshot.Actor(actorId)" Definition="Definition" ActorsById="ActorsById"
                                           IsCurrent="isCurrent" IsSelected="isSelected" IsDm="Access.IsDm" Dead="dead" Down="down" Stable="IsStable(actorId)"
                                           CanSeeExact="CanSeeExact(actorId)" CanRollDeathSave="Access.IsDm || IsOwnCharacter(actorId)"
                                           OnToggleSelected="() => ToggleSelected(actorId)" OnRollDeathSave="() => SendAsync(new RollDeathSaveCommand(actorId, CurrentUserId))"
                                           OnRemoveCondition="effectId => SendAsync(new RemoveStatusEffectCommand(actorId, effectId))">
                                @if (isSelected)
                                {
                                    <TableCommandPanel @key="actorId" ActorId="@actorId" Name="@name" Participant="participant" Dead="dead" Down="down" Stable="IsStable(actorId)" IsDm="Access.IsDm"
                                                       Definition="Definition" Snapshot="snapshot" ActorsById="ActorsById" Rests="Rests" RestLabel="RestLabel" HitDice="HitDicePool(actorId)"
                                                       Send="SendAsync" OnMessage="OnMessage" OnClose="() => ToggleSelected(actorId)" OnRemoveFromOrder="() => RemoveFromOrderAsync(actorId)"
                                                       OnMarkDead="() => MarkDeadAsync(actorId, name)" OnSetVisibility="visibility => SetVisibilityAsync(actorId, visibility)" OnRest="rest => RestAsync(actorId, rest)" />
                                }
                            </InitiativeRow>
                        }
                    }
                }

                @if (Access.IsDm)
                {
                    <datalist id="conditions-list">
                        @foreach (var condition in PickableConditions)
                        {
                            <option value="@condition" label="@ConditionName(condition)"></option>
                        }
                    </datalist>
                    <InitiativeAddPanel Candidates="Actors.Where(a => encounter == null || encounter.Participants.All(p => p.ActorId != a.Id))" InitiativeDice="@InitiativeDice"
                                        BonusText="InitiativeBonusText" OnRoll="RollInitiativeAsync" OnSet="SetInitiativeAsync" OnMessage="OnMessage" />
                }
            </section>

            @if (Access.IsDm)
            {
                <QuickAddPanel SystemId="@Campaign.SystemId" OnAdd="QuickAddMonsterAsync" />

                @if (Rests.Count > 0)
                {
                    <section class="panel" aria-labelledby="party-rest-heading">
                        <div class="panel-title"><h3 id="party-rest-heading">@L["Combat.PartyRest"]</h3></div>
                        <p class="small-muted">@L["Combat.PartyRestHint"]</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var rest in Rests)
                            {
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" data-testid="@($"party-rest-{Slug(rest)}")" OnClick="() => PartyRestAsync(rest)">@L["Combat.PartyRestButton", RestLabel(rest)]</CodexButton>
                            }
                        </div>
                    </section>
                }

                <div class="d-flex justify-content-end">
                    <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="EndTableAsync" data-testid="end-table">@L["Combat.EndTable"]</CodexButton>
                </div>
            }
        </div>

        <div class="col-lg-4">
            @{
                var slotActors = SlotPoolRules.Count == 0 ? new List<ActorDocument>() : Actors.Where(a => CanTrackSlots(a.Id) && SlotKeys(a.Id).Any()).ToList();
            }
            @if (slotActors.Count > 0)
            {
                <section class="panel" aria-labelledby="slots-heading" data-testid="table-slots">
                    <div class="panel-title"><h3 id="slots-heading">@SlotTracker.Heading(Definition, SlotPoolRules, slotActors.SelectMany(a => SlotKeys(a.Id)))</h3></div>
                    @foreach (var actor in slotActors)
                    {
                        var actorId = actor.Id;
                        <div class="mb-3" data-testid="table-slots-actor" data-actor-id="@actorId">
                            <div class="fw-semibold mb-1"><a class="table-name" href="@ActorHref(actorId)" data-preview>@actor.Name</a></div>
                            <SlotTracker Definition="Definition" Pools="SlotPoolRules" Keys="SlotKeys(actorId)" Value="key => PoolValue(actorId, key)" Title="@(L["Combat.SlotsTitle", actor.Name])"
                                         OnAdjust="change => SendAsync(new AdjustResourceCommand(actorId, change.Key, change.Delta, change.Label))"
                                         OnRest="rest => SendAsync(new RestCommand(actorId, rest.Name, rest.Keys))" />
                        </div>
                    }
                </section>
            }

            <TableDicePanel Rolls="VisibleRollLog()" RollerName="ResolveRollerName" IsDm="Access.IsDm" OnRoll="RollDiceAsync"
                            ActorHref="@(actorId => ActorsById.ContainsKey(actorId) ? ActorHref(actorId) : null)" />

        </div>
    </div>
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public CampaignDocument Campaign { get; set; } = null!;
    [Parameter] public CampaignAccess Access { get; set; } = null!;
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public IEnumerable<ActorDocument> Actors { get; set; } = Enumerable.Empty<ActorDocument>();
    [Parameter] public SystemDefinition? Definition { get; set; }
    [Parameter] public EventCallback OnActorAdded { get; set; }
    [Parameter] public EventCallback<Flash> OnMessage { get; set; }

    private ConfirmDialog confirm = null!;
    private CampaignRuntime? runtime;
    // What this component renders from: an immutable picture the runtime's loop publishes with each
    // StateChanged. Reading the live encounter, roll log or entities during render could collide with
    // the loop mutating them and throw inside render (F13).
    private RuntimeSnapshot snapshot = RuntimeSnapshot.Empty;
    private string? selectedParticipantId;
    private string startSessionId = "";
    private List<SessionDocument> openSessions = new();
    private bool sessionsLoadedFor;
    // The roster the page last loaded its list of actors for; a different one in the snapshot means someone joined, left or
    // was revealed, and the list is reloaded (R1).
    private int rosterSeen;
    private bool subscribedToManager;
    // The sheet rule engine resolves initiative bonuses and class hit dice; loaded once per attach.
    private SheetRuleEngine? engine;
    private CachedEntryResolver? resolver;
    private Task? rulesLoading;

    // Built when the parameters are set, not on every read: a row reads it several times per render.
    private Dictionary<string, ActorDocument> ActorsById { get; set; } = new();
    // The actors this viewer can see, built with ActorsById for the visibility rules each render reads (F4).
    private HashSet<string> VisibleActorIds { get; set; } = new();
    private VitalsRules? Vitals => Definition?.Vitals;
    /// <summary>A rest as the table reads it ("Long Rest"); the rules still get the system's own name.</summary>
    private string RestLabel(string rest) => Definition?.DisplayValue(rest) ?? rest;

    /// <summary>A condition as the table reads it. The stored effect id stays the rules' own word.</summary>
    private string ConditionName(string condition) => Definition?.DisplayCondition(condition) ?? condition;

    private IEnumerable<string> PickableConditions => (Definition?.Conditions ?? Enumerable.Empty<string>())
        .Where(c => Vitals?.Exhaustion?.Condition == null || !string.Equals(c, Vitals.Exhaustion.Condition, StringComparison.OrdinalIgnoreCase))
        .Concat(Vitals?.Concentration is { } concentration ? new[] { concentration.Condition } : Array.Empty<string>())
        .Distinct(StringComparer.OrdinalIgnoreCase);
    private string InitiativeDice => Definition?.Dice.Initiative ?? "1d20";
    private static readonly DownRules NoDownRules = new();
    private DownRules Down => Vitals?.Down ?? NoDownRules;
    private string StableCondition => Down.StableCondition;

    /// <summary>Rest names the table offers: the system's rests plus whatever slot pools recover on.</summary>
    private List<string> Rests => (Vitals?.Rests.Select(r => r.Name) ?? Enumerable.Empty<string>())
        .Concat(SlotPoolRules.SelectMany(p => p.RecoversOn))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static string Slug(string text) => text.Replace(' ', '-').ToLowerInvariant();

    protected override async Task OnParametersSetAsync()
    {
        ActorsById = Actors.ToDictionary(a => a.Id);
        VisibleActorIds = ActorsById.Keys.ToHashSet();
        if (!subscribedToManager)
        {
            RuntimeManager.RuntimeChanged += OnRuntimeChanged;
            subscribedToManager = true;
        }

        if (runtime == null && RuntimeManager.TryGet(CampaignId) is { } existing)
        {
            Attach(existing);
        }

        if (runtime == null && Access.IsDm && !sessionsLoadedFor)
        {
            sessionsLoadedFor = true;
            await LoadOpenSessionsAsync();
        }
    }

    /// <summary>Sessions the DM can run: planned ones, and a live one the last table left behind. The
    /// campaign's current session is preselected when it is one of them; otherwise the next planned one.</summary>
    private async Task LoadOpenSessionsAsync()
    {
        openSessions = (await SessionRepo.GetAllForCampaignAsync(CampaignId))
            .Where(s => s.Status != SessionStatus.Completed)
            .OrderBy(s => s.Date)
            .ToList();
        startSessionId = openSessions.Any(s => s.Id == Campaign.CurrentSessionId) ? Campaign.CurrentSessionId! : openSessions.FirstOrDefault()?.Id ?? "";
    }

    private string SessionLabel(SessionDocument session) =>
        L["Combat.Console.SessionOption", string.IsNullOrWhiteSpace(session.Title) ? ViewerTime.Format(session.Date, "d MMM yyyy") : session.Title, SessionStatusLabel(session.Status)];

    private string SessionStatusLabel(SessionStatus status) => status switch
    {
        SessionStatus.Planned => L["Combat.Status.Planned"],
        SessionStatus.Live => L["Combat.Status.Live"],
        _ => L["Combat.Status.Completed"]
    };

    /// <summary>A player's open table page attaches the moment the DM starts (or ends) the table.</summary>
    private void OnRuntimeChanged(string campaignId)
    {
        if (campaignId != CampaignId) return;
        InvokeAsync(async () =>
        {
            var current = RuntimeManager.TryGet(CampaignId);
            if (current == null)
            {
                Detach();
                if (Access.IsDm) await LoadOpenSessionsAsync();
            }
            else
            {
                Attach(current);
            }

            StateHasChanged();
        });
    }

    private async Task StartOrJoinAsync()
    {
        var existing = RuntimeManager.TryGet(CampaignId);
        if (existing != null)
        {
            Attach(existing);
            return;
        }

        if (!Access.IsDm || starting) return;

        // Starting loads every actor and the session, so the button shows it is working rather than waiting silently (F18).
        starting = true;
        try
        {
            Attach(await RuntimeManager.GetOrStartAsync(Campaign, Access, string.IsNullOrEmpty(startSessionId) ? null : startSessionId));
        }
        catch (InvalidOperationException ex)
        {
            await OnMessage.InvokeAsync(Flash.Error(L.Describe(ex)));
        }
        finally
        {
            starting = false;
        }
    }

    private bool starting;

    private async Task EndTableAsync()
    {
        if (!Access.IsDm) return;
        var inCombat = snapshot.Encounter is { Participants.Count: > 0 };
        var ok = await confirm.ShowAsync(L["Combat.EndTableTitle"],
            inCombat ? L["Combat.EndTableCombat"] : L["Combat.EndTableIdle"],
            L["Combat.EndTable"], isDestructive: true);
        if (!ok) return;
        var completed = await RuntimeManager.EvictAsync(CampaignId);
        await OnMessage.InvokeAsync(Flash.Success(completed ? L["Combat.TableEnded"] : L["Combat.TableEndedKept"]));
    }

    /// <summary>Idempotent: starting the table reaches here twice (once from the manager's
    /// RuntimeChanged notification, once from the click handler), and a second subscription would
    /// outlive DisposeAsync's single unsubscribe (F14).</summary>
    private void Attach(CampaignRuntime started)
    {
        if (ReferenceEquals(runtime, started)) return;

        Detach();
        runtime = started;
        runtime.StateChanged += OnStateChanged;
        snapshot = runtime.Snapshot;
        rosterSeen = snapshot.RosterVersion;
        if (Access.IsDm && Definition != null && rulesLoading == null)
        {
            rulesLoading = LoadRulesAsync();
        }
    }

    private async Task LoadRulesAsync()
    {
        try
        {
            resolver = await CachedEntryResolver.LoadAsync(Library, Campaign, Access, Definition!);
            engine = new SheetRuleEngine(Definition!, resolver);
        }
        catch (Exception)
        {
            // Without the engine, initiative rolls fall back to the bare die and hit dice to the sheet's own count.
            engine = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void Detach()
    {
        if (runtime != null)
        {
            runtime.StateChanged -= OnStateChanged;
            runtime = null;
        }

        snapshot = RuntimeSnapshot.Empty;
        selectedParticipantId = null;
    }

    private void OnStateChanged(IReadOnlyCollection<string> _) => InvokeAsync(async () =>
    {
        if (runtime != null) snapshot = runtime.Snapshot;
        if (snapshot.RosterVersion != rosterSeen && OnActorAdded.HasDelegate)
        {
            // Someone joined or left the table, or the DM revealed or hid them: this viewer's list of who they may see is stale.
            rosterSeen = snapshot.RosterVersion;
            await OnActorAdded.InvokeAsync();
        }

        StateHasChanged();
    });

    private void ToggleSelected(string actorId) => selectedParticipantId = selectedParticipantId == actorId ? null : actorId;

    // ---- Initiative ----

    /// <summary>The system's initiative bonus for an actor: the named derived field (DEX modifier in
    /// the SRD), evaluated from their sheet. Zero when the system has none or the rules are not loaded.</summary>
    private int InitiativeBonus(string actorId)
    {
        if (engine == null || Definition?.Dice.InitiativeBonus is not { } key || ActorsById.GetValueOrDefault(actorId) is not { } actor) return 0;
        try
        {
            var evaluation = engine.Evaluate(actor.Sheet);
            return evaluation.Derived.TryGetValue(key, out var value) ? Convert.ToInt32(value) : 0;
        }
        catch (Exception)
        {
            return 0;
        }
    }

    private string InitiativeBonusText(string actorId)
    {
        if (string.IsNullOrEmpty(actorId)) return "";
        var bonus = InitiativeBonus(actorId);
        return bonus == 0 ? "" : bonus > 0 ? $" + {bonus}" : $" - {-bonus}";
    }

    /// <summary>The tie-break score: the attribute the system names (DEX), read off the sheet.</summary>
    private int TieBreak(string actorId)
    {
        if (Definition?.Dice.InitiativeTieBreak is not { } key || ActorsById.GetValueOrDefault(actorId) is not { } actor) return 0;
        return YamlValues.GetInt(actor.Sheet, key) ?? Definition.Attributes.FirstOrDefault(a => a.Key == key)?.Default ?? 0;
    }

    private Task RollInitiativeAsync((string ActorId, string Expression) roll)
    {
        var bonus = InitiativeBonus(roll.ActorId);
        return SendAsync(new RollInitiativeCommand(roll.ActorId, roll.Expression + (bonus == 0 ? "" : bonus > 0 ? $"+{bonus}" : bonus.ToString()), CurrentUserId, TieBreak(roll.ActorId)));
    }

    private Task SetInitiativeAsync((string ActorId, int Total) set) => SendAsync(new SetInitiativeCommand(set.ActorId, set.Total, TieBreak(set.ActorId)));

    private Task NextTurnAsync() => SendAsync(new NextTurnCommand());
    private Task PreviousTurnAsync() => SendAsync(new PreviousTurnCommand());

    private async Task RemoveFromOrderAsync(string actorId)
    {
        if (selectedParticipantId == actorId) selectedParticipantId = null;
        await SendAsync(new RemoveParticipantCommand(actorId));
    }

    private async Task EndEncounterAsync()
    {
        var ok = await confirm.ShowAsync(L["Combat.EndEncounterTitle"], L["Combat.EndEncounterText"], L["Combat.EndEncounter"], isDestructive: true);
        if (!ok) return;
        selectedParticipantId = null;
        await SendAsync(new EndEncounterCommand());
    }

    // ---- Reading the snapshot ----

    private IReadOnlyList<EffectSnapshot> GetEffects(string actorId) =>
        snapshot.Actor(actorId)?.Effects ?? Array.Empty<EffectSnapshot>();

    private bool HasEffect(string actorId, string effectId) =>
        GetEffects(actorId).Any(e => string.Equals(e.EffectId, effectId, StringComparison.OrdinalIgnoreCase));

    // The runtime's verdicts (TableRules.IsDead / IsDown), carried on the snapshot.
    private bool IsDead(string actorId) => snapshot.Actor(actorId)?.IsDead == true;
    private bool IsDown(string actorId) => snapshot.Actor(actorId)?.IsDown == true;
    private bool IsStable(string actorId) => HasEffect(actorId, StableCondition);

    private IReadOnlyList<SlotPoolRule> SlotPoolRules => Definition?.SheetRules?.SlotPools ?? (IReadOnlyList<SlotPoolRule>)Array.Empty<SlotPoolRule>();

    /// <summary>The DM tracks everyone's slots; a player tracks their own character's.</summary>
    private bool CanTrackSlots(string actorId) => Access.IsDm || ActorsById.GetValueOrDefault(actorId)?.OwnerUserId == CurrentUserId;

    private IEnumerable<string> SlotKeys(string actorId) =>
        snapshot.Actor(actorId)?.Pools?.Keys.Where(k => SlotPoolRules.Any(r => r.Owns(k))).ToList() ?? Enumerable.Empty<string>();

    private int? PoolValue(string actorId, string key) => snapshot.Actor(actorId)?.Pool(key);

    private bool CanSeeExact(string actorId) => Access.IsDm || ActorsById.GetValueOrDefault(actorId)?.OwnerUserId == CurrentUserId;

    private bool IsOwnCharacter(string actorId) => ActorsById.GetValueOrDefault(actorId) is { Kind: ActorKind.PlayerCharacter } a && a.OwnerUserId == CurrentUserId;

    private string ActorHref(string actorId) => MentionLinks.Href(CampaignId, MentionKind.Actor, actorId);

    /// <summary>Whose turn it is, for the banner. A participant the viewer can't see is never named. While one acts, players read
    /// "Someone you can't see": that a hidden creature is in the order is a hint the DM's table gives on purpose (F2, decided
    /// 2026-11-02), like a DM pausing behind the screen. Its name, rolls and place in the count stay hidden.</summary>
    private string? CurrentTurnName(EncounterSnapshot encounter)
    {
        if (encounter.TurnIndex < 0 || encounter.TurnIndex >= encounter.Participants.Count) return null;
        var id = encounter.Participants[encounter.TurnIndex].ActorId;
        var actor = ActorsById.GetValueOrDefault(id);
        return actor?.Name ?? (Access.IsDm ? id : L["Combat.SomeoneUnseen"]);
    }

    private (int Position, int Count)? TurnPosition(EncounterSnapshot encounter) =>
        TableVisibility.TurnPosition(encounter, Access.IsDm, VisibleActorIds);

    /// <summary>Death by the DM's hand goes through the table's rules (R3), after a confirm: it ends what the creature
    /// concentrated on and the effects counted on its turns.</summary>
    private async Task MarkDeadAsync(string actorId, string name)
    {
        if (!await confirm.ShowAsync(L["Combat.MarkDeadTitle", name], L["Combat.MarkDeadText"], L["Combat.MarkDead"], isDestructive: true)) return;
        await SendAsync(new KillCommand(actorId));
    }

    /// <summary>Shows, hides or unmasks a creature for the players without leaving the table (R1).</summary>
    private async Task SetVisibilityAsync(string actorId, ActorVisibility visibility)
    {
        if (!await RuntimeManager.TrySetVisibilityAsync(actorId, visibility, Access))
        {
            await OnMessage.InvokeAsync(Flash.Error(L["Combat.CommandFailed"]));
            return;
        }

        if (OnActorAdded.HasDelegate) await OnActorAdded.InvokeAsync();
    }

    // ---- Rests and hit dice ----

    private Task RestAsync(string actorId, string rest) => SendAsync(new RestCommand(actorId, rest, SlotKeysRestoredBy(actorId, rest)));

    private async Task PartyRestAsync(string rest)
    {
        foreach (var actor in Actors.Where(a => a.Kind == ActorKind.PlayerCharacter && snapshot.Actor(a.Id) != null))
        {
            await RestAsync(actor.Id, rest);
        }
    }

    private List<string> SlotKeysRestoredBy(string actorId, string rest) =>
        SlotKeys(actorId).Where(key => SlotPoolRules.Any(r => r.Owns(key) && r.RecoversOn.Contains(rest, StringComparer.OrdinalIgnoreCase) && !key.EndsWith("_Max", StringComparison.Ordinal))).ToList();

    private (int Current, int Max, int? Sides)? HitDicePool(string actorId)
    {
        if (Vitals?.HitDice is not { } rules || PoolValue(actorId, rules.MaxKey) is not { } max) return null;
        return (PoolValue(actorId, rules.Key) ?? 0, max, HitDieSides(actorId, rules));
    }

    /// <summary>The die to spend: the first class's hit die for a character, the stat block's for a creature.</summary>
    private int? HitDieSides(string actorId, HitDiceRules rules)
    {
        if (ActorsById.GetValueOrDefault(actorId) is not { } actor) return null;
        if (rules.CreatureDiceProperty != null && ActorSheetSync.HitDiceExpression.Parse(YamlValues.GetString(actor.Sheet, rules.CreatureDiceProperty)) is { } creature)
        {
            return creature.Sides;
        }

        var classId = YamlValues.GetString(actor.Sheet, rules.ClassField);
        var classType = Definition?.ActorFields.FirstOrDefault(f => f.Key == rules.ClassField)?.TargetEntityType;
        if (string.IsNullOrWhiteSpace(classId) || classType == null || resolver?.Resolve(classType, classId) is not { } entry) return null;
        return entry.Properties.TryGetValue(rules.DieProperty, out var raw) ? SheetRuleEngine.ParseHitDie(raw) : null;
    }

    // ---- Quick add ----

    private async Task<bool> QuickAddMonsterAsync(IActorDefinition definition)
    {
        var actor = new ActorDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Kind = ActorKind.Monster,
            BlueprintId = $"{definition.SystemId}:{definition.Id}",
            Name = definition.Name,
            // The players see a goblin join the fight, by what it is (R1); the DM hides or names it from its row.
            Visibility = ActorVisibility.Unknown,
            PublicName = definition.Name
        };
        ActorSheetSync.SeedFromBlueprint(actor, definition, Definition, Components);

        if (!await RuntimeManager.TryCreateActorAsync(actor, Access))
        {
            await OnMessage.InvokeAsync(Flash.Error(L["Combat.DmOnlyCreatures"]));
            return false;
        }

        await OnMessage.InvokeAsync(Flash.Success(L["Combat.CreatureAdded", actor.Name]));

        if (OnActorAdded.HasDelegate)
        {
            await OnActorAdded.InvokeAsync();
        }

        return true;
    }

    // ---- Dice ----

    private Task RollDiceAsync((string Expression, bool Secret) roll) =>
        SendAsync(new RollDiceCommand(roll.Expression, null, CurrentUserId, roll.Secret));

    /// <summary>How every button here reaches the runtime. The loop rethrows a command's failure into the caller, and an
    /// exception escaping a Blazor handler ends the whole circuit: a typo in the dice box, a database hiccup while saving
    /// a turn, or a table evicted between render and click would close the DM's page (D8). They become a message.</summary>
    private async Task SendAsync(IRuntimeCommand command)
    {
        if (runtime is not { } live)
        {
            await OnMessage.InvokeAsync(Flash.Error(L["Combat.TableClosed"]));
            return;
        }

        try
        {
            await live.EnqueueAsync(command);
        }
        catch (Exception ex) when (ex is FormatException or LocalizedException)
        {
            // The user's own input; nothing for the log.
            await OnMessage.InvokeAsync(Flash.Error(L.Describe(ex)));
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            await OnMessage.InvokeAsync(Flash.Error(L["Combat.TableClosed"]));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Runtime command {Command} failed for campaign {CampaignId}.", command.GetType().Name, CampaignId);
            await OnMessage.InvokeAsync(Flash.Error(L["Combat.CommandFailed"]));
        }
    }

    private IEnumerable<RollLogEntry> VisibleRollLog() =>
        TableVisibility.Rolls(snapshot.RollLog, Access.IsDm, VisibleActorIds);

    /// <summary>Who rolled. Like the turn banner, a creature the viewer can't see is never named (nor its id shown).</summary>
    private string ResolveRollerName(RollLogEntry entry) =>
        entry.ActorId != null
            ? ActorsById.GetValueOrDefault(entry.ActorId)?.Name ?? (Access.IsDm ? entry.ActorId : L["Combat.SomeoneUnseen"])
            : (entry.RollerUserId == CurrentUserId ? L["Combat.You"] : entry.RollerUserId == Campaign.OwnerId ? L["Combat.Dm"] : L["Combat.Player"]);

    public async ValueTask DisposeAsync()
    {
        Detach();

        if (subscribedToManager)
        {
            RuntimeManager.RuntimeChanged -= OnRuntimeChanged;
        }

        await Task.CompletedTask;
    }
}
