@using Codex.Core
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Services
@inject IHomebrewRepository Homebrew
@inject CampaignLibrary Library

@* DM-only editor for a campaign's homebrew entry. The field schema comes from the system's
   content type, so a homebrew spell has the same fields as an SRD spell. *@

<form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-labelledby="@(id)-title" data-testid="homebrew-editor">
    <h3 id="@(id)-title" class="h5">@(Entry.Id.Length == 0 ? "New homebrew entry" : $"Edit {Entry.Name}")</h3>

    <div class="field-grid mb-3">
        <div>
            <label for="@(id)-type" class="field-label">Type <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
            <select id="@(id)-type" class="field-select" value="@Entry.Type" @onchange="OnTypeChanged" required data-testid="homebrew-type">
                <option value="">— choose a type —</option>
                @foreach (var type in types)
                {
                    <option value="@type.Type">@type.Label</option>
                }
            </select>
        </div>
        <div>
            <label for="@(id)-name" class="field-label">Name <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
            <input id="@(id)-name" class="field-input" @bind="Entry.Name" required data-testid="homebrew-name" />
        </div>
        <div class="field-wide">
            <label for="@(id)-desc" class="field-label">Description</label>
            <textarea id="@(id)-desc" class="field-input" rows="5" @bind="Entry.Description" data-testid="homebrew-description"></textarea>
            <div class="field-hint">Plain text. <code>**bold**</code>, <code>*italic*</code>, "- " bullets and | tables | are rendered.</div>
        </div>
        <div>
            <label for="@(id)-tags" class="field-label">Tags</label>
            <input id="@(id)-tags" class="field-input" placeholder="Comma-separated" value="@string.Join(", ", Entry.Tags)"
                   @onchange="e => Entry.Tags = (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()" />
        </div>
        <div>
            <div class="field-check mt-4">
                <input id="@(id)-published" type="checkbox" class="field-box" @bind="Entry.IsPublished" />
                <label for="@(id)-published" >Visible to players</label>
            </div>
        </div>
    </div>

    @if (schema != null && schema.Fields.Count > 0)
    {
        <SchemaForm Schema="schema" Values="Entry.Properties" ReferenceOptions="referenceOptions" ShowGroupHeadings="false" />
    }

    <div class="d-flex gap-2 flex-wrap">
        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="homebrew-save">Save</CodexButton>
        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="OnCancel">Cancel</CodexButton>
        @if (Entry.Id.Length > 0)
        {
            <CodexButton Variant="CodexButtonVariant.Blood" Class="ms-auto" OnClick="DeleteAsync">Delete</CodexButton>
        }
    </div>
</form>

@code {
    [Parameter, EditorRequired] public CampaignDocument Campaign { get; set; } = null!;
    [Parameter, EditorRequired] public CampaignAccess Access { get; set; } = null!;
    [Parameter, EditorRequired] public HomebrewEntryDocument Entry { get; set; } = null!;
    [Parameter] public EventCallback<Flash> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<Flash> OnDeleted { get; set; }

    private readonly string id = "hb-" + Guid.NewGuid().ToString("N")[..6];
    private List<ContentTypeDefinition> types = new();
    private UISchema? schema;
    private Dictionary<string, IReadOnlyList<(string Id, string Name)>> referenceOptions = new();

    protected override async Task OnParametersSetAsync()
    {
        types = (await Library.TypesAsync(Campaign, Access)).ToList();
        await BuildSchemaAsync();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        Entry.Type = e.Value?.ToString() ?? string.Empty;
        await BuildSchemaAsync();
    }

    private async Task BuildSchemaAsync()
    {
        var type = types.FirstOrDefault(t => string.Equals(t.Type, Entry.Type, StringComparison.OrdinalIgnoreCase));
        schema = type == null ? null : new UISchema(type.Type, PreferredEditor.Form, type.EditorFields());

        referenceOptions = new Dictionary<string, IReadOnlyList<(string, string)>>();
        foreach (var target in (type?.EditorFields() ?? new List<FieldDefinition>()).Where(f => f.Type == FieldType.EntityReference && f.TargetEntityType != null).Select(f => f.TargetEntityType!).Distinct())
        {
            referenceOptions[target] = (await Library.OptionsAsync(Campaign, Access, target)).Select(i => (i.Entry.Id, i.Entry.Name)).ToList();
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Entry.Type) || string.IsNullOrWhiteSpace(Entry.Name))
        {
            await OnSaved.InvokeAsync(Flash.Error("A type and a name are required."));
            return;
        }

        Entry.SystemId = Campaign.SystemId;
        Entry.AuthorUserId = Access.UserId;
        if (await Homebrew.TrySaveAsync(Entry, Access))
        {
            await OnSaved.InvokeAsync(Flash.Success($"Saved “{Entry.Name}”."));
        }
        else
        {
            await OnSaved.InvokeAsync(Flash.Error("Only the DM can edit homebrew."));
        }
    }

    private async Task DeleteAsync()
    {
        if (await Homebrew.TryDeleteAsync(Entry.Id, Access))
        {
            await OnDeleted.InvokeAsync(Flash.Success($"Deleted “{Entry.Name}”."));
        }
        else
        {
            await OnDeleted.InvokeAsync(Flash.Error("Could not delete that entry."));
        }
    }
}
