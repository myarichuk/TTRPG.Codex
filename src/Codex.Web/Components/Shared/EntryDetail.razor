@using Codex.Core
@using Codex.Plugin.Abstractions
@using Codex.Web.Services
@inject IContentRegistry Registry
@inject ISystemCatalog Catalog

@* Renders one Library item: its summary fields, the formatted rules text, any structured rows
   (features, traits, actions) and - always - the licence attribution for where it came from. *@

<article class="entry-detail" aria-labelledby="@titleId">
    <header class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
        <div>
            <div class="label-caps"><DomainIcon Domain="kind" Key="@Item.Entry.Type" Size="DomainIconSize.Small" /> @TypeLabel</div>
            <h2 id="@titleId" class="mb-1">
                @if (DomainIconMap.Subject(Item.Entry) is { } subject)
                {
                    <span class="title-glyph" title="@subject.Label"><DomainIcon Domain="@subject.Domain" Key="@subject.Key" Size="DomainIconSize.Large" /></span>
                }
                @Item.Entry.Name
            </h2>
            <div class="d-flex flex-wrap gap-1">
                @if (Item.IsHomebrew)
                {
                    <span class="pill pill-accent">@L["Library.Homebrew"]</span>
                }
                @foreach (var tag in Item.Entry.Tags.Take(8))
                {
                    <span class="pill">@TagLabel(tag)</span>
                }
            </div>
        </div>
        @if (Actions != null)
        {
            <div class="row-actions">@Actions</div>
        }
    </header>

    @Art

    @if (Flavor is { } flavor)
    {
        <blockquote class="entry-flavor" data-testid="entry-flavor">@flavor</blockquote>
    }

    @if (MonsterCard.CanShow(Item.Entry))
    {
        <MonsterCard Entry="Item.Entry" />
    }
    else if (SpellCard.CanShow(Item.Entry))
    {
        <SpellCard Entry="Item.Entry" />
    }
    else if (ItemCard.CanShow(Item.Entry))
    {
        <ItemCard Entry="Item.Entry" />
    }
    else
    {
        @if (SummaryPairs.Count > 0)
        {
            <dl class="prop-list">
                @foreach (var pair in SummaryPairs)
                {
                    <dt>@pair.Label</dt>
                    <dd>@pair.Value</dd>
                }
            </dl>
        }

        @if (!string.IsNullOrWhiteSpace(Item.Entry.Description))
        {
            <div class="rules-text">@((MarkupString)TextFormatting.ToHtml(Item.Entry.Description))</div>
        }

        @foreach (var group in CollectionProperties)
        {
            <h3 class="h6 mt-3">@group.Label</h3>
            <ul class="feature-list">
                @foreach (var row in group.Rows)
                {
                    <li>
                        @if (row.TryGetValue("level", out var level))
                        {
                            <div class="feature-level">@L["Library.Detail.Level", level]</div>
                        }
                        <strong>@RefCard.Cell(row, "name")</strong>
                        @if (RefCard.Cell(row, "description") is { } description)
                        {
                            <div class="rules-text">@((MarkupString)TextFormatting.ToHtml(description))</div>
                        }
                    </li>
                }
            </ul>
        }
    }

    <footer class="attribution" data-testid="entry-attribution">
        <div><strong>@L["Library.Detail.Source"]</strong> @Item.SourceName@(Item.Entry.Source != null && !Item.IsHomebrew ? $" — {Item.Entry.Source}" : string.Empty)</div>
        @if (Item.License != null)
        {
            <div class="mt-1">
                @if (!string.IsNullOrWhiteSpace(Item.License.Attribution))
                {
                    <div>@Item.License.Attribution</div>
                }
                <div>
                    @L["Library.Detail.Licence"] @if (Item.License.Url != null) { <a href="@Item.License.Url" rel="license noopener" target="_blank">@Item.License.Name</a> } else { @Item.License.Name }
                    @if (Item.License.Modified) { <span> · @L["Library.Detail.Modified"]</span> }
                </div>
            </div>
        }
        else if (Item.IsHomebrew)
        {
            <div class="mt-1">@L["Library.Detail.HomebrewNote"]</div>
        }
        @foreach (var translationPack in TranslationPacks)
        {
            <div class="mt-1" data-testid="translation-attribution">
                <strong>@L["Library.Detail.Translation"]</strong> @translationPack.Name@(translationPack.License != null ? " · " + L["Library.Detail.LicenceName", translationPack.License.Name] : string.Empty)
                @if (translationPack.License?.Modified == true) { <span> · @L["Library.Detail.Modified"]</span> }
                @if (!string.IsNullOrWhiteSpace(translationPack.License?.Attribution))
                {
                    <div>@translationPack.License!.Attribution</div>
                }
                @foreach (var notice in translationPack.License?.Notices ?? new List<string>())
                {
                    <div>@notice</div>
                }
            </div>
        }
        @if (FlavorPack is { } lorePack)
        {
            <div class="mt-1" data-testid="flavor-attribution">
                <strong>@L["Library.Detail.LoreText"]</strong> @lorePack.Name@(lorePack.License != null ? " · " + L["Library.Detail.LicenceName", lorePack.License.Name] : string.Empty)
                @if (!string.IsNullOrWhiteSpace(lorePack.License?.Attribution))
                {
                    <div>@lorePack.License!.Attribution</div>
                }
            </div>
        }
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public LibraryItem Item { get; set; } = null!;
    [Parameter] public ContentTypeDefinition? Type { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>The entry's art slot, rendered under the title (the Library passes an <see cref="ArtSlot"/>).</summary>
    [Parameter] public RenderFragment? Art { get; set; }

    /// <summary>A tag as the reader should see it: translated when one of the type's fields knows the word (the tag stays English in the data).</summary>
    private string TagLabel(string tag) => TagLabels.Show(tag, Type, Catalog.GetDefinition(Item.Entry.SystemId), L);

    private readonly string titleId = "entry-title-" + Guid.NewGuid().ToString("N")[..6];

    /// <summary>The pack the lore text came from when it is not the pack that owns the rules (the SRD's text is not ours to add to).</summary>
    private PackManifest? FlavorPack =>
        Item.Entry.Properties.TryGetValue(ContentEntry.FlavorSourceKey, out var source) && !string.IsNullOrWhiteSpace(source?.ToString())
            && !string.Equals(source.ToString(), Item.Entry.PackId, StringComparison.OrdinalIgnoreCase)
            ? Registry.GetPack(source.ToString()!)
            : null;

    /// <summary>The translation packs the shown text came from, when the entry is displayed translated.</summary>
    private IEnumerable<PackManifest> TranslationPacks =>
        Item.Entry.Properties.TryGetValue(ContentEntry.TranslationSourceKey, out var source) && !string.IsNullOrWhiteSpace(source?.ToString())
            ? source.ToString()!.Split(',').Select(id => Registry.GetPack(id)).OfType<PackManifest>()
            : Enumerable.Empty<PackManifest>();

    private string? Flavor => Item.Entry.Properties.TryGetValue("flavor", out var value) && !string.IsNullOrWhiteSpace(value?.ToString()) ? value.ToString() : null;

    private string TypeLabel => Type?.Label ?? CampaignLibrary.Humanize(Item.Entry.Type);

    /// <summary>Scalar properties worth a definition list: declared summary fields first, then
    /// every other scalar (strings, numbers, booleans, tag lists) that isn't a collection.</summary>
    private List<(string Label, string Value)> SummaryPairs
    {
        get
        {
            var pairs = new List<(string, string)>();
            var fields = Type?.Fields ?? new List<FieldDefinition>();
            var ordered = (Type?.SummaryFields ?? new List<string>())
                .Concat(fields.Select(f => f.Key))
                .Concat(Item.Entry.Properties.Keys)
                .Distinct(StringComparer.OrdinalIgnoreCase);

            foreach (var key in ordered)
            {
                // Shown as the quote above (flavor), kept for art generation (imagePrompt), or bookkeeping (flavorSource).
                if (key is "flavor" or "imagePrompt" or ContentEntry.FlavorSourceKey or ContentEntry.TranslationSourceKey) continue;
                if (!Item.Entry.Properties.TryGetValue(key, out var value) || value == null) continue;
                var fieldDef = fields.FirstOrDefault(f => string.Equals(f.Key, key, StringComparison.OrdinalIgnoreCase));
                if (fieldDef?.Type == FieldType.Collection || IsRows(value) || !RefCard.IsPlain(value)) continue;
                if (fieldDef?.Type == FieldType.LongText && Item.Entry.Description?.Contains(value.ToString() ?? "\0") == true) continue;

                var text = value switch
                {
                    bool b => b ? L["Library.Detail.Yes"] : L["Library.Detail.No"],
                    IEnumerable<object> list => string.Join(", ", list.Select(o => Shown(fieldDef, o?.ToString()))),
                    _ => Shown(fieldDef, value.ToString())
                };
                if (text.Length == 0 || text.Length > 160) continue;
                pairs.Add((fieldDef?.Label ?? CampaignLibrary.Humanize(key), text));
            }

            return pairs;
        }
    }

    private List<(string Label, List<Dictionary<string, object>> Rows)> CollectionProperties
    {
        get
        {
            var result = new List<(string, List<Dictionary<string, object>>)>();
            foreach (var (key, value) in Item.Entry.Properties)
            {
                if (!IsRows(value)) continue;
                var fieldDef = Type?.Fields.FirstOrDefault(f => string.Equals(f.Key, key, StringComparison.OrdinalIgnoreCase));
                var rows = ((IEnumerable<object>)value).OfType<IDictionary<string, object>>().Select(r => new Dictionary<string, object>(r)).ToList();
                // Rows already rendered inside the description (the importer writes both) are skipped
                // when every row name appears in the text, to avoid showing a stat block twice.
                if (Item.Entry.Description != null && rows.Count > 0 && rows.All(r => r.GetValueOrDefault("name") is string n && Item.Entry.Description.Contains(n)))
                {
                    continue;
                }

                result.Add((fieldDef?.Label ?? CampaignLibrary.Humanize(key), rows));
            }

            return result;
        }
    }

    /// <summary>A stored value as the reader should see it: dropdown and tag values are translated, never replaced.</summary>
    private static string Shown(FieldDefinition? field, string? value) =>
        value == null ? string.Empty : field?.Display(value) ?? value;

    private static bool IsRows(object value) =>
        value is IEnumerable<object> list && list.Any() && list.All(item => item is IDictionary<string, object>);
}
