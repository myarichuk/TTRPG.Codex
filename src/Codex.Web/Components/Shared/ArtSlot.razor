@using Codex.Persistence
@using Codex.Web.Services
@implements IDisposable
@inject ILogger<ArtSlot> Logger

@* The picture every Library entry and place reserves room for. Readers see the art, or nothing
   when there is none. Editors see the frame either way, and can drop a file on it, pick one,
   have the image model draw one (and stop it while it draws), or remove it. What happens to the
   picture (store it now, or hold it until the wizard saves) is the caller's OnPicked. *@

@if (CanEdit || Src != null)
{
    <figure class="art-slot @(Landscape ? "art-landscape" : "art-portrait") @(Src == null ? "art-empty" : "") @Class" data-testid="@TestId">
        <div class="art-frame">
            @if (Src != null)
            {
                <img src="@Src" alt="@Alt" loading="lazy" />
            }
            else
            {
                <div class="art-placeholder" aria-hidden="true">
                    <LucideIcon IconName="image-plus" Size="30" />
                    <span>@L["Actor.Art.Drop"]</span>
                </div>
            }
            @if (CanEdit)
            {
                @* The file input covers the frame, so dropping a file anywhere on it works. *@
                <InputFile OnChange="OnFileAsync" accept="@ArtService.Accept" class="art-drop" title="@L["Actor.Art.DropTitle"]" aria-label="@L["Actor.Art.Choose", LabelText.ToLowerInvariant()]" disabled="@(busy != null)" data-testid="@($"{TestId}-file")" />
            }
            @if (busy != null)
            {
                <div class="art-busy">
                    @if (drawing.IsRunning)
                    {
                        <AiWorking Text="@busy" OnStop="drawing.Stop" TestId="@($"{TestId}-working")" />
                    }
                    else
                    {
                        <div role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @busy</div>
                    }
                </div>
            }
        </div>
        @if (CanEdit)
        {
            <figcaption class="art-actions">
                <span class="label-caps">@LabelText</span>
                <div class="d-flex flex-wrap gap-1">
                    @if (Generate != null)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" Icon="sparkles" OnClick="GenerateAsync" Disabled="@(busy != null)" data-testid="@($"{TestId}-generate")">@L["Actor.Art.Generate"]</CodexButton>
                    }
                    @if (Src != null && OnRemove.HasDelegate)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="x" OnClick="RemoveAsync" Disabled="@(busy != null)">@L["Actor.Art.Remove"]</CodexButton>
                    }
                </div>
                @if (error != null)
                {
                    <p class="text-danger small mb-0" role="alert">@error @if (notConfigured) { <a href="/settings/ai#images">@L["Actor.Art.SetUp"]</a> }</p>
                }
                else if (stopped)
                {
                    <p class="small-muted mb-0" role="status">@L["Common.Ai.Stopped"]</p>
                }
                else
                {
                    <p class="field-hint mb-0">@(Landscape ? L["Actor.Art.WideHint"] : L["Actor.Art.TallHint"]) @L["Actor.Art.FormatHint"]</p>
                }
            </figcaption>
        }
    </figure>
}

@code {
    /// <summary>The stored image's URL, if any.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>An image picked but not stored yet (the wizard holds it until Save); shown instead of <see cref="ImageUrl"/>.</summary>
    [Parameter] public ArtImage? Pending { get; set; }

    [Parameter] public string Alt { get; set; } = string.Empty;
    /// <summary>Caption of the frame; null shows the localized default ("Art").</summary>
    [Parameter] public string? Label { get; set; }

    private string LabelText => Label ?? L["Actor.Art.Label"];
    [Parameter] public bool Landscape { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TestId { get; set; } = "art-slot";

    [Parameter] public EventCallback<ArtImage> OnPicked { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    /// <summary>Draws an image; null hides the button. The token is cancelled by Stop.</summary>
    [Parameter] public Func<CancellationToken, Task<ArtImage>>? Generate { get; set; }

    private readonly AiCall drawing = new();
    private bool stopped;

    private string? busy;
    private string? error;
    private bool notConfigured;

    private string? Src => Pending != null ? $"data:{Pending.ContentType};base64,{Convert.ToBase64String(Pending.Bytes)}" : ImageUrl;

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        error = null;
        notConfigured = false;
        var file = e.File;
        if (ArtService.Problem(file.ContentType, file.Size) is { } problem)
        {
            error = problem;
            return;
        }

        busy = L["Actor.Art.Uploading"];
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(RavenMediaStore.MaxBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            await OnPicked.InvokeAsync(new ArtImage(buffer.ToArray(), file.ContentType));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Art upload failed");
            error = L["Actor.Art.UploadFailed", L.Describe(ex)];
        }
        finally
        {
            busy = null;
        }
    }

    private async Task GenerateAsync()
    {
        if (Generate == null || busy != null) return;
        error = null;
        notConfigured = false;
        stopped = false;
        busy = L["Actor.Art.Drawing"];
        var ct = drawing.Begin();
        try
        {
            var image = await Generate(ct);
            // Stopped just as the picture arrived: nothing is stored.
            ct.ThrowIfCancellationRequested();
            drawing.End(ct);
            await OnPicked.InvokeAsync(image);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            stopped = true;
        }
        catch (AiImageNotConfiguredException)
        {
            notConfigured = true;
            error = L["Actor.Art.NotConfigured"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Art generation failed");
            error = L["Actor.Art.DrawFailed", AiFailureText.For(L, ex)];
        }
        finally
        {
            drawing.End(ct);
            busy = null;
        }
    }

    public void Dispose() => drawing.Dispose();

    private async Task RemoveAsync()
    {
        error = null;
        await OnRemove.InvokeAsync();
    }
}
