@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Codex.Web.Components.Layout
@layout AuthLayout
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PersistentComponentState AppState
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Register | TTRPG.Codex</PageTitle>

<div class="login-card">
    <div class="brand-anchor">
        <div class="logo-mark">
            <LucideIcon IconName="gem" Size="32" />
        </div>
        <div class="brand-name">TTRPG.Codex</div>
    </div>

    @* Plain HTTP post (not an interactive EditForm): cookie sign-in needs a real
       HttpContext, which an interactive circuit doesn't have. Failures come back via
       ?error= (see /auth/register in Program.cs). *@
    <form method="post" action="/auth/register">
        <input type="hidden" name="__RequestVerificationToken" value="@AntiforgeryToken" />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger small p-2 mb-3 rounded" role="alert" style="background-color: rgba(220, 53, 69, 0.1); border-color: rgba(220, 53, 69, 0.2); color: #ff6b6b;">@ErrorMessage</div>
        }

        <div class="mb-3 text-start">
            <label for="username" class="form-label small text-secondary">Account Username <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="username" name="username" class="form-control w-100" placeholder="dm" autocomplete="username" required />
        </div>

        <div class="mb-3 text-start">
            <label for="password" class="form-label small text-secondary">Secret Key <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="password" name="password" type="password" class="form-control w-100" placeholder="••••••••" autocomplete="new-password" required />
        </div>

        <div class="mb-4 text-start">
            <label for="confirmPassword" class="form-label small text-secondary">Confirm Secret Key <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control w-100" placeholder="••••••••" autocomplete="new-password" required />
        </div>

        <button type="submit" class="btn-accent w-100 mt-2" disabled="@(AntiforgeryToken == null)">Initiate Account</button>
    </form>

    <div class="footer-links">
        Already a Storyteller? <a href="/login" class="text-accent">Enter Grimoire</a>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? QueryError { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string? AntiforgeryToken { get; set; }
    private PersistingComponentStateSubscription? _persistSubscription;

    protected override void OnInitialized()
    {
        // Prerendering runs this twice: once for SSR (HttpContext exists - mint the token)
        // and once on the live circuit (no HttpContext). Without persistence the second run
        // leaves the token null and the re-render blanks the form's hidden input, so every
        // submit 400s. Persist the SSR-minted token across the handoff instead.
        if (!AppState.TryTakeFromJson<string>("antiforgery", out var restored))
        {
            restored = HttpContext == null ? null : Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
        }

        AntiforgeryToken = restored;
        _persistSubscription = AppState.RegisterOnPersisting(() =>
        {
            AppState.PersistAsJson("antiforgery", AntiforgeryToken);
            return Task.CompletedTask;
        });

        if (!string.IsNullOrEmpty(QueryError))
        {
            ErrorMessage = QueryError;
        }
    }

    public string? ErrorMessage { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // In-circuit arrivals (link clicks) never ran SSR, so no token was minted or
        // persisted. Fetch one through the BROWSER - only a browser-issued request stores
        // the accompanying cookie where the form post will send it back from.
        // (OnAfterRenderAsync never runs during SSR, so this can't double-mint.)
        if (firstRender && AntiforgeryToken == null)
        {
            try
            {
                AntiforgeryToken = await JS.InvokeAsync<string>("codexAuth.getToken");
            }
            catch (JSException)
            {
                AntiforgeryToken = null;
            }

            StateHasChanged();
        }
    }

    public void Dispose() => _persistSubscription?.Dispose();
}
