@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using Codex.Persistence
@using Codex.Web.Components.Layout
@layout AuthLayout
@inject IUserRepository UserRepository
@inject ICampaignRepository CampaignRepository
@inject NavigationManager NavManager
@inject IConfiguration Configuration
@inject IServerSettingsStore Settings

<PageTitle>@L["Page.Register.Title"] | TTRPG.Codex</PageTitle>

<div class="auth-card">
    <div class="brand-mark" aria-hidden="true"><LucideIcon IconName="scroll" Size="28" /></div>
    <h1>@L["Page.Register.Heading"]</h1>

    @if (NotSetUp)
    {
        <div class="status" role="alert" data-testid="not-set-up">
            <LucideIcon IconName="info" Size="18" /><span>@L[Exposed ? "Page.Register.NoAccountYet" : "Page.Setup.Elsewhere"]</span>
        </div>
    }
    else if (!SignUpOpen)
    {
        <div class="status" role="alert" data-testid="invite-only">
            <LucideIcon IconName="info" Size="18" /><span>@L["Page.Register.InviteOnly"]</span>
        </div>
    }
    else
    {
    @if (NeedsApproval)
    {
        <div class="status" role="note" data-testid="needs-approval">
            <LucideIcon IconName="info" Size="18" /><span>@L["Page.Register.NeedsApproval"]</span>
        </div>
    }
    <EditForm Model="@Model" OnValidSubmit="HandleRegister" FormName="RegisterForm">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="status status-error" role="alert">
                <LucideIcon IconName="alert-triangle" Size="18" /><span>@ErrorMessage</span>
            </div>
        }

        <div class="mb-3">
            <label for="username" class="field-label">@L["Page.Auth.Username"]</label>
            <InputText id="username" class="field-input" autocomplete="username" required @bind-Value="Model!.Username" />
        </div>

        <div class="mb-3">
            <label for="password" class="field-label">@L["Page.Auth.Password"]</label>
            <InputText id="password" type="password" class="field-input" autocomplete="new-password" required aria-describedby="password-help" @bind-Value="Model!.Password" />
            <div id="password-help" class="field-hint">@L["Page.Register.PasswordHelp"]</div>
        </div>

        <div class="mb-4">
            <label for="confirmPassword" class="field-label">@L["Page.Register.Confirm"]</label>
            <InputText id="confirmPassword" type="password" class="field-input" autocomplete="new-password" required @bind-Value="Model!.ConfirmPassword" />
        </div>

        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Class="w-100">@L["Page.Register.Title"]</CodexButton>
    </EditForm>
    }

    <p class="text-center small-muted mt-4 mb-0">@L["Page.Register.HaveAccount"]<a href="@LoginHref">@L["Page.Auth.SignIn"]</a></p>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public RegisterModel? Model { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool Exposed => Codex.Web.ExposurePolicy.IsExposed(Configuration);

    /// <summary>False on a server open to the internet unless the visitor came from a real campaign invite.</summary>
    private bool SignUpOpen { get; set; } = true;

    /// <summary>Nobody has an account yet: the first one is the admin's, made in the setup on the server's own computer.</summary>
    private bool NotSetUp { get; set; }

    /// <summary>The new account will wait for an admin's approval.</summary>
    private bool NeedsApproval { get; set; }

    private string? ConfiguredAdmin => Configuration["Codex:AdminUsername"] is { Length: > 0 } name && !string.IsNullOrWhiteSpace(name) ? name : null;

    private string LoginHref => string.IsNullOrEmpty(ReturnUrl) ? "/login" : "/login?returnUrl=" + Uri.EscapeDataString(ReturnUrl);

    protected override async Task OnInitializedAsync()
    {
        Model ??= new();
        if (ConfiguredAdmin == null && !await UserRepository.AnyUsersExistAsync())
        {
            if (await ServerAccess.MaySetUpAsync(UserRepository, Exposed, HttpContext?.Connection.RemoteIpAddress))
            {
                NavManager.NavigateTo("/setup");
                return;
            }

            NotSetUp = true;
            return;
        }

        var status = await ServerAccess.NewAccountAsync(Settings, Exposed, ReturnUrl, CampaignRepository);
        SignUpOpen = status != null;
        NeedsApproval = status == AccountStatus.Pending;
    }

    public string? ErrorMessage { get; set; }

    private async Task HandleRegister()
    {
        if (HttpContext == null || Model == null)
        {
            ErrorMessage = L["Page.Register.Stale"];
            return;
        }

        if (NotSetUp)
        {
            return;
        }

        var status = await ServerAccess.NewAccountAsync(Settings, Exposed, ReturnUrl, CampaignRepository);
        if (status == null)
        {
            SignUpOpen = false;
            return;
        }

        if (PasswordRules.Problem(Model.Username, Model.Password, Model.ConfirmPassword) is { } problem)
        {
            ErrorMessage = L[problem];
            return;
        }

        var existingUser = await UserRepository.GetUserByUsernameAsync(Model.Username);
        if (existingUser != null)
        {
            ErrorMessage = L["Page.Register.Taken"];
            return;
        }

        var user = new UserDocument
        {
            Id = Guid.NewGuid().ToString(),
            Username = Model.Username,
            Roles = new List<string> { UserRoles.Player },
            Status = status.Value,
            CreatedAt = DateTime.UtcNow,
            // Whatever language the person has been reading the sign-up page in becomes their saved choice.
            Culture = SupportedCultures.Normalize(System.Globalization.CultureInfo.CurrentUICulture.Name)
        };

        var hasher = new PasswordHasher<UserDocument>();
        user.PasswordHash = hasher.HashPassword(user, Model.Password);

        if (!await UserRepository.TryReserveUsernameAsync(user.Username, user.Id))
        {
            ErrorMessage = L["Page.Register.Taken"];
            return;
        }

        // ServerAdmin goes to the configured Codex:AdminUsername, or to the first account made on this computer while the
        // server has no admin (claimed, so two sign-ups at once cannot both get it). Never while open to the internet:
        // whoever arrives with an invite must not be able to claim it; nor a LAN player who signs up before the DM (R13).
        var configuredAdmin = Configuration["Codex:AdminUsername"];
        var grantsServerAdmin = !Exposed && (!string.IsNullOrWhiteSpace(configuredAdmin)
            ? string.Equals(Model.Username, configuredAdmin, StringComparison.OrdinalIgnoreCase)
            : Codex.Web.ExposurePolicy.MayClaimFirstAdmin(Exposed, HttpContext.Connection.RemoteIpAddress) && await UserRepository.TryClaimFirstAdminAsync(user.Id));

        if (grantsServerAdmin)
        {
            // Whoever runs the server is approved and runs campaigns.
            user.Roles.Add(UserRoles.ServerAdmin);
            user.Roles.Add(UserRoles.GameMaster);
            user.Status = AccountStatus.Approved;
        }

        await UserRepository.CreateUserAsync(user);

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, UserPrincipal.For(user));

        var dest = user.Status == AccountStatus.Pending ? ServerAccess.WaitingPath
            : grantsServerAdmin && !(await Settings.GetAsync()).SetupDone ? "/setup/server"
            : Codex.Web.UrlHelper.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/";
        NavManager.NavigateTo(dest, forceLoad: true);
    }

    public class RegisterModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
