@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using Codex.Persistence
@using Codex.Web.Components.Layout
@layout AuthLayout
@inject IUserRepository UserRepository
@inject NavigationManager NavManager
@inject IConfiguration Configuration

<PageTitle>@L["Page.Register.Title"] | TTRPG.Codex</PageTitle>

<div class="auth-card">
    <div class="brand-mark" aria-hidden="true"><LucideIcon IconName="scroll" Size="28" /></div>
    <h1>@L["Page.Register.Heading"]</h1>

    <EditForm Model="@Model" OnValidSubmit="HandleRegister" FormName="RegisterForm">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="status status-error" role="alert">
                <LucideIcon IconName="alert-triangle" Size="18" /><span>@ErrorMessage</span>
            </div>
        }

        <div class="mb-3">
            <label for="username" class="field-label">@L["Page.Auth.Username"]</label>
            <InputText id="username" class="field-input" autocomplete="username" required @bind-Value="Model!.Username" />
        </div>

        <div class="mb-3">
            <label for="password" class="field-label">@L["Page.Auth.Password"]</label>
            <InputText id="password" type="password" class="field-input" autocomplete="new-password" required aria-describedby="password-help" @bind-Value="Model!.Password" />
            <div id="password-help" class="field-hint">@L["Page.Register.PasswordHelp"]</div>
        </div>

        <div class="mb-4">
            <label for="confirmPassword" class="field-label">@L["Page.Register.Confirm"]</label>
            <InputText id="confirmPassword" type="password" class="field-input" autocomplete="new-password" required @bind-Value="Model!.ConfirmPassword" />
        </div>

        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Class="w-100">@L["Page.Register.Title"]</CodexButton>
    </EditForm>

    <p class="text-center small-muted mt-4 mb-0">@L["Page.Register.HaveAccount"]<a href="/login">@L["Page.Auth.SignIn"]</a></p>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public RegisterModel? Model { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    public string? ErrorMessage { get; set; }

    private async Task HandleRegister()
    {
        if (HttpContext == null || Model == null)
        {
            ErrorMessage = L["Page.Register.Stale"];
            return;
        }

        if (Model.Password != Model.ConfirmPassword)
        {
            ErrorMessage = L["Page.Register.Mismatch"];
            return;
        }

        if (string.IsNullOrWhiteSpace(Model.Username) || string.IsNullOrWhiteSpace(Model.Password))
        {
            ErrorMessage = L["Page.Register.Required"];
            return;
        }

        if (Model.Password.Length < 8)
        {
            ErrorMessage = L["Page.Register.TooShort"];
            return;
        }

        if (!Model.Password.Any(char.IsUpper) || !Model.Password.Any(char.IsLower) || !Model.Password.Any(char.IsDigit))
        {
            ErrorMessage = L["Page.Register.Weak"];
            return;
        }

        var existingUser = await UserRepository.GetUserByUsernameAsync(Model.Username);
        if (existingUser != null)
        {
            ErrorMessage = L["Page.Register.Taken"];
            return;
        }

        var user = new UserDocument
        {
            Id = Guid.NewGuid().ToString(),
            Username = Model.Username,
            Roles = new List<string> { "Player" }
        };

        // ServerAdmin goes to the configured Codex:AdminUsername, or to the very first account.
        var configuredAdmin = Configuration["Codex:AdminUsername"];
        var grantsServerAdmin = !string.IsNullOrWhiteSpace(configuredAdmin)
            ? string.Equals(Model.Username, configuredAdmin, StringComparison.OrdinalIgnoreCase)
            : !await UserRepository.AnyUsersExistAsync();

        if (grantsServerAdmin)
        {
            user.Roles.Add("ServerAdmin");
        }

        var hasher = new PasswordHasher<UserDocument>();
        user.PasswordHash = hasher.HashPassword(user, Model.Password);

        if (!await UserRepository.TryReserveUsernameAsync(user.Username, user.Id))
        {
            ErrorMessage = L["Page.Register.Taken"];
            return;
        }

        await UserRepository.CreateUserAsync(user);

        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Name, user.Username),
            new Claim(ClaimTypes.NameIdentifier, user.Id)
        };

        foreach (var role in user.Roles)
        {
            claims.Add(new Claim(ClaimTypes.Role, role));
        }

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));

        var dest = Codex.Web.UrlHelper.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/";
        NavManager.NavigateTo(dest, forceLoad: true);
    }

    public class RegisterModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
