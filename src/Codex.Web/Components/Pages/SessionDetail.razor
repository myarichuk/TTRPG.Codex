@page "/campaigns/{CampaignId}/sessions/{SessionId}"
@using System.Security.Claims
@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject Codex.Web.Services.ViewerClock Clock
@inject ISessionRepository SessionRepo
@inject INoteRepository NoteRepo
@inject IActorRepository ActorRepo
@inject IJournalRepository JournalRepo
@inject ICampaignAccessResolver AccessResolver
@inject IUserRepository UserRepo
@inject AiFeatures Ai
@inject MentionSources MentionSources
@inject ILogger<SessionDetail> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject Codex.Persistence.Runtime.CampaignRuntimeManager RuntimeManager
@inject NavigationManager Nav

<PageTitle>@(Title ?? "Session") | TTRPG.Codex</PageTitle>

@if (loading)
{
    <LoadingSkeleton />
}
else if (campaign == null || session == null || access == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="calendar" Size="28" /></div>
        <h1 class="h4">Session not found</h1>
        <p>It may not exist, or you may not have access to it.</p>
        <a href="/" class="cx-btn cx-plaque">Back to campaigns</a>
    </div>
}
else
{
    <div class="page-header mb-3">
        <div>
            <nav aria-label="Breadcrumb" class="breadcrumb-nav mb-1"><a href="/">Campaigns</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId">@campaign.Name</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId/sessions">Sessions</a></nav>
            <h1 class="mb-0">@Title</h1>
            <div class="d-flex flex-wrap gap-1 mt-1">
                <span class="pill @(session.Status == SessionStatus.Live ? "pill-success" : "")">@(session.Status == SessionStatus.Live ? "" : "")@session.Status</span>
                <span class="pill"><LucideIcon IconName="calendar" Size="14" /> <LocalTime Value="session.Date" Format="dddd d MMM yyyy" /></span>
                <span class="pill"><LucideIcon IconName="zap" Size="14" /> @visibleEvents.Count event@(visibleEvents.Count == 1 ? "" : "s")</span>
            </div>
        </div>
        @if (access.IsDm)
        {
            <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" data-testid="run-session" OnClick="RunAtTableAsync">
                <LucideIcon IconName="dices" Size="14" /> @(RuntimeManager.TryGet(CampaignId)?.ActiveSession?.Id == session.Id ? "Go to the table" : session.Status == SessionStatus.Completed ? "Reopen at the table" : "Run at the table")
            </CodexButton>
        }
    </div>

    <StatusMessage Message="flash" OnDismiss="() => flash = null" />

    <div class="row g-3">
        <div class="col-lg-8">
            @if (access.IsDm)
            {
                <section class="panel" aria-labelledby="details-heading">
                    <div class="panel-title"><h2 id="details-heading" class="h5"><LucideIcon IconName="edit-3" Size="18" Class="title-icon" /> Details</h2></div>
                    <div class="field-grid">
                        <div>
                            <label for="session-title" class="field-label">Title</label>
                            <input id="session-title" class="field-input" @bind="editTitle" />
                        </div>
                        <div>
                            <label for="session-status" class="field-label">Status</label>
                            <select id="session-status" class="field-select" @bind="editStatus">
                                <option value="@SessionStatus.Planned">Planned</option>
                                <option value="@SessionStatus.Live">Live</option>
                                <option value="@SessionStatus.Completed">Completed</option>
                            </select>
                        </div>
                    </div>
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="mt-3" OnClick="SaveDetailsAsync">Save details</CodexButton>
                </section>
            }

            <section class="panel" aria-labelledby="recap-heading">
                <div class="panel-title">
                    <h2 id="recap-heading" class="h5"><LucideIcon IconName="book-open" Size="18" Class="title-icon" /> Recap</h2>
                    @if (access.IsDm)
                    {
                        <span class="pill pill-success"><LucideIcon IconName="users" Size="14" /> Players can read this</span>
                    }
                </div>
                @if (access.IsDm)
                {
                    <label for="recap" class="visually-hidden">Recap</label>
                    <textarea id="recap" class="field-input mb-2" rows="8" placeholder="What happened this session, as the players will read it…" @bind="editRecap" @bind:event="oninput" data-mentions="@mentionsJson" aria-describedby="mention-hint"></textarea>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="SaveRecapAsync">Save recap</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="PreFillRecap">Pre-fill from events</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" OnClick="() => DraftAsync(AiAudience.Players)" disabled="@(drafting != null)" aria-describedby="ai-help">
                            <LucideIcon IconName="sparkles" Size="14" /> @(drafting == AiAudience.Players ? "Drafting…" : "Draft with AI")
                        </CodexButton>
                    </div>
                    <p id="mention-hint" class="field-hint">Mention someone with @@, a place with # or an item with $; players read only the names they know.</p>
                    <p id="ai-help" class="field-hint">The player draft is built from the event log, party notes and open rolls only. Secret rolls, private notes and secret table notes never reach it.</p>
                }
                else if (!string.IsNullOrWhiteSpace(session.Recap))
                {
                    <div class="rules-text mb-0">@((MarkupString)MentionLinks.ToHtml(session.Recap, mentions, CampaignId))</div>
                }
                else
                {
                    <p class="small-muted mb-0">The DM hasn't written a recap yet.</p>
                }
            </section>

            @if (access.IsDm)
            {
                <section class="panel panel-dm" aria-labelledby="dm-summary-heading">
                    <div class="panel-title">
                        <h2 id="dm-summary-heading" class="h5"><LucideIcon IconName="lock" Size="18" Class="title-icon" /> DM summary</h2>
                        <span class="pill pill-warning"><LucideIcon IconName="eye-off" Size="14" /> Only you</span>
                    </div>
                    <label for="dm-summary" class="visually-hidden">DM summary</label>
                    <textarea id="dm-summary" class="field-input mb-2" rows="8" placeholder="Secrets, loose threads, hooks for next time…" @bind="editDmSummary" @bind:event="oninput" data-mentions="@mentionsJson"></textarea>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="SaveDmSummaryAsync">Save summary</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" OnClick="() => DraftAsync(AiAudience.Dm)" disabled="@(drafting != null)">
                            <LucideIcon IconName="sparkles" Size="14" /> @(drafting == AiAudience.Dm ? "Drafting…" : "Draft with AI")
                        </CodexButton>
                    </div>
                    <p class="field-hint">The DM draft sees everything: secret rolls, private notes and your previous summary.</p>
                </section>
            }

            <section class="panel" aria-labelledby="notes-heading">
                <div class="panel-title"><h2 id="notes-heading" class="h5"><LucideIcon IconName="message-square" Size="18" Class="title-icon" /> Table notes</h2></div>
                @if (noteRows.Count == 0)
                {
                    <p class="small-muted">No notes yet.</p>
                }
                @foreach (var note in noteRows)
                {
                    <div class="list-row align-items-start" data-testid="session-note">
                        <span class="avatar avatar-sm" aria-hidden="true">@Initial(memberUsernames.GetValueOrDefault(note.AuthorId, note.AuthorId))</span>
                        <div class="row-main">
                            <div class="row-sub">
                                <strong>@memberUsernames.GetValueOrDefault(note.AuthorId, note.AuthorId)</strong>
                                · <LocalTime Value="note.When" Format="d MMM, HH:mm" />
                                · <span class="pill">@note.Label</span>
                                @if (note.AtTable)
                                {
                                    <span class="pill ms-1">At the table</span>
                                }
                                @if (note.Kind != null)
                                {
                                    <span class="pill pill-kind ms-1">@note.Kind</span>
                                }
                                @if (note.Context != null)
                                {
                                    <span> · @note.Context</span>
                                }
                            </div>
                            @if (note.Speaker != null)
                            {
                                <p class="mb-0"><strong>@note.Speaker</strong>@if (note.With is { Count: > 0 }) { <span class="small-muted"> to @string.Join(", ", note.With)</span> }: <q><MentionText Text="@note.Text" Mentions="mentions" CampaignId="@CampaignId" /></q></p>
                            }
                            else
                            {
                                <p class="mb-0"><MentionText Text="@note.Text" Mentions="mentions" CampaignId="@CampaignId" /></p>
                            }
                        </div>
                    </div>
                }
                <form class="mt-3" @onsubmit="AddNoteAsync" @onsubmit:preventDefault="true">
                    <label for="new-note" class="field-label">Add a note</label>
                    <textarea id="new-note" class="field-input mb-2" rows="2" @bind="newNoteContent" @bind:event="oninput" data-mentions="@mentionsJson" data-testid="new-note"></textarea>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <label for="note-visibility" class="visually-hidden">Note visibility</label>
                        <select id="note-visibility" class="field-select field-sm" @bind="newNoteVisibility" aria-label="Note visibility">
                            <option value="@CommentVisibility.Private">Private (you and the DM)</option>
                            <option value="@CommentVisibility.Public">Party (everyone in the campaign)</option>
                        </select>
                        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Small="true">Add note</CodexButton>
                    </div>
                </form>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="panel panel-journal" aria-labelledby="journal-heading">
                <div class="panel-title">
                    <h2 id="journal-heading" class="h5"><LucideIcon IconName="notebook-pen" Size="18" Class="title-icon" /> My journal</h2>
                    <span class="pill"><LucideIcon IconName="lock" Size="14" /> Only you</span>
                </div>
                <p class="small-muted">Your private notebook for this session. Nobody else, not even the DM, can read it.</p>
                <label for="journal-body" class="visually-hidden">Journal entry</label>
                <textarea id="journal-body" class="field-input mb-2" rows="7" placeholder="Names to remember, theories, loot you're owed…" @bind="journalBody" @bind:event="oninput" data-mentions="@mentionsJson" data-testid="session-journal"></textarea>
                <div class="d-flex align-items-center gap-2">
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="SaveJournalAsync" data-testid="session-journal-save">Save journal</CodexButton>
                    @if (journalSavedAt != null)
                    {
                        <span class="small-muted" role="status">Saved <LocalTime Value="journalSavedAt.Value" Format="HH:mm" /></span>
                    }
                </div>
                <a href="/campaigns/@CampaignId/journal" class="small d-inline-block mt-2">All my journal entries</a>
            </section>

            <section class="panel" aria-labelledby="events-heading">
                <div class="panel-title"><h2 id="events-heading" class="h5"><LucideIcon IconName="clock" Size="18" Class="title-icon" /> Events (@visibleEvents.Count)</h2></div>
                @if (visibleEvents.Count == 0)
                {
                    <p class="small-muted mb-0">Nothing recorded yet. Events are written automatically while the table runs.</p>
                }
                <div class="log">
                    @foreach (var evt in visibleEvents.OrderByDescending(e => e.Timestamp))
                    {
                        <div class="log-entry">
                            <span class="small-muted"><LocalTime Value="evt.Timestamp" Format="HH:mm" /></span>
                            <span class="pill ms-1">@evt.Type</span>
                            <div>@evt.Description</div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public string SessionId { get; set; } = string.Empty;

    private bool loading = true;
    private CampaignDocument? campaign;
    private SessionDocument? session;
    private CampaignAccess? access;
    private string? currentUserId;
    private List<NoteRow> noteRows = new();
    private List<ActorDocument> campaignActors = new();
    // Places and items for mentions in table notes, as this viewer may see them.
    private IReadOnlyList<LocationDocument> places = Array.Empty<LocationDocument>();
    private IReadOnlyList<MentionItem> items = Array.Empty<MentionItem>();
    private MentionDirectory mentions = MentionDirectory.Empty;
    // What the recap, summary, note and journal boxes suggest after @, # or $.
    private string mentionsJson = "[]";
    private IReadOnlyList<SessionEvent> visibleEvents = Array.Empty<SessionEvent>();
    private readonly Dictionary<string, string> memberUsernames = new();
    private string newNoteContent = "";
    private CommentVisibility newNoteVisibility = CommentVisibility.Private;
    private string editRecap = "";
    private string editDmSummary = "";
    private string editTitle = "";
    private SessionStatus editStatus;
    private AiAudience? drafting;
    private JournalEntryDocument? journal;
    private string journalBody = "";
    private DateTime? journalSavedAt;
    private Flash? flash;

    /// <summary>One note on the page. <see cref="Speaker"/> is set for a line of dialogue, already named for this viewer.</summary>
    private sealed record NoteRow(string AuthorId, string Text, DateTime When, string Label, bool AtTable, string? Speaker = null,
        IReadOnlyList<string>? With = null, string? Kind = null, string? Context = null);

    private string NotesTargetId => $"session:{SessionId}";
    private string? Title => session == null ? null : string.IsNullOrWhiteSpace(session.Title) ? Clock.Format(session.Date, "d MMM yyyy") : session.Title;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        campaign = await CampaignRepo.GetAsync(CampaignId);
        access = campaign != null && currentUserId != null ? await AccessResolver.ResolveAsync(CampaignId, currentUserId) : null;

        if (campaign != null && access != null)
        {
            var loaded = await SessionRepo.GetAsync(SessionId);
            session = loaded?.CampaignId == CampaignId ? loaded : null;
            if (session != null)
            {
                editTitle = session.Title;
                editStatus = session.Status;
                campaignActors = (await ActorRepo.GetVisibleForCampaignAsync(access)).ToList();
                (places, items) = await MentionSources.LoadAsync(campaign, access);
                mentions = new MentionDirectory(campaignActors, places, items, access.IsDm);
                mentionsJson = MentionLinks.Json(mentions, campaignActors);
                // The boxes hold the text as typed (@Name); the stored text holds ids.
                editRecap = mentions.ForEditing(session.Recap ?? "");
                editDmSummary = access.IsDm ? mentions.ForEditing(session.DmSummary ?? "") : "";
                // Notes left here and quick notes typed at the live table, as one timeline. Secret table notes are the DM's alone.
                var pageNotes = await NoteRepo.GetNotesForTargetAsync(NotesTargetId, access);
                var actorsById = campaignActors.ToDictionary(a => a.Id);
                noteRows = pageNotes
                    .Select(n => new NoteRow(n.AuthorId, n.Content, n.CreatedAt, n.Visibility == CommentVisibility.Public ? "Party" : "Private", AtTable: false))
                    .Concat(session.Notes
                        .Where(n => access.IsDm || !n.IsSecret)
                        .Select(n => new NoteRow(n.AuthorId, n.Text, n.Timestamp, n.IsSecret ? "Secret" : "Party", AtTable: true,
                            n.SpeakerActorId == null ? null : SessionQuotes.SpeakerName(n.SpeakerActorId, actorsById, access.IsDm),
                            n.SpeakerActorId == null ? Array.Empty<string>() : SessionNotes.WithNames(n, actorsById, access.IsDm),
                            n.SpeakerActorId == null && n.Kind != NoteKind.Note ? SessionNotes.KindLabel(n.Kind) : null,
                            SessionNotes.Context(n, actorsById, access.IsDm))))
                    .OrderBy(n => n.When)
                    .ToList();
                visibleEvents = SessionEventRedactor.ForViewer(session.Events, access, campaignActors);
                memberUsernames.Clear();
                foreach (var member in campaign.Members)
                {
                    var user = await UserRepo.GetUserByIdAsync(member.UserId);
                    memberUsernames[member.UserId] = user?.Username ?? member.UserId;
                }

                journal = (await JournalRepo.GetMineAsync(access)).FirstOrDefault(j => j.SessionId == SessionId);
                journalBody = mentions.ForEditing(journal?.Body ?? "");
                journalSavedAt = journal?.UpdatedAt;
            }
        }

        loading = false;
    }

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();

    // The recap this fills in is what players read, so it starts from the player-safe log, not the DM's.
    private string SerializeEvents() => string.Join("\n",
        SessionEventRedactor.ForPlayers(session!.Events, campaignActors).OrderBy(e => e.Timestamp).Select(e => $"{e.Timestamp:HH:mm} [{e.Type}] {e.Description}"));

    private void PreFillRecap()
    {
        if (session == null) return;
        editRecap = SerializeEvents();
        flash = Flash.Info("Recap pre-filled from the event log. Edit and save.");
    }

    /// <summary>Starts the table on this session (a planned one begins, a completed one reopens) and goes there.</summary>
    private async Task RunAtTableAsync()
    {
        if (campaign == null || session == null || access == null || !access.IsDm) return;
        try
        {
            await RuntimeManager.GetOrStartAsync(campaign, access, session.Id);
            Nav.NavigateTo($"/campaigns/{CampaignId}/table");
        }
        catch (InvalidOperationException ex)
        {
            flash = Flash.Error(ex.Message);
        }
    }

    private async Task SaveDetailsAsync()
    {
        if (session == null || access == null || !access.IsDm) return;
        var title = editTitle.Trim();
        var status = editStatus;
        session = await SessionRepo.UpdateAsync(session.Id, stored =>
        {
            stored.Title = title;
            stored.Status = status;
        }) ?? session;
        flash = Flash.Success("Details saved.");
    }

    private async Task SaveRecapAsync()
    {
        if (session == null || access == null || !access.IsDm) return;
        var recap = mentions.Encode(editRecap);
        session = await SessionRepo.UpdateAsync(session.Id, stored => stored.Recap = recap) ?? session;
        editRecap = mentions.ForEditing(session.Recap ?? "");
        flash = Flash.Success("Recap saved.");
    }

    private async Task SaveDmSummaryAsync()
    {
        if (session == null || access == null || !access.IsDm) return;
        var summary = mentions.Encode(editDmSummary);
        session = await SessionRepo.UpdateAsync(session.Id, stored => stored.DmSummary = summary) ?? session;
        editDmSummary = mentions.ForEditing(session.DmSummary ?? "");
        flash = Flash.Success("DM summary saved.");
    }

    private async Task DraftAsync(AiAudience audience)
    {
        if (session == null || access == null || campaign == null || !access.IsDm || drafting != null) return;

        drafting = audience;
        try
        {
            // The player digest is built from player-visible notes only; the DM digest from everything.
            var allNotes = await NoteRepo.GetNotesForTargetAsync(NotesTargetId, access);
            var text = await Ai.SessionSummaryAsync(campaign, session, allNotes, audience, access, id => memberUsernames.GetValueOrDefault(id, "someone"), campaignActors, places, items);
            if (audience == AiAudience.Players) editRecap = text; else editDmSummary = text;
            flash = Flash.Info("AI draft ready. Review, edit and save.");
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error("No AI provider is set up. Add one under your account's AI settings (top right).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI summary failed for session {SessionId}", SessionId);
            flash = Flash.Error("The AI draft failed: " + ex.Message);
        }
        finally
        {
            drafting = null;
        }
    }

    private async Task SaveJournalAsync()
    {
        if (access == null) return;
        var entry = journal ?? new JournalEntryDocument { CampaignId = CampaignId, SessionId = SessionId, Title = Title ?? "Session" };
        entry.Body = mentions.Encode(journalBody);
        entry.Title = Title ?? entry.Title;
        if (await JournalRepo.TrySaveAsync(entry, access))
        {
            journal = entry;
            journalSavedAt = entry.UpdatedAt;
            flash = Flash.Success("Journal saved. Only you can read it.");
        }
        else
        {
            flash = Flash.Error("Could not save the journal entry.");
        }
    }

    private async Task AddNoteAsync()
    {
        if (access == null || currentUserId == null || string.IsNullOrWhiteSpace(newNoteContent)) return;

        await NoteRepo.CreateNoteAsync(new NoteDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            TargetId = NotesTargetId,
            AuthorId = currentUserId,
            Content = mentions.Encode(newNoteContent.Trim()),
            Visibility = newNoteVisibility
        });
        newNoteContent = "";
        flash = Flash.Success("Note added.");
        await ReloadAsync();
    }
}
