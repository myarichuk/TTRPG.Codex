@page "/campaigns/{CampaignId}/sessions/{SessionId}"
@using System.Security.Claims
@using Codex.Core.AI
@using Codex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject ISessionRepository SessionRepo
@inject INoteRepository NoteRepo
@inject ICampaignAccessResolver AccessResolver
@inject IUserRepository UserRepo
@inject LoreGenerator Lore
@inject ILogger<SessionDetail> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(Title ?? "Session") | TTRPG.Codex</PageTitle>

@if (loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"><span class="visually-hidden">Loading…</span></div></div>
}
else if (campaign == null || session == null || access == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="calendar" Size="28" /></div>
        <h1 class="h4">Session not found</h1>
        <p>It may not exist, or you may not have access to it.</p>
        <a href="/" class="btn btn-primary">Back to campaigns</a>
    </div>
}
else
{
    <div class="page-header mb-3">
        <div>
            <nav aria-label="Breadcrumb" class="small-muted mb-1"><a href="/">Campaigns</a> / <a href="/campaigns/@CampaignId">@campaign.Name</a> / <a href="/campaigns/@CampaignId/sessions">Sessions</a></nav>
            <h1 class="mb-0">@Title</h1>
            <div class="d-flex flex-wrap gap-1 mt-1">
                <span class="pill @(session.Status == SessionStatus.Live ? "pill-success" : "")">@session.Status</span>
                <span class="pill">@session.Date.ToLocalTime().ToString("dddd d MMM yyyy")</span>
            </div>
        </div>
    </div>

    <StatusMessage Message="flash" OnDismiss="() => flash = null" />

    <div class="row g-3">
        <div class="col-lg-8">
            @if (access.IsDm)
            {
                <section class="panel" aria-labelledby="details-heading">
                    <div class="panel-title"><h2 id="details-heading" class="h5">Details</h2></div>
                    <div class="field-grid">
                        <div>
                            <label for="session-title" class="form-label">Title</label>
                            <input id="session-title" class="form-control" @bind="editTitle" />
                        </div>
                        <div>
                            <label for="session-status" class="form-label">Status</label>
                            <select id="session-status" class="form-select" @bind="editStatus">
                                <option value="@SessionStatus.Planned">Planned</option>
                                <option value="@SessionStatus.Live">Live</option>
                                <option value="@SessionStatus.Completed">Completed</option>
                            </select>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mt-3" @onclick="SaveDetailsAsync">Save details</button>
                </section>
            }

            <section class="panel" aria-labelledby="recap-heading">
                <div class="panel-title"><h2 id="recap-heading" class="h5">Recap</h2></div>
                @if (access.IsDm)
                {
                    <label for="recap" class="visually-hidden">Recap</label>
                    <textarea id="recap" class="form-control mb-2" rows="6" placeholder="What happened this session…" @bind="editRecap" @bind:event="oninput"></textarea>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveRecapAsync">Save recap</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PreFillRecap">Pre-fill from events</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DraftWithAiAsync" disabled="@draftingAi" aria-describedby="ai-help">
                            @(draftingAi ? "Drafting…" : "Draft with AI")
                        </button>
                    </div>
                    <p id="ai-help" class="form-text mb-0">“Draft with AI” sends the event list to the configured chat model, only when you click it.</p>
                }
                else if (!string.IsNullOrWhiteSpace(session.Recap))
                {
                    <p class="mb-0" style="white-space: pre-wrap">@session.Recap</p>
                }
                else
                {
                    <p class="small-muted mb-0">The DM hasn't written a recap yet.</p>
                }
            </section>

            <section class="panel" aria-labelledby="notes-heading">
                <div class="panel-title"><h2 id="notes-heading" class="h5">Notes</h2></div>
                @if (notes.Count == 0)
                {
                    <p class="small-muted">No notes yet.</p>
                }
                @foreach (var note in notes)
                {
                    <div class="list-row align-items-start">
                        <div class="row-main">
                            <div class="row-sub">
                                <strong>@memberUsernames.GetValueOrDefault(note.AuthorId, note.AuthorId)</strong>
                                · @note.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")
                                · <span class="pill">@(note.Visibility == CommentVisibility.Public ? "Party" : "Private")</span>
                            </div>
                            <p class="mb-0">@note.Content</p>
                        </div>
                    </div>
                }
                <form class="mt-3" @onsubmit="AddNoteAsync" @onsubmit:preventDefault="true">
                    <label for="new-note" class="form-label">Add a note</label>
                    <textarea id="new-note" class="form-control mb-2" rows="2" @bind="newNoteContent" @bind:event="oninput" data-testid="new-note"></textarea>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <label for="note-visibility" class="visually-hidden">Note visibility</label>
                        <select id="note-visibility" class="form-select form-select-sm w-auto" @bind="newNoteVisibility" aria-label="Note visibility">
                            <option value="@CommentVisibility.Private">Private (you and the DM)</option>
                            <option value="@CommentVisibility.Public">Party (everyone in the campaign)</option>
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Add note</button>
                    </div>
                </form>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="panel" aria-labelledby="events-heading">
                <div class="panel-title"><h2 id="events-heading" class="h5">Events (@session.Events.Count)</h2></div>
                @if (session.Events.Count == 0)
                {
                    <p class="small-muted mb-0">Nothing recorded yet. Events are written automatically while the table runs.</p>
                }
                <div class="log">
                    @foreach (var evt in session.Events.OrderByDescending(e => e.Timestamp))
                    {
                        <div class="log-entry">
                            <span class="small-muted">@evt.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                            <span class="pill ms-1">@evt.Type</span>
                            <div>@evt.Description</div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public string SessionId { get; set; } = string.Empty;

    private bool loading = true;
    private CampaignDocument? campaign;
    private SessionDocument? session;
    private CampaignAccess? access;
    private string? currentUserId;
    private List<NoteDocument> notes = new();
    private readonly Dictionary<string, string> memberUsernames = new();
    private string newNoteContent = "";
    private CommentVisibility newNoteVisibility = CommentVisibility.Private;
    private string editRecap = "";
    private string editTitle = "";
    private SessionStatus editStatus;
    private bool draftingAi;
    private Flash? flash;

    private string NotesTargetId => $"session:{SessionId}";
    private string? Title => session == null ? null : string.IsNullOrWhiteSpace(session.Title) ? session.Date.ToLocalTime().ToString("d MMM yyyy") : session.Title;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        campaign = await CampaignRepo.GetAsync(CampaignId);
        access = campaign != null && currentUserId != null ? await AccessResolver.ResolveAsync(CampaignId, currentUserId) : null;

        if (campaign != null && access != null)
        {
            var loaded = await SessionRepo.GetAsync(SessionId);
            session = loaded?.CampaignId == CampaignId ? loaded : null;
            if (session != null)
            {
                editRecap = session.Recap ?? "";
                editTitle = session.Title;
                editStatus = session.Status;
                notes = (await NoteRepo.GetNotesForTargetAsync(NotesTargetId, access)).ToList();
                memberUsernames.Clear();
                foreach (var member in campaign.Members)
                {
                    var user = await UserRepo.GetUserByIdAsync(member.UserId);
                    memberUsernames[member.UserId] = user?.Username ?? member.UserId;
                }
            }
        }

        loading = false;
    }

    private string SerializeEvents() => string.Join("\n",
        session!.Events.OrderBy(e => e.Timestamp).Select(e => $"{e.Timestamp:HH:mm} [{e.Type}] {e.Description}"));

    private void PreFillRecap()
    {
        if (session == null) return;
        editRecap = SerializeEvents();
        flash = Flash.Info("Recap pre-filled from the event log. Edit and save.");
    }

    private async Task SaveDetailsAsync()
    {
        if (session == null || access == null || !access.IsDm) return;
        session.Title = editTitle.Trim();
        session.Status = editStatus;
        await SessionRepo.SaveAsync(session);
        flash = Flash.Success("Details saved.");
    }

    private async Task SaveRecapAsync()
    {
        if (session == null || access == null || !access.IsDm) return;
        session.Recap = editRecap;
        await SessionRepo.SaveAsync(session);
        flash = Flash.Success("Recap saved.");
    }

    private async Task DraftWithAiAsync()
    {
        if (session == null || access == null || !access.IsDm || draftingAi) return;

        draftingAi = true;
        try
        {
            editRecap = await Lore.SummarizeSessionAsync(SerializeEvents());
            flash = Flash.Info("AI draft ready. Review and save.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI recap draft failed for session {SessionId}", SessionId);
            flash = Flash.Error("The AI draft failed. The event list still works for a manual recap.");
        }
        finally
        {
            draftingAi = false;
        }
    }

    private async Task AddNoteAsync()
    {
        if (access == null || currentUserId == null || string.IsNullOrWhiteSpace(newNoteContent)) return;

        await NoteRepo.CreateNoteAsync(new NoteDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            TargetId = NotesTargetId,
            AuthorId = currentUserId,
            Content = newNoteContent.Trim(),
            Visibility = newNoteVisibility
        });
        newNoteContent = "";
        flash = Flash.Success("Note added.");
        await ReloadAsync();
    }
}
