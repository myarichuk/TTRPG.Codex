@* Not a page of its own: CampaignPage opens it as a window for /campaigns/{CampaignId}/sessions/{SessionId} (U2). *@
@using System.Security.Claims
@using System.Globalization
@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject Codex.Web.Services.ViewerClock Clock
@inject ISessionRepository SessionRepo
@inject INoteRepository NoteRepo
@inject IActorRepository ActorRepo
@inject IJournalRepository JournalRepo
@inject ICampaignAccessResolver AccessResolver
@inject IUserRepository UserRepo
@inject ISystemCatalog Catalog
@inject AiFeatures Ai
@inject MentionSources MentionSources
@inject ITemplateRepository TemplateRepo
@inject ILogger<SessionDetail> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject Codex.Persistence.Runtime.CampaignRuntimeManager RuntimeManager
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(Title ?? L["Session.Title"]) | TTRPG.Codex</PageTitle>
<UnsavedChangesGuard IsDirty="IsDirty" />
<ConfirmDialog @ref="confirm" />

@if (loading)
{
    <LoadingSkeleton />
}
else if (campaign == null || session == null || access == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="calendar" Size="28" /></div>
        <h1 class="h4">@L["Session.NotFound"]</h1>
        <p>@L["Session.NotFoundHint"]</p>
        <a href="/" class="cx-btn cx-plaque">@L["Session.BackToCampaigns"]</a>
    </div>
}
else
{
    <div class="page-header mb-3">
        <div>
            <nav aria-label="@L["Session.Breadcrumb"]" class="breadcrumb-nav mb-1"><a href="/">@L["Session.Campaigns"]</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId">@campaign.Name</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId/sessions">@L["Session.Sessions"]</a></nav>
            <h1 class="mb-0">@Title</h1>
            <div class="d-flex flex-wrap gap-1 mt-1">
                <span class="pill @(session.Status == SessionStatus.Live ? "pill-success" : "")">@StatusLabel(session.Status)</span>
                <span class="pill"><LucideIcon IconName="calendar" Size="14" /> <LocalTime Value="session.Date" Format="dddd d MMM yyyy" /></span>
                <span class="pill"><LucideIcon IconName="zap" Size="14" /> @L["Session.Events", visibleEvents.Count]</span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="arrow-left" OnClick="OnBack" data-testid="session-back">@BackLabel</CodexButton>
            @if (access.IsDm)
            {
                <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" data-testid="session-run" OnClick="RunAtTableAsync">
                    <LucideIcon IconName="dices" Size="14" /> @(RuntimeManager.TryGet(CampaignId)?.ActiveSession?.Id == session.Id ? L["Session.GoToTable"] : session.Status == SessionStatus.Completed ? L["Session.ReopenTable"] : L["Session.RunTable"])
                </CodexButton>
                <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Class="cx-blood" Icon="trash-2" Label="@L["Session.Delete.Label"]" OnClick="DeleteAsync" data-testid="session-delete" />
            }
        </div>
    </div>

    <StatusMessage Message="flash" OnDismiss="() => flash = null" Toast="true" />

    <div class="row g-3">
        <div class="col-lg-8">
            @if (access.IsDm)
            {
                <section class="panel" aria-labelledby="details-heading">
                    <div class="panel-title"><h2 id="details-heading" class="h5"><LucideIcon IconName="edit-3" Size="18" Class="title-icon" /> @L["Session.Details"]</h2></div>
                    <div class="field-grid">
                        <div>
                            <label for="session-title" class="field-label">@L["Session.TitleLabel"]</label>
                            <input id="session-title" class="field-input" @bind="editTitle" @bind:event="oninput" />
                        </div>
                        <div>
                            <label for="session-status" class="field-label">@L["Session.StatusLabel"]</label>
                            <select id="session-status" class="field-select" @bind="editStatus">
                                <option value="@SessionStatus.Planned">@L["Session.Status.Planned"]</option>
                                <option value="@SessionStatus.Live">@L["Session.Status.Live"]</option>
                                <option value="@SessionStatus.Completed">@L["Session.Status.Completed"]</option>
                            </select>
                        </div>
                        <div>
                            <label for="session-date" class="field-label">@L["Session.DateLabel"]</label>
                            <input id="session-date" type="date" class="field-input" data-testid="session-date"
                                   value="@ShownDate.ToString("yyyy-MM-dd")" @onchange="e => editDate = DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) ? day.Date : null" />
                        </div>
                    </div>
                </section>
            }

            <section class="panel" aria-labelledby="recap-heading">
                <div class="panel-title">
                    <h2 id="recap-heading" class="h5"><LucideIcon IconName="book-open" Size="18" Class="title-icon" /> @L["Session.Recap"]</h2>
                    @if (access.IsDm)
                    {
                        <span class="pill pill-success"><LucideIcon IconName="users" Size="14" /> @L["Session.PlayersCanRead"]</span>
                    }
                </div>
                @if (access.IsDm)
                {
                    <label for="recap" class="visually-hidden">@L["Session.Recap"]</label>
                    <MarkdownEditor Id="recap" Title="@L["Session.Recap"]" Rows="8" Placeholder="@L["Session.RecapPlaceholder"]" @bind-Value="editRecap" Mentions="@mentionsJson"
                                    DescribedBy="mention-hint" Preview="PreviewRecap" Secrets="true" TestId="session-recap"
                                    Busy="@(drafting == AiAudience.Players)" BusyText="@L["Session.Drafting"]" OnStop="aiCall.Stop" />
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="PreFillRecap">@L["Session.Prefill"]</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" Icon="sparkles" OnClick="() => DraftAsync(AiAudience.Players)" Disabled="@(drafting != null)" Busy="@(drafting == AiAudience.Players)" aria-describedby="ai-help">
                            @L["Session.DraftAi"]
                        </CodexButton>
                    </div>
                    <p id="mention-hint" class="field-hint">@L["Session.MentionHint"]</p>
                    <p id="ai-help" class="field-hint">@L["Session.AiHelp"]</p>
                }
                else if (!string.IsNullOrWhiteSpace(session.Recap))
                {
                    <div class="rules-text mb-0">@((MarkupString)SecretRender.Html(session.Recap, text => MentionLinks.ToHtml(text, mentions, CampaignId), null))</div>
                }
                else
                {
                    <p class="small-muted mb-0">@L["Session.NoRecap"]</p>
                }
            </section>

            @if (access.IsDm)
            {
                <section class="panel panel-dm" aria-labelledby="dm-summary-heading">
                    <div class="panel-title">
                        <h2 id="dm-summary-heading" class="h5"><LucideIcon IconName="lock" Size="18" Class="title-icon" /> @L["Session.DmSummary"]</h2>
                        <span class="pill pill-warning"><LucideIcon IconName="eye-off" Size="14" /> @L["Session.OnlyYou"]</span>
                    </div>
                    <label for="dm-summary" class="visually-hidden">@L["Session.DmSummary"]</label>
                    <MarkdownEditor Id="dm-summary" Title="@L["Session.DmSummary"]" Rows="8" Placeholder="@L["Session.DmSummaryPlaceholder"]" @bind-Value="editDmSummary" Mentions="@mentionsJson"
                                    Preview="PreviewMentions" TestId="session-dm-summary" Templates="templates" TemplatesHref="@($"/campaigns/{CampaignId}/templates")"
                                    Busy="@(drafting == AiAudience.Dm)" BusyText="@L["Session.Drafting"]" OnStop="aiCall.Stop" />
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" Icon="sparkles" OnClick="() => DraftAsync(AiAudience.Dm)" Disabled="@(drafting != null)" Busy="@(drafting == AiAudience.Dm)">
                            @L["Session.DraftAi"]
                        </CodexButton>
                    </div>
                    <p class="field-hint">@L["Session.DmDraftHint"]</p>
                </section>
            }

            <section class="panel" aria-labelledby="notes-heading">
                <div class="panel-title"><h2 id="notes-heading" class="h5"><LucideIcon IconName="message-square" Size="18" Class="title-icon" /> @L["Session.TableNotes"]</h2></div>
                @if (noteRows.Count == 0)
                {
                    <p class="small-muted">@L["Session.NoNotes"]</p>
                }
                @foreach (var note in noteRows)
                {
                    <div class="list-row align-items-start" data-testid="session-note">
                        <span class="avatar avatar-sm" aria-hidden="true">@Initial(memberUsernames.GetValueOrDefault(note.AuthorId, note.AuthorId))</span>
                        <div class="row-main">
                            <div class="row-sub">
                                <strong>@memberUsernames.GetValueOrDefault(note.AuthorId, note.AuthorId)</strong>
                                · <LocalTime Value="note.When" Format="d MMM, HH:mm" />
                                · <span class="pill">@note.Label</span>
                                @if (note.AtTable)
                                {
                                    <span class="pill ms-2">@L["Session.AtTable"]</span>
                                }
                                @if (note.Kind != null)
                                {
                                    <span class="pill pill-kind ms-2">@note.Kind</span>
                                }
                                @if (note.Context != null)
                                {
                                    <span> · @note.Context</span>
                                }
                            </div>
                            @if (note.Speaker != null)
                            {
                                <p class="mb-0"><strong>@note.Speaker</strong>@if (note.With is { Count: > 0 }) { <span class="small-muted">@(" " + L["Session.To", string.Join(", ", note.With)])</span> }: <q><MentionText Text="@note.Text" Mentions="mentions" CampaignId="@CampaignId" Dm="@NoteDm" /></q></p>
                            }
                            else
                            {
                                <p class="mb-0"><MentionText Text="@note.Text" Mentions="mentions" CampaignId="@CampaignId" Dm="@NoteDm" /></p>
                            }
                        </div>
                    </div>
                }
                <form class="mt-3" @onsubmit="AddNoteAsync" @onsubmit:preventDefault="true">
                    <label for="new-note" class="field-label">@L["Session.AddNoteLabel"]</label>
                    <textarea id="new-note" class="field-input mb-2" rows="2" @bind="newNoteContent" @bind:event="oninput" data-mentions="@mentionsJson" data-md-secrets="@(access?.IsDm == true ? "" : null)" aria-describedby="@(access?.IsDm == true ? "new-note-hint" : null)" data-testid="new-note"></textarea>
                    @if (access?.IsDm == true)
                    {
                        <p id="new-note-hint" class="field-hint">@L["Common.Note.SecretHint"]</p>
                    }
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <label for="note-visibility" class="visually-hidden">@L["Session.NoteVisibility"]</label>
                        <select id="note-visibility" class="field-select field-sm" @bind="newNoteVisibility" aria-label="@L["Session.NoteVisibility"]">
                            <option value="@CommentVisibility.Private">@L["Session.VisPrivate"]</option>
                            <option value="@CommentVisibility.Public">@L["Session.VisParty"]</option>
                        </select>
                        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Small="true">@L["Session.AddNote"]</CodexButton>
                    </div>
                </form>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="panel panel-journal" aria-labelledby="journal-heading">
                <div class="panel-title">
                    <h2 id="journal-heading" class="h5"><LucideIcon IconName="notebook-pen" Size="18" Class="title-icon" /> @L["Session.MyJournal"]</h2>
                    <span class="pill"><LucideIcon IconName="lock" Size="14" /> @L["Session.OnlyYou"]</span>
                </div>
                <p class="small-muted">@L["Session.JournalHint"]</p>
                <label for="journal-body" class="visually-hidden">@L["Session.JournalEntry"]</label>
                <MarkdownEditor Id="journal-body" Title="@L["Session.MyJournal"]" Rows="7" Placeholder="@L["Session.JournalPlaceholder"]" @bind-Value="journalBody" Mentions="@mentionsJson"
                                Preview="PreviewMentions" TestId="session-journal">
                    <TidyNotesButton @bind-Value="journalBody" Mentions="mentions" UserId="@(currentUserId ?? "")" TestId="session-journal-tidy" />
                </MarkdownEditor>
                @if (journalSavedAt != null)
                {
                    <p class="small-muted mb-0" role="status">@L["Session.Saved"] <LocalTime Value="journalSavedAt.Value" Format="HH:mm" /></p>
                }
                <a href="/campaigns/@CampaignId/journal" class="small d-inline-block mt-2">@L["Session.AllJournal"]</a>
            </section>

            <section class="panel" aria-labelledby="events-heading">
                <div class="panel-title"><h2 id="events-heading" class="h5"><LucideIcon IconName="clock" Size="18" Class="title-icon" /> @L["Session.EventsHeading", visibleEvents.Count]</h2></div>
                @if (visibleEvents.Count == 0)
                {
                    <p class="small-muted mb-0">@L["Session.EventsEmpty"]</p>
                }
                <div class="log">
                    @foreach (var evt in visibleEvents.OrderByDescending(e => e.Timestamp))
                    {
                        <div class="log-entry">
                            <span class="small-muted"><LocalTime Value="evt.Timestamp" Format="HH:mm" /></span>
                            <span class="pill ms-2">@TypeLabel(evt.Type)</span>
                            <div>@evt.Text(L, terms)</div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
    @* One Save for the whole page (U6): the details, recap and summary the DM wrote and this person's journal, whichever
       changed. Ctrl+S presses it from any of them. *@
    <SaveBar Dirty="IsDirty(includeNote: false)" TestId="session-save-bar">
        <CodexButton Variant="CodexButtonVariant.Plaque" Icon="check" OnClick="SaveAsync" Busy="@saveGate.IsBusy" data-testid="session-save" data-save-shortcut="" title="@L["Common.SaveShortcut"]">@L["Common.Save"]</CodexButton>
    </SaveBar>
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public string SessionId { get; set; } = string.Empty;

    /// <summary>Back to what the session was opened from (the list, the Table), and what the button says.</summary>
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public string BackLabel { get; set; } = string.Empty;

    private bool loading = true;
    private CampaignDocument? campaign;
    private SessionDocument? session;
    private CampaignAccess? access;
    private string? currentUserId;
    private List<NoteRow> noteRows = new();
    private List<ActorDocument> campaignActors = new();
    // Places and items for mentions in table notes, as this viewer may see them.
    private IReadOnlyList<LocationDocument> places = Array.Empty<LocationDocument>();
    private IReadOnlyList<MentionItem> items = Array.Empty<MentionItem>();
    private MentionDirectory mentions = MentionDirectory.Empty;
    // The DM reads a note's secret blocks marked; anyone else's copy has none.
    private DmView? NoteDm => access?.IsDm == true ? DmView.From(L, mentions) : null;
    // What the recap, summary, note and journal boxes suggest after @, # or $.
    private IReadOnlyList<TextTemplate>? templates;
    private string mentionsJson = "[]";
    private IReadOnlyList<SessionEvent> visibleEvents = Array.Empty<SessionEvent>();
    private readonly Dictionary<string, string> memberUsernames = new();
    private EventTermText? terms;
    private string newNoteContent = "";
    private CommentVisibility newNoteVisibility = CommentVisibility.Private;
    private string editRecap = "";
    private string editDmSummary = "";
    private string editTitle = "";
    private SessionStatus editStatus;
    // The day the DM picked, or null while unchanged. Kept as a day, not a time: the stored date is read in the viewer's
    // zone, which may only be known after the first render (R10).
    private DateTime? editDate;
    private DateTime ShownDate => editDate ?? Clock.ToViewer(session!.Date).Date;
    private AiAudience? drafting;
    private JournalEntryDocument? journal;
    private string journalBody = "";
    private DateTime? journalSavedAt;
    private Flash? flash;

    /// <summary>Whether any box on the page (details, recap, summary, journal, and unless left out a note being written)
    /// differs from what is stored. A note has its own Add button, so the save bar leaves it out.</summary>
    private bool IsDirty() => IsDirty(includeNote: true);

    private bool IsDirty(bool includeNote) =>
        session != null && access != null && !deleted
        && ((includeNote && !string.IsNullOrWhiteSpace(newNoteContent)) || JournalChanged || SessionChanged);

    private bool JournalChanged => journalBody != mentions.ForEditing(journal?.Body ?? "");

    private bool SessionChanged => session != null && access is { IsDm: true }
        && (editTitle.Trim() != (session.Title ?? "").Trim() || editStatus != session.Status
            || (editDate != null && editDate != Clock.ToViewer(session.Date).Date) || editRecap != mentions.ForEditing(session.Recap ?? "") || editDmSummary != mentions.ForEditing(session.DmSummary ?? ""));

    /// <summary>One note on the page. <see cref="Speaker"/> is set for a line of dialogue, already named for this viewer.</summary>
    private sealed record NoteRow(string AuthorId, string Text, DateTime When, string Label, bool AtTable, string? Speaker = null,
        IReadOnlyList<string>? With = null, string? Kind = null, string? Context = null);

    private string NotesTargetId => $"session:{SessionId}";
    private string? Title => session == null ? null : string.IsNullOrWhiteSpace(session.Title) ? Clock.Format(session.Date, "d MMM yyyy") : session.Title;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        campaign = await CampaignRepo.GetAsync(CampaignId);
        access = campaign != null && currentUserId != null ? await AccessResolver.ResolveAsync(CampaignId, currentUserId) : null;

        if (campaign != null && access != null)
        {
            // A player's copy comes redacted from the repository (F6): no DM summary, secret notes or DM blocks.
            session = await SessionRepo.GetVisibleAsync(SessionId, access);
            if (session != null)
            {
                editTitle = session.Title;
                editStatus = session.Status;
                campaignActors = (await ActorRepo.GetVisibleForCampaignAsync(access)).ToList();
                (places, items) = await MentionSources.LoadAsync(campaign, access);
                mentions = new MentionDirectory(campaignActors, places, items, access.IsDm) { Words = MentionSources.Words(L) };
                mentionsJson = MentionLinks.Json(mentions, campaignActors);
                // The boxes hold the text as typed (@Name); the stored text holds ids.
                editRecap = mentions.ForEditing(session.Recap ?? "");
                editDmSummary = access.IsDm ? mentions.ForEditing(session.DmSummary ?? "") : "";
                // Only for the DM's own summary: the recap is the players' to read, and a template can hold the DM's secrets.
                templates = access.IsDm ? await TemplateRepo.GetAsync(access, L) : null;
                // Notes left here and quick notes typed at the live table, as one timeline. Secret table notes are the DM's alone.
                var pageNotes = await NoteRepo.GetNotesForTargetAsync(NotesTargetId, access);
                var actorsById = campaignActors.ToDictionary(a => a.Id);
                noteRows = pageNotes
                    .Select(n => new NoteRow(n.AuthorId, n.Content, n.CreatedAt, n.Visibility == CommentVisibility.Public ? L["Session.Label.Party"] : L["Session.Label.Private"], AtTable: false))
                    .Concat(session.Notes
                        .Where(n => access.IsDm || !n.IsSecret)
                        .Select(n => new NoteRow(n.AuthorId, n.Text, n.Timestamp, n.IsSecret ? L["Session.Label.Secret"] : L["Session.Label.Party"], AtTable: true,
                            n.SpeakerActorId == null ? null : SessionQuotes.SpeakerName(n.SpeakerActorId, actorsById, access.IsDm, L["Session.UnknownSpeaker"]),
                            n.SpeakerActorId == null ? Array.Empty<string>() : SessionNotes.WithNames(n, actorsById, access.IsDm),
                            n.SpeakerActorId == null && n.Kind != NoteKind.Note ? KindLabel(n.Kind) : null,
                            RoundContext(n, actorsById, access.IsDm))))
                    .OrderBy(n => n.When)
                    .ToList();
                visibleEvents = SessionEventRedactor.ForViewer(session.Events, access, campaignActors);
                memberUsernames.Clear();
                foreach (var member in campaign.Members)
                {
                    var user = await UserRepo.GetUserByIdAsync(member.UserId);
                    memberUsernames[member.UserId] = user?.Username ?? member.UserId;
                }

                terms = EventTerms.For(Catalog.GetDefinition(campaign.SystemId), L, memberUsernames);

                journal = (await JournalRepo.GetMineAsync(access)).FirstOrDefault(j => j.SessionId == SessionId);
                journalBody = mentions.ForEditing(journal?.Body ?? "");
                journalSavedAt = journal?.UpdatedAt;
            }
        }

        loading = false;
    }

    private string StatusLabel(SessionStatus status) => status switch
    {
        SessionStatus.Planned => L["Session.Status.Planned"],
        SessionStatus.Live => L["Session.Status.Live"],
        _ => L["Session.Status.Completed"]
    };

    private string KindLabel(NoteKind kind) => NoteKindText.Label(L, kind);

    /// <summary>"Round 3 · Grik's turn", "Round 3" when the viewer can't see who was acting, or null outside an encounter.</summary>
    private string? RoundContext(SessionNote note, IReadOnlyDictionary<string, ActorDocument> visibleActors, bool isDm)
    {
        if (note.Round is not { } round) return null;
        return SessionNotes.TurnName(note, visibleActors, isDm) is { } turn ? L["Session.RoundTurn", round, turn] : L["Session.Round", round];
    }

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();

    // The recap this fills in is what players read, so it starts from the player-safe log, not the DM's.
    private string SerializeEvents() => string.Join("\n",
        SessionEventRedactor.ForPlayers(session!.Events, campaignActors).OrderBy(e => e.Timestamp).Select(e => $"{e.Timestamp:HH:mm} [{TypeLabel(e.Type)}] {e.Text(L, terms)}"));

    // An event type the log has no label for (one recorded by an older version) shows as stored.
    private string TypeLabel(string type) => L.Has("Event.Type." + type) ? L.Get("Event.Type." + type) : type;

    private void PreFillRecap()
    {
        if (session == null) return;
        editRecap = SerializeEvents();
        flash = Flash.Info(L["Session.Flash.Prefilled"]);
    }

    // ---- Deleting (U7): the DM's, never while the table runs it, with no undo (its encounters go with it). ----

    private ConfirmDialog? confirm;
    private bool deleted;

    /// <summary>Told when the session is deleted, with what to say; the window closes.</summary>
    [Parameter] public EventCallback<string> OnDeleted { get; set; }

    private async Task DeleteAsync()
    {
        if (session == null || access is not { IsDm: true } || confirm == null) return;
        if (RuntimeManager.TryGet(CampaignId)?.ActiveSession?.Id == session.Id)
        {
            flash = Flash.Error(L["Session.Delete.Running"]);
            return;
        }

        var name = Title!;
        if (!await confirm.ShowAsync(L["Session.Delete.Title", name], L["Session.Delete.Body"], L["Common.Delete"], isDestructive: true)) return;
        if (!await SessionRepo.DeleteAsync(session.Id, access))
        {
            flash = Flash.Error(L["Session.Delete.Failed"]);
            return;
        }

        deleted = true;
        await OnDeleted.InvokeAsync(L["Session.Delete.Done", name]);
    }

    /// <summary>Starts the table on this session (a planned one begins, a completed one reopens) and goes there.</summary>
    private async Task RunAtTableAsync()
    {
        if (campaign == null || session == null || access == null || !access.IsDm) return;
        try
        {
            await RuntimeManager.GetOrStartAsync(campaign, access, session.Id);
            Nav.NavigateTo($"/campaigns/{CampaignId}/table");
        }
        catch (InvalidOperationException ex)
        {
            flash = Flash.Error(L.Describe(ex));
        }
    }

    // A second Save (a double click, Ctrl+S twice) while one is still being written does nothing.
    private readonly SaveGate saveGate = new();

    private Task SaveAsync() => saveGate.RunAsync(SaveNowAsync);

    /// <summary>Stores whatever changed: the DM's details, recap and summary in one write, the journal in its own (U6).</summary>
    private async Task SaveNowAsync()
    {
        if (session == null || access == null) return;
        if (SessionChanged)
        {
            var title = editTitle.Trim();
            var status = editStatus;
            DateTime? date = editDate == null ? null : Clock.DayToUtc(editDate.Value);
            var recap = mentions.Encode(editRecap);
            var summary = mentions.Encode(editDmSummary);
            session = await SessionRepo.UpdateAsync(session.Id, stored =>
            {
                stored.Title = title;
                stored.Status = status;
                if (date != null) stored.Date = date.Value;
                stored.Recap = recap;
                stored.DmSummary = summary;
            }) ?? session;
            editDate = null;
            editRecap = mentions.ForEditing(session.Recap ?? "");
            editDmSummary = mentions.ForEditing(session.DmSummary ?? "");
        }

        if (JournalChanged && !await SaveJournalAsync())
        {
            flash = Flash.Error(L["Session.Flash.JournalFailed"]);
            return;
        }

        flash = Flash.Success(L["Common.Saved"]);
    }

    private async Task DraftAsync(AiAudience audience)
    {
        if (session == null || access == null || campaign == null || !access.IsDm || drafting != null) return;

        drafting = audience;
        var ct = aiCall.Begin();
        try
        {
            // The player digest is built from player-visible notes only; the DM digest from everything.
            var allNotes = await NoteRepo.GetNotesForTargetAsync(NotesTargetId, access);
            var text = await Ai.SessionSummaryAsync(campaign, session, allNotes, audience, access, id => memberUsernames.GetValueOrDefault(id, "someone"), campaignActors, places, items, ct);
            if (audience == AiAudience.Players) editRecap = text; else editDmSummary = text;
            flash = Flash.Info(L["Session.Flash.DraftReady"]);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            flash = Flash.Info(L["Common.Ai.Stopped"]);
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error(L["Session.Flash.NoAi"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI summary failed for session {SessionId}", SessionId);
            flash = Flash.Error(L["Session.Flash.DraftFailed", AiFailureText.For(L, ex)]);
        }
        finally
        {
            aiCall.End(ct);
            drafting = null;
        }
    }

    private readonly AiCall aiCall = new();

    public void Dispose() => aiCall.Dispose();

    /// <summary>The text as a reader will see it: the typed @Names become mentions first.</summary>
    private string PreviewMentions(string text) => MentionLinks.ToHtml(mentions.Encode(text), mentions, CampaignId);

    // The recap is the DM's prose that players read, so it takes secret blocks: the preview shows them as the DM reads them.
    private string PreviewRecap(string text) =>
        SecretRender.Html(mentions.Encode(text), encoded => MentionLinks.ToHtml(encoded, mentions, CampaignId), DmView.From(L, mentions));

    private async Task<bool> SaveJournalAsync()
    {
        if (access == null) return false;
        var entry = journal ?? new JournalEntryDocument { CampaignId = CampaignId, SessionId = SessionId, Title = Title ?? "Session" };
        entry.Body = mentions.Encode(journalBody);
        entry.Title = Title ?? entry.Title;
        if (!await JournalRepo.TrySaveAsync(entry, access)) return false;
        journal = entry;
        journalSavedAt = entry.UpdatedAt;
        return true;
    }

    private async Task AddNoteAsync()
    {
        if (access == null || currentUserId == null || string.IsNullOrWhiteSpace(newNoteContent)) return;

        await NoteRepo.CreateNoteAsync(new NoteDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            TargetId = NotesTargetId,
            AuthorId = currentUserId,
            Content = mentions.Encode(newNoteContent.Trim()),
            Visibility = newNoteVisibility
        });
        newNoteContent = "";
        flash = Flash.Success(L["Session.Flash.NoteAdded"]);
        await ReloadAsync();
    }
}
