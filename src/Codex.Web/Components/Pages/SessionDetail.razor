@page "/campaigns/{CampaignId}/sessions/{SessionId}"
@using System.Security.Claims
@using Codex.Core.AI
@using Codex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject ISessionRepository SessionRepo
@inject INoteRepository NoteRepo
@inject ICampaignAccessResolver AccessResolver
@inject IUserRepository UserRepo
@inject LoreGenerator Lore
@inject ILogger<SessionDetail> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(session?.Title ?? "Session") | TTRPG.Codex</PageTitle>

<div class="app-container">
@if (loading)
{
    <div class="d-flex justify-content-center my-5 py-5">
        <div class="spinner-border text-accent" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (campaign == null || session == null || access == null)
{
    <div class="empty-state text-center py-5">
        <h3>Session not found</h3>
        <p class="text-tertiary">It may not exist, or you may not have access to it.</p>
        <a href="/campaigns" class="btn btn-accent mt-3">Back to Campaigns</a>
    </div>
}
else
{
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">@(string.IsNullOrWhiteSpace(session.Title) ? session.Date.ToString("MMM dd, yyyy") : session.Title)</h1>
            <span class="badge bg-secondary">@session.Status</span>
            <span class="text-tertiary small ms-2">@session.Date.ToString("MMM dd, yyyy")</span>
        </div>
        <a href="/campaigns/@CampaignId" class="btn btn-outline-secondary btn-sm">Back to Campaign</a>
    </header>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info py-2">@statusMessage</div>
    }

    <div class="card p-3 mb-4">
        <h5>Recap</h5>
        @if (access.IsDm)
        {
            <textarea class="form-control form-control-sm mb-2" rows="5" placeholder="What happened this session..." @bind="editRecap" @bind:event="oninput"></textarea>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-accent btn-sm" @onclick="SaveRecapAsync">Save Recap</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PreFillRecap">Pre-fill from Events</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DraftWithAiAsync" disabled="@draftingAi">
                    @(draftingAi ? "Drafting..." : "Draft with AI")
                </button>
            </div>
            <p class="form-text small mb-0">AI draft sends the event list to the configured chat model, only when you click.</p>
        }
        else if (!string.IsNullOrWhiteSpace(session.Recap))
        {
            <p class="mb-0">@session.Recap</p>
        }
        else
        {
            <p class="text-tertiary small mb-0">The DM hasn't written a recap yet.</p>
        }
    </div>

    <div class="card p-3 mb-4">
        <h5>Session Notes</h5>
        @foreach (var note in notes)
        {
            <div class="border-bottom py-2">
                <div class="d-flex justify-content-between">
                    <strong class="small">@memberUsernames.GetValueOrDefault(note.AuthorId, note.AuthorId)</strong>
                    <span>
                        <span class="badge bg-dark me-1">@note.Visibility</span>
                        <span class="text-tertiary small">@note.CreatedAt.ToString("MMM dd, HH:mm")</span>
                    </span>
                </div>
                <p class="mb-0">@note.Content</p>
            </div>
        }
        @if (!notes.Any())
        {
            <p class="text-tertiary small">No notes yet.</p>
        }
        <div class="mt-3">
            <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="Add a note..." @bind="newNoteContent" @bind:event="oninput"></textarea>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm w-auto" @bind="newNoteVisibility" aria-label="Note visibility">
                    <option value="@CommentVisibility.Private">Private (you + DM)</option>
                    <option value="@CommentVisibility.Public">Public (whole party)</option>
                </select>
                <button type="button" class="btn btn-accent btn-sm" @onclick="AddNoteAsync">Add Note</button>
            </div>
        </div>
    </div>

    <div class="card p-3 mb-4">
        <h5>Events (@session.Events.Count)</h5>
        @foreach (var evt in session.Events.OrderBy(e => e.Timestamp))
        {
            <div class="small border-bottom py-1">
                <span class="text-tertiary">@evt.Timestamp.ToString("HH:mm")</span>
                <span class="badge bg-dark ms-1">@evt.Type</span>
                <span class="ms-1">@evt.Description</span>
            </div>
        }
        @if (!session.Events.Any())
        {
            <p class="text-tertiary small mb-0">Nothing recorded yet.</p>
        }
    </div>
}
</div>

@code {
    [Parameter]
    public string CampaignId { get; set; } = string.Empty;

    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    private bool loading = true;
    private CampaignDocument? campaign;
    private SessionDocument? session;
    private CampaignAccess? access;
    private string? currentUserId;
    private List<NoteDocument> notes = new();
    private Dictionary<string, string> memberUsernames = new();
    private string newNoteContent = "";
    private CommentVisibility newNoteVisibility = CommentVisibility.Private;
    private string editRecap = "";
    private bool draftingAi;
    private string? statusMessage;

    private string NotesTargetId => $"session:{SessionId}";

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        campaign = await CampaignRepo.GetAsync(CampaignId);
        if (campaign != null && currentUserId != null)
        {
            access = await AccessResolver.ResolveAsync(CampaignId, currentUserId);
        }

        if (campaign != null && access != null)
        {
            var loaded = await SessionRepo.GetAsync(SessionId);
            session = loaded?.CampaignId == CampaignId ? loaded : null;
            if (session != null)
            {
                editRecap = session.Recap ?? "";
                notes = (await NoteRepo.GetNotesForTargetAsync(NotesTargetId, access)).ToList();
                memberUsernames.Clear();
                foreach (var member in campaign.Members)
                {
                    var user = await UserRepo.GetUserByIdAsync(member.UserId);
                    memberUsernames[member.UserId] = user?.Username ?? member.UserId;
                }
            }
        }

        loading = false;
    }

    private string SerializeEvents() => string.Join("\n",
        session!.Events.OrderBy(e => e.Timestamp).Select(e => $"{e.Timestamp:HH:mm} [{e.Type}] {e.Description}"));

    private void PreFillRecap()
    {
        if (session == null)
        {
            return;
        }

        editRecap = SerializeEvents();
        statusMessage = "Recap pre-filled from the event log - edit and save.";
    }

    private async Task SaveRecapAsync()
    {
        if (session == null || access == null || !access.IsDm)
        {
            return;
        }

        session.Recap = editRecap;
        await SessionRepo.SaveAsync(session);
        statusMessage = "Recap saved.";
    }

    private async Task DraftWithAiAsync()
    {
        if (session == null || access == null || !access.IsDm || draftingAi)
        {
            return;
        }

        draftingAi = true;
        try
        {
            editRecap = await Lore.SummarizeSessionAsync(SerializeEvents());
            statusMessage = "AI draft ready - review and save.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI recap draft failed for session {SessionId}", SessionId);
            statusMessage = "AI draft failed. The event list below still works for a manual recap.";
        }
        finally
        {
            draftingAi = false;
        }
    }

    private async Task AddNoteAsync()
    {
        if (access == null || currentUserId == null || string.IsNullOrWhiteSpace(newNoteContent))
        {
            return;
        }

        await NoteRepo.CreateNoteAsync(new NoteDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            TargetId = NotesTargetId,
            AuthorId = currentUserId,
            Content = newNoteContent.Trim(),
            Visibility = newNoteVisibility
        });
        newNoteContent = "";
        statusMessage = "Note added.";
        await ReloadAsync();
    }
}
