@page "/loading"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<div class="loading-screen-backdrop" role="status" aria-live="polite">
    <div class="loading-container">
        <div class="logo-anchor" aria-hidden="true">
            <LucideIcon IconName="scroll" Size="32" />
        </div>
        <div class="brand-name">TTRPG.Codex</div>
        <div class="status-container">
            <div class="status-text active">Loading game systems and content packs…</div>
        </div>
        <div class="progress-wrapper" aria-hidden="true">
            <div class="progress-bar-inner"></div>
        </div>
    </div>
</div>
