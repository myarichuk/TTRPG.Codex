@page "/campaigns/{CampaignId}"
@using System.Security.Claims
@using System.Text
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Components.Layout
@using Codex.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject ICampaignRepository CampaignRepo
@inject IActorRepository ActorRepo
@inject IRegionRepository RegionRepo
@inject IFactRepository FactRepo
@inject ISessionRepository SessionRepo
@inject ICampaignAccessResolver AccessResolver
@inject INoteRepository NoteRepo
@inject IContentRegistry ContentRegistry
@inject ISystemCatalog SystemCatalog
@inject IUserRepository UserRepo
@inject CampaignExportService ExportService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>@(campaign?.Name ?? "Campaign")</PageTitle>

<div class="app-container">
@if (loading)
{
    <div class="d-flex justify-content-center my-5 py-5">
        <div class="spinner-border text-accent" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (campaign == null)
{
    <div class="empty-state text-center py-5">
        <h3>Campaign not found</h3>
        <a href="/campaigns" class="btn btn-accent mt-3">Back to Campaigns</a>
    </div>
}
else if (access == null)
{
    <div class="empty-state text-center py-5">
        <h3>You're not a member of this campaign</h3>
        <p class="text-tertiary">Ask the DM for an invite link.</p>
        <a href="/campaigns" class="btn btn-accent mt-3">Back to Campaigns</a>
    </div>
}
else
{
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-2">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/campaigns">Campaigns</a></li>
            <li class="breadcrumb-item active" aria-current="page">@campaign.Name</li>
        </ol>
    </nav>
    <div class="art-preview mb-4" aria-hidden="true">
        <LucideIcon IconName="map" Size="40" Class="text-white opacity-25" />
    </div>
    <header class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="mb-0">@campaign.Name</h1>
            <span class="badge bg-secondary">@campaign.SystemId</span>
            <span class="badge bg-info text-dark">@access.Role</span>
            <span class="badge @(IsTableOnline ? "bg-success" : "bg-dark") ms-1">@(IsTableOnline ? "Online" : "Offline")</span>
        </div>
        <a href="/campaigns" class="btn btn-outline-secondary btn-sm">Back to Campaigns</a>
    </header>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info py-2" role="status">@statusMessage</div>
    }

    <div class="nav nav-tabs fluent-tabs mb-4" role="tablist" aria-label="Campaign sections" @onkeydown="OnTabKeyDown">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" id="tab-@tab" aria-selected="@(activeTab == tab)" aria-controls="panel-@tab" tabindex="@(activeTab == tab ? "0" : "-1")"
                    class="nav-link @(activeTab == tab ? "active" : "")" @onclick="() => SelectTab(tab)">@tab</button>
        }
    </div>

    <div role="tabpanel" id="panel-@activeTab" aria-labelledby="tab-@activeTab" tabindex="0">
    @if (activeTab == "Overview")
    {
        @RenderOverview()
    }
    else if (activeTab == "Cast")
    {
        @RenderCast()
    }
    else if (activeTab == "Locations")
    {
        @RenderLocations()
    }
    else if (activeTab == "Lore")
    {
        @RenderLore()
    }
    else if (activeTab == "Sessions")
    {
        @RenderSessions()
    }
    else if (activeTab == "Combat")
    {
        @RenderCombat()
    }
    </div>
}
</div>

@code {
    private static readonly string[] Tabs = { "Overview", "Cast", "Locations", "Lore", "Sessions", "Combat" };

    [Parameter]
    public string CampaignId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? InitialTab { get; set; }

    private bool loading = true;
    private CampaignDocument? campaign;
    private CampaignAccess? access;
    private string? currentUserId;
    private string activeTab = "Overview";
    private string? statusMessage;

    private bool IsTableOnline => sessions.Any(s => s.Status == SessionStatus.Live);

    private void SelectTab(string tab) => activeTab = tab;

    private void OnTabKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        var index = Array.IndexOf(Tabs, activeTab);
        if (e.Key == "ArrowRight") SelectTab(Tabs[(index + 1) % Tabs.Length]);
        else if (e.Key == "ArrowLeft") SelectTab(Tabs[(index - 1 + Tabs.Length) % Tabs.Length]);
        else if (e.Key == "Home") SelectTab(Tabs[0]);
        else if (e.Key == "End") SelectTab(Tabs[^1]);
    }

    private IEnumerable<ActorDocument> actors = Enumerable.Empty<ActorDocument>();
    private IEnumerable<RegionDocument> regions = Enumerable.Empty<RegionDocument>();
    private IEnumerable<FactDocument> facts = Enumerable.Empty<FactDocument>();
    private IEnumerable<SessionDocument> sessions = Enumerable.Empty<SessionDocument>();
    private Dictionary<string, string> memberUsernames = new();

    private string editName = "";
    private string editDescription = "";

    private string contentSearch = "";
    private string newActorName = "New Actor";
    private ActorKind newActorKind = ActorKind.NonPlayerCharacter;
    private Dictionary<string, object> newActorValues = new();

    private string newRegionName = "";
    private string newLocationName = "";

    private string newFactSummary = "";
    private string newFactDetails = "";
    private FactVisibility newFactVisibility = FactVisibility.DmOnly;
    private readonly Dictionary<string, FactVisibility> approveVisibility = new();

    private List<NoteDocument> campaignNotes = new();
    private string newNoteContent = "";
    private CommentVisibility newNoteVisibility = CommentVisibility.Public;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(InitialTab) && Tabs.Contains(InitialTab, StringComparer.Ordinal))
        {
            activeTab = InitialTab;
        }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        campaign = await CampaignRepo.GetAsync(CampaignId);
        if (campaign != null && currentUserId != null)
        {
            access = await AccessResolver.ResolveAsync(CampaignId, currentUserId);
        }

        if (campaign != null && access != null)
        {
            editName = campaign.Name;
            editDescription = campaign.Description ?? "";

            actors = await ActorRepo.GetVisibleForCampaignAsync(access);
            regions = await RegionRepo.GetVisibleForCampaignAsync(access);
            var ownedActorIds = actors.Where(a => a.OwnerUserId == currentUserId).Select(a => a.Id).ToHashSet();
            facts = await FactRepo.GetVisibleForCampaignAsync(access, ownedActorIds);
            sessions = await SessionRepo.GetAllForCampaignAsync(CampaignId);
            campaignNotes = (await NoteRepo.GetNotesForTargetAsync(CampaignNotesTargetId, access)).ToList();

            memberUsernames.Clear();
            foreach (var member in campaign.Members)
            {
                var user = await UserRepo.GetUserByIdAsync(member.UserId);
                memberUsernames[member.UserId] = user?.Username ?? member.UserId;
            }
        }

        loading = false;
    }

    private void Flash(string message) => statusMessage = message;

    private string CampaignNotesTargetId => $"campaign:{CampaignId}";

    // ---- Overview (2.1, 2.4) ----

    private RenderFragment RenderOverview() => @<div>
        <div class="card p-3 mb-4">
            <h5>Chronicle</h5>
            @if (access!.IsDm)
            {
                <div class="mb-2">
                    <label class="form-label small" for="chronicle-name">Name</label>
                    <input id="chronicle-name" class="form-control" @bind="editName" />
                </div>
                <div class="mb-2">
                    <label class="form-label small" for="chronicle-desc">Description</label>
                    <textarea id="chronicle-desc" class="form-control" rows="2" @bind="editDescription"></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label small">System</label>
                    <div><span class="badge bg-secondary">@campaign!.SystemId</span> <span class="text-tertiary small">Locked after creation.</span></div>
                </div>
                <button type="button" class="btn btn-accent btn-sm" @onclick="SaveOverviewAsync">Save</button>
            }
            else
            {
                <p>@(string.IsNullOrWhiteSpace(campaign!.Description) ? "No chronicle notes yet." : campaign.Description)</p>
            }
        </div>

        <div class="card p-3 mb-4">
            <h5>Members (@campaign!.Members.Count)</h5>
            <ul class="list-unstyled mb-0">
                @foreach (var member in campaign.Members)
                {
                    var isOwner = string.Equals(member.UserId, campaign.OwnerId, StringComparison.Ordinal);
                    <li class="d-flex justify-content-between align-items-center border-bottom py-1 flex-wrap gap-1">
                        <span>@memberUsernames.GetValueOrDefault(member.UserId, member.UserId)
                            @if (isOwner)
                            {
                                <span class="text-tertiary small ms-1">(owner)</span>
                            }
                        </span>
                        @if (access!.IsDm && !isOwner)
                        {
                            <span class="d-flex gap-1 align-items-center flex-wrap">
                                <label class="visually-hidden" for="role-@member.UserId">Role for @memberUsernames.GetValueOrDefault(member.UserId, member.UserId)</label>
                                <select id="role-@member.UserId" class="form-select form-select-sm w-auto" value="@member.Role"
                                        @onchange="e => ChangeMemberRoleAsync(member, e.Value?.ToString())" aria-label="Role for @memberUsernames.GetValueOrDefault(member.UserId, member.UserId)">
                                    @foreach (CampaignRole r in Enum.GetValues<CampaignRole>())
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                                @if (pendingRemoveMemberId == member.UserId)
                                {
                                    <span class="inline-confirm">
                                        <span class="small">Remove?</span>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMemberConfirmed(member.UserId)">Confirm</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => pendingRemoveMemberId = null">Keep</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => pendingRemoveMemberId = member.UserId">Remove</button>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@member.Role</span>
                        }
                    </li>
                }
            </ul>
            @if (!access!.IsDm && !string.Equals(currentUserId, campaign.OwnerId, StringComparison.Ordinal))
            {
                @if (pendingRemoveMemberId == currentUserId)
                {
                    <span class="inline-confirm mt-2">
                        <span class="small">Leave this campaign?</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMemberConfirmed(currentUserId!)">Confirm</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => pendingRemoveMemberId = null">Stay</button>
                    </span>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="() => pendingRemoveMemberId = currentUserId">Leave campaign</button>
                }
            }
        </div>

        @if (access.IsDm)
        {
            <div class="card p-3">
                <h5>Invite</h5>
                <p class="text-tertiary small">Share this link to add a player to the campaign:</p>
                <div class="input-group">
                    <label class="visually-hidden" for="invite-link">Invite link</label>
                    <input id="invite-link" class="form-control" readonly value="@GetInviteLink()" aria-label="Invite link" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="CopyInviteLinkAsync">Copy</button>
                </div>
            </div>
        }
        @if (access.IsDm)
        {
            <div class="card p-3 mt-4">
                <h5>Backup</h5>
                <p class="text-tertiary small">Export downloads this campaign (actors, sessions, lore, notes) as one JSON file. Import restores it, including after deletion.</p>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExportCampaignAsync">Export Campaign (JSON)</button>
                    <label class="btn btn-outline-secondary btn-sm mb-0">Import Campaign (JSON)<InputFile OnChange="ImportCampaignAsync" accept=".json" class="d-none" /></label>
                </div>
            </div>
        }
    </div>;

    private string GetInviteLink() => $"{Nav.BaseUri}campaigns/join/{campaign!.InviteCode}";

    private async Task CopyInviteLinkAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", GetInviteLink());
            Flash("Invite link copied.");
        }
        catch (JSException)
        {
            Flash($"Copy this link manually: {GetInviteLink()}");
        }
    }

    private async Task ExportCampaignAsync()
    {
        var bundle = await ExportService.ExportAsync(access!);
        if (bundle == null)
        {
            Flash("Export failed.");
            return;
        }

        var json = CampaignExportService.Serialize(bundle);
        var href = "data:application/json;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
        await JSRuntime.InvokeVoidAsync("codexDownload", href, $"{campaign!.Name}-export.json");
        Flash("Export downloaded.");
    }

    private async Task ImportCampaignAsync(InputFileChangeEventArgs e)
    {
        if (currentUserId == null)
        {
            return;
        }

        try
        {
            using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var bundle = CampaignExportService.Deserialize(await reader.ReadToEndAsync());
            if (bundle == null)
            {
                Flash("That file isn't a campaign export.");
                return;
            }

            if (await ExportService.ImportAsync(bundle, currentUserId))
            {
                Flash($"Imported campaign \"{bundle.Campaign?.Name}\".");
                await ReloadAsync();
            }
            else
            {
                Flash("Import rejected: unrecognized format or insufficient permission.");
            }
        }
        catch (Exception ex)
        {
            Flash($"Import failed: {ex.Message}");
        }
    }

    private string? pendingRemoveMemberId;

    private async Task ChangeMemberRoleAsync(CampaignMember member, string? roleText)
    {
        if (currentUserId == null || !Enum.TryParse<CampaignRole>(roleText, out var role))
        {
            return;
        }

        Flash(await CampaignRepo.SetMemberRoleAsync(CampaignId, member.UserId, role, currentUserId)
            ? $"Role updated to {role}."
            : "Couldn't change that role.");
        await ReloadAsync();
    }

    private async Task RemoveMemberConfirmed(string targetUserId)
    {
        pendingRemoveMemberId = null;
        if (currentUserId == null)
        {
            return;
        }

        await CampaignRepo.RemoveMemberAsync(CampaignId, targetUserId, currentUserId);
        if (string.Equals(targetUserId, currentUserId, StringComparison.Ordinal))
        {
            Nav.NavigateTo("/campaigns");
            return;
        }

        Flash("Member removed.");
        await ReloadAsync();
    }

    private async Task SaveOverviewAsync()
    {
        campaign!.Name = editName;
        campaign.Description = editDescription;
        // SystemId is intentionally never written here: the system is locked after creation
        // because blueprints, UI schemas, and every actor's State shape hang off it.
        try
        {
            await CampaignRepo.SaveAsync(campaign);
            Flash("Saved.");
        }
        catch (InvalidOperationException ex)
        {
            Flash(ex.Message);
        }
        await ReloadAsync();
    }

    // ---- Cast (2.2, 2.3, 2.5) ----

    private RenderFragment RenderCast() => @<div>
        <div class="row">
            <div class="col-md-7">
                <h5>Actors</h5>
                @foreach (var actor in actors)
                {
                    <div class="card p-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong><a href="@($"/campaigns/{CampaignId}/actors/{actor.Id}")">@actor.Name</a></strong>
                                <span class="badge bg-secondary ms-1">@actor.Kind</span>
                                <span class="badge bg-dark ms-1">@actor.Visibility</span>
                            </div>
                            @if (access!.IsDm)
                            {
                                <div class="d-flex gap-1 align-items-center flex-wrap">
                                    @if (actor.Visibility != ActorVisibility.Known)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => RevealActorAsync(actor)">Reveal to Party</button>
                                    }
                                    @if (pendingDeleteActorId == actor.Id)
                                    {
                                        <span class="inline-confirm">
                                            <span class="small">Delete?</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteActorConfirmed(actor)">Confirm</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => pendingDeleteActorId = null">Keep</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => pendingDeleteActorId = actor.Id" aria-label="Delete @actor.Name">Delete</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (!actors.Any())
                {
                    <p class="text-tertiary small">No actors yet.</p>
                }
                <a href="@($"/campaigns/{CampaignId}/create")" class="btn btn-accent btn-sm mt-2" data-testid="create-character-link">Create a Character</a>
            </div>
            @if (access!.IsDm)
            {
                <div class="col-md-5">
                    <h5>Add from Content</h5>
                    <label class="visually-hidden" for="cast-content-search">Search actors</label>
                    <input id="cast-content-search" class="form-control form-control-sm mb-2" placeholder="Search @campaign!.SystemId actors..." aria-label="Search actors" @bind="contentSearch" @bind:event="oninput" />
                    @foreach (var definition in SearchActorBlueprints())
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                            <span>@definition.Name</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddActorFromBlueprintAsync(definition)">Add to Campaign</button>
                        </div>
                    }

                    <h5 class="mt-4">New Blank Actor</h5>
                    <label class="visually-hidden" for="new-actor-name">New actor name</label>
                    <input id="new-actor-name" class="form-control form-control-sm mb-1" placeholder="Name" aria-label="New actor name" @bind="newActorName" />
                    <label class="visually-hidden" for="new-actor-kind">New actor kind</label>
                    <select id="new-actor-kind" class="form-select form-select-sm mb-2" @bind="newActorKind" aria-label="New actor kind">
                        @foreach (ActorKind kind in Enum.GetValues<ActorKind>())
                        {
                            <option value="@kind">@kind</option>
                        }
                    </select>
                    @{ var actorSchema = SystemCatalog.GetUISchemas(campaign!.SystemId).FirstOrDefault(s => s.EntityType == "Actor"); }
                    @if (actorSchema != null)
                    {
                        <SchemaForm Schema="actorSchema" Values="newActorValues" />
                    }
                    <button type="button" class="btn btn-accent btn-sm mt-2" @onclick="CreateBlankActorAsync">Create</button>
                </div>
            }
        </div>
    </div>;

    private IEnumerable<IActorDefinition> SearchActorBlueprints()
    {
        var blueprints = ContentRegistry.GetActorsBySystem(campaign!.SystemId);
        if (string.IsNullOrWhiteSpace(contentSearch))
        {
            return blueprints;
        }

        return blueprints.Where(a => a.Name.Contains(contentSearch, StringComparison.OrdinalIgnoreCase) ||
            a.Tags.Any(t => t.Contains(contentSearch, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task AddActorFromBlueprintAsync(IActorDefinition definition)
    {
        var actor = new ActorDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Kind = ActorKind.NonPlayerCharacter,
            BlueprintId = $"{definition.SystemId}:{definition.Id}",
            Name = definition.Name,
            Visibility = ActorVisibility.Hidden,
            State = new Dictionary<string, object>(definition.Properties)
        };
        if (!await ActorRepo.TrySaveAsync(actor, access!))
        {
            Flash("Only the DM can add actors.");
            return;
        }

        Flash($"Added {definition.Name} to the campaign (Hidden).");
        await ReloadAsync();
    }

    private async Task CreateBlankActorAsync()
    {
        var actor = new ActorDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Kind = newActorKind,
            Name = newActorName,
            Visibility = ActorVisibility.Hidden,
            State = new Dictionary<string, object>(newActorValues)
        };
        if (!await ActorRepo.TrySaveAsync(actor, access!))
        {
            Flash("Only the DM can create actors.");
            return;
        }

        newActorValues = new();
        newActorName = "New Actor";
        Flash($"Created {actor.Name}.");
        await ReloadAsync();
    }

    private async Task RevealActorAsync(ActorDocument actor)
    {
        actor.Visibility = ActorVisibility.Known;
        if (!await ActorRepo.TrySaveAsync(actor, access!))
        {
            Flash("Only the DM can reveal actors.");
            return;
        }

        Flash($"{actor.Name} revealed to the party.");
        await ReloadAsync();
    }

    private string? pendingDeleteActorId;

    private async Task DeleteActorConfirmed(ActorDocument actor)
    {
        pendingDeleteActorId = null;
        await ActorRepo.TryDeleteAsync(actor.Id, access!);
        Flash($"{actor.Name} deleted.");
        await ReloadAsync();
    }

    // ---- Locations (2.5) ----

    private RenderFragment RenderLocations() => @<div>
        @foreach (var region in regions)
        {
            <div class="card p-3 mb-3">
                <h5>@region.Name</h5>
                @foreach (var location in region.Locations)
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                        <div>
                            <strong>@location.Name</strong>
                            <span class="badge bg-dark ms-1">@location.Visibility</span>
                        </div>
                        @if (access!.IsDm && location.Visibility != ActorVisibility.Known)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => RevealLocationAsync(region.Id, location.Id)">Reveal to Party</button>
                        }
                    </div>
                }
                @if (access!.IsDm)
                {
                    <div class="input-group input-group-sm mt-2">
                        <input class="form-control" placeholder="New location name" aria-label="New location name" @bind="newLocationName" />
                        <button type="button" class="btn btn-outline-primary" @onclick="() => AddLocationAsync(region.Id)">Add</button>
                    </div>
                }
            </div>
        }
        @if (access!.IsDm)
        {
            <div class="input-group input-group-sm">
                <input class="form-control" placeholder="New region name" aria-label="New region name" @bind="newRegionName" />
                <button type="button" class="btn btn-outline-primary" @onclick="CreateRegionAsync">Add Region</button>
            </div>
        }
        @if (!regions.Any() && !access!.IsDm)
        {
            <p class="text-tertiary small">No locations have been revealed yet.</p>
        }
    </div>;

    private async Task CreateRegionAsync()
    {
        if (string.IsNullOrWhiteSpace(newRegionName)) return;
        var region = new RegionDocument { Id = Guid.NewGuid().ToString(), CampaignId = CampaignId, Name = newRegionName };
        await RegionRepo.SaveAsync(region, access!);
        newRegionName = "";
        await ReloadAsync();
    }

    private async Task AddLocationAsync(string regionId)
    {
        if (string.IsNullOrWhiteSpace(newLocationName)) return;
        var location = new LocationDocument { Id = Guid.NewGuid().ToString(), Name = newLocationName, Visibility = ActorVisibility.Hidden };
        await RegionRepo.UpsertLocationAsync(regionId, location, access!);
        newLocationName = "";
        await ReloadAsync();
    }

    private async Task RevealLocationAsync(string regionId, string locationId)
    {
        await RegionRepo.SetLocationVisibilityAsync(regionId, locationId, ActorVisibility.Known, access!);
        await ReloadAsync();
    }

    // ---- Lore (2.5) ----

    private RenderFragment RenderLore() => @<div>
        <div class="mb-3">
            <a href="@($"/campaigns/{CampaignId}/grimoire")">Open Grimoire (player view)</a>
        </div>
        @if (access!.IsDm)
        {
            var proposed = facts.Where(f => f.Status == FactStatus.Proposed).ToList();
            @if (proposed.Any())
            {
                <h5>Proposed by Players (@proposed.Count)</h5>
                @foreach (var fact in proposed)
                {
                    <div class="card p-2 mb-2 border-warning">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                            <div>
                                <strong>@fact.Summary</strong>
                                <span class="badge bg-warning text-dark ms-1">Proposed</span>
                                <span class="text-tertiary small ms-1">by @memberUsernames.GetValueOrDefault(fact.AuthorId ?? "", fact.AuthorId ?? "?")</span>
                            </div>
                            <div class="d-flex gap-1 align-items-center">
                                <select class="form-select form-select-sm w-auto" aria-label="Approve visibility" value="@GetApproveVisibility(fact.Id)" @onchange="e => approveVisibility[fact.Id] = Enum.Parse<FactVisibility>(e.Value?.ToString() ?? nameof(FactVisibility.Public))">
                                    @foreach (FactVisibility v in Enum.GetValues<FactVisibility>())
                                    {
                                        <option value="@v">@v</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => ApproveFactAsync(fact)">Approve</button>
                                @if (pendingDismissFactId == fact.Id)
                                {
                                    <span class="inline-confirm">
                                        <span class="small">Dismiss?</span>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DismissFactConfirmed(fact)">Confirm</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => pendingDismissFactId = null">Keep</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => pendingDismissFactId = fact.Id">Dismiss</button>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(fact.Details))
                        {
                            <p class="small text-tertiary mb-0">@fact.Details</p>
                        }
                    </div>
                }
            }
        }
        <h5>Canon</h5>
        @foreach (var fact in facts.Where(f => f.Status == FactStatus.Approved))
        {
            <div class="card p-2 mb-2">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@fact.Summary</strong>
                        <span class="badge bg-dark ms-1">@fact.Visibility</span>
                    </div>
                    @if (access!.IsDm && fact.Visibility != FactVisibility.Public)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => RevealFactAsync(fact)">Reveal to Party</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(fact.Details))
                {
                    <p class="small text-tertiary mb-0">@fact.Details</p>
                }
            </div>
        }
        <div class="card p-3 mt-3">
            <h5>@(access!.IsDm ? "New Fact" : "Propose Lore")</h5>
            @if (!access.IsDm)
            {
                <p class="text-tertiary small">Player proposals go to the DM for review before becoming canon.</p>
            }
            <label class="visually-hidden" for="new-fact-summary">Fact summary</label>
            <input id="new-fact-summary" class="form-control form-control-sm mb-2" placeholder="Summary" aria-label="Fact summary" @bind="newFactSummary" />
            <label class="visually-hidden" for="new-fact-details">Fact details</label>
            <textarea id="new-fact-details" class="form-control form-control-sm mb-2" rows="2" placeholder="Details (optional)" aria-label="Fact details" @bind="newFactDetails"></textarea>
            @if (access.IsDm)
            {
                <label class="visually-hidden" for="new-fact-visibility">Fact visibility</label>
                <select id="new-fact-visibility" class="form-select form-select-sm mb-2" @bind="newFactVisibility" aria-label="Fact visibility">
                    @foreach (FactVisibility v in Enum.GetValues<FactVisibility>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
                <button type="button" class="btn btn-accent btn-sm" @onclick="CreateFactAsync">Add Fact</button>
            }
            else
            {
                <button type="button" class="btn btn-accent btn-sm" @onclick="ProposeFactAsync">Propose Lore</button>
            }
        </div>
        <div class="card p-3 mt-3">
            <h5>Campaign Notes</h5>
            @foreach (var note in campaignNotes)
            {
                <div class="border-bottom py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="small">@memberUsernames.GetValueOrDefault(note.AuthorId, note.AuthorId)</strong>
                        <span>
                            <span class="badge bg-dark me-1">@note.Visibility</span>
                            <span class="text-tertiary small">@note.CreatedAt.ToString("MMM dd, HH:mm")</span>
                        </span>
                    </div>
                    <p class="small mb-1">@note.Content</p>
                    @if (access!.IsDm)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => PromoteNoteAsync(note)">Promote to Fact</button>
                    }
                </div>
            }
            @if (!campaignNotes.Any())
            {
                <p class="text-tertiary small">No campaign notes yet.</p>
            }
            <div class="mt-3">
                <label class="visually-hidden" for="new-campaign-note">Add a campaign note</label>
                <textarea id="new-campaign-note" class="form-control form-control-sm mb-2" rows="2" placeholder="Add a campaign note..." aria-label="Add a campaign note" @bind="newNoteContent" @bind:event="oninput"></textarea>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm w-auto" @bind="newNoteVisibility" aria-label="Note visibility">
                        <option value="@CommentVisibility.Private">Private (you + DM)</option>
                        <option value="@CommentVisibility.Public">Public (whole party)</option>
                    </select>
                    <button type="button" class="btn btn-accent btn-sm" @onclick="CreateNoteAsync">Add Note</button>
                </div>
            </div>
        </div>
    </div>;

    private FactVisibility GetApproveVisibility(string factId) =>
        approveVisibility.TryGetValue(factId, out var v) ? v : FactVisibility.Public;

    private async Task CreateFactAsync()
    {
        if (string.IsNullOrWhiteSpace(newFactSummary)) return;
        var fact = new FactDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Summary = newFactSummary.Trim(),
            Details = string.IsNullOrWhiteSpace(newFactDetails) ? null : newFactDetails.Trim(),
            Visibility = newFactVisibility,
            AuthorId = currentUserId,
            Status = FactStatus.Approved
        };
        await FactRepo.SaveAsync(fact, access!);
        newFactSummary = "";
        newFactDetails = "";
        Flash("Fact added.");
        await ReloadAsync();
    }

    private async Task ProposeFactAsync()
    {
        if (string.IsNullOrWhiteSpace(newFactSummary)) return;
        var fact = new FactDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Summary = newFactSummary.Trim(),
            Details = string.IsNullOrWhiteSpace(newFactDetails) ? null : newFactDetails.Trim(),
            Visibility = FactVisibility.DmOnly
        };
        await FactRepo.ProposeAsync(fact, access!);
        newFactSummary = "";
        newFactDetails = "";
        Flash("Proposed - the DM will review it.");
        await ReloadAsync();
    }

    private async Task ApproveFactAsync(FactDocument fact)
    {
        await FactRepo.ApproveAsync(fact.Id, GetApproveVisibility(fact.Id), access!);
        Flash($"Approved \"{fact.Summary}\".");
        await ReloadAsync();
    }

    private string? pendingDismissFactId;

    private async Task DismissFactConfirmed(FactDocument fact)
    {
        pendingDismissFactId = null;
        await FactRepo.DeleteAsync(fact.Id, access!);
        Flash("Proposal dismissed.");
        await ReloadAsync();
    }

    private async Task RevealFactAsync(FactDocument fact)
    {
        await FactRepo.SetVisibilityAsync(fact.Id, FactVisibility.Public, access!);
        await ReloadAsync();
    }

    private async Task CreateNoteAsync()
    {
        if (access == null || currentUserId == null || string.IsNullOrWhiteSpace(newNoteContent)) return;
        await NoteRepo.CreateNoteAsync(new NoteDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            TargetId = CampaignNotesTargetId,
            AuthorId = currentUserId,
            Content = newNoteContent.Trim(),
            Visibility = newNoteVisibility
        });
        newNoteContent = "";
        Flash("Note added.");
        await ReloadAsync();
    }

    private async Task PromoteNoteAsync(NoteDocument note)
    {
        if (access == null || !access.IsDm) return;
        var firstLine = note.Content.Split('\n', 2)[0].Trim();
        var summary = firstLine.Length > 80 ? firstLine[..80] + "…" : firstLine;
        await FactRepo.SaveAsync(new FactDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Summary = string.IsNullOrWhiteSpace(summary) ? "Promoted note" : summary,
            Details = note.Content,
            Visibility = FactVisibility.Public,
            AuthorId = note.AuthorId,
            Status = FactStatus.Approved
        }, access);
        Flash($"Promoted note to canon.");
        await ReloadAsync();
    }

    // ---- Sessions ----

    private RenderFragment RenderSessions() => @<div>
        @foreach (var session in sessions.OrderByDescending(s => s.Date))
        {
            <div class="card p-2 mb-2 d-flex flex-row justify-content-between align-items-center">
                <a href="@($"/campaigns/{CampaignId}/sessions/{session.Id}")">@(string.IsNullOrWhiteSpace(session.Title) ? session.Date.ToString("MMM dd, yyyy") : session.Title)</a>
                <span class="badge bg-secondary">@session.Status</span>
            </div>
        }
        @if (!sessions.Any())
        {
            <p class="text-tertiary small">No sessions yet.</p>
        }
        @if (access!.IsDm)
        {
            <button type="button" class="btn btn-accent btn-sm mt-2" @onclick="CreateSessionAsync">Plan New Session</button>
        }
    </div>;

    private async Task CreateSessionAsync()
    {
        var session = new SessionDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = CampaignId,
            Date = DateTime.UtcNow,
            Status = SessionStatus.Planned
        };
        await SessionRepo.SaveAsync(session);
        await ReloadAsync();
    }

    // ---- Combat (3.5-3.7) ----

    private RenderFragment RenderCombat() => @<div>
        <CombatConsole CampaignId="@CampaignId"
                        Campaign="campaign!"
                        Access="access!"
                        CurrentUserId="@(currentUserId!)"
                        Actors="actors"
                        OnActorAdded="ReloadAsync" />
    </div>;
}
