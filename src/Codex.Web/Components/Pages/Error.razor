@page "/Error"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Diagnostics

<PageTitle>Something went wrong | TTRPG.Codex</PageTitle>

<div class="empty">
    <div class="empty-icon"><LucideIcon IconName="alert-triangle" Size="28" /></div>
    <h1 class="h4">Something went wrong</h1>
    <p>The request could not be completed. Reloading the page usually fixes it; if it keeps happening, the server log has the details.</p>
    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p class="small-muted">Request ID <code>@RequestId</code></p>
    }
    <a href="/" class="btn btn-primary">Back to campaigns</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
