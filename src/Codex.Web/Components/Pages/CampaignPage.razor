@page "/campaigns/{CampaignId}"
@page "/campaigns/{CampaignId}/{Section}"
@page "/campaigns/{CampaignId}/{Section}/{Arg1}"
@page "/campaigns/{CampaignId}/{Section}/{Arg1}/{Arg2}"
@using System.Security.Claims
@using Codex.Persistence
@using Codex.Persistence.Runtime
@using Codex.Plugin.Abstractions
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject ICampaignRepository CampaignRepo
@inject IActorRepository ActorRepo
@inject ICampaignAccessResolver AccessResolver
@inject ISystemCatalog Catalog
@inject CampaignRuntimeManager RuntimeManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

@* A window (a sheet, a session) names the tab itself. *@
@if (WindowKind == null)
{
    <PageTitle>@(campaign?.Name ?? L["Page.Campaign.Fallback"]) | TTRPG.Codex</PageTitle>
}

@if (loading)
{
    <LoadingSkeleton Rows="4" />
}
else if (campaign == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="compass" Size="28" /></div>
        <h1 class="h4">@L["Page.Campaign.NotFoundTitle"]</h1>
        <p>@L["Page.Campaign.NotFoundText"]</p>
        <a href="/" class="cx-btn cx-plaque">@L["Page.Common.BackToCampaigns"]</a>
    </div>
}
else if (access == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="shield" Size="28" /></div>
        <h1 class="h4">@L["Page.Campaign.NotMemberTitle"]</h1>
        <p>@L["Page.Campaign.NotMemberText"]</p>
        <a href="/" class="cx-btn cx-plaque">@L["Page.Common.BackToCampaigns"]</a>
    </div>
}
else
{
    var tableLive = RuntimeManager.TryGet(CampaignId) != null;

    <div class="workspace @(notesOpen && tableLive ? "beside-notes" : "")">
        <header class="ws-head @(campaign.HasCover ? "has-cover" : "") @(CurrentSection == "overview" ? "" : "ws-head-inner")" style="@(campaign.HasCover ? $"--cover:url('{MediaEndpoints.CoverUrl(campaign)}')" : "")">
            <nav aria-label="@L["Page.Common.Breadcrumb"]" class="breadcrumb-nav"><a href="/">@L["Page.Home.Title"]</a></nav>
            <h1 data-testid="campaign-title">@campaign.Name</h1>
            @if (!string.IsNullOrWhiteSpace(campaign.Tagline))
            {
                <p class="ws-tagline" data-testid="campaign-tagline">@campaign.Tagline</p>
            }
            <div class="pills">
                <span class="pill">@Catalog.GetDisplayName(campaign.SystemId)</span>
                <span class="pill @(access.IsDm ? "pill-accent" : "")" data-testid="my-role">@RoleLabel(access.Role)</span>
            </div>
        </header>

        <nav class="ws-nav" aria-label="@L["Page.Campaign.Sections"]">
            @foreach (var group in Groups)
            {
                <div class="ws-nav-group" role="group" aria-label="@GroupLabel(group.Label)">
                    <div class="ws-nav-label" aria-hidden="true">@GroupLabel(group.Label)</div>
                    @foreach (var section in group.Sections.Where(s => s.Key != "build" || access.IsDm))
                    {
                        var href = section.Key == "overview" ? BasePath : BasePath + "/" + section.Key;
                        var current = NavSection == section.Key ? "page" : null;
                        var testId = "section-" + section.Key;
                        var label = section.Key == "bestiary" && !access.IsDm ? L["Page.Campaign.Section.Creatures"] : SectionLabel(section.Key);
                        <a href="@href" aria-current="@current" data-testid="@testId">
                            <LucideIcon IconName="@section.Icon" Size="18" /><span>@label</span>
                            @if (section.Key == "table" && tableLive)
                            {
                                <span class="pill pill-success nav-badge" title="@L["Page.Campaign.TableRunning"]"><span class="live-dot" aria-hidden="true"></span>@L["Page.Campaign.Live"]</span>
                            }
                        </a>
                    }
                </div>
            }
        </nav>

        @* On a phone the side rail is replaced by a tab bar at the bottom of the screen: the sections this role uses at
           the table, plus a More menu with every section. *@
        <nav class="ws-tabbar" aria-label="@L["Page.Campaign.Sections"]">
            @foreach (var key in TabBar)
            {
                var section = Sections.First(s => s.Key == key);
                <a href="@(BasePath + "/" + key)" aria-current="@(CurrentSection == key ? "page" : null)" data-testid="@("tabbar-" + key)">
                    <LucideIcon IconName="@section.Icon" Size="20" /><span>@SectionLabel(key)</span>
                    @if (key == "table" && tableLive)
                    {
                        <span class="live-dot tabbar-live" aria-hidden="true"></span><span class="visually-hidden">@L["Page.Campaign.TableRunning"]</span>
                    }
                </a>
            }
            <details class="popover-menu tabbar-more">
                <summary class="@(TabBar.Contains(CurrentSection) ? "" : "current")" data-testid="tabbar-more">
                    <LucideIcon IconName="layout-grid" Size="20" /><span>@L["Page.Campaign.More"]</span>
                </summary>
                <div class="popover-panel">
                    @foreach (var group in Groups)
                    {
                        <div class="tabbar-more-label eyebrow" aria-hidden="true">@GroupLabel(group.Label)</div>
                        @foreach (var section in group.Sections.Where(s => s.Key != "build" || access.IsDm))
                        {
                            var href = section.Key == "overview" ? BasePath : BasePath + "/" + section.Key;
                            var label = section.Key == "bestiary" && !access.IsDm ? L["Page.Campaign.Section.Creatures"] : SectionLabel(section.Key);
                            <a class="menu-item" href="@href" aria-current="@(NavSection == section.Key ? "page" : null)"><LucideIcon IconName="@section.Icon" Size="18" />@label</a>
                        }
                    }
                </div>
            </details>
        </nav>

        <div class="ws-main">
            <StatusMessage Message="flash" OnDismiss="() => flash = null" Toast="true" />

            @* U2: a character sheet or a session is a window inside the campaign, not a page of its own: the rail, the tab bar
               and the notes drawer stay, and the section it was opened from stays alive under it (hidden), so going back
               finds it as it was, scrolled where it was, with no loading skeleton. *@
            @if (WindowKind == "actor")
            {
                <div class="ws-window" data-testid="campaign-window">
                    <ActorSheet @key="Arg1" CampaignId="@CampaignId" ActorId="@(Arg1!)" BackLabel="@BackLabel" OnBack="CloseWindowAsync" />
                </div>
            }
            else if (WindowKind == "session")
            {
                <div class="ws-window" data-testid="campaign-window">
                    <SessionDetail @key="Arg1" CampaignId="@CampaignId" SessionId="@(Arg1!)" BackLabel="@BackLabel" OnBack="CloseWindowAsync" OnDeleted="WindowDeletedAsync" />
                </div>
            }

            @if (WindowKind == null || underSection != null)
            {
                <div class="ws-section" hidden="@(WindowKind != null)">
                    <CascadingValue Value="context" IsFixed="false">
                        @switch (CurrentSection)
                        {
                            case "cast":
                                <CastSection />
                                break;
                            case "world":
                                <WorldSection />
                                break;
                            case "lore":
                                <LoreSection />
                                break;
                            case "build":
                                <WorldChatSection Starter="@Arg1" />
                                break;
                            case "wiki":
                                <WikiSection Slug="@Arg1" Action="@Arg2" />
                                break;
                            case "journal":
                                <JournalSection />
                                break;
                            case "bestiary":
                                <BestiarySection />
                                break;
                            case "sessions":
                                <SessionsSection />
                                break;
                            case "items":
                                <ItemsSection />
                                break;
                            case "table":
                                <TableSection />
                                break;
                            case "library":
                                <LibrarySection RouteType="@Arg1" RouteId="@Arg2" />
                                break;
                            case "settings":
                                <SettingsSection />
                                break;
                            case "templates":
                                <TemplatesSection />
                                break;
                            default:
                                <OverviewSection />
                                break;
                        }
                    </CascadingValue>
                </div>
            }
        </div>

        <TableNotesHost CampaignId="@CampaignId" Campaign="campaign" Actors="actors" Access="access" CurrentUserId="@(currentUserId ?? "")" @bind-Open="notesOpen" />
    </div>
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? Arg1 { get; set; }
    [Parameter] public string? Arg2 { get; set; }

    private static readonly (string Label, (string Key, string Label, string Icon)[] Sections)[] Groups =
    {
        ("Play", new[]
        {
            ("overview", "Overview", "home"),
            ("table", "Table", "dices"),
            ("sessions", "Sessions", "calendar"),
            ("items", "Items", "package"),
            ("journal", "My journal", "notebook-pen")
        }),
        ("World", new[]
        {
            ("cast", "Cast", "users"),
            ("bestiary", "Bestiary", "paw-print"),
            ("world", "Places", "map"),
            ("wiki", "Wiki", "globe"),
            ("build", "World builder", "sparkles"),
            ("lore", "Lore", "book-marked")
        }),
        ("Reference", new[]
        {
            ("library", "Library", "book-open"),
            ("settings", "Settings", "settings")
        })
    };

    private static readonly (string Key, string Label, string Icon)[] Sections = Groups.SelectMany(g => g.Sections).ToArray();

    // The phone tab bar (U7): what each role reaches for at the table; everything else is under More. A player reads their
    // journal and the places the party knows; the DM runs the table with the cast and the wiki at hand.
    private static readonly string[] PlayerTabBar = { "table", "sessions", "journal", "world" };
    private static readonly string[] DmTabBar = { "table", "sessions", "cast", "wiki" };

    private string[] TabBar => access?.IsDm == true ? DmTabBar : PlayerTabBar;

    private bool loading = true;
    private CampaignDocument? campaign;
    private CampaignAccess? access;
    private string? currentUserId;
    private IReadOnlyList<ActorDocument> actors = Array.Empty<ActorDocument>();
    private Flash? flash;
    private CampaignContext? context;
    // Whether the session notes drawer is open; kept here so it stays open while moving between sections.
    private bool notesOpen;
    private string? loadedCampaignId;

    private string GroupLabel(string group) => group switch
    {
        "Play" => L["Page.Campaign.Group.Play"],
        "World" => L["Page.Campaign.Group.World"],
        _ => L["Page.Campaign.Group.Reference"]
    };

    private string SectionLabel(string key) => key switch
    {
        "table" => L["Page.Campaign.Section.Table"],
        "sessions" => L["Page.Campaign.Section.Sessions"],
        "items" => L["Page.Campaign.Section.Items"],
        "journal" => L["Page.Campaign.Section.Journal"],
        "cast" => L["Page.Campaign.Section.Cast"],
        "bestiary" => L["Page.Campaign.Section.Bestiary"],
        "world" => L["Page.Campaign.Section.Places"],
        "wiki" => L["Page.Campaign.Section.Wiki"],
        "build" => L["Page.Campaign.Section.Build"],
        "lore" => L["Page.Campaign.Section.Lore"],
        "library" => L["Page.Campaign.Section.Library"],
        "settings" => L["Page.Campaign.Section.Settings"],
        "templates" => L["Campaign.Templates.Title"],
        _ => L["Page.Campaign.Section.Overview"]
    };

    private string RoleLabel(CampaignRole role) => role switch
    {
        CampaignRole.DM => L["Page.Role.DM"],
        CampaignRole.Player => L["Page.Role.Player"],
        _ => L["Page.Role.Observer"]
    };

    private string BasePath => $"/campaigns/{CampaignId}";
    private string RouteSection => Sections.Any(s => s.Key == Section) || Section == "templates" ? Section! : "overview";

    /// <summary>"actor" for <c>actors/{id}</c>, "session" for <c>sessions/{id}</c>: a window over a section (U2).</summary>
    private string? WindowKind => string.IsNullOrEmpty(Arg1) ? null : Section switch
    {
        "actors" => "actor",
        "sessions" => "session",
        _ => null
    };

    // The section a window was opened over, kept alive under it. Null when the window was the first thing opened (a link
    // from outside, a reload): then nothing is under it, and closing it goes to the section it belongs to.
    private string? underSection;
    private bool windowShown;
    private string? openedOver;

    private string CurrentSection => WindowKind == null ? RouteSection : underSection ?? (WindowKind == "actor" ? "cast" : "sessions");

    private string BackLabel => L["Page.Campaign.BackTo", SectionLabel(CurrentSection)];

    /// <summary>Back to what was open before: the browser's own Back when the window was opened from here (so Forward works
    /// too), else the section the window belongs to.</summary>
    private async Task CloseWindowAsync()
    {
        if (underSection != null) await JS.InvokeVoidAsync("history.back");
        else Nav.NavigateTo(CurrentSection == "overview" ? BasePath : $"{BasePath}/{CurrentSection}");
    }

    // What the window showed is gone (a deleted session): say so here, where the section underneath shows it gone.
    private async Task WindowDeletedAsync(string message)
    {
        flash = Flash.Success(message);
        await CloseWindowAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The window starts at the top; closing it puts the section back where it was scrolled.
        var open = WindowKind != null;
        if (open == windowShown) return;
        windowShown = open;
        if (open)
        {
            openedOver = underSection;
            await JS.InvokeVoidAsync("codex.windowOpened");
        }
        else
        {
            await JS.InvokeVoidAsync("codex.windowClosed", openedOver != null && openedOver == RouteSection);
        }
    }

    // The section the side rail marks as the one open: the templates belong to the wiki.
    private string NavSection => CurrentSection == "templates" ? "wiki" : CurrentSection;

    protected override void OnInitialized()
    {
        // The "Live" badge next to Table follows the runtime starting or stopping, on every page.
        RuntimeManager.RuntimeChanged += OnRuntimeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (WindowKind == null) underSection = RouteSection;
        else if (loadedCampaignId != CampaignId) underSection = null;

        // A message belongs to the section that said it: "Saved." from Settings is not news on the Table (U5).
        if (shownSection != CurrentSection)
        {
            flash = null;
            shownSection = CurrentSection;
        }

        var window = WindowKind == null ? null : $"{Section}/{Arg1}";
        if (loadedCampaignId != CampaignId)
        {
            flash = null;
            notesOpen = false;
            await ReloadAsync();
        }
        else if (shownWindow != null && window != shownWindow)
        {
            // A window does its work without this page: a character made and opened from the cast, renamed, revealed or
            // retired on its sheet. Leaving it reloads who is in the campaign, so the sections (Lore's "about", the mention
            // lists, the cast) know what the window changed.
            await ReloadAsync();
        }

        shownWindow = window;
    }

    private string? shownWindow;

    private string? shownSection;

    private void OnRuntimeChanged(string campaignId)
    {
        if (campaignId == CampaignId)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAsync()
    {
        loading = loadedCampaignId != CampaignId;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        campaign = await CampaignRepo.GetAsync(CampaignId);
        access = campaign != null && currentUserId != null ? await AccessResolver.ResolveAsync(CampaignId, currentUserId) : null;

        if (campaign != null && access != null)
        {
            actors = (await ActorRepo.GetVisibleForCampaignAsync(access)).OrderBy(a => a.Name).ToList();
            context = new CampaignContext
            {
                Campaign = campaign,
                Access = access,
                UserId = currentUserId!,
                System = Catalog.GetLocalizedDefinition(campaign.SystemId),
                Actors = actors.Where(a => !a.Retired).ToList(),
                AllActors = actors,
                ReloadAsync = async () => { await ReloadAsync(); StateHasChanged(); },
                Notify = message => { flash = message; StateHasChanged(); },
                AccessChangedAsync = async () => { await ReloadAsync(); flash = Flash.Error(L["Campaign.AccessChanged"]); StateHasChanged(); }
            };
        }

        loadedCampaignId = CampaignId;
        loading = false;
    }

    public void Dispose() => RuntimeManager.RuntimeChanged -= OnRuntimeChanged;
}
