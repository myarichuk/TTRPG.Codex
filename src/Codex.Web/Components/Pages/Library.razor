@page "/library"
@page "/library/{SystemId}"
@page "/library/{SystemId}/{Type}"
@page "/library/{SystemId}/{Type}/{EntryId}"
@using Codex.Plugin.Abstractions
@using Codex.Web.Components.Shared
@inject ISystemCatalog Catalog
@inject NavigationManager Nav

<PageTitle>@L["Page.Library.Title"] | TTRPG.Codex</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["Page.Library.Title"]</h1>
        <p class="page-subtitle">@L["Page.Library.Subtitle"]</p>
    </div>
    @if (Catalog.Systems.Count() > 1)
    {
        <div>
            <label for="library-system" class="field-label">@L["Page.Library.System"]</label>
            <select id="library-system" class="field-select" value="@EffectiveSystemId" @onchange="OnSystemChanged">
                @foreach (var system in Catalog.Systems)
                {
                    <option value="@system.Id">@system.Name</option>
                }
            </select>
        </div>
    }
</div>

@if (string.IsNullOrEmpty(EffectiveSystemId))
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="book-open" Size="28" /></div>
        <h2>@L["Page.Library.NoneTitle"]</h2>
        <p>@L["Page.Library.NoneBefore"]<code>system.yaml</code>@L["Page.Library.NoneAfter"]</p>
    </div>
}
else
{
    <LibraryBrowser SystemId="@EffectiveSystemId" BasePath="@($"/library/{EffectiveSystemId}")" RouteType="@Type" RouteId="@EntryId" />
}

@code {
    [Parameter] public string? SystemId { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public string? EntryId { get; set; }

    private string EffectiveSystemId => SystemId ?? Catalog.Systems.FirstOrDefault()?.Id ?? string.Empty;

    private void OnSystemChanged(ChangeEventArgs e) => Nav.NavigateTo($"/library/{e.Value}");
}
