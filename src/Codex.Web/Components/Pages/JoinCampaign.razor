@page "/campaigns/join/{InviteCode}"
@attribute [Authorize(Policy = ServerAccess.SignedIn)]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using Codex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IUserRepository Users
@inject IServerSettingsStore Settings
@inject AccountCheck Check

@* Open to an account waiting for approval too (docs/SERVER_ACCESS_AND_VAULT.md 3): a GM's invite approves it, as a player. A page
   without a circuit, since a waiting account has none. *@

<PageTitle>@L["Page.Join.Title"] | TTRPG.Codex</PageTitle>

<div class="empty">
    @if (result == null)
    {
        <div class="spinner-border" role="status"><span class="visually-hidden">@L["Page.Join.Joining"]</span></div>
    }
    else if (result == CampaignJoinResult.InvalidCode)
    {
        <div class="empty-icon"><LucideIcon IconName="alert-triangle" Size="28" /></div>
        <h1 class="h4">@L["Page.Join.InvalidTitle"]</h1>
        <p>@L["Page.Join.InvalidText"]</p>
        <a href="/" class="cx-btn cx-plaque">@L["Page.Common.BackToCampaigns"]</a>
    }
    else if (result == CampaignJoinResult.TooManyAttempts)
    {
        <div class="empty-icon"><LucideIcon IconName="clock" Size="28" /></div>
        <h1 class="h4">@L["Page.Join.TooManyTitle"]</h1>
        <p>@L["Page.Join.TooManyText"]</p>
        <a href="/" class="cx-btn cx-plaque">@L["Page.Common.BackToCampaigns"]</a>
    }
    else
    {
        @* Joined vs. AlreadyMember isn't a reliable distinction here: prerendering runs
           OnInitializedAsync twice, so a first-time join can resolve as Joined and then
           AlreadyMember. Either way the membership is in place. *@
        <div class="empty-icon"><LucideIcon IconName="check" Size="28" /></div>
        <h1 class="h4">@L["Page.Join.InTitle"]</h1>
        <p>@L["Page.Join.InText"]</p>
        <a href="/campaigns/@joinedCampaignId" class="cx-btn cx-plaque">@L["Page.Join.Go"]</a>
    }
</div>

@code {
    [Parameter]
    public string InviteCode { get; set; } = string.Empty;

    private CampaignJoinResult? result;
    private string? joinedCampaignId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId == null)
        {
            // A local path, so signing in or creating an account brings the person straight back here.
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: true);
            return;
        }

        (result, joinedCampaignId) = await CampaignRepo.JoinByInviteCodeAsync(InviteCode, userId);
        if (result is CampaignJoinResult.Joined or CampaignJoinResult.AlreadyMember && ServerAccess.IsWaiting(authState.User))
        {
            await ApproveByInviteAsync(userId);
        }
    }

    private async Task ApproveByInviteAsync(string userId)
    {
        var approved = false;
        var user = await Users.UpdateUserAsync(userId, u =>
        {
            approved = u.Status == AccountStatus.Pending;
            if (approved) u.Status = AccountStatus.Approved;
        });
        Check.Forget(userId);
        if (!approved || user == null || joinedCampaignId == null || await CampaignRepo.GetAsync(joinedCampaignId) is not { } campaign) return;
        var gm = await Users.GetUserByIdAsync(campaign.OwnerId);
        await Settings.LogAsync(new AdminLogDocument
        {
            ByUserId = campaign.OwnerId,
            ByName = gm?.Username ?? string.Empty,
            Action = AdminAction.Approved,
            TargetName = user.Username,
            Detail = campaign.Name
        });
    }
}
