@page "/campaigns/join/{InviteCode}"
@using System.Security.Claims
@using Codex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>@L["Page.Join.Title"] | TTRPG.Codex</PageTitle>

<div class="empty">
    @if (result == null)
    {
        <div class="spinner-border" role="status"><span class="visually-hidden">@L["Page.Join.Joining"]</span></div>
    }
    else if (result == CampaignJoinResult.InvalidCode)
    {
        <div class="empty-icon"><LucideIcon IconName="alert-triangle" Size="28" /></div>
        <h1 class="h4">@L["Page.Join.InvalidTitle"]</h1>
        <p>@L["Page.Join.InvalidText"]</p>
        <a href="/" class="cx-btn cx-plaque">@L["Page.Common.BackToCampaigns"]</a>
    }
    else
    {
        @* Joined vs. AlreadyMember isn't a reliable distinction here: prerendering runs
           OnInitializedAsync twice, so a first-time join can resolve as Joined and then
           AlreadyMember. Either way the membership is in place. *@
        <div class="empty-icon"><LucideIcon IconName="check" Size="28" /></div>
        <h1 class="h4">@L["Page.Join.InTitle"]</h1>
        <p>@L["Page.Join.InText"]</p>
        <a href="/campaigns/@joinedCampaignId" class="cx-btn cx-plaque">@L["Page.Join.Go"]</a>
    }
</div>

@code {
    [Parameter]
    public string InviteCode { get; set; } = string.Empty;

    private CampaignJoinResult? result;
    private string? joinedCampaignId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId == null)
        {
            // A local path, so signing in or creating an account brings the person straight back here.
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: true);
            return;
        }

        (result, joinedCampaignId) = await CampaignRepo.JoinByInviteCodeAsync(InviteCode, userId);
    }
}
