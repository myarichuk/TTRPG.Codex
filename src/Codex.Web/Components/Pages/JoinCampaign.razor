@page "/campaigns/join/{InviteCode}"
@using System.Security.Claims
@using Codex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Join campaign | TTRPG.Codex</PageTitle>

<div class="empty">
    @if (result == null)
    {
        <div class="spinner-border" role="status"><span class="visually-hidden">Joining…</span></div>
    }
    else if (result == CampaignJoinResult.InvalidCode)
    {
        <div class="empty-icon"><LucideIcon IconName="alert-triangle" Size="28" /></div>
        <h1 class="h4">This invite link is not valid</h1>
        <p>It may have been mistyped, or the campaign may have been deleted. Ask your DM for a fresh link.</p>
        <a href="/" class="btn btn-primary">Back to campaigns</a>
    }
    else
    {
        @* Joined vs. AlreadyMember isn't a reliable distinction here: prerendering runs
           OnInitializedAsync twice, so a first-time join can resolve as Joined and then
           AlreadyMember. Either way the membership is in place. *@
        <div class="empty-icon"><LucideIcon IconName="check" Size="28" /></div>
        <h1 class="h4">You're in!</h1>
        <p>You are now a player in this campaign.</p>
        <a href="/campaigns/@joinedCampaignId" class="btn btn-primary">Go to campaign</a>
    }
</div>

@code {
    [Parameter]
    public string InviteCode { get; set; } = string.Empty;

    private CampaignJoinResult? result;
    private string? joinedCampaignId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId == null)
        {
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", forceLoad: true);
            return;
        }

        (result, joinedCampaignId) = await CampaignRepo.JoinByInviteCodeAsync(InviteCode, userId);
    }
}
