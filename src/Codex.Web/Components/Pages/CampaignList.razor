@page "/campaigns"
@using System.Security.Claims
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject ISystemCatalog SystemCatalog
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Campaigns</PageTitle>

<div class="app-container">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-2">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Campaigns</li>
        </ol>
    </nav>
    <header class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h1 class="mb-0">Campaigns</h1>
        <div class="d-flex gap-3 align-items-center" style="flex: 1; justify-content: flex-end;">
            <div class="search-wrapper">
                <LucideIcon IconName="search" Size="16" Class="search-icon" />
                <input type="search" class="search-input" placeholder="Search chronicles..." aria-label="Search chronicles"
                       @bind="searchText" @bind:event="oninput" @bind:after="LoadData">
            </div>
            <button type="button" class="btn-primary-fluent d-flex align-items-center gap-2" @onclick="OpenCreateDialog" style="white-space: nowrap;">
                <LucideIcon IconName="plus" Size="18" />
                New
            </button>
        </div>
    </header>
    <p class="small text-tertiary" role="status">@ResultCountText</p>
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info py-2" role="status">@statusMessage</div>
    }

    @if (availableSystems != null && availableSystems.Any())
    {
        <div class="filter-ribbon" role="group" aria-label="Filter campaigns by system">
            <button type="button" class="filter-chip @(selectedSystem == null ? "active" : "")" aria-pressed="@(selectedSystem == null ? "true" : "false")" @onclick="() => SelectSystem(null)">All Adventures</button>
            @foreach (var system in availableSystems)
            {
                <button type="button" class="filter-chip @(selectedSystem == system ? "active" : "")" aria-pressed="@(selectedSystem == system ? "true" : "false")" @onclick="() => SelectSystem(system)">@system</button>
            }
        </div>
    }

    @if (campaigns == null)
{
    <div class="d-flex justify-content-center my-5 py-5">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!campaigns.Any())
{
    <div class="empty-state text-center py-5">
        <div class="mb-4">
            <LucideIcon IconName="sparkles" Size="48" Class="text-tertiary" />
        </div>
        <h3 class="mb-3">No Campaigns Found</h3>
        <p class="text-tertiary mb-5">It looks like you don't have any campaigns yet. Let's get your adventure started!</p>
        <button type="button" class="btn btn-accent px-5 d-inline-flex align-items-center justify-content-center gap-2" @onclick="OpenCreateDialog">
            <span>Create Your First Campaign</span>
        </button>
    </div>
}
else
{
    <div class="campaign-grid">
        @foreach (var campaign in campaigns)
        {
            var isDnd = campaign.SystemId.Contains("DnD") || campaign.SystemId == "D&D 5E";
            <article class="campaign-card" aria-labelledby="campaigns-@campaign.Id-title">
                <div class="art-container" aria-hidden="true">
                    <div class="art-fallback">
                        <LucideIcon IconName="@(isDnd ? "swords" : "anchor")" Size="32" />
                    </div>
                    <span class="system-badge">@campaign.SystemId</span>
                </div>
                <div class="card-content">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h3 class="card-title mb-0" id="campaigns-@campaign.Id-title">@campaign.Name</h3>
                    </div>
                    <div class="card-meta">
                        <span class="meta-item"><LucideIcon IconName="calendar" Size="12" /> Active</span>
                    </div>
                    <p class="card-text small text-secondary">
                        @if (!string.IsNullOrWhiteSpace(campaign.Description))
                        {
                            @campaign.Description
                        }
                        else
                        {
                            <span class="opacity-50 italic">No chronicle notes scribed yet.</span>
                        }
                    </p>
                    <div class="mt-auto pt-3 border-top border-secondary border-opacity-10">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-tertiary small">Last session: @campaign.UpdatedAt.ToString("MMM dd")</span>
                            @if (confirmDeleteId == campaign.Id)
                            {
                                <span class="inline-confirm">
                                    <span class="small">Delete?</span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCampaignConfirmed(campaign.Id)">Confirm</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDeleteId = null">Keep</button>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="btn-manage-fluence d-flex align-items-center gap-2" aria-label="Delete @campaign.Name" @onclick="() => confirmDeleteId = campaign.Id" title="Delete Campaign">
                                    <LucideIcon IconName="trash-2" Size="14" />
                                </button>
                            }
                            <a href="/campaigns/@campaign.Id" class="btn-manage-fluence" aria-label="Manage @campaign.Name">
                                <LucideIcon IconName="settings" Size="14" Class="anim-rotate" />
                                <span>Manage</span>
                            </a>
                        </div>
                        <button type="button" class="btn-session-fluence w-100" @onclick="() => GoToCampaign(campaign.Id)">
                            <LucideIcon IconName="dices" Size="16" Class="anim-pulse" />
                            <span>Open Campaign</span>
                        </button>
                    </div>
                </div>
            </article>
        }

        <button type="button" class="campaign-card" aria-label="Initiate New Story" style="border-style: dashed; background: transparent; cursor: pointer; justify-content: center; align-items: center; min-height: 380px;" @onclick="OpenCreateDialog">
            <div class="text-center p-5">
                <div style="background: var(--fluent-surface-secondary); width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 1rem auto;">
                    <LucideIcon IconName="plus" Size="24" Class="text-secondary" />
                </div>
                <h4 class="h6 text-secondary">Initiate New Story</h4>
                <p class="small text-tertiary">Name your campaign and pick a system.</p>
            </div>
        </button>
    </div>
    }

    @if (showCreateDialog)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="create-campaign-title">
            <div class="modal-dialog">
                <div class="modal-content" style="background: var(--bg-color-surface); border: 1px solid var(--fluent-border);">
                    <div class="modal-header" style="border-color: var(--fluent-border);">
                        <h2 class="h5 mb-0" id="create-campaign-title">New campaign</h2>
                        <button type="button" class="btn-manage-fluence" aria-label="Close" @onclick="CloseCreateDialog">✕</button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small" for="new-campaign-name">Name</label>
                            <input id="new-campaign-name" class="form-control" @bind="newCampaignName" placeholder="Unnamed Legend" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label small" for="new-campaign-system">System</label>
                            <select id="new-campaign-system" class="form-select" @bind="newCampaignSystemId">
                                @foreach (var system in CreateSystemOptions)
                                {
                                    <option value="@system">@system</option>
                                }
                            </select>
                            <p class="form-text small text-tertiary">The system locks after creation.</p>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-color: var(--fluent-border);">
                        <button type="button" class="btn btn-surface" @onclick="CloseCreateDialog">Cancel</button>
                        <button type="button" class="btn btn-accent" @onclick="CreateCampaignFromDialog" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create campaign</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<CampaignDocument>? campaigns;
    private List<string>? availableSystems;
    private string? selectedSystem;
    private string searchText = string.Empty;
    private bool isCreating = false;
    private bool showCreateDialog;
    private string newCampaignName = "Unnamed Legend";
    private string newCampaignSystemId = "";
    private string? confirmDeleteId;
    private string? statusMessage;

    private string ResultCountText => campaigns == null
        ? "Loading campaigns…"
        : $"{campaigns.Count()} {(campaigns.Count() == 1 ? "campaign" : "campaigns")}";

    private IEnumerable<string> CreateSystemOptions =>
        SystemCatalog.LoadedSystemIds.OrderBy(s => s, StringComparer.Ordinal)
            .Concat(availableSystems ?? Enumerable.Empty<string>())
            .Distinct(StringComparer.Ordinal)
            .DefaultIfEmpty("");

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var all = await CampaignRepo.GetAllAsync();
        availableSystems = all.Select(c => c.SystemId).Distinct().OrderBy(s => s).ToList();

        var filtered = all.AsEnumerable();
        if (selectedSystem != null)
        {
            filtered = filtered.Where(c => c.SystemId == selectedSystem);
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            filtered = filtered.Where(c => c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));
        }

        campaigns = filtered;
    }

    private async Task SelectSystem(string? system)
    {
        selectedSystem = system;
        await LoadData();
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private async Task DeleteCampaignConfirmed(string id)
    {
        var userId = await GetCurrentUserIdAsync();
        if (userId == null) return;

        var result = await CampaignRepo.DeleteAsync(id, userId);
        statusMessage = result == CampaignDeleteResult.Forbidden
            ? "Only the campaign owner can delete it."
            : "Campaign deleted.";
        confirmDeleteId = null;
        await LoadData();
    }

    private void GoToCampaign(string campaignId) => Nav.NavigateTo($"/campaigns/{campaignId}");

    private void OpenCreateDialog()
    {
        newCampaignName = "Unnamed Legend";
        newCampaignSystemId = CreateSystemOptions.FirstOrDefault() ?? "";
        showCreateDialog = true;
    }

    private void CloseCreateDialog() => showCreateDialog = false;

    private async Task CreateCampaignFromDialog()
    {
        var userId = await GetCurrentUserIdAsync();
        if (userId == null) return;

        isCreating = true;
        try
        {
            var systemId = string.IsNullOrWhiteSpace(newCampaignSystemId)
                ? CreateSystemOptions.FirstOrDefault() ?? ""
                : newCampaignSystemId;
            var doc = new CampaignDocument
            {
                Id = Guid.NewGuid().ToString(),
                OwnerId = userId,
                Name = string.IsNullOrWhiteSpace(newCampaignName) ? "Unnamed Legend" : newCampaignName.Trim(),
                SystemId = systemId,
                UpdatedAt = DateTime.UtcNow
            };
            await CampaignRepo.SaveAsync(doc);
            showCreateDialog = false;
            Nav.NavigateTo($"/campaigns/{doc.Id}");
        }
        finally
        {
            isCreating = false;
        }
    }
}
