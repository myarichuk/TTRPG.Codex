            if (entry == null) return null;
            string? level = entry.Properties.TryGetValue("level", out var raw)
                ? EntryChoiceWords.LevelText(raw, n => L["Actor.Slots.Level", n].ToString())
                : null;
            return new EntryOptionInfo(Nm(entry) ?? option.Label, level, $"{LibraryPath}/{entry.Type}/{Uri.EscapeDataString(entry.Id)}");
        }
