    private ActorDocument ForAi(ActorDocument snapshot)
    {
        snapshot.Biography = snapshot.Biography == null ? null : noteMentions.Plain(snapshot.Biography);
        snapshot.DmNotes = snapshot.DmNotes == null ? null : noteMentions.Plain(snapshot.DmNotes);
