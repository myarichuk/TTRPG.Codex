    private void SetRawList(string key, List<string> raw)
    {
        if (raw.Count == 0) editSheet.Remove(key);
        else editSheet[key] = raw.Cast<object>().ToList();
        Reevaluate();
    }

    private void AddPick(ListRule list, string id) => SetRawList(list.Key, SheetRuleEngine.RawList(editSheet, list.Key).Append(id).ToList());

    private void RemovePick(ListRule list, int index)
    {
        var raw = SheetRuleEngine.RawList(editSheet, list.Key);
        if (index < 0 || index >= raw.Count) return;
        raw.RemoveAt(index);
        SetRawList(list.Key, raw);
    }

    /// <summary>"+1 STR, +1 DEX" after a pick that raised scores.</summary>
    private string? Nm(ContentEntry? entry) => entry == null ? null : ContentRegistry.Name(entry, L.Culture.Name);

    /// <summary>A rule message in the reader's language: the localized sentence when the engine named one, built from its arguments (entries by their
    /// translated names, rule texts and system words through the system's translation); else the engine's English.</summary>
    private string Describe(RuleViolation violation)
    {
        if (violation.Key == null || violation.Args == null || !L.Has(violation.Key)) return violation.Message;
        var culture = L.Culture.Name;
        var args = violation.Args.Select((a, index) => a switch
        {
            ContentEntry entry => ContentRegistry.Name(entry, culture),
            // The spreads a bonus may take, each read left to right: "+2/+1 or +1/+1/+1".
            List<List<int>> spreads => string.Join(L["Actor.Sheet.Or"], spreads.Select(s => Bidi.Ltr(string.Join("/", s.Select(v => "+" + v))))),
            // Scores and signed numbers keep their order inside a right-to-left sentence.
            string text when System.Text.RegularExpressions.Regex.IsMatch(text, @"^[\d+/, ]+$") => Bidi.Ltr(text),
            // A system word ("Heavy armor") in the middle of a sentence is not capitalised.
            string text when system != null && violation.Key == "Actor.Rule.ArmorUntrained" && index == 2 => system.DisplayValue(text).ToLower(L.Culture),
            string text when system != null => system.DisplayRuleMessage(text) is var message && message != text ? message : system.DisplayValue(text),
            _ => a
        }).ToArray();
        return L[violation.Key, args];
    }

    /// <summary>A weight as the inventory shows it: the number, and the system's unit in the reader's language when it names one.</summary>
    private string Weight(double weight, InventoryRules rules)
    {
        var number = weight.ToString("0.##", L.Culture);
        return rules.WeightUnit is { } unit && system != null ? $"{number} {system.DisplayValue(unit)}" : number;
    }

    private string? PickNote(SheetPick pick) =>
        pick.Choices.Count == 0 || system == null ? null
            : string.Join(", ", pick.Choices.Select(c => $"+{c.Value} {system.Attributes.FirstOrDefault(a => a.Key.Equals(c.Key, StringComparison.OrdinalIgnoreCase))?.Abbreviation ?? c.Key}"));

    private void SetOtherClasses(MulticlassRules rules, List<OtherClass> classes) =>
