    // ---- Level up (U4): what the next level brings, from a copy of the sheet at that level, before it is taken. ----

    private LevelUpPlan? levelUpPlan;
    private LevelUpPlan? levelUpDone;
    private int? levelUpRoll;

    // The picks made in the stepper for the choices the level opens, by choice key. The plan is worked out on a copy of the sheet, so they
    // are laid on each copy and written to the sheet only when the level is taken.
    private readonly Dictionary<string, IReadOnlyList<string>> levelUpPicks = new(StringComparer.Ordinal);

    private void PickForLevelUp(ChoiceEdit edit)
    {
        levelUpPicks[edit.Key] = edit.Picks;
        PlanLevelUp();
    }

    private void OpenLevelUp()
    {
        levelUpDone = null;
        levelUpRoll = null;
        levelUpPicks.Clear();
        levelUpClassId = evaluation?.Classes.FirstOrDefault(c => c.IsFirst)?.Id ?? "";
        PlanLevelUp();
    }

    private void CloseLevelUp()
    {
        levelUpPlan = null;
        levelUpRoll = null;
        levelUpPicks.Clear();
    }

    private void ChooseLevelUpClass(string? classId)
    {
        levelUpClassId = classId ?? "";
        levelUpPicks.Clear(); // another class opens other choices
        PlanLevelUp();
    }

    /// <summary>Works out the next level on a copy: the sheet itself changes only when the level is taken.</summary>
    private void PlanLevelUp()
    {
        if (engine == null || evaluation == null || Rules == null || AtMaxLevel)
        {
            levelUpPlan = null;
            return;
        }

        var sheet = new Dictionary<string, object>(editSheet);
        RaiseLevel(sheet);
        foreach (var (key, picks) in levelUpPicks) SheetRuleEngine.SetChoice(sheet, key, picks);
        engine.ApplyInherited(sheet);
        engine.ApplyAttributeTotals(sheet);
        var after = engine.Evaluate(sheet, linkedSheets);
        var level = YamlValues.GetInt(sheet, LevelField!) ?? CurrentLevel + 1;

        ContentEntry? cls;
        ContentEntry? subclass;
        int classLevel;
        if (after.Classes.Count > 0)
        {
            var gaining = after.Classes.FirstOrDefault(c => c.Id == levelUpClassId) ?? after.Classes.First(c => c.IsFirst);
            (cls, subclass, classLevel) = (gaining.Entry, gaining.Subclass, gaining.Level);
        }
        else
        {
            // Without class levels the character level is the class's.
            var classField = Rules.Multiclass?.ClassField ?? system?.FieldRoles.Class;
            var type = system?.ActorFields.FirstOrDefault(f => f.Key == classField)?.TargetEntityType ?? classField;
            cls = classField != null && type != null && YamlValues.GetString(sheet, classField) is { Length: > 0 } classId ? ContentRegistry.GetEntry(campaign!.SystemId, type, classId) : null;
            subclass = null;
            classLevel = level;
        }

        levelUpPlan = LevelUpPlan.Build(Rules, evaluation, after, level,
            cls == null ? null : ContentRegistry.Localize(cls, L.Culture.Name), classLevel,
            subclass == null ? null : ContentRegistry.Localize(subclass, L.Culture.Name),
            Rules.Skills?.BonusKey ?? Rules.Spellcasting?.BonusKey);
    }

    /// <summary>The level on <paramref name="sheet"/> one higher: the character level, and the class gaining it when it is not the
    /// first (the first class gets whatever the others don't take, so only another class is written down). A rolled hit die
    /// goes with it.</summary>
    private void RaiseLevel(Dictionary<string, object> sheet)
    {
        var level = (YamlValues.GetInt(sheet, LevelField!) ?? 1) + 1;
        sheet[LevelField!] = (long)level;
        if (Rules?.Multiclass is { } multiclass && evaluation?.Classes.FirstOrDefault(c => c.IsFirst) is { } first
            && !string.IsNullOrEmpty(levelUpClassId) && levelUpClassId != first.Id)
        {
            var classes = SheetRuleEngine.ParseClassLevels(sheet, multiclass.Key);
            var index = classes.FindIndex(c => c.Id == levelUpClassId);
            if (index >= 0) classes[index] = classes[index] with { Level = classes[index].Level + 1 };
            else classes.Add(new OtherClass(levelUpClassId, 1));
            sheet[multiclass.Key] = classes.Select(SheetRuleEngine.FormatClassLevel).Cast<object>().ToList();
        }

        if (levelUpRoll is { } roll && Rules?.HitPoints is { } hp)
        {
            var rolls = SheetRuleEngine.RawList(sheet, hp.RollsKey);
            while (rolls.Count < level - 1) rolls.Add("0");
            rolls[level - 2] = roll.ToString(System.Globalization.CultureInfo.InvariantCulture);
            sheet[hp.RollsKey] = rolls.Cast<object>().ToList();
        }
    }

    private void SetLevelUpRoll(int? roll)
    {
        levelUpRoll = roll;
        PlanLevelUp();
    }

    private void RollLevelUpHitDie(int die)
    {
        levelUpRoll = RuntimeManager.DiceRollerFor(campaign?.SystemId ?? string.Empty).Roll($"1d{die}").Total;
        PlanLevelUp();
    }

    private void ApplyLevelUp()
    {
        if (AtMaxLevel || levelUpPlan is not { } taken) return;
        RaiseLevel(editSheet);
        // A choice left open is not written: it stays pending on the sheet, to make later.
        foreach (var (key, picks) in levelUpPicks)
        {
            if (engine != null) engine.ChangeChoice(editSheet, key, picks, linkedSheets);
            else SheetRuleEngine.SetChoice(editSheet, key, picks);
        }

        levelUpPicks.Clear();
        levelUpPlan = null;
        Reevaluate();
        levelUpDone = taken;
        levelUpRoll = null;
        levelUpClassId = evaluation?.Classes.FirstOrDefault(c => c.IsFirst)?.Id ?? "";
        flash = Flash.Info(L["Actor.Sheet.LevelSet", CurrentLevel]);
    }

    /// <summary>The character as the AI reads it for a change: the sheet's edits so far, mentions as plain names.</summary>
    private ActorDocument AssistCharacter() =>
        ForAi(ApplyEdits(new ActorDocument { Id = actor!.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name, Biography = actor.Biography, DmNotes = actor.DmNotes }));

    /// <summary>Changes taken from the AI go on the sheet unsaved, as typed edits do; Save stores them.</summary>
    private void TakeAssist(Dictionary<string, object> sheet)
    {
        editSheet.Clear();
        foreach (var (key, value) in sheet) editSheet[key] = value;
        Reevaluate();
    }

    private void GoToHighlight(string field) =>
        ShowRule(field.StartsWith(SheetRuleEngine.BasePrefix, StringComparison.Ordinal) ? "attributes" : field);

    private void AppendAdviceToNotes()
    {
        if (levelUpAdvice == null) return;
        var key = schema?.Fields.FirstOrDefault(f => f.Type == FieldType.LongText)?.Key ?? "notes";
        var existing = YamlValues.GetString(editSheet, key) ?? string.Empty;
        editSheet[key] = (existing.TrimEnd() + "\n\n" + L["Actor.Sheet.LevelPlan", CurrentLevel + 1] + "\n" + levelUpAdvice).Trim();
        levelUpAdvice = null;
        flash = Flash.Info(L["Actor.Sheet.AddedNotes"]);
    }
}
