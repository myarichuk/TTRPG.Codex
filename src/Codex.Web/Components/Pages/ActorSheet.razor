    /// <summary>Writes the picks of a choice the player ticked, confirmed or cleared, and re-runs the rules. Nothing is logged yet: a change
    /// is logged when the sheet is saved (<see cref="LogChoiceChangesAsync"/>), once, as it stands then.</summary>
    private Task EditChoiceAsync(ChoiceEdit edit)
    {
        if (!CanEdit) return Task.CompletedTask;
        // One route for every change: a row choice also settles the counters of the rows it swaps (onChange).
        if (engine != null) engine.ChangeChoice(editSheet, edit.Key, edit.Picks, linkedSheets);
        else SheetRuleEngine.SetChoice(editSheet, edit.Key, edit.Picks);
        Reevaluate();
        return Task.CompletedTask;
    }

    /// <summary>The choices whose picks the sheet being edited holds differently from the sheet as loaded, where the loaded one had picks
    /// (making a choice, confirming ticks, is not a change). Read before the save, with the evaluation of the sheet as edited.</summary>
    private List<LogChoiceChangedCommand> ChoiceChanges()
    {
        var changes = new List<LogChoiceChangedCommand>();
        if (actor == null || evaluation == null) return changes;
        var choices = evaluation.PendingChoices.Concat(evaluation.MadeChoices).ToList();
        var keys = loadedSheet.Keys.Concat(editSheet.Keys).Where(k => k.StartsWith(SheetRuleEngine.ChoicePrefix, StringComparison.Ordinal)).Distinct();
        foreach (var key in keys)
        {
            var was = SheetRuleEngine.RawList(loadedSheet, key);
            var now = SheetRuleEngine.RawList(editSheet, key);
            if (was.Count == 0 || was.SequenceEqual(now, StringComparer.OrdinalIgnoreCase)) continue;
            var choice = choices.FirstOrDefault(c => c.Key == key);
            if (choice == null) continue; // the entry left the sheet: pruned, not changed
            var names = now.Select(p => choice.Options.FirstOrDefault(o => o.Key.Equals(p, StringComparison.OrdinalIgnoreCase))?.Label ?? p).ToList();
            changes.Add(new LogChoiceChangedCommand(actor.Id, actor.Name, choice.Label, names.Count == 0 ? L["Actor.Skills.RankNone"] : string.Join(", ", names)));
        }

        return changes;
    }

    // The log is the live table's: with no session on there is none, and the sheet keeps no history of changes (its History is the
    // character's story), so a change then is not recorded anywhere.
    private async Task LogChoiceChangesAsync(List<LogChoiceChangedCommand> changes)
    {
        if (changes.Count == 0) return;
        try
        {
            if (RuntimeManager.TryGet(CampaignId) is { ActiveSession: not null } table)
            {
                foreach (var change in changes) await table.EnqueueAsync(change);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Logging a choice change to the session failed");
        }
    }

