    // A link from the table (a card, the party rest) names a choice in the address: #choice-… opens it once the sheet is evaluated.
    private bool fragmentHandled;

    private void OpenChoiceFromAddress()
    {
        if (fragmentHandled || evaluation == null) return;
        fragmentHandled = true;
        var fragment = Nav.ToAbsoluteUri(Nav.Uri).Fragment.TrimStart('#');
        if (!fragment.StartsWith("choice-", StringComparison.Ordinal)) return;
        var choice = evaluation.PendingChoices.Concat(evaluation.MadeChoices).FirstOrDefault(c => ChoicePicker.AnchorFor(c.Key) == fragment);
        if (choice != null)
        {
            OpenChoice(choice.Key);
            StateHasChanged();
        }
    }

    private void OfferChoicesAfter(string moment)
    {
        restMoment = moment;
        restChoices = SheetRuleEngine.ChoicesToChangeAfter(editSheet, moment).ToList();
        openChoices.Clear();
        foreach (var (key, _) in restChoices) openChoices.Add(key);
    }

