    /// <summary>What the pickers need to show choices over Library entries (spells) and values (a spell list's class): which lists hold entries,
    /// the type's names, the system's words, and each entry's name, level and Library card.</summary>
    private EntryChoiceContext EntryChoices => new()
    {
        EntityTypeOf = list => Rules?.Lists.FirstOrDefault(l => l.Key.Equals(list, StringComparison.Ordinal))?.TargetEntityType,
        TypeNames = type => system?.FindType(type) is { } found ? (found.Label, found.PluralOrLabel) : null,
        DisplayValue = value => system?.DisplayValue(value) ?? value,
        Describe = (type, option) =>
        {
