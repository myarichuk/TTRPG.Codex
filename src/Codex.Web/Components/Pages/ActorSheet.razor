@* Not a page of its own: CampaignPage opens it as a window for /campaigns/{CampaignId}/actors/{ActorId} (U2). *@
@using System.Security.Claims
@using Codex.Core
@using Codex.Core.AI
@using Codex.Core.Rules
@using Codex.Core.Systems
@using Codex.Persistence
@using Codex.Persistence.Runtime
@using Codex.Plugin.Abstractions
@using Codex.Plugin.Abstractions.Dice
@using Codex.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject IActorRepository ActorRepo
@inject ISessionRepository SessionRepo
@inject Codex.Web.Services.ViewerClock Clock
@inject CampaignRuntimeManager RuntimeManager
@inject ICampaignAccessResolver AccessResolver
@inject IContentRegistry ContentRegistry
@inject ISystemCatalog SystemCatalog
@inject ComponentRegistry Components
@inject CampaignLibrary Library
@inject MentionSources MentionSources
@inject AiFeatures Ai
@inject ILogger<ActorSheet> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IUserRepository UserRepo
@inject IWikiRepository WikiRepo
@inject ITemplateRepository TemplateRepo
@inject IJSRuntime JS
@inject IVaultRepository VaultRepo
@inject Codex.Web.Services.VaultService VaultService
@implements IDisposable

<PageTitle>@(actor?.Name ?? L["Actor.Sheet.TitleFallback"]) | TTRPG.Codex</PageTitle>

@if (loading)
{
    <LoadingSkeleton />
}
else if (campaign == null || actor == null || access == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="user" Size="28" /></div>
        <h1 class="h4">@L["Actor.Sheet.NotFound"]</h1>
        <p>@L["Actor.Sheet.NotFoundBody"]</p>
        <a href="/" class="cx-btn cx-plaque">@L["Actor.Sheet.BackToCampaigns"]</a>
    </div>
}
else if (IsStranger)
{
    @* Someone the party met but has not identified: the repository hands over a mask (name they go by, what can be seen), nothing of the sheet. *@
    <div class="stranger-card panel" data-testid="stranger-card">
        <nav aria-label="@L["Actor.Sheet.Breadcrumb"]" class="breadcrumb-nav"><a href="/">@L["Actor.Sheet.Campaigns"]</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId">@campaign.Name</a><span class="crumb-sep" aria-hidden="true">/</span><a href="@CastPath">@L["Actor.Sheet.Cast"]</a></nav>
        <div class="stranger-head">
            <ActorAvatar Actor="actor" DisplayName="@DisplayName" Size="lg" />
            <div class="min-w-0">
                <h1 data-testid="actor-name">@DisplayName</h1>
                <span class="pill pill-warning"><LucideIcon IconName="help-circle" Size="14" /> @L["Actor.Stranger.NotIdentified"]</span>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(actor.PublicDescription))
        {
            <div class="rules-text mb-0" data-testid="stranger-description">@((MarkupString)SecretRender.Html(actor.PublicDescription, text => MentionLinks.ToHtml(text, noteMentions, CampaignId), null))</div>
        }
        else
        {
            <p class="small-muted mb-0">@L["Actor.Stranger.NothingYet"]</p>
        }
        <div class="mt-3">
            <LoreAbout Access="access" OwnedActorIds="OwnedActorIds" BasePath="@($"/campaigns/{CampaignId}")" TestId="actor-lore" Keys="@(new[] { FactLinks.Actor(actor.Id) })" />
        </div>
        @if (mentionedIn.Count > 0 || writtenIn.Count > 0)
        {
            <h2 class="h6 mt-3"><LucideIcon IconName="notebook-pen" Size="14" Class="title-icon" /> @L["Actor.Sheet.InNotes"]</h2>
            <NotesMentioning Lines="mentionedIn" Written="writtenIn" Mentions="noteMentions" Actors="noteActors" IsDm="false" CampaignId="@CampaignId" />
        }
    </div>
}
else
{
    <div class="sheet-plate" data-testid="sheet-plate">
        <div class="plate-top">
            <div class="plate-id">
                <div class="portrait-wrap">
                    <ActorAvatar Actor="actor" DisplayName="@DisplayName" Size="lg" Alt="@L["Actor.Avatar.Portrait", DisplayName]" />
                    @if (CanEdit && !Vault)
                    {
                        <PortraitUpload Actor="actor" Access="access" OnMessage="message => flash = message" />
                    }
                </div>
                <div class="min-w-0">
                    @if (Vault)
                    {
                        <nav aria-label="@L["Actor.Sheet.Breadcrumb"]" class="breadcrumb-nav"><a href="/vault">@L["Vault.Title"]</a></nav>
                    }
                    else
                    {
                        <nav aria-label="@L["Actor.Sheet.Breadcrumb"]" class="breadcrumb-nav"><a href="/">@L["Actor.Sheet.Campaigns"]</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId">@campaign.Name</a><span class="crumb-sep" aria-hidden="true">/</span><a href="@CastPath">@L["Actor.Sheet.Cast"]</a></nav>
                    }
                    <h1 data-testid="actor-name">@DisplayName</h1>
                    <div class="plate-plaques">
                        <span class="pill">@KindLabel</span>
                        @if (access.IsDm)
                        {
                            <span class="pill @(actor.Visibility == ActorVisibility.Known ? "pill-success" : "pill-warning")">@VisibilityLabel</span>
                        }
                        @if (wikiPage != null)
                        {
                            <a class="pill" href="/campaigns/@CampaignId/wiki/@wikiPage.Slug" data-testid="actor-wiki-page"><LucideIcon IconName="book-open" Size="14" /> @L["Actor.Sheet.WikiPage", wikiPage.Title]</a>
                        }
                        @if (Vault)
                        {
                            <span class="pill" data-testid="vault-system">@SystemName</span>
                        }
                        @if (!string.IsNullOrEmpty(actor.BlueprintId))
                        {
                            <span class="pill">@L["Actor.Sheet.From", ContentRegistry.ActorName(actor.BlueprintId, L.Culture.Name) ?? actor.BlueprintId.Split(':').Last()]</span>
                        }
                        @foreach (var plaque in PlatePlaques())
                        {
                            <span class="pill pill-accent">@plaque</span>
                        }
                        @if (CanEdit && !Vault)
                        {
                            <PortraitActions Actor="actor" Campaign="campaign" Access="access" CurrentUserId="@(currentUserId ?? "")" Definition="system" Draft="PortraitDraft" Confirm="leaveConfirm"
                                             Busy="@(busy != null)" OnBusyChanged="SetDrawing" OnMessage="message => flash = message" />
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="plate-bar">
            <div class="stat-strip" role="list" aria-label="@L["Actor.Sheet.KeyNumbers"]">
                @if (system?.PrimaryResource is { } vital)
                {
                    var hpNow = YamlValues.GetInt(editSheet, vital.Key) ?? 0;
                    var hpMax = vital.MaxKey != null ? YamlValues.GetInt(editSheet, vital.MaxKey) ?? 0 : 0;
                    var hpPct = hpMax > 0 ? Math.Clamp(100.0 * hpNow / hpMax, 0, 100) : 0;
                    var hpBand = hpPct < 25 ? "hp-low" : hpPct < 50 ? "hp-mid" : "hp-high";
                    <div class="stat-cell stat-hp" role="listitem">
                        <span class="stat-label">@vital.Label</span>
                        <span class="stat-value" data-testid="plate-hp">@Bidi.Ltr(hpNow + (hpMax > 0 ? $" / {hpMax}" : ""))</span>
                        @if (hpMax > 0)
                        {
                            <div class="hp-bar @hpBand" role="progressbar" aria-label="@vital.Label" aria-valuemin="0" aria-valuemax="@hpMax" aria-valuenow="@hpNow">
                                <span style="width:@(hpPct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </div>
                        }
                    </div>
                }
                @if (Rules?.ArmorClass is { } plateAc)
                {
                    var acField = system?.ActorFields.FirstOrDefault(f => f.Key == plateAc.Key);
                    <div class="stat-cell stat-ac" role="listitem">
                        <span class="stat-label">@(acField?.Abbreviation ?? acField?.Label ?? plateAc.Key)</span>
                        <span class="stat-value" data-testid="plate-ac">@(evaluation?.ArmorClass is { Active: true } acSummary ? acSummary.Total : YamlValues.GetInt(editSheet, plateAc.Key) ?? 10)</span>
                    </div>
                }
                @foreach (var stat in PlateStats())
                {
                    <div class="stat-cell" role="listitem">
                        <span class="stat-label">@stat.Label</span>
                        <span class="stat-value">@stat.Value</span>
                    </div>
                }
            </div>
            <div class="plate-save">
                @if (CanEdit && DirtyCount > 0)
                {
                    <span class="dirty-note" role="status" data-testid="sheet-dirty">@L["Actor.Sheet.Dirty", DirtyCount]</span>
                }
                <CodexButton Variant="CodexButtonVariant.Rune" Icon="arrow-left" Label="@BackLabel" title="@BackLabel" OnClick="OnBack" data-testid="sheet-back" />
                @if (CanEdit)
                {
                    <CodexButton Variant="CodexButtonVariant.Plaque" Icon="check" OnClick="SaveAsync" data-testid="sheet-save" data-save-shortcut="" title="@L["Common.SaveShortcut"]">@L["Actor.Sheet.SaveChanges"]</CodexButton>
                }
            </div>
        </div>
        @if (lastRoll != null)
        {
            <div class="plate-roll" data-testid="plate-roll">
                <DiceResult Compact="true" Label="@lastRoll.Label" Expression="@lastRoll.Expression" Kept="lastRoll.Kept" Dropped="lastRoll.Dropped" Modifier="lastRoll.Modifier" CheckDieIndex="lastRoll.CheckDieIndex" Total="lastRoll.Total" Text="@lastRoll.Result" />
            </div>
        }
        @* Inside the sticky plate so a result is seen wherever the page is scrolled to. *@
        <StatusMessage Message="flash" OnDismiss="() => flash = null" Toast="true" />
        @if (restChoices.Count > 0 && restMoment != null)
        {
            <RestChoicesNotice Moment="@SlotTracker.RestName(system, restMoment)" Choices="restChoices" HrefFor="key => '#' + ChoicePicker.AnchorFor(key)" OnOpen="OpenChoice"
                               OnDismiss="() => { restChoices = new(); openChoices.Clear(); }" />
        }
    </div>

    @if (!Vault && actor.JoinNotes.Count > 0 && (actor.OwnerUserId == currentUserId || access is { IsDm: true }))
    {
        <JoinNotesBanner Notes="actor.JoinNotes" SystemId="@(campaign?.SystemId ?? string.Empty)" ReadOnly="@(actor.OwnerUserId != currentUserId)" OnDismiss="DismissJoinNotesAsync" />
    }

    @if (!string.IsNullOrEmpty(actor.BlueprintId) && ContentRegistry.GetActor(actor.BlueprintId) == null)
    {
        <div class="status" role="note">
            <LucideIcon IconName="alert-triangle" Size="18" />
            <span>@L["Actor.Sheet.Missing", actor.BlueprintId]</span>
        </div>
    }

    @if (!CanEdit)
    {
        <p class="small-muted">@L["Actor.Sheet.ReadOnlyNote"]</p>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            @if (evaluation != null && evaluation.HasViolations && CanEdit)
            {
                <section class="panel panel-warn" aria-labelledby="rules-heading" data-testid="rule-violations">
                    <div class="panel-title">
                        <h2 id="rules-heading" class="h5"><LucideIcon IconName="alert-triangle" Size="18" Class="title-icon" /> @L["Actor.Sheet.Rules"]</h2>
                        <span class="pill @(Enforcement == "strict" ? "pill-danger" : "pill-warning")">@(Enforcement == "strict" ? (access.IsDm ? L["Actor.Sheet.StrictOverride"] : L["Actor.Sheet.StrictFix"]) : L["Actor.Sheet.WarningsOnly"])</span>
                    </div>
                    <ul class="mb-0 small">
                        @foreach (var violation in evaluation.Violations)
                        {
                            var shown = violation;
                            @* Each one is also said beside its field, on its tab; this list is the way there. *@
                            <li class="d-flex align-items-baseline gap-2" data-testid="rule-violation">
                                <span class="flex-grow-1">@Describe(violation)</span>
                                <button type="button" class="link-btn" data-testid="rule-show" @onclick="() => ShowRule(RuleTarget(shown))">@L["Actor.Sheet.ShowRule"]</button>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (evaluation != null && evaluation.Warnings.Count > 0)
            {
                <section class="panel" aria-labelledby="warnings-heading" data-testid="rule-warnings">
                    <div class="panel-title">
                        <h2 id="warnings-heading" class="h5"><LucideIcon IconName="info" Size="18" Class="title-icon" /> @L["Actor.Sheet.WorthLook"]</h2>
                        <span class="pill">@L["Actor.Sheet.NotBlocking"]</span>
                    </div>
                    <ul class="mb-0 small">
                        @foreach (var warning in evaluation.Warnings)
                        {
                            <li>@Describe(warning)</li>
                        }
                    </ul>
                </section>
            }

            @if (ShowTray)
            {
                <section class="panel dice-tray" aria-labelledby="tray-heading" data-testid="dice-tray">
                    <div class="panel-title"><h2 id="tray-heading" class="h5"><LucideIcon IconName="dices" Size="18" Class="title-icon" /> @L["Actor.Sheet.Dice"]</h2></div>
                    <div class="tray-bar">
                        <label for="roll-mode" class="field-label mb-0">@L["Actor.Sheet.RollWith"]</label>
                        <select id="roll-mode" class="field-select field-sm" style="width:auto" @bind="rollMode" data-testid="roll-mode">
                            <option value="1d20">@L["Actor.Sheet.RollNormal"]</option>
                            <option value="adv">@L["Actor.Sheet.RollAdv"]</option>
                            <option value="dis">@L["Actor.Sheet.RollDis"]</option>
                        </select>
                        <span class="small-muted">@L["Actor.Sheet.TrayHint"]</span>
                    </div>
                    <RollBonusPanel Offers="bonusOffers" Tray="rollBonuses" Definition="system"
                                    EntryName="@(entryId => evaluation?.Actions.FirstOrDefault(a => a.Entry.Id == entryId) is { } found ? Nm(found.Entry) : null)" />
                    <div aria-live="polite">
                        @if (lastRoll != null)
                        {
                            <DiceResult Label="@lastRoll.Label" Expression="@lastRoll.Expression" Kept="lastRoll.Kept" Dropped="lastRoll.Dropped" Modifier="lastRoll.Modifier" CheckDieIndex="lastRoll.CheckDieIndex" Total="lastRoll.Total" Text="@lastRoll.Result" />
                            <p class="field-hint mb-0" data-testid="roll-where">@(lastRollShared ? L["Actor.Sheet.RollShared"] : L["Actor.Sheet.RollPrivate"])</p>
                        }
                        else
                        {
                            <p class="small-muted tray-empty">@L["Actor.Sheet.NoRolls"]</p>
                        }
                    </div>
                </section>
            }

            <nav class="sheet-tabs" aria-label="@L["Actor.Sheet.Sections"]" data-testid="sheet-tabs">
                @foreach (var tab in Tabs)
                {
                    var problems = ProblemsOn(tab.Key);
                    <button type="button" class="sheet-tab" aria-current="@(ActiveTab == tab.Key ? "page" : null)" data-testid="@("tab-" + tab.Key)" @onclick="() => activeTab = tab.Key">
                        <LucideIcon IconName="@tab.Icon" Size="18" /> @tab.Label
                        @if (problems > 0)
                        {
                            <span class="tab-problems" data-testid="@("tab-problems-" + tab.Key)"><span aria-hidden="true">@problems</span><span class="visually-hidden">@L["Actor.Sheet.TabProblems", problems]</span></span>
                        }
                    </button>
                }
            </nav>

            @if (sheetRoll != null)
            {
                <section class="panel" aria-live="polite" data-testid="sheet-roll-result">
                    <div class="panel-title"><h2 class="h5"><LucideIcon IconName="dices" Size="18" Class="title-icon" /> @(sheetRoll.Label ?? sheetRoll.Definition)</h2>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => sheetRoll = null">@L["Actor.Sheet.Dismiss"]</CodexButton></div>
                    <p class="mb-1"><strong data-testid="sheet-roll-outcome">@(sheetRoll.Outcome is { } outcome ? system!.DisplayValue(outcome) : SheetView.Format(sheetRoll.Totals().FirstOrDefault()))</strong>
                        <span class="small-muted ms-2" data-testid="sheet-roll-dice"><bdi>@L["Actor.Sheet.RollDice", string.Join(" ", sheetRoll.Kept), SheetView.Format(sheetRoll.Totals().FirstOrDefault())]</bdi></span></p>
                    <RollBonusList Bonuses="sheetRoll.Bonuses" Caption="@L["Actor.Bonus.Counted"]" Pool="@(system?.Rolls.FirstOrDefault(r => r.Key == sheetRoll.Definition)?.Pool != null)" TestId="sheet-roll-bonuses" />
                    @if (sheetRollNote != null)
                    {
                        <p class="small-muted mb-0">@sheetRollNote</p>
                    }
                </section>
            }

            @foreach (var section in Layout.Where(s => !s.Aside && s.Section == ActiveTab))
            {
                @if (!Layout.Any(s => s.Widgets.Any(w => Is(w, "fields"))) && section == Layout.First(s => !s.Aside))
                {
                    @FieldsPanel
                }
                @Section(section)
            }

            @if (ActiveTab == "history")
            {
            <section class="panel" aria-labelledby="bio-heading">
                <div class="panel-title">
                    <h2 id="bio-heading" class="h5"><LucideIcon IconName="feather" Size="18" Class="title-icon" /> @L["Actor.Sheet.History"]</h2>
                    @if (CanEdit && !Vault)
                    {
                        <span class="pill"><LucideIcon IconName="users" Size="14" /> @L["Actor.Sheet.HistoryVisible"]</span>
                    }
                </div>
                @if (CanEdit)
                {
                    <label for="actor-bio" class="visually-hidden">@L["Actor.Sheet.History"]</label>
                    <MarkdownEditor Id="actor-bio" Title="@L["Actor.Sheet.History"]" Rows="10" Placeholder="@L["Actor.Sheet.HistoryPlaceholder"]" @bind-Value="editBiography"
                                    Mentions="@mentionsJson" DescribedBy="bio-mention-hint" Preview="PreviewMentions" TestId="sheet-biography" Secrets="@access.IsDm"
                                    Templates="templates" TemplatesHref="@($"/campaigns/{CampaignId}/templates")"
                                    Busy="@(busy == "bio")" BusyText="@L["Actor.Sheet.Writing"]" OnStop="aiCall.Stop">
                        @* In the vault too (docs/SERVER_ACCESS_AND_VAULT.md 6): the history is the player's own, written for players. *@
                        <div class="ai-row">
                            <label for="bio-instruction" class="visually-hidden">@L["Actor.Sheet.AiInstruction"]</label>
                            <input id="bio-instruction" class="field-input field-sm" placeholder="@L["Actor.Sheet.BioInstructionPh"]" @bind="bioInstruction" />
                            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" Icon="sparkles" OnClick="() => RewriteAsync(AiAudience.Players)" Disabled="@(busy != null)" Busy="@(busy == "bio")" data-testid="sheet-biography-ai">
                                @(string.IsNullOrWhiteSpace(editBiography) ? L["Actor.Sheet.WriteAi"] : L["Actor.Sheet.RewriteAi"])
                            </CodexButton>
                        </div>
                        <p id="bio-mention-hint" class="field-hint">@L["Actor.Sheet.MentionHint"]</p>
                    </MarkdownEditor>
                }
                else if (!string.IsNullOrWhiteSpace(actor.Biography))
                {
                    <div class="rules-text mb-0">@((MarkupString)SecretRender.Html(actor.Biography, text => MentionLinks.ToHtml(text, noteMentions, CampaignId), access.IsDm ? DmView.From(L, noteMentions) : null))</div>
                }
                else
                {
                    <p class="small-muted mb-0">@L["Actor.Sheet.NoHistory"]</p>
                }
                @if (!string.IsNullOrWhiteSpace(actor.RevealedToReader))
                {
                    @* Revealed by the DM to this player's characters: read here, never in the box above, whose save would make it everyone's. *@
                    <div class="revealed-to-you mt-3" data-testid="actor-revealed-to-you">
                        <div class="revealed-to-you-title"><LucideIcon IconName="key-round" Size="14" /> @L["Actor.Sheet.RevealedToYou"]</div>
                        <div class="rules-text mb-0">@((MarkupString)MentionLinks.ToHtml(actor.RevealedToReader, noteMentions, CampaignId))</div>
                    </div>
                }
            </section>
            @if (!Vault)
            {
                <LoreAbout Access="access" OwnedActorIds="OwnedActorIds" BasePath="@($"/campaigns/{CampaignId}")" TestId="actor-lore"
                           Keys="@(new[] { FactLinks.Actor(actor.Id) })" AboutKey="@FactLinks.Actor(actor.Id)" />
            }

            }

            @if (ActiveTab == "said")
            {
            <section class="panel" aria-labelledby="said-heading" data-testid="said-panel">
                <div class="panel-title">
                    <h2 id="said-heading" class="h5"><LucideIcon IconName="message-square-quote" Size="18" Class="title-icon" /> @L["Actor.Sheet.Said"]</h2>
                    <span class="small-muted">@L["Actor.Sheet.SaidLines", said.Count]</span>
                </div>
                @foreach (var group in said.GroupBy(x => x.Session.Id).OrderByDescending(g => g.First().Session.Date))
                {
                    var saidIn = group.First().Session;
                    <h3 class="h6 mt-3"><a href="/campaigns/@CampaignId/sessions/@saidIn.Id">@(string.IsNullOrWhiteSpace(saidIn.Title) ? Clock.Format(saidIn.Date, "d MMM yyyy") : saidIn.Title)</a></h3>
                    <ul class="list-unstyled mb-0">
                        @foreach (var (_, line) in group)
                        {
                            <li class="mb-2" data-testid="said-line">
                                <q><MentionText Text="@line.Text" Mentions="noteMentions" CampaignId="@CampaignId" /></q>
                                @if (line.IsSecret)
                                {
                                    <span class="pill ms-2">@L["Actor.Sheet.Secret"]</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
            }

            @if (ActiveTab == "mentioned")
            {
            <section class="panel" aria-labelledby="mentioned-heading" data-testid="mentioned-panel">
                <div class="panel-title">
                    <h2 id="mentioned-heading" class="h5"><LucideIcon IconName="notebook-pen" Size="18" Class="title-icon" /> @L["Actor.Sheet.InNotes"]</h2>
                    <span class="small-muted">@L["Actor.Sheet.MentionNotes", MentionCount, actor!.NameFor(access!.IsDm)]</span>
                </div>
                <NotesMentioning Lines="mentionedIn" Written="writtenIn" Mentions="noteMentions" Actors="noteActors" IsDm="access!.IsDm" CampaignId="@CampaignId" />
            </section>
            }

            @if (ActiveTab == "notes")
            {
            @if (access.IsDm)
            {
                <section class="panel panel-dm" aria-labelledby="dm-notes-heading">
                    <div class="panel-title">
                        <h2 id="dm-notes-heading" class="h5"><LucideIcon IconName="lock" Size="18" Class="title-icon" /> @L["Actor.Sheet.DmNotes"]</h2>
                        <span class="pill pill-warning"><LucideIcon IconName="eye-off" Size="14" /> @L["Actor.Sheet.OnlyYou"]</span>
                    </div>
                    <label for="actor-dm-notes" class="visually-hidden">@L["Actor.Sheet.DmNotes"]</label>
                    <MarkdownEditor Id="actor-dm-notes" Title="@L["Actor.Sheet.DmNotes"]" Rows="8" Placeholder="@L["Actor.Sheet.DmNotesPlaceholder"]" @bind-Value="editDmNotes"
                                    Mentions="@mentionsJson" Preview="PreviewMentions" TestId="sheet-dm-notes"
                                    Templates="templates" TemplatesHref="@($"/campaigns/{CampaignId}/templates")"
                                    Busy="@(busy == "dm")" BusyText="@L["Actor.Sheet.Writing"]" OnStop="aiCall.Stop">
                        <div class="ai-row">
                            <label for="dm-instruction" class="visually-hidden">@L["Actor.Sheet.AiInstruction"]</label>
                            <input id="dm-instruction" class="field-input field-sm" placeholder="@L["Actor.Sheet.DmInstructionPh"]" @bind="dmInstruction" />
                            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" Icon="sparkles" OnClick="() => RewriteAsync(AiAudience.Dm)" Disabled="@(busy != null)" Busy="@(busy == "dm")" data-testid="sheet-dm-notes-ai">
                                @L["Actor.Sheet.DraftAi"]
                            </CodexButton>
                        </div>
                    </MarkdownEditor>
                </section>
            }

            }
        </div>

        <div class="col-lg-4">
            @foreach (var section in Layout.Where(s => s.Aside))
            {
                @Section(section)
            }

            @* Not a layout widget: the AI's help with a change works on any system's sheet. *@
            @if (CanEdit && system != null && currentUserId != null)
            {
                <CharacterAssistPanel Character="AssistCharacter" Sheet="editSheet" Campaign="campaign" Access="access" System="system" UserId="@currentUserId"
                                      Describe="Describe" OnTake="TakeAssist" OnGoThere="GoToHighlight" />
            }

            @if (!Vault && actor.VaultSourceId != null && actor.OwnerUserId == currentUserId)
            {
                <VaultCopyPanel Actor="actor" Campaign="campaign" Access="access" Dirty="DirtyCount > 0" OnMessage="message => flash = message" />
            }

            @if (access.IsDm)
            {
                <ActorVisibilityPanel Edits="audience" Actor="actor" Members="campaign.Members" MemberNames="memberNames" MentionsJson="@mentionsJson" Preview="PreviewMentions" OnChanged="StateHasChanged" />
            }
        </div>
    </div>
}

@* Leaving with unsaved edits asks first, whichever link was used (Back, the breadcrumb, the header). *@
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@(CanEdit && DirtyCount > 0)" />
<ConfirmDialog @ref="leaveConfirm" />

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public string ActorId { get; set; } = string.Empty;

    /// <summary>The sheet of one of the caller's vault characters (docs/SERVER_ACCESS_AND_VAULT.md 8): no campaign, so the
    /// server's Library for its system, and nothing of a campaign's (lore, notes, the table, its AI and art).</summary>
    [Parameter] public bool Vault { get; set; }

    private string LibraryPath => Vault ? $"/library/{Uri.EscapeDataString(campaign?.SystemId ?? "")}" : $"/campaigns/{CampaignId}/library";
    private string SystemName => SystemCatalog.GetLocalizedDefinition(campaign?.SystemId ?? "")?.Name ?? campaign?.SystemId ?? "";

    /// <summary>Back to what the sheet was opened from (the Table, Cast, a wiki page), and what the button says.</summary>
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public string BackLabel { get; set; } = string.Empty;

    private bool loading = true;
    private CampaignDocument? campaign;
    // Usernames for the DM's "Played by" picker.
    private Dictionary<string, string> memberNames = new();
    private ActorDocument? actor;
    private CampaignAccess? access;
    // The wiki page this character was promoted from, when the reader can open it.
    private WikiPageDocument? wikiPage;
    private SystemDefinition? system;
    private string? currentUserId;
    private UISchema? schema;
    private HashSet<string> attributeKeys = new();
    private HashSet<string> hiddenKeys = new();
    private Dictionary<string, IReadOnlyList<(string Id, string Name)>> referenceOptions = new();
    private Dictionary<string, IReadOnlyList<(string Id, string Name)>> fieldOptions = new();
    private SheetRuleEngine? engine;
    private SheetEvaluation? evaluation;
    private List<ContentEntry> subclassCandidates = new();
    private IReadOnlyDictionary<string, IReadOnlyList<ContentEntry>> inventoryOptions = new Dictionary<string, IReadOnlyList<ContentEntry>>();
    private List<(string Label, LibraryItem Item)> linkedEntries = new();
    private string editName = "";
    private string editBiography = "";
    private string editDmNotes = "";
    private string bioInstruction = "";
    private string dmInstruction = "";
    private string? levelUpAdvice;
    private string? busy;
    private readonly AiCall aiCall = new();

    /// <summary>The history or notes as a reader will see them: the typed @Names become mentions first.</summary>
    private string PreviewMentions(string text) =>
        SecretRender.Html(noteMentions.Encode(text), encoded => MentionLinks.ToHtml(encoded, noteMentions, CampaignId), access?.IsDm == true ? DmView.From(L, noteMentions) : null);
    // Who sees it, as what, and who plays it: the DM's, edited in ActorVisibilityPanel.
    private readonly ActorVisibilityPanel.Draft audience = new();
    private Dictionary<string, object> editSheet = new();
    private Dictionary<string, object> loadedSheet = new();
    private string levelUpClassId = "";
    private Flash? flash;
    private Dictionary<string, object> baselineSheet = new();
    private string rollMode = "1d20";
    private bool showSums;
    private RollLogEntry? lastRoll;
    private bool lastRollShared;
    // The bonuses ticked for the next sheet-rules roll, and what the sheet offers (kept in step by Reevaluate).
    private readonly RollBonusTray rollBonuses = new();
    private IReadOnlyList<RollOptIn> bonusOffers = Array.Empty<RollOptIn>();

    /// <summary>Lines this actor spoke at the table, across the campaign's sessions, that this viewer may read.</summary>
    private IReadOnlyList<(SessionDocument Session, SessionNote Line)> said = Array.Empty<(SessionDocument, SessionNote)>();
    // The table notes that mention this character, and what names the mentions in them and in "said".
    private IReadOnlyList<(SessionDocument Session, SessionNote Note)> mentionedIn = Array.Empty<(SessionDocument, SessionNote)>();
    private IReadOnlyList<WrittenMention> writtenIn = Array.Empty<WrittenMention>();
    private int MentionCount => mentionedIn.Count + writtenIn.Count;
    private MentionDirectory noteMentions = MentionDirectory.Empty;
    // What the history and DM notes boxes suggest after @, # or $.
    private IReadOnlyList<TextTemplate>? templates;
    private string mentionsJson = "[]";
    private IReadOnlyDictionary<string, ActorDocument> noteActors = new Dictionary<string, ActorDocument>();

    /// <summary>The tray appears wherever the sheet has rolls to offer.</summary>
    private bool ShowTray => actor != null && access != null && Rules?.Skills != null && evaluation is { Skills.Count: > 0 };

    /// <summary>Rolls a d20 check with the sheet's bonus. During a session the roll goes into the
    /// table's shared log under this character; otherwise it is rolled and shown here only.</summary>
    private Task RollAsync(RollRequest request) =>
        RollWithBonusesAsync(rollMode + Plus(request.Bonus), request.Label, RollBonusTray.SiteOf(engine, request.Kind, request.Key, null), request.AddSiteNumber);

    /// <summary>An action's roll: an attack is a check like any other (the sheet's roll mode counts); damage is its own dice.</summary>
    private Task RollActionAsync(ActionRoll roll) =>
        RollWithBonusesAsync(roll.Expression ?? rollMode + Plus(roll.CheckBonus ?? 0), roll.Label, RollBonusTray.SiteOf(engine, roll.Kind, null, roll.Action), false);

    private static string Plus(int bonus) => bonus == 0 ? "" : bonus > 0 ? $"+{bonus}" : bonus.ToString();

    // The sheet's bonuses for the next roll (the tray's ticks) and the always-on dice join the roll; what a ticked one spends is paid first,
    // and a roll that cannot pay is not made. The ticks it took are cleared; one that did not fit stays.
    private async Task RollWithBonusesAsync(string expression, string label, RollSite? site, bool addNumber)
    {
        var built = rollBonuses.Build(engine, editSheet, site, expression, label, addNumber, linkedSheets);
        if (!await RollBonusTray.PayAsync(built.Applied, SpendOnSheet))
        {
            flash = Flash.Error(L["Actor.Bonus.CannotPay"]);
            return;
        }

        rollBonuses.Used(built.Applied);
        // What a ticked bonus spent may have emptied its pool: the boxes say so now, not at the next edit.
        bonusOffers = OptInsOfSheet();
        rollBonuses.Keep(bonusOffers);
        await RollExpressionAsync(built.Expression, built.Label);
    }

    // Every opt-in the sheet holds for a sheet-rules roll, for the tray.
    private IReadOnlyList<RollOptIn> OptInsOfSheet()
    {
        if (engine == null || Rules == null || (Rules.Actions.Count == 0 && Rules.Skills == null)) return Array.Empty<RollOptIn>();
        try
        {
            return engine.AllOptIns(editSheet, linkedSheets);
        }
        catch (Exception ex) when (ex is FormulaException or InvalidOperationException)
        {
            return Array.Empty<RollOptIn>();
        }
    }

    private async Task RollExpressionAsync(string expression, string label)
    {
        if (actor == null || currentUserId == null) return;
        var request = new RollRequest(label, 0);
        lastRoll = null;
        var live = RuntimeManager.TryGet(CampaignId);
        if (live?.ActiveSession != null)
        {
            await live.EnqueueAsync(new RollDiceCommand(expression, actor.Id, currentUserId, false, request.Label));
            lastRoll = live.Snapshot.RollLog.LastOrDefault(r => r.ActorId == actor.Id && r.Label == request.Label);
            lastRollShared = lastRoll != null;
        }
        if (lastRoll == null || !lastRollShared)
        {
            var result = RuntimeManager.DiceRollerFor(campaign?.SystemId ?? string.Empty).Roll(expression);
            lastRoll = new RollLogEntry { ActorId = actor.Id, RollerUserId = currentUserId, Expression = expression, Result = result.ToString(), Total = result.Total, Label = request.Label, Kept = result.Kept.ToList(), Dropped = result.Dropped.ToList(), Modifier = result.Modifier, CheckDieIndex = result.CheckDieIndex };
            lastRollShared = false;
        }
    }


    // ---- The layout (overhaul step 6): tabs and the aside from the system's sections, each widget built in or generic. ----

    private IReadOnlyList<LayoutSection> layout = SheetLayout.Builtin;
    private IReadOnlyList<LayoutSection> Layout => layout;
    private SheetView? sheetView;
    private IEntryResolver? resolver;
    private SheetRollResult? sheetRoll;
    private string? sheetRollNote;

    private static bool Is(LayoutWidget widget, string name) => string.Equals(widget.Widget, name, StringComparison.OrdinalIgnoreCase);

    /// <summary>The host's own word for a section it knows (srd5e's tabs), the system's label, or the section's name.</summary>
    private string SectionLabel(LayoutSection section) => section.Label ?? section.Section.ToLowerInvariant() switch
    {
        "attributes" => L["Actor.Sheet.Attributes"],
        "picks" => L["Actor.Sheet.Picks"],
        "inventory" => L["Actor.Sheet.Inventory"],
        SheetLayout.GenericSection => L["Actor.Sheet.SheetHeading"],
        _ => system?.DisplayValue(section.Section) ?? section.Section
    };

    /// <summary>Whether a widget has anything to show here; a tab whose widgets show nothing is not offered.</summary>
    private bool Shows(LayoutWidget widget) => widget.Widget.ToLowerInvariant() switch
    {
        "attributes" => system != null && system.Attributes.Count > 0 && system.SheetKinds.Count == 0,
        "skills" => Rules?.Skills != null && evaluation is { Skills.Count: > 0 },
        "fields" => true,
        "classes" => Rules?.Multiclass != null && evaluation != null,
        "library" => linkedEntries.Count > 0 || actor is { Carried.Count: > 0 },
        "picks" => Rules != null && Rules.Lists.Count > 0,
        "inventory" => Rules?.Inventory != null,
        "hit-points" => system?.PrimaryResource != null,
        "armor-class" => Rules?.ArmorClass != null,
        "slots" => Rules is { SlotPools.Count: > 0 } && editSheet.Keys.Any(k => Rules.SlotPools.Any(p => p.Owns(k))),
        "actions" => evaluation is { Actions.Count: > 0 },
        "features" => HasFeatureSources && evaluation is { } worked
            && (worked.Counters.Count > 0 || worked.Spenders.Count > 0 || worked.Granted.Count > 0 || worked.Features.Any(f => f.Adds.Count > 0 || (f.OnKind && f.Modifiers.Count > 0))),
        "moments" => system != null && sheetView != null && SystemMoments.Of(system).Any(m => m.Kind == MomentKind.Declared && SystemMoments.Matters(system, editSheet, m.Key)),
        "level-up" => CanEdit && HasLevel,
        // A vault character belongs to no campaign: there is no actor to link to, and nobody links to it.
        "link" or "members" => !Vault && sheetView?.Shows(widget) == true,
        _ => sheetView?.Shows(widget) == true
    };

    /// <summary>Whether the sheet has somewhere its features come from: <c>sheetRules.features</c>, or its sheet kind's own <c>features</c>.</summary>
    private bool HasFeatureSources =>
        Rules is { Features.Count: > 0 } || (system is { SheetKinds.Count: > 0 } && SheetLayout.KindOf(system, editSheet) is { Features.Count: > 0 });

    // The first tab gets the name and fields when the layout does not place them.
    private bool Shows(LayoutSection section) =>
        section.Widgets.Any(Shows) || (!Layout.Any(s => s.Widgets.Any(w => Is(w, "fields"))) && section == Layout.FirstOrDefault(s => !s.Aside));

    /// <summary>The tab that holds a widget: the first section with one that matches.</summary>
    private string? SectionWith(Func<LayoutWidget, bool> match) => Layout.FirstOrDefault(s => !s.Aside && s.Widgets.Any(match))?.Section;

    private string FirstTab => Layout.FirstOrDefault(s => !s.Aside && Shows(s))?.Section ?? "history";

    private RenderFragment FieldsPanel => __builder =>
    {
                <section class="panel" aria-labelledby="sheet-heading">
                    <div class="panel-title"><h2 id="sheet-heading" class="h5"><LucideIcon IconName="file-text" Size="18" Class="title-icon" /> @L["Actor.Sheet.SheetHeading"]</h2></div>
                    <div class="mb-3">
                        <label for="actor-name-input" class="field-label">@L["Actor.Sheet.Name"]</label>
                        <input id="actor-name-input" class="field-input" @bind="editName" disabled="@(!CanEdit)" data-testid="sheet-name" />
                    </div>
                    @if (schema != null)
                    {
                        <SchemaForm Schema="schema" Values="editSheet" ReferenceOptions="referenceOptions" FieldOptions="fieldOptions" HiddenKeys="HiddenNow" ReadOnly="@(!CanEdit)" ValuesChanged="OnSheetChanged" Secrets="@access.IsDm" Preview="PreviewMentions"
                                    Problems="FieldProblems" />
                    }
                    else if (editSheet.Count > 0)
                    {
                        <dl class="prop-list mb-0">
                            @foreach (var entry in editSheet)
                            {
                                <dt>@entry.Key</dt>
                                <dd>@entry.Value</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="small-muted mb-0">@L["Actor.Sheet.NoSheet", campaign.SystemId]</p>
                    }
                </section>

    };

    /// <summary>A section's widgets: a built-in one is a panel of its own, as the sheet has always had them; a run of generic ones
    /// shares one panel under the section's name.</summary>
    private RenderFragment Section(LayoutSection section) => __builder =>
    {
        var runs = new List<(bool Builtin, List<LayoutWidget> Widgets)>();
        foreach (var widget in section.Widgets.Where(Shows))
        {
            var builtin = SheetLayout.BuiltinWidgets.ContainsKey(widget.Widget);
            if (runs.Count == 0 || runs[^1].Builtin != builtin || builtin) runs.Add((builtin, new List<LayoutWidget>()));
            runs[^1].Widgets.Add(widget);
        }

        @foreach (var run in runs)
        {
            @if (run.Builtin)
            {
                @Widget(run.Widgets[0])
            }
            else
            {
                <section class="panel" data-testid="@($"section-{section.Section}")">
                    <div class="panel-title"><h2 class="h5"><LucideIcon IconName="@(section.Icon ?? "file-text")" Size="18" Class="title-icon" /> @SectionLabel(section)</h2></div>
                    @foreach (var widget in run.Widgets)
                    {
                        @Widget(widget)
                    }
                </section>
            }
        }
    };

    private RenderFragment Widget(LayoutWidget widget) => __builder =>
    {
        @switch (widget.Widget.ToLowerInvariant())
        {
            case "attributes":
                    @if (system != null && system.Attributes.Count > 0)
                    {
                        <AttributesPanel Definition="system" Evaluation="evaluation" Sheet="editSheet" CanEdit="CanEdit" IsDm="access?.IsDm == true" ShowTray="ShowTray" ShowSums="showSums"
                                         Problems="@(Problems(v => !IsIncrease(v) && (system.Attributes.Any(a => a.Key == v.FieldKey) || v.FieldKey == SheetRuleEngine.MethodKey || v.FieldKey.StartsWith(SheetRuleEngine.BonusPrefix, StringComparison.Ordinal))))"
                                         IncreaseProblems="@(Problems(IsIncrease))" Describe="Describe" Changed="OnRulesInputChanged" OnRoll="RollAsync" />
                    }

                break;
            case "skills":
                    @if (Rules?.Skills is { } skillRules && evaluation is { Skills.Count: > 0 })
                    {
                        <ChoicesBlock Evaluation="evaluation" CanEdit="CanEdit" TargetLabel="ChoiceTargetLabel" Describe="Describe" OnEdit="EditChoiceAsync"
                                      OptionText="ChoiceOptionText" MomentLabel="MomentName" Entries="EntryChoices" OpenKeys="openChoices" />
                        <SkillsPanel Rules="skillRules" Evaluation="evaluation" Sheet="editSheet" Attributes="system!.Attributes" CanEdit="CanEdit" Changed="OnRulesInputChanged" OnRoll="RollAsync"
                                     ShowSums="showSums" ShowSumsChanged="value => showSums = value" />
                    }

                break;
            case "fields":
                @FieldsPanel
                break;
            case "classes":
                    @if (Rules?.Multiclass is { } multiclass && evaluation != null)
                    {
                        <ClassesPanel Multiclass="multiclass" Evaluation="evaluation" LibraryPath="@LibraryPath" CurrentLevel="CurrentLevel" CanEdit="CanEdit" EntryName="Nm" Describe="Describe"
                                      Problems="Problems(v => v.FieldKey == multiclass.Key)" SubclassOptions="SubclassOptions"
                                      OnSetLevel="change => SetClassLevel(multiclass, change.ClassId, change.Level)" OnRemove="classId => RemoveClass(multiclass, classId)"
                                      OnSetSubclass="change => SetClassSubclass(multiclass, change.ClassId, change.SubclassId)" OnAdd="classId => AddClass(multiclass, classId)" />
                    }


                break;
            case "library":
                    @if (linkedEntries.Count > 0)
                    {
                        <section class="panel" aria-labelledby="linked-heading">
                            <div class="panel-title"><h2 id="linked-heading" class="h5"><LucideIcon IconName="book-open" Size="18" Class="title-icon" /> @L["Actor.Sheet.FromLibrary"]</h2></div>
                            @foreach (var (label, item) in linkedEntries)
                            {
                                <div class="mb-3">
                                    <div class="label-caps">@label</div>
                                    <a href="@LibraryPath/@item.Entry.Type/@Uri.EscapeDataString(item.Entry.Id)" class="fw-semibold">@Nm(item.Entry)</a>
                                    <div class="small">@TextFormatting.Summary(item.Entry.Description, 200)</div>
                                </div>
                            }
                        </section>
                    }
                    @if (actor is { Carried.Count: > 0 } && system != null)
                    {
                        @* Entries written for this character (the AI drafter's homebrew): not in any Library until a GM adds them. *@
                        <section class="panel" aria-labelledby="carried-heading" data-testid="sheet-carried">
                            <div class="panel-title"><h2 id="carried-heading" class="h5"><LucideIcon IconName="feather" Size="18" Class="title-icon" /> @L["Actor.Sheet.Homebrew.Title"]</h2></div>
                            <p class="field-hint mt-0">@L["Actor.Sheet.Homebrew.Hint"]</p>
                            @foreach (var carried in actor.Carried)
                            {
                                <details class="carried-entry" data-testid="sheet-carried-entry">
                                    <summary><span class="label-caps me-2">@(system.FindType(carried.Type)?.Label ?? carried.Type)</span><span class="fw-semibold">@carried.Name</span></summary>
                                    <EntryDetail Item="@(new LibraryItem(carried.ToEntry(system.Id), null, null))" Type="@system.FindType(carried.Type)" ForDm="@CanEdit" />
                                </details>
                            }
                        </section>
                    }
                break;
            case "picks":
                    @if (Rules != null && Rules.Lists.Count > 0 && evaluation != null)
                    {
                        <section class="panel" aria-labelledby="picks-heading">
                            <div class="panel-title"><h2 id="picks-heading" class="h5"><LucideIcon IconName="sparkles" Size="18" Class="title-icon" /> @L["Actor.Sheet.Picks"]</h2></div>
                            @foreach (var list in Rules.Lists)
                            {
                                <div class="mb-3" data-rule-key="@list.Key">
                                    <EntryListPicker Rule="list"
                                                     Picks="evaluation.ListPicks.GetValueOrDefault(list.Key) ?? Array.Empty<SheetPick>()"
                                                     Missing="evaluation.ListMissing.GetValueOrDefault(list.Key) ?? Array.Empty<MissingPick>()"
                                                     Options="evaluation.ListOptions.GetValueOrDefault(list.Key) ?? Array.Empty<ContentEntry>()"
                                                     Limit="evaluation.ListLimits.GetValueOrDefault(list.Key)"
                                                     ReadOnly="@(!CanEdit)"
                                                     LibraryPath="@LibraryPath"
                                                     Type="system?.FindType(list.TargetEntityType)"
                                                     Added="id => AddPick(list, id)"
                                                     Removed="index => RemovePick(list, index)"
                                                     Note="PickNote" />
                                    <RuleProblemList Problems="@(Problems(v => v.FieldKey == list.Key && !IsIncrease(v)))" Describe="Describe" TestId="@("list-problems-" + list.Key)" />
                                </div>
                            }
                        </section>
                    }
                break;
            case "inventory":
                    @if (Rules?.Inventory is { } inventoryRules && evaluation != null)
                    {
                        <div data-rule-key="@inventoryRules.Key">
                            <RuleProblemList Problems="@(Problems(v => v.FieldKey == inventoryRules.Key))" Describe="Describe" TestId="inventory-problems" />
                            @if (evaluation.Inventory.Count > 0)
                            {
                                <p class="small-muted mb-2" data-testid="inventory-weight">@(evaluation.CarryingCapacity is { } capacity
                                    ? L["Actor.Sheet.CarriedOf", Weight(evaluation.CarriedWeight, inventoryRules), Weight(capacity, inventoryRules)]
                                    : L["Actor.Sheet.Carried", Weight(evaluation.CarriedWeight, inventoryRules)])</p>
                            }
                            <InventoryPanel Rules="inventoryRules" Items="evaluation.Inventory" Options="inventoryOptions" FindType="type => system?.FindType(type)" Sheet="editSheet" CanEdit="CanEdit"
                                            LibraryPath="@LibraryPath" Changed="OnRulesInputChanged" />
                        </div>
                    }
                break;
            case "hit-points":
                    @if (system?.PrimaryResource is { } primary)
                    {
                        var current = YamlValues.GetInt(editSheet, primary.Key) ?? 0;
                        var max = primary.MaxKey != null ? YamlValues.GetInt(editSheet, primary.MaxKey) ?? 0 : 0;
                        var pct = max > 0 ? Math.Clamp(100.0 * current / max, 0, 100) : 0;
                        var band = pct < 25 ? "hp-low" : pct < 50 ? "hp-mid" : "hp-high";
                        <section class="panel" aria-labelledby="vitals-heading">
                            <div class="panel-title"><h2 id="vitals-heading" class="h5"><LucideIcon IconName="heart" Size="18" Class="title-icon" /> @primary.Label</h2></div>
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="stat-numeral hp-text" data-testid="hp-current">@current</span>
                                @if (max > 0)
                                {
                                    <span class="small-muted">/ @max</span>
                                }
                            </div>
                            @if (max > 0)
                            {
                                <div class="hp-bar @band" role="progressbar" aria-label="@primary.Label" aria-valuemin="0" aria-valuemax="@max" aria-valuenow="@current">
                                    <span style="width:@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                </div>
                            }
                            <p class="small-muted mt-2 mb-0">@(Rules?.HitPoints == null ? L["Actor.Sheet.HpLiveNoteEdit"] : L["Actor.Sheet.HpLiveNote"])</p>
                            @if (Rules?.HitPoints is { } hitPointRules)
                            {
                                <HitPointRulesPanel Rules="hitPointRules" Summary="evaluation?.HitPoints" Sheet="editSheet" CanEdit="CanEdit" Changed="OnRulesInputChanged" />
                            }
                        </section>
                    }

                break;
            case "armor-class":
                    @if (Rules?.ArmorClass is { } armorClassRules)
                    {
                        <ArmorClassPanel Rules="armorClassRules" Definition="system" Summary="evaluation?.ArmorClass" Sheet="editSheet" CanEdit="CanEdit" Changed="OnRulesInputChanged" />
                    }

                break;
            case "slots":
                    @if (Rules is { SlotPools.Count: > 0 } && editSheet.Keys.Any(k => Rules.SlotPools.Any(p => p.Owns(k))))
                    {
                        <section class="panel" aria-labelledby="sheet-slots-heading" data-testid="sheet-slots">
                            <div class="panel-title"><h2 id="sheet-slots-heading" class="h5"><LucideIcon IconName="flame" Size="18" Class="title-icon" /> @SlotTracker.Heading(system, Rules.SlotPools, editSheet.Keys)</h2></div>
                            <SlotTracker Definition="system" Pools="Rules.SlotPools" Keys="editSheet.Keys.ToList()" Value="key => YamlValues.GetInt(editSheet, key)" ReadOnly="@(!CanEdit)"
                                         OnAdjust="AdjustSlot" OnRest="RestSlots" />
                            <p class="small-muted mt-2 mb-0">@L["Actor.Sheet.SlotsNote"]</p>
                        </section>
                    }

                break;
            case "actions":
                    @if (evaluation is { Actions.Count: > 0 })
                    {
                        <ActionsPanel Evaluation="evaluation" Definition="system" Value="key => YamlValues.GetInt(editSheet, key)" ReadOnly="@(!CanEdit)"
                                      EntryName="Nm" Spend="SpendOnSheet" OnRoll="RollActionAsync" />
                    }

                break;
            case "features":
                    @if (HasFeatureSources)
                    {
                        @* A system with no skills has no skills panel to hold the choices a feature leaves open: they are here. *@
                        @if (Rules?.Skills == null && evaluation != null)
                        {
                            <ChoicesBlock Evaluation="evaluation" CanEdit="CanEdit" TargetLabel="ChoiceTargetLabel" Describe="Describe" OnEdit="EditChoiceAsync"
                                          OptionText="ChoiceOptionText" MomentLabel="MomentName" Entries="EntryChoices" OpenKeys="openChoices" />
                        }

                        <FeaturesPanel Evaluation="evaluation" Sheet="editSheet" Rules="Rules" Definition="system" ReadOnly="@(!CanEdit)"
                                       EntryName="@((type, id) => resolver?.Resolve(type, id)?.Name ?? id)"
                                       IsDm="@(access?.IsDm == true)" Spend="SpendOnSheet"
                                       OnAdjust="AdjustSlot" OnRest="RestFeatures" />
                    }

                break;
            case "moments":
                    @if (system != null)
                    {
                        <MomentsPanel Definition="system" Sheet="editSheet" ReadOnly="@(!CanEdit)" OnFire="FireMomentAsync" />
                    }

                break;
            case "level-up":
                    @if (CanEdit && HasLevel)
                    {
                        <section class="panel panel-ai" aria-labelledby="levelup-heading">
                            <div class="panel-title"><h2 id="levelup-heading" class="h5"><LucideIcon IconName="trending-up" Size="18" Class="title-icon" /> @L["Actor.Sheet.LevelUp"]</h2></div>
                            @if (AtMaxLevel)
                            {
                                <p class="small-muted mb-0" data-testid="levelup-max">@L["Actor.Sheet.LevelMax", CurrentLevel]</p>
                            }
                            else if (levelUpPlan is { } plan)
                            {
                                <LevelUpStepper Plan="plan" Evaluation="evaluation" Rules="Rules" ClassId="@levelUpClassId" Roll="levelUpRoll" EntryName="Nm" Describe="Describe"
                                                TargetLabel="ChoiceTargetLabel" OptionText="ChoiceOptionText" MomentLabel="MomentName" Entries="EntryChoices" OnPick="PickForLevelUp"
                                                OnClassChosen="ChooseLevelUpClass" OnRollTyped="SetLevelUpRoll" OnRollDie="RollLevelUpHitDie" OnApply="ApplyLevelUp" OnCancel="CloseLevelUp" />
                            }
                            else
                            {
                                <p class="small-muted">@L["Actor.Sheet.LevelUpIntro", CurrentLevel, CurrentLevel + 1]</p>
                                <div class="d-flex gap-2 flex-wrap">
                                    <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" Icon="trending-up" OnClick="OpenLevelUp" data-testid="levelup-start">@L["Actor.Sheet.LevelUpTo", CurrentLevel + 1]</CodexButton>
                                    @if (busy == "level")
                                    {
                                        <AiWorking Text="@L["Actor.Sheet.Thinking"]" OnStop="aiCall.Stop" TestId="levelup-working" />
                                    }
                                    else
                                    {
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" OnClick="SuggestLevelUpAsync" Disabled="@(busy != null)" data-testid="sheet-levelup">
                                            <LucideIcon IconName="sparkles" Size="14" /> @L["Actor.Sheet.SuggestLevel", CurrentLevel + 1]
                                        </CodexButton>
                                    }
                                </div>
                            }
                            @if (levelUpDone is { } done && levelUpPlan == null)
                            {
                                <LevelUpToDo Done="done" Evaluation="evaluation" Rules="Rules" Sheet="editSheet" OnGoThere="ShowRule" OnDismiss="() => levelUpDone = null" />
                            }
                            @if (levelUpAdvice != null)
                            {
                                <div class="ai-output mt-3" data-testid="levelup-advice">
                                    <div class="rules-text">@((MarkupString)TextFormatting.ToHtml(levelUpAdvice))</div>
                                    <div class="d-flex gap-2">
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => levelUpAdvice = null">@L["Actor.Sheet.Dismiss"]</CodexButton>
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="AppendAdviceToNotes">@L["Actor.Sheet.KeepInNotes"]</CodexButton>
                                    </div>
                                </div>
                            }
                        </section>
                    }

                break;
            default:
                @if (sheetView != null && resolver != null && system != null && Shows(widget))
                {
                    <div class="sheet-widget" data-testid="@($"widget-{widget.Widget}-{widget.Key ?? widget.Roll ?? widget.Target}")">
                        <SheetWidget Widget="widget" Definition="system" View="sheetView" Sheet="editSheet" Resolver="resolver" CanEdit="CanEdit" CanRoll="CanEdit"
                                     Changed="OnRulesInputChanged" Left="SayLeft" OnRoll="RollDefinitionAsync"
                                     Linked="linkedSheets" Actors="noteActors.Values" ActorId="@actor?.Id" CampaignId="@CampaignId" ViewerIsDm="@(access?.IsDm == true)"
                                     Vault="Vault" LinkChanged="OnLinkChangedAsync" />
                    </div>
                }
                break;
        }
    };

    private string activeTab = "";

    private string ActiveTab => Tabs.Any(t => t.Key == activeTab) ? activeTab : Tabs[0].Key;

    /// <summary>The sections the sheet offers; a tab appears only when it has something to show.</summary>
    private IReadOnlyList<(string Key, string Label, string Icon)> Tabs
    {
        get
        {
            var tabs = Layout.Where(s => !s.Aside && Shows(s)).Select(s => (s.Section, SectionLabel(s), s.Icon ?? "file-text")).ToList();
            tabs.Add(("history", L["Actor.Sheet.History"], "feather"));
            if (said.Count > 0) tabs.Add(("said", L["Actor.Sheet.Said"], "message-square-quote"));
            if (MentionCount > 0) tabs.Add(("mentioned", L["Actor.Sheet.InNotes"], "notebook-pen"));
            if (access?.IsDm == true) tabs.Add(("notes", L["Actor.Sheet.DmNotes"], "lock"));
            return tabs;
        }
    }

    /// <summary>Fields changed since the sheet was loaded or last saved, counting the name and the long texts.</summary>
    private int DirtyCount
    {
        get
        {
            if (actor == null) return 0;
            var count = 0;
            if (editName != actor.Name) count++;
            // The boxes hold the text as typed (@Name), the stored text holds ids.
            if (editBiography != noteMentions.ForEditing(actor.Biography ?? "")) count++;
            if (editDmNotes != noteMentions.ForEditing(actor.DmNotes ?? "")) count++;
            if (access?.IsDm == true)
            {
                if (audience.Visibility != actor.Visibility) count++;
                if (audience.PublicName != (actor.PublicName ?? "")) count++;
                if (audience.PublicDescription != noteMentions.ForEditing(actor.PublicDescription ?? "")) count++;
            }

            return count + YamlValues.ChangedKeys(editSheet, baselineSheet);
        }
    }

    /// <summary>Class and level, and the species, as plaques on the plate.</summary>
    private IEnumerable<string> PlatePlaques()
    {
        // A system with several sheet kinds says which this is (a scoundrel, a crew).
        if (system is { SheetKinds.Count: > 1 } && SheetLayout.KindOf(system, editSheet) is { } sheetKind)
        {
            yield return system.DisplayValue(string.IsNullOrEmpty(sheetKind.Label) ? sheetKind.Kind : sheetKind.Label);
        }

        if (evaluation is { Classes.Count: > 0 })
        {
            foreach (var cls in evaluation.Classes) yield return $"{Nm(cls.Entry) ?? cls.Id} {cls.Level}";
        }
        else if (HasLevel)
        {
            yield return L["Actor.Sheet.Level", CurrentLevel];
        }
    }

    /// <summary>The derived numbers (initiative, proficiency bonus) and speed, for the plate's stat strip.</summary>
    private IEnumerable<(string Label, string Value)> PlateStats()
    {
        if (Rules != null && evaluation != null)
        {
            foreach (var derived in Rules.Derived)
            {
                if (evaluation.Derived.TryGetValue(derived.Key, out var value)) yield return (derived.Label, derived.Signed ? FormatSigned(value) : value.ToString() ?? string.Empty);
            }
        }

        if (system?.ActorFields.FirstOrDefault(f => f.Key == system.FieldRoles.Speed) is { } speed && YamlValues.GetInt(editSheet, speed.Key) is { } distance)
        {
            // The plate says the system's unit with the number, so the label's own "(feet)" goes, in any language.
            var label = speed.Abbreviation ?? System.Text.RegularExpressions.Regex.Replace(speed.Label, @"\s*\([^)]*\)\s*$", "");
            yield return (label, string.IsNullOrEmpty(speed.Unit) ? distance.ToString(System.Globalization.CultureInfo.CurrentCulture) : $"{distance} {speed.Unit}");
        }
    }

    /// <summary>Hidden fields, plus maximum hit points while the rules work them out (typing there would be overwritten).</summary>
    private IReadOnlySet<string> HiddenNow =>
        Rules?.HitPoints is { } hp && evaluation?.HitPoints is { Active: true } ? new HashSet<string>(hiddenKeys, StringComparer.OrdinalIgnoreCase) { hp.Key } : hiddenKeys;

    private ConfirmDialog leaveConfirm = null!;

    private string CastPath => $"/campaigns/{CampaignId}/cast";

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        var dirty = CanEdit ? DirtyCount : 0;
        if (dirty == 0) return;
        var leave = await leaveConfirm.ShowAsync(
            L["Actor.Sheet.ConfirmDiscardTitle", dirty],
            L["Actor.Sheet.ConfirmDiscardBody"],
            L["Actor.Sheet.DiscardLeave"], isDestructive: true, cancel: L["Actor.Sheet.KeepEditing"]);
        if (!leave) context.PreventNavigation();
    }

    private bool CanEdit => access != null && actor != null && (access.IsDm || actor.OwnerUserId == currentUserId);
    private SheetRules? Rules => system?.SheetRules;
    private string Enforcement => SheetRuleEngine.EffectiveEnforcement(system, campaign?.RulesEnforcement);

    private static string FormatSigned(object value) => Bidi.Ltr(value is long l && l >= 0 ? "+" + l : value.ToString() ?? string.Empty);
    // The field the system says holds the character's level (FieldRoles); without one there is no level up.
    private string? LevelField => system?.FieldRoles.Level;
    private bool HasLevel => LevelField != null && schema?.Fields.Any(f => f.Key == LevelField) == true;
    private int CurrentLevel => LevelField == null ? 1 : YamlValues.GetInt(editSheet, LevelField) ?? 1;

    // The system's top level (the level field's max, 20 in the SRD): past it the tables have no row, so there is no level up (R7).
    private bool AtMaxLevel => schema?.Fields.FirstOrDefault(f => f.Key == LevelField)?.Max is { } max && CurrentLevel >= max;

    private string DisplayName => actor == null ? string.Empty : actor.NameFor(access?.IsDm != false);

    /// <summary>The characters the reader plays: which lore and which revealed blocks reach them.</summary>
    private IReadOnlySet<string> OwnedActorIds => noteActors.Values.Where(a => a.OwnerUserId == currentUserId).Select(a => a.Id).ToHashSet();

    /// <summary>A player looking at someone the DM keeps unidentified: what they were handed is a mask, not a sheet.</summary>
    private bool IsStranger => actor != null && access is { IsDm: false } && actor.Visibility == ActorVisibility.Unknown && actor.OwnerUserId != currentUserId;

    private string KindLabel => actor?.Kind switch
    {
        ActorKind.PlayerCharacter => L["Actor.Sheet.KindPc"],
        ActorKind.Monster => L["Actor.Sheet.KindMonster"],
        _ => L["Actor.Sheet.KindNpc"]
    };

    private string VisibilityLabel => actor?.Visibility switch
    {
        ActorVisibility.Known => L["Actor.Sheet.VisLabelKnown"],
        ActorVisibility.Unknown => L["Actor.Sheet.VisLabelUnknown"],
        _ => L["Actor.Sheet.VisLabelHidden"]
    };

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        ActorDocument? own = null;
        if (Vault)
        {
            own = currentUserId == null ? null : await VaultRepo.GetAsync(ActorId, currentUserId);
            campaign = own == null ? null : Codex.Web.Services.VaultService.CampaignFor(own.SystemId!);
            access = own == null ? null : CampaignAccess.Vault(currentUserId!);
        }
        else
        {
            campaign = await CampaignRepo.GetAsync(CampaignId);
            access = campaign != null && currentUserId != null ? await AccessResolver.ResolveAsync(CampaignId, currentUserId) : null;
        }

        if (campaign != null && access != null)
        {
            if (access.IsDm) memberNames = await MemberNames.LoadAsync(UserRepo, campaign);
            actor = Vault ? own : await ActorRepo.GetVisibleAsync(ActorId, access);
            if (actor != null)
            {
                // The sheet shows the system in the reader's language; the rules engine still matches the original words (see AttributeDefinition.CanonicalLabel).
                // While the table runs, the sheet is the table's: the definition it started with, even if the system was reloaded
                // since (overhaul step 10), so what the page shows and saves is what the table's rules do.
                system = RuntimeManager.TryGet(CampaignId)?.System?.Localize(System.Globalization.CultureInfo.CurrentUICulture.Name)
                    ?? SystemCatalog.GetLocalizedDefinition(campaign.SystemId);
                schema = system != null
                    ? DataDrivenSystemPlugin.BuildActorSchema(system)
                    : SystemCatalog.GetUISchemas(campaign.SystemId).FirstOrDefault(s => s.EntityType == DataDrivenSystemPlugin.ActorSchemaType);
                attributeKeys = (system?.Attributes.Select(a => a.Key) ?? Enumerable.Empty<string>()).ToHashSet(StringComparer.OrdinalIgnoreCase);
                hiddenKeys = attributeKeys
                    .Concat(attributeKeys.Select(k => SheetRuleEngine.BasePrefix + k))
                    .Concat(attributeKeys.Select(k => SheetRuleEngine.BonusPrefix + k))
                    .Append(SheetRuleEngine.MethodKey)
                    .Concat(system?.SheetRules?.Lists.Select(l => l.Key) ?? Enumerable.Empty<string>())
                    .Concat(system?.SheetRules?.Multiclass is { } mc ? new[] { mc.Key, mc.ClassLevelKey } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.HitPoints is { } hp ? new[] { hp.ModeKey, hp.RollsKey } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.ArmorClass is { } ac ? new[] { ac.Key, ac.ModeKey, ac.MiscField } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.Inventory is { } inv ? new[] { inv.Key } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.Skills is { } sk ? sk.SkillRanks().Concat(sk.SaveRanks()).Select(r => r.SheetKey) : Enumerable.Empty<string>())
                    .Concat(system?.SheetRules?.Inherits.Select(i => i.AppliedKey) ?? Enumerable.Empty<string>())
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);

                ActorSheetSync.ApplyStateToSheet(actor, system, Components);
                wikiPage = string.IsNullOrEmpty(actor.WikiPageId) || access == null ? null
                    : (await WikiRepo.GetVisibleForCampaignAsync(access)).FirstOrDefault(p => p.Id == actor.WikiPageId);
                editName = actor.Name;
                audience.Visibility = actor.Visibility;
                audience.PublicName = actor.PublicName ?? "";
                audience.Kind = actor.Kind;
                audience.OwnerId = actor.OwnerUserId ?? "";
                editSheet = new Dictionary<string, object>(actor.Sheet);
                loadedSheet = new Dictionary<string, object>(actor.Sheet);

                await LoadReferenceOptionsAsync();
                // A vault character reads its sheet against the packs and the entries it carries itself.
                resolver = system != null ? await CachedEntryResolver.LoadAsync(Library, campaign, access, system, actor.Carried.Select(c => c.ToEntry(system.Id))) : null;
                engine = system != null && resolver != null ? new SheetRuleEngine(system, resolver) : null;
                layout = system != null ? SheetLayout.For(system, editSheet) : SheetLayout.Builtin;
                inventoryOptions = Rules?.Inventory?.Types.ToDictionary(
                    type => type,
                    type => (IReadOnlyList<ContentEntry>)(resolver?.Candidates(type).OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase).ToList() ?? new List<ContentEntry>()))
                    ?? new Dictionary<string, IReadOnlyList<ContentEntry>>();
                var subclassType = system?.ActorFields.FirstOrDefault(f => f.Key == Rules?.Multiclass?.SubclassField)?.TargetEntityType;
                subclassCandidates = subclassType == null || resolver == null ? new List<ContentEntry>() : resolver.Candidates(subclassType).ToList();
                await LoadLinkedSheetsAsync();
                Reevaluate();
                baselineSheet = new Dictionary<string, object>(editSheet);
                SeeOnSetValues();
                levelUpClassId = evaluation?.Classes.FirstOrDefault(c => c.IsFirst)?.Id ?? "";
                await LoadLinkedEntriesAsync();
                var visibleActors = Vault ? new List<ActorDocument>() : (await ActorRepo.GetVisibleForCampaignAsync(access)).ToList();
                var (sessions, writings, mentions) = Vault
                    ? ((IReadOnlyList<SessionDocument>)Array.Empty<SessionDocument>(), MentionWritings.Empty, MentionDirectory.Empty)
                    : await MentionSources.NotesAsync(campaign, access, visibleActors, forWriting: CanEdit);
                said = SessionQuotes.SaidBy(sessions, actor.Id, access.IsDm);
                mentionedIn = SessionMentions.NotesMentioning(sessions, MentionKind.Actor, actor.Id, access.IsDm);
                writtenIn = writings.Mentioning(MentionKind.Actor, actor.Id);
                noteMentions = mentions;
                noteActors = visibleActors.ToDictionary(a => a.Id);
                mentionsJson = CanEdit ? MentionLinks.Json(mentions, visibleActors) : "[]";
                // The DM's templates (a template can hold the DM's secrets, so a player's boxes get none).
                templates = access.IsDm ? await TemplateRepo.GetAsync(access, L) : null;
                editBiography = mentions.ForEditing(actor.Biography ?? "");
                editDmNotes = mentions.ForEditing(actor.DmNotes ?? "");
                audience.PublicDescription = mentions.ForEditing(actor.PublicDescription ?? "");
            }
        }

        loading = false;
    }

    // The sheets the actors this sheet links to have (docs/CREW_LINKS_DESIGN.md), for every evaluation, roll and intent on this page. Loaded with the
    // campaign's own access, not the viewer's: what a link brings never depends on who is looking (only the linked actor's name does).
    // None for a vault character, or a sheet that links to nobody: then a link is simply absent.
    private ILinkedSheets? linkedSheets;

    private async Task LoadLinkedSheetsAsync()
    {
        linkedSheets = null;
        if (Vault || access == null || system is not { SheetKinds.Count: > 0 }) return;
        var ids = ActorLinkedSheets.LinkedIds(editSheet);
        if (ids.Count == 0) return;
        linkedSheets = new ActorLinkedSheets(await ActorRepo.GetForRulesAsync(access, ids));
    }

    /// <summary>The link was changed in the widget: the new linked actor's sheet is loaded before the rules run again on it.</summary>
    private async Task OnLinkChangedAsync()
    {
        await LoadLinkedSheetsAsync();
        await OnRulesInputChanged();
    }

    /// <summary>Re-runs the rules after any edit: totals, derived values, allowed picker options and violations.</summary>
    private void Reevaluate()
    {
        if (engine == null)
        {
            evaluation = null;
            return;
        }

        evaluation = engine.Recompute(editSheet, linkedSheets);
        // The tray's bonuses for the next roll follow the sheet: one whose feature went, or whose pool ran dry, is no longer ticked.
        bonusOffers = OptInsOfSheet();
        rollBonuses.Keep(bonusOffers);
        sheetView = system is { SheetKinds.Count: > 0 } && resolver != null ? new SheetView(system, resolver, editSheet, linkedSheets) : null;
        fieldOptions = evaluation.AllowedOptions.ToDictionary(
            kv => kv.Key,
            kv => (IReadOnlyList<(string Id, string Name)>)kv.Value.Select(e => (e.Id, Nm(e)!)).ToList());
        // An open level-up follows the sheet: a pick or a score changed under it changes what the next level brings.
        if (levelUpPlan != null) PlanLevelUp();
    }

    // ---- Rule problems where they are fixed (U4): beside the field, a count on its tab, and the summary's way there. ----

    // An increase's problem names its feat's list, but is fixed where its points are spent, on Attributes.
    private static bool IsIncrease(RuleViolation violation) => violation.Key?.StartsWith("Actor.Rule.Inc", StringComparison.Ordinal) == true;

    private IReadOnlyList<RuleViolation> Problems(Func<RuleViolation, bool> where) =>
        CanEdit && evaluation != null ? evaluation.Violations.Where(where).ToList() : Array.Empty<RuleViolation>();

    private string TabOf(RuleViolation violation) => TabFor(RuleTarget(violation));

    // The tab that fixes a problem: the list's picker, the inventory, a widget bound to the key, else the attributes' (or first) tab.
    private string TabFor(string target) =>
        (Rules?.Lists.Any(l => l.Key == target) == true ? SectionWith(w => Is(w, "picks"))
            : target == Rules?.Inventory?.Key ? SectionWith(w => Is(w, "inventory"))
            : null)
        ?? SectionWith(w => w.Key == target || w.Keys.Contains(target))
        ?? SectionWith(w => Is(w, "attributes"))
        ?? FirstTab;

    private int ProblemsOn(string tab) => Problems(v => TabOf(v) == tab).Count;

    // The data-rule-key of the place that fixes it.
    private string RuleTarget(RuleViolation violation) =>
        IsIncrease(violation) ? "increases"
        : violation.FieldKey == SheetRuleEngine.MethodKey || violation.FieldKey.StartsWith(SheetRuleEngine.BonusPrefix, StringComparison.Ordinal) ? "attributes"
        : violation.FieldKey;

    /// <summary>Each sheet field's problems, said under the field.</summary>
    private IReadOnlyDictionary<string, string> FieldProblems =>
        Problems(v => schema?.Fields.Any(f => f.Key == v.FieldKey) == true && system?.Attributes.Any(a => a.Key == v.FieldKey) != true)
            .GroupBy(v => v.FieldKey)
            .ToDictionary(g => g.Key, g => string.Join(" ", g.Select(Describe)));

    private string? pendingRule;

    /// <summary>Opens the tab that fixes it and brings the place into view.</summary>
    private void ShowRule(string target)
    {
        activeTab = TabFor(target);
        pendingRule = target;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        OpenChoiceFromAddress();
        if (pendingRule is { } target)
        {
            pendingRule = null;
            await JS.InvokeVoidAsync("codex.showRule", target);
        }
    }

    /// <summary>What a track change on the sheet left for the table (an overflow's question), said rather than dropped.</summary>
    private Task SayLeft(IReadOnlyList<SheetIntent> left)
    {
        var asks = left.Where(i => i.Kind == SheetEvents.AskKind).ToList();
        if (asks.Count > 0)
        {
            flash = Flash.Info(L["Actor.Sheet.TableAsks", string.Join("; ", asks.Select(a => string.Join(", ", (a.Fields.GetValueOrDefault("choices") as System.Collections.IEnumerable)?.Cast<object?>().Select(c => system?.DisplayValue(c?.ToString() ?? "") ?? c?.ToString()) ?? Array.Empty<string?>())))]);
        }

        return Task.CompletedTask;
    }

    /// <summary>A roll from the layout's roll widget, made on this sheet with the host's dice. What it asks of this sheet (a cost, a
    /// mark) is applied to the sheet being edited, to be saved with it; what it asks of others is said.</summary>
    private async Task RollDefinitionAsync(SheetRollRequest request)
    {
        if (system == null || resolver == null || actor == null || currentUserId == null) return;
        sheetRollNote = null;

        // With the table live, the roll is the table's: made on the live sheet, in the shared roll log, its costs applied there.
        var live = RuntimeManager.TryGet(CampaignId);
        if (live?.ActiveSession != null && live.HasActor(actor.Id))
        {
            var command = new MakeRollCommand(actor.Id, currentUserId, request);
            await live.EnqueueAsync(command);
            sheetRoll = command.Rolled;
            if (command.Failed != null) flash = Flash.Error(L["Actor.Sheet.RollFailed", command.Failed]);
            else sheetRollNote = L["Actor.Sheet.RollAtTable"];
            return;
        }

        try
        {
            sheetRoll = SheetRolls.Roll(system, resolver, editSheet, request, new RandomDiceSource(), linkedSheets);
        }
        catch (Exception ex) when (ex is RollException or FormulaException or InvalidOperationException)
        {
            sheetRoll = null;
            flash = Flash.Error(L["Actor.Sheet.RollFailed", ex.Message]);
            return;
        }

        var applied = SheetIntents.Apply(system, resolver, editSheet, sheetRoll.AllIntents(), linked: linkedSheets);
        var left = applied.Left.Where(i => i.Kind != SheetEvents.AskKind).ToList();
        if (left.Count > 0) sheetRollNote = L["Actor.Sheet.RollLeft", left.Count];
        await SayLeft(applied.Left);
        Reevaluate();
    }

    private async Task DismissJoinNotesAsync()
    {
        if (actor == null || currentUserId == null) return;
        // The store checks the owner again: the notes are the player's to read and dismiss.
        if (await VaultRepo.DismissJoinNotesAsync(actor.Id, currentUserId)) actor.JoinNotes = new List<JoinNote>();
    }

    private async Task OnRulesInputChanged()
    {
        // A value being set can be the moment a system declares ("load chosen": the load input): fired once, after the value is written.
        foreach (var moment in MomentsSetByEdit()) await FireMomentAsync(moment);
        Reevaluate();
    }

    // What each declared moment's onSet value held when last looked at, so a change of it is seen as the value being set.
    private readonly Dictionary<string, string?> onSetSeen = new(StringComparer.Ordinal);

    private string? OnSetValue(string key) => editSheet.TryGetValue(key, out var raw) ? Convert.ToString(raw, System.Globalization.CultureInfo.InvariantCulture) : null;

    /// <summary>Remembers the values the declared moments watch (when the sheet loads), so only a later change of one fires its moment.</summary>
    private void SeeOnSetValues()
    {
        onSetSeen.Clear();
        foreach (var moment in SystemMoments.Of(system).Where(m => m.OnSet != null)) onSetSeen[moment.OnSet!] = OnSetValue(moment.OnSet!);
    }

    /// <summary>The declared moments whose <c>onSet</c> value changed since it was last seen.</summary>
    private List<string> MomentsSetByEdit()
    {
        var fired = new List<string>();
        if (!CanEdit) return fired;
        foreach (var moment in SystemMoments.Of(system).Where(m => m.Kind == MomentKind.Declared && m.OnSet != null))
        {
            var now = OnSetValue(moment.OnSet!);
            if (onSetSeen.TryGetValue(moment.OnSet!, out var was) && was == now) continue;
            onSetSeen[moment.OnSet!] = now;
            fired.Add(moment.Key);
        }

        return fired;
    }

    /// <summary>The live table, when this actor is at it: a session is on and the actor is in play.</summary>
    private CampaignRuntime? TableOfActor() =>
        actor != null && RuntimeManager.TryGet(CampaignId) is { ActiveSession: not null } live && live.HasActor(actor.Id) ? live : null;

    /// <summary>A moment (or rest) fired on the sheet: where the table runs it, the table's own command does (so the refill is logged, undoable
    /// and not lost to the merge on save); otherwise it is applied to the sheet being edited, to be saved with it.</summary>
    private async Task FireMomentAsync(string moment)
    {
        if (system == null || actor == null || !CanEdit) return;
        if (TableOfActor() is { } live)
        {
            await RunAtTableAsync(live, new MomentCommand(actor.Id, moment), moment);
            return;
        }

        flash = null;
        var before = new Dictionary<string, object>(editSheet);
        RefillFeatureCounters(moment);
        if (resolver != null && SheetEvents.Handles(system, moment))
        {
            try
            {
                var raised = SheetEvents.Raise(system, resolver, editSheet, new SheetEvent(moment, new Dictionary<string, object?>(StringComparer.Ordinal)), actor.Id, linked: linkedSheets);
                await SayLeft(raised.Applied.Left);
            }
            catch (SheetEventException ex)
            {
                flash = Flash.Error(L["Actor.Sheet.RollFailed", ex.Message]);
            }
        }

        OfferChoicesAfter(moment);
        if (flash == null) SayMoment(moment, before);
        Reevaluate();
    }

    /// <summary>Sends a rest or moment to the live table, then takes the table's numbers for the sheet's counters as the sheet's own (and as what
    /// it was loaded with, so saving does not merge them as an edit made here).</summary>
    private async Task RunAtTableAsync(CampaignRuntime live, IRuntimeCommand command, string moment)
    {
        flash = null;
        var before = new Dictionary<string, object>(editSheet);
        // What the table held before the command: only the counters the command itself moves are taken, so an unsaved mark made here on
        // another counter (stress ticked a moment ago) is kept for the save to merge.
        var keys = editSheet.Keys.ToList();
        var atTable = actor == null ? null : live.Snapshot.Actor(actor.Id);
        var was = keys.ToDictionary(k => k, k => atTable?.Pool(k), StringComparer.Ordinal);
        try
        {
            await live.EnqueueAsync(command);
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException)
        {
            flash = Flash.Error(L["Combat.CommandFailed"]);
            return;
        }

        if (actor != null && live.Snapshot.Actor(actor.Id) is { } state)
        {
            foreach (var key in keys)
            {
                if (state.Pool(key) is not { } value || was[key] == value) continue;
                editSheet[key] = (long)value;
                loadedSheet[key] = (long)value;
                baselineSheet[key] = (long)value;
            }
        }

        OfferChoicesAfter(moment);
        SayMoment(moment, before);
        Reevaluate();
    }

    /// <summary>Says, in the status message, what the moment brought back (or that it had nothing to bring).</summary>
    private void SayMoment(string moment, IReadOnlyDictionary<string, object> before)
    {
        var name = SystemMoments.Find(system, moment)?.Label ?? MomentName(moment);
        var changed = SystemMoments.WhatChanged(system, before, editSheet);
        flash = Flash.Info(changed.Count > 0 ? L["Actor.Moments.Done", name, string.Join(", ", changed)] : L["Actor.Moments.Nothing", name]);
    }

