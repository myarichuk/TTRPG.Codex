    // The choices the last rest says may be changed now, and those the sheet shows open for it.
    private List<(string Key, string Label)> restChoices = new();
    private string? restMoment;
    private readonly HashSet<string> openChoices = new(StringComparer.Ordinal);

    /// <summary>Shows the choice stored under <paramref name="key"/> open: its tab (where the choices are shown), the picker unfolded, its first control focused.</summary>
    private void OpenChoice(string key)
