    private void SetRawList(string key, List<string> raw)
    {
        if (raw.Count == 0) editSheet.Remove(key);
        else editSheet[key] = raw.Cast<object>().ToList();
        Reevaluate();
    }

    private void AddPick(ListRule list, string id) => SetRawList(list.Key, SheetRuleEngine.RawList(editSheet, list.Key).Append(id).ToList());

    private void RemovePick(ListRule list, int index)
    {
