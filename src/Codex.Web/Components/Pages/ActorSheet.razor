    private IEnumerable<ContentEntry> SubclassOptions(string classId) =>
        subclassCandidates
            .Where(c => string.Equals(c.Properties.GetValueOrDefault(Rules?.Multiclass?.SubclassClassProperty ?? string.Empty)?.ToString(), classId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase);

    private void SetClassSubclass(MulticlassRules rules, string classId, string? subclassId) =>
        SetOtherClasses(rules, SheetRuleEngine.ParseClassLevels(editSheet, rules.Key).Select(c => c.Id == classId ? c with { Subclass = string.IsNullOrEmpty(subclassId) ? null : subclassId } : c).ToList());

    private void AddClass(MulticlassRules rules, string classId)
    {
        if (string.IsNullOrEmpty(classId)) return;
        var classes = SheetRuleEngine.ParseClassLevels(editSheet, rules.Key);
        classes.Add(new OtherClass(classId, 1));
        SetOtherClasses(rules, classes);
    }

    private void RemoveClass(MulticlassRules rules, string classId) =>
        SetOtherClasses(rules, SheetRuleEngine.ParseClassLevels(editSheet, rules.Key).Where(c => c.Id != classId).ToList());

    private void SetClassLevel(MulticlassRules rules, string classId, int level)
    {
        SetOtherClasses(rules, SheetRuleEngine.ParseClassLevels(editSheet, rules.Key).Select(c => c.Id == classId ? c with { Level = level } : c).ToList());
    }

    private void AdjustSlot((string Key, int Delta, string Label) change)
    {
        var maxKey = SystemDefinition.PoolMaxKey(system, change.Key);
        var max = YamlValues.GetInt(editSheet, maxKey) ?? 0;
        var current = YamlValues.GetInt(editSheet, change.Key) ?? max;
        editSheet[change.Key] = (long)Math.Clamp(current + change.Delta, 0, max);
    }

    private void RestSlots((string Name, List<string> Keys) rest)
    {
        foreach (var key in rest.Keys)
        {
            if (YamlValues.GetInt(editSheet, SystemDefinition.PoolMaxKey(system, key)) is { } max) editSheet[key] = (long)max;
        }

        flash = Flash.Info(L["Actor.Sheet.SlotsRefilled", SlotTracker.RestName(system, rest.Name)]);
    }

    private async Task LoadReferenceOptionsAsync()
    {
        referenceOptions = new Dictionary<string, IReadOnlyList<(string, string)>>();
        if (campaign == null || access == null || schema == null) return;
        foreach (var target in schema.Fields.Where(f => f.Type == FieldType.EntityReference && f.TargetEntityType != null).Select(f => f.TargetEntityType!).Distinct())
        {
            referenceOptions[target] = (await Library.OptionsAsync(campaign, access, target, L.Culture.Name)).Select(i => (i.Entry.Id, i.Entry.Name)).ToList();
        }
    }

    private async Task LoadLinkedEntriesAsync()
    {
        linkedEntries = new List<(string, LibraryItem)>();
        if (campaign == null || access == null || schema == null) return;
        foreach (var field in schema.Fields.Where(f => f.Type == FieldType.EntityReference && f.TargetEntityType != null))
        {
            var id = YamlValues.GetString(editSheet, field.Key);
            if (string.IsNullOrEmpty(id)) continue;
            var item = await Library.GetAsync(campaign, access, field.TargetEntityType!, id, L.Culture.Name);
            if (item != null) linkedEntries.Add((field.Label, item));
        }
    }


    private ActorDocument ApplyEdits(ActorDocument target)
    {
        target.Name = string.IsNullOrWhiteSpace(editName) ? target.Name : editName.Trim();
        engine?.ApplyAttributeTotals(editSheet);
        target.Sheet = new Dictionary<string, object>(editSheet);
        target.Biography = string.IsNullOrWhiteSpace(editBiography) ? null : noteMentions.Encode(editBiography.Trim());
        if (access!.IsDm)
        {
            target.DmNotes = string.IsNullOrWhiteSpace(editDmNotes) ? null : noteMentions.Encode(editDmNotes.Trim());
            target.Visibility = audience.Visibility;
            target.PublicName = string.IsNullOrWhiteSpace(audience.PublicName) ? null : audience.PublicName.Trim();
            target.PublicDescription = string.IsNullOrWhiteSpace(audience.PublicDescription) ? null : noteMentions.Encode(audience.PublicDescription.Trim());
            target.Kind = audience.Kind;
            target.OwnerUserId = audience.Kind == ActorKind.PlayerCharacter && !string.IsNullOrEmpty(audience.OwnerId) ? audience.OwnerId : (audience.Kind == ActorKind.PlayerCharacter ? target.OwnerUserId : null);
        }

        ActorSheetSync.ApplySheetToState(target, system, Components);
        return target;
    }

    /// <summary>Saves through the live table when there is one (merging with whatever the table changed
    /// since this page loaded), and straight to the actor otherwise. <see cref="loadedSheet"/> is what
    /// tells the merge which fields were edited here. It is the sheet as stored, not <see cref="baselineSheet"/>
    /// (the sheet after the rules ran on load, which only decides what counts as unsaved): what the rules
    /// recomputed on load is written too, and a counter they moved (current hit points following a new
    /// maximum) is merged by that move, added to the table's value rather than put over it.</summary>
    // Set when the last save was refused with the edits left in the page: the DM changed the history while the player was
    // editing it, or someone saved the sheet since this page loaded it.
    private bool editsKept;

    private async Task<bool> TrySaveActorAsync()
    {
        editsKept = false;
        try
        {
            return await RuntimeManager.TrySaveActorAsync(actor!, loadedSheet, access!, system);
        }
        catch (LocalizedException ex) when (ex.Key == "Actor.Sheet.HistoryChanged")
        {
            editsKept = true;
            flash = Flash.Error(L[ex.Key]);
            return false;
        }
        catch (LocalizedException ex) when (ex.Key == "Actor.Sheet.ChangedMeanwhile")
        {
            // The page now replaces the version stored since, so a second Save is made knowing it (D3).
            if (await ActorRepo.GetVisibleAsync(actor!.Id, access!) is { } latest) DocumentVersions.Carry(actor, latest);
            editsKept = true;
            flash = Flash.Error(L[ex.Key]);
            return false;
        }
    }

    // A second Save (a double click, Ctrl+S twice) while one is still being written does nothing.
    private readonly SaveGate saveGate = new();

    private Task SaveAsync() => saveGate.RunAsync(SaveNowAsync);

    private async Task SaveNowAsync()
    {
        if (actor == null || access == null || campaign == null) return;
        flash = null; // a message from an earlier attempt must not outlive this one
        Reevaluate();
        if (evaluation is { HasViolations: true })
        {
            if (Enforcement == "strict" && !access.IsDm)
            {
                flash = Flash.Error(L["Actor.Sheet.NotSavedStrict", evaluation.Violations.Count]);
                return;
            }

            if (Enforcement != "off")
            {
                flash = Flash.Info(L["Actor.Sheet.SavedWarnings", evaluation.Violations.Count]);
            }
        }

        ApplyEdits(actor);

        if (await TrySaveActorAsync())
        {
            flash ??= Flash.Success(L["Common.Saved"]);
        }
        else if (editsKept)
        {
            // Not reloaded: the player's text stays in the editor for them to copy.
            return;
        }
        else
        {
            flash = Flash.Error(L["Actor.Sheet.NoPermission"]);
        }

        await ReloadAsync();
    }

    private void SetDrawing(bool drawing) => busy = drawing ? "portrait" : null;

    /// <summary>The character as the sheet now has it, for drawing its portrait.</summary>
    private ActorDocument PortraitDraft() =>
        ForAi(ApplyEdits(new ActorDocument { Id = actor!.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name, Biography = actor.Biography, PublicDescription = actor.PublicDescription }));

    /// <summary>The model reads names, not stored mention ids.</summary>
    private ActorDocument ForAi(ActorDocument snapshot)
    {
        snapshot.Biography = snapshot.Biography == null ? null : noteMentions.Plain(snapshot.Biography);
        snapshot.DmNotes = snapshot.DmNotes == null ? null : noteMentions.Plain(snapshot.DmNotes);
        return snapshot;
    }

    private async Task RewriteAsync(AiAudience audience)
    {
        if (actor == null || campaign == null || currentUserId == null || busy != null) return;
        busy = audience == AiAudience.Dm ? "dm" : "bio";
        var ct = aiCall.Begin();
        try
        {
            var snapshot = ApplyEdits(new ActorDocument { Id = actor.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name, Biography = actor.Biography });
            var text = await Ai.RewriteAsync(ForAi(snapshot), campaign, system,
                audience == AiAudience.Dm ? editDmNotes : editBiography,
                audience == AiAudience.Dm ? dmInstruction : bioInstruction,
                audience, currentUserId, ct);
            // The model's text replaces the box; what was there before can be had back from the toast (U3).
            var previous = audience == AiAudience.Dm ? editDmNotes : editBiography;
            var forActor = actor.Id;
            if (audience == AiAudience.Dm) editDmNotes = text; else editBiography = text;
            flash = Flash.Undoable(L["Actor.Sheet.AiDraftReady"], () =>
            {
                if (actor?.Id != forActor)
                {
                    flash = Flash.Error(L["Common.UndoGone"]);
                    return Task.CompletedTask;
                }

                if (audience == AiAudience.Dm) editDmNotes = previous; else editBiography = previous;
                flash = Flash.Info(L["Common.Undone"]);
                return Task.CompletedTask;
            });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            flash = Flash.Info(L["Common.Ai.Stopped"]);
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error(L["Actor.Sheet.NoAiProvider"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI rewrite failed for actor {ActorId}", ActorId);
            flash = Flash.Error(L["Actor.Sheet.AiDraftFailed", AiFailureText.For(L, ex)]);
        }
        finally
        {
            aiCall.End(ct);
            busy = null;
        }
    }

    private async Task SuggestLevelUpAsync()
    {
        if (actor == null || campaign == null || currentUserId == null || busy != null) return;
        busy = "level";
        var ct = aiCall.Begin();
        try
        {
            var snapshot = ApplyEdits(new ActorDocument { Id = actor.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name });
            levelUpAdvice = await Ai.LevelUpAsync(ForAi(snapshot), campaign, system, currentUserId, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            flash = Flash.Info(L["Common.Ai.Stopped"]);
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error(L["Actor.Sheet.NoAiProvider"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI level-up failed for actor {ActorId}", ActorId);
            flash = Flash.Error(L["Actor.Sheet.AiSuggestFailed", AiFailureText.For(L, ex)]);
        }
        finally
        {
            aiCall.End(ct);
            busy = null;
        }
    }

    public void Dispose() => aiCall.Dispose();

    // ---- Level up (U4): what the next level brings, from a copy of the sheet at that level, before it is taken. ----

    private LevelUpPlan? levelUpPlan;
    private LevelUpPlan? levelUpDone;
    private int? levelUpRoll;

    private void OpenLevelUp()
    {
        levelUpDone = null;
        levelUpRoll = null;
        levelUpClassId = evaluation?.Classes.FirstOrDefault(c => c.IsFirst)?.Id ?? "";
        PlanLevelUp();
    }

    private void CloseLevelUp()
    {
        levelUpPlan = null;
        levelUpRoll = null;
    }

    private void ChooseLevelUpClass(string? classId)
    {
        levelUpClassId = classId ?? "";
        PlanLevelUp();
    }

    /// <summary>Works out the next level on a copy: the sheet itself changes only when the level is taken.</summary>
    private void PlanLevelUp()
    {
        if (engine == null || evaluation == null || Rules == null || AtMaxLevel)
        {
            levelUpPlan = null;
            return;
        }

        var sheet = new Dictionary<string, object>(editSheet);
        RaiseLevel(sheet);
        engine.ApplyInherited(sheet);
        engine.ApplyAttributeTotals(sheet);
        var after = engine.Evaluate(sheet);
        var level = YamlValues.GetInt(sheet, LevelField!) ?? CurrentLevel + 1;

        ContentEntry? cls;
        ContentEntry? subclass;
        int classLevel;
        if (after.Classes.Count > 0)
        {
            var gaining = after.Classes.FirstOrDefault(c => c.Id == levelUpClassId) ?? after.Classes.First(c => c.IsFirst);
            (cls, subclass, classLevel) = (gaining.Entry, gaining.Subclass, gaining.Level);
        }
        else
        {
            // Without class levels the character level is the class's.
            var classField = Rules.Multiclass?.ClassField ?? system?.FieldRoles.Class;
            var type = system?.ActorFields.FirstOrDefault(f => f.Key == classField)?.TargetEntityType ?? classField;
            cls = classField != null && type != null && YamlValues.GetString(sheet, classField) is { Length: > 0 } classId ? ContentRegistry.GetEntry(campaign!.SystemId, type, classId) : null;
            subclass = null;
            classLevel = level;
        }

        levelUpPlan = LevelUpPlan.Build(Rules, evaluation, after, level,
            cls == null ? null : ContentRegistry.Localize(cls, L.Culture.Name), classLevel,
            subclass == null ? null : ContentRegistry.Localize(subclass, L.Culture.Name),
            Rules.Skills?.BonusKey ?? Rules.Spellcasting?.BonusKey);
    }

    /// <summary>The level on <paramref name="sheet"/> one higher: the character level, and the class gaining it when it is not the
    /// first (the first class gets whatever the others don't take, so only another class is written down). A rolled hit die
    /// goes with it.</summary>
    private void RaiseLevel(Dictionary<string, object> sheet)
    {
        var level = (YamlValues.GetInt(sheet, LevelField!) ?? 1) + 1;
        sheet[LevelField!] = (long)level;
        if (Rules?.Multiclass is { } multiclass && evaluation?.Classes.FirstOrDefault(c => c.IsFirst) is { } first
            && !string.IsNullOrEmpty(levelUpClassId) && levelUpClassId != first.Id)
        {
            var classes = SheetRuleEngine.ParseClassLevels(sheet, multiclass.Key);
            var index = classes.FindIndex(c => c.Id == levelUpClassId);
            if (index >= 0) classes[index] = classes[index] with { Level = classes[index].Level + 1 };
            else classes.Add(new OtherClass(levelUpClassId, 1));
            sheet[multiclass.Key] = classes.Select(SheetRuleEngine.FormatClassLevel).Cast<object>().ToList();
        }

        if (levelUpRoll is { } roll && Rules?.HitPoints is { } hp)
        {
            var rolls = SheetRuleEngine.RawList(sheet, hp.RollsKey);
            while (rolls.Count < level - 1) rolls.Add("0");
            rolls[level - 2] = roll.ToString(System.Globalization.CultureInfo.InvariantCulture);
            sheet[hp.RollsKey] = rolls.Cast<object>().ToList();
        }
    }

    private void SetLevelUpRoll(int? roll)
    {
        levelUpRoll = roll;
        PlanLevelUp();
    }

    private void RollLevelUpHitDie(int die)
    {
        levelUpRoll = RuntimeManager.DiceRollerFor(campaign?.SystemId ?? string.Empty).Roll($"1d{die}").Total;
        PlanLevelUp();
    }

    private void ApplyLevelUp()
    {
        if (AtMaxLevel || levelUpPlan is not { } taken) return;
        RaiseLevel(editSheet);
        levelUpPlan = null;
        Reevaluate();
        levelUpDone = taken;
        levelUpRoll = null;
        levelUpClassId = evaluation?.Classes.FirstOrDefault(c => c.IsFirst)?.Id ?? "";
        flash = Flash.Info(L["Actor.Sheet.LevelSet", CurrentLevel]);
    }

    private void AppendAdviceToNotes()
    {
        if (levelUpAdvice == null) return;
        var key = schema?.Fields.FirstOrDefault(f => f.Type == FieldType.LongText)?.Key ?? "notes";
        var existing = YamlValues.GetString(editSheet, key) ?? string.Empty;
        editSheet[key] = (existing.TrimEnd() + "\n\n" + L["Actor.Sheet.LevelPlan", CurrentLevel + 1] + "\n" + levelUpAdvice).Trim();
        levelUpAdvice = null;
        flash = Flash.Info(L["Actor.Sheet.AddedNotes"]);
    }
