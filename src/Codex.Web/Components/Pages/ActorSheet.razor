    private async Task RewriteAsync(AiAudience audience)
    {
        if (actor == null || campaign == null || currentUserId == null || busy != null) return;
        busy = audience == AiAudience.Dm ? "dm" : "bio";
        var ct = aiCall.Begin();
        try
        {
            var snapshot = ApplyEdits(new ActorDocument { Id = actor.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name, Biography = actor.Biography });
            var text = await Ai.RewriteAsync(ForAi(snapshot), campaign, system,
                audience == AiAudience.Dm ? editDmNotes : editBiography,
                audience == AiAudience.Dm ? dmInstruction : bioInstruction,
                audience, currentUserId, ct);
            // The model's text replaces the box; what was there before can be had back from the toast (U3).
            var previous = audience == AiAudience.Dm ? editDmNotes : editBiography;
            var forActor = actor.Id;
            if (audience == AiAudience.Dm) editDmNotes = text; else editBiography = text;
            flash = Flash.Undoable(L["Actor.Sheet.AiDraftReady"], () =>
            {
                if (actor?.Id != forActor)
                {
                    flash = Flash.Error(L["Common.UndoGone"]);
                    return Task.CompletedTask;
                }

                if (audience == AiAudience.Dm) editDmNotes = previous; else editBiography = previous;
                flash = Flash.Info(L["Common.Undone"]);
                return Task.CompletedTask;
            });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            flash = Flash.Info(L["Common.Ai.Stopped"]);
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error(L["Actor.Sheet.NoAiProvider"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI rewrite failed for actor {ActorId}", ActorId);
            flash = Flash.Error(L["Actor.Sheet.AiDraftFailed", AiFailureText.For(L, ex)]);
        }
        finally
        {
            aiCall.End(ct);
            busy = null;
        }
    }

    private async Task SuggestLevelUpAsync()
    {
        if (actor == null || campaign == null || currentUserId == null || busy != null) return;
        busy = "level";
        var ct = aiCall.Begin();
        try
        {
            var snapshot = ApplyEdits(new ActorDocument { Id = actor.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name });
            levelUpAdvice = await Ai.LevelUpAsync(ForAi(snapshot), campaign, system, currentUserId, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            flash = Flash.Info(L["Common.Ai.Stopped"]);
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error(L["Actor.Sheet.NoAiProvider"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI level-up failed for actor {ActorId}", ActorId);
            flash = Flash.Error(L["Actor.Sheet.AiSuggestFailed", AiFailureText.For(L, ex)]);
        }
        finally
        {
            aiCall.End(ct);
            busy = null;
        }
    }

