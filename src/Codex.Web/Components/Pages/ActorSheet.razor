@page "/campaigns/{CampaignId}/actors/{ActorId}"
@using System.Security.Claims
@using Codex.Core
@using Codex.Core.AI
@using Codex.Core.Rules
@using Codex.Core.Systems
@using Codex.Persistence
@using Codex.Persistence.Runtime
@using Codex.Plugin.Abstractions
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject IActorRepository ActorRepo
@inject CampaignRuntimeManager RuntimeManager
@inject ICampaignAccessResolver AccessResolver
@inject IContentRegistry ContentRegistry
@inject ISystemCatalog SystemCatalog
@inject ComponentRegistry Components
@inject CampaignLibrary Library
@inject IMediaStore Media
@inject AiFeatures Ai
@inject ILogger<ActorSheet> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>@(actor?.Name ?? "Character") | TTRPG.Codex</PageTitle>

@if (loading)
{
    <LoadingSkeleton />
}
else if (campaign == null || actor == null || access == null)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="user" Size="28" /></div>
        <h1 class="h4">Character not found</h1>
        <p>It may not exist, or you may not have access to it.</p>
        <a href="/" class="cx-btn cx-plaque">Back to campaigns</a>
    </div>
}
else
{
    <div class="sheet-plate" data-testid="sheet-plate">
        <div class="plate-top">
            <div class="plate-id">
                <div class="portrait-wrap">
                    <ActorAvatar Actor="actor" DisplayName="@DisplayName" Size="lg" Alt="@($"Portrait of {DisplayName}")" />
                    @if (CanEdit)
                    {
                        <label class="portrait-upload" title="Upload a portrait">
                            <LucideIcon IconName="camera" Size="14" /><span class="visually-hidden">Upload a portrait (PNG, JPEG or WebP, up to 6 MB)</span>
                            <InputFile OnChange="UploadPortraitAsync" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" class="visually-hidden" />
                        </label>
                    }
                </div>
                <div class="min-w-0">
                    <nav aria-label="Breadcrumb" class="breadcrumb-nav"><a href="/">Campaigns</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId">@campaign.Name</a><span class="crumb-sep" aria-hidden="true">/</span><a href="/campaigns/@CampaignId/cast">Cast</a></nav>
                    <h1 data-testid="actor-name">@DisplayName</h1>
                    <div class="plate-plaques">
                        <span class="pill">@KindLabel</span>
                        @if (access.IsDm)
                        {
                            <span class="pill @(actor.Visibility == ActorVisibility.Known ? "pill-success" : "pill-warning")">@VisibilityLabel</span>
                        }
                        @if (!string.IsNullOrEmpty(actor.BlueprintId))
                        {
                            <span class="pill">From @actor.BlueprintId.Split(':').Last()</span>
                        }
                        @foreach (var plaque in PlatePlaques())
                        {
                            <span class="pill pill-accent">@plaque</span>
                        }
                        @if (CanEdit && actor.HasPortrait)
                        {
                            <button type="button" class="pill pill-button" @onclick="RemovePortraitAsync"><LucideIcon IconName="x" Size="12" /> Remove portrait</button>
                        }
                    </div>
                </div>
            </div>
            @if (CanEdit)
            {
                <div class="plate-save">
                    @if (DirtyCount > 0)
                    {
                        <span class="dirty-note" role="status" data-testid="sheet-dirty">@DirtyCount unsaved @(DirtyCount == 1 ? "change" : "changes")</span>
                    }
                    <CodexButton Variant="CodexButtonVariant.Plaque" Icon="check" OnClick="SaveAsync" data-testid="sheet-save">Save changes</CodexButton>
                </div>
            }
        </div>
        <div class="stat-strip" role="list" aria-label="Key numbers">
            @if (system?.PrimaryResource is { } vital)
            {
                var hpNow = YamlValues.GetInt(editSheet, vital.Key) ?? 0;
                var hpMax = vital.MaxKey != null ? YamlValues.GetInt(editSheet, vital.MaxKey) ?? 0 : 0;
                var hpPct = hpMax > 0 ? Math.Clamp(100.0 * hpNow / hpMax, 0, 100) : 0;
                var hpBand = hpPct < 25 ? "hp-low" : hpPct < 50 ? "hp-mid" : "hp-high";
                <div class="stat-cell stat-hp" role="listitem">
                    <span class="stat-label">@vital.Label</span>
                    <span class="stat-value" data-testid="plate-hp">@hpNow@(hpMax > 0 ? $" / {hpMax}" : "")</span>
                    @if (hpMax > 0)
                    {
                        <div class="hp-bar @hpBand" role="progressbar" aria-label="@vital.Label" aria-valuemin="0" aria-valuemax="@hpMax" aria-valuenow="@hpNow">
                            <span style="width:@(hpPct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                        </div>
                    }
                </div>
            }
            @if (Rules?.ArmorClass is { } plateAc)
            {
                <div class="stat-cell stat-ac" role="listitem">
                    <span class="stat-label">AC</span>
                    <span class="stat-value" data-testid="plate-ac">@(evaluation?.ArmorClass is { Active: true } acSummary ? acSummary.Total : YamlValues.GetInt(editSheet, plateAc.Key) ?? 10)</span>
                </div>
            }
            @foreach (var stat in PlateStats())
            {
                <div class="stat-cell" role="listitem">
                    <span class="stat-label">@stat.Label</span>
                    <span class="stat-value">@stat.Value</span>
                </div>
            }
        </div>
    </div>

    <StatusMessage Message="flash" OnDismiss="() => flash = null" />

    @if (!string.IsNullOrEmpty(actor.BlueprintId) && ContentRegistry.GetActor(actor.BlueprintId) == null)
    {
        <div class="status" role="note">
            <LucideIcon IconName="alert-triangle" Size="18" />
            <span>Missing content: this character came from “@actor.BlueprintId”, which isn't in a loaded pack. The sheet still works.</span>
        </div>
    }

    @if (!CanEdit)
    {
        <p class="small-muted">Only the owner and the DM can edit this sheet.</p>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            @if (evaluation != null && evaluation.HasViolations && CanEdit)
            {
                <section class="panel panel-warn" aria-labelledby="rules-heading" data-testid="rule-violations">
                    <div class="panel-title">
                        <h2 id="rules-heading" class="h5"><LucideIcon IconName="alert-triangle" Size="16" Class="title-icon" /> Rules</h2>
                        <span class="pill @(Enforcement == "strict" ? "pill-danger" : "pill-warning")">@(Enforcement == "strict" ? (access.IsDm ? "Strict (you can override)" : "Strict: fix before saving") : "Warnings only")</span>
                    </div>
                    <ul class="mb-0 small">
                        @foreach (var violation in evaluation.Violations)
                        {
                            <li>@violation.Message</li>
                        }
                    </ul>
                </section>
            }

            @if (evaluation != null && evaluation.Warnings.Count > 0)
            {
                <section class="panel" aria-labelledby="warnings-heading" data-testid="rule-warnings">
                    <div class="panel-title">
                        <h2 id="warnings-heading" class="h5"><LucideIcon IconName="info" Size="16" Class="title-icon" /> Worth a look</h2>
                        <span class="pill">Doesn't block saving</span>
                    </div>
                    <ul class="mb-0 small">
                        @foreach (var warning in evaluation.Warnings)
                        {
                            <li>@warning.Message</li>
                        }
                    </ul>
                </section>
            }

            <nav class="sheet-tabs" aria-label="Sheet sections" data-testid="sheet-tabs">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="sheet-tab" aria-current="@(ActiveTab == tab.Key ? "page" : null)" data-testid="@("tab-" + tab.Key)" @onclick="() => activeTab = tab.Key">
                        <LucideIcon IconName="@tab.Icon" Size="16" /> @tab.Label
                    </button>
                }
            </nav>

            @if (ActiveTab == "attributes")
            {
            @if (system != null && system.Attributes.Count > 0)
            {
                var attributeRules = Rules?.Attributes;
                var summary = evaluation?.Attributes;
                <section class="panel" aria-labelledby="attributes-heading">
                    <div class="panel-title">
                        <h2 id="attributes-heading" class="h5"><LucideIcon IconName="zap" Size="16" Class="title-icon" /> Attributes</h2>
                        @if (attributeRules != null && CanEdit)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <label for="attr-method" class="field-label">Method</label>
                                <select id="attr-method" class="field-select field-sm" value="@AttrMethod" @onchange="e => SetMethod(e.Value?.ToString())" data-testid="attr-method">
                                    @foreach (var method in AvailableMethods)
                                    {
                                        <option value="@method">@MethodLabel(method)</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    @if (attributeRules != null && summary != null && AttrMethod == "point-buy" && attributeRules.PointBuy != null)
                    {
                        <p class="small mb-2 @(summary.PointsSpent > summary.PointsBudget ? "text-danger fw-semibold" : "small-muted")" data-testid="point-buy-summary">
                            Point buy: <strong>@summary.PointsSpent</strong> of @summary.PointsBudget points spent. Scores run from @attributeRules.PointBuy.Min to @attributeRules.PointBuy.Max before bonuses.
                        </p>
                    }
                    else if (attributeRules != null && AttrMethod == "standard-array" && attributeRules.StandardArray.Count > 0)
                    {
                        <p class="small small-muted mb-2">Standard array: assign @string.Join(", ", attributeRules.StandardArray), one score per attribute.</p>
                    }

                    <div class="attr-grid">
                        @foreach (var attr in system.Attributes)
                        {
                            var total = summary?.Totals.GetValueOrDefault(attr.Key) ?? (YamlValues.GetInt(editSheet, attr.Key) ?? attr.Default);
                            var baseScore = attributeRules != null ? (YamlValues.GetInt(editSheet, SheetRuleEngine.BasePrefix + attr.Key) ?? attr.Default) : total;
                            var bonus = summary?.Bonuses.GetValueOrDefault(attr.Key) ?? 0;
                            var increase = summary?.Increases.GetValueOrDefault(attr.Key) ?? 0;
                            var modifier = Modifier(attr, total);
                            var modifierText = modifier == null ? null : (modifier >= 0 ? "+" : "") + modifier;
                            var inputId = "attr-input-" + attr.Key;
                            var testId = "attr-" + attr.Key;
                            var invalid = evaluation?.Violations.Any(v => v.FieldKey == attr.Key) == true;
                            <div class="attr-box @(invalid ? "attr-invalid" : "")">
                                <div class="attr-label" id="@("attr-" + attr.Key)">@(attr.Abbreviation ?? attr.Label)</div>
                                @if (modifierText != null)
                                {
                                    <div class="attr-mod" aria-label="@(attr.Label + " modifier")">@modifierText</div>
                                }
                                @if (CanEdit && attributeRules != null && AttrMethod == "standard-array")
                                {
                                    <div class="attr-medallion">
                                    <label for="@inputId" class="visually-hidden">@(attr.Label + " score")</label>
                                    <select id="@inputId" class="field-select field-sm" value="@baseScore" data-testid="@testId" @onchange="e => SetBase(attr, e.Value?.ToString())">
                                        @foreach (var value in attributeRules.StandardArray.Distinct().OrderByDescending(v => v))
                                        {
                                            <option value="@value">@value</option>
                                        }
                                    </select>
                                    </div>
                                }
                                else if (CanEdit)
                                {
                                    var min = attributeRules != null && AttrMethod == "point-buy" ? attributeRules.PointBuy?.Min : attr.Min;
                                    var max = attributeRules != null && AttrMethod == "point-buy" ? attributeRules.PointBuy?.Max : attr.Max;
                                    <div class="attr-medallion">
                                    <label for="@inputId" class="visually-hidden">@(attr.Label + " score")</label>
                                    <input id="@inputId" type="number" class="field-input field-sm" min="@min" max="@max"
                                           value="@baseScore" data-testid="@testId"
                                           @onchange="e => SetBase(attr, e.Value?.ToString())" />
                                    </div>
                                }
                                else
                                {
                                    <div class="attr-medallion attr-score">@total</div>
                                }
                                @if (attributeRules != null && (bonus != 0 || increase != 0 || CanEdit))
                                {
                                    <div class="attr-total small-muted" data-testid="@(testId + "-total")">@TotalText(baseScore, bonus, increase, total)</div>
                                }
                            </div>
                        }
                    </div>

                    @if (attributeRules?.Bonuses is { } bonusRules && summary != null)
                    {
                        <div class="mt-3" data-testid="attr-bonuses">
                            <div class="field-label">@bonusRules.Label</div>
                            @if (summary.EligibleBonusAttributes.Count == 0)
                            {
                                <p class="small-muted mb-0">Choose a @(system.ActorFields.FirstOrDefault(f => f.Key == bonusRules.FromField)?.Label.ToLowerInvariant() ?? bonusRules.FromField) under Sheet to unlock its bonuses.</p>
                            }
                            else
                            {
                                <p class="small-muted mb-2">Spread as @string.Join(" or ", bonusRules.Allocations.Select(a => string.Join("/", a.Select(v => "+" + v)))) across: @string.Join(", ", summary.EligibleBonusAttributes.Select(k => system.Attributes.First(a => a.Key == k).Label)).</p>
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var key in summary.EligibleBonusAttributes)
                                    {
                                        var attr = system.Attributes.First(a => a.Key == key);
                                        var bonusId = "bonus-" + key;
                                        <div>
                                            <label for="@bonusId" class="field-label">@attr.Label</label>
                                            <select id="@bonusId" class="field-select field-sm" value="@(summary.Bonuses.GetValueOrDefault(key))" disabled="@(!CanEdit)" data-testid="@bonusId" @onchange="e => SetBonus(attr, e.Value?.ToString())">
                                                <option value="0">—</option>
                                                @foreach (var value in bonusRules.Allocations.SelectMany(a => a).Distinct().OrderBy(v => v))
                                                {
                                                    <option value="@value">+@value</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (attributeRules?.Increases is { } increaseRules && evaluation != null)
                    {
                        <div class="mt-3" data-testid="attr-increases">
                            <div class="field-label">@increaseRules.Label</div>
                            @if (evaluation.Increases.Count == 0)
                            {
                                <p class="small-muted mb-0">None yet. Picks that raise scores, such as Ability Score Improvement, show up here once you add them under Picks.</p>
                            }
                            @foreach (var grant in evaluation.Increases)
                            {
                                var targets = PointTargets(grant);
                                <div class="mb-2" data-testid="increase-@grant.Pick.Index">
                                    <div class="small fw-semibold">@grant.Pick.Entry.Name <span class="small-muted fw-normal">· @grant.Points point@(grant.Points == 1 ? "" : "s")@(grant.Cap.HasValue ? $", up to {grant.Cap}" : "")</span></div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @for (var point = 0; point < grant.Points; point++)
                                        {
                                            var pointIndex = point;
                                            var selectId = $"inc-{grant.Pick.Index}-{pointIndex}";
                                            <div>
                                                <label for="@selectId" class="field-label">+1 to<span class="visually-hidden"> (@grant.Pick.Entry.Name, point @(pointIndex + 1) of @grant.Points)</span></label>
                                                <select id="@selectId" class="field-select field-sm" value="@targets[pointIndex]" disabled="@(!CanEdit)" data-testid="@selectId"
                                                        @onchange="e => SetIncreasePoint(increaseRules, grant, pointIndex, e.Value?.ToString())">
                                                    <option value="">Choose…</option>
                                                    @foreach (var key in grant.Options)
                                                    {
                                                        <option value="@key">@system.Attributes.First(a => a.Key == key).Label</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (evaluation != null && evaluation.Derived.Count > 0)
                    {
                        <dl class="prop-list mt-3 mb-0" data-testid="derived-fields">
                            @foreach (var derived in Rules!.Derived)
                            {
                                if (!evaluation.Derived.TryGetValue(derived.Key, out var value)) continue;
                                <dt>@derived.Label</dt>
                                <dd data-testid="derived-@derived.Key">@FormatSigned(value)</dd>
                            }
                        </dl>
                    }
                </section>
            }

            @if (Rules?.Skills is { } skillRules && evaluation is { Skills.Count: > 0 })
            {
                <SkillsPanel Rules="skillRules" Evaluation="evaluation" Sheet="editSheet" Attributes="system!.Attributes" CanEdit="CanEdit" Changed="OnRulesInputChanged" />
            }

            <section class="panel" aria-labelledby="sheet-heading">
                <div class="panel-title"><h2 id="sheet-heading" class="h5"><LucideIcon IconName="file-text" Size="16" Class="title-icon" /> Sheet</h2></div>
                <div class="mb-3">
                    <label for="actor-name-input" class="field-label">Name</label>
                    <input id="actor-name-input" class="field-input" @bind="editName" disabled="@(!CanEdit)" data-testid="sheet-name" />
                </div>
                @if (schema != null)
                {
                    <SchemaForm Schema="schema" Values="editSheet" ReferenceOptions="referenceOptions" FieldOptions="fieldOptions" HiddenKeys="HiddenNow" ReadOnly="@(!CanEdit)" ValuesChanged="OnSheetChanged" />
                }
                else if (editSheet.Count > 0)
                {
                    <dl class="prop-list mb-0">
                        @foreach (var entry in editSheet)
                        {
                            <dt>@entry.Key</dt>
                            <dd>@entry.Value</dd>
                        }
                    </dl>
                }
                else
                {
                    <p class="small-muted mb-0">No attributes recorded, and the system “@campaign.SystemId” declares no sheet.</p>
                }
            </section>

            @if (Rules?.Multiclass is { } multiclass && evaluation != null)
            {
                <section class="panel" aria-labelledby="classes-heading" data-testid="multiclass">
                    <div class="panel-title">
                        <h2 id="classes-heading" class="h5"><LucideIcon IconName="layers" Size="16" Class="title-icon" /> Classes</h2>
                        <span class="pill">Level @CurrentLevel in all</span>
                    </div>
                    @if (evaluation.Classes.Count == 0)
                    {
                        <p class="small-muted mb-0">Choose a class under Sheet first. You can add more classes here afterwards.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-2">
                            @foreach (var cls in evaluation.Classes)
                            {
                                var classId = cls.Id;
                                var levelInputId = "class-level-" + classId;
                                <li class="list-row py-1" data-testid="class-row">
                                    <span>
                                        <a href="/campaigns/@CampaignId/library/@(cls.Entry?.Type ?? "class")/@Uri.EscapeDataString(classId)" class="fw-semibold">@(cls.Entry?.Name ?? classId)</a>
                                        @if (cls.IsFirst)
                                        {
                                            <span class="small-muted"> · first class</span>
                                        }
                                        @if (cls.Subclass != null)
                                        {
                                            <span class="small-muted"> · @cls.Subclass.Name</span>
                                        }
                                    </span>
                                    @if (cls.IsFirst || !CanEdit)
                                    {
                                        <span data-testid="class-level-@classId">@cls.Level level@(cls.Level == 1 ? "" : "s")</span>
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center gap-2">
                                            <label for="@levelInputId" class="visually-hidden">@(cls.Entry?.Name ?? classId) levels</label>
                                            <input id="@levelInputId" type="number" min="1" max="@CurrentLevel" class="field-input field-sm" value="@cls.Level" data-testid="class-level-@classId"
                                                   @onchange="e => SetClassLevel(multiclass, classId, e.Value?.ToString())" />
                                            <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Icon="x" Label="@($"@(")"Remove " + (cls.Entry?.Name ?? classId))" OnClick="() => RemoveClass(multiclass, classId)" />
                                        </span>
                                    }
                                </li>
                                @if (CanEdit && !cls.IsFirst && multiclass.SubclassField != null && cls.Level >= multiclass.SubclassLevel)
                                {
                                    var subclassId = "class-subclass-" + classId;
                                    <li class="py-1">
                                        <label for="@subclassId" class="field-label">@(cls.Entry?.Name ?? classId) subclass</label>
                                        <select id="@subclassId" class="field-select field-sm" value="@(cls.SubclassId ?? "")" data-testid="@subclassId"
                                                @onchange="e => SetClassSubclass(multiclass, classId, e.Value?.ToString())">
                                            <option value="">None yet</option>
                                            @foreach (var option in SubclassOptions(classId))
                                            {
                                                <option value="@option.Id">@option.Name</option>
                                            }
                                        </select>
                                    </li>
                                }
                            }
                        </ul>
                        @if (CanEdit)
                        {
                            var firstLevel = evaluation.Classes.FirstOrDefault(c => c.IsFirst)?.Level ?? 0;
                            <div class="d-flex gap-2 align-items-end flex-wrap">
                                <div>
                                    <label for="add-class" class="field-label">Add a class</label>
                                    <select id="add-class" class="field-select field-sm" @bind="newClassId" data-testid="add-class-select">
                                        <option value="">Choose…</option>
                                        @foreach (var option in evaluation.MulticlassOptions)
                                        {
                                            <option value="@option.Id">@option.Name</option>
                                        }
                                    </select>
                                </div>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Disabled="@(string.IsNullOrEmpty(newClassId) || firstLevel <= 1)" OnClick="() => AddClass(multiclass)" data-testid="add-class">Add</CodexButton>
                            </div>
                            <p class="field-hint">A new class takes one level from your first class@(firstLevel <= 1 ? " (raise the character level first)" : ""). Only classes whose prerequisites your scores meet are listed.</p>
                        }
                    }
                </section>
            }


            @if (linkedEntries.Count > 0)
            {
                <section class="panel" aria-labelledby="linked-heading">
                    <div class="panel-title"><h2 id="linked-heading" class="h5"><LucideIcon IconName="book-open" Size="16" Class="title-icon" /> From the Library</h2></div>
                    @foreach (var (label, item) in linkedEntries)
                    {
                        <div class="mb-3">
                            <div class="label-caps">@label</div>
                            <a href="/campaigns/@CampaignId/library/@item.Entry.Type/@Uri.EscapeDataString(item.Entry.Id)" class="fw-semibold">@item.Entry.Name</a>
                            <div class="small">@TextFormatting.Summary(item.Entry.Description, 200)</div>
                        </div>
                    }
                </section>
            }
            }

            @if (ActiveTab == "picks")
            {
            @if (Rules != null && Rules.Lists.Count > 0 && evaluation != null)
            {
                <section class="panel" aria-labelledby="picks-heading">
                    <div class="panel-title"><h2 id="picks-heading" class="h5"><LucideIcon IconName="sparkles" Size="16" Class="title-icon" /> Picks</h2></div>
                    @foreach (var list in Rules.Lists)
                    {
                        <div class="mb-3">
                            <EntryListPicker Rule="list"
                                             Picks="evaluation.ListPicks.GetValueOrDefault(list.Key) ?? Array.Empty<SheetPick>()"
                                             Options="evaluation.ListOptions.GetValueOrDefault(list.Key) ?? Array.Empty<ContentEntry>()"
                                             Limit="evaluation.ListLimits.GetValueOrDefault(list.Key)"
                                             ReadOnly="@(!CanEdit)"
                                             LibraryPath="@($"/campaigns/{CampaignId}/library")"
                                             Type="system?.FindType(list.TargetEntityType)"
                                             Added="id => AddPick(list, id)"
                                             Removed="index => RemovePick(list, index)"
                                             Note="PickNote" />
                        </div>
                    }
                </section>
            }

            }

            @if (ActiveTab == "inventory")
            {
            @if (Rules?.Inventory is { } inventoryRules && evaluation != null)
            {
                <InventoryPanel Rules="inventoryRules" Items="evaluation.Inventory" Options="inventoryOptions" FindType="type => system?.FindType(type)" Sheet="editSheet" CanEdit="CanEdit"
                                LibraryPath="@($"/campaigns/{CampaignId}/library")" Changed="OnRulesInputChanged" />
            }

            }

            @if (ActiveTab == "history")
            {
            <section class="panel" aria-labelledby="bio-heading">
                <div class="panel-title">
                    <h2 id="bio-heading" class="h5"><LucideIcon IconName="feather" Size="16" Class="title-icon" /> History</h2>
                    @if (CanEdit)
                    {
                        <span class="pill"><LucideIcon IconName="users" Size="12" /> Visible to whoever can see this character</span>
                    }
                </div>
                @if (CanEdit)
                {
                    <label for="actor-bio" class="visually-hidden">History</label>
                    <textarea id="actor-bio" class="field-input mb-2" rows="8" placeholder="Where they came from, what they want, who they owe…" @bind="editBiography" @bind:event="oninput" data-testid="sheet-biography"></textarea>
                    <div class="ai-row">
                        <label for="bio-instruction" class="visually-hidden">Instruction for the AI</label>
                        <input id="bio-instruction" class="field-input field-sm" placeholder="Optional instruction: “expand into three paragraphs”, “make it grimmer”, “add a rival”…" @bind="bioInstruction" />
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" OnClick="() => RewriteAsync(AiAudience.Players)" Disabled="@(busy != null)">
                            <LucideIcon IconName="sparkles" Size="14" /> @(busy == "bio" ? "Writing…" : string.IsNullOrWhiteSpace(editBiography) ? "Write with AI" : "Rewrite with AI")
                        </CodexButton>
                    </div>
                    <p class="field-hint">The AI sees the sheet and this text. Save changes to keep the result.</p>
                }
                else if (!string.IsNullOrWhiteSpace(actor.Biography))
                {
                    <div class="rules-text mb-0">@((MarkupString)TextFormatting.ToHtml(actor.Biography))</div>
                }
                else
                {
                    <p class="small-muted mb-0">No history written yet.</p>
                }
            </section>

            }

            @if (ActiveTab == "notes")
            {
            @if (access.IsDm)
            {
                <section class="panel panel-dm" aria-labelledby="dm-notes-heading">
                    <div class="panel-title">
                        <h2 id="dm-notes-heading" class="h5"><LucideIcon IconName="lock" Size="16" Class="title-icon" /> DM notes</h2>
                        <span class="pill pill-warning"><LucideIcon IconName="eye-off" Size="12" /> Only you</span>
                    </div>
                    <label for="actor-dm-notes" class="visually-hidden">DM notes</label>
                    <textarea id="actor-dm-notes" class="field-input mb-2" rows="6" placeholder="Secret agenda, true identity, how they really feel about the party…" @bind="editDmNotes" @bind:event="oninput" data-testid="sheet-dm-notes"></textarea>
                    <div class="ai-row">
                        <label for="dm-instruction" class="visually-hidden">Instruction for the AI</label>
                        <input id="dm-instruction" class="field-input field-sm" placeholder="Optional instruction: “give them a secret that ties into the party”…" @bind="dmInstruction" />
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" OnClick="() => RewriteAsync(AiAudience.Dm)" Disabled="@(busy != null)">
                            <LucideIcon IconName="sparkles" Size="14" /> @(busy == "dm" ? "Writing…" : "Draft with AI")
                        </CodexButton>
                    </div>
                </section>
            }

            }
        </div>

        <div class="col-lg-4">
            @if (system?.PrimaryResource is { } primary)
            {
                var current = YamlValues.GetInt(editSheet, primary.Key) ?? 0;
                var max = primary.MaxKey != null ? YamlValues.GetInt(editSheet, primary.MaxKey) ?? 0 : 0;
                var pct = max > 0 ? Math.Clamp(100.0 * current / max, 0, 100) : 0;
                var band = pct < 25 ? "hp-low" : pct < 50 ? "hp-mid" : "hp-high";
                <section class="panel" aria-labelledby="vitals-heading">
                    <div class="panel-title"><h2 id="vitals-heading" class="h5"><LucideIcon IconName="heart" Size="16" Class="title-icon" /> @primary.Label</h2></div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="stat-numeral hp-text" data-testid="hp-current">@current</span>
                        @if (max > 0)
                        {
                            <span class="small-muted">/ @max</span>
                        }
                    </div>
                    @if (max > 0)
                    {
                        <div class="hp-bar @band" role="progressbar" aria-label="@primary.Label" aria-valuemin="0" aria-valuemax="@max" aria-valuenow="@current">
                            <span style="width:@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                        </div>
                    }
                    <p class="small-muted mt-2 mb-0">Changes at the live table update this number@(Rules?.HitPoints == null ? "; edit the values under Sheet to set them directly." : ".")</p>
                    @if (Rules?.HitPoints is { } hitPointRules)
                    {
                        <HitPointRulesPanel Rules="hitPointRules" Summary="evaluation?.HitPoints" Sheet="editSheet" CanEdit="CanEdit" Changed="OnRulesInputChanged" />
                    }
                </section>
            }

            @if (Rules?.ArmorClass is { } armorClassRules)
            {
                <ArmorClassPanel Rules="armorClassRules" Summary="evaluation?.ArmorClass" Sheet="editSheet" CanEdit="CanEdit" Changed="OnRulesInputChanged" />
            }

            @if (Rules is { SlotPools.Count: > 0 } && editSheet.Keys.Any(k => Rules.SlotPools.Any(p => p.Owns(k))))
            {
                <section class="panel" aria-labelledby="sheet-slots-heading" data-testid="sheet-slots">
                    <div class="panel-title"><h2 id="sheet-slots-heading" class="h5"><LucideIcon IconName="flame" Size="16" Class="title-icon" /> @SlotTracker.Heading(Rules.SlotPools, editSheet.Keys)</h2></div>
                    <SlotTracker Pools="Rules.SlotPools" Keys="editSheet.Keys.ToList()" Value="key => YamlValues.GetInt(editSheet, key)" ReadOnly="@(!CanEdit)"
                                 OnAdjust="AdjustSlot" OnRest="RestSlots" />
                    <p class="small-muted mt-2 mb-0">During a session, use the Table tab: changes there reach everyone at once. Changes here need Save changes.</p>
                </section>
            }

            @if (CanEdit && HasLevel)
            {
                <section class="panel panel-ai" aria-labelledby="levelup-heading">
                    <div class="panel-title"><h2 id="levelup-heading" class="h5"><LucideIcon IconName="trending-up" Size="16" Class="title-icon" /> Level up</h2></div>
                    <p class="small-muted">Level @CurrentLevel now. Ask what level @(CurrentLevel + 1) brings and which picks fit this character, from the Library's class entry.</p>
                    @if (Rules?.Multiclass != null && evaluation is { Classes.Count: > 0 })
                    {
                        <div class="mb-2">
                            <label for="levelup-class" class="field-label">Class gaining the level</label>
                            <select id="levelup-class" class="field-select field-sm" @bind="levelUpClassId" data-testid="levelup-class">
                                @foreach (var cls in evaluation.Classes)
                                {
                                    <option value="@cls.Id">@(cls.Entry?.Name ?? cls.Id) (level @(cls.Level + 1))</option>
                                }
                                @foreach (var option in evaluation.MulticlassOptions)
                                {
                                    <option value="@option.Id">@option.Name (new, level 1)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="d-flex gap-2 flex-wrap">
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="cx-arcane" OnClick="SuggestLevelUpAsync" Disabled="@(busy != null)" data-testid="sheet-levelup">
                            <LucideIcon IconName="sparkles" Size="14" /> @(busy == "level" ? "Thinking…" : $"Suggest level {CurrentLevel + 1}")
                        </CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="ApplyLevelUp">Set level to @(CurrentLevel + 1)</CodexButton>
                    </div>
                    @if (levelUpAdvice != null)
                    {
                        <div class="ai-output mt-3" data-testid="levelup-advice">
                            <div class="rules-text">@((MarkupString)TextFormatting.ToHtml(levelUpAdvice))</div>
                            <div class="d-flex gap-2">
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => levelUpAdvice = null">Dismiss</CodexButton>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="AppendAdviceToNotes">Keep in notes</CodexButton>
                            </div>
                        </div>
                    }
                </section>
            }

            @if (access.IsDm)
            {
                <section class="panel" aria-labelledby="visibility-heading">
                    <div class="panel-title"><h2 id="visibility-heading" class="h5"><LucideIcon IconName="eye" Size="16" Class="title-icon" /> Visibility to players</h2></div>
                    <div class="mb-2">
                        <label for="actor-visibility" class="field-label">Who sees this character</label>
                        <select id="actor-visibility" class="field-select" @bind="editVisibility">
                            <option value="@ActorVisibility.Hidden">Hidden (players don't know they exist)</option>
                            <option value="@ActorVisibility.Unknown">Seen but not identified</option>
                            <option value="@ActorVisibility.Known">Known</option>
                        </select>
                    </div>
                    @if (editVisibility == ActorVisibility.Unknown)
                    {
                        <div class="mb-2">
                            <label for="actor-public-name" class="field-label">Shown to players as</label>
                            <input id="actor-public-name" class="field-input" @bind="editPublicName" placeholder="e.g. Hooded stranger" />
                        </div>
                    }
                    <div class="mb-2">
                        <label for="actor-kind" class="field-label">Kind</label>
                        <select id="actor-kind" class="field-select" @bind="editKind">
                            <option value="@ActorKind.PlayerCharacter">Player character</option>
                            <option value="@ActorKind.NonPlayerCharacter">Non-player character</option>
                            <option value="@ActorKind.Monster">Monster</option>
                        </select>
                    </div>
                    @if (editKind == ActorKind.PlayerCharacter)
                    {
                        <div class="mb-2">
                            <label for="actor-owner" class="field-label">Played by</label>
                            <select id="actor-owner" class="field-select" @bind="editOwnerId">
                                <option value="">— nobody —</option>
                                @foreach (var member in campaign.Members)
                                {
                                    <option value="@member.UserId">@member.UserId</option>
                                }
                            </select>
                        </div>
                    }
                </section>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;
    [Parameter] public string ActorId { get; set; } = string.Empty;

    private bool loading = true;
    private CampaignDocument? campaign;
    private ActorDocument? actor;
    private CampaignAccess? access;
    private SystemDefinition? system;
    private string? currentUserId;
    private UISchema? schema;
    private HashSet<string> attributeKeys = new();
    private HashSet<string> hiddenKeys = new();
    private Dictionary<string, IReadOnlyList<(string Id, string Name)>> referenceOptions = new();
    private Dictionary<string, IReadOnlyList<(string Id, string Name)>> fieldOptions = new();
    private SheetRuleEngine? engine;
    private SheetEvaluation? evaluation;
    private List<ContentEntry> subclassCandidates = new();
    private IReadOnlyDictionary<string, IReadOnlyList<ContentEntry>> inventoryOptions = new Dictionary<string, IReadOnlyList<ContentEntry>>();
    private List<(string Label, LibraryItem Item)> linkedEntries = new();
    private string editName = "";
    private string editBiography = "";
    private string editDmNotes = "";
    private string bioInstruction = "";
    private string dmInstruction = "";
    private string? levelUpAdvice;
    private string? busy;
    private ActorVisibility editVisibility;
    private string editPublicName = "";
    private ActorKind editKind;
    private string editOwnerId = "";
    private Dictionary<string, object> editSheet = new();
    private Dictionary<string, object> loadedSheet = new();
    private string newClassId = "";
    private string levelUpClassId = "";
    private Flash? flash;
    private Dictionary<string, object> baselineSheet = new();
    private string activeTab = "attributes";

    private string ActiveTab => Tabs.Any(t => t.Key == activeTab) ? activeTab : Tabs[0].Key;

    /// <summary>The sections the sheet offers; a tab appears only when it has something to show.</summary>
    private IReadOnlyList<(string Key, string Label, string Icon)> Tabs
    {
        get
        {
            var tabs = new List<(string, string, string)> { ("attributes", "Attributes", "zap") };
            if (Rules != null && Rules.Lists.Count > 0) tabs.Add(("picks", "Picks", "sparkles"));
            if (Rules?.Inventory != null) tabs.Add(("inventory", "Inventory", "package"));
            tabs.Add(("history", "History", "feather"));
            if (access?.IsDm == true) tabs.Add(("notes", "DM notes", "lock"));
            return tabs;
        }
    }

    /// <summary>Fields changed since the sheet was loaded or last saved, counting the name and the long texts.</summary>
    private int DirtyCount
    {
        get
        {
            if (actor == null) return 0;
            var count = 0;
            if (editName != actor.Name) count++;
            if (editBiography != (actor.Biography ?? "")) count++;
            if (editDmNotes != (actor.DmNotes ?? "")) count++;
            foreach (var key in editSheet.Keys.Union(baselineSheet.Keys))
            {
                editSheet.TryGetValue(key, out var now);
                baselineSheet.TryGetValue(key, out var before);
                if (!Equals(now, before) && now?.ToString() != before?.ToString()) count++;
            }

            return count;
        }
    }

    /// <summary>Class and level, and the species, as plaques on the plate.</summary>
    private IEnumerable<string> PlatePlaques()
    {
        if (evaluation is { Classes.Count: > 0 })
        {
            foreach (var cls in evaluation.Classes) yield return $"{cls.Entry?.Name ?? cls.Id} {cls.Level}";
        }
        else if (HasLevel)
        {
            yield return "Level " + CurrentLevel;
        }
    }

    /// <summary>The derived numbers (initiative, proficiency bonus) and speed, for the plate's stat strip.</summary>
    private IEnumerable<(string Label, string Value)> PlateStats()
    {
        if (Rules != null && evaluation != null)
        {
            foreach (var derived in Rules.Derived)
            {
                if (evaluation.Derived.TryGetValue(derived.Key, out var value)) yield return (derived.Label, FormatSigned(value));
            }
        }

        if (system?.ActorFields.FirstOrDefault(f => f.Key == "speed") is { } speed && YamlValues.GetInt(editSheet, speed.Key) is { } feet)
        {
            yield return (speed.Label.Replace(" (feet)", ""), feet + " ft");
        }
    }

    /// <summary>Hidden fields, plus maximum hit points while the rules work them out (typing there would be overwritten).</summary>
    private IReadOnlySet<string> HiddenNow =>
        Rules?.HitPoints is { } hp && evaluation?.HitPoints is { Active: true } ? new HashSet<string>(hiddenKeys, StringComparer.OrdinalIgnoreCase) { hp.Key } : hiddenKeys;

    private bool CanEdit => access != null && actor != null && (access.IsDm || actor.OwnerUserId == currentUserId);
    private SheetRules? Rules => system?.SheetRules;
    private string Enforcement => SheetRuleEngine.EffectiveEnforcement(system, campaign?.RulesEnforcement);
    private string AttrMethod => (YamlValues.GetString(editSheet, SheetRuleEngine.MethodKey) ?? Rules?.Attributes?.Default ?? "manual").ToLowerInvariant();

    /// <summary>Players pick from the system's methods; the DM may always set scores by hand.</summary>
    private IEnumerable<string> AvailableMethods
    {
        get
        {
            var methods = Rules?.Attributes?.Methods ?? new List<string> { "manual" };
            return access?.IsDm == true ? methods.Append("manual").Distinct() : methods;
        }
    }

    private static string MethodLabel(string method) => method switch
    {
        "point-buy" => "Point buy",
        "standard-array" => "Standard array",
        _ => "Manual"
    };

    private static string FormatSigned(object value) => value is long l && l >= 0 ? "+" + l : value.ToString() ?? string.Empty;
    private bool HasLevel => schema?.Fields.Any(f => f.Key == "level") == true;
    private int CurrentLevel => YamlValues.GetInt(editSheet, "level") ?? 1;

    private string DisplayName => actor == null ? string.Empty
        : access?.IsDm == false && actor.Visibility == ActorVisibility.Unknown && !string.IsNullOrWhiteSpace(actor.PublicName) ? actor.PublicName : actor.Name;

    private string KindLabel => actor?.Kind switch
    {
        ActorKind.PlayerCharacter => "Player character",
        ActorKind.Monster => "Monster",
        _ => "Non-player character"
    };

    private string VisibilityLabel => actor?.Visibility switch
    {
        ActorVisibility.Known => "Known to players",
        ActorVisibility.Unknown => "Seen, not identified",
        _ => "Hidden from players"
    };

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        campaign = await CampaignRepo.GetAsync(CampaignId);
        access = campaign != null && currentUserId != null ? await AccessResolver.ResolveAsync(CampaignId, currentUserId) : null;

        if (campaign != null && access != null)
        {
            actor = await ActorRepo.GetVisibleAsync(ActorId, access);
            if (actor != null)
            {
                system = SystemCatalog.GetDefinition(campaign.SystemId);
                schema = SystemCatalog.GetUISchemas(campaign.SystemId).FirstOrDefault(s => s.EntityType == DataDrivenSystemPlugin.ActorSchemaType);
                attributeKeys = (system?.Attributes.Select(a => a.Key) ?? Enumerable.Empty<string>()).ToHashSet(StringComparer.OrdinalIgnoreCase);
                hiddenKeys = attributeKeys
                    .Concat(attributeKeys.Select(k => SheetRuleEngine.BasePrefix + k))
                    .Concat(attributeKeys.Select(k => SheetRuleEngine.BonusPrefix + k))
                    .Append(SheetRuleEngine.MethodKey)
                    .Concat(system?.SheetRules?.Lists.Select(l => l.Key) ?? Enumerable.Empty<string>())
                    .Concat(system?.SheetRules?.Multiclass is { } mc ? new[] { mc.Key, mc.ClassLevelKey } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.HitPoints is { } hp ? new[] { hp.ModeKey, hp.RollsKey } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.ArmorClass is { } ac ? new[] { ac.Key, ac.ModeKey, ac.MiscField } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.Inventory is { } inv ? new[] { inv.Key } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.Skills is { } sk ? new[] { sk.ProficienciesKey, sk.ExpertiseKey } : Array.Empty<string>())
                    .Concat(system?.SheetRules?.Inherits.Select(i => i.AppliedKey) ?? Enumerable.Empty<string>())
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);

                ActorSheetSync.ApplyStateToSheet(actor, system, Components);
                editName = actor.Name;
                editBiography = actor.Biography ?? "";
                editDmNotes = actor.DmNotes ?? "";
                editVisibility = actor.Visibility;
                editPublicName = actor.PublicName ?? "";
                editKind = actor.Kind;
                editOwnerId = actor.OwnerUserId ?? "";
                editSheet = new Dictionary<string, object>(actor.Sheet);
                loadedSheet = new Dictionary<string, object>(actor.Sheet);

                await LoadReferenceOptionsAsync();
                var resolver = system != null ? await CachedEntryResolver.LoadAsync(Library, campaign, access, system) : null;
                engine = system != null && resolver != null ? new SheetRuleEngine(system, resolver) : null;
                inventoryOptions = Rules?.Inventory?.Types.ToDictionary(
                    type => type,
                    type => (IReadOnlyList<ContentEntry>)(resolver?.Candidates(type).OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase).ToList() ?? new List<ContentEntry>()))
                    ?? new Dictionary<string, IReadOnlyList<ContentEntry>>();
                var subclassType = system?.ActorFields.FirstOrDefault(f => f.Key == Rules?.Multiclass?.SubclassField)?.TargetEntityType;
                subclassCandidates = subclassType == null || resolver == null ? new List<ContentEntry>() : resolver.Candidates(subclassType).ToList();
                Reevaluate();
                baselineSheet = new Dictionary<string, object>(editSheet);
                levelUpClassId = evaluation?.Classes.FirstOrDefault(c => c.IsFirst)?.Id ?? "";
                await LoadLinkedEntriesAsync();
            }
        }

        loading = false;
    }

    /// <summary>Re-runs the rules after any edit: totals, derived values, allowed picker options and violations.</summary>
    private void Reevaluate()
    {
        if (engine == null)
        {
            evaluation = null;
            return;
        }

        engine.ApplyInherited(editSheet);
        engine.ApplyAttributeTotals(editSheet);
        evaluation = engine.Evaluate(editSheet);
        engine.ApplySlotPools(editSheet, evaluation);
        engine.ApplyHitPoints(editSheet, evaluation);
        engine.ApplyArmorClass(editSheet, evaluation);
        fieldOptions = evaluation.AllowedOptions.ToDictionary(
            kv => kv.Key,
            kv => (IReadOnlyList<(string Id, string Name)>)kv.Value.Select(e => (e.Id, e.Name)).ToList());
    }

    private Task OnRulesInputChanged()
    {
        Reevaluate();
        return Task.CompletedTask;
    }

    private Task OnSheetChanged(Dictionary<string, object> _)
    {
        Reevaluate();
        return Task.CompletedTask;
    }

    private void SetMethod(string? method)
    {
        if (string.IsNullOrEmpty(method) || system == null) return;
        editSheet[SheetRuleEngine.MethodKey] = method;
        if (method == "point-buy" && Rules?.Attributes?.PointBuy is { } pointBuy)
        {
            foreach (var attr in system.Attributes)
            {
                var current = YamlValues.GetInt(editSheet, SheetRuleEngine.BasePrefix + attr.Key) ?? attr.Default;
                editSheet[SheetRuleEngine.BasePrefix + attr.Key] = (long)Math.Clamp(current, pointBuy.Min, pointBuy.Max);
            }
        }
        else if (method == "standard-array" && Rules?.Attributes?.StandardArray is { Count: > 0 } array)
        {
            var values = array.OrderByDescending(v => v).ToList();
            for (var i = 0; i < system.Attributes.Count; i++)
            {
                editSheet[SheetRuleEngine.BasePrefix + system.Attributes[i].Key] = (long)values[Math.Min(i, values.Count - 1)];
            }
        }

        Reevaluate();
    }

    private void SetBase(AttributeDefinition attribute, string? raw)
    {
        if (!int.TryParse(raw, out var value)) return;
        if (Rules?.Attributes != null)
        {
            editSheet[SheetRuleEngine.BasePrefix + attribute.Key] = (long)value;
        }
        else
        {
            if (attribute.Min.HasValue) value = Math.Max(attribute.Min.Value, value);
            if (attribute.Max.HasValue) value = Math.Min(attribute.Max.Value, value);
            editSheet[attribute.Key] = (long)value;
        }

        Reevaluate();
    }

    private void SetBonus(AttributeDefinition attribute, string? raw)
    {
        if (!int.TryParse(raw, out var value)) return;
        if (value == 0) editSheet.Remove(SheetRuleEngine.BonusPrefix + attribute.Key);
        else editSheet[SheetRuleEngine.BonusPrefix + attribute.Key] = (long)value;
        Reevaluate();
    }

    private void SetRawList(string key, List<string> raw)
    {
        if (raw.Count == 0) editSheet.Remove(key);
        else editSheet[key] = raw.Cast<object>().ToList();
        Reevaluate();
    }

    private void AddPick(ListRule list, string id) => SetRawList(list.Key, SheetRuleEngine.RawList(editSheet, list.Key).Append(id).ToList());

    private void RemovePick(ListRule list, int index)
    {
        var raw = SheetRuleEngine.RawList(editSheet, list.Key);
        if (index < 0 || index >= raw.Count) return;
        raw.RemoveAt(index);
        SetRawList(list.Key, raw);
    }

    /// <summary>"+1 STR, +1 DEX" after a pick that raised scores.</summary>
    private string? PickNote(SheetPick pick) =>
        pick.Choices.Count == 0 || system == null ? null
            : string.Join(", ", pick.Choices.Select(c => $"+{c.Value} {system.Attributes.FirstOrDefault(a => a.Key.Equals(c.Key, StringComparison.OrdinalIgnoreCase))?.Abbreviation ?? c.Key}"));

    private static string TotalText(int baseScore, int bonus, int increase, int total)
    {
        if (bonus == 0 && increase == 0) return $"total {total}";
        var parts = new List<string> { baseScore.ToString() };
        if (bonus != 0) parts.Add(bonus.ToString());
        if (increase != 0) parts.Add(increase.ToString());
        return string.Join(" + ", parts) + " = " + total;
    }

    /// <summary>Which attribute each of a grant's points goes to, "" where not chosen yet.</summary>
    private static List<string> PointTargets(IncreaseGrant grant)
    {
        var targets = grant.Pick.Choices.SelectMany(c => Enumerable.Repeat(c.Key, Math.Max(c.Value, 0))).ToList();
        while (targets.Count < grant.Points) targets.Add("");
        return targets;
    }

    private void SetIncreasePoint(IncreaseRules rules, IncreaseGrant grant, int point, string? attributeKey)
    {
        var targets = PointTargets(grant);
        if (point >= targets.Count) return;
        targets[point] = attributeKey ?? "";
        var choices = targets.Where(t => t.Length > 0).GroupBy(t => t, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.Count());
        var raw = SheetRuleEngine.RawList(editSheet, rules.FromList);
        if (grant.Pick.Index >= raw.Count) return;
        raw[grant.Pick.Index] = SheetRuleEngine.FormatPick(grant.Pick.Entry.Id, choices);
        SetRawList(rules.FromList, raw);
    }

    private void SetOtherClasses(MulticlassRules rules, List<OtherClass> classes) =>
        SetRawList(rules.Key, classes.Select(SheetRuleEngine.FormatClassLevel).ToList());

    private IEnumerable<ContentEntry> SubclassOptions(string classId) =>
        subclassCandidates
            .Where(c => string.Equals(c.Properties.GetValueOrDefault("class")?.ToString(), classId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase);

    private void SetClassSubclass(MulticlassRules rules, string classId, string? subclassId) =>
        SetOtherClasses(rules, SheetRuleEngine.ParseClassLevels(editSheet, rules.Key).Select(c => c.Id == classId ? c with { Subclass = string.IsNullOrEmpty(subclassId) ? null : subclassId } : c).ToList());

    private void AddClass(MulticlassRules rules)
    {
        if (string.IsNullOrEmpty(newClassId)) return;
        var classes = SheetRuleEngine.ParseClassLevels(editSheet, rules.Key);
        classes.Add(new OtherClass(newClassId, 1));
        newClassId = "";
        SetOtherClasses(rules, classes);
    }

    private void RemoveClass(MulticlassRules rules, string classId) =>
        SetOtherClasses(rules, SheetRuleEngine.ParseClassLevels(editSheet, rules.Key).Where(c => c.Id != classId).ToList());

    private void SetClassLevel(MulticlassRules rules, string classId, string? raw)
    {
        if (!int.TryParse(raw, out var level) || level < 1) return;
        SetOtherClasses(rules, SheetRuleEngine.ParseClassLevels(editSheet, rules.Key).Select(c => c.Id == classId ? c with { Level = level } : c).ToList());
    }

    private void AdjustSlot((string Key, int Delta, string Label) change)
    {
        var maxKey = change.Key + "_Max";
        var max = YamlValues.GetInt(editSheet, maxKey) ?? 0;
        var current = YamlValues.GetInt(editSheet, change.Key) ?? max;
        editSheet[change.Key] = (long)Math.Clamp(current + change.Delta, 0, max);
    }

    private void RestSlots((string Name, List<string> Keys) rest)
    {
        foreach (var key in rest.Keys)
        {
            if (YamlValues.GetInt(editSheet, key + "_Max") is { } max) editSheet[key] = (long)max;
        }

        flash = Flash.Info($"{rest.Name}: slots refilled. Save changes to keep it.");
    }

    private async Task LoadReferenceOptionsAsync()
    {
        referenceOptions = new Dictionary<string, IReadOnlyList<(string, string)>>();
        if (campaign == null || access == null || schema == null) return;
        foreach (var target in schema.Fields.Where(f => f.Type == FieldType.EntityReference && f.TargetEntityType != null).Select(f => f.TargetEntityType!).Distinct())
        {
            referenceOptions[target] = (await Library.OptionsAsync(campaign, access, target)).Select(i => (i.Entry.Id, i.Entry.Name)).ToList();
        }
    }

    private async Task LoadLinkedEntriesAsync()
    {
        linkedEntries = new List<(string, LibraryItem)>();
        if (campaign == null || access == null || schema == null) return;
        foreach (var field in schema.Fields.Where(f => f.Type == FieldType.EntityReference && f.TargetEntityType != null))
        {
            var id = YamlValues.GetString(editSheet, field.Key);
            if (string.IsNullOrEmpty(id)) continue;
            var item = await Library.GetAsync(campaign, access, field.TargetEntityType!, id);
            if (item != null) linkedEntries.Add((field.Label, item));
        }
    }

    private static int? Modifier(AttributeDefinition attribute, int score) =>
        attribute.Modifier == "half-minus-five" ? (int)Math.Floor((score - 10) / 2.0) : null;

    private ActorDocument ApplyEdits(ActorDocument target)
    {
        target.Name = string.IsNullOrWhiteSpace(editName) ? target.Name : editName.Trim();
        engine?.ApplyAttributeTotals(editSheet);
        target.Sheet = new Dictionary<string, object>(editSheet);
        target.Biography = string.IsNullOrWhiteSpace(editBiography) ? null : editBiography.Trim();
        if (access!.IsDm)
        {
            target.DmNotes = string.IsNullOrWhiteSpace(editDmNotes) ? null : editDmNotes.Trim();
            target.Visibility = editVisibility;
            target.PublicName = string.IsNullOrWhiteSpace(editPublicName) ? null : editPublicName.Trim();
            target.Kind = editKind;
            target.OwnerUserId = editKind == ActorKind.PlayerCharacter && !string.IsNullOrEmpty(editOwnerId) ? editOwnerId : (editKind == ActorKind.PlayerCharacter ? target.OwnerUserId : null);
        }

        ActorSheetSync.ApplySheetToState(target, system, Components);
        return target;
    }

    /// <summary>Saves through the live table when there is one (merging with whatever the table changed
    /// since this page loaded), and straight to the actor otherwise. <see cref="loadedSheet"/> is what
    /// tells the merge which fields were edited here.</summary>
    private Task<bool> TrySaveActorAsync() => RuntimeManager.TrySaveActorAsync(actor!, loadedSheet, access!, system);

    private async Task SaveAsync()
    {
        if (actor == null || access == null || campaign == null) return;
        flash = null; // a message from an earlier attempt must not outlive this one
        Reevaluate();
        if (evaluation is { HasViolations: true })
        {
            if (Enforcement == "strict" && !access.IsDm)
            {
                flash = Flash.Error($"Not saved: {evaluation.Violations.Count} rule problem{(evaluation.Violations.Count == 1 ? "" : "s")} to fix first (see Rules above). The DM can relax this under Settings.");
                return;
            }

            if (Enforcement != "off")
            {
                flash = Flash.Info($"Saved with {evaluation.Violations.Count} rule warning{(evaluation.Violations.Count == 1 ? "" : "s")}.");
            }
        }

        ApplyEdits(actor);

        if (await TrySaveActorAsync())
        {
            flash ??= Flash.Success("Saved.");
        }
        else
        {
            flash = Flash.Error("You don't have permission to edit this sheet.");
        }

        await ReloadAsync();
    }

    private async Task UploadPortraitAsync(InputFileChangeEventArgs e)
    {
        if (actor == null || access == null || !CanEdit) return;
        var file = e.File;
        if (!RavenMediaStore.AllowedContentTypes.Contains(file.ContentType))
        {
            flash = Flash.Error("Use a PNG, JPEG, WebP, GIF or AVIF image.");
            return;
        }

        if (file.Size > RavenMediaStore.MaxBytes)
        {
            flash = Flash.Error("That image is over 6 MB. Resize it and try again.");
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(RavenMediaStore.MaxBytes);
            await Media.PutAsync(actor.Id, RavenMediaStore.ActorPortrait, stream, file.ContentType);
            actor.HasPortrait = true;
            actor.PortraitVersion++;
            ApplyEdits(actor);
            await TrySaveActorAsync();
            flash = Flash.Success("Portrait updated.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Portrait upload failed for actor {ActorId}", ActorId);
            flash = Flash.Error("The upload failed: " + ex.Message);
        }

        await ReloadAsync();
    }

    private async Task RemovePortraitAsync()
    {
        if (actor == null || access == null || !CanEdit) return;
        await Media.DeleteAsync(actor.Id, RavenMediaStore.ActorPortrait);
        actor.HasPortrait = false;
        actor.PortraitVersion++;
        ApplyEdits(actor);
        await TrySaveActorAsync();
        flash = Flash.Success("Portrait removed.");
        await ReloadAsync();
    }

    private async Task RewriteAsync(AiAudience audience)
    {
        if (actor == null || campaign == null || currentUserId == null || busy != null) return;
        busy = audience == AiAudience.Dm ? "dm" : "bio";
        try
        {
            var snapshot = ApplyEdits(new ActorDocument { Id = actor.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name, Biography = actor.Biography });
            var text = await Ai.RewriteAsync(snapshot, campaign, system,
                audience == AiAudience.Dm ? editDmNotes : editBiography,
                audience == AiAudience.Dm ? dmInstruction : bioInstruction,
                audience, currentUserId);
            if (audience == AiAudience.Dm) editDmNotes = text; else editBiography = text;
            flash = Flash.Info("AI draft in the editor. Review, then Save changes.");
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error("No AI provider is set up. Add one under AI settings (top right).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI rewrite failed for actor {ActorId}", ActorId);
            flash = Flash.Error("The AI draft failed: " + ex.Message);
        }
        finally
        {
            busy = null;
        }
    }

    private async Task SuggestLevelUpAsync()
    {
        if (actor == null || campaign == null || currentUserId == null || busy != null) return;
        busy = "level";
        try
        {
            var snapshot = ApplyEdits(new ActorDocument { Id = actor.Id, CampaignId = actor.CampaignId, Kind = actor.Kind, OwnerUserId = actor.OwnerUserId, Name = actor.Name });
            levelUpAdvice = await Ai.LevelUpAsync(snapshot, campaign, system, currentUserId);
        }
        catch (AiNotConfiguredException)
        {
            flash = Flash.Error("No AI provider is set up. Add one under AI settings (top right).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI level-up failed for actor {ActorId}", ActorId);
            flash = Flash.Error("The AI suggestion failed: " + ex.Message);
        }
        finally
        {
            busy = null;
        }
    }

    private void ApplyLevelUp()
    {
        editSheet["level"] = (long)(CurrentLevel + 1);
        if (Rules?.Multiclass is { } multiclass && evaluation?.Classes.FirstOrDefault(c => c.IsFirst) is { } first
            && !string.IsNullOrEmpty(levelUpClassId) && levelUpClassId != first.Id)
        {
            // The first class gets whatever the others don't take, so only another class needs writing down.
            var classes = SheetRuleEngine.ParseClassLevels(editSheet, multiclass.Key);
            var index = classes.FindIndex(c => c.Id == levelUpClassId);
            if (index >= 0) classes[index] = classes[index] with { Level = classes[index].Level + 1 };
            else classes.Add(new OtherClass(levelUpClassId, 1));
            SetOtherClasses(multiclass, classes);
        }
        else
        {
            Reevaluate();
        }

        levelUpClassId = evaluation?.Classes.FirstOrDefault(c => c.IsFirst)?.Id ?? "";
        flash = Flash.Info($"Level set to {CurrentLevel}. Update hit points and features, then Save changes.");
    }

    private void AppendAdviceToNotes()
    {
        if (levelUpAdvice == null) return;
        var key = schema?.Fields.FirstOrDefault(f => f.Type == FieldType.LongText)?.Key ?? "notes";
        var existing = YamlValues.GetString(editSheet, key) ?? string.Empty;
        editSheet[key] = (existing.TrimEnd() + $"\n\nLevel {CurrentLevel + 1} plan:\n{levelUpAdvice}").Trim();
        levelUpAdvice = null;
        flash = Flash.Info("Added to the notes field. Save changes to keep it.");
    }
}
