@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.Authentication
@using Codex.Web.Components.Layout
@layout AuthLayout
@inject IConfiguration Configuration
@inject NavigationManager NavManager
@inject IAuthenticationSchemeProvider SchemeProvider
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PersistentComponentState AppState
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Login | TTRPG.Codex</PageTitle>

<div class="login-card">
    <div class="brand-anchor">
        <div class="logo-mark">
            <LucideIcon IconName="scroll" Size="64" />
        </div>
        <div class="brand-name">TTRPG.Codex</div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger small p-2 mb-3 rounded" role="alert"
            style="background-color: rgba(220, 53, 69, 0.1); border-color: rgba(220, 53, 69, 0.2); color: #ff6b6b;">
            @ErrorMessage</div>
    }

    @if (EnableLocalLogin)
    {
        @* Plain HTTP post (not an interactive EditForm): cookie sign-in needs a real
           HttpContext, which an interactive circuit doesn't have. Failures come back via
           ?error= (see /auth/login in Program.cs). *@
        <form method="post" action="/auth/login">
            <input type="hidden" name="__RequestVerificationToken" value="@AntiforgeryToken" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="mb-3 text-start">
                <label for="username" class="form-label small text-secondary">Account Username <span class="text-danger" aria-hidden="true">*</span></label>
                <input id="username" name="username" class="form-control w-100" placeholder="dm" autocomplete="username" required />
            </div>

            <div class="mb-4 text-start">
                <div class="d-flex justify-content-between">
                    <label for="password" class="form-label small text-secondary">Secret Key <span class="text-danger" aria-hidden="true">*</span></label>
                </div>
                <input id="password" name="password" type="password" class="form-control w-100" placeholder="••••••••" autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn-accent w-100 mt-2" disabled="@(AntiforgeryToken == null)">Enter Codex</button>
        </form>
    }

    @if (EnableLocalLogin && ExternalSchemes.Any())
    {
        <div class="auth-divider">
            <span class="auth-divider-text">Unified Auth</span>
        </div>
    }

    <div class="oauth-container">
        @foreach (var scheme in ExternalSchemes)
        {
            var providerClass = scheme.Name.ToLowerInvariant();
            <a href="/login/external?provider=@scheme.Name&returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")"
                class="oauth-btn @providerClass">
                @if (scheme.Name == "Google")
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google"
                        viewBox="0 0 16 16">
                        <path
                            d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z" />
                    </svg>
                }
                else if (scheme.Name == "Apple")
                {
                    <LucideIcon IconName="apple" Size="18" />
                }
                Continue with @(scheme.DisplayName ?? scheme.Name)
            </a>
        }
    </div>

    @if (!EnableLocalLogin && !ExternalSchemes.Any())
    {
        <div class="alert alert-warning small p-2 mt-3 rounded">
            No authentication methods are currently configured. Please contact the administrator.
        </div>
    }

    @if (EnableLocalLogin)
    {
        <div class="footer-links">
            New Storyteller? <a href="/register" class="text-accent">Initiate Account</a>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? QueryError { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    public bool EnableLocalLogin { get; set; } = true;

    public IEnumerable<AuthenticationScheme> ExternalSchemes { get; set; } = Array.Empty<AuthenticationScheme>();

    private string? AntiforgeryToken { get; set; }
    private PersistingComponentStateSubscription? _persistSubscription;

    protected override async Task OnInitializedAsync()
    {
        // Prerendering runs this twice: once for SSR (HttpContext exists - mint the token)
        // and once on the live circuit (no HttpContext). Without persistence the second run
        // leaves the token null and the re-render blanks the form's hidden input, so every
        // submit 400s. Persist the SSR-minted token across the handoff instead.
        if (!AppState.TryTakeFromJson<string>("antiforgery", out var restored))
        {
            restored = HttpContext == null ? null : Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
        }

        AntiforgeryToken = restored;
        _persistSubscription = AppState.RegisterOnPersisting(() =>
        {
            AppState.PersistAsJson("antiforgery", AntiforgeryToken);
            return Task.CompletedTask;
        });

        var allSchemes = await SchemeProvider.GetAllSchemesAsync();
        ExternalSchemes = allSchemes.Where(s => s.Name != "Cookies" && s.Name != "External").ToList();

        EnableLocalLogin = Configuration.GetValue<bool>("Authentication:EnableLocalLogin", true);

        if (!string.IsNullOrEmpty(QueryError))
        {
            ErrorMessage = QueryError;
        }
        else if (!EnableLocalLogin && ExternalSchemes.Count() == 1)
        {
            var provider = ExternalSchemes.First().Name;
            var dest = $"/login/external?provider={provider}&returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
            NavManager.NavigateTo(dest, forceLoad: true);
        }
    }

    public string? ErrorMessage { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // In-circuit arrivals (link clicks, RedirectToLogin) never ran SSR, so no token was
        // minted or persisted. Fetch one through the BROWSER - only a browser-issued request
        // stores the accompanying cookie where the form post will send it back from.
        // (OnAfterRenderAsync never runs during SSR, so this can't double-mint.)
        if (firstRender && AntiforgeryToken == null)
        {
            try
            {
                AntiforgeryToken = await JS.InvokeAsync<string>("codexAuth.getToken");
            }
            catch (JSException)
            {
                AntiforgeryToken = null;
            }

            StateHasChanged();
        }
    }

    public void Dispose() => _persistSubscription?.Dispose();
}
