@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using Codex.Persistence
@using Codex.Web.Components.Layout
@layout AuthLayout
@inject IUserRepository UserRepository
@inject ICampaignRepository CampaignRepository
@inject IConfiguration Configuration
@inject NavigationManager NavManager
@inject IAuthenticationSchemeProvider SchemeProvider
@inject LoginAttempts Attempts
@inject IServerSettingsStore Settings

<PageTitle>@L["Page.Auth.SignIn"] | TTRPG.Codex</PageTitle>

<div class="auth-card">
    <div class="brand-mark" aria-hidden="true"><LucideIcon IconName="scroll" Size="28" /></div>
    <h1>@L["Page.Login.Heading"]</h1>

    @if (QueryDeleted == "1" && string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="status status-success" role="status" data-testid="login-account-deleted">
            <LucideIcon IconName="check" Size="18" /><span>@L["Page.Login.AccountDeleted"]</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="status status-error" role="alert">
            <LucideIcon IconName="alert-triangle" Size="18" /><span>@ErrorMessage</span>
        </div>
    }

    @if (EnableLocalLogin)
    {
        <EditForm Model="@Model" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="username" class="field-label">@L["Page.Auth.Username"]</label>
                <InputText id="username" class="field-input" autocomplete="username" required @bind-Value="Model!.Username" />
            </div>

            <div class="mb-4">
                <label for="password" class="field-label">@L["Page.Auth.Password"]</label>
                <InputText id="password" type="password" class="field-input" autocomplete="current-password" required @bind-Value="Model!.Password" />
            </div>

            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Class="w-100">@L["Page.Auth.SignIn"]</CodexButton>
        </EditForm>
    }

    @if (EnableLocalLogin && ExternalSchemes.Any())
    {
        <div class="auth-divider"><span>@L["Page.Login.Divider"]</span></div>
    }

    @foreach (var scheme in ExternalSchemes)
    {
        <a href="/login/external?provider=@scheme.Name&returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")" class="oauth-btn">
            @L["Page.Login.Continue", scheme.DisplayName ?? scheme.Name]
        </a>
    }

    @if (!EnableLocalLogin && !ExternalSchemes.Any())
    {
        <div class="status" role="alert">
            <LucideIcon IconName="info" Size="18" /><span>@L["Page.Login.NoMethod"]</span>
        </div>
    }

    @if (EnableLocalLogin && CanSignUp)
    {
        <p class="text-center small-muted mt-4 mb-0">@L["Page.Login.NewHere"]<a href="@RegisterHref">@L["Page.Login.CreateAccount"]</a></p>
    }
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public LoginModel? Model { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? QueryError { get; set; }

    // Set by deleting your own account (docs/SERVER_ACCESS_AND_VAULT.md 16); only "1" says anything.
    [SupplyParameterFromQuery(Name = "deleted")]
    public string? QueryDeleted { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    public bool EnableLocalLogin { get; set; } = true;

    /// <summary>Always true at home; on a server open to the internet only for someone holding a real invite.</summary>
    private bool CanSignUp { get; set; } = true;

    // Carry the return address across, so a new player lands back on their invite after signing up.
    private string RegisterHref => string.IsNullOrEmpty(ReturnUrl) ? "/register" : "/register?returnUrl=" + Uri.EscapeDataString(ReturnUrl);

    public IEnumerable<AuthenticationScheme> ExternalSchemes { get; set; } = Array.Empty<AuthenticationScheme>();

    protected override async Task OnInitializedAsync()
    {
        Model ??= new();
        // A server nobody has an account on yet starts with the setup, on its own computer.
        var exposed = Codex.Web.ExposurePolicy.IsExposed(Configuration);
        if (string.IsNullOrWhiteSpace(Configuration["Codex:AdminUsername"]) && await ServerAccess.MaySetUpAsync(UserRepository, exposed, HttpContext?.Connection.RemoteIpAddress))
        {
            NavManager.NavigateTo("/setup");
            return;
        }

        var allSchemes = await SchemeProvider.GetAllSchemesAsync();
        ExternalSchemes = allSchemes.Where(s => s.Name != "Cookies" && s.Name != "External").ToList();

        EnableLocalLogin = Configuration.GetValue<bool>("Authentication:EnableLocalLogin", true);
        CanSignUp = await ServerAccess.NewAccountAsync(Settings, exposed, ReturnUrl, CampaignRepository) != null;

        if (!string.IsNullOrEmpty(QueryError))
        {
            // Only codes this server sends are shown, in the reader's language: text from the address bar is never put in the
            // app's own alert, where a link someone else made could make it say anything (R13).
            ErrorMessage = QueryError switch
            {
                "invite-only" => L["Page.Register.InviteOnly"],
                "disabled" => L["Page.Login.Disabled"],
                "unknown-provider" => L["Page.Login.Error.UnknownProvider"],
                "external-invalid" => L["Page.Login.Error.ExternalInvalid"],
                "no-username" => L["Page.Login.Error.NoUsername"],
                _ => L["Page.Login.Error.ExternalFailed"]
            };
        }
        else if (!EnableLocalLogin && ExternalSchemes.Count() == 1)
        {
            var provider = ExternalSchemes.First().Name;
            NavManager.NavigateTo($"/login/external?provider={provider}&returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}", forceLoad: true);
        }
    }

    public string? ErrorMessage { get; set; }

    private async Task HandleLogin()
    {
        if (HttpContext == null || Model == null)
        {
            ErrorMessage = L["Page.Login.Stale"];
            return;
        }

        var attempt = LoginAttempts.Key(Model.Username, Codex.Web.ExposurePolicy.ClientKey(HttpContext.Connection.RemoteIpAddress));
        if (!Attempts.Allows(attempt))
        {
            ErrorMessage = L["Page.Login.TooMany"];
            return;
        }

        var user = await UserRepository.GetUserByUsernameAsync(Model.Username);

        if (user == null)
        {
            Attempts.Failed(attempt);
            ErrorMessage = L["Page.Login.Invalid"];
            return;
        }

        var hasher = new PasswordHasher<UserDocument>();
        var result = hasher.VerifyHashedPassword(user, user.PasswordHash, Model.Password);

        if ((result == PasswordVerificationResult.Success || result == PasswordVerificationResult.SuccessRehashNeeded) && user.Status == AccountStatus.Disabled)
        {
            // Said only to someone who knows the password: it tells a stranger nothing about the account.
            ErrorMessage = L["Page.Login.Disabled"];
            return;
        }

        if (result == PasswordVerificationResult.Success || result == PasswordVerificationResult.SuccessRehashNeeded)
        {
            if (result == PasswordVerificationResult.SuccessRehashNeeded)
            {
                var rehashed = hasher.HashPassword(user, Model.Password);
                await UserRepository.UpdateUserAsync(user.Id, stored => stored.PasswordHash = rehashed);
            }

            await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, UserPrincipal.For(user));
            if (user.Culture is not null)
                CultureCookie.Write(HttpContext, user.Culture);

            // Waiting for approval: only an invite (which approves) or the waiting page.
            var dest = user.Status == AccountStatus.Pending && ExposurePolicy.InviteCodeFrom(ReturnUrl) == null ? ServerAccess.WaitingPath
                : Codex.Web.UrlHelper.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/";
            NavManager.NavigateTo(dest, forceLoad: true);
        }
        else
        {
            Attempts.Failed(attempt);
            ErrorMessage = L["Page.Login.Invalid"];
        }
    }

    public class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
