@page "/not-found"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout MainLayout

<PageTitle>@L["Page.NotFound.Title"] | TTRPG.Codex</PageTitle>

<div class="empty">
    <div class="empty-icon"><LucideIcon IconName="compass" Size="28" /></div>
    <h1 class="h4">@L["Page.NotFound.Title"]</h1>
    <p>@L["Page.NotFound.Text"]</p>
    <a href="/" class="cx-btn cx-plaque">@L["Page.Common.BackToCampaigns"]</a>
</div>
