@page "/about"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Codex.Core
@using Codex.Plugin.Abstractions
@inject ISystemCatalog Catalog
@inject IContentRegistry Registry
@inject PluginLoader Loader
@inject Codex.Web.Services.BackupStatus Backups

<PageTitle>@L["Page.About.Title"] | TTRPG.Codex</PageTitle>

<div class="page-narrow">
    <div class="page-header">
        <div>
            <h1>@L["Page.About.Heading"]</h1>
            <p class="page-subtitle">@L["Page.About.Subtitle"]</p>
        </div>
    </div>

    <section class="panel" aria-labelledby="systems-heading">
        <div class="panel-title"><h2 id="systems-heading">@L["Page.About.Systems"]</h2></div>
        @if (!Catalog.Systems.Any())
        {
            <p class="mb-0">@L["Page.About.NoSystemsBefore"]<code>system.yaml</code>@L["Page.About.NoSystemsAfter"]</p>
        }
        @foreach (var system in Catalog.Systems)
        {
            var packs = Registry.GetPacks(system.Id).ToList();
            <article class="mb-4" aria-labelledby="sys-@system.Id" data-testid="about-system">
                <h3 id="sys-@system.Id" class="h5 mb-1">@system.Name <span class="pill ms-2">@(system.IsDataDriven ? L["Page.About.DataDriven"] : L["Page.About.Compiled"])</span></h3>
                @if (Loader.LoadProblems.Any(p => string.Equals(p.SystemId, system.Id, StringComparison.OrdinalIgnoreCase)))
                {
                    <a class="small" href="/about#problems-@system.Id"><LucideIcon IconName="alert-triangle" Size="14" /> @L["Page.About.HasProblems"]</a>
                }
                @if (system.Compatibility != null)
                {
                    <div class="small-muted">@system.Compatibility</div>
                }
                @if (system.Description != null)
                {
                    <p class="mb-2">@system.Description</p>
                }
                @if (system.License != null)
                {
                    <div class="attribution mt-2">
                        @if (!string.IsNullOrWhiteSpace(system.License.Attribution))
                        {
                            <div>@system.License.Attribution</div>
                        }
                        <div>@L["Page.About.Licence"] @License(system.License)</div>
                    </div>
                }

                @if (packs.Count > 0)
                {
                    <h4 class="h6 mt-3">@L["Page.About.Packs"]</h4>
                    <ul class="list-unstyled mb-0">
                        @foreach (var pack in packs)
                        {
                            <li class="list-row" data-testid="about-pack">
                                <div class="row-main">
                                    <div class="row-title">@pack.Name <span class="pill ms-2">@pack.Kind</span> <span class="small-muted">v@(pack.Version)</span></div>
                                    @if (pack.Description != null)
                                    {
                                        <div class="row-sub">@pack.Description</div>
                                    }
                                    @if (pack.Authors.Count > 0)
                                    {
                                        <div class="row-sub">@L["Page.About.By", string.Join(", ", pack.Authors)]</div>
                                    }
                                    @if (pack.License != null)
                                    {
                                        <div class="attribution mt-2">
                                            @if (!string.IsNullOrWhiteSpace(pack.License.Attribution))
                                            {
                                                <div>@pack.License.Attribution</div>
                                            }
                                            <div>@L["Page.About.Licence"] @License(pack.License)</div>
                                            @foreach (var notice in pack.License.Notices)
                                            {
                                                <div class="mt-1">@notice</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </article>
        }
    </section>

    @if (Loader.LoadProblems.Count > 0 || Loader.FailedSystems.Count > 0)
    {
        <section class="panel" aria-labelledby="warnings-heading" data-testid="about-load-problems">
            <div class="panel-title"><h2 id="warnings-heading">@L["Page.About.Warnings"]</h2></div>
            <p class="small-muted">@L["Page.About.WarningsIntro"]</p>

            @foreach (var system in Catalog.Systems)
            {
                var problems = Loader.LoadProblems.Where(p => string.Equals(p.SystemId, system.Id, StringComparison.OrdinalIgnoreCase)).ToList();
                if (problems.Count == 0) continue;
                <h3 id="problems-@system.Id" class="h6 mt-3">@system.Name</h3>
                @ProblemList(problems)
            }

            @if (Loader.FailedSystems.Count > 0)
            {
                <h3 class="h6 mt-3">@L["Page.About.FailedSystems"]</h3>
                <p class="small-muted">@L["Page.About.FailedSystemsIntro"]</p>
                <ul class="mb-0" data-testid="about-failed-systems">
                    @foreach (var failed in Loader.FailedSystems)
                    {
                        <li>
                            <strong>@failed.Name</strong>
                            <ul>
                                @foreach (var error in failed.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                            <AuthorizeView Roles="@ExposurePolicy.ServerAdminRole"><div class="small-muted">@L["Page.About.OnTheServer"] <code>@failed.Path</code></div></AuthorizeView>
                        </li>
                    }
                </ul>
            }

            @{ var other = Loader.LoadProblems.Where(IsOther).ToList(); }
            @if (other.Count > 0)
            {
                <h3 class="h6 mt-3">@L["Page.About.OtherProblems"]</h3>
                @ProblemList(other)
            }
        </section>
    }

    @* Where the files are and what went wrong is for whoever runs the server: this page is open to anyone. *@
    <AuthorizeView Roles="@ExposurePolicy.ServerAdminRole">
    <section class="panel" aria-labelledby="backups-heading" data-testid="about-backups">
        <div class="panel-title"><h2 id="backups-heading">@L["Page.About.Backups"]</h2></div>
        @if (!Backups.Enabled)
        {
            <p class="mb-0">@L["Page.About.BackupsOff"]</p>
        }
        else
        {
            <p>@L["Page.About.BackupsWhere", Backups.Keep] <code>@Backups.Folder</code></p>
            <p class="@(Backups.LastError != null ? "text-danger" : "small-muted")">
                @(Backups.LastError != null ? L["Page.About.BackupsFailed", Backups.LastError]
                  : Backups.LastWrittenAt is { } last ? L["Page.About.BackupsLast", last.ToString("yyyy-MM-dd HH:mm") + " UTC"]
                  : L["Page.About.BackupsNone"])
            </p>
            <p class="small-muted mb-0">@L["Page.About.BackupsRestore"]</p>
        }
        <p class="small-muted mb-0 mt-2">@(Backups.Database switch
        {
            DatabaseBackups.On => L["Page.About.DatabaseBackupsOn"],
            DatabaseBackups.NotLicensed => L["Page.About.DatabaseBackupsNotLicensed"],
            DatabaseBackups.Failed => L["Page.About.DatabaseBackupsFailed"],
            _ => L["Page.About.DatabaseBackupsUnknown"]
        })</p>
    </section>
    </AuthorizeView>

    <section class="panel" aria-labelledby="software-heading">
        <div class="panel-title"><h2 id="software-heading">@L["Page.About.Software"]</h2></div>
        <p>TTRPG.Codex is source-available under the PolyForm Noncommercial License 1.0.0: free for noncommercial use. It bundles <a href="https://getbootstrap.com/" rel="noopener" target="_blank">Bootstrap</a> (MIT) icons from <a href="https://lucide.dev/" rel="noopener" target="_blank">Lucide</a> (ISC) and the typefaces <a href="https://github.com/NDISCOVER/Cinzel" rel="noopener" target="_blank">Cinzel</a>, <a href="https://github.com/huertatipografica/Alegreya-Sans" rel="noopener" target="_blank">Alegreya Sans</a>, Forum, <a href="https://github.com/fontef/frankruhllibre" rel="noopener" target="_blank">Frank Ruhl Libre</a> and <a href="https://github.com/hafontia/Assistant" rel="noopener" target="_blank">Assistant</a> (all SIL Open Font License 1.1); everything runs locally and nothing is loaded from the internet at the table.</p>
        <p class="mb-0 small-muted">Product names belong to their owners. Where a system says it is “compatible with” a product, that is the only relationship: TTRPG.Codex is not affiliated with or endorsed by any publisher.</p>
    </section>
</div>

@code {
    // Problems shown under neither a loaded system nor a failed one: the loader's own, packs for a system that is not here.
    private bool IsOther(LoadProblem problem) =>
        !(problem.SystemId != null && Catalog.LoadedSystemIds.Contains(problem.SystemId))
        && !(problem.Source == LoadProblemSource.System && Loader.FailedSystems.Any(f => f.Name == problem.Subject));

    private RenderFragment ProblemList(IReadOnlyList<LoadProblem> problems) => @<ul class="mb-0">
        @foreach (var problem in problems)
        {
            <li>
                @problem.Text
                @if (problem.Path != null)
                {
                    <AuthorizeView Roles="@ExposurePolicy.ServerAdminRole"><div class="small-muted">@L["Page.About.OnTheServer"] <code>@problem.Path</code></div></AuthorizeView>
                }
            </li>
        }
    </ul>;

    private RenderFragment License(LicenseInfo license) => builder =>
    {
        if (license.Url != null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", license.Url);
            builder.AddAttribute(2, "rel", "license noopener");
            builder.AddAttribute(3, "target", "_blank");
            builder.AddContent(4, license.Name);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(5, license.Name);
        }

        if (license.Modified)
        {
            builder.AddContent(6, " · " + L["Page.About.Modified"]);
        }

        if (license.SourceUrl != null)
        {
            builder.AddContent(7, " · " + L["Page.About.Source"] + " ");
            builder.OpenElement(8, "a");
            builder.AddAttribute(9, "href", license.SourceUrl);
            builder.AddAttribute(10, "rel", "noopener");
            builder.AddAttribute(11, "target", "_blank");
            builder.AddContent(12, license.SourceUrl);
            builder.CloseElement();
        }
    };
}
