@page "/settings/ai"
@using System.Security.Claims
@using Codex.Core.AI
@using Codex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject AiProviderService Providers
@inject IUserRepository UserRepo
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>@L["Page.AiSettings.Title"] | TTRPG.Codex</PageTitle>

<div class="page-header">
    <div>
        <nav aria-label="@L["Page.Common.Breadcrumb"]" class="breadcrumb-nav mb-1"><a href="/">@L["Page.Home.Title"]</a><span class="crumb-sep" aria-hidden="true">/</span><span>@L["Page.AiSettings.Title"]</span></nav>
        <h1><LucideIcon IconName="sparkles" Size="28" Class="title-icon" /> @L["Page.AiSettings.Title"]</h1>
        <p class="page-subtitle">@L["Page.AiSettings.Sub1"]<strong>@L["Page.AiSettings.SubTextModel"]</strong>@L["Page.AiSettings.Sub2", L["Library.Ai.Write"], L["Library.Ai.Enhance"]]<strong>@L["Page.AiSettings.SubImageModel"]</strong>@L["Page.AiSettings.Sub3", L["Actor.Art.Generate"]]</p>
    </div>
</div>

<StatusMessage Message="flash" OnDismiss="() => flash = null" />

@if (user == null)
{
    <LoadingSkeleton />
}
else
{
    <div class="row g-3">
        <div class="col-lg-7">
            @ProviderList(Purpose.Text)
            @ProviderList(Purpose.Image)

            <section class="panel" aria-labelledby="server-heading">
                <div class="panel-title"><h2 id="server-heading" class="h5"><LucideIcon IconName="shield" Size="18" Class="title-icon" /> @L["Page.AiSettings.ServerHeading"]</h2></div>
                <p class="mb-1 small">@L["Page.AiSettings.ServerText"]</p>
                <ul class="small mb-0">
                    <li>@L["Page.AiSettings.ServerTextBefore"]<code>AI</code>@L["Page.AiSettings.ServerTextAfter"] <strong>@(Providers.ServerConfigured ? Providers.ServerDescription : L["Page.AiSettings.NotConfigured"])</strong></li>
                    <li>@L["Page.AiSettings.ServerImageBefore"]<code>AIImage</code>@L["Page.AiSettings.ServerImageAfter"] <strong>@(Providers.ServerImageConfigured ? Providers.ServerImageDescription : L["Page.AiSettings.NotConfigured"])</strong></li>
                </ul>
            </section>

            <section class="panel" aria-labelledby="what-heading">
                <div class="panel-title"><h2 id="what-heading" class="h5"><LucideIcon IconName="info" Size="18" Class="title-icon" /> @L["Page.AiSettings.WhatHeading"]</h2></div>
                <ul class="feature-grid mb-0">
                    <li><LucideIcon IconName="book-open" Size="18" /> <div><strong>@L["Page.AiSettings.FeatRecapsTitle"]</strong><div class="small-muted">@L["Page.AiSettings.FeatRecapsText"]</div></div></li>
                    <li><LucideIcon IconName="feather" Size="18" /> <div><strong>@L["Page.AiSettings.FeatHistoriesTitle"]</strong><div class="small-muted">@L["Page.AiSettings.FeatHistoriesText"]</div></div></li>
                    <li><LucideIcon IconName="trending-up" Size="18" /> <div><strong>@L["Page.AiSettings.FeatLevelTitle"]</strong><div class="small-muted">@L["Page.AiSettings.FeatLevelText"]</div></div></li>
                    <li><LucideIcon IconName="wand" Size="18" /> <div><strong>@L["Page.AiSettings.FeatCharsTitle"]</strong><div class="small-muted">@L["Page.AiSettings.FeatCharsText"]</div></div></li>
                    <li><LucideIcon IconName="globe" Size="18" /> <div><strong>@L["Page.AiSettings.FeatWikiTitle"]</strong><div class="small-muted">@L["Page.AiSettings.FeatWikiText"]</div></div></li>
                    <li><LucideIcon IconName="image" Size="18" /> <div><strong>@L["Page.AiSettings.FeatArtTitle"]</strong><div class="small-muted">@L["Page.AiSettings.FeatArtText"]</div></div></li>
                </ul>
            </section>
        </div>

        <div class="col-lg-5">
            <section class="panel" aria-labelledby="editor-heading" id="provider-editor">
                <div class="panel-title"><h2 id="editor-heading" class="h5"><LucideIcon IconName="@(editingOriginalId != null ? "edit-3" : "plus")" Size="18" Class="title-icon" /> @(editingOriginalId != null ? (purpose == Purpose.Image ? L["Page.AiSettings.EditImage"] : L["Page.AiSettings.EditText"]) : (purpose == Purpose.Image ? L["Page.AiSettings.NewImage"] : L["Page.AiSettings.NewText"]))</h2></div>
                <div class="segmented mb-3" role="group" aria-label="@L["Page.AiSettings.KindOfModel"]">
                    <button type="button" class="chip" aria-pressed="@(purpose == Purpose.Text ? "true" : "false")" @onclick="() => StartNew(Purpose.Text)" disabled="@(editingOriginalId != null)" data-testid="ai-purpose-text"><LucideIcon IconName="feather" Size="14" /> @L["Page.AiSettings.Text"]</button>
                    <button type="button" class="chip" aria-pressed="@(purpose == Purpose.Image ? "true" : "false")" @onclick="() => StartNew(Purpose.Image)" disabled="@(editingOriginalId != null)" data-testid="ai-purpose-image"><LucideIcon IconName="image" Size="14" /> @L["Page.AiSettings.Images"]</button>
                </div>
                <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="ai-kind" class="field-label">@L["Page.AiSettings.Service"]</label>
                        @* `selected` on the option, not `value` on the select: the select's value is applied before
                           its options exist, so an edited model would show the first service instead of its own. *@
                        <select id="ai-kind" class="field-select" @onchange="OnPresetChanged" data-testid="ai-kind">
                            @foreach (var preset in Presets(purpose))
                            {
                                <option value="@preset.Kind" selected="@(string.Equals(preset.Kind, editing.Kind, StringComparison.OrdinalIgnoreCase))">@preset.Label</option>
                            }
                        </select>
                        @if (PresetFor(purpose, editing.Kind) is { } hint)
                        {
                            <div class="field-hint">@hint.Hint</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label for="ai-name" class="field-label">@L["Page.AiSettings.Name"]</label>
                        <input id="ai-name" class="field-input" @bind="editing.Name" required data-testid="ai-name" />
                    </div>
                    <div class="mb-3">
                        <label for="ai-url" class="field-label">@L["Page.AiSettings.BaseUrl"]</label>
                        <input id="ai-url" class="field-input" @bind="editing.BaseUrl" placeholder="https://…/v1" required data-testid="ai-url" />
                    </div>
                    <div class="mb-3">
                        <label for="ai-model" class="field-label">@L["Page.AiSettings.Model"]</label>
                        <input id="ai-model" class="field-input" @bind="editing.ModelId" placeholder="@(purpose == Purpose.Image ? L["Page.AiSettings.ModelPhImage"] : L["Page.AiSettings.ModelPhText"])" required data-testid="ai-model" />
                        @if (editing.Kind == "openrouter")
                        {
                            <div class="field-hint">@(purpose == Purpose.Image
                                ? L["Page.AiSettings.HintOpenRouterImage"]
                                : L["Page.AiSettings.HintOpenRouterText"])</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label for="ai-key" class="field-label">@L["Page.AiSettings.ApiKey"] @(editingOriginalId != null && !string.IsNullOrEmpty(editing.ProtectedApiKey) ? L["Page.AiSettings.ApiKeyKeep"] : "")</label>
                        <input id="ai-key" type="password" class="field-input" @bind="plainKey" autocomplete="off" placeholder="@(PresetFor(purpose, editing.Kind)?.RequiresKey == false ? L["Page.AiSettings.KeyPhLocal"] : "sk-…")" data-testid="ai-key" />
                        <div class="field-hint">
                            @L["Page.AiSettings.KeyHint"]
                            @if (SharedKeySource() is { } source)
                            {
                                <span> @L["Page.AiSettings.KeyReuse", source.Name]</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="ai-save">@(purpose == Purpose.Image ? L["Page.AiSettings.SaveImage"] : L["Page.AiSettings.SaveText"])</CodexButton>
                        @if (purpose == Purpose.Text)
                        {
                            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => TestAsync(editing, plainKey)" disabled="@testing">@(testing ? L["Page.AiSettings.Testing"] : L["Page.AiSettings.TestConnection"])</CodexButton>
                        }
                        @if (editingOriginalId != null)
                        {
                            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => StartNew(purpose)">@L["Common.Cancel"]</CodexButton>
                        }
                    </div>
                    @if (purpose == Purpose.Image)
                    {
                        <p class="field-hint mt-2 mb-0">@L["Page.AiSettings.NoImageTest", L["Actor.Art.Generate"]]</p>
                    }
                </form>
            </section>
        </div>
    </div>
}

@code {
    private enum Purpose { Text, Image }

    private sealed record PresetView(string Kind, string Label, string DefaultEndpoint, string DefaultModel, bool RequiresKey, string Hint);

    private UserDocument? user;
    private Purpose purpose = Purpose.Text;
    private AiProviderConfig editing = new();
    private string? editingOriginalId;
    private string plainKey = string.Empty;
    private bool testing;
    private Flash? flash;

    private RenderFragment ProviderList(Purpose listPurpose) => __builder =>
    {
        var list = ListFor(listPurpose);
        var defaultId = DefaultIdFor(listPurpose);
        var key = listPurpose == Purpose.Image ? "images" : "text";
        <section class="panel" aria-labelledby="@key-heading" id="@key">
            <div class="panel-title">
                <h2 id="@key-heading" class="h5"><LucideIcon IconName="@(listPurpose == Purpose.Image ? "image" : "bot")" Size="18" Class="title-icon" /> @(listPurpose == Purpose.Image ? L["Page.AiSettings.ImageModels"] : L["Page.AiSettings.TextModels"])</h2>
                <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => StartNew(listPurpose, focus: true)" data-testid="@(listPurpose == Purpose.Image ? "ai-add-image-provider" : "ai-add-provider")"><LucideIcon IconName="plus" Size="14" /> @L["Page.AiSettings.Add"]</CodexButton>
            </div>
            @if (list.Count == 0)
            {
                <div class="empty empty-compact">
                    <div class="empty-icon"><LucideIcon IconName="@(listPurpose == Purpose.Image ? "image" : "key-round")" Size="28" /></div>
                    <h3>@(listPurpose == Purpose.Image ? L["Page.AiSettings.EmptyImageTitle"] : L["Page.AiSettings.EmptyTextTitle"])</h3>
                    <p>@(listPurpose == Purpose.Image
                        ? L["Page.AiSettings.EmptyImageText"]
                        : L["Page.AiSettings.EmptyTextText"])</p>
                </div>
            }
            else
            {
                <ul class="list-unstyled mb-0" data-testid="@(listPurpose == Purpose.Image ? "ai-image-provider-list" : "ai-provider-list")">
                    @foreach (var provider in list)
                    {
                        var isDefault = provider.Id == defaultId;
                        var local = PresetFor(listPurpose, provider.Kind)?.RequiresKey == false;
                        <li class="list-row @(isDefault ? "list-row-active" : "")">
                            <span class="avatar avatar-md avatar-flat" aria-hidden="true"><LucideIcon IconName="@(local ? "home" : "globe")" Size="18" /></span>
                            <div class="row-main">
                                <div class="row-title">@provider.Name
                                    @if (isDefault)
                                    {
                                        <span class="pill pill-accent ms-1">@L["Page.AiSettings.InUse"]</span>
                                    }
                                </div>
                                <div class="row-sub">@provider.ModelId · @provider.BaseUrl · @(string.IsNullOrEmpty(provider.ProtectedApiKey) ? L["Page.AiSettings.NoKey"] : L["Page.AiSettings.KeyStored"])</div>
                            </div>
                            <div class="row-actions">
                                @if (!isDefault)
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => MakeDefaultAsync(provider, listPurpose)">@L["Page.AiSettings.Use"]</CodexButton>
                                }
                                @if (listPurpose == Purpose.Text)
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => TestAsync(provider, null)" disabled="@testing">@L["Page.AiSettings.Test"]</CodexButton>
                                }
                                <CodexButton Variant="CodexButtonVariant.Rune" Icon="edit-3" Label="@L["Page.AiSettings.EditLabel", provider.Name]" OnClick="() => StartEdit(provider, listPurpose)" />
                                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@L["Page.AiSettings.RemoveLabel", provider.Name]" OnClick="() => RemoveAsync(provider, listPurpose)" />
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    };

    private List<AiProviderConfig> ListFor(Purpose p) => p == Purpose.Image ? user!.ImageProviders : user!.AiProviders;

    private string? DefaultIdFor(Purpose p) => user == null ? null : (p == Purpose.Image ? Providers.DefaultImageProvider(user) : Providers.DefaultProvider(user))?.Id;

    private IEnumerable<PresetView> Presets(Purpose p) => p == Purpose.Image
        ? AiImageGenerator.Presets.Select(x => new PresetView(x.Kind, Shown(p, x.Kind, null, x.Label), x.DefaultEndpoint, x.DefaultModel, x.RequiresKey, Shown(p, x.Kind, ".Hint", x.Hint)))
        : AIClientFactory.Presets.Select(x => new PresetView(x.Kind, Shown(p, x.Kind, null, x.Label), x.DefaultEndpoint, x.DefaultModel, x.RequiresKey, Shown(p, x.Kind, ".Hint", x.Hint)));

    // A service's name and hint in the reader's language (Page.AiSettings.Preset.Text.ollama[.Hint]); brand names have no entry
    // and stay as the preset gives them, and so does a preset added without one. A hint may name the API path ({0}), kept
    // left to right inside Hebrew text.
    private string Shown(Purpose p, string kind, string? part, string fallback) =>
        L.Has($"Page.AiSettings.Preset.{p}.{kind}{part}")
            ? L[$"Page.AiSettings.Preset.{p}.{kind}{part}", Bidi.Ltr(p == Purpose.Image ? "/v1/images/generations" : "/v1/chat/completions")]
            : fallback;

    private PresetView? PresetFor(Purpose p, string? kind) =>
        Presets(p).FirstOrDefault(x => string.Equals(x.Kind, kind, StringComparison.OrdinalIgnoreCase));

    /// <summary>A text model on the same service with a stored key, which a new image model may reuse (one OpenRouter key does both).</summary>
    private AiProviderConfig? SharedKeySource() =>
        purpose == Purpose.Image && editingOriginalId == null && user != null
            ? user.AiProviders.FirstOrDefault(p => string.Equals(p.Kind, editing.Kind, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(p.ProtectedApiKey))
            : null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        user = userId == null ? null : await UserRepo.GetUserByIdAsync(userId);
        await StartNew(Purpose.Text);
    }

    private async Task StartNew(Purpose p, bool focus = false)
    {
        purpose = p;
        editingOriginalId = null;
        plainKey = string.Empty;
        editing = new AiProviderConfig();
        ApplyPreset(p == Purpose.Image ? "openai" : "openrouter");
        if (focus)
        {
            await JS.InvokeVoidAsync("codex.focus", "ai-kind");
        }
    }

    private void StartEdit(AiProviderConfig provider, Purpose p)
    {
        purpose = p;
        editingOriginalId = provider.Id;
        plainKey = string.Empty;
        editing = new AiProviderConfig
        {
            Id = provider.Id,
            Name = provider.Name,
            Kind = provider.Kind,
            BaseUrl = provider.BaseUrl,
            ModelId = provider.ModelId,
            ProtectedApiKey = provider.ProtectedApiKey,
            CreatedAt = provider.CreatedAt
        };
    }

    private void OnPresetChanged(ChangeEventArgs e) => ApplyPreset(e.Value?.ToString() ?? "custom");

    /// <summary>Fills in the service's defaults. On a model being edited, a field the user changed from the old
    /// service's default is kept: switching the service must not quietly swap their model for another (paid) one.</summary>
    private void ApplyPreset(string kind)
    {
        var previous = PresetFor(purpose, editing.Kind);
        var preset = PresetFor(purpose, kind);
        editing.Kind = kind;
        if (preset == null) return;
        var editingExisting = editingOriginalId != null;
        bool Replaceable(string current, string? oldDefault) =>
            !editingExisting || string.IsNullOrWhiteSpace(current) || string.Equals(current.Trim(), oldDefault, StringComparison.OrdinalIgnoreCase);
        // A model saved before the names were translated carries the English one, which is just as much a default.
        var englishName = purpose == Purpose.Image ? AiImageGenerator.Preset(previous?.Kind)?.Label : AIClientFactory.Preset(previous?.Kind)?.Label;
        if (Replaceable(editing.Name, previous?.Label) || Replaceable(editing.Name, englishName)) editing.Name = preset.Label;
        if (Replaceable(editing.BaseUrl, previous?.DefaultEndpoint)) editing.BaseUrl = preset.DefaultEndpoint;
        if (Replaceable(editing.ModelId, previous?.DefaultModel)) editing.ModelId = preset.DefaultModel;
    }

    private async Task SaveAsync()
    {
        if (user == null) return;
        if (string.IsNullOrWhiteSpace(editing.Name) || string.IsNullOrWhiteSpace(editing.BaseUrl) || string.IsNullOrWhiteSpace(editing.ModelId))
        {
            flash = Flash.Error(L["Page.AiSettings.Required"]);
            return;
        }

        if (!Uri.TryCreate(editing.BaseUrl.Trim(), UriKind.Absolute, out _))
        {
            flash = Flash.Error(L["Page.AiSettings.BadUrl"]);
            return;
        }

        if (!string.IsNullOrWhiteSpace(plainKey))
        {
            editing.ProtectedApiKey = Providers.Protect(plainKey.Trim());
        }
        else if (SharedKeySource() is { } shared)
        {
            editing.ProtectedApiKey = shared.ProtectedApiKey;
        }
        else if (editingOriginalId == null && PresetFor(purpose, editing.Kind)?.RequiresKey == true)
        {
            flash = Flash.Error(L["Page.AiSettings.NeedsKey"]);
            return;
        }

        // An address (or key) that is Anthropic's belongs on Anthropic's own client, whichever service was picked.
        if (purpose == Purpose.Text) editing.Kind = AIClientFactory.DetectKind(editing.Kind, editing.BaseUrl, plainKey);
        editing.Name = editing.Name.Trim();
        editing.BaseUrl = editing.BaseUrl.Trim();
        editing.ModelId = editing.ModelId.Trim();

        var list = ListFor(purpose);
        var index = list.FindIndex(p => p.Id == editing.Id);
        if (index >= 0) list[index] = editing; else list.Add(editing);
        if (purpose == Purpose.Image) user.DefaultImageProviderId ??= editing.Id; else user.DefaultAiProviderId ??= editing.Id;
        await UserRepo.UpdateUserAsync(user);
        flash = Flash.Success(L["Page.AiSettings.Saved", editing.Name]);
        await StartNew(purpose);
    }

    private async Task MakeDefaultAsync(AiProviderConfig provider, Purpose p)
    {
        if (user == null) return;
        if (p == Purpose.Image) user.DefaultImageProviderId = provider.Id; else user.DefaultAiProviderId = provider.Id;
        await UserRepo.UpdateUserAsync(user);
        flash = Flash.Success(p == Purpose.Image ? L["Page.AiSettings.NowImage", provider.Name] : L["Page.AiSettings.NowText", provider.Name]);
    }

    private async Task RemoveAsync(AiProviderConfig provider, Purpose p)
    {
        if (user == null) return;
        var list = ListFor(p);
        list.Remove(provider);
        if (p == Purpose.Image)
        {
            if (user.DefaultImageProviderId == provider.Id) user.DefaultImageProviderId = list.FirstOrDefault()?.Id;
        }
        else if (user.DefaultAiProviderId == provider.Id)
        {
            user.DefaultAiProviderId = list.FirstOrDefault()?.Id;
        }

        await UserRepo.UpdateUserAsync(user);
        flash = Flash.Success(L["Page.AiSettings.Removed", provider.Name]);
        if (editingOriginalId == provider.Id) await StartNew(p);
    }

    private async Task TestAsync(AiProviderConfig provider, string? key)
    {
        testing = true;
        try
        {
            var (ok, message) = await Providers.TestAsync(provider, string.IsNullOrWhiteSpace(key) ? null : key.Trim());
            flash = ok ? Flash.Success(L.Describe(message)) : Flash.Error(L.Describe(message));
        }
        finally
        {
            testing = false;
        }
    }
}
