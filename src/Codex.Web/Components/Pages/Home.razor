@page "/"
@using System.Security.Claims
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Components.Shared
@using Codex.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject ISystemCatalog Catalog
@inject Codex.Core.PluginLoader Loader
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IUserRepository Users
@inject IServerSettingsStore Settings

<PageTitle>@L["Page.Home.Title"] | TTRPG.Codex</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["Page.Home.Title"]</h1>
        <p class="page-subtitle">@L["Page.Home.Subtitle"]</p>
    </div>
    @if (mayCreate)
    {
        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="OpenNewDialogAsync" data-testid="new-campaign">
            <LucideIcon IconName="plus" Size="18" /> @L["Page.Home.New"]
        </CodexButton>
    }
</div>

@if (finishSetup)
{
    <div class="status mb-3" role="note" data-testid="finish-setup">
        <LucideIcon IconName="settings" Size="18" /><span>@L["Page.Home.FinishSetup"] <a href="/setup/server">@L["Page.Home.FinishSetupLink"]</a></span>
    </div>
}

<StatusMessage Message="flash" OnDismiss="() => flash = null" Toast="true" />

@if (campaigns == null)
{
    <LoadingSkeleton />
}
else if (campaigns.Count == 0)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="compass" Size="28" /></div>
        <h2>@L["Page.Home.EmptyTitle"]</h2>
        @if (mayCreate)
        {
            <p>@L["Page.Home.EmptyText"]</p>
            <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="OpenNewDialogAsync" data-testid="new-campaign-empty">@L["Page.Home.CreateFirst"]</CodexButton>
        }
        else
        {
            <p data-testid="join-only">@L["Page.Home.JoinOnly"]</p>
        }
    </div>
}
else
{
    <div class="card-grid" data-testid="campaign-list">
        @foreach (var campaign in campaigns)
        {
            var role = RoleOf(campaign);
            <article class="campaign-card @(campaign.HasCover ? "has-cover" : "")" aria-labelledby="camp-@campaign.Id">
                @if (campaign.HasCover)
                {
                    <div class="card-cover" style="background-image:url('@MediaEndpoints.CoverUrl(campaign)')" aria-hidden="true"></div>
                }
                else
                {
                    <div class="card-cover card-cover-empty" style="--cover-hue:@Hue(campaign.Name)" aria-hidden="true"><LucideIcon IconName="@SystemIcon(campaign.SystemId)" Size="28" /></div>
                }
                <div class="card-head">
                    <h2 id="camp-@campaign.Id"><a href="/campaigns/@campaign.Id">@campaign.Name</a></h2>
                    <span class="pill @(role == CampaignRole.DM ? "pill-accent" : "")">@RoleLabel(role, campaign.OwnerId == currentUserId)</span>
                </div>
                <div class="small-muted">@Catalog.GetDisplayName(campaign.SystemId)</div>
                <p class="mb-0 small campaign-pitch">@(campaign.Pitch() is { Length: > 0 } pitch ? pitch : L["Page.Home.NoDescription"])</p>
                <div class="card-foot">
                    <span class="small-muted">@L["Page.Home.Members", campaign.Members.Count] · @L["Page.Home.Updated"] <LocalTime Value="campaign.UpdatedAt" Format="d MMM yyyy" /></span>
                    <div class="row-actions">
                        @if (campaign.OwnerId == currentUserId)
                        {
                            <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@L["Page.Home.DeleteLabel", campaign.Name]" title="@L["Page.Home.DeleteCampaign"]" OnClick="() => DeleteAsync(campaign)" />
                        }
                        <a href="/campaigns/@campaign.Id" class="cx-btn cx-etched cx-sm">@L["Page.Home.Open"]</a>
                    </div>
                </div>
            </article>
        }
        @if (mayCreate)
        {
            <button type="button" class="campaign-card card-new" @onclick="OpenNewDialogAsync" aria-label="@L["Page.Home.New"]">
                <LucideIcon IconName="plus" Size="28" />
                <span class="fw-semibold">@L["Page.Home.New"]</span>
            </button>
        }
    </div>
}

<ConfirmDialog @ref="confirm" />

<dialog id="new-campaign-dialog" class="codex-dialog" aria-labelledby="new-campaign-title" @oncancel="CloseNewDialog">
    <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
        <div class="dialog-body">
            <h2 id="new-campaign-title">@L["Page.Home.New"]</h2>
            <div class="mb-3">
                <label for="nc-name" class="field-label">@L["Page.Home.Name"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Page.Home.Required"]</span></label>
                <input id="nc-name" class="field-input" @bind="newName" required maxlength="120" data-testid="new-campaign-name" />
            </div>
            <div class="mb-3">
                <label for="nc-system" class="field-label">@L["Page.Home.System"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Page.Home.Required"]</span></label>
                <select id="nc-system" class="field-select" @bind="newSystemId" required data-testid="new-campaign-system">
                    @foreach (var system in Catalog.Systems)
                    {
                        <option value="@system.Id">@system.Name</option>
                    }
                </select>
                @if (SelectedSystem?.Description is { } description)
                {
                    <div class="field-hint">@description</div>
                }
                @if (Loader.FailedSystems.Count > 0)
                {
                    @* A system with a broken system.yaml is not in the list above; say which, so the GM doesn't hunt for it. *@
                    <div class="field-hint" data-testid="new-campaign-failed-systems">
                        <LucideIcon IconName="alert-triangle" Size="14" /> @L["Page.Home.FailedSystems", string.Join(", ", Loader.FailedSystems.Select(f => f.Name))]
                        <a href="/about#warnings-heading">@L["Page.Home.FailedSystemsLink"]</a>
                    </div>
                }
            </div>
            <div class="mb-3">
                <label for="nc-tagline" class="field-label">@L["Page.Home.Tagline"]</label>
                <input id="nc-tagline" class="field-input" @bind="newTagline" @bind:event="oninput" maxlength="@CampaignDocument.MaxTagline" placeholder="@L["Page.Home.TaglinePlaceholder"]" aria-describedby="nc-tagline-hint" data-testid="new-campaign-tagline" />
                <div id="nc-tagline-hint" class="field-hint d-flex justify-content-between gap-2"><span>@L["Page.Home.TaglineHint"]</span><span aria-hidden="true">@newTagline.Length / @CampaignDocument.MaxTagline</span></div>
            </div>
            <div class="mb-1">
                <label for="nc-desc" class="field-label">@L["Page.Home.Description"]</label>
                <textarea id="nc-desc" class="field-input" rows="4" @bind="newDescription" placeholder="@L["Page.Home.DescriptionPlaceholder"]" aria-describedby="nc-desc-hint"></textarea>
                <div id="nc-desc-hint" class="field-hint">@L["Page.Home.DescriptionHint"]</div>
            </div>
            @if (createError != null)
            {
                <p class="text-danger mb-0" role="alert">@createError</p>
            }
        </div>
        <div class="dialog-actions">
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseNewDialog">@L["Common.Cancel"]</CodexButton>
            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Disabled="@creating" data-testid="new-campaign-create">@(creating ? L["Page.Home.Creating"] : L["Page.Home.Create"])</CodexButton>
        </div>
    </form>
</dialog>

@code {
    private List<CampaignDocument>? campaigns;
    private string? currentUserId;
    private Flash? flash;
    private ConfirmDialog confirm = null!;

    private string newName = string.Empty;
    private string newSystemId = string.Empty;
    private string newDescription = string.Empty;
    private string newTagline = string.Empty;
    private string? createError;
    private bool creating;

    /// <summary>Whether this account may create campaigns (ServerAccess.MayCreateCampaigns); checked again on create.</summary>
    private bool mayCreate;

    /// <summary>The admin made their account but has not finished the setup steps.</summary>
    private bool finishSetup;

    private SystemSummary? SelectedSystem => Catalog.Systems.FirstOrDefault(s => s.Id == newSystemId);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        newSystemId = Catalog.Systems.FirstOrDefault()?.Id ?? string.Empty;
        var settings = await Settings.GetAsync();
        var me = currentUserId == null ? null : await Users.GetUserByIdAsync(currentUserId);
        mayCreate = ServerAccess.MayCreateCampaigns(me, settings);
        finishSetup = !settings.SetupDone && me?.Roles.Contains(UserRoles.ServerAdmin) == true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        campaigns = currentUserId == null
            ? new List<CampaignDocument>()
            : (await CampaignRepo.GetForUserAsync(currentUserId)).ToList();
    }

    private static int Hue(string name)
    {
        var hash = 0;
        foreach (var c in name) hash = (hash * 31 + c) & 0x7fffffff;
        return hash % 360;
    }

    // The owner is the GM; anyone else holding the GM role is a co-GM.
    private string RoleLabel(CampaignRole role, bool isOwner) => role switch
    {
        CampaignRole.DM => isOwner ? L["Page.Role.DM"] : L["Campaign.Settings.Role.CoGm"],
        CampaignRole.Player => L["Page.Role.Player"],
        _ => L["Page.Role.Observer"]
    };

    private static string SystemIcon(string systemId) => systemId.Contains("srd", StringComparison.OrdinalIgnoreCase) ? "swords" : "scroll";

    private CampaignRole RoleOf(CampaignDocument campaign) =>
        campaign.OwnerId == currentUserId
            ? CampaignRole.DM
            : campaign.Members.FirstOrDefault(m => m.UserId == currentUserId)?.Role ?? CampaignRole.Observer;

    private async Task OpenNewDialogAsync()
    {
        createError = null;
        newName = string.Empty;
        newDescription = string.Empty;
        newTagline = string.Empty;
        if (string.IsNullOrEmpty(newSystemId))
        {
            newSystemId = Catalog.Systems.FirstOrDefault()?.Id ?? string.Empty;
        }

        await JS.InvokeVoidAsync("codex.showModal", "new-campaign-dialog");
        await JS.InvokeVoidAsync("codex.focus", "nc-name");
    }

    private async Task CloseNewDialog() => await JS.InvokeVoidAsync("codex.closeModal", "new-campaign-dialog");

    private async Task CreateAsync()
    {
        if (currentUserId == null) return;
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = L["Page.Home.NameRequired"];
            return;
        }

        if (string.IsNullOrWhiteSpace(newSystemId))
        {
            createError = L["Page.Home.NoSystem"];
            return;
        }

        if (!ServerAccess.MayCreateCampaigns(await Users.GetUserByIdAsync(currentUserId), await Settings.GetAsync()))
        {
            mayCreate = false;
            createError = L["Page.Home.JoinOnly"];
            return;
        }

        creating = true;
        try
        {
            var doc = new CampaignDocument
            {
                Id = Guid.NewGuid().ToString(),
                OwnerId = currentUserId,
                Name = newName.Trim(),
                Tagline = CampaignDocument.CleanTagline(newTagline),
                Description = newDescription.Trim(),
                SystemId = newSystemId,
                UpdatedAt = DateTime.UtcNow
            };
            await CampaignRepo.SaveAsync(doc);
            await CloseNewDialog();
            Nav.NavigateTo($"/campaigns/{doc.Id}");
        }
        catch (InvalidOperationException ex)
        {
            createError = L.Describe(ex);
        }
        finally
        {
            creating = false;
        }
    }

    private async Task DeleteAsync(CampaignDocument campaign)
    {
        var ok = await confirm.ShowAsync(
            L["Page.Home.DeleteTitle", campaign.Name],
            L["Page.Home.DeleteBody"],
            L["Page.Home.DeleteCampaign"],
            isDestructive: true);
        if (!ok || currentUserId == null) return;

        var result = await CampaignRepo.DeleteAsync(campaign.Id, currentUserId);
        flash = result switch
        {
            CampaignDeleteResult.Deleted => Flash.Success(L["Page.Home.Deleted", campaign.Name]),
            CampaignDeleteResult.Forbidden => Flash.Error(L["Page.Home.Forbidden"]),
            _ => Flash.Error(L["Page.Home.Gone"])
        };
        await LoadAsync();
    }
}
