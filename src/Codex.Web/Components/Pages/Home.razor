@page "/"
@using System.Security.Claims
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@using Codex.Web.Components.Shared
@using Codex.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject ISystemCatalog Catalog
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Campaigns | TTRPG.Codex</PageTitle>

<div class="page-header">
    <div>
        <h1>Campaigns</h1>
        <p class="page-subtitle">Every campaign you run or play in. Players join with an invite link from their DM.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="OpenNewDialogAsync" data-testid="new-campaign">
        <LucideIcon IconName="plus" Size="18" /> New campaign
    </button>
</div>

<StatusMessage Message="flash" OnDismiss="() => flash = null" />

@if (campaigns == null)
{
    <LoadingSkeleton />
}
else if (campaigns.Count == 0)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="map" Size="28" /></div>
        <h2>No campaigns yet</h2>
        <p>Create one to run a table, or ask your DM for an invite link to join theirs.</p>
        <button type="button" class="btn btn-primary" @onclick="OpenNewDialogAsync" data-testid="new-campaign-empty">Create your first campaign</button>
    </div>
}
else
{
    <div class="card-grid" data-testid="campaign-list">
        @foreach (var campaign in campaigns)
        {
            var role = RoleOf(campaign);
            <article class="campaign-card" aria-labelledby="camp-@campaign.Id">
                <div class="card-head">
                    <h2 id="camp-@campaign.Id"><a href="/campaigns/@campaign.Id">@campaign.Name</a></h2>
                    <span class="pill @(role == CampaignRole.DM ? "pill-accent" : "")">@role</span>
                </div>
                <div class="small-muted">@Catalog.GetDisplayName(campaign.SystemId)</div>
                <p class="mb-0 small">@(string.IsNullOrWhiteSpace(campaign.Description) ? "No description yet." : campaign.Description)</p>
                <div class="card-foot">
                    <span class="small-muted">@campaign.Members.Count member@(campaign.Members.Count == 1 ? "" : "s") · updated @campaign.UpdatedAt.ToString("d MMM yyyy")</span>
                    <div class="row-actions">
                        @if (campaign.OwnerId == currentUserId)
                        {
                            <button type="button" class="icon-btn danger" aria-label="Delete @campaign.Name" title="Delete campaign" @onclick="() => DeleteAsync(campaign)">
                                <LucideIcon IconName="trash-2" Size="16" />
                            </button>
                        }
                        <a href="/campaigns/@campaign.Id" class="btn btn-outline-secondary btn-sm">Open</a>
                    </div>
                </div>
            </article>
        }
        <button type="button" class="campaign-card card-new" @onclick="OpenNewDialogAsync" aria-label="New campaign">
            <LucideIcon IconName="plus" Size="24" />
            <span class="fw-semibold">New campaign</span>
        </button>
    </div>
}

<ConfirmDialog @ref="confirm" />

<dialog id="new-campaign-dialog" class="codex-dialog" aria-labelledby="new-campaign-title" @oncancel="CloseNewDialog">
    <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
        <div class="dialog-body">
            <h2 id="new-campaign-title">New campaign</h2>
            <div class="mb-3">
                <label for="nc-name" class="form-label">Name <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
                <input id="nc-name" class="form-control" @bind="newName" required maxlength="120" data-testid="new-campaign-name" />
            </div>
            <div class="mb-3">
                <label for="nc-system" class="form-label">Game system <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
                <select id="nc-system" class="form-select" @bind="newSystemId" required data-testid="new-campaign-system">
                    @foreach (var system in Catalog.Systems)
                    {
                        <option value="@system.Id">@system.Name</option>
                    }
                </select>
                @if (SelectedSystem?.Description is { } description)
                {
                    <div class="form-text">@description</div>
                }
            </div>
            <div class="mb-1">
                <label for="nc-desc" class="form-label">Description</label>
                <textarea id="nc-desc" class="form-control" rows="2" @bind="newDescription" placeholder="A line or two about the campaign (optional)"></textarea>
            </div>
            @if (createError != null)
            {
                <p class="text-danger mb-0" role="alert">@createError</p>
            }
        </div>
        <div class="dialog-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseNewDialog">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@creating" data-testid="new-campaign-create">@(creating ? "Creating…" : "Create campaign")</button>
        </div>
    </form>
</dialog>

@code {
    private List<CampaignDocument>? campaigns;
    private string? currentUserId;
    private Flash? flash;
    private ConfirmDialog confirm = null!;

    private string newName = string.Empty;
    private string newSystemId = string.Empty;
    private string newDescription = string.Empty;
    private string? createError;
    private bool creating;

    private SystemSummary? SelectedSystem => Catalog.Systems.FirstOrDefault(s => s.Id == newSystemId);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        newSystemId = Catalog.Systems.FirstOrDefault()?.Id ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        campaigns = currentUserId == null
            ? new List<CampaignDocument>()
            : (await CampaignRepo.GetForUserAsync(currentUserId)).ToList();
    }

    private CampaignRole RoleOf(CampaignDocument campaign) =>
        campaign.OwnerId == currentUserId
            ? CampaignRole.DM
            : campaign.Members.FirstOrDefault(m => m.UserId == currentUserId)?.Role ?? CampaignRole.Observer;

    private async Task OpenNewDialogAsync()
    {
        createError = null;
        newName = string.Empty;
        newDescription = string.Empty;
        if (string.IsNullOrEmpty(newSystemId))
        {
            newSystemId = Catalog.Systems.FirstOrDefault()?.Id ?? string.Empty;
        }

        await JS.InvokeVoidAsync("codex.showModal", "new-campaign-dialog");
        await JS.InvokeVoidAsync("codex.focus", "nc-name");
    }

    private async Task CloseNewDialog() => await JS.InvokeVoidAsync("codex.closeModal", "new-campaign-dialog");

    private async Task CreateAsync()
    {
        if (currentUserId == null) return;
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = "Give the campaign a name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newSystemId))
        {
            createError = "No game system is loaded. Add a system.yaml under the content folder and restart.";
            return;
        }

        creating = true;
        try
        {
            var doc = new CampaignDocument
            {
                Id = Guid.NewGuid().ToString(),
                OwnerId = currentUserId,
                Name = newName.Trim(),
                Description = newDescription.Trim(),
                SystemId = newSystemId,
                UpdatedAt = DateTime.UtcNow
            };
            await CampaignRepo.SaveAsync(doc);
            await CloseNewDialog();
            Nav.NavigateTo($"/campaigns/{doc.Id}");
        }
        catch (InvalidOperationException ex)
        {
            createError = ex.Message;
        }
        finally
        {
            creating = false;
        }
    }

    private async Task DeleteAsync(CampaignDocument campaign)
    {
        var ok = await confirm.ShowAsync(
            $"Delete “{campaign.Name}”?",
            "This removes the campaign and everything in it: characters, sessions, lore, notes and homebrew. Export a backup first if you want to keep any of it. This cannot be undone.",
            "Delete campaign",
            isDestructive: true);
        if (!ok || currentUserId == null) return;

        var result = await CampaignRepo.DeleteAsync(campaign.Id, currentUserId);
        flash = result switch
        {
            CampaignDeleteResult.Deleted => Flash.Success($"Deleted “{campaign.Name}”."),
            CampaignDeleteResult.Forbidden => Flash.Error("Only the campaign's owner can delete it."),
            _ => Flash.Error("That campaign no longer exists.")
        };
        await LoadAsync();
    }
}
