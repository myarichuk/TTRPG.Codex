@page "/"
@using System.Security.Claims
@using Codex.Persistence
@using Codex.Web.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@inject ICampaignRepository CampaignRepo
@inject ISessionRepository SessionRepo
@inject ICampaignAccessResolver AccessResolver
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard | TTRPG.Codex</PageTitle>

@if (campaigns == null)
{
    <div class="d-flex justify-content-center my-5 py-5">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="animate-fade">
        <header class="d-flex justify-content-between align-items-start">
            <div>
                <h1>Your Worlds</h1>
                <p class="page-subtitle">Welcome back. You have <span>@campaigns.Count</span> active @(campaigns.Count == 1 ? "campaign" : "campaigns").</p>
            </div>
            <a href="/campaigns" class="btn btn-accent btn-sm text-decoration-none">New Campaign</a>
        </header>

        <div class="dashboard-grid">
            @foreach (var campaign in campaigns)
            {
                var access = accessByCampaign.GetValueOrDefault(campaign.Id);
                var last = lastSessionByCampaign.GetValueOrDefault(campaign.Id);
                var sessionCount = sessionCountByCampaign.GetValueOrDefault(campaign.Id, 0);
                <a class="campaign-card campaign-card-link" href="/campaigns/@campaign.Id" aria-label="Open @campaign.Name">
                    <div class="art-preview">
                        <LucideIcon IconName="@(campaign.SystemId.Contains("DnD") ? "swords" : "anchor")" Size="40" Class="text-white opacity-25" />
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="card-title mb-0">@campaign.Name</h3>
                            <button type="button" class="btn-delete-fluence" aria-label="Delete @campaign.Name" @onclick="() => DeleteCampaign(campaign.Id, campaign.Name)" @onclick:stopPropagation="true" @onclick:preventDefault="true" title="Destroy Chronicle">
                                <LucideIcon IconName="trash-2" Size="14" />
                            </button>
                        </div>
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-secondary">@campaign.SystemId</span>
                            @if (access != null)
                            {
                                <span class="badge bg-info text-dark">@access.Role</span>
                            }
                            <span class="badge bg-dark">@campaign.Members.Count @(campaign.Members.Count == 1 ? "member" : "members")</span>
                        </div>
                        <p class="card-text">@(string.IsNullOrWhiteSpace(campaign.Description) ? "No description recorded." : campaign.Description)</p>
                        <p class="small text-tertiary mb-0">
                            @if (last != null)
                            {
                                <span>Last session: @(string.IsNullOrWhiteSpace(last.Title) ? last.Date.ToString("MMM dd, yyyy") : last.Title) · @sessionCount @(sessionCount == 1 ? "session" : "sessions")</span>
                            }
                            else
                            {
                                <span>No sessions yet</span>
                            }
                        </p>
                    </div>
                </a>
            }

            <a class="campaign-card card-empty text-center text-decoration-none" href="/campaigns" aria-label="Go to campaigns">
                <div class="card-body">
                    <LucideIcon IconName="plus" Size="32" Class="sparkle-icon" />
                    <h3 class="card-title">New Campaign</h3>
                    <p class="card-text">Create a campaign or browse existing ones.</p>
                </div>
            </a>
        </div>

        <section>
            <div class="section-header">
                <h2 class="h5 mb-0 fw-bold">Recent Activity</h2>
            </div>

            <div class="fluent-table-wrapper">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Campaign</th>
                            <th>Session</th>
                            <th>Recap</th>
                            <th>Last Played</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentActivity.Any())
                        {
                            @foreach (var item in recentActivity)
                            {
                                <tr>
                                    <td><a href="/campaigns/@item.CampaignId">@item.CampaignName</a></td>
                                    <td><a href="@item.Href">@item.Title</a></td>
                                    <td class="small text-secondary">@(string.IsNullOrWhiteSpace(item.Snippet) ? "—" : item.Snippet)</td>
                                    <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="empty-state-icon mx-auto mb-3" style="width: 48px; height: 48px; background: var(--fluent-surface-secondary); border-radius: 50%; display: grid; place-items: center;">
                                        <LucideIcon IconName="book-open" Size="24" Class="text-tertiary" />
                                    </div>
                                    <h3 class="h6 fw-bold mb-2">Nothing played yet</h3>
                                    <p class="text-secondary small mb-0">Plan a session in any campaign to see history here.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3 text-end">
                <a href="/grimoire" class="text-accent small text-decoration-none fw-600" aria-label="View all lore">View all lore <span aria-hidden="true">→</span></a>
            </div>
        </section>
    </div>
}

@code {
    private List<CampaignDocument>? campaigns;
    private string? currentUserId;
    private readonly Dictionary<string, CampaignAccess?> accessByCampaign = new();
    private readonly Dictionary<string, SessionDocument?> lastSessionByCampaign = new();
    private readonly Dictionary<string, int> sessionCountByCampaign = new();
    private List<ActivityItem> recentActivity = new();

    private sealed record ActivityItem(string CampaignId, string CampaignName, string Title, string? Snippet, DateTime Date, string Href);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        campaigns = null;
        accessByCampaign.Clear();
        lastSessionByCampaign.Clear();
        sessionCountByCampaign.Clear();
        recentActivity = new();

        var all = await CampaignRepo.GetAllAsync();
        var mine = (currentUserId == null
            ? Enumerable.Empty<CampaignDocument>()
            : all.Where(c => string.Equals(c.OwnerId, currentUserId, StringComparison.Ordinal)
                || c.Members.Any(m => string.Equals(m.UserId, currentUserId, StringComparison.Ordinal))))
            .OrderByDescending(c => c.UpdatedAt)
            .ToList();

        var activity = new List<ActivityItem>();
        foreach (var campaign in mine)
        {
            var access = currentUserId == null
                ? null
                : await AccessResolver.ResolveAsync(campaign.Id, currentUserId);
            if (access == null)
            {
                continue;
            }

            accessByCampaign[campaign.Id] = access;
            var sessions = (await SessionRepo.GetAllForCampaignAsync(campaign.Id))
                .OrderByDescending(s => s.Date)
                .ToList();
            sessionCountByCampaign[campaign.Id] = sessions.Count;
            var last = sessions.FirstOrDefault();
            lastSessionByCampaign[campaign.Id] = last;
            if (last != null)
            {
                activity.Add(new ActivityItem(
                    campaign.Id,
                    campaign.Name,
                    string.IsNullOrWhiteSpace(last.Title) ? last.Date.ToString("MMM dd, yyyy") : last.Title,
                    string.IsNullOrWhiteSpace(last.Recap) ? null : (last.Recap.Length > 140 ? last.Recap[..140] + "…" : last.Recap),
                    last.Date,
                    $"/campaigns/{campaign.Id}/sessions/{last.Id}"));
            }
        }

        campaigns = mine.Where(c => accessByCampaign.ContainsKey(c.Id)).ToList();
        recentActivity = activity.OrderByDescending(a => a.Date).Take(6).ToList();
    }

    private async Task DeleteCampaign(string id, string name)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the campaign '{name}'? This action cannot be undone.");
        if (!confirm) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) return;

        var result = await CampaignRepo.DeleteAsync(id, userId);
        if (result == CampaignDeleteResult.Forbidden)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Only the campaign owner can delete it.");
        }
        await LoadAsync();
        StateHasChanged();
    }
}
