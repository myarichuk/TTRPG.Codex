@using Codex.Core
@using Codex.Persistence
@using Microsoft.AspNetCore.WebUtilities
@inject IFactRepository FactRepo
@inject IWikiRepository WikiRepo
@inject MentionSources MentionSources
@inject NavigationManager Nav

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["Campaign.Lore.Title"]</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? L["Campaign.Lore.Subtitle.Dm"] : L["Campaign.Lore.Subtitle.Player"])</p>
    </div>
</div>

<div class="toolbar">
    <div class="search">
        <LucideIcon IconName="search" Size="18" Class="search-icon" />
        <label for="lore-search" class="visually-hidden">@L["Campaign.Lore.Search"]</label>
        <input id="lore-search" type="search" class="field-input" placeholder="@L["Campaign.Lore.SearchPlaceholder"]" @bind="search" @bind:event="oninput" />
    </div>
    <div class="chips" role="group" aria-label="@L["Campaign.Lore.FilterLabel"]">
        @foreach (var chip in Chips)
        {
            <button type="button" class="chip" aria-pressed="@((activeChip == chip) ? "true" : "false")" @onclick="() => activeChip = chip">@ChipLabel(chip)</button>
        }
    </div>
</div>

<div class="row g-3">
    <div class="@(Ctx.IsDm ? "col-lg-8" : "col-12")">
        @if (facts == null)
        {
            <LoadingSkeleton />
        }
        else
        {
            @if (!Filtered.Any() && !WikiFiltered.Any())
            {
                <div class="empty">
                    <div class="empty-icon"><LucideIcon IconName="book-marked" Size="28" /></div>
                    <h3>@(string.IsNullOrWhiteSpace(search) ? L["Campaign.Lore.Empty.None"] : L["Campaign.Lore.Empty.NoMatch"])</h3>
                    <p>@(Ctx.IsDm ? L["Campaign.Lore.Empty.Dm"] : L["Campaign.Lore.Empty.Player"])</p>
                </div>
            }
            @foreach (var fact in Filtered)
            {
                <article class="panel" aria-labelledby="fact-@fact.Id" data-testid="fact-card">
                    @if (editingId == fact.Id)
                    {
                        <form @onsubmit="() => SaveEditAsync(fact)" @onsubmit:preventDefault="true" data-testid="fact-edit">
                            <div class="mb-2">
                                <label for="edit-summary-@fact.Id" class="field-label">@L["Campaign.Lore.Summary"]</label>
                                <input id="edit-summary-@fact.Id" class="field-input" @bind="editSummary" required data-testid="fact-edit-summary" />
                            </div>
                            <div class="mb-2">
                                <label for="edit-details-@fact.Id" class="field-label">@L["Campaign.Lore.Details"]</label>
                                <textarea id="edit-details-@fact.Id" class="field-input" rows="4" @bind="editDetails" @bind:event="oninput" data-mentions="@mentionsJson" aria-describedby="edit-details-hint-@fact.Id" data-testid="fact-edit-details"></textarea>
                                <p id="edit-details-hint-@fact.Id" class="field-hint">@L["Campaign.Lore.DetailsHint"]</p>
                            </div>
                            <div class="mb-2">
                                <label for="edit-visibility-@fact.Id" class="field-label">@L["Campaign.Lore.WhoCanSee"]</label>
                                <select id="edit-visibility-@fact.Id" class="field-select" @bind="editVisibility">
                                    <option value="@FactVisibility.DmOnly">@L["Campaign.Lore.Vis.DmOnly"]</option>
                                    <option value="@FactVisibility.KnowersOnly">@L["Campaign.Lore.Vis.KnowersOnly"]</option>
                                    <option value="@FactVisibility.Public">@L["Campaign.Lore.Vis.Public"]</option>
                                </select>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Small="true" data-testid="fact-edit-save">@L["Campaign.Lore.SaveFact"]</CodexButton>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => editingId = null">@L["Common.Cancel"]</CodexButton>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="panel-title">
                            <h3 id="fact-@fact.Id" class="h6">@fact.Summary</h3>
                            <span class="pill @VisibilityClass(fact)">@VisibilityLabel(fact)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(fact.Details))
                        {
                            <div class="rules-text mb-2" data-testid="fact-details">@((MarkupString)WikiRender.ToHtml(fact.Details, pages, mentions, Ctx.Campaign.Id, false, Ctx.IsDm ? DmView.From(L, mentions) : null))</div>
                        }
                        @if (Ctx.IsDm)
                        {
                            <div class="fact-knowers small-muted mb-2">
                                <span>@L["Campaign.Lore.KnownByLabel"]</span>
                                @if (fact.KnownBy.Count == 0)
                                {
                                    <span>@L["Campaign.Lore.Nobody"]</span>
                                }
                                @foreach (var knower in fact.KnownBy)
                                {
                                    <span class="chip chip-static" data-testid="fact-knower">
                                        @ActorName(knower.EntityId) · @LevelLabel(knower.Level)
                                        <button type="button" class="chip-x" aria-label="@L["Campaign.Lore.Forget", ActorName(knower.EntityId)]" title="@L["Campaign.Lore.Forget", ActorName(knower.EntityId)]" @onclick="() => ForgetAsync(fact, knower.EntityId)"><LucideIcon IconName="x" Size="12" /></button>
                                    </span>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-end">
                                @if (fact.Visibility != FactVisibility.Public)
                                {
                                    <div>
                                        <label for="reveal-actor-@fact.Id" class="field-label">@L["Campaign.Lore.RevealTo"]</label>
                                        <select id="reveal-actor-@fact.Id" class="field-select field-sm" @bind="revealActorId[fact.Id]" data-testid="fact-reveal-actor">
                                            @if (PlayerCharacters.Count > 0)
                                            {
                                                <optgroup label="@L["Campaign.Lore.PlayerCharacters"]">
                                                    @foreach (var actor in PlayerCharacters)
                                                    {
                                                        <option value="@actor.Id">@actor.Name</option>
                                                    }
                                                </optgroup>
                                            }
                                            @if (OtherActors.Count > 0)
                                            {
                                                <optgroup label="@L["Campaign.Lore.Others"]">
                                                    @foreach (var actor in OtherActors)
                                                    {
                                                        <option value="@actor.Id">@actor.Name</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label for="reveal-level-@fact.Id" class="field-label">@L["Campaign.Lore.HowWell"]</label>
                                        <select id="reveal-level-@fact.Id" class="field-select field-sm" @bind="revealLevel[fact.Id]">
                                            @foreach (KnowledgeLevel level in Enum.GetValues<KnowledgeLevel>().Where(l => l != KnowledgeLevel.None))
                                            {
                                                <option value="@level">@LevelLabel(level)</option>
                                            }
                                        </select>
                                    </div>
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => RevealToActorAsync(fact)" disabled="@(Ctx.Actors.Count == 0)" data-testid="fact-reveal-to">@L["Campaign.Lore.RevealToCharacter"]</CodexButton>
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => RevealToPartyAsync(fact)" data-testid="fact-reveal-party"><LucideIcon IconName="eye" Size="14" /> @L["Campaign.Lore.RevealToParty"]</CodexButton>
                                }
                                else
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => HideAsync(fact)" data-testid="fact-hide"><LucideIcon IconName="eye-off" Size="14" /> @L["Campaign.Lore.HideAgain"]</CodexButton>
                                }
                                <span class="flex-grow-1"></span>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => BeginEdit(fact)" data-testid="fact-edit-open"><LucideIcon IconName="edit-3" Size="14" /> @L["Campaign.Lore.Edit"]</CodexButton>
                                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@L["Campaign.Lore.DeleteLabel", fact.Summary]" OnClick="() => DeleteAsync(fact)" data-testid="fact-delete" />
                            </div>
                        }
                        else
                        {
                            <div class="small-muted">@MyKnowledgeLabel(fact)</div>
                        }
                    }
                </article>
            }

            @if (WikiFiltered.Any())
            {
                <section class="panel" aria-labelledby="lore-wiki-heading" data-testid="lore-wiki">
                    <div class="panel-title">
                        <h3 id="lore-wiki-heading" class="h6"><LucideIcon IconName="book-open" Size="14" Class="title-icon" /> @(Ctx.IsDm ? L["Campaign.Lore.Wiki.Dm"] : L["Campaign.Lore.Wiki.Player"])</h3>
                    </div>
                    <p class="field-hint">@(Ctx.IsDm ? L["Campaign.Lore.Wiki.DmHint"] : L["Campaign.Lore.Wiki.PlayerHint"])</p>
                    <ul class="secret-list mb-0">
                        @foreach (var item in WikiFiltered)
                        {
                            <li class="secret-item secret-item-@item.Block.Marked.ToString().ToLowerInvariant()" data-testid="lore-wiki-item">
                                <a class="secret-item-text" href="@Ctx.BasePath/wiki/@item.Page.Slug">@SecretPreview(item.Block)</a>
                                <div class="secret-item-meta">
                                    <span><LucideIcon IconName="book-open" Size="12" /> @item.Page.Title</span>
                                    @if (Ctx.IsDm)
                                    {
                                        <span class="pill @StatusClass(item.Block)">@StatusLabel(item.Block)</span>
                                    }
                                    @if (item.Block.RevealedAt is { } at && item.Block.Marked != SecretAudience.Dm)
                                    {
                                        <span><LocalTime Value="at" Format="d MMM, HH:mm" /></span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    </div>
    @if (Ctx.IsDm)
    {
        <div class="col-lg-4">
            <section class="panel" aria-labelledby="new-fact-heading">
                <div class="panel-title"><h3 id="new-fact-heading">@L["Campaign.Lore.NewFact"]</h3></div>
                <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
                    <div class="mb-2">
                        <label for="fact-summary" class="field-label">@L["Campaign.Lore.Summary"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Campaign.Lore.Required"]</span></label>
                        <input id="fact-summary" class="field-input" @bind="newSummary" required data-testid="new-fact-summary" />
                    </div>
                    <div class="mb-2">
                        <label for="fact-details" class="field-label">@L["Campaign.Lore.Details"]</label>
                        <textarea id="fact-details" class="field-input" rows="3" @bind="newDetails" @bind:event="oninput" data-mentions="@mentionsJson" aria-describedby="fact-details-hint" data-testid="new-fact-details"></textarea>
                        <p id="fact-details-hint" class="field-hint">@L["Campaign.Lore.DetailsHint"]</p>
                    </div>
                    <div class="mb-3">
                        <label for="fact-visibility" class="field-label">@L["Campaign.Lore.WhoCanSee"]</label>
                        <select id="fact-visibility" class="field-select" @bind="newVisibility" data-testid="new-fact-visibility">
                            <option value="@FactVisibility.DmOnly">@L["Campaign.Lore.Vis.DmOnly"]</option>
                            <option value="@FactVisibility.KnowersOnly">@L["Campaign.Lore.Vis.KnowersOnly"]</option>
                            <option value="@FactVisibility.Public">@L["Campaign.Lore.Vis.Public"]</option>
                        </select>
                    </div>
                    <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Class="w-100" data-testid="new-fact-add">@L["Campaign.Lore.AddFact"]</CodexButton>
                </form>
            </section>
        </div>
    }
</div>

<ConfirmDialog @ref="confirm" />

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private ConfirmDialog confirm = null!;
    private List<FactDocument>? facts;
    private List<WikiPageDocument> pages = new();
    private MentionDirectory mentions = MentionDirectory.Empty;
    private string mentionsJson = "[]";
    private string search = string.Empty;
    private string activeChip = "All";
    private string newSummary = string.Empty;
    private string newDetails = string.Empty;
    private FactVisibility newVisibility = FactVisibility.DmOnly;
    private readonly Dictionary<string, string> revealActorId = new();
    private readonly Dictionary<string, KnowledgeLevel> revealLevel = new();
    private string? editingId;
    private string editSummary = string.Empty;
    private string editDetails = string.Empty;
    private FactVisibility editVisibility;
    private string? loadedFor;

    private sealed record WikiSecret(WikiPageDocument Page, SecretBlock Block);

    private IEnumerable<string> Chips => Ctx.IsDm ? new[] { "All", "Party", "Revealed", "DM only" } : new[] { "All", "Party", "Revealed to me" };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Ctx.Campaign.Id) return;
        loadedFor = Ctx.Campaign.Id;
        await LoadAsync();
        // "?about=actor:ID" or "?about=wiki:slug" (a page's or a sheet's "Add lore" link) starts a new fact about it.
        if (Ctx.IsDm && QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("about", out var about) && newDetails.Length == 0)
        {
            var key = about.ToString();
            newDetails = key.StartsWith("wiki:", StringComparison.Ordinal)
                ? pages.FirstOrDefault(p => p.Slug == key[5..]) is { } page ? $"[[{page.Title}]] " : string.Empty
                : key.StartsWith("actor:", StringComparison.Ordinal) || key.StartsWith("place:", StringComparison.Ordinal) ? mentions.ForEditing($"[[{key}]]") + " " : string.Empty;
        }
    }

    private async Task LoadAsync()
    {
        facts = (await FactRepo.GetVisibleForCampaignAsync(Ctx.Access, Ctx.OwnedActorIds)).OrderBy(f => f.Summary, StringComparer.CurrentCultureIgnoreCase).ToList();
        pages = (await WikiRepo.GetVisibleForCampaignAsync(Ctx.Access)).ToList();
        mentions = await MentionSources.DirectoryAsync(Ctx.Campaign, Ctx.Access, Ctx.Actors);
        mentionsJson = Ctx.IsDm ? MentionLinks.Json(mentions, Ctx.Actors) : "[]";
        var firstActor = PlayerCharacters.Concat(OtherActors).FirstOrDefault()?.Id ?? string.Empty;
        foreach (var fact in facts)
        {
            revealActorId.TryAdd(fact.Id, firstActor);
            revealLevel.TryAdd(fact.Id, KnowledgeLevel.Full);
        }
    }

    /// <summary>The characters players play, first in the reveal picker: a reveal is nearly always to one of them.</summary>
    private List<ActorDocument> PlayerCharacters => Ctx.Actors.Where(a => a.Kind == ActorKind.PlayerCharacter).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();

    private List<ActorDocument> OtherActors => Ctx.Actors.Where(a => a.Kind == ActorKind.NonPlayerCharacter).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();

    private IEnumerable<FactDocument> Filtered
    {
        get
        {
            IEnumerable<FactDocument> result = facts ?? new List<FactDocument>();
            result = activeChip switch
            {
                "Party" => result.Where(f => f.Visibility == FactVisibility.Public),
                "Revealed" or "Revealed to me" => result.Where(f => f.Visibility == FactVisibility.KnowersOnly),
                "DM only" => result.Where(f => f.Visibility == FactVisibility.DmOnly),
                _ => result
            };
            if (!string.IsNullOrWhiteSpace(search))
            {
                result = result.Where(f => f.Summary.Contains(search, StringComparison.OrdinalIgnoreCase) || (f.Details != null && mentions.Plain(f.Details).Contains(search, StringComparison.OrdinalIgnoreCase)));
            }

            return result;
        }
    }

    /// <summary>
    /// The wiki's secret blocks as lore. The DM gets every block they can reveal or hide, on every page. A player gets what
    /// was revealed to them, newest first: their copy of a page already holds only that, each revealed block marked with when
    /// (see <see cref="SecretText.ForPlayersMarked"/>), so nothing here is more than the pages themselves show.
    /// </summary>
    private IEnumerable<WikiSecret> WikiSecrets => Ctx.IsDm
        ? pages.SelectMany(p => SecretText.Blocks(p.Body).Where(b => !b.UnderDm && b.Marked is SecretAudience.Dm or SecretAudience.Party or SecretAudience.Some).Select(b => new WikiSecret(p, b)))
        : pages.SelectMany(p => SecretText.Blocks(p.Body).Where(b => b.Marked == SecretAudience.Party && b.RevealedAt != null).Select(b => new WikiSecret(p, b)))
            .OrderByDescending(s => s.Block.RevealedAt);

    private IEnumerable<WikiSecret> WikiFiltered
    {
        get
        {
            var result = WikiSecrets;
            result = activeChip switch
            {
                "Party" => result.Where(s => s.Block.Marked == SecretAudience.Party),
                "Revealed" => result.Where(s => s.Block.Marked == SecretAudience.Some),
                "DM only" => result.Where(s => s.Block.Marked == SecretAudience.Dm),
                "Revealed to me" => Enumerable.Empty<WikiSecret>(),
                _ => result
            };
            if (!string.IsNullOrWhiteSpace(search))
            {
                result = result.Where(s => s.Page.Title.Contains(search, StringComparison.OrdinalIgnoreCase) || mentions.Plain(s.Block.Inner).Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            return result;
        }
    }

    private string SecretPreview(SecretBlock block)
    {
        var text = WikiRender.Summary(block.Inner, mentions, 140, forDm: Ctx.IsDm);
        return string.IsNullOrWhiteSpace(text) ? L["Campaign.Wiki.Secrets.Empty"] : text;
    }

    private string StatusLabel(SecretBlock block) => block.Marked switch
    {
        SecretAudience.Party => L["Common.Secret.Party"],
        SecretAudience.Some => L["Common.Secret.Some", string.Join(", ", block.Knowers.Select(ActorName))],
        _ => L["Common.Secret.Dm"]
    };

    private static string StatusClass(SecretBlock block) => block.Marked switch
    {
        SecretAudience.Party => "pill-success",
        SecretAudience.Some => "pill-accent",
        _ => "pill-warning"
    };

    private string ActorName(string id) => Ctx.Actors.FirstOrDefault(a => a.Id == id)?.NameFor(Ctx.IsDm) ?? "?";

    private string ChipLabel(string chip) => chip switch
    {
        "Party" => L["Campaign.Lore.Chip.Party"],
        "Revealed" => L["Campaign.Lore.Chip.Revealed"],
        "Revealed to me" => L["Campaign.Lore.Chip.RevealedToMe"],
        "DM only" => L["Campaign.Lore.Chip.DmOnly"],
        _ => L["Campaign.Lore.Chip.All"]
    };

    private string LevelLabel(KnowledgeLevel level) => level switch
    {
        KnowledgeLevel.Rumor => L["Campaign.Lore.Level.Rumor"],
        KnowledgeLevel.Heard => L["Campaign.Lore.Level.Heard"],
        KnowledgeLevel.Witnessed => L["Campaign.Lore.Level.Witnessed"],
        KnowledgeLevel.Full => L["Campaign.Lore.Level.Full"],
        _ => L["Campaign.Lore.Level.None"]
    };

    private string VisibilityLabel(FactDocument fact) => fact.Visibility switch
    {
        FactVisibility.Public => L["Campaign.Lore.Chip.Party"],
        FactVisibility.KnowersOnly => L["Campaign.Lore.Chip.Revealed"],
        _ => L["Campaign.Lore.Chip.DmOnly"]
    };

    private static string VisibilityClass(FactDocument fact) => fact.Visibility switch
    {
        FactVisibility.Public => "pill-success",
        FactVisibility.KnowersOnly => "pill-accent",
        _ => "pill-warning"
    };

    private string MyKnowledgeLabel(FactDocument fact)
    {
        if (fact.Visibility == FactVisibility.Public) return L["Campaign.Lore.KnownToParty"];
        var mine = fact.KnownBy.Where(k => Ctx.OwnedActorIds.Contains(k.EntityId)).OrderByDescending(k => k.Level).FirstOrDefault();
        return mine == null ? string.Empty : L["Campaign.Lore.KnownTo", Ctx.Actors.FirstOrDefault(a => a.Id == mine.EntityId)?.Name ?? L["Campaign.Lore.YourCharacter"], LevelLabel(mine.Level)];
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newSummary)) return;
        var fact = new FactDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = Ctx.Campaign.Id,
            Summary = newSummary.Trim(),
            Details = string.IsNullOrWhiteSpace(newDetails) ? null : mentions.Encode(newDetails.Trim()),
            Visibility = newVisibility
        };
        if (await FactRepo.SaveAsync(fact, Ctx.Access))
        {
            newSummary = string.Empty;
            newDetails = string.Empty;
            Ctx.Notify(Flash.Success(L["Campaign.Lore.FactAdded"]));
            await LoadAsync();
        }
    }

    private void BeginEdit(FactDocument fact)
    {
        editingId = fact.Id;
        editSummary = fact.Summary;
        editDetails = mentions.ForEditing(fact.Details ?? string.Empty);
        editVisibility = fact.Visibility;
    }

    private async Task SaveEditAsync(FactDocument fact)
    {
        if (string.IsNullOrWhiteSpace(editSummary)) return;
        var changed = new FactDocument
        {
            Id = fact.Id,
            CampaignId = fact.CampaignId,
            Summary = editSummary,
            Details = string.IsNullOrWhiteSpace(editDetails) ? null : mentions.Encode(editDetails.Trim()),
            Visibility = editVisibility,
            KnownBy = fact.KnownBy,
            Metadata = fact.Metadata
        };
        if (await FactRepo.SaveAsync(changed, Ctx.Access))
        {
            editingId = null;
            Ctx.Notify(Flash.Success(L["Campaign.Lore.FactSaved"]));
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(FactDocument fact)
    {
        if (!await confirm.ShowAsync(L["Campaign.Lore.DeleteQ", fact.Summary], L["Campaign.Lore.DeleteBody"], L["Campaign.Lore.Delete"], isDestructive: true)) return;
        if (await FactRepo.DeleteAsync(fact.Id, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Lore.Deleted"]));
            await LoadAsync();
        }
    }

    private async Task RevealToActorAsync(FactDocument fact)
    {
        if (!revealActorId.TryGetValue(fact.Id, out var actorId) || string.IsNullOrEmpty(actorId)) return;
        var level = revealLevel.GetValueOrDefault(fact.Id, KnowledgeLevel.Full);
        if (await FactRepo.AddKnowerAsync(fact.Id, new KnowerEntry(actorId, level), Ctx.Access))
        {
            var name = Ctx.Actors.FirstOrDefault(a => a.Id == actorId)?.Name ?? L["Campaign.Lore.TheCharacter"];
            Ctx.Notify(Flash.Success(L["Campaign.Lore.RevealedTo", name]));
            await LoadAsync();
        }
    }

    private async Task ForgetAsync(FactDocument fact, string actorId)
    {
        if (await FactRepo.RemoveKnowerAsync(fact.Id, actorId, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Lore.Forgotten", ActorName(actorId)]));
            await LoadAsync();
        }
    }

    private async Task RevealToPartyAsync(FactDocument fact)
    {
        if (await FactRepo.SetVisibilityAsync(fact.Id, FactVisibility.Public, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Lore.RevealedToParty"]));
            await LoadAsync();
        }
    }

    /// <summary>Takes a fact back from the party: the characters it was revealed to keep it, everyone else loses it.</summary>
    private async Task HideAsync(FactDocument fact)
    {
        var to = fact.KnownBy.Count > 0 ? FactVisibility.KnowersOnly : FactVisibility.DmOnly;
        if (await FactRepo.SetVisibilityAsync(fact.Id, to, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Lore.Hidden"]));
            await LoadAsync();
        }
    }
}
