@using Codex.Core
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject ICampaignRepository CampaignRepo
@inject CampaignLibrary Library
@inject CastService Cast
@inject NavigationManager Nav

@* The campaign's creatures: for the DM, a shortlist of Library creatures planned for upcoming
   encounters plus everything currently in the cast; for players, the creatures they have met. *@

@{
    var inPlay = Ctx.Actors.Where(a => a.Kind == ActorKind.Monster).OrderBy(a => a.Name).ToList();
}

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@(Ctx.IsDm ? L["Campaign.Bestiary.Title.Dm"] : L["Campaign.Bestiary.Title.Player"])</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? L["Campaign.Bestiary.Subtitle.Dm"] : L["Campaign.Bestiary.Subtitle.Player"])</p>
    </div>
    @if (Ctx.IsDm)
    {
        <div class="row-actions">
            <a href="@Ctx.BasePath/library/monster?new=1" class="cx-btn cx-plaque" data-testid="new-homebrew-creature"><LucideIcon IconName="plus" Size="18" /> @L["Campaign.Bestiary.NewHomebrew"]</a>
        </div>
    }
</div>

@if (!Ctx.IsDm)
{
    @if (inPlay.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><LucideIcon IconName="paw-print" Size="28" /></div>
            <h3>@L["Campaign.Bestiary.Met.Title"]</h3>
            <p>@L["Campaign.Bestiary.Met.Body"]</p>
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var actor in inPlay)
            {
                <article class="campaign-card creature-card">
                    <div class="d-flex gap-3 align-items-center">
                        <ActorAvatar Actor="actor" DisplayName="@PublicName(actor)" Size="lg" />
                        <div>
                            <h3 class="h6 mb-0"><a href="@Ctx.BasePath/actors/@actor.Id">@PublicName(actor)</a></h3>
                            <div class="small-muted">@(actor.Visibility == ActorVisibility.Unknown ? (actor.PublicDescription ?? L["Campaign.Bestiary.NotIdentified"]) : L["Campaign.Bestiary.Monster"])</div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
}
else
{
    <div class="row g-3">
        <div class="col-lg-7">
            <section class="panel" aria-labelledby="shortlist-heading">
                <div class="panel-title"><h3 id="shortlist-heading"><LucideIcon IconName="bookmark" Size="18" Class="title-icon" /> @L["Campaign.Bestiary.Shortlist", Ctx.Campaign.Bestiary.Count]</h3></div>
                @if (Ctx.Campaign.Bestiary.Count == 0)
                {
                    <p class="small-muted mb-0">@L["Campaign.Bestiary.ShortlistEmpty"]</p>
                }
                <ul class="list-unstyled mb-0" data-testid="bestiary-shortlist">
                    @foreach (var entry in Ctx.Campaign.Bestiary.OrderBy(e => e.Name))
                    {
                        <li class="list-row align-items-start" data-testid="bestiary-row">
                            <span class="avatar avatar-md avatar-flat" aria-hidden="true"><LucideIcon IconName="skull" Size="18" /></span>
                            <div class="row-main">
                                <div class="row-title">
                                    <a href="@Ctx.BasePath/library/@entry.EntryType/@Uri.EscapeDataString(entry.EntryId)">@entry.Name</a>
                                    @if (entry.IsHomebrew)
                                    {
                                        <span class="pill pill-accent ms-1">@L["Campaign.Bestiary.Homebrew"]</span>
                                    }
                                </div>
                                <div class="row-sub">
                                    <label for="bb-note-@entry.Key" class="visually-hidden">@L["Campaign.Bestiary.NoteFor", entry.Name]</label>
                                    <input id="bb-note-@entry.Key" class="field-input field-sm inline-input" placeholder="@L["Campaign.Bestiary.NotePlaceholder"]" value="@entry.Note" @onchange="e => SetNoteAsync(entry, e.Value?.ToString())" />
                                </div>
                            </div>
                            <div class="row-actions">
                                <label for="bb-count-@entry.Key" class="visually-hidden">@L["Campaign.Bestiary.HowMany"]</label>
                                <input id="bb-count-@entry.Key" type="number" min="1" max="20" class="field-input field-sm count-input" value="@entry.Count" @onchange="e => SetCountAsync(entry, e.Value?.ToString())" />
                                <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => AddToCastAsync(entry)" aria-label="@L["Campaign.Bestiary.AddToCastLabel", entry.Count, entry.Name]"><LucideIcon IconName="user-plus" Size="14" /> @L["Campaign.Bestiary.ToCast"]</CodexButton>
                                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="x" Label="@L["Campaign.Bestiary.RemoveFromShortlist", entry.Name]" OnClick="() => RemoveAsync(entry)" />
                            </div>
                        </li>
                    }
                </ul>
            </section>

            <section class="panel" aria-labelledby="inplay-heading">
                <div class="panel-title"><h3 id="inplay-heading"><LucideIcon IconName="swords" Size="18" Class="title-icon" /> @L["Campaign.Bestiary.InCast", inPlay.Count]</h3></div>
                @if (inPlay.Count == 0)
                {
                    <p class="small-muted mb-0">@L["Campaign.Bestiary.NoMonsters"]</p>
                }
                <ul class="list-unstyled mb-0">
                    @foreach (var actor in inPlay)
                    {
                        var hp = ActorSheetSync.PrimaryResource(actor, Ctx.System);
                        <li class="list-row">
                            <ActorAvatar Actor="actor" Size="md" />
                            <div class="row-main">
                                <div class="row-title"><a href="@Ctx.BasePath/actors/@actor.Id">@actor.Name</a>
                                    @if (actor.Visibility != ActorVisibility.Known)
                                    {
                                        <span class="pill pill-warning ms-1">@(actor.Visibility == ActorVisibility.Hidden ? L["Campaign.Bestiary.Hidden"] : L["Campaign.Bestiary.Unidentified"])</span>
                                    }
                                </div>
                                <div class="row-sub">@(hp.Max > 0 ? $"{hp.Current}/{hp.Max} {hp.Label}" : "")</div>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <div class="col-lg-5">
            <section class="panel" aria-labelledby="find-heading">
                <div class="panel-title"><h3 id="find-heading"><LucideIcon IconName="search" Size="18" Class="title-icon" /> @L["Campaign.Bestiary.Find"]</h3></div>
                <div class="search mb-2">
                    <LucideIcon IconName="search" Size="18" Class="search-icon" />
                    <label for="bestiary-search" class="visually-hidden">@L["Campaign.Bestiary.Search"]</label>
                    <input id="bestiary-search" type="search" class="field-input" placeholder="@L["Campaign.Bestiary.SearchPlaceholder"]" value="@query" @oninput="OnQueryChanged" data-testid="bestiary-search" />
                </div>
                @if (results == null)
                {
                    <LoadingSkeleton Rows="3" />
                }
                else if (results.Count == 0)
                {
                    <p class="small-muted mb-0">@L["Campaign.Bestiary.NoMatch"]</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in results.Take(30))
                        {
                            var shortlisted = Ctx.Campaign.Bestiary.Any(b => b.EntryType == item.Entry.Type && b.EntryId == item.Entry.Id && b.IsHomebrew == item.IsHomebrew);
                            <li class="list-row">
                                <div class="row-main">
                                    <div class="row-title"><a href="@Ctx.BasePath/library/@item.Entry.Type/@Uri.EscapeDataString(item.Entry.Id)">@item.Entry.Name</a>
                                        @if (item.IsHomebrew)
                                        {
                                            <span class="pill pill-accent ms-1">@L["Campaign.Bestiary.Homebrew"]</span>
                                        }
                                    </div>
                                    <div class="row-sub">@Summary(item)</div>
                                </div>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => ShortlistAsync(item)" Disabled="@shortlisted" aria-label="@(shortlisted ? L["Campaign.Bestiary.IsShortlisted", item.Entry.Name] : L["Campaign.Bestiary.ShortlistThis", item.Entry.Name])">
                                    <LucideIcon IconName="@(shortlisted ? "check" : "bookmark-plus")" Size="14" /> @(shortlisted ? L["Campaign.Bestiary.Listed"] : L["Campaign.Bestiary.ShortlistBtn"])
                                </CodexButton>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private List<LibraryItem>? results;
    private string query = string.Empty;
    private CancellationTokenSource? debounce;

    private IEnumerable<string> CreatureTypes => (Ctx.System?.EntityTypes ?? new List<ContentTypeDefinition>()).Where(t => t.ActorBlueprint).Select(t => t.Type).DefaultIfEmpty("monster");

    protected override async Task OnInitializedAsync()
    {
        if (Ctx.IsDm) await SearchAsync();
    }

    private string PublicName(ActorDocument actor) =>
        actor.Visibility == ActorVisibility.Unknown && !string.IsNullOrWhiteSpace(actor.PublicName) ? actor.PublicName : actor.Name;

    private async Task SearchAsync()
    {
        var found = new List<LibraryItem>();
        foreach (var type in CreatureTypes)
        {
            found.AddRange(await Library.SearchAsync(Ctx.Campaign, Ctx.Access, query, type, limit: 60, culture: L.Culture.Name));
        }

        results = found;
    }

    private async Task OnQueryChanged(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        try { await Task.Delay(150, debounce.Token); } catch (TaskCanceledException) { return; }
        await SearchAsync();
    }

    private string Summary(LibraryItem item)
    {
        var type = Ctx.System?.FindType(item.Entry.Type);
        // Values go through the field's translation (size, creature type), as they do in the Library; the stored text stays as it is.
        string Shown(string key, object value)
        {
            var field = type?.Fields.FirstOrDefault(f => f.Key == key);
            return value is IEnumerable<object> list && value is not string
                ? string.Join(", ", list.Select(o => field?.Display(o?.ToString() ?? string.Empty) ?? o?.ToString()))
                : field?.Display(value.ToString() ?? string.Empty) ?? value.ToString() ?? string.Empty;
        }

        var parts = (type?.SummaryFields ?? new List<string>())
            .Select(key => item.Entry.Properties.TryGetValue(key, out var v) && v != null ? $"{type!.Fields.FirstOrDefault(f => f.Key == key)?.Label ?? key} {Shown(key, v)}" : null)
            .Where(p => p != null);
        var text = string.Join(" · ", parts);
        return text.Length > 0 ? text : TextFormatting.Summary(item.Entry.Description, 90);
    }

    /// <summary>Applies one small edit to the stored shortlist (reload-then-mutate, so a member who
    /// joined or a session started since this page opened is not overwritten) and refreshes the page's copy.</summary>
    private async Task EditBestiaryAsync(Action<List<BestiaryEntry>> edit)
    {
        var stored = await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign => edit(campaign.Bestiary));
        if (stored != null)
        {
            Ctx.Campaign.Bestiary = stored.Bestiary;
        }
    }

    private async Task ShortlistAsync(LibraryItem item)
    {
        var entry = new BestiaryEntry { EntryType = item.Entry.Type, EntryId = item.Entry.Id, IsHomebrew = item.IsHomebrew, Name = item.Entry.Name };
        await EditBestiaryAsync(list =>
        {
            if (!list.Any(b => b.Key == entry.Key)) list.Add(entry);
        });
        Ctx.Notify(Flash.Success(L["Campaign.Bestiary.Shortlisted", item.Entry.Name]));
    }

    private Task RemoveAsync(BestiaryEntry entry) => EditBestiaryAsync(list => list.RemoveAll(b => b.Key == entry.Key));

    private Task SetNoteAsync(BestiaryEntry entry, string? note)
    {
        var text = string.IsNullOrWhiteSpace(note) ? null : note.Trim();
        return EditBestiaryAsync(list =>
        {
            if (list.FirstOrDefault(b => b.Key == entry.Key) is { } stored) stored.Note = text;
        });
    }

    private Task SetCountAsync(BestiaryEntry entry, string? raw)
    {
        if (!int.TryParse(raw, out var count)) return Task.CompletedTask;
        var clamped = Math.Clamp(count, 1, 20);
        return EditBestiaryAsync(list =>
        {
            if (list.FirstOrDefault(b => b.Key == entry.Key) is { } stored) stored.Count = clamped;
        });
    }

    private async Task AddToCastAsync(BestiaryEntry entry)
    {
        var item = await Library.GetAsync(Ctx.Campaign, Ctx.Access, entry.EntryType, entry.EntryId);
        if (item == null)
        {
            Ctx.Notify(Flash.Error(L["Campaign.Bestiary.GoneFromLibrary", entry.Name]));
            return;
        }

        var created = await Cast.AddToCastAsync(item, Ctx.Campaign, Ctx.System, Ctx.Access, entry.Count);
        if (created.Count == 0)
        {
            Ctx.Notify(Flash.Error(L["Campaign.Bestiary.CannotCreate"]));
            return;
        }

        Ctx.Notify(Flash.Success(L["Campaign.Bestiary.AddedToCast", created.Count, entry.Name]));
        await Ctx.ReloadAsync();
    }
}
