@inherits BookPart
@using Codex.Core.Book
@using Codex.Persistence
@using Codex.Web.Book
@using static Codex.Web.Components.Campaign.BookPage

        @if (!previewOpen)
        {
            <button type="button" class="book-draft-strip" @onclick="() => TogglePaneAsync(Pane.Preview)" aria-expanded="false"
                    aria-label="@L["Campaign.Book.Draft.ExpandNamed", L["Campaign.Book.Draft.Preview"]]" data-testid="book-draft-pane-preview-toggle">
                <LucideIcon IconName="panel-right-open" Size="14" /> <span>@L["Campaign.Book.Draft.Preview"]</span>
            </button>
        }
        <section class="book-draft-pane book-draft-preview @(previewOpen ? null : "offstage")" aria-labelledby="book-draft-preview-title" aria-hidden="@(previewOpen ? null : "true")">
            <div class="book-draft-pane-head">
                <span id="book-draft-preview-title"><LucideIcon IconName="eye" Size="14" /> @L["Campaign.Book.Draft.Preview"]</span>
                <span class="flex-grow-1"></span>
                <button type="button" class="book-draft-pane-btn" @onclick="() => TogglePaneAsync(Pane.Preview)" aria-expanded="true"
                        title="@L["Campaign.Book.Draft.Collapse"]" aria-label="@L["Campaign.Book.Draft.CollapseNamed", L["Campaign.Book.Draft.Preview"]]" data-testid="@(previewOpen ? "book-draft-pane-preview-toggle" : null)">
                    <LucideIcon IconName="panel-right-close" Size="14" />
                </button>
            </div>
            <div class="field-error small px-2" data-overflow hidden data-testid="book-draft-overflow"></div>
            <div class="small-muted small px-2" data-run-on hidden data-testid="book-draft-run-on"></div>
            <iframe class="book-draft-frame" @ref="frame" sandbox="allow-same-origin" title="@L["Campaign.Book.PreviewTitle"]" data-testid="book-draft-preview"></iframe>
        </section>
