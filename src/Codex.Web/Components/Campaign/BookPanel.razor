@using System.Globalization
@using Codex.Core.AI
@using Codex.Core.Book
@using Codex.Persistence
@using Codex.Web.Book
@implements IDisposable
@inject IJSRuntime JS
@inject BookBuilds Builds
@inject NavigationManager Nav

<section class="panel book-panel" aria-labelledby="book-heading" data-testid="book-panel">
    <div class="panel-title"><h3 id="book-heading">@L["Campaign.Book.Title"]</h3></div>
    <p class="small-muted">@L["Campaign.Book.Hint"]</p>

    <div class="row g-2">
        <div class="col-12">
            <label for="book-edition" class="field-label">@L["Campaign.Book.Edition"]</label>
            <select id="book-edition" class="field-input" @bind="edition" @bind:after="Changed" data-testid="book-edition">
                <option value="dm">@L["Campaign.Book.Edition.Dm"]</option>
                <option value="party">@L["Campaign.Book.Edition.Party"]</option>
            </select>
            <div class="field-hint">@(edition == "dm" ? L["Campaign.Book.Edition.DmHint"] : L["Campaign.Book.Edition.PartyHint"])</div>
        </div>
        <div class="col-12">
            <label for="book-theme" class="field-label">@L["Campaign.Book.Look"]</label>
            <select id="book-theme" class="field-input" @bind="themeId" @bind:after="ThemeChanged" data-testid="book-theme">
                @foreach (var theme in BookThemes.All)
                {
                    <option value="@theme.Id">@theme.Name</option>
                }
            </select>
        </div>
        <div class="col-6">
            <label for="book-language" class="field-label">@L["Campaign.Book.Language"]</label>
            <select id="book-language" class="field-input" @bind="language" @bind:after="Changed" data-testid="book-language">
                @foreach (var (tag, native) in SupportedCultures.All)
                {
                    var ok = Theme.Supports(tag);
                    <option value="@tag" disabled="@(!ok)">@(ok ? native : L["Campaign.Book.LanguageUnsupported", native])</option>
                }
            </select>
        </div>
        <div class="col-6">
            <label for="book-size" class="field-label">@L["Campaign.Book.Paper"]</label>
            <select id="book-size" class="field-input" @bind="size" @bind:after="Changed" data-testid="book-size">
                <option value="A4">A4</option>
                <option value="Letter">Letter</option>
            </select>
        </div>
        <div class="col-6">
            <label for="book-cols" class="field-label">@L["Campaign.Book.Columns"]</label>
            <select id="book-cols" class="field-input" @bind="columns" @bind:after="Changed" data-testid="book-cols">
                <option value="1">@L["Campaign.Book.Columns.One"]</option>
                <option value="2">@L["Campaign.Book.Columns.Two"]</option>
            </select>
        </div>
    </div>
    <label class="form-check mt-2"><input type="checkbox" class="form-check-input" @bind="pictures" @bind:after="Changed" data-testid="book-pictures" /> @L["Campaign.Book.Pictures"]</label>
    <div class="field-hint">@L["Campaign.Book.Pictures.Hint"]</div>
    @if (Ctx.Access.IsDm)
    {
        <BookArtTray Access="Ctx.Access" Edition="@edition" Language="@language" Changed="ArtChanged" />
    }
    <div class="field-hint">@L["Campaign.Book.ThemeNote", Theme.Name]</div>

    <div class="d-flex gap-2 flex-wrap mt-2">
        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="TogglePreview" aria-expanded="@(showPreview ? "true" : "false")" aria-controls="book-preview-frame" data-testid="book-preview-toggle">
            <LucideIcon IconName="@(showPreview ? "eye-off" : "eye")" Size="14" /> @(showPreview ? L["Campaign.Book.HidePreview"] : L["Campaign.Book.Preview"])
        </CodexButton>
        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="DownloadAsync" Disabled="@busy" data-testid="book-download">
            <LucideIcon IconName="download" Size="14" /> @(busy ? L["Campaign.Book.Printing"] : L["Campaign.Book.Download"])
        </CodexButton>
    </div>

    <div role="status" aria-live="polite" class="mt-2" data-testid="book-status">
        @if (error != null)
        {
            <div class="field-error" data-testid="book-error">@error@if (errorDetail != null) { <text> </text><bdi dir="auto">@errorDetail</bdi> }</div>
        }
        else if (done)
        {
            <div class="small-muted" data-testid="book-done">@L["Campaign.Book.Done"]</div>
        }
    </div>


    @if (Ctx.Access.IsDm)
    {
        <hr class="my-3" />
        <div data-testid="book-draft-panel">
            <h4 class="h6">@L["Campaign.Book.Draft.PanelTitle"]</h4>
            <p class="small-muted">@L["Campaign.Book.Draft.PanelHint"]</p>
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="EditDraftAsync" data-testid="book-draft-open">
                <LucideIcon IconName="pencil" Size="14" /> @L["Campaign.Book.Draft.Open", edition == "dm" ? L["Campaign.Book.Edition.Dm"] : L["Campaign.Book.Edition.Party"]]
            </CodexButton>
        </div>
        <BookDraftEditor @ref="draftEditor" Access="Ctx.Access" BasePath="@Ctx.BasePath" />

        <hr class="my-3" />
        <div data-testid="book-ai">
            <h4 class="h6">@L["Campaign.Book.Ai.Title"]</h4>
            <p class="small-muted">@L["Campaign.Book.Ai.Hint"]</p>

            @if (preview?.Model is { } model)
            {
                <div class="small-muted" data-testid="book-ai-model">@L["Campaign.Book.Ai.Model", model.Label]</div>
            }
            else if (preview != null)
            {
                <div class="small-muted" data-testid="book-ai-nomodel">@L["Campaign.Book.Ai.NoModel"] <a href="/settings/ai">@L["Campaign.Book.Ai.SetUp"]</a></div>
            }

            <label for="book-ai-style" class="field-label mt-2">@L["Campaign.Book.Ai.Style"]</label>
            <input id="book-ai-style" class="field-input" maxlength="@BookBuildRequest.MaxStyleChars" @bind="style" @bind:after="PreviewAsync" disabled="@Running" data-testid="book-ai-style" />
            <div class="field-hint">@L["Campaign.Book.Ai.StyleHint"]</div>

            @if (preview is { StyleProblems.Count: > 0 })
            {
                <div class="field-error" role="alert" data-testid="book-ai-style-refused">@L["Campaign.Book.Ai.StyleRefused", string.Join("; ", preview.StyleProblems)]</div>
            }

            @if (preview != null)
            {
                <div class="mt-2 field-label">@L["Campaign.Book.Ai.Chapters"]</div>
                <ul class="list-unstyled small mb-2" data-testid="book-ai-chapters">
                    @foreach (var chapter in preview.Chapters)
                    {
                        <li class="d-flex gap-2 align-items-baseline flex-wrap">
                            <bdi dir="auto">@chapter.Title</bdi>
                            <span class="small-muted">@ChapterState(chapter)</span>
                            @if (chapter.State == BookSectionState.Current && preview.Model != null && !Running)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ToggleRedo(chapter.Id)" aria-pressed="@(redo.Contains(chapter.Id) ? "true" : "false")">@L["Campaign.Book.Ai.Redo"]</button>
                            }
                            else if (redo.Contains(chapter.Id))
                            {
                                <span class="small-muted">@L["Campaign.Book.Ai.Redo"]</span>
                            }
                        </li>
                    }
                </ul>

                <div role="status" aria-live="polite" data-testid="book-ai-preflight">
                    @if (preview.Preflight is not { } flight)
                    {
                        <div class="small-muted">@L["Campaign.Book.Ai.Preflight.None"]</div>
                    }
                    else
                    {
                        <div class="small">@L["Campaign.Book.Ai.Preflight.Summary", preview.ToBuild, flight.RequestsMin, flight.RequestsMax]</div>
                        <div class="small-muted">@L["Campaign.Book.Ai.Preflight.Tokens", Number(flight.InputLow), Number(flight.InputHigh), Number(flight.OutputHigh * 2)]</div>
                        @if (flight.CostLow is { } low && flight.CostHigh is { } high)
                        {
                            <div class="small-muted">@L["Campaign.Book.Ai.Preflight.Cost", Money(low), Money(high)]</div>
                        }
                        else if (preview.Model != null)
                        {
                            <div class="small-muted">@L["Campaign.Book.Ai.Preflight.NoPrice"]</div>
                        }

                        @if (preview.Model?.ServerUsedToday is { } server && server.Limit > 0)
                        {
                            <div class="small-muted">@L["Campaign.Book.Ai.Preflight.Allowance", server.Used, server.Limit, flight.RequestsMax]</div>
                        }
                    }
                </div>

                @if (preview.Preflight != null && preview.Model != null)
                {
                    <label for="book-ai-cap" class="field-label mt-2">@L["Campaign.Book.Ai.Cap"]</label>
                    <input id="book-ai-cap" type="number" min="0" step="1000" class="field-input" value="@Cap" @onchange="CapChanged" disabled="@Running" data-testid="book-ai-cap" />
                    <div class="field-hint">@L["Campaign.Book.Ai.CapHint"]</div>
                    @if (Cap < preview.MinimumCap)
                    {
                        <div class="field-error" role="alert" data-testid="book-ai-cap-low">@L["Campaign.Book.Ai.CapTooLow", Number(preview.MinimumCap)]</div>
                    }
                }

                <div class="d-flex gap-2 flex-wrap mt-2">
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="StartAsync" Disabled="@(Running || preview.Model == null || preview.Preflight == null || Cap < preview.MinimumCap || preview.StyleProblems.Count > 0)" data-testid="book-ai-start">
                        <LucideIcon IconName="sparkles" Size="14" /> @L["Campaign.Book.Ai.Start"]
                    </CodexButton>
                    @if (Running)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="StopRun" data-testid="book-ai-stop">
                            <LucideIcon IconName="square" Size="14" /> @L["Campaign.Book.Ai.Stop"]
                        </CodexButton>
                    }
                    @if (preview.Totals != null && !Running)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="DiscardAsync" data-testid="book-ai-discard">
                            <LucideIcon IconName="trash-2" Size="14" /> @L["Campaign.Book.Ai.Discard"]
                        </CodexButton>
                    }
                </div>
            }

            @if (aiError != null)
            {
                <div class="field-error mt-2" role="alert" data-testid="book-ai-error">@aiError</div>
            }

            @if (run?.Snapshot() is { } now)
            {
                <div class="mt-2" role="status" aria-live="polite" data-testid="book-ai-progress">
                    <div class="small">
                        @(now.Status switch
                        {
                            BookRunStatus.Running => L["Campaign.Book.Ai.Status.Running"] + " " + L["Campaign.Book.Ai.Progress", now.Finished, now.Rows.Count],
                            BookRunStatus.Done => L["Campaign.Book.Ai.Status.Done", now.Refined, now.Rows.Count],
                            BookRunStatus.Stopped => L["Campaign.Book.Ai.Status.Stopped", now.Refined, now.Rows.Count],
                            _ => L["Campaign.Book.Ai.Status.Failed", now.Failure ?? string.Empty]
                        })
                    </div>
                    <progress class="w-100" max="@Math.Max(1, now.Rows.Count)" value="@now.Finished" aria-label="@L["Campaign.Book.Ai.Progress", now.Finished, now.Rows.Count]"></progress>
                    <div class="small-muted">@L["Campaign.Book.Ai.Meter", now.Budget.Calls, Number(now.Budget.InputTokens), Number(now.Budget.OutputTokens)]
                        @if (now.Budget.Cost(now.Price) is { } cost) { <text> · </text>@L["Campaign.Book.Ai.Money", Money(cost, now.Price)] }
                    </div>
                    @if (now.Budget.Estimated)
                    {
                        <div class="small-muted">@L["Campaign.Book.Ai.Estimated"]</div>
                    }
                    @if (now.SaveFailed)
                    {
                        <div class="field-error">@L["Campaign.Book.Ai.SaveFailed"]</div>
                    }
                    <ul class="list-unstyled small mt-1 mb-0">
                        @foreach (var row in now.Rows.Where(r => r.Status != BookRowStatus.Cached || Running))
                        {
                            <li><bdi dir="auto">@row.Title</bdi> <span class="small-muted">@RowText(row)</span></li>
                        }
                    </ul>
                </div>
            }

            @if (preview?.Totals is { } totals)
            {
                <div class="small-muted mt-2" data-testid="book-ai-totals">
                    @L["Campaign.Book.Ai.Totals", totals.Calls, Number(totals.InputTokens), Number(totals.OutputTokens)]
                    @if (totals.Estimated) { <text> </text>@L["Campaign.Book.Ai.Estimated"] }
                    @if (totals.UnpricedRuns == 0 && totals.Runs > 0 && totals.Cost > 0) { <text> </text>@L["Campaign.Book.Ai.TotalsCost", AiPrice.Format(totals.Cost, totals.PriceLabel, CultureInfo.CurrentCulture)] }
                    else if (totals.Cost > 0) { <text> </text>@L["Campaign.Book.Ai.TotalsCostPartial", AiPrice.Format(totals.Cost, totals.PriceLabel, CultureInfo.CurrentCulture)] }
                </div>
            }

            <div class="form-check mt-2">
                <input id="book-ai-use" type="checkbox" class="form-check-input" checked="@useAi" @onchange="UseAiChanged" data-testid="book-ai-use" />
                <label for="book-ai-use" class="form-check-label small">@L["Campaign.Book.Ai.Use"]</label>
            </div>
        </div>
    }

    @if (showPreview)
    {
        @* The page is the one the PDF is printed from. It is sandboxed with no permissions at all (no script, no same-origin) and
           the page's own policy allows no fetch, so what a campaign's text holds cannot reach the app around it. *@
        <iframe id="book-preview-frame" class="book-preview" sandbox="" title="@L["Campaign.Book.PreviewTitle"]" src="@PageUrl()" loading="lazy" data-testid="book-preview"></iframe>
    }
</section>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private string edition = "dm";
    private string size = "A4";
    private string columns = "2";
    private bool pictures = true;
    private string language = "en";
    private bool showPreview;
    private bool busy;
    private bool done;
    private string? error;
    private string? errorDetail;

    private string themeId = BookThemes.Plain.Id;
    private BookDraftEditor? draftEditor;

    // The editable book of the edition and language chosen above; it is made from the campaign the first time.
    private Task EditDraftAsync() => draftEditor?.OpenAsync(edition, language, size == "Letter" ? "Letter" : "A4") ?? Task.CompletedTask;

    private BookTheme Theme => BookThemes.Find(themeId) ?? BookThemes.Plain;

    protected override async Task OnInitializedAsync()
    {
        // The book follows the reader's language when the theme can print it, and otherwise the theme's own: asking for the
        // other would only be refused.
        var current = SupportedCultures.Normalize(CultureInfo.CurrentUICulture.Name);
        language = Theme.Supports(current) ? current : SupportedCultures.Tags.First(Theme.Supports);
        await PreviewAsync();
        Attach(Builds.Find(Ctx.Access, edition));
    }

    private string PageUrl(bool pdf = false) =>
        $"{Ctx.BasePath}/book/{edition}{(pdf ? "/pdf" : string.Empty)}?lang={Uri.EscapeDataString(language)}&size={Uri.EscapeDataString(size)}&cols={columns}&pics={(pictures ? "1" : "0")}&theme={Theme.Id}{(useAi ? "&ai=1" : string.Empty)}&_={previewStamp}";

    private int previewStamp;

    // A look that cannot print the chosen language moves the language to one it can, as OnInitialized does: asking for it would be refused.
    private void ThemeChanged()
    {
        if (!Theme.Supports(language)) language = SupportedCultures.Tags.First(Theme.Supports);
        Changed();
    }

    private void Changed()
    {
        done = false;
        error = errorDetail = null;
        // The stored build belongs to one edition and one language: what is current changes with them.
        Attach(Builds.Find(Ctx.Access, edition));
        _ = PreviewAsync();
    }

    // A picture put in or taken out of a slot shows in the preview at once.
    private void ArtChanged()
    {
        done = false;
        previewStamp++;
    }

    private void TogglePreview()
    {
        showPreview = !showPreview;
        previewStamp++;
    }

    private async Task DownloadAsync()
    {
        busy = true;
        done = false;
        error = errorDetail = null;
        try
        {
            var result = await JS.InvokeAsync<BookDownload>("codex.downloadFrom", Nav.ToAbsoluteUri(PageUrl(pdf: true)).ToString());
            if (result.Status == 200)
            {
                done = true;
            }
            else
            {
                error = (result.Status, result.Code) switch
                {
                    (422, _) => L["Campaign.Book.Failed.Language"],
                    (429, _) => L["Campaign.Book.Failed.Busy"],
                    (503, "no-browser") => L["Campaign.Book.Failed.NoBrowser"],
                    (503, "browser-too-old") => L["Campaign.Book.Failed.TooOld"],
                    (503, "launch-failed") => L["Campaign.Book.Failed.Launch"],
                    (504, _) => L["Campaign.Book.Failed.Timeout"],
                    _ => L["Campaign.Book.Failed.Other"]
                };
                // The setup sentence names an environment variable, which the person who runs the app needs; it is in English and
                // is shown as its own run so a right-to-left sentence around it does not reorder it.
                errorDetail = result is { Status: 503, Code: "no-browser" } ? result.Detail : null;
            }
        }
        catch (JSException)
        {
            error = L["Campaign.Book.Failed.Other"];
        }
        finally
        {
            busy = false;
        }
    }


    // ---- AI polish -------------------------------------------------------------------------------------------------------------

    private string style = string.Empty;
    private bool useAi;
    private long? capInput;
    private string? aiError;
    private BookBuildPreview? preview;
    private BookRun? run;
    private readonly HashSet<string> redo = new(StringComparer.Ordinal);

    private bool Running => run?.Running == true;

    private long Cap => capInput ?? preview?.SuggestedCap ?? 0;

    private BookBuildRequest Request(long cap = 0) => new(edition, language, style, cap, redo.Count == 0 ? null : redo);

    private async Task PreviewAsync()
    {
        try
        {
            preview = await Builds.PreviewAsync(Ctx.Access, Request());
        }
        catch (Exception)
        {
            preview = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void Attach(BookRun? found)
    {
        if (ReferenceEquals(found, run)) return;
        if (run != null) run.Changed -= OnRunChanged;
        run = found;
        if (run != null) run.Changed += OnRunChanged;
    }

    private void OnRunChanged() => _ = InvokeAsync(async () =>
    {
        // A finished run changed what is stored: the list, the totals and the preview all read it again.
        if (!Running)
        {
            redo.Clear();
            previewStamp++;
            await PreviewAsync();
        }

        StateHasChanged();
    });

    private void ToggleRedo(string id)
    {
        if (!redo.Remove(id)) redo.Add(id);
        capInput = null;
        _ = PreviewAsync();
    }

    private void CapChanged(ChangeEventArgs args) => capInput = long.TryParse(args.Value?.ToString(), NumberStyles.None, CultureInfo.CurrentCulture, out var value) ? value : null;

    private void UseAiChanged(ChangeEventArgs args)
    {
        useAi = args.Value is true;
        previewStamp++;
    }

    private async Task StartAsync()
    {
        aiError = null;
        try
        {
            var started = await Builds.StartAsync(Ctx.Access, Request(Cap));
            Attach(started);
            if (started == null) aiError = L["Campaign.Book.Failed.Other"];
        }
        catch (BookStyleRefusedException refused)
        {
            aiError = L["Campaign.Book.Ai.StyleRefused", string.Join("; ", refused.Problems)];
        }
        catch (BookBuildBusyException)
        {
            aiError = L["Campaign.Book.Ai.Busy"];
        }
        catch (AiNotConfiguredException)
        {
            aiError = L["Campaign.Book.Ai.NoModel"];
        }
        catch (LocalizedException ex)
        {
            aiError = L.Describe(ex);
        }
    }

    private void StopRun() => run?.Cancel();

    private async Task DiscardAsync()
    {
        aiError = null;
        if (!await Builds.DiscardAsync(Ctx.Access, edition)) aiError = L["Campaign.Book.Failed.Other"];
        useAi = false;
        previewStamp++;
        await PreviewAsync();
    }

    private static string Number(long value) => value.ToString("N0", CultureInfo.CurrentCulture);

    private static string Money(decimal amount, AiPriceQuote? price = null) =>
        AiPrice.Format(amount, price?.Label ?? string.Empty, CultureInfo.CurrentCulture);

    private string Money(decimal amount) => AiPrice.Format(amount, preview?.Model?.Price?.Label, CultureInfo.CurrentCulture);

    private string ChapterState(BookChapterInfo chapter) => chapter.TooShort
        ? L["Campaign.Book.Ai.State.TooShort"]
        : chapter.State switch
        {
            BookSectionState.Current => L["Campaign.Book.Ai.State.Current"],
            BookSectionState.Stale => L["Campaign.Book.Ai.State.Stale"],
            _ => chapter.LastReason is { } why ? L["Campaign.Book.Ai.State.New"] + "; " + L["Campaign.Book.Ai.LastReason", Reason(why)] : L["Campaign.Book.Ai.State.New"]
        };

    private string Reason(string reason) => reason switch
    {
        "budget" or "checks" or "error" or "auth" or "ratelimit" or "allowance" or "storage" or "cancelled" => L["Campaign.Book.Ai.Reason." + reason],
        _ => reason
    };

    private string RowText(BookRunRow row) => row.Status switch
    {
        BookRowStatus.Queued => L["Campaign.Book.Ai.Row.Queued"],
        BookRowStatus.Cached => L["Campaign.Book.Ai.Row.Cached"],
        BookRowStatus.Refined => L["Campaign.Book.Ai.Row.Refined"],
        BookRowStatus.Skipped => L["Campaign.Book.Ai.Row.Skipped"],
        _ => row.Reason is { } why ? L["Campaign.Book.Ai.Row.Kept"] + ": " + Reason(why) : L["Campaign.Book.Ai.Row.Kept"]
    };

    public void Dispose()
    {
        if (run != null) run.Changed -= OnRunChanged;
    }

    public sealed class BookDownload
    {
        public int Status { get; set; }
        public string? Detail { get; set; }
        public string? Code { get; set; }
    }
}
