@using Codex.Core
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject IHomebrewRepository Homebrew
@inject IContentRegistry Registry
@inject CastService Cast
@inject HomebrewImportService Importer
@inject ContentPackExporter Exporter
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">Library</h2>
        <p class="page-subtitle">Reference content for this campaign's system@(Ctx.IsDm ? ", plus your homebrew: equipment, classes, subclasses, feats, spells, creatures and more." : ", including the DM's homebrew.")</p>
    </div>
    @if (Ctx.IsDm)
    {
        <div class="row-actions">
            <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="NewHomebrew" data-testid="new-homebrew"><LucideIcon IconName="plus" Size="16" /> New homebrew</CodexButton>
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="OpenImportAsync" data-testid="import-homebrew"><LucideIcon IconName="folder-input" Size="16" /> Import from another campaign</CodexButton>
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="ExportHomebrewAsync" aria-label="Export this campaign's homebrew as a content pack"><LucideIcon IconName="download" Size="16" /> Export pack</CodexButton>
        </div>
    }
</div>

<LibraryBrowser Campaign="Ctx.Campaign" Access="Ctx.Access" BasePath="@($"{Ctx.BasePath}/library")"
                RouteType="@RouteType" RouteId="@RouteId" Version="version" EditorOpen="editing != null">
    <EditorPane>
        @if (editing != null)
        {
            <section class="panel">
                <HomebrewEditor Campaign="Ctx.Campaign" Access="Ctx.Access" Entry="editing"
                                OnSaved="OnSavedAsync" OnCancel="() => editing = null" OnDeleted="OnDeletedAsync" />
            </section>
        }
    </EditorPane>
    <DetailActions Context="item">
        @if (Ctx.IsDm && item.IsHomebrew)
        {
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => editing = item.Homebrew" data-testid="edit-homebrew"><LucideIcon IconName="edit-3" Size="14" /> Edit</CodexButton>
        }
        @if (Ctx.IsDm && !item.IsHomebrew)
        {
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => CloneAsHomebrew(item)" data-testid="clone-homebrew" title="Start a homebrew variant with these fields"><LucideIcon IconName="copy" Size="14" /> Homebrew copy</CodexButton>
        }
        @if (Ctx.IsDm && IsBlueprint(item))
        {
            <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => AddToCastAsync(item)" data-testid="add-to-cast"><LucideIcon IconName="user-plus" Size="14" /> Add to cast</CodexButton>
        }
    </DetailActions>
</LibraryBrowser>

<dialog id="import-homebrew-dialog" class="codex-dialog codex-dialog-wide" aria-labelledby="import-homebrew-title">
    <div class="dialog-body">
        <h2 id="import-homebrew-title"><LucideIcon IconName="folder-input" Size="20" Class="title-icon" /> Import homebrew</h2>
        @if (sourceCampaigns == null)
        {
            <LoadingSkeleton Rows="2" />
        }
        else if (sourceCampaigns.Count == 0)
        {
            <p class="mb-0">You don't run another campaign on this system yet. Homebrew can be imported from any campaign where you are the DM and the game system matches.</p>
        }
        else
        {
            <div class="mb-3">
                <label for="import-source" class="field-label">From campaign</label>
                <select id="import-source" class="field-select" value="@sourceCampaignId" @onchange="OnSourceChangedAsync" data-testid="import-source">
                    @foreach (var campaign in sourceCampaigns)
                    {
                        <option value="@campaign.Id">@campaign.Name</option>
                    }
                </select>
            </div>
            @if (sourceEntries == null)
            {
                <LoadingSkeleton Rows="3" />
            }
            else if (sourceEntries.Count == 0)
            {
                <p class="small-muted mb-0">That campaign has no homebrew.</p>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small-muted">@selectedImports.Count of @sourceEntries.Count selected</span>
                    <div class="d-flex gap-2">
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => selectedImports = sourceEntries.Select(e => e.Id).ToHashSet()">Select all</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => selectedImports.Clear()">None</CodexButton>
                    </div>
                </div>
                <div class="import-list">
                    @foreach (var group in sourceEntries.GroupBy(e => e.Type))
                    {
                        <div class="label-caps mt-2 mb-1">@(Ctx.System?.FindType(group.Key)?.PluralOrLabel ?? CampaignLibrary.Humanize(group.Key))</div>
                        @foreach (var entry in group)
                        {
                            <div class="field-check">
                                <input id="imp-@entry.Id" type="checkbox" class="field-box" checked="@selectedImports.Contains(entry.Id)" @onchange="e => ToggleImport(entry.Id, (bool)(e.Value ?? false))" />
                                <label for="imp-@entry.Id" >@entry.Name <span class="small-muted">@TextFormatting.Summary(entry.Description, 70)</span></label>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
    <div class="dialog-actions">
        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseImportAsync">Close</CodexButton>
        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="ImportAsync" Disabled="@(selectedImports.Count == 0 || importing)" data-testid="import-confirm">@(importing ? "Importing…" : $"Import {selectedImports.Count}")</CodexButton>
    </div>
</dialog>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;
    [Parameter] public string? RouteType { get; set; }
    [Parameter] public string? RouteId { get; set; }

    private HomebrewEntryDocument? editing;
    private int version;
    private List<CampaignDocument>? sourceCampaigns;
    private string sourceCampaignId = string.Empty;
    private List<HomebrewEntryDocument>? sourceEntries;
    private HashSet<string> selectedImports = new();
    private bool importing;

    private void NewHomebrew() => editing = new HomebrewEntryDocument
    {
        CampaignId = Ctx.Campaign.Id,
        SystemId = Ctx.Campaign.SystemId,
        Type = RouteType ?? string.Empty,
        AuthorUserId = Ctx.UserId
    };

    private void CloneAsHomebrew(LibraryItem item)
    {
        editing = HomebrewImportService.CloneFromPack(item.Entry, item.Pack, Ctx.Campaign, Ctx.Access);
        Ctx.Notify(Flash.Info($"Editing a homebrew copy of “{item.Entry.Name}”. It stays a draft (hidden from players) until you tick “Visible to players”."));
    }

    private async Task OnSavedAsync(Flash flash)
    {
        Ctx.Notify(flash);
        if (flash.Tone != FlashTone.Error)
        {
            var saved = editing;
            editing = null;
            version++;
            if (saved != null)
            {
                Nav.NavigateTo($"{Ctx.BasePath}/library/{saved.Type}/{Uri.EscapeDataString(saved.EntryId)}");
            }
        }

        await Task.CompletedTask;
    }

    private async Task OnDeletedAsync(Flash flash)
    {
        Ctx.Notify(flash);
        editing = null;
        version++;
        Nav.NavigateTo($"{Ctx.BasePath}/library");
        await Task.CompletedTask;
    }

    private bool IsBlueprint(LibraryItem item) => Cast.Blueprint(item, Ctx.Campaign, Ctx.System) != null;

    private async Task AddToCastAsync(LibraryItem item)
    {
        var created = await Cast.AddToCastAsync(item, Ctx.Campaign, Ctx.System, Ctx.Access);
        if (created.Count == 0)
        {
            Ctx.Notify(Flash.Error("That entry can't be turned into a creature, or only the DM can add creatures."));
            return;
        }

        Ctx.Notify(Flash.Success($"Added {created[0].Name} to the cast (hidden from players)."));
        await Ctx.ReloadAsync();
    }

    private async Task OpenImportAsync()
    {
        sourceCampaigns = null;
        sourceEntries = null;
        selectedImports.Clear();
        await JS.InvokeVoidAsync("codex.showModal", "import-homebrew-dialog");
        sourceCampaigns = (await Importer.SourceCampaignsAsync(Ctx.Campaign, Ctx.Access)).ToList();
        sourceCampaignId = sourceCampaigns.FirstOrDefault()?.Id ?? string.Empty;
        await LoadSourceEntriesAsync();
    }

    private Task CloseImportAsync() => JS.InvokeVoidAsync("codex.closeModal", "import-homebrew-dialog").AsTask();

    private async Task OnSourceChangedAsync(ChangeEventArgs e)
    {
        sourceCampaignId = e.Value?.ToString() ?? string.Empty;
        selectedImports.Clear();
        await LoadSourceEntriesAsync();
    }

    private async Task LoadSourceEntriesAsync()
    {
        sourceEntries = string.IsNullOrEmpty(sourceCampaignId) ? new List<HomebrewEntryDocument>() : (await Importer.EntriesOfAsync(sourceCampaignId, Ctx.Access)).ToList();
    }

    private void ToggleImport(string id, bool on)
    {
        if (on) selectedImports.Add(id); else selectedImports.Remove(id);
    }

    private async Task ImportAsync()
    {
        if (importing || selectedImports.Count == 0) return;
        importing = true;
        try
        {
            var copied = await Importer.ImportAsync(sourceCampaignId, selectedImports, Ctx.Campaign, Ctx.Access);
            await CloseImportAsync();
            version++;
            Ctx.Notify(copied == 0
                ? Flash.Info("Nothing imported: every selected entry already exists here.")
                : Flash.Success($"Imported {copied} entr{(copied == 1 ? "y" : "ies")}. Entries that already existed here were skipped."));
        }
        finally
        {
            importing = false;
        }
    }

    private async Task ExportHomebrewAsync()
    {
        var entries = (await Homebrew.GetAllForCampaignAsync(Ctx.Campaign.Id)).Select(h => h.ToEntry()).ToList();
        if (entries.Count == 0)
        {
            Ctx.Notify(Flash.Info("There is no homebrew to export yet."));
            return;
        }

        var manifest = new PackManifest
        {
            Id = $"homebrew-{RavenHomebrewRepository.Slugify(Ctx.Campaign.Name)}",
            Name = $"{Ctx.Campaign.Name} homebrew",
            Version = "1.0.0",
            SystemId = Ctx.Campaign.SystemId,
            Kind = "homebrew",
            Description = $"Homebrew content exported from the campaign “{Ctx.Campaign.Name}”.",
            License = new LicenseInfo { Name = "All rights reserved", Attribution = $"Homebrew by the DM of “{Ctx.Campaign.Name}”." }
        };
        var bytes = await Exporter.ExportToZipBytesAsync(manifest, entries, Ctx.System);
        var href = "data:application/zip;base64," + Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("codex.download", href, $"{manifest.Id}.zip");
        Ctx.Notify(Flash.Success($"Exported {entries.Count} entries. Drop the zip into a content folder to load it as a pack."));
    }
}
