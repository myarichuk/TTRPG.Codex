@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject IHomebrewRepository Homebrew
@inject IContentRegistry Registry
@inject CastService Cast
@inject HomebrewImportService Importer
@inject ContentPackExporter Exporter
@inject ArtService Art
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MentionSources MentionSources
@inject AiFeatures Ai

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["Campaign.Library.Title"]</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? L["Campaign.Library.Subtitle.Dm"] : L["Campaign.Library.Subtitle.Player"])</p>
    </div>
    @if (Ctx.IsDm)
    {
        <div class="row-actions">
            <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="NewHomebrew" data-testid="new-homebrew"><LucideIcon IconName="plus" Size="18" /> @L["Campaign.Library.NewHomebrew"]</CodexButton>
            @if (aiReady)
            {
                <CodexButton Variant="CodexButtonVariant.Etched" Class="cx-arcane" OnClick="BuildWithAiAsync" data-testid="build-homebrew-ai"><LucideIcon IconName="sparkles" Size="18" /> @L["WorldBuilder.Open.Homebrew"]</CodexButton>
            }
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="OpenImportAsync" data-testid="import-homebrew"><LucideIcon IconName="folder-input" Size="18" /> @L["Campaign.Library.ImportFromCampaign"]</CodexButton>
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="ExportHomebrewAsync" aria-label="@L["Campaign.Library.ExportLabel"]"><LucideIcon IconName="download" Size="18" /> @L["Campaign.Library.ExportPack"]</CodexButton>
        </div>
    }
</div>

<LibraryBrowser Campaign="Ctx.Campaign" Access="Ctx.Access" BasePath="@($"{Ctx.BasePath}/library")"
                RouteType="@RouteType" RouteId="@RouteId" Version="version">
    <DetailArt Context="item">
        <ArtSlot ImageUrl="@ArtService.Url(Ctx.Campaign, item)" CanEdit="Ctx.IsDm" Landscape="@(!IsCreatureType(item.Entry.Type))"
                 Label="@(IsCreatureType(item.Entry.Type) ? L["Campaign.Library.Portrait"] : L["Campaign.Library.Art"])" Alt="@L["Campaign.Library.ArtFor", item.Entry.Name]" Class="entry-art" TestId="entry-art"
                 OnPicked="img => StoreArtAsync(item, img)" OnRemove="() => RemoveArtAsync(item)" Generate="() => GenerateArtAsync(item)" />
    </DetailArt>
    <DetailActions Context="item">
        @if (Ctx.IsDm && item.IsHomebrew)
        {
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => wizard.OpenAsync(item.Homebrew!)" data-testid="edit-homebrew"><LucideIcon IconName="edit-3" Size="14" /> @L["Campaign.Library.Edit"]</CodexButton>
        }
        @if (Ctx.IsDm && !item.IsHomebrew)
        {
            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => CloneAsHomebrew(item)" data-testid="clone-homebrew" title="@L["Campaign.Library.CloneTitle"]"><LucideIcon IconName="copy" Size="14" /> @L["Campaign.Library.HomebrewCopy"]</CodexButton>
        }
        @if (Ctx.IsDm && IsBlueprint(item))
        {
            <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => AddToCastAsync(item)" data-testid="add-to-cast"><LucideIcon IconName="user-plus" Size="14" /> @L["Campaign.Library.AddToCast"]</CodexButton>
        }
    </DetailActions>
    <DetailFooter Context="item">
        @{ var itemKey = MentionSources.ItemKey(item.Entry.Type, item.Entry.Id); var mentioned = SessionMentions.NotesMentioning(noteSessions, MentionKind.Item, itemKey, Ctx.IsDm); var written = noteWritings.Mentioning(MentionKind.Item, itemKey); }
        @if (mentioned.Count + written.Count > 0)
        {
            <section class="mt-4" aria-labelledby="entry-mentions-heading" data-testid="entry-mentions">
                <h2 id="entry-mentions-heading" class="h6"><LucideIcon IconName="notebook-pen" Size="16" Class="title-icon" /> @L["Campaign.Library.InNotes"]</h2>
                <NotesMentioning Lines="mentioned" Written="written" Mentions="noteMentions" Actors="noteActors" IsDm="Ctx.IsDm" CampaignId="@Ctx.Campaign.Id" />
            </section>
        }
    </DetailFooter>
</LibraryBrowser>

@if (Ctx.IsDm)
{
    <HomebrewWizard @ref="wizard" OnSaved="OnSavedAsync" OnDeleted="OnDeletedAsync" />
    <WorldBuilderWizard @ref="builder" OnSaved="OnBuiltAsync" />
}

<dialog id="import-homebrew-dialog" class="codex-dialog codex-dialog-wide" aria-labelledby="import-homebrew-title">
    <div class="dialog-body">
        <h2 id="import-homebrew-title"><LucideIcon IconName="folder-input" Size="18" Class="title-icon" /> @L["Campaign.Library.Import.Title"]</h2>
        @if (sourceCampaigns == null)
        {
            <LoadingSkeleton Rows="2" />
        }
        else if (sourceCampaigns.Count == 0)
        {
            <p class="mb-0">@L["Campaign.Library.Import.NoSource"]</p>
        }
        else
        {
            <div class="mb-3">
                <label for="import-source" class="field-label">@L["Campaign.Library.Import.FromCampaign"]</label>
                <select id="import-source" class="field-select" value="@sourceCampaignId" @onchange="OnSourceChangedAsync" data-testid="import-source">
                    @foreach (var campaign in sourceCampaigns)
                    {
                        <option value="@campaign.Id">@campaign.Name</option>
                    }
                </select>
            </div>
            @if (sourceEntries == null)
            {
                <LoadingSkeleton Rows="3" />
            }
            else if (sourceEntries.Count == 0)
            {
                <p class="small-muted mb-0">@L["Campaign.Library.Import.NoHomebrew"]</p>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small-muted">@L["Campaign.Library.Import.Selected", selectedImports.Count, sourceEntries.Count]</span>
                    <div class="d-flex gap-2">
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => selectedImports = sourceEntries.Select(e => e.Id).ToHashSet()">@L["Campaign.Library.Import.SelectAll"]</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => selectedImports.Clear()">@L["Campaign.Library.Import.None"]</CodexButton>
                    </div>
                </div>
                <div class="import-list">
                    @foreach (var group in sourceEntries.GroupBy(e => e.Type))
                    {
                        <div class="label-caps mt-2 mb-1">@(Ctx.System?.FindType(group.Key)?.PluralOrLabel ?? CampaignLibrary.Humanize(group.Key))</div>
                        @foreach (var entry in group)
                        {
                            <div class="field-check">
                                <input id="imp-@entry.Id" type="checkbox" class="field-box" checked="@selectedImports.Contains(entry.Id)" @onchange="e => ToggleImport(entry.Id, (bool)(e.Value ?? false))" />
                                <label for="imp-@entry.Id" >@entry.Name <span class="small-muted">@TextFormatting.Summary(entry.Description, 70)</span></label>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
    <div class="dialog-actions">
        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseImportAsync">@L["Common.Close"]</CodexButton>
        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="ImportAsync" Disabled="@(selectedImports.Count == 0 || importing)" data-testid="import-confirm">@(importing ? L["Campaign.Library.Import.Importing"] : L["Campaign.Library.Import.Button", selectedImports.Count])</CodexButton>
    </div>
</dialog>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;
    [Parameter] public string? RouteType { get; set; }
    [Parameter] public string? RouteId { get; set; }

    /// <summary>?new=1 opens the wizard on arrival (the Bestiary's "New homebrew creature" links here).</summary>
    [SupplyParameterFromQuery(Name = "new")] public string? OpenNew { get; set; }

    private HomebrewWizard wizard = null!;
    private WorldBuilderWizard builder = null!;
    private bool aiReady;
    private int version;
    private List<CampaignDocument>? sourceCampaigns;
    private string sourceCampaignId = string.Empty;
    private List<HomebrewEntryDocument>? sourceEntries;
    private HashSet<string> selectedImports = new();
    private bool importing;

    // Session notes, to list under an item the ones that mention it.
    private IReadOnlyList<SessionDocument> noteSessions = Array.Empty<SessionDocument>();
    private MentionWritings noteWritings = MentionWritings.Empty;
    private MentionDirectory noteMentions = MentionDirectory.Empty;
    private IReadOnlyDictionary<string, ActorDocument> noteActors = new Dictionary<string, ActorDocument>();

    protected override async Task OnInitializedAsync()
    {
        (noteSessions, noteWritings, noteMentions) = await MentionSources.NotesAsync(Ctx.Campaign, Ctx.Access, Ctx.Actors);
        noteActors = Ctx.Actors.ToDictionary(a => a.Id);
        aiReady = Ctx.IsDm && await Ai.IsConfiguredAsync(Ctx.UserId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Ctx.IsDm && OpenNew is "1" or "true")
        {
            // Drop the flag so a reload or Back doesn't reopen the wizard.
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("new", (string?)null), replace: true);
            await NewHomebrew();
        }
    }

    private Task NewHomebrew() => wizard.OpenAsync(new HomebrewEntryDocument
    {
        CampaignId = Ctx.Campaign.Id,
        SystemId = Ctx.Campaign.SystemId,
        Type = RouteType ?? string.Empty,
        AuthorUserId = Ctx.UserId
    });

    private Task BuildWithAiAsync() =>
        builder.OpenAsync("homebrew", new Dictionary<string, string?> { ["type"] = RouteType });

    /// <summary>The world builder saved its drafts hidden from players; open the entry in the editor so the DM checks the rules and publishes it.</summary>
    private async Task OnBuiltAsync(WorldBuildResult result)
    {
        version++;
        Ctx.Notify(Flash.Success(L["WorldBuilder.Saved", result.Count]));
        if (result.Entries.FirstOrDefault() is { } entry)
        {
            Nav.NavigateTo($"{Ctx.BasePath}/library/{entry.Type}/{Uri.EscapeDataString(entry.EntryId)}");
            await wizard.OpenAsync(entry, startAt: "review");
        }
    }

    private async Task CloneAsHomebrew(LibraryItem item)
    {
        var copy = HomebrewImportService.CloneFromPack(item.Entry, item.Pack, Ctx.Campaign, Ctx.Access);
        Ctx.Notify(Flash.Info(L["Campaign.Library.EditingCopy", item.Entry.Name]));
        await wizard.OpenAsync(copy, startAt: "story");
    }

    private Task OnSavedAsync(HomebrewEntryDocument saved)
    {
        Ctx.Notify(Flash.Success(L["Campaign.Library.Saved", saved.Name]));
        version++;
        Nav.NavigateTo($"{Ctx.BasePath}/library/{saved.Type}/{Uri.EscapeDataString(saved.EntryId)}");
        return Task.CompletedTask;
    }

    private Task OnDeletedAsync(HomebrewEntryDocument deleted)
    {
        Ctx.Notify(Flash.Success(L["Campaign.Library.Deleted", deleted.Name]));
        version++;
        Nav.NavigateTo($"{Ctx.BasePath}/library");
        return Task.CompletedTask;
    }

    private bool IsCreatureType(string type) => Ctx.System?.FindType(type)?.ActorBlueprint == true;

    private async Task StoreArtAsync(LibraryItem item, ArtImage image)
    {
        if (await Art.PutAsync(Ctx.Campaign, Ctx.Access, item, image))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Library.ArtSaved", item.Entry.Name]));
        }
        else
        {
            Ctx.Notify(Flash.Error(L["Campaign.Library.ArtOnlyDm"]));
        }
    }

    private async Task RemoveArtAsync(LibraryItem item)
    {
        if (await Art.RemoveAsync(Ctx.Campaign, Ctx.Access, item))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Library.ArtRemoved", item.Entry.Name]));
        }
    }

    private Task<ArtImage> GenerateArtAsync(LibraryItem item)
    {
        var visual = YamlValues.GetString(item.Entry.Properties, "imagePrompt") ?? TextFormatting.Summary(item.Entry.Description, 300);
        var kind = (Ctx.System?.Canonical.FindType(item.Entry.Type)?.Label ?? CampaignLibrary.Humanize(item.Entry.Type)).ToLowerInvariant();
        return Art.GenerateAsync(Ctx.UserId, item.Entry.Name, kind, visual, IsCreatureType(item.Entry.Type) ? ArtShape.Tall : ArtShape.Wide);
    }

    private bool IsBlueprint(LibraryItem item) => Cast.Blueprint(item, Ctx.Campaign, Ctx.System) != null;

    private async Task AddToCastAsync(LibraryItem item)
    {
        var created = await Cast.AddToCastAsync(item, Ctx.Campaign, Ctx.System, Ctx.Access);
        if (created.Count == 0)
        {
            Ctx.Notify(Flash.Error(L["Campaign.Library.CannotCreate"]));
            return;
        }

        Ctx.Notify(Flash.Success(L["Campaign.Library.AddedToCast", created[0].Name]));
        await Ctx.ReloadAsync();
    }

    private async Task OpenImportAsync()
    {
        sourceCampaigns = null;
        sourceEntries = null;
        selectedImports.Clear();
        await JS.InvokeVoidAsync("codex.showModal", "import-homebrew-dialog");
        sourceCampaigns = (await Importer.SourceCampaignsAsync(Ctx.Campaign, Ctx.Access)).ToList();
        sourceCampaignId = sourceCampaigns.FirstOrDefault()?.Id ?? string.Empty;
        await LoadSourceEntriesAsync();
    }

    private Task CloseImportAsync() => JS.InvokeVoidAsync("codex.closeModal", "import-homebrew-dialog").AsTask();

    private async Task OnSourceChangedAsync(ChangeEventArgs e)
    {
        sourceCampaignId = e.Value?.ToString() ?? string.Empty;
        selectedImports.Clear();
        await LoadSourceEntriesAsync();
    }

    private async Task LoadSourceEntriesAsync()
    {
        sourceEntries = string.IsNullOrEmpty(sourceCampaignId) ? new List<HomebrewEntryDocument>() : (await Importer.EntriesOfAsync(sourceCampaignId, Ctx.Access)).ToList();
    }

    private void ToggleImport(string id, bool on)
    {
        if (on) selectedImports.Add(id); else selectedImports.Remove(id);
    }

    private async Task ImportAsync()
    {
        if (importing || selectedImports.Count == 0) return;
        importing = true;
        try
        {
            var copied = await Importer.ImportAsync(sourceCampaignId, selectedImports, Ctx.Campaign, Ctx.Access);
            await CloseImportAsync();
            version++;
            Ctx.Notify(copied == 0
                ? Flash.Info(L["Campaign.Library.NothingImported"])
                : Flash.Success(L["Campaign.Library.Imported", copied]));
        }
        finally
        {
            importing = false;
        }
    }

    private async Task ExportHomebrewAsync()
    {
        var entries = (await Homebrew.GetAllForCampaignAsync(Ctx.Campaign.Id)).Select(h => h.ToEntry()).ToList();
        if (entries.Count == 0)
        {
            Ctx.Notify(Flash.Info(L["Campaign.Library.NoHomebrewToExport"]));
            return;
        }

        var manifest = new PackManifest
        {
            Id = $"homebrew-{RavenHomebrewRepository.Slugify(Ctx.Campaign.Name)}",
            Name = $"{Ctx.Campaign.Name} homebrew",
            Version = "1.0.0",
            SystemId = Ctx.Campaign.SystemId,
            Kind = "homebrew",
            Description = $"Homebrew content exported from the campaign “{Ctx.Campaign.Name}”.",
            License = new LicenseInfo { Name = "All rights reserved", Attribution = $"Homebrew by the DM of “{Ctx.Campaign.Name}”." }
        };
        var bytes = await Exporter.ExportToZipBytesAsync(manifest, entries, Ctx.System);
        var href = "data:application/zip;base64," + Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("codex.download", href, $"{manifest.Id}.zip");
        Ctx.Notify(Flash.Success(L["Campaign.Library.Exported", entries.Count]));
    }
}
