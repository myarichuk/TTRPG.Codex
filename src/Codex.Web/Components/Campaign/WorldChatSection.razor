@using Codex.Core
@using Codex.Core.AI
@using Codex.Core.WorldBuilder
@using Codex.Persistence
@using Microsoft.AspNetCore.WebUtilities
@inject WorldChatSessions Sessions
@inject WorldBuilderService Builder
@inject IRegionRepository RegionRepo
@inject AiFeatures Ai
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<WorldChatSection> Logger
@implements IDisposable

@* The world builder: conversations with the DM's own model, which reads the campaign through tools and proposes pages, places,
   people, secrets and homebrew, and changes to what exists. A workbench that fills the screen: the DM's chats on the left, the
   conversation in the middle, the proposal on the right. Narrower, the chats fold into a drawer; on a phone one pane shows at a
   time, picked from a row of tabs. A proposal is saved only when the DM applies it, hidden from players. *@

@if (!Ctx.IsDm)
{
    <div class="empty"><p>@L["WorldChat.DmOnly"]</p></div>
}
else if (!aiReady)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="sparkles" Size="28" /></div>
        <h3>@L["WorldChat.NoAi.Title"]</h3>
        <p>@L["WorldChat.NoAi.Body"]</p>
        <a href="/settings/ai" class="cx-btn cx-plaque">@L["WorldChat.NoAi.Settings"]</a>
    </div>
}
else if (chat != null)
{
    var live = chat.Live;
    var proposal = chat.Proposal;
    <h2 class="visually-hidden">@L["WorldChat.Title"]</h2>
    <div class="wb-host">
        <div class="wb" data-pane="@pane" data-drawer="@(drawer ? "open" : null)" data-testid="world-builder">
            <div class="wb-tabs" role="tablist" aria-label="@L["WorldChat.Title"]">
                <button type="button" role="tab" class="wb-tab" aria-selected="@(pane == "chats" ? "true" : "false")" @onclick='() => pane = "chats"' data-testid="world-tab-chats"><LucideIcon IconName="message-square" Size="16" /> @L["WorldChat.Chats"]</button>
                <button type="button" role="tab" class="wb-tab" aria-selected="@(pane == "talk" ? "true" : "false")" @onclick='() => pane = "talk"' data-testid="world-tab-talk"><LucideIcon IconName="sparkles" Size="16" /> @L["WorldChat.Conversation"]</button>
                <button type="button" role="tab" class="wb-tab" aria-selected="@(pane == "ledger" ? "true" : "false")" @onclick='() => pane = "ledger"' data-testid="world-tab-proposal">
                    <LucideIcon IconName="clipboard-check" Size="16" /> @L["WorldChat.Proposal.Title"]
                    @if (proposal != null)
                    {
                        <span class="wb-badge">@proposal.Drafts.Count(d => d.Selected)</span>
                    }
                </button>
            </div>

            @* ---- The DM's chats ---- *@
            <aside class="wb-chats panel" aria-labelledby="world-chats-heading" data-testid="world-chats">
                <header class="wb-head">
                    <h3 id="world-chats-heading" class="wb-title"><LucideIcon IconName="message-square" Size="16" Class="title-icon" /> @L["WorldChat.Chats"]</h3>
                    <button type="button" class="wb-icon-btn wb-drawer-close" @onclick="() => drawer = false" aria-label="@L["Common.Close"]"><LucideIcon IconName="x" Size="18" /></button>
                </header>
                <div class="wb-chats-new">
                    <CodexButton Variant="CodexButtonVariant.Etched" Icon="message-square-plus" OnClick="NewChat" Disabled="@(chat.Lines.Count == 0 && !chat.IsBusy)" data-testid="world-chat-new">@L["WorldChat.NewChat"]</CodexButton>
                </div>
                <nav class="wb-scroll wb-chat-list" aria-label="@L["WorldChat.Chats"]">
                    @if (chats.Count == 0 && chat.Lines.Count == 0)
                    {
                        <p class="small-muted px-1">@L["WorldChat.NoChats"]</p>
                    }
                    <ul class="list-unstyled mb-0">
                        @* A new chat is stored with its first answer; until then it is listed only while it has a message under way. *@
                        @if (string.IsNullOrEmpty(chat.Id) && chat.Lines.Count > 0)
                        {
                            <li><span class="wb-chat-item" aria-current="page"><span class="wb-chat-name">@(chat.Title.Length > 0 ? chat.Title : L["WorldChat.Untitled"])</span></span></li>
                        }
                        @foreach (var item in chats)
                        {
                            var isCurrent = item.Id == chat.Id;
                            <li>
                                <button type="button" class="wb-chat-item" aria-current="@(isCurrent ? "page" : null)" @onclick="() => OpenAsync(item.Id)" data-testid="world-chat-item">
                                    <span class="wb-chat-name">@(item.Title.Length > 0 ? item.Title : L["WorldChat.Untitled"])</span>
                                    <span class="wb-chat-meta">
                                        <LocalTime Value="item.UpdatedAt" Format="d MMM, HH:mm" />
                                        @if (Sessions.IsBusy(item.Id))
                                        {
                                            <span class="wb-chat-busy" title="@L["WorldChat.Working"]"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span class="visually-hidden">@L["WorldChat.Working"]</span></span>
                                        }
                                        else if (item.Waiting > 0)
                                        {
                                            <span class="wb-badge" title="@L["WorldChat.Waiting", item.Waiting]">@item.Waiting<span class="visually-hidden"> @L["WorldChat.Waiting", item.Waiting]</span></span>
                                        }
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </nav>
            </aside>
            <div class="wb-scrim" @onclick="() => drawer = false" aria-hidden="true"></div>

            @* ---- The conversation ---- *@
            <section class="wb-talk panel" aria-labelledby="world-chat-heading">
                <header class="wb-head wb-bar">
                    <button type="button" class="wb-icon-btn wb-drawer-open" @onclick="() => drawer = true" aria-label="@L["WorldChat.Chats"]" title="@L["WorldChat.Chats"]" data-testid="world-chats-open"><LucideIcon IconName="panel-left" Size="18" /></button>
                    @if (renaming)
                    {
                        <form class="wb-rename" @onsubmit="RenameAsync" @onsubmit:preventDefault="true">
                            <label for="world-chat-name" class="visually-hidden">@L["WorldChat.RenameLabel"]</label>
                            <input id="world-chat-name" class="field-input" @bind="newTitle" maxlength="120" @onkeydown="OnRenameKey" data-testid="world-chat-name" />
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Etched" Small="true" Icon="check">@L["Common.Save"]</CodexButton>
                        </form>
                    }
                    else
                    {
                        <h3 id="world-chat-heading" class="wb-title wb-chat-title" data-testid="world-chat-title">@(chat.Title.Length > 0 ? chat.Title : L["WorldChat.Untitled"])</h3>
                        @if (!string.IsNullOrEmpty(chat.Id))
                        {
                            <button type="button" class="wb-icon-btn" @onclick="StartRename" aria-label="@L["WorldChat.Rename"]" title="@L["WorldChat.Rename"]" data-testid="world-chat-rename"><LucideIcon IconName="edit-3" Size="16" /></button>
                            <button type="button" class="wb-icon-btn" @onclick="DeleteAsync" disabled="@chat.IsBusy" aria-label="@L["WorldChat.Delete"]" title="@L["WorldChat.Delete"]" data-testid="world-chat-delete"><LucideIcon IconName="trash-2" Size="16" /></button>
                        }
                    }
                </header>

                <ol id="world-chat-log" class="wb-scroll wb-log" role="log" tabindex="0" aria-label="@L["WorldChat.Conversation"]" aria-live="polite" aria-relevant="additions" data-testid="world-chat-log">
                    @if (chat.Lines.Count == 0 && live == null)
                    {
                        <li class="wb-welcome">
                            <p class="wb-welcome-title">@L["WorldChat.Welcome"]</p>
                            <p class="small-muted">@L["WorldChat.Intro"]</p>
                            <ol class="wb-options" aria-label="@L["WorldChat.Starters"]">
                                @for (var i = 0; i < StarterKeys.Length; i++)
                                {
                                    var key = StarterKeys[i];
                                    <li><button type="button" class="wb-option" @onclick="() => UseStarter(key)" data-testid="world-chat-starter-@key"><span class="wb-option-num" aria-hidden="true">@(i + 1).</span> @L[$"WorldChat.Starter.{key}.Label"]</button></li>
                                }
                            </ol>
                        </li>
                    }
                    @foreach (var line in chat.Lines)
                    {
                        @switch (line.Speaker)
                        {
                            case WorldChatSpeaker.Dm:
                                <li class="wb-msg wb-msg-dm">
                                    <div class="wb-who">@L["WorldChat.You"]</div>
                                    <div class="wb-msg-text">@line.Text</div>
                                </li>
                                break;
                            case WorldChatSpeaker.Model:
                                <li class="wb-msg wb-msg-model">
                                    <div class="wb-who"><LucideIcon IconName="sparkles" Size="14" /> @L["WorldChat.Model"]</div>
                                    @if (line.Steps is { Count: > 0 } steps)
                                    {
                                        @* What the model looked at to get here, folded away: there if the DM wonders, out of the way if not. *@
                                        <details class="wb-trail" data-testid="world-chat-steps">
                                            <summary>
                                                <LucideIcon IconName="chevron-right" Size="14" Class="wb-trail-chevron" /> @L["WorldChat.Steps", steps.Count]
                                                <span class="small-muted">· @WorldChatView.Duration(L, steps.Sum(s => s.DurationMs))</span>
                                                @if (steps.Count(s => s.Status == WorldChatStepStatus.Failed || s.Rejected) is > 0 and var troubled)
                                                {
                                                    <span class="wb-trail-trouble">· <LucideIcon IconName="alert-triangle" Size="12" /> @L["WorldChat.Steps.Trouble", troubled]</span>
                                                }
                                            </summary>
                                            <WorldChatSteps Steps="steps" OnRaw="ShowRawAsync" />
                                        </details>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(line.Reasoning))
                                    {
                                        <details class="wb-trail wb-reasoning">
                                            <summary><LucideIcon IconName="chevron-right" Size="14" Class="wb-trail-chevron" /> @L["WorldChat.Reasoning"]</summary>
                                            <div class="wb-reasoning-text">@line.Reasoning</div>
                                        </details>
                                    }
                                    <div class="wb-msg-text rules-text">@((MarkupString)TextFormatting.ToHtml(line.Text))</div>
                                    @if (proposal != null && ReferenceEquals(line, proposalLine))
                                    {
                                        <button type="button" class="wb-proposal-card" @onclick="ShowProposal" data-testid="world-proposal-card">
                                            <LucideIcon IconName="clipboard-check" Size="18" />
                                            <span><strong>@L["WorldChat.Proposal.Ready", proposal.Drafts.Count]</strong> <span class="small-muted">@proposal.Summary</span></span>
                                            <span class="wb-proposal-card-go">@L["WorldChat.Proposal.Show"] <LucideIcon IconName="chevron-right" Size="14" /></span>
                                        </button>
                                    }
                                    @if (line.Usage is { } usage)
                                    {
                                        <div class="wb-usage" data-testid="world-chat-usage">@string.Join(" · ", WorldChatView.Usage(L, usage))</div>
                                    }
                                </li>
                                break;
                            default:
                                <li class="wb-note">
                                    <div><LucideIcon IconName="@(line.Icon ?? "info")" Size="14" /> @line.Text</div>
                                    @if (line.Links is { Count: > 0 } links)
                                    {
                                        <WorldChatLinks Links="links" />
                                    }
                                </li>
                                break;
                        }
                    }
                    @if (live != null)
                    {
                        var steps = live.Steps;
                        var reply = live.Reply;
                        var reasoning = live.Reasoning;
                        <li class="wb-msg wb-msg-model is-live" aria-live="off" data-testid="world-chat-live">
                            <div class="wb-who"><LucideIcon IconName="sparkles" Size="14" /> @L["WorldChat.Model"]</div>
                            @if (steps.Count > 0)
                            {
                                <WorldChatSteps Steps="steps" Live="true" OnRaw="ShowRawAsync" TestId="world-chat-trail" />
                            }
                            @if (reasoning.Length > 0)
                            {
                                <details class="wb-trail wb-reasoning" open="@live.Thinking" data-testid="world-chat-thinking">
                                    <summary><LucideIcon IconName="chevron-right" Size="14" Class="wb-trail-chevron" /> @L["WorldChat.Reasoning"]</summary>
                                    <div class="wb-reasoning-text">@Tail(reasoning)</div>
                                </details>
                            }
                            @if (reply.Length > 0)
                            {
                                @* The reply as it is written; aria-live off so a screen reader hears it once, when it lands in the log. *@
                                <div class="wb-msg-text rules-text" data-testid="world-chat-streaming">@((MarkupString)TextFormatting.ToHtml(reply))</div>
                            }
                            else if (live.Aside is { } aside)
                            {
                                <div class="wb-aside">@aside</div>
                            }
                            <div class="wb-status" role="status" data-testid="world-chat-working">
                                <span class="ai-working-orb" aria-hidden="true"><span class="spinner-border spinner-border-sm"></span></span>
                                <span>@Status(live, steps, reply)</span>
                                <span class="wb-status-time">@WorldChatView.Duration(L, (long)(DateTime.UtcNow - live.StartedAt).TotalMilliseconds)</span>
                            </div>
                        </li>
                    }
                </ol>

                <form class="wb-composer" @onsubmit="SendAsync" @onsubmit:preventDefault="true">
                    @if (notice != null && live == null)
                    {
                        <StatusMessage Message="notice" OnDismiss="() => notice = null">
                            <Actions>
                                @if (carryOn != null)
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="message-square-plus" OnClick="CarryOnAsync" data-testid="world-chat-carry-on">@L["WorldChat.CarryOn"]</CodexButton>
                                }
                                else if (!string.IsNullOrWhiteSpace(draft))
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="refresh-cw" OnClick="SendAsync" data-testid="world-chat-retry">@L["WorldChat.Retry"]</CodexButton>
                                }
                            </Actions>
                        </StatusMessage>
                    }
                    <label for="world-chat-input" class="visually-hidden">@L["WorldChat.MessageLabel"]</label>
                    <textarea id="world-chat-input" class="wb-input" rows="2" @bind="draft" @bind:event="oninput" readonly="@(live != null)"
                              placeholder="@L["WorldChat.Placeholder"]" aria-describedby="world-chat-hint" data-testid="world-chat-input"
                              @onkeydown="OnKeyAsync"></textarea>
                    <div class="wb-composer-bar">
                        <span id="world-chat-hint" class="field-hint mb-0">@L["WorldChat.Hint"]</span>
                        @if (live != null)
                        {
                            <CodexButton Variant="CodexButtonVariant.Etched" Icon="square" OnClick="Stop" data-testid="world-chat-stop">@L["Common.Ai.Stop"]</CodexButton>
                        }
                        else
                        {
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" id="world-chat-send" Disabled="@(applying || string.IsNullOrWhiteSpace(draft))" data-testid="world-chat-send"><LucideIcon IconName="send" Size="16" /> @L["WorldChat.Send"]</CodexButton>
                        }
                    </div>
                </form>
            </section>

            @* ---- The proposal ---- *@
            <aside class="wb-ledger panel" id="world-proposal" aria-labelledby="world-proposal-heading">
                <WorldProposalPanel @ref="panel" Proposal="proposal" Warnings="chat.ProposalWarnings" Decided="chat.Decided" Missing="missing" PlaceNames="placeNames"
                                    LastApplied="lastApplied" Locked="@(chat.IsBusy || applying)" Applying="applying" ApplyError="@applyError"
                                    OnApply="ApplyAsync" OnDiscard="DiscardAsync" OnFill="FillAsync" OnDecided="DecidedAsync" />
            </aside>
        </div>
    </div>

    <dialog id="world-step-dialog" class="codex-dialog codex-dialog-wide wb-raw-dialog" aria-labelledby="world-step-title" data-testid="world-step-dialog">
        <div class="dialog-body">
            <h2 id="world-step-title"><LucideIcon IconName="braces" Size="18" Class="title-icon" /> @L["WorldChat.Step.Title", rawStep?.Tool ?? ""]</h2>
            @if (rawStep != null)
            {
                @* The call as JSON; what came back is text, so it is shown as text rather than as one long escaped string. *@
                <div class="label-caps">@L["WorldChat.Step.Request"]</div>
                <pre class="wb-code wb-code-raw" data-testid="world-step-json">@WorldChatView.Raw(rawStep, withResult: false)</pre>
                @if (rawStep.Result != null)
                {
                    <div class="label-caps mt-3">@L["WorldChat.Step.Result"]</div>
                    <pre class="wb-code wb-code-raw">@rawStep.Result</pre>
                }
            }
        </div>
        <div class="dialog-actions">
            <CodexButton Variant="CodexButtonVariant.Etched" Icon="copy" OnClick="CopyRawAsync" data-testid="world-step-copy">@(copied ? L["WorldChat.Step.Copied"] : L["WorldChat.Step.Copy"])</CodexButton>
            <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="CloseRawAsync" data-testid="world-step-close">@L["Common.Close"]</CodexButton>
        </div>
    </dialog>

    <ConfirmDialog @ref="confirm" />
}

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    /// <summary>A starter to put in the message box ("settlement", "homebrew" with ?type=...), from the wiki's and the Library's
    /// "with AI" buttons; it opens a new chat.</summary>
    [Parameter] public string? Starter { get; set; }

    private static readonly string[] StarterKeys = { "settlement", "faction", "quest", "people", "homebrew", "variant", "revise", "tags" };

    private WorldChat? chat;
    private IReadOnlyList<WorldChatSummary> chats = Array.Empty<WorldChatSummary>();
    private bool aiReady;
    private string draft = string.Empty;
    // Which pane a phone shows ("chats", "talk", "ledger"), and whether the chats drawer is open beside a narrower conversation.
    private string pane = "talk";
    private bool drawer;
    private bool applying;
    private string? applyError;
    // How the last turn ended when it didn't land: an error, or a stop the DM asked for. The message is back in the box either way.
    private Flash? notice;
    // A new chat's first message, offered when this one has grown too long for the model: a recap of how this one ended.
    private string? carryOn;
    private IReadOnlyList<MissingMention> missing = Array.Empty<MissingMention>();
    private Dictionary<string, string> placeNames = new();
    private WorldProposalPanel? panel;
    private ConfirmDialog? confirm;
    private string? startedWith;
    private bool renaming;
    private string newTitle = string.Empty;
    private WorldChatStep? rawStep;
    private string rawJson = string.Empty;
    private bool copied;
    private bool followLog;
    private bool forceFollow;
    private bool composerChanged = true;
    private DateTime lastPaint;
    private CancellationTokenSource? ticking;

    // The reply that brought the waiting proposal, which carries the card that opens it; the last applied proposal's note.
    private WorldChatLine? proposalLine;
    private WorldChatLine? lastApplied;

    protected override async Task OnInitializedAsync()
    {
        if (!Ctx.IsDm) return;
        aiReady = await Ai.IsConfiguredAsync(Ctx.UserId);
        if (!aiReady) return;
        chats = await Sessions.ListAsync(Ctx.Access);
        var wanted = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("chat", out var id) ? id.ToString() : null;
        var opened = wanted != null ? await Sessions.OpenAsync(Ctx.Campaign, Ctx.Access, ChatId(wanted)) : null;
        if (opened == null && Starter == null && chats.Count > 0) opened = await Sessions.OpenAsync(Ctx.Campaign, Ctx.Access, chats[0].Id);
        await ShowAsync(opened ?? Sessions.New(Ctx.Campaign, Ctx.Access));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (chat == null || Starter == null || Starter == startedWith) return;
        startedWith = Starter;
        if (!StarterKeys.Contains(Starter)) return;
        if (chat.Lines.Count > 0 || chat.IsBusy) await ShowAsync(Sessions.New(Ctx.Campaign, Ctx.Access));
        if (Starter == "homebrew")
        {
            var type = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("type", out var t) ? t.ToString() : null;
            var label = type == null ? null : (await Builder.TypesAsync(Ctx.Campaign, Ctx.Access)).FirstOrDefault(x => string.Equals(x.Type, type, StringComparison.OrdinalIgnoreCase))?.Label;
            SetDraft(L["WorldChat.Starter.homebrew.Text", label ?? L["WorldChat.Starter.homebrew.Any"]]);
            return;
        }

        UseStarter(Starter);
    }

    // Chat ids are "worldchats/<guid>"; the address carries the guid.
    private static string ChatId(string fromAddress) => fromAddress.Contains('/') ? fromAddress : "worldchats/" + fromAddress;

    private static string AddressId(string chatId) => chatId.StartsWith("worldchats/", StringComparison.Ordinal) ? chatId["worldchats/".Length..] : chatId;

    /// <summary>Shows <paramref name="next"/>: hears its turn when one runs, and reads what its proposal needs.</summary>
    private async Task ShowAsync(WorldChat next)
    {
        if (chat != null) chat.Changed -= OnChatChanged;
        chat = next;
        chat.Changed += OnChatChanged;
        notice = null;
        applyError = null;
        renaming = false;
        drawer = false;
        forceFollow = true;
        draft = string.Empty;
        composerChanged = true;
        await AfterTurnAsync();
        if (chat.IsBusy) StartTicking();
    }

    private async Task OpenAsync(string id)
    {
        if (chat?.Id == id)
        {
            drawer = false;
            pane = "talk";
            return;
        }

        var opened = await Sessions.OpenAsync(Ctx.Campaign, Ctx.Access, id);
        if (opened == null)
        {
            chats = await Sessions.ListAsync(Ctx.Access);
            return;
        }

        await ShowAsync(opened);
        pane = "talk";
        Nav.NavigateTo($"{Ctx.BasePath}/build?chat={AddressId(id)}", replace: true);
    }

    private async Task NewChat()
    {
        await ShowAsync(Sessions.New(Ctx.Campaign, Ctx.Access));
        pane = "talk";
        Nav.NavigateTo($"{Ctx.BasePath}/build", replace: true);
    }

    private async Task CarryOnAsync()
    {
        var recap = carryOn;
        if (recap == null) return;
        await NewChat();
        notice = null;
        carryOn = null;
        SetDraft(recap);
    }

    /// <summary>How the chat ended, as the first message of a new one: the last of what the DM and the model said (no tool results,
    /// which are what made it too long), then the message that did not get through.</summary>
    private string Recap(WorldChat from, string unsent)
    {
        const int room = 6_000;
        var said = new List<string>();
        var length = 0;
        foreach (var line in from.Lines.Reverse().Where(l => l.Speaker != WorldChatSpeaker.Tool && !string.IsNullOrWhiteSpace(l.Text)))
        {
            var entry = $"{(line.Speaker == WorldChatSpeaker.Dm ? L["WorldChat.CarryOn.Me"] : L["WorldChat.CarryOn.You"])}: {TextFormatting.Summary(line.Text.Trim(), 1_500)}";
            if (length + entry.Length > room) break;
            said.Insert(0, entry);
            length += entry.Length;
        }

        return $"{L["WorldChat.CarryOn.Intro"]}\n\n{string.Join("\n\n", said)}\n\n{L["WorldChat.CarryOn.Next"]} {unsent.Trim()}";
    }

    private void UseStarter(string key)
    {
        SetDraft(key == "homebrew" ? L["WorldChat.Starter.homebrew.Text", L["WorldChat.Starter.homebrew.Any"]] : L[$"WorldChat.Starter.{key}.Text"]);
        _ = JS.InvokeVoidAsync("codex.focus", "world-chat-input");
    }

    private void SetDraft(string text)
    {
        draft = text;
        composerChanged = true;
    }

    // A turn moves on on its own thread: the page is redrawn on its own, every few words rather than every token. When the turn
    // ends (whichever page started it: the DM may have left and come back), what the page reads after a turn is read again.
    private void OnChatChanged() => _ = InvokeAsync(async () =>
    {
        var shown = chat;
        if (shown == null) return;
        if (!shown.IsBusy)
        {
            ticking?.Cancel();
            await AfterTurnAsync();
            chats = await Sessions.ListAsync(Ctx.Access);
            if (!ReferenceEquals(shown, chat)) return;
            forceFollow = true;
        }
        else if (DateTime.UtcNow - lastPaint < TimeSpan.FromMilliseconds(80))
        {
            return;
        }

        lastPaint = DateTime.UtcNow;
        followLog = true;
        StateHasChanged();
    });

    // While the model works with nothing to show (a long wait for the first word), the clock on the status line still moves.
    private void StartTicking()
    {
        ticking?.Cancel();
        ticking = new CancellationTokenSource();
        _ = TickAsync(ticking.Token);
    }

    private async Task TickAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (chat?.IsBusy != true) return;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Stop() => chat?.Stop();

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && chat?.IsBusy == true) chat.Stop();
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chat == null) return;
        var force = forceFollow;
        var follow = followLog || force;
        var grow = composerChanged;
        followLog = forceFollow = composerChanged = false;
        try
        {
            if (grow) await JS.InvokeVoidAsync("codex.composer", "world-chat-input", "world-chat-send");
            if (follow) await JS.InvokeVoidAsync("codex.followLog", "world-chat-log", force);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task SendAsync() => SendTextAsync(draft, fromBox: true);

    // fromBox: the DM typed it, so it leaves the box and goes back there if the turn doesn't land. Anything else (a request to write
    // what the proposal mentions) leaves what the DM is typing alone.
    private async Task SendTextAsync(string text, bool fromBox)
    {
        // Not while a proposal is being applied: the apply writes to the conversation too, and a turn stopped meanwhile would undo it.
        var sending = chat;
        if (sending == null || sending.IsBusy || applying || string.IsNullOrWhiteSpace(text)) return;
        if (fromBox) SetDraft(string.Empty);
        notice = null;
        carryOn = null;
        applyError = null;
        forceFollow = true;
        pane = "talk";
        StartTicking();
        Flash? failed = null;
        var task = sending.SendAsync(text, null, CancellationToken.None);
        // A new chat is listed as soon as its first message is stored, which is when the turn ends; show the turn now.
        StateHasChanged();
        try
        {
            await task;
        }
        catch (OperationCanceledException)
        {
            failed = new Flash(L["Common.Ai.Stopped"], FlashTone.Info);
        }
        catch (AiNotConfiguredException)
        {
            failed = Flash.Error(L["WorldChat.NoAi.Title"]);
        }
        catch (Exception ex) when (WorldChat.IsStale(ex))
        {
            // The message goes back to the box of the chat as it is now.
            await ReloadStaleAsync(sending, ex);
            if (chat?.Id == sending.Id) SetDraft(text);
            return;
        }
        catch (Exception ex) when (ex.InnerException is OperationCanceledException || ex is TaskCanceledException)
        {
            failed = new Flash(L["Common.Ai.Stopped"], FlashTone.Info);
        }
        catch (LocalizedException ex) when (ex.Key == "WorldChat.Error.TooLong")
        {
            failed = Flash.Error(L.Describe(ex));
            if (ReferenceEquals(sending, chat)) carryOn = Recap(sending, text);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "World-building chat failed");
            failed = Flash.Error(L["WorldChat.Error", AiFailureText.For(L, ex)]);
        }
        // The DM may have moved to another chat meanwhile; what went wrong belongs to the chat it happened in. What the page reads
        // after a turn is read when the chat says the turn ended (OnChatChanged).
        if (!ReferenceEquals(sending, chat)) return;
        if (failed != null)
        {
            notice = failed;
            if (fromBox || string.IsNullOrWhiteSpace(draft)) SetDraft(text);
        }
        else
        {
            if (!string.IsNullOrEmpty(sending.Id) && !Nav.Uri.Contains(AddressId(sending.Id), StringComparison.Ordinal))
            {
                Nav.NavigateTo($"{Ctx.BasePath}/build?chat={AddressId(sending.Id)}", replace: true);
            }

            _ = JS.InvokeVoidAsync("codex.focus", "world-chat-input");
        }
    }

    // What the page reads after a turn or on opening a chat: the reply that brought the proposal, the last applied one, the places
    // a proposal nests in, and what its texts mention that nothing is called.
    private async Task AfterTurnAsync()
    {
        if (chat == null) return;
        proposalLine = chat.Proposal == null ? null
            : chat.Lines.LastOrDefault(l => l.Speaker == WorldChatSpeaker.Model && l.Steps?.Any(s => s.Tool is "propose_changes" or "add_entries" && s is { Status: WorldChatStepStatus.Done, Rejected: false }) == true)
              ?? chat.Lines.LastOrDefault(l => l.Speaker == WorldChatSpeaker.Model);
        lastApplied = chat.Lines.LastOrDefault(l => l.Speaker == WorldChatSpeaker.Tool) is { Links.Count: > 0 } note && chat.Lines[^1] == note ? note : null;
        if (chat.Proposal != null)
        {
            placeNames = (await RegionRepo.GetVisibleForCampaignAsync(Ctx.Access)).SelectMany(r => r.Locations).GroupBy(l => l.Id).ToDictionary(g => g.Key, g => g.First().Name);
            missing = await Builder.MissingMentionsAsync(Ctx.Access, chat.Proposal);
        }
        else
        {
            missing = Array.Empty<MissingMention>();
        }
    }

    private void ShowProposal()
    {
        pane = "ledger";
        panel?.ReadNext();
    }

    // The last stretch of the reasoning, which can run long; the note shows what the model is on now.
    private static string Tail(string text)
    {
        const int Max = 600;
        var all = text.Trim();
        return all.Length <= Max ? all : "…" + all[^Max..].TrimStart();
    }

    // What the model is doing right now, for the status line: thinking, running a tool, or writing.
    private string Status(WorldChatLive live, IReadOnlyList<WorldChatStep> steps, string reply)
    {
        if (live.Thinking) return L["WorldChat.Thinking"];
        if (steps.LastOrDefault(s => s.Status == WorldChatStepStatus.Running) is { } running) return WorldChatView.Label(L, running);
        return reply.Length > 0 ? L["Common.Ai.Writing"] : L["WorldChat.Working"];
    }

    // Asks the model for what the proposal mentions and doesn't have, as the DM would: in the conversation, so it shows in the log.
    private async Task FillAsync(IReadOnlyList<MissingMention> wanted)
    {
        if (chat == null || chat.IsBusy || applying || wanted.Count == 0) return;
        var ask = wanted.Count == 1
            ? L["WorldChat.Fill.Message", wanted[0].Name, string.Join(", ", wanted[0].By)]
            : L["WorldChat.Fill.All", string.Join("; ", wanted.Select(m => $"“{m.Name}” ({string.Join(", ", m.By)})"))];
        await SendTextAsync(ask, fromBox: false);
    }

    private async Task DecidedAsync(string? reference)
    {
        if (chat == null) return;
        if (reference != null) chat.Decide(reference);
        if (!await KeepsUpAsync(chat, chat.SaveAsync)) return;
        if (chat.Proposal != null) missing = await Builder.MissingMentionsAsync(Ctx.Access, chat.Proposal);
        chats = await Sessions.ListAsync(Ctx.Access);
    }

    private async Task ApplyAsync()
    {
        if (chat?.Proposal == null || applying || chat.IsBusy) return;
        applying = true;
        applyError = null;
        try
        {
            // What was made is shown in the panel and the conversation; a flash above the workbench would only push it down.
            var result = await chat.ApplyAsync();
            if (result.Actors.Count > 0 || result.Places.Count > 0 || result.Shortlisted.Count > 0) await Ctx.ReloadAsync();
            forceFollow = true;
        }
        catch (Exception ex) when (WorldChat.IsStale(ex))
        {
            // Nothing was made: another tab changed (or applied) this chat first. Show it as it is now.
            applying = false;
            await ReloadStaleAsync(chat!, ex);
            return;
        }
        catch (Exception ex)
        {
            // What was stored stays stored (each entry remembers it), so Apply again only adds the rest.
            Logger.LogError(ex, "Applying a world-building proposal failed");
            applyError = L["WorldChat.Proposal.Failed", L.Describe(ex)];
        }
        finally
        {
            applying = false;
        }

        await AfterTurnAsync();
        chats = await Sessions.ListAsync(Ctx.Access);
    }

    private async Task DiscardAsync()
    {
        // Not while a turn is starting or under way: the chat refuses, and the proposal may be about to change.
        if (chat == null || chat.IsBusy || applying) return;
        if (!await KeepsUpAsync(chat, chat.DiscardAsync)) return;
        applyError = null;
        await AfterTurnAsync();
        chats = await Sessions.ListAsync(Ctx.Access);
    }

    private void StartRename()
    {
        newTitle = chat?.Title ?? string.Empty;
        renaming = true;
        _ = JS.InvokeVoidAsync("codex.focus", "world-chat-name");
    }

    private async Task RenameAsync()
    {
        renaming = false;
        if (chat == null || string.IsNullOrWhiteSpace(newTitle)) return;
        var title = newTitle;
        if (!await KeepsUpAsync(chat, () => chat.RenameAsync(title))) return;
        chats = await Sessions.ListAsync(Ctx.Access);
    }

    // Runs a change to the chat; when this tab's copy turns out to be behind the stored one, shows the stored one instead. False then.
    private async Task<bool> KeepsUpAsync(WorldChat changing, Func<Task> change)
    {
        try
        {
            await change();
            return true;
        }
        catch (Exception ex) when (WorldChat.IsStale(ex))
        {
            await ReloadStaleAsync(changing, ex);
            return false;
        }
    }

    // This tab's copy of the chat fell behind (another tab saved it since) or the chat was deleted: what it holds is dropped, and the
    // chat is shown as stored, with a note saying why.
    private async Task ReloadStaleAsync(WorldChat stale, Exception why)
    {
        var fresh = string.IsNullOrEmpty(stale.Id) ? null : await Sessions.OpenAsync(Ctx.Campaign, Ctx.Access, stale.Id);
        chats = await Sessions.ListAsync(Ctx.Access);
        if (!ReferenceEquals(stale, chat)) return;
        await ShowAsync(fresh ?? Sessions.New(Ctx.Campaign, Ctx.Access));
        notice = new Flash(L.Describe(why), FlashTone.Info);
        if (fresh == null) Nav.NavigateTo($"{Ctx.BasePath}/build", replace: true);
    }

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") renaming = false;
    }

    private async Task DeleteAsync()
    {
        if (chat == null || string.IsNullOrEmpty(chat.Id) || confirm == null) return;
        if (!await confirm.ShowAsync(L["WorldChat.DeleteConfirm.Title"], L["WorldChat.DeleteConfirm.Body", chat.Title], L["WorldChat.Delete"], isDestructive: true)) return;
        await Sessions.DeleteAsync(Ctx.Access, chat.Id);
        chats = await Sessions.ListAsync(Ctx.Access);
        var next = chats.Count > 0 ? await Sessions.OpenAsync(Ctx.Campaign, Ctx.Access, chats[0].Id) : null;
        await ShowAsync(next ?? Sessions.New(Ctx.Campaign, Ctx.Access));
        Nav.NavigateTo(next == null ? $"{Ctx.BasePath}/build" : $"{Ctx.BasePath}/build?chat={AddressId(next.Id)}", replace: true);
    }

    private async Task ShowRawAsync(WorldChatStep step)
    {
        rawStep = step;
        rawJson = WorldChatView.Raw(step);
        copied = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("codex.showModal", "world-step-dialog");
    }

    private async Task CopyRawAsync() => copied = await JS.InvokeAsync<bool>("codex.copyText", rawJson);

    private Task CloseRawAsync() => JS.InvokeVoidAsync("codex.closeModal", "world-step-dialog").AsTask();

    public void Dispose()
    {
        ticking?.Cancel();
        if (chat != null) chat.Changed -= OnChatChanged;
    }
}
