@using Codex.Core
@using Codex.Core.AI
@using Codex.Core.WorldBuilder
@using Codex.Persistence
@using Microsoft.AspNetCore.WebUtilities
@inject WorldChatSessions Sessions
@inject WorldBuilderService Builder
@inject IRegionRepository RegionRepo
@inject AiFeatures Ai
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<WorldChatSection> Logger
@implements IDisposable

@* The world builder: a conversation with the DM's own model, which reads the campaign through tools and proposes related
   pages, places, people, secrets and homebrew. A proposal is saved only when the DM applies it, hidden from players. *@

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["WorldChat.Title"]</h2>
        <p class="page-subtitle">@L["WorldChat.Subtitle"]</p>
    </div>
    @if (chat != null && (chat.Lines.Count > 0 || chat.Proposal != null))
    {
        <div class="row-actions">
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="RestartAsync" Disabled="@busy" data-testid="world-chat-restart"><LucideIcon IconName="rotate-ccw" Size="18" /> @L["WorldChat.Restart"]</CodexButton>
        </div>
    }
</div>

@if (!Ctx.IsDm)
{
    <div class="empty"><p>@L["WorldChat.DmOnly"]</p></div>
}
else if (!aiReady)
{
    <div class="empty">
        <div class="empty-icon"><LucideIcon IconName="sparkles" Size="28" /></div>
        <h3>@L["WorldChat.NoAi.Title"]</h3>
        <p>@L["WorldChat.NoAi.Body"]</p>
        <a href="/settings/ai" class="cx-btn cx-plaque">@L["WorldChat.NoAi.Settings"]</a>
    </div>
}
else if (chat != null)
{
    <div class="row g-3">
        <div class="@(chat.Proposal != null || result != null ? "col-lg-7" : "col-12")">
            <section class="panel world-chat" aria-labelledby="world-chat-heading">
                <h3 id="world-chat-heading" class="visually-hidden">@L["WorldChat.Conversation"]</h3>
                @if (chat.Lines.Count == 0 && !busy)
                {
                    <p class="small-muted">@L["WorldChat.Intro"]</p>
                    <div class="chips mb-3" role="group" aria-label="@L["WorldChat.Starters"]">
                        @foreach (var key in StarterKeys)
                        {
                            <button type="button" class="chip" @onclick="() => UseStarter(key)" data-testid="world-chat-starter-@key">@L[$"WorldChat.Starter.{key}.Label"]</button>
                        }
                    </div>
                }
                @* A window of its own once the conversation is long, so the message box and the proposal stay in reach; tabindex so the keyboard can scroll it. *@
                <ol id="world-chat-log" class="world-chat-log" role="log" tabindex="0" aria-label="@L["WorldChat.Conversation"]" aria-live="polite" aria-relevant="additions" data-testid="world-chat-log">
                    @foreach (var line in chat.Lines)
                    {
                        <li class="world-chat-line world-chat-@line.Speaker.ToString().ToLowerInvariant()">
                            @switch (line.Speaker)
                            {
                                case WorldChatSpeaker.Dm:
                                    <span class="visually-hidden">@L["WorldChat.You"]: </span>
                                    <div class="world-chat-bubble">@line.Text</div>
                                    break;
                                case WorldChatSpeaker.Model:
                                    <div class="world-chat-turn">
                                        @if (line.Steps is { Count: > 0 } steps)
                                        {
                                            @* What the model looked at to get here, folded away: there if the DM wonders, out of the way if not. *@
                                            <details class="world-chat-trail" data-testid="world-chat-steps">
                                                <summary>@L["WorldChat.Steps", steps.Count]</summary>
                                                @foreach (var step in steps)
                                                {
                                                    <div class="world-chat-step"><LucideIcon IconName="@(step.Icon ?? "search")" Size="14" /> @step.Text</div>
                                                }
                                            </details>
                                        }
                                        <span class="visually-hidden">@L["WorldChat.Model"]: </span>
                                        <div class="world-chat-bubble rules-text">@((MarkupString)TextFormatting.ToHtml(line.Text))</div>
                                    </div>
                                    break;
                                default:
                                    <div class="world-chat-note"><LucideIcon IconName="@(line.Icon ?? "info")" Size="14" /> @line.Text</div>
                                    break;
                            }
                        </li>
                    }
                    @if (busy && (working.Count > 0 || aside != null || (thoughtLive && thought.Length > 0)))
                    {
                        @* The turn under way: what the model has looked at so far, and on the last line what it is on now. *@
                        <li class="world-chat-line world-chat-tool">
                            <div class="world-chat-trail world-chat-trail-live" aria-live="off" data-testid="world-chat-trail">
                                @if (working.Count > ShownSteps)
                                {
                                    <div class="world-chat-step world-chat-earlier">@L["WorldChat.Earlier", working.Count - ShownSteps]</div>
                                }
                                @foreach (var step in working.Skip(Math.Max(0, working.Count - ShownSteps)))
                                {
                                    <div class="world-chat-step"><LucideIcon IconName="@(step.Icon ?? "search")" Size="14" /> @step.Text</div>
                                }
                                @if (thoughtLive && thought.Length > 0)
                                {
                                    <div class="world-chat-aside" data-testid="world-chat-thinking"><LucideIcon IconName="sparkles" Size="14" /> @Tail(thought)</div>
                                }
                                else if (streamed.Length == 0 && aside != null)
                                {
                                    <div class="world-chat-aside">@aside</div>
                                }
                            </div>
                        </li>
                    }
                    @if (busy && streamed.Length > 0)
                    {
                        @* The reply as it is written; aria-live off so a screen reader hears it once, when it lands in the log above. *@
                        <li class="world-chat-line world-chat-model" aria-live="off" data-testid="world-chat-streaming">
                            <div class="world-chat-bubble rules-text">@((MarkupString)TextFormatting.ToHtml(streamed.ToString()))</div>
                        </li>
                    }
                </ol>
                @if (busy)
                {
                    @* "Thinking" until the first words arrive, then "Writing": the label follows what the model is doing. *@
                    <AiWorking Text="@(streamed.Length > 0 ? L["Common.Ai.Writing"] : L["WorldChat.Working"])" OnStop="aiCall.Stop" TestId="world-chat-working" />
                }
                else if (notice != null)
                {
                    <div class="mt-2">
                        <StatusMessage Message="notice" OnDismiss="() => notice = null">
                            <Actions>
                                @if (!string.IsNullOrWhiteSpace(draft))
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="refresh-cw" OnClick="SendAsync" data-testid="world-chat-retry">@L["WorldChat.Retry"]</CodexButton>
                                }
                            </Actions>
                        </StatusMessage>
                    </div>
                }
                <form class="world-chat-form mt-3" @onsubmit="SendAsync" @onsubmit:preventDefault="true">
                    <label for="world-chat-input" class="visually-hidden">@L["WorldChat.MessageLabel"]</label>
                    <textarea id="world-chat-input" class="field-input" rows="3" @bind="draft" @bind:event="oninput" readonly="@busy"
                              placeholder="@L["WorldChat.Placeholder"]" aria-describedby="world-chat-hint" data-testid="world-chat-input"
                              @onkeydown="OnKeyAsync"></textarea>
                    <div class="d-flex gap-2 align-items-center flex-wrap mt-2">
                        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Disabled="@(busy || applying || string.IsNullOrWhiteSpace(draft))" data-testid="world-chat-send"><LucideIcon IconName="send" Size="16" /> @L["WorldChat.Send"]</CodexButton>
                        <span id="world-chat-hint" class="field-hint mb-0">@L["WorldChat.Hint"]</span>
                    </div>
                </form>
            </section>
        </div>

        @if (chat.Proposal is { } proposal)
        {
            <div class="col-lg-5">
                <section id="world-proposal" class="panel world-proposal world-side" aria-labelledby="world-proposal-heading" data-testid="world-proposal">
                    <div class="panel-title"><h3 id="world-proposal-heading" class="h6"><LucideIcon IconName="clipboard-check" Size="14" Class="title-icon" /> @L["WorldChat.Proposal.Title"]</h3></div>
                    @if (!string.IsNullOrWhiteSpace(proposal.Summary))
                    {
                        <p>@proposal.Summary</p>
                    }
                    <p class="field-hint">@L["WorldChat.Proposal.Hint"]</p>
                    @if (chat.ProposalWarnings.Count > 0)
                    {
                        <details class="mb-2">
                            <summary class="small text-warning">@L["WorldChat.Proposal.Warnings", chat.ProposalWarnings.Count]</summary>
                            <ul class="small mb-0">
                                @foreach (var warning in chat.ProposalWarnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (missing.Count > 0)
                    {
                        <div class="world-missing mb-2" data-testid="world-missing">
                            <h4 class="eyebrow">@L["WorldChat.Missing.Title"]</h4>
                            <ul class="list-unstyled mb-1">
                                @foreach (var m in missing)
                                {
                                    <li class="world-missing-row">
                                        <span><strong>@m.Name</strong> <span class="small-muted">@L["WorldChat.Missing.Mentions", string.Join(", ", m.By)]</span></span>
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="sparkles" OnClick="() => FillAsync(new[] { m })" Disabled="@(busy || applying)" data-testid="world-missing-write">@L["WorldChat.Missing.Write", m.Name]</CodexButton>
                                    </li>
                                }
                            </ul>
                            @if (missing.Count > 1)
                            {
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="sparkles" OnClick="() => FillAsync(missing)" Disabled="@(busy || applying)" data-testid="world-missing-all">@L["WorldChat.Missing.All", missing.Count]</CodexButton>
                            }
                        </div>
                    }
                    @foreach (var group in proposal.Drafts.GroupBy(d => d.Kind).OrderBy(g => Array.IndexOf(KindOrder, g.Key)))
                    {
                        <h4 class="eyebrow mt-3">@L[$"WorldChat.Kind.{group.Key}"]</h4>
                        <ul class="list-unstyled mb-0">
                            @foreach (var d in group)
                            {
                                var id = $"proposal-{d.Ref}";
                                <li class="world-proposal-entry" data-testid="world-proposal-entry">
                                    <div class="field-check">
                                        <input id="@id" type="checkbox" class="field-box" checked="@d.Selected" @onchange="e => SetSelected(proposal, d, (bool)(e.Value ?? false))" disabled="@applying" />
                                        <label for="@id"><strong>@d.Name</strong>@Detail(proposal, d)</label>
                                    </div>
                                    @if (d is { Kind: DraftKinds.Edit, SharedWithPlayers: true })
                                    {
                                        <div class="small ms-4 text-warning" data-testid="world-proposal-shared"><LucideIcon IconName="eye" Size="14" /> @L["WorldChat.Proposal.Shared"]</div>
                                    }
                                    @if (d.Kind == DraftKinds.Edit && !string.IsNullOrWhiteSpace(d.Before))
                                    {
                                        <details class="ms-4">
                                            <summary class="small">@L["WorldChat.Proposal.Current"]</summary>
                                            <div class="rules-text small mt-1" data-testid="world-proposal-before">@((MarkupString)TextFormatting.ToHtml(d.Before))</div>
                                        </details>
                                    }
                                    @if (d.Kind == DraftKinds.Npc)
                                    {
                                        <div class="field-check ms-4">
                                            <input id="@id-cast" type="checkbox" class="field-box" checked="@d.Cast" disabled="@(!d.Selected || applying)" @onchange="e => d.Cast = (bool)(e.Value ?? false)" data-testid="world-proposal-cast" />
                                            <label for="@id-cast" class="small">@(d.Stats is { } stats ? L["WorldChat.Proposal.CastAs", stats.Shown] : L["WorldChat.Proposal.Cast"])</label>
                                        </div>
                                    }
                                    else if (d.Kind == DraftKinds.Homebrew && d.Bestiary)
                                    {
                                        <div class="small-muted ms-4">@L["WorldChat.Proposal.Bestiary"]</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(d.Body))
                                    {
                                        <details class="ms-4">
                                            <summary class="small">@L["WorldChat.Proposal.Read"]</summary>
                                            <div class="rules-text small mt-1">@((MarkupString)TextFormatting.ToHtml(WorldBundleParser.ResolveLinks(d.Body, proposal, keepLinks: false)))</div>
                                        </details>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (applyError != null)
                    {
                        <p class="text-danger mt-2" role="alert">@applyError</p>
                    }
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="ApplyAsync" Disabled="@(applying || busy || !proposal.Drafts.Any(d => d.Selected))" data-testid="world-proposal-apply">
                            <LucideIcon IconName="check" Size="16" /> @L["WorldChat.Proposal.Apply", proposal.Drafts.Count(d => d.Selected)]
                        </CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="OpenReviewAsync" Disabled="@(applying || busy)" data-testid="world-proposal-review"><LucideIcon IconName="list" Size="16" /> @L["WorldChat.Review.Open"]</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="Discard" Disabled="@(applying || busy)" data-testid="world-proposal-discard">@L["WorldChat.Proposal.Discard"]</CodexButton>
                    </div>
                    @if (applying)
                    {
                        <AiWorking Text="@L["WorldChat.Proposal.Applying"]" TestId="world-proposal-applying" />
                    }
                </section>

                <dialog id="world-review-dialog" class="codex-dialog codex-dialog-review" aria-labelledby="world-review-title" data-testid="world-review-dialog">
                    @{
                        var order = ReviewOrder(proposal);
                        var current = order.FirstOrDefault(x => x.Ref == reviewRef) ?? order.FirstOrDefault();
                        var position = current == null ? 0 : order.IndexOf(current);
                        var left = order.Count(x => x.Selected && !decided.Contains(x.Ref));
                    }
                    <div class="dialog-body">
                        <h2 id="world-review-title"><LucideIcon IconName="clipboard-check" Size="18" Class="title-icon" /> @L["WorldChat.Review.Title"]</h2>
                        <div class="review-layout">
                            <nav class="review-rail" aria-label="@L["WorldChat.Review.Rail"]">
                                <ol class="list-unstyled mb-0">
                                    @foreach (var x in order)
                                    {
                                        var state = ReviewState(x);
                                        <li>
                                            <button type="button" class="review-rail-item @(x.Ref == current?.Ref ? "is-current" : null)" aria-current="@(x.Ref == current?.Ref ? "step" : null)" @onclick="() => reviewRef = x.Ref" data-testid="world-review-rail-item">
                                                <span class="review-dot review-dot-@state" aria-hidden="true"></span>
                                                <span class="review-rail-name">@x.Name</span>
                                                <span class="visually-hidden">(@L[$"WorldChat.Review.{state}"])</span>
                                            </button>
                                        </li>
                                    }
                                </ol>
                            </nav>
                            <section class="review-pane">
                                @if (current != null)
                                {
                                    var state = ReviewState(current);
                                    var cascade = CascadeCount(proposal, current);
                                    <p class="eyebrow mb-1" role="status">@L["WorldChat.Review.Step", position + 1, order.Count] · @L[$"WorldChat.Kind.{current.Kind}"]@Detail(proposal, current)</p>
                                    <h3 class="review-name">@current.Name <span class="chip review-state review-state-@state">@L[$"WorldChat.Review.{state}"]</span></h3>
                                    @if (!string.IsNullOrWhiteSpace(current.Pitch))
                                    {
                                        <p class="review-pitch">@current.Pitch</p>
                                    }
                                    @if (current is { Kind: DraftKinds.Edit, SharedWithPlayers: true })
                                    {
                                        <div class="small text-warning mb-2"><LucideIcon IconName="eye" Size="14" /> @L["WorldChat.Proposal.Shared"]</div>
                                    }
                                    @if (current.Kind == DraftKinds.Edit && !string.IsNullOrWhiteSpace(current.Before))
                                    {
                                        <details class="mb-2">
                                            <summary class="small">@L["WorldChat.Proposal.Current"]</summary>
                                            <div class="rules-text small mt-1">@((MarkupString)TextFormatting.ToHtml(current.Before))</div>
                                        </details>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(current.Body))
                                    {
                                        <div class="rules-text review-body" data-testid="world-review-body">@((MarkupString)TextFormatting.ToHtml(WorldBundleParser.ResolveLinks(current.Body, proposal, keepLinks: false)))</div>
                                    }
                                    @if (current.Kind == DraftKinds.Npc)
                                    {
                                        <div class="field-check">
                                            <input id="review-cast" type="checkbox" class="field-box" checked="@current.Cast" disabled="@(!current.Selected || applying)" @onchange="e => current.Cast = (bool)(e.Value ?? false)" />
                                            <label for="review-cast" class="small">@(current.Stats is { } stats ? L["WorldChat.Proposal.CastAs", stats.Shown] : L["WorldChat.Proposal.Cast"])</label>
                                        </div>
                                    }
                                    @if (missing.Where(m => m.ByRefs.Contains(current.Ref)).ToList() is { Count: > 0 } here)
                                    {
                                        <div class="world-missing mt-3">
                                            <h4 class="eyebrow">@L["WorldChat.Missing.Title"]</h4>
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var m in here)
                                                {
                                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="sparkles" OnClick="() => FillAsync(new[] { m })" Disabled="@(busy || applying)" data-testid="world-review-write">@L["WorldChat.Missing.Write", m.Name]</CodexButton>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (cascade > 0 && current.Selected)
                                    {
                                        <p class="small-muted mt-3 mb-0">@L["WorldChat.Review.SkippedAlso", cascade]</p>
                                    }
                                }
                                @if (busy)
                                {
                                    <AiWorking Text="@L["WorldChat.Working"]" OnStop="aiCall.Stop" TestId="world-review-working" />
                                }
                                else if (notice != null)
                                {
                                    @* The dialog covers the page, so what went wrong with a turn it started is shown here too. *@
                                    <div class="mt-2" data-testid="world-review-notice">
                                        <StatusMessage Message="notice" OnDismiss="() => notice = null" />
                                    </div>
                                }
                                @if (applyError != null)
                                {
                                    <p class="text-danger mt-2" role="alert" data-testid="world-review-error">@applyError</p>
                                }
                            </section>
                        </div>
                        @if (left == 0 && order.Count > 0)
                        {
                            <p class="review-done mb-0" role="status" data-testid="world-review-done">@L["WorldChat.Review.Done", order.Count(x => x.Selected)]</p>
                        }
                    </div>
                    <div class="dialog-actions review-actions">
                        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => Step(order, position - 1)" Disabled="@(position == 0)" data-testid="world-review-back"><LucideIcon IconName="chevron-left" Size="16" /> @L["WorldChat.Review.Back"]</CodexButton>
                        @if (current != null)
                        {
                            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => SkipDraft(proposal, current)" Disabled="@(busy || applying)" data-testid="world-review-skip"><LucideIcon IconName="x" Size="16" /> @L["WorldChat.Review.Skip"]</CodexButton>
                            <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="() => Accept(proposal, current)" Disabled="@(busy || applying)" data-testid="world-review-accept"><LucideIcon IconName="check" Size="16" /> @L["WorldChat.Review.Accept"]</CodexButton>
                        }
                        @if (left > 1)
                        {
                            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => AcceptRest(proposal)" Disabled="@(busy || applying)" data-testid="world-review-accept-rest">@L["WorldChat.Review.AcceptRest"]</CodexButton>
                        }
                        <span class="review-spacer"></span>
                        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseReviewAsync" data-testid="world-review-close">@L["WorldChat.Review.Close"]</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="ApplyFromReviewAsync" Disabled="@(applying || busy || !proposal.Drafts.Any(x => x.Selected))" data-testid="world-review-apply">
                            <LucideIcon IconName="check" Size="16" /> @L["WorldChat.Proposal.Apply", proposal.Drafts.Count(x => x.Selected)]
                        </CodexButton>
                    </div>
                </dialog>
            </div>
        }
        else if (result != null)
        {
            <div class="col-lg-5">
                <section class="panel world-side" aria-labelledby="world-result-heading" data-testid="world-result">
                    <div class="panel-title"><h3 id="world-result-heading" class="h6"><LucideIcon IconName="check" Size="14" Class="title-icon" /> @L["WorldChat.Result.Title", result.Count]</h3></div>
                    <p class="field-hint">@L["WorldChat.Result.Hint"]</p>
                    <ul class="link-list mb-0">
                        @foreach (var written in result.Pages)
                        {
                            <li><a href="@Ctx.BasePath/wiki/@written.Slug"><LucideIcon IconName="book-open" Size="14" /> @written.Title</a></li>
                        }
                        @foreach (var actor in result.Actors)
                        {
                            <li><a href="@Ctx.BasePath/actors/@actor.Id"><LucideIcon IconName="user" Size="14" /> @actor.Name</a></li>
                        }
                        @foreach (var place in result.Places)
                        {
                            <li><a href="@Ctx.BasePath/world#place-@place.Id"><LucideIcon IconName="map-pin" Size="14" /> @place.Name</a></li>
                        }
                        @foreach (var entry in result.Entries)
                        {
                            <li><a href="@Ctx.BasePath/library/@entry.Type/@entry.EntryId"><LucideIcon IconName="book-marked" Size="14" /> @entry.Name</a></li>
                        }
                        @foreach (var change in result.Changes)
                        {
                            <li data-testid="world-result-change"><a href="@ChangeHref(change)"><LucideIcon IconName="edit-3" Size="14" /> @change.Name</a> <span class="small-muted">@L[$"WorldChat.Edit.{change.Target}"]</span></li>
                        }
                        @if (result.Facts.Count > 0)
                        {
                            <li><a href="@Ctx.BasePath/lore"><LucideIcon IconName="key-round" Size="14" /> @L["WorldChat.Result.Secrets", result.Facts.Count]</a></li>
                        }
                    </ul>
                </section>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    /// <summary>A starter to put in the message box: "settlement", "faction", "quest", "people" or "homebrew" (with ?type=).</summary>
    [Parameter] public string? Starter { get; set; }

    private static readonly string[] StarterKeys = { "settlement", "faction", "quest", "people", "homebrew" };
    // ---- Reviewing a proposal one entry at a time ----

    // What the ticked entries link to by name that nobody has written: the model mentioned them, the DM can ask for them.
    private IReadOnlyList<MissingMention> missing = Array.Empty<MissingMention>();
    // The entry the review shows, and the ones the DM has decided on (by ref). An unticked entry is skipped however it got that way.
    private string? reviewRef;
    private int shownEpoch;
    private readonly HashSet<string> decided = new(StringComparer.OrdinalIgnoreCase);

    private static List<WorldDraft> ReviewOrder(WorldBundle proposal) =>
        proposal.Drafts.OrderBy(d => Array.IndexOf(KindOrder, d.Kind)).ToList();

    private string ReviewState(WorldDraft d) => !d.Selected ? "Skipped" : decided.Contains(d.Ref) ? "Accepted" : "Pending";

    private async Task RefreshMissingAsync() =>
        missing = chat?.Proposal is { } proposal ? await Builder.MissingMentionsAsync(Ctx.Access, proposal) : Array.Empty<MissingMention>();

    // Unticking an entry unticks what only exists because of it (the places inside it), so no place is left without its parent.
    private async Task SetSelected(WorldBundle proposal, WorldDraft d, bool on)
    {
        if (on) proposal.Select(d);
        else proposal.Skip(d);
        await RefreshMissingAsync();
    }

    private async Task OpenReviewAsync()
    {
        if (chat?.Proposal is not { } proposal) return;
        var order = ReviewOrder(proposal);
        reviewRef = (order.FirstOrDefault(d => d.Selected && !decided.Contains(d.Ref)) ?? order.FirstOrDefault())?.Ref;
        StateHasChanged();
        await JS.InvokeVoidAsync("codex.showModal", "world-review-dialog");
    }

    private Task CloseReviewAsync() => JS.InvokeVoidAsync("codex.closeModal", "world-review-dialog").AsTask();

    private void Step(List<WorldDraft> order, int to)
    {
        if (to >= 0 && to < order.Count) reviewRef = order[to].Ref;
    }

    // After a decision, the next entry still waiting; when none is, stay where the DM is.
    private void Advance(WorldBundle proposal, WorldDraft from)
    {
        var order = ReviewOrder(proposal);
        var after = order.Skip(order.IndexOf(from) + 1).Concat(order.Take(order.IndexOf(from)));
        reviewRef = (after.FirstOrDefault(d => d.Selected && !decided.Contains(d.Ref)) ?? from).Ref;
    }

    private async Task Accept(WorldBundle proposal, WorldDraft d)
    {
        foreach (var up in proposal.Select(d)) decided.Add(up.Ref); // the place it sits in comes back with it
        decided.Add(d.Ref);
        Advance(proposal, d);
        await RefreshMissingAsync();
    }

    private async Task SkipDraft(WorldBundle proposal, WorldDraft d)
    {
        decided.Add(d.Ref);
        foreach (var also in proposal.Skip(d)) decided.Add(also.Ref);
        Advance(proposal, d);
        await RefreshMissingAsync();
    }

    private void AcceptRest(WorldBundle proposal)
    {
        foreach (var d in proposal.Drafts.Where(d => d.Selected)) decided.Add(d.Ref);
    }

    // How many other entries skipping this one would skip, for the note under it; nothing is changed.
    private static int CascadeCount(WorldBundle proposal, WorldDraft d) => proposal.WouldSkip(d).Count;

    // Asks the model for what the proposal mentions and doesn't have, as the DM would: in the conversation, so it shows in the log.
    private async Task FillAsync(IReadOnlyList<MissingMention> wanted)
    {
        if (chat == null || busy || applying || wanted.Count == 0) return;
        var ask = wanted.Count == 1
            ? L["WorldChat.Fill.Message", wanted[0].Name, string.Join(", ", wanted[0].By)]
            : L["WorldChat.Fill.All", string.Join("; ", wanted.Select(m => $"“{m.Name}” ({string.Join(", ", m.By)})"))];
        await SendTextAsync(ask, fromBox: false);
    }

    private async Task ApplyFromReviewAsync()
    {
        await ApplyAsync();
        if (chat?.Proposal == null) await CloseReviewAsync();
    }

    private static readonly string[] KindOrder = { DraftKinds.Edit, DraftKinds.Place, DraftKinds.Npc, DraftKinds.Wiki, DraftKinds.Fact, DraftKinds.Homebrew };

    private WorldChat? chat;
    private bool aiReady;
    private bool busy;
    private bool applying;
    private string draft = string.Empty;
    // How the last turn ended when it didn't land: an error, or a stop the DM asked for. The message is back in the box either way.
    private Flash? notice;
    private bool followLog;
    private bool forceFollow;
    // The proposal the page has shown, so a new one can be brought into view (the columns stack on a narrow screen).
    private WorldBundle? shownProposal;
    private bool revealProposal;
    // Which send is current. A callback from a stopped turn can still be queued when the next one starts; it must not write into it.
    private int run;
    private bool focusInput;
    private string? applyError;
    private WorldBuildResult? result;
    // What the model looked up during the turn under way, shown until its reply arrives.
    private readonly List<WorldChatLine> working = new();
    // The reply and the reasoning of the turn under way, as far as they have arrived; thoughtLive while the model is still reasoning.
    private readonly System.Text.StringBuilder streamed = new();
    private readonly System.Text.StringBuilder thought = new();
    // What the model said before its latest tool call ("Got it, let me look…"): one line, replaced by the next, never a pile.
    private string? aside;
    private const int ShownSteps = 5;
    private bool thoughtLive;
    private DateTime lastPaint;
    private readonly AiCall aiCall = new();
    private string? startedWith;

    protected override async Task OnInitializedAsync()
    {
        if (!Ctx.IsDm) return;
        aiReady = await Ai.IsConfiguredAsync(Ctx.UserId);
        chat = Sessions.For(Ctx.Campaign, Ctx.Access);
        shownProposal = chat.Proposal;
        shownEpoch = chat.ProposalEpoch;
        await RefreshMissingAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (chat == null || Starter == null || Starter == startedWith) return;
        startedWith = Starter;
        if (!StarterKeys.Contains(Starter)) return;
        if (Starter == "homebrew")
        {
            var type = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("type", out var t) ? t.ToString() : null;
            var label = type == null ? null : (await Builder.TypesAsync(Ctx.Campaign, Ctx.Access)).FirstOrDefault(x => string.Equals(x.Type, type, StringComparison.OrdinalIgnoreCase))?.Label;
            draft = L["WorldChat.Starter.homebrew.Text", label ?? L["WorldChat.Starter.homebrew.Any"]];
            return;
        }

        UseStarter(Starter);
    }

    private void UseStarter(string key)
    {
        draft = key == "homebrew" ? L["WorldChat.Starter.homebrew.Text", L["WorldChat.Starter.homebrew.Any"]] : L[$"WorldChat.Starter.{key}.Text"];
        _ = JS.InvokeVoidAsync("codex.focus", "world-chat-input");
    }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        // Ctrl/Cmd+Enter sends; Enter alone makes a new line, as in the other long text boxes.
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await SendAsync();
        else if (e.Key == "Escape" && busy) aiCall.Stop();
    }

    // Follows the reply as it is written inside the log (only while the DM is already at its end, so reading back up is left
    // alone), brings a new proposal into view, and hands the keyboard back to the message box once the turn is over.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!busy && !followLog && !focusInput && !revealProposal) return;
        var focus = focusInput && !busy;
        var force = forceFollow;
        var reveal = revealProposal;
        followLog = forceFollow = revealProposal = false;
        if (focus) focusInput = false;
        try
        {
            await JS.InvokeVoidAsync("codex.followLog", "world-chat-log", force);
            if (reveal) await JS.InvokeVoidAsync("codex.revealPanel", "world-proposal");
            if (focus) await JS.InvokeVoidAsync("codex.focus", "world-chat-input");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task SendAsync() => SendTextAsync(draft, fromBox: true);

    // fromBox: the DM typed it, so it leaves the box and goes back there if the turn doesn't land. Anything else (a request to write
    // what the proposal mentions) leaves what the DM is typing alone, and only takes the empty box to be retried from.
    private async Task SendTextAsync(string text, bool fromBox)
    {
        // Not while a proposal is being applied: the apply writes to the conversation too, and a turn stopped meanwhile would undo it.
        if (chat == null || busy || applying || string.IsNullOrWhiteSpace(text)) return;
        if (fromBox) draft = string.Empty;
        busy = true;
        forceFollow = true;
        notice = null;
        result = null;
        working.Clear();
        streamed.Clear();
        thought.Clear();
        aside = null;
        thoughtLive = false;
        var ct = aiCall.Begin();
        var mine = ++run;
        void Restore()
        {
            if (fromBox || string.IsNullOrWhiteSpace(draft)) draft = text;
        }

        try
        {
            await chat.SendAsync(text, line => InvokeAsync(() =>
            {
                if (mine != run || !busy) return;
                // A tool call ends the round: the words before it were a preamble, not the answer.
                if (streamed.Length > 0) aside = streamed.ToString().Trim();
                streamed.Clear();
                thought.Clear();
                thoughtLive = false;
                working.Add(line);
                Paint(force: true);
            }), ct, delta => InvokeAsync(() =>
            {
                if (mine != run || !busy) return;
                if (delta.Reasoning)
                {
                    // Reasoning after a stretch of reply is a new round of thinking, not more of the old one.
                    if (!thoughtLive) thought.Clear();
                    thought.Append(delta.Text);
                }
                else
                {
                    streamed.Append(delta.Text);
                }

                thoughtLive = delta.Reasoning;
                Paint();
            }));
        }
        catch (Exception) when (ct.IsCancellationRequested)
        {
            // Whatever shape the SDK gave the cancellation (some wrap it), a stop the DM asked for is not an error.
            notice = new Flash(L["Common.Ai.Stopped"], FlashTone.Info);
            Restore();
        }
        catch (AiNotConfiguredException)
        {
            notice = Flash.Error(L["WorldChat.NoAi.Title"]);
            Restore();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "World-building chat failed");
            notice = Flash.Error(L["WorldChat.Error", AiFailureText.For(L, ex)]);
            Restore();
        }
        finally
        {
            aiCall.End(ct);
            working.Clear();
            streamed.Clear();
            thought.Clear();
            aside = null;
            busy = false;
            followLog = true;
            focusInput = notice == null;
        }

        if (chat.Proposal != null)
        {
            await LoadPlacesAsync();
            // Entries added to the proposal keep the DM's decisions; a proposal made afresh starts the review over (its refs may repeat).
            if (chat.ProposalEpoch != shownEpoch) decided.Clear();
            shownEpoch = chat.ProposalEpoch;
            await RefreshMissingAsync();
            if (!ReferenceEquals(chat.Proposal, shownProposal)) revealProposal = true;
        }
        else
        {
            missing = Array.Empty<MissingMention>();
        }

        shownProposal = chat.Proposal;
    }

    // Every few words, not every token: each render is a round trip to the browser.
    private void Paint(bool force = false)
    {
        if (!force && DateTime.UtcNow - lastPaint < TimeSpan.FromMilliseconds(80)) return;
        lastPaint = DateTime.UtcNow;
        StateHasChanged();
    }

    // The last stretch of the reasoning, which can run long; the note shows what the model is on now.
    private static string Tail(System.Text.StringBuilder text)
    {
        const int Max = 400;
        var all = text.ToString().Trim();
        return all.Length <= Max ? all : "…" + all[^Max..].TrimStart();
    }

    private async Task ApplyAsync()
    {
        if (chat?.Proposal == null || applying || busy) return;
        applying = true;
        applyError = null;
        try
        {
            result = await chat.ApplyAsync();
            decided.Clear();
            missing = Array.Empty<MissingMention>();
            Ctx.Notify(Flash.Success(L["WorldBuilder.Saved", result.Count]));
            if (result.Actors.Count > 0 || result.Places.Count > 0) await Ctx.ReloadAsync();
        }
        catch (Exception ex)
        {
            // What was stored stays stored (each entry remembers it), so Apply again only adds the rest.
            Logger.LogError(ex, "Applying a world-building proposal failed");
            applyError = L["WorldChat.Proposal.Failed", L.Describe(ex)];
        }
        finally
        {
            applying = false;
        }
    }

    private void Discard()
    {
        chat?.Discard();
        applyError = null;
        decided.Clear();
        missing = Array.Empty<MissingMention>();
    }

    private void RestartAsync()
    {
        aiCall.Stop();
        chat = Sessions.Restart(Ctx.Campaign, Ctx.Access);
        shownProposal = null;
        result = null;
        notice = null;
        applyError = null;
        draft = string.Empty;
    }

    /// <summary>" — settlement in Greyharbour": what kind of entry it is and, for a place, where it goes.</summary>
    private string Detail(WorldBundle proposal, WorldDraft d)
    {
        var parts = new List<string>();
        if (d.Kind == DraftKinds.Edit)
        {
            parts.Add(L[$"WorldChat.Edit.{WorldBundle.ParseTarget(d.Target ?? string.Empty, out _)}"]);
        }
        else if (d.Kind == DraftKinds.Place)
        {
            if (d.PlaceKind != null) parts.Add(L[$"Campaign.Places.Kind.{(d.PlaceKind == "site" ? "Site" : char.ToUpperInvariant(d.PlaceKind[0]) + d.PlaceKind[1..])}"]);
            var parent = d.Parent == null ? null
                : d.Parent.StartsWith(WorldBundle.ExistingPrefix, StringComparison.Ordinal) ? PlaceName(d.Parent)
                : proposal.Find(d.Parent)?.Name;
            if (parent != null) parts.Add(L["Campaign.Places.InPlace", parent]);
            else if (!string.IsNullOrWhiteSpace(proposal.Region)) parts.Add(L["Campaign.Places.InPlace", proposal.Region]);
        }
        else if (d.Kind == DraftKinds.Wiki && d.PageKind is "faction" or "quest")
        {
            parts.Add(L[$"Campaign.Wiki.Kind.{(d.PageKind == "faction" ? "Faction" : "Quest")}"]);
        }
        else if (d.Kind == DraftKinds.Homebrew && d.Type != null)
        {
            parts.Add(d.Type);
        }

        return parts.Count == 0 ? string.Empty : " — " + string.Join(", ", parts);
    }

    private string ChangeHref(WorldEdit change) => change.Target switch
    {
        EditTarget.Place => $"{Ctx.BasePath}/world#place-{change.Id}",
        EditTarget.Actor => $"{Ctx.BasePath}/actors/{change.Id}",
        _ => $"{Ctx.BasePath}/wiki/{change.Id}"
    };

    private string? PlaceName(string key)
    {
        var id = key[(WorldBundle.ExistingPrefix + WorldBundle.PlacePrefix).Length..];
        return placeNames.GetValueOrDefault(id) ?? L["WorldChat.Proposal.ExistingPlace"];
    }

    // The campaign's places by id, to name an existing parent on the proposal card; read again after each turn.
    private Dictionary<string, string> placeNames = new();

    private async Task LoadPlacesAsync() =>
        placeNames = (await RegionRepo.GetVisibleForCampaignAsync(Ctx.Access)).SelectMany(r => r.Locations).GroupBy(l => l.Id).ToDictionary(g => g.Key, g => g.First().Name);

    public void Dispose() => aiCall.Dispose();
}
