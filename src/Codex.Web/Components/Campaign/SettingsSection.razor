@using System.Text
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject ICampaignRepository CampaignRepo
@inject IUserRepository UserRepo
@inject ISystemCatalog Catalog
@inject IContentRegistry Registry
@inject CampaignExportService ExportService
@inject IServerSettingsStore ServerSettings
@inject IMediaStore Media
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IJSRuntime JS

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["Campaign.Settings.Title"]</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? L["Campaign.Settings.Subtitle.Dm"] : L["Campaign.Settings.Subtitle.Player"])</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <section class="panel" aria-labelledby="details-heading">
            <div class="panel-title"><h3 id="details-heading">@L["Campaign.Settings.Details"]</h3></div>
            @if (Ctx.IsDm)
            {
                <form @onsubmit="SaveDetailsAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="cs-name" class="field-label">@L["Campaign.Settings.Name"]</label>
                        <input id="cs-name" class="field-input" @bind="name" @bind:after="() => nameError = null" required maxlength="120" data-testid="settings-name"
                               aria-invalid="@(nameError == null ? null : "true")" aria-describedby="@(nameError == null ? null : "cs-name-error")" />
                        <FieldError Id="cs-name-error" Message="@nameError" TestId="settings-name-error" />
                    </div>
                    <div class="mb-3">
                        <label for="cs-tagline" class="field-label">@L["Campaign.Settings.Tagline"]</label>
                        <input id="cs-tagline" class="field-input" @bind="tagline" @bind:event="oninput" maxlength="@CampaignDocument.MaxTagline" aria-describedby="cs-tagline-hint" data-testid="settings-tagline" />
                        <div id="cs-tagline-hint" class="field-hint d-flex justify-content-between gap-2"><span>@L["Campaign.Settings.TaglineHint"]</span><span aria-hidden="true">@tagline.Length / @CampaignDocument.MaxTagline</span></div>
                    </div>
                    <div class="mb-3">
                        <label for="cs-desc" class="field-label">@L["Campaign.Settings.Description"]</label>
                        <MarkdownEditor Id="cs-desc" Title="@L["Campaign.Settings.Description"]" Rows="8" @bind-Value="description" DescribedBy="cs-desc-hint" TestId="settings-description" />
                        <div id="cs-desc-hint" class="field-hint">@L["Campaign.Settings.DescriptionHint"]</div>
                    </div>
                    <div class="mb-3">
                        <label for="cs-system" class="field-label">@L["Campaign.Settings.GameSystem"]</label>
                        <select id="cs-system" class="field-select" @bind="systemId" aria-describedby="cs-system-help" data-testid="settings-system">
                            @if (Ctx.SystemMissing)
                            {
                                @* Without this the browser shows the first installed system as if it were chosen, and saving
                                   the form for any other reason would switch the campaign to it. *@
                                <option value="@Ctx.Campaign.SystemId" disabled>@L["Campaign.Settings.SystemNotInstalled", Ctx.Campaign.SystemId]</option>
                            }
                            @foreach (var system in Catalog.Systems)
                            {
                                <option value="@system.Id">@system.Name</option>
                            }
                        </select>
                        <div id="cs-system-help" class="field-hint">@L["Campaign.Settings.SystemHint"]</div>
                    </div>
                    @if (Ctx.System?.SheetRules != null)
                    {
                        <div class="mb-3">
                            <label for="cs-rules" class="field-label">@L["Campaign.Settings.Rules.Label"]</label>
                            <select id="cs-rules" class="field-select" @bind="rulesEnforcement" aria-describedby="cs-rules-help" data-testid="settings-rules">
                                <option value="inherit">@L["Campaign.Settings.Rules.Inherit", Ctx.System.SheetRules.Enforcement]</option>
                                <option value="strict">@L["Campaign.Settings.Rules.Strict"]</option>
                                <option value="warn">@L["Campaign.Settings.Rules.Warn"]</option>
                                <option value="off">@L["Campaign.Settings.Rules.Off"]</option>
                            </select>
                            <div id="cs-rules-help" class="field-hint">@L["Campaign.Settings.Rules.Hint"]</div>
                        </div>
                    }
                    <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="settings-save" data-save-shortcut="" Busy="@saveGate.IsBusy">@L["Campaign.Settings.SaveDetails"]</CodexButton>
                </form>
            }
            else
            {
                <dl class="prop-list mb-0">
                    <dt>@L["Campaign.Settings.Name"]</dt><dd>@Ctx.Campaign.Name</dd>
                    <dt>@L["Campaign.Settings.System"]</dt><dd>@Catalog.GetDisplayName(Ctx.Campaign.SystemId)</dd>
                    <dt>@L["Campaign.Settings.Tagline"]</dt><dd>@(string.IsNullOrWhiteSpace(Ctx.Campaign.Tagline) ? "—" : Ctx.Campaign.Tagline)</dd>
                    <dt>@L["Campaign.Settings.Description"]</dt><dd>@if (string.IsNullOrWhiteSpace(Ctx.Campaign.Description)) { <text>—</text> } else { <div class="rules-text">@((MarkupString)Codex.Core.TextFormatting.ToHtml(Ctx.Campaign.Description))</div> }</dd>
                </dl>
            }
        </section>

        @if (Ctx.IsDm)
        {
            <section class="panel" aria-labelledby="art-heading">
                <div class="panel-title"><h3 id="art-heading"><LucideIcon IconName="image" Size="18" Class="title-icon" /> @L["Campaign.Settings.Cover.Title"]</h3></div>
                <div class="cover-settings">
                    <div class="cover-preview @(Ctx.Campaign.HasCover ? "has-cover" : "")" style="@(Ctx.Campaign.HasCover ? $"background-image:url('{MediaEndpoints.CoverUrl(Ctx.Campaign)}')" : "")" role="img" aria-label="@(Ctx.Campaign.HasCover ? L["Campaign.Settings.Cover.Current"] : L["Campaign.Settings.Cover.None"])">
                        @if (!Ctx.Campaign.HasCover)
                        {
                            <LucideIcon IconName="image" Size="28" />
                        }
                    </div>
                    <div>
                        <p class="small-muted">@L["Campaign.Settings.Cover.Hint"]</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <label class="cx-btn cx-etched cx-sm mb-0">
                                <LucideIcon IconName="upload" Size="14" /> @(Ctx.Campaign.HasCover ? L["Campaign.Settings.Cover.Replace"] : L["Campaign.Settings.Cover.Upload"])
                                <InputFile OnChange="UploadCoverAsync" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" class="visually-hidden" />
                            </label>
                            @if (Ctx.Campaign.HasCover)
                            {
                                <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="RemoveCoverAsync">@L["Campaign.Settings.Remove"]</CodexButton>
                            }
                        </div>
                        <FieldError Id="cs-cover-error" Message="@coverError" TestId="settings-cover-error" />
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="packs-heading">
                <div class="panel-title"><h3 id="packs-heading">@L["Campaign.Settings.Packs.Title"]</h3></div>
                @{
                    var packs = Registry.GetPacks(Ctx.Campaign.SystemId).Where(p => !p.IsTranslation).ToList();
                }
                @if (packs.Count == 0)
                {
                    <p class="small-muted mb-0">@L["Campaign.Settings.Packs.None"]</p>
                }
                else
                {
                    <p class="small-muted">@L["Campaign.Settings.Packs.Hint"]</p>
                    @foreach (var pack in packs)
                    {
                        <div class="field-check mb-1">
                            <input id="pack-@pack.Id" type="checkbox" class="field-box" checked="@IsActive(pack.Id)" @onchange="e => TogglePack(pack.Id, (bool)(e.Value ?? false))" />
                            <label for="pack-@pack.Id" >@pack.Name <span class="pill ms-2">@pack.Kind</span></label>
                        </div>
                    }
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="mt-2" OnClick="SavePacksAsync" Busy="@saveGate.IsBusy">@L["Campaign.Settings.Packs.Save"]</CodexButton>
                }
            </section>
        }

        <section class="panel" aria-labelledby="members-heading">
            <div class="panel-title"><h3 id="members-heading">@L["Campaign.Settings.Members"]</h3></div>
            <ul class="list-unstyled mb-0">
                @foreach (var member in Ctx.Campaign.Members)
                {
                    var isOwner = member.UserId == Ctx.Campaign.OwnerId;
                    var who = usernames.GetValueOrDefault(member.UserId, member.UserId);
                    <li class="list-row" data-testid="member-@member.UserId">
                        <div class="row-main">
                            <div class="row-title">@who @(isOwner ? L["Campaign.Settings.Owner"] : "")</div>
                        </div>
                        @* Only the owner changes who GMs the campaign (docs/SERVER_ACCESS_AND_VAULT.md 4): a co-GM manages the players. *@
                        @if (Ctx.IsDm && !isOwner && (IsOwner || member.Role != CampaignRole.DM))
                        {
                            <div class="row-actions">
                                <label for="role-@member.UserId" class="visually-hidden">@L["Campaign.Settings.RoleFor", usernames.GetValueOrDefault(member.UserId, member.UserId)]</label>
                                @* Keyed on the times a change was called off, so a refused pick is redrawn as the role it still is. *@
                                <select @key="(member.UserId, roleResets)" id="role-@member.UserId" class="field-select field-sm" value="@member.Role" @onchange="e => ChangeRoleAsync(member, e.Value?.ToString())">
                                    @* Observer is not offered: nothing reads it, so it is a player by another name. A member who has it keeps it. *@
                                    @foreach (var role in Enum.GetValues<CampaignRole>().Where(r => (r != CampaignRole.Observer || r == member.Role) && (r != CampaignRole.DM || IsOwner)))
                                    {
                                        <option value="@role">@RoleLabel(role, isOwner: false)</option>
                                    }
                                </select>
                                @if (IsOwner && member.Role == CampaignRole.DM)
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => PassOnAsync(member)" aria-label="@L["Campaign.Settings.PassOnLabel", who]" data-testid="@($"pass-on-{member.UserId}")">@L["Campaign.Settings.PassOn"]</CodexButton>
                                }
                                <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="() => RemoveMemberAsync(member)" aria-label="@L["Campaign.Settings.RemoveFromCampaign", who]">@L["Campaign.Settings.Remove"]</CodexButton>
                            </div>
                        }
                        else
                        {
                            <div class="row-actions">
                                <span class="pill @(member.Role == CampaignRole.DM ? "pill-accent" : "")">@RoleLabel(member.Role, isOwner)</span>
                                @if (!isOwner && member.Role == CampaignRole.DM && member.UserId == Ctx.UserId)
                                {
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="StepDownAsync" data-testid="step-down">@L["Campaign.Settings.StepDown"]</CodexButton>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
            @if (Ctx.IsDm && !IsOwner)
            {
                <p class="field-hint mt-2 mb-0" data-testid="co-gm-hint">@L["Campaign.Settings.CoGmHint"]</p>
            }
            @if (Ctx.IsDm)
            {
                <hr />
                <label for="cs-invite" class="field-label">@InviteLabel</label>
                <div class="input-group input-group-sm">
                    <input id="cs-invite" class="field-input" readonly value="@InviteLink" />
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => CopyInviteAsync(InviteLink)" aria-label="@L["Campaign.Settings.CopyInvite"]"><LucideIcon IconName="copy" Size="14" /></CodexButton>
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="RegenerateInviteAsync">@L["Campaign.Settings.NewLink"]</CodexButton>
                </div>
                @if (RemoteInviteLink is { } remoteLink)
                {
                    <label for="cs-invite-remote" class="field-label mt-2">@L["Campaign.Settings.InviteLinkTailscale"]</label>
                    <div class="input-group input-group-sm">
                        <input id="cs-invite-remote" class="field-input" readonly value="@remoteLink" />
                        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => CopyInviteAsync(remoteLink)" aria-label="@L["Campaign.Settings.CopyInvite"]"><LucideIcon IconName="copy" Size="14" /></CodexButton>
                    </div>
                }
                @if (InviteState is { } state)
                {
                    <div class="field-hint" data-testid="invite-state">@state</div>
                }
                <div class="d-flex align-items-center gap-2 mt-2">
                    <label for="cs-invite-validity" class="field-label mb-0">@L["Campaign.Settings.InviteValidity"]</label>
                    <select id="cs-invite-validity" class="field-select field-sm" @bind="inviteValidity" data-testid="invite-validity">
                        <option value="forever">@L["Campaign.Settings.InviteValidity.Forever"]</option>
                        <option value="week">@L["Campaign.Settings.InviteValidity.Week"]</option>
                        <option value="day">@L["Campaign.Settings.InviteValidity.Day"]</option>
                        <option value="once">@L["Campaign.Settings.InviteValidity.Once"]</option>
                    </select>
                </div>
                <div class="field-hint">@L["Campaign.Settings.NewLinkHint"]</div>
            }
        </section>

        @if (!IsOwner && Ctx.Campaign.Members.Any(m => m.UserId == Ctx.UserId))
        {
            <section class="panel" aria-labelledby="leave-heading">
                <div class="panel-title"><h3 id="leave-heading">@L["Campaign.Settings.Leave.Title"]</h3></div>
                <p class="small-muted">@L["Campaign.Settings.Leave.Hint"]</p>
                <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="LeaveAsync" data-testid="settings-leave">@L["Campaign.Settings.Leave.Button"]</CodexButton>
            </section>
        }
    </div>

    @if (Ctx.IsDm)
    {
        <div class="col-lg-5">
            <section class="panel" aria-labelledby="backup-heading">
                <div class="panel-title"><h3 id="backup-heading">@L["Campaign.Settings.Backup"]</h3></div>
                <p class="small-muted">@L["Campaign.Settings.BackupHint"]</p>
                <div class="d-flex gap-2 flex-wrap">
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="ExportAsync"><LucideIcon IconName="download" Size="14" /> @L["Campaign.Settings.Export"]</CodexButton>
                    <label class="cx-btn cx-etched cx-sm mb-0">
                        <LucideIcon IconName="upload" Size="14" /> @L["Campaign.Settings.Import"]
                        <InputFile OnChange="ImportAsync" accept=".json" class="visually-hidden" />
                    </label>
                </div>
                <div class="field-check mt-2">
                    <input id="restore-as-new" type="checkbox" class="field-box" @bind="restoreAsNew" />
                    <label for="restore-as-new" class="small-muted">@L["Campaign.Settings.RestoreAsNew"]</label>
                </div>
            </section>

            <BookPanel />

            <section class="panel" aria-labelledby="danger-heading">
                <div class="panel-title"><h3 id="danger-heading">@L["Campaign.Settings.Delete.Title"]</h3></div>
                <p class="small-muted">@L["Campaign.Settings.Delete.Hint"]</p>
                <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="DeleteAsync" Disabled="@(Ctx.Campaign.OwnerId != Ctx.UserId)" data-testid="settings-delete">@L["Campaign.Settings.Delete.Button"]</CodexButton>
                @if (Ctx.Campaign.OwnerId != Ctx.UserId)
                {
                    <div class="field-hint">@L["Campaign.Settings.Delete.OwnerOnlyHint"]</div>
                }
                else
                {
                    <div class="field-hint" data-testid="owner-leave-hint">@L["Campaign.Settings.Leave.OwnerHint"]</div>
                }
            </section>
        </div>
    }
</div>

<ConfirmDialog @ref="confirm" />

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private ConfirmDialog confirm = null!;
    private bool restoreAsNew;
    private string name = string.Empty;
    private string description = string.Empty;
    private string tagline = string.Empty;
    private string systemId = string.Empty;
    private string rulesEnforcement = "inherit";
    private HashSet<string> activePacks = new();
    private Dictionary<string, string> usernames = new();

    private string InviteLink => Codex.Web.Services.InviteLinks.Build(Nav.BaseUri, Config["Codex:PublicUrl"], Ctx.Campaign.InviteCode);

    private string? RemoteInviteLink => Codex.Web.Services.InviteLinks.BuildRemote(Config["Codex:RemoteUrl"], Ctx.Campaign.InviteCode);

    private string InviteLabel => RemoteInviteLink is null ? L["Campaign.Settings.InviteLink"] : L["Campaign.Settings.InviteLinkNetwork"];

    protected override async Task OnParametersSetAsync()
    {
        name = Ctx.Campaign.Name;
        description = Ctx.Campaign.Description;
        tagline = Ctx.Campaign.Tagline;
        systemId = Ctx.Campaign.SystemId;
        rulesEnforcement = string.IsNullOrWhiteSpace(Ctx.Campaign.RulesEnforcement) ? "inherit" : Ctx.Campaign.RulesEnforcement;
        activePacks = Ctx.Campaign.ActivePacks.ToHashSet(StringComparer.OrdinalIgnoreCase);

        usernames = await MemberNames.LoadAsync(UserRepo, Ctx.Campaign);
    }

    private bool IsOwner => Ctx.Campaign.OwnerId == Ctx.UserId;

    // The owner is the GM; anyone else holding the GM role is a co-GM.
    private string RoleLabel(CampaignRole role, bool isOwner) => role switch
    {
        CampaignRole.DM => isOwner ? L["Campaign.Settings.Role.DM"] : L["Campaign.Settings.Role.CoGm"],
        CampaignRole.Player => L["Campaign.Settings.Role.Player"],
        _ => L["Campaign.Settings.Role.Observer"]
    };

    private bool IsActive(string packId) => activePacks.Count == 0 || activePacks.Contains(packId);

    private void TogglePack(string packId, bool on)
    {
        if (activePacks.Count == 0)
        {
            // Going from "everything" to an explicit list: start from all packs, then apply the change.
            activePacks = Registry.GetPacks(Ctx.Campaign.SystemId).Where(p => !p.IsTranslation).Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }

        if (on) activePacks.Add(packId); else activePacks.Remove(packId);
    }

    // One save of the details or the packs at a time: a double press, or Ctrl+S held, writes once (U6).
    private readonly SaveGate saveGate = new();
    // What is wrong with the name or the cover, said under it rather than at the top of the page (U5).
    private string? nameError;
    private string? coverError;

    private Task SaveDetailsAsync() => saveGate.RunAsync(SaveDetailsNowAsync);

    private async Task SaveDetailsNowAsync()
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            nameError = L["Campaign.Settings.NameRequired"];
            return;
        }

        var newName = name.Trim();
        var newDescription = description.Trim();
        var newTagline = CampaignDocument.CleanTagline(tagline);
        var newSystemId = systemId;
        var newEnforcement = rulesEnforcement == "inherit" ? null : rulesEnforcement;
        try
        {
            await ChangeAsync(campaign =>
            {
                campaign.Name = newName;
                campaign.Description = newDescription;
                campaign.Tagline = newTagline;
                campaign.SystemId = newSystemId;
                campaign.RulesEnforcement = newEnforcement;
            }, L["Common.Saved"]);
        }
        catch (Exception ex) when (ex is InvalidOperationException or LocalizedException { Key: "Campaign.SystemMissing" })
        {
            Ctx.Notify(Flash.Error(L.Describe(ex)));
        }
    }

    /// <summary>Writes a DM-only change and, once it is stored, says <paramref name="done"/> and reloads. A role taken away
    /// since the page loaded is refused by the store; <see cref="CampaignContext.WithCurrentRoleAsync"/> says so instead.</summary>
    private async Task ChangeAsync(Action<CampaignDocument> mutate, string done)
    {
        try
        {
            if (await Ctx.WithCurrentRoleAsync(() => CampaignRepo.UpdateAsDmAsync(Ctx.Access, mutate)))
            {
                Ctx.Notify(Flash.Success(done));
                await Ctx.ReloadAsync();
            }
        }
        catch (LocalizedException ex) when (ex.Key == "Campaign.OwnerOnly")
        {
            // The owner passed the campaign on, or this page was opened as the owner and no longer is.
            Ctx.Notify(Flash.Error(L["Campaign.OwnerOnly"]));
            await Ctx.ReloadAsync();
        }
    }

    private Task SavePacksAsync() => saveGate.RunAsync(SavePacksNowAsync);

    private Task SavePacksNowAsync()
    {
        var all = Registry.GetPacks(Ctx.Campaign.SystemId).Where(p => !p.IsTranslation).Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var packs = activePacks.SetEquals(all) ? new List<string>() : activePacks.ToList();
        return ChangeAsync(campaign => campaign.ActivePacks = packs.ToList(), L["Campaign.Settings.PacksSaved"]);
    }

    private int roleResets;

    // A role changes on the select's change, which a mis-scroll on a phone can fire: it asks first (U3).
    private async Task ChangeRoleAsync(CampaignMember member, string? role)
    {
        if (!Enum.TryParse<CampaignRole>(role, out var parsed) || parsed == member.Role) return;
        var who = usernames.GetValueOrDefault(member.UserId, member.UserId);
        if (!await confirm.ShowAsync(L["Campaign.Settings.RoleQ", who, RoleLabel(parsed, isOwner: false)],
                parsed == CampaignRole.DM ? L["Campaign.Settings.RoleBodyDm"] : L["Campaign.Settings.RoleBody"], L["Campaign.Settings.RoleConfirm"],
                isDestructive: parsed == CampaignRole.DM))
        {
            roleResets++;
            return;
        }

        await ChangeAsync(campaign =>
        {
            if (campaign.Members.FirstOrDefault(m => m.UserId == member.UserId) is { } stored) stored.Role = parsed;
        }, L["Campaign.Settings.RoleChanged", who, RoleLabel(parsed, isOwner: false)]);
    }

    // The owner hands the campaign to a co-GM and stays one; from then on the new owner alone changes who GMs it.
    private async Task PassOnAsync(CampaignMember member)
    {
        var who = usernames.GetValueOrDefault(member.UserId, member.UserId);
        if (!await confirm.ShowAsync(L["Campaign.Settings.PassOnQ", who], L["Campaign.Settings.PassOnBody", who], L["Campaign.Settings.PassOn"], isDestructive: true)) return;
        await ChangeAsync(campaign =>
        {
            if (campaign.Members.Any(m => m.UserId == member.UserId && m.Role == CampaignRole.DM)) campaign.OwnerId = member.UserId;
        }, L["Campaign.Settings.PassedOn", who]);
    }

    // A co-GM gives up the GM role themselves; the store lets them take only their own away. Their GM view ends, so the page loads afresh.
    private async Task StepDownAsync()
    {
        if (!await confirm.ShowAsync(L["Campaign.Settings.StepDownQ"], L["Campaign.Settings.StepDownBody"], L["Campaign.Settings.StepDown"], isDestructive: true)) return;
        try
        {
            if (await Ctx.WithCurrentRoleAsync(() => CampaignRepo.UpdateAsDmAsync(Ctx.Access, campaign =>
                {
                    if (campaign.OwnerId != Ctx.UserId && campaign.Members.FirstOrDefault(m => m.UserId == Ctx.UserId) is { } me) me.Role = CampaignRole.Player;
                })))
            {
                Nav.NavigateTo(Ctx.BasePath, forceLoad: true);
            }
        }
        catch (LocalizedException ex) when (ex.Key == "Campaign.OwnerOnly")
        {
            Ctx.Notify(Flash.Error(L["Campaign.OwnerOnly"]));
            await Ctx.ReloadAsync();
        }
    }

    // Any member but the owner may leave; their characters stay in the cast, and a new invite brings them back.
    private async Task LeaveAsync()
    {
        if (!await confirm.ShowAsync(L["Campaign.Settings.Leave.Q", Ctx.Campaign.Name], L["Campaign.Settings.Leave.Hint"], L["Campaign.Settings.Leave.Button"], isDestructive: true)) return;
        switch (await CampaignRepo.LeaveAsync(Ctx.Campaign.Id, Ctx.UserId))
        {
            case CampaignLeaveResult.Left:
            case CampaignLeaveResult.NotMember:
                Nav.NavigateTo("/", forceLoad: true);
                break;
            default:
                Ctx.Notify(Flash.Error(L["Campaign.Settings.Leave.OwnerHint"]));
                await Ctx.ReloadAsync();
                break;
        }
    }

    private async Task RemoveMemberAsync(CampaignMember member)
    {
        var who = usernames.GetValueOrDefault(member.UserId, member.UserId);
        if (!await confirm.ShowAsync(L["Campaign.Settings.RemoveQ", who], L["Campaign.Settings.RemoveBody"], L["Campaign.Settings.Remove"], isDestructive: true)) return;
        await ChangeAsync(campaign => campaign.Members.RemoveAll(m => m.UserId == member.UserId), L["Campaign.Settings.Removed", who]);
    }

    private async Task CopyInviteAsync(string link)
    {
        var ok = await JS.InvokeAsync<bool>("codex.copyText", link);
        Ctx.Notify(ok ? Flash.Success(L["Campaign.Settings.InviteCopied"]) : Flash.Error(L["Campaign.Settings.CopyFailed"]));
    }

    private string inviteValidity = "forever";

    // The link in use stops working at once, and cannot be had back (U3).
    private async Task RegenerateInviteAsync()
    {
        if (!await confirm.ShowAsync(L["Campaign.Settings.NewLinkQ"], L["Campaign.Settings.NewLinkBody"], L["Campaign.Settings.NewLinkConfirm"], isDestructive: true)) return;
        var code = InviteCodes.New();
        DateTime? expires = inviteValidity switch
        {
            "week" => DateTime.UtcNow.AddDays(7),
            "day" => DateTime.UtcNow.AddDays(1),
            _ => null
        };
        var once = inviteValidity == "once";
        await ChangeAsync(campaign =>
        {
            campaign.InviteCode = code;
            campaign.InviteExpiresAt = expires;
            campaign.InviteSingleUse = once;
            campaign.InviteUsedBy = null;
        }, L["Campaign.Settings.NewInviteCreated"]);
    }

    /// <summary>What limits the current link, if anything: when it stops working, or that it lets one player in (D14).</summary>
    private string? InviteState
    {
        get
        {
            var campaign = Ctx.Campaign;
            if (campaign.InviteSingleUse)
            {
                return campaign.InviteUsedBy == null
                    ? L["Campaign.Settings.InviteOnce"]
                    : L["Campaign.Settings.InviteUsed", usernames.GetValueOrDefault(campaign.InviteUsedBy, campaign.InviteUsedBy)];
            }

            if (campaign.InviteExpiresAt is not { } expires) return null;
            var left = expires - DateTime.UtcNow;
            return left <= TimeSpan.Zero ? L["Campaign.Settings.InviteExpired"]
                : left.TotalHours > 48 ? L["Campaign.Settings.InviteExpiresDays", (int)Math.Ceiling(left.TotalDays)]
                : L["Campaign.Settings.InviteExpiresHours", Math.Max(1, (int)Math.Ceiling(left.TotalHours))];
        }
    }

    private async Task UploadCoverAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        coverError = null;
        if (!RavenMediaStore.AllowedContentTypes.Contains(file.ContentType))
        {
            coverError = L["Campaign.Settings.BadImageType"];
            return;
        }

        if (file.Size > RavenMediaStore.MaxBytes)
        {
            coverError = L["Campaign.Settings.ImageTooBig"];
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(RavenMediaStore.MaxBytes);
            if (await Ctx.WithCurrentRoleAsync(() => Media.PutAsync(Ctx.Access, Ctx.Campaign.Id, RavenMediaStore.CampaignCover, stream, file.ContentType)))
            {
                await ChangeAsync(campaign =>
                {
                    campaign.HasCover = true;
                    campaign.CoverVersion++;
                }, L["Campaign.Settings.CoverUpdated"]);
            }
        }
        catch (Exception ex)
        {
            coverError = L["Campaign.Settings.UploadFailed", L.Describe(ex)];
        }
    }

    private async Task RemoveCoverAsync()
    {
        if (!await confirm.ShowAsync(L["Common.Art.RemoveTitle"], L["Common.Art.RemoveBody"], L["Common.Art.Remove"], isDestructive: true)) return;
        if (await Ctx.WithCurrentRoleAsync(() => Media.DeleteAsync(Ctx.Access, Ctx.Campaign.Id, RavenMediaStore.CampaignCover)))
        {
            await ChangeAsync(campaign =>
            {
                campaign.HasCover = false;
                campaign.CoverVersion++;
            }, L["Campaign.Settings.CoverRemoved"]);
        }
    }

    private async Task ExportAsync()
    {
        var bundle = await ExportService.ExportAsync(Ctx.Access);
        if (bundle == null)
        {
            Ctx.Notify(Flash.Error(L["Campaign.Settings.ExportFailed"]));
            return;
        }

        var json = CampaignExportService.Serialize(bundle);
        var href = "data:application/json;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
        await JS.InvokeVoidAsync("codex.download", href, $"{RavenHomebrewRepository.Slugify(Ctx.Campaign.Name)}-export.json");
        Ctx.Notify(Flash.Success(L["Campaign.Settings.ExportDone"]));
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var bundle = CampaignExportService.Deserialize(await reader.ReadToEndAsync());
            if (bundle == null)
            {
                Ctx.Notify(Flash.Error(L["Campaign.Settings.NotExport"]));
                return;
            }

            if (bundle.Campaign?.Id != Ctx.Campaign.Id && !restoreAsNew)
            {
                Ctx.Notify(Flash.Error(L["Campaign.Settings.OtherCampaign"]));
                return;
            }

            if (bundle.Campaign!.Id != Ctx.Campaign.Id)
            {
                // A copy is a new campaign: only someone who may create campaigns (docs/SERVER_ACCESS_AND_VAULT.md 3).
                if (!ServerAccess.MayCreateCampaigns(await UserRepo.GetUserByIdAsync(Ctx.UserId), await ServerSettings.GetAsync()))
                {
                    Ctx.Notify(Flash.Error(L["Page.Home.JoinOnly"]));
                    return;
                }

                // Under new ids, so the file can never land on a campaign that exists (D13).
                if (await ExportService.ImportAsNewAsync(bundle, Ctx.UserId) is { } restoredId)
                {
                    Ctx.Notify(Flash.Success(L["Campaign.Settings.RestoredAsNew", bundle.Campaign.Name]));
                    Nav.NavigateTo($"/campaigns/{restoredId}");
                }
                else
                {
                    Ctx.Notify(Flash.Error(L["Campaign.Settings.ImportRejected"]));
                }
            }
            else if (await ExportService.ImportAsync(bundle, Ctx.UserId))
            {
                Ctx.Notify(Flash.Success(L["Campaign.Settings.Imported", bundle.Campaign.Name]));
                await Ctx.ReloadAsync();
            }
            else
            {
                Ctx.Notify(Flash.Error(L["Campaign.Settings.ImportRejected"]));
            }
        }
        catch (Exception ex)
        {
            Ctx.Notify(Flash.Error(L["Campaign.Settings.ImportFailed", L.Describe(ex)]));
        }
    }

    private async Task DeleteAsync()
    {
        var ok = await confirm.ShowAsync(L["Campaign.Settings.DeleteQ", Ctx.Campaign.Name],
            L["Campaign.Settings.DeleteBody"],
            L["Campaign.Settings.DeleteConfirm"], isDestructive: true);
        if (!ok) return;

        var result = await CampaignRepo.DeleteAsync(Ctx.Campaign.Id, Ctx.UserId);
        if (result == CampaignDeleteResult.Deleted)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            Ctx.Notify(Flash.Error(L["Campaign.Settings.Delete.OwnerOnlyHint"]));
        }
    }
}
