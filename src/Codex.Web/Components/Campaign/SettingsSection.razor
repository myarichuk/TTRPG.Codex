@using System.Text
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject ICampaignRepository CampaignRepo
@inject IUserRepository UserRepo
@inject ISystemCatalog Catalog
@inject IContentRegistry Registry
@inject CampaignExportService ExportService
@inject IMediaStore Media
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IJSRuntime JS

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">Settings</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? "Campaign details, content packs, members and backups." : "Campaign details. Only the DM can change them.")</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <section class="panel" aria-labelledby="details-heading">
            <div class="panel-title"><h3 id="details-heading">Details</h3></div>
            @if (Ctx.IsDm)
            {
                <form @onsubmit="SaveDetailsAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="cs-name" class="field-label">Name</label>
                        <input id="cs-name" class="field-input" @bind="name" required maxlength="120" data-testid="settings-name" />
                    </div>
                    <div class="mb-3">
                        <label for="cs-desc" class="field-label">Description</label>
                        <textarea id="cs-desc" class="field-input" rows="3" @bind="description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="cs-system" class="field-label">Game system</label>
                        <select id="cs-system" class="field-select" @bind="systemId" aria-describedby="cs-system-help">
                            @foreach (var system in Catalog.Systems)
                            {
                                <option value="@system.Id">@system.Name</option>
                            }
                        </select>
                        <div id="cs-system-help" class="field-hint">Changing the system does not convert existing character sheets.</div>
                    </div>
                    @if (Ctx.System?.SheetRules != null)
                    {
                        <div class="mb-3">
                            <label for="cs-rules" class="field-label">House rules: sheet checks</label>
                            <select id="cs-rules" class="field-select" @bind="rulesEnforcement" aria-describedby="cs-rules-help" data-testid="settings-rules">
                                <option value="inherit">Use the system's setting (@Ctx.System.SheetRules.Enforcement)</option>
                                <option value="strict">Strict: players can't save a sheet that breaks a rule</option>
                                <option value="warn">Warn only: show problems, allow saving</option>
                                <option value="off">Off: no checks</option>
                            </select>
                            <div id="cs-rules-help" class="field-hint">Point buy, class spell lists, subclass and feat limits come from the system's rules. The DM can always save regardless.</div>
                        </div>
                    }
                    <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="settings-save">Save details</CodexButton>
                </form>
            }
            else
            {
                <dl class="prop-list mb-0">
                    <dt>Name</dt><dd>@Ctx.Campaign.Name</dd>
                    <dt>System</dt><dd>@Catalog.GetDisplayName(Ctx.Campaign.SystemId)</dd>
                    <dt>Description</dt><dd>@(string.IsNullOrWhiteSpace(Ctx.Campaign.Description) ? "—" : Ctx.Campaign.Description)</dd>
                </dl>
            }
        </section>

        @if (Ctx.IsDm)
        {
            <section class="panel" aria-labelledby="art-heading">
                <div class="panel-title"><h3 id="art-heading"><LucideIcon IconName="image" Size="18" Class="title-icon" /> Cover art</h3></div>
                <div class="cover-settings">
                    <div class="cover-preview @(Ctx.Campaign.HasCover ? "has-cover" : "")" style="@(Ctx.Campaign.HasCover ? $"background-image:url('{MediaEndpoints.CoverUrl(Ctx.Campaign)}')" : "")" role="img" aria-label="@(Ctx.Campaign.HasCover ? "Current cover art" : "No cover art yet")">
                        @if (!Ctx.Campaign.HasCover)
                        {
                            <LucideIcon IconName="image" Size="28" />
                        }
                    </div>
                    <div>
                        <p class="small-muted">Shown on the campaign card and behind the campaign title. Landscape images around 1600 × 900 look best. PNG, JPEG or WebP, up to 6 MB.</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <label class="cx-btn cx-etched cx-sm mb-0">
                                <LucideIcon IconName="upload" Size="14" /> @(Ctx.Campaign.HasCover ? "Replace cover" : "Upload cover")
                                <InputFile OnChange="UploadCoverAsync" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" class="visually-hidden" />
                            </label>
                            @if (Ctx.Campaign.HasCover)
                            {
                                <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="RemoveCoverAsync">Remove</CodexButton>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="packs-heading">
                <div class="panel-title"><h3 id="packs-heading">Content packs</h3></div>
                @{
                    var packs = Registry.GetPacks(Ctx.Campaign.SystemId).ToList();
                }
                @if (packs.Count == 0)
                {
                    <p class="small-muted mb-0">No packs are loaded for this system.</p>
                }
                else
                {
                    <p class="small-muted">Untick a pack to keep it out of this campaign's Library. With nothing ticked, every pack is in play.</p>
                    @foreach (var pack in packs)
                    {
                        <div class="field-check mb-1">
                            <input id="pack-@pack.Id" type="checkbox" class="field-box" checked="@IsActive(pack.Id)" @onchange="e => TogglePack(pack.Id, (bool)(e.Value ?? false))" />
                            <label for="pack-@pack.Id" >@pack.Name <span class="pill ms-1">@pack.Kind</span></label>
                        </div>
                    }
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="mt-2" OnClick="SavePacksAsync">Save pack selection</CodexButton>
                }
            </section>
        }

        <section class="panel" aria-labelledby="members-heading">
            <div class="panel-title"><h3 id="members-heading">Members</h3></div>
            <ul class="list-unstyled mb-0">
                @foreach (var member in Ctx.Campaign.Members)
                {
                    var isOwner = member.UserId == Ctx.Campaign.OwnerId;
                    <li class="list-row">
                        <div class="row-main">
                            <div class="row-title">@usernames.GetValueOrDefault(member.UserId, member.UserId) @(isOwner ? "(owner)" : "")</div>
                        </div>
                        @if (Ctx.IsDm && !isOwner)
                        {
                            <div class="row-actions">
                                <label for="role-@member.UserId" class="visually-hidden">Role for @usernames.GetValueOrDefault(member.UserId, member.UserId)</label>
                                <select id="role-@member.UserId" class="field-select field-sm" value="@member.Role" @onchange="e => ChangeRoleAsync(member, e.Value?.ToString())">
                                    @foreach (CampaignRole role in Enum.GetValues<CampaignRole>())
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                                <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="() => RemoveMemberAsync(member)" aria-label="@($"Remove {usernames.GetValueOrDefault(member.UserId, member.UserId)} from the campaign")">Remove</CodexButton>
                            </div>
                        }
                        else
                        {
                            <span class="pill @(member.Role == CampaignRole.DM ? "pill-accent" : "")">@member.Role</span>
                        }
                    </li>
                }
            </ul>
            @if (Ctx.IsDm)
            {
                <hr />
                <label for="cs-invite" class="field-label">Invite link</label>
                <div class="input-group input-group-sm">
                    <input id="cs-invite" class="field-input" readonly value="@InviteLink" />
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CopyInviteAsync" aria-label="Copy invite link"><LucideIcon IconName="copy" Size="14" /></CodexButton>
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="RegenerateInviteAsync">New link</CodexButton>
                </div>
                <div class="field-hint">Making a new link stops the old one from working.</div>
            }
        </section>
    </div>

    @if (Ctx.IsDm)
    {
        <div class="col-lg-5">
            <section class="panel" aria-labelledby="backup-heading">
                <div class="panel-title"><h3 id="backup-heading">Backup</h3></div>
                <p class="small-muted">Export downloads the whole campaign (characters, sessions, lore, notes, homebrew) as one JSON file. Import restores a file exported from here, including after the campaign was deleted.</p>
                <div class="d-flex gap-2 flex-wrap">
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="ExportAsync"><LucideIcon IconName="download" Size="14" /> Export campaign</CodexButton>
                    <label class="cx-btn cx-etched cx-sm mb-0">
                        <LucideIcon IconName="upload" Size="14" /> Import campaign
                        <InputFile OnChange="ImportAsync" accept=".json" class="visually-hidden" />
                    </label>
                </div>
                <div class="field-check mt-2">
                    <input id="restore-as-new" type="checkbox" class="field-box" @bind="restoreAsNew" />
                    <label for="restore-as-new" class="small-muted">The file is a backup of a different (for example deleted) campaign: restore that one</label>
                </div>
            </section>

            <section class="panel" aria-labelledby="danger-heading">
                <div class="panel-title"><h3 id="danger-heading">Delete campaign</h3></div>
                <p class="small-muted">Removes the campaign and everything in it. Export first if you want to keep anything.</p>
                <CodexButton Variant="CodexButtonVariant.Blood" Small="true" OnClick="DeleteAsync" Disabled="@(Ctx.Campaign.OwnerId != Ctx.UserId)" data-testid="settings-delete">Delete this campaign</CodexButton>
                @if (Ctx.Campaign.OwnerId != Ctx.UserId)
                {
                    <div class="field-hint">Only the campaign's owner can delete it.</div>
                }
            </section>
        </div>
    }
</div>

<ConfirmDialog @ref="confirm" />

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private ConfirmDialog confirm = null!;
    private bool restoreAsNew;
    private string name = string.Empty;
    private string description = string.Empty;
    private string systemId = string.Empty;
    private string rulesEnforcement = "inherit";
    private HashSet<string> activePacks = new();
    private readonly Dictionary<string, string> usernames = new();

    private string InviteLink => Codex.Web.Services.InviteLinks.Build(Nav.BaseUri, Config["Codex:PublicUrl"], Ctx.Campaign.InviteCode);

    protected override async Task OnParametersSetAsync()
    {
        name = Ctx.Campaign.Name;
        description = Ctx.Campaign.Description;
        systemId = Ctx.Campaign.SystemId;
        rulesEnforcement = string.IsNullOrWhiteSpace(Ctx.Campaign.RulesEnforcement) ? "inherit" : Ctx.Campaign.RulesEnforcement;
        activePacks = Ctx.Campaign.ActivePacks.ToHashSet(StringComparer.OrdinalIgnoreCase);

        usernames.Clear();
        foreach (var member in Ctx.Campaign.Members)
        {
            usernames[member.UserId] = (await UserRepo.GetUserByIdAsync(member.UserId))?.Username ?? member.UserId;
        }
    }

    private bool IsActive(string packId) => activePacks.Count == 0 || activePacks.Contains(packId);

    private void TogglePack(string packId, bool on)
    {
        if (activePacks.Count == 0)
        {
            // Going from "everything" to an explicit list: start from all packs, then apply the change.
            activePacks = Registry.GetPacks(Ctx.Campaign.SystemId).Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }

        if (on) activePacks.Add(packId); else activePacks.Remove(packId);
    }

    private async Task SaveDetailsAsync()
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            Ctx.Notify(Flash.Error("The campaign needs a name."));
            return;
        }

        var newName = name.Trim();
        var newDescription = description.Trim();
        var newSystemId = systemId;
        var newEnforcement = rulesEnforcement == "inherit" ? null : rulesEnforcement;
        try
        {
            await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign =>
            {
                campaign.Name = newName;
                campaign.Description = newDescription;
                campaign.SystemId = newSystemId;
                campaign.RulesEnforcement = newEnforcement;
            });
            Ctx.Notify(Flash.Success("Saved."));
            await Ctx.ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Ctx.Notify(Flash.Error(ex.Message));
        }
    }

    private async Task SavePacksAsync()
    {
        var all = Registry.GetPacks(Ctx.Campaign.SystemId).Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var packs = activePacks.SetEquals(all) ? new List<string>() : activePacks.ToList();
        await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign => campaign.ActivePacks = packs.ToList());
        Ctx.Notify(Flash.Success("Pack selection saved."));
        await Ctx.ReloadAsync();
    }

    private async Task ChangeRoleAsync(CampaignMember member, string? role)
    {
        if (!Enum.TryParse<CampaignRole>(role, out var parsed)) return;
        await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign =>
        {
            if (campaign.Members.FirstOrDefault(m => m.UserId == member.UserId) is { } stored) stored.Role = parsed;
        });
        Ctx.Notify(Flash.Success($"{usernames.GetValueOrDefault(member.UserId, member.UserId)} is now a {parsed}."));
        await Ctx.ReloadAsync();
    }

    private async Task RemoveMemberAsync(CampaignMember member)
    {
        var who = usernames.GetValueOrDefault(member.UserId, member.UserId);
        if (!await confirm.ShowAsync($"Remove {who}?", "They lose access to this campaign. Their characters stay in the cast.", "Remove", isDestructive: true)) return;
        await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign => campaign.Members.RemoveAll(m => m.UserId == member.UserId));
        Ctx.Notify(Flash.Success($"Removed {who}."));
        await Ctx.ReloadAsync();
    }

    private async Task CopyInviteAsync()
    {
        var ok = await JS.InvokeAsync<bool>("codex.copyText", InviteLink);
        Ctx.Notify(ok ? Flash.Success("Invite link copied.") : Flash.Error("Could not copy. Select the link and copy it manually."));
    }

    private async Task RegenerateInviteAsync()
    {
        var code = Guid.NewGuid().ToString("N")[..8];
        await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign => campaign.InviteCode = code);
        Ctx.Notify(Flash.Success("New invite link created. The old one no longer works."));
        await Ctx.ReloadAsync();
    }

    private async Task UploadCoverAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (!RavenMediaStore.AllowedContentTypes.Contains(file.ContentType))
        {
            Ctx.Notify(Flash.Error("Use a PNG, JPEG, WebP, GIF or AVIF image."));
            return;
        }

        if (file.Size > RavenMediaStore.MaxBytes)
        {
            Ctx.Notify(Flash.Error("That image is over 6 MB. Resize it and try again."));
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(RavenMediaStore.MaxBytes);
            await Media.PutAsync(Ctx.Campaign.Id, RavenMediaStore.CampaignCover, stream, file.ContentType);
            await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign =>
            {
                campaign.HasCover = true;
                campaign.CoverVersion++;
            });
            Ctx.Notify(Flash.Success("Cover art updated."));
            await Ctx.ReloadAsync();
        }
        catch (Exception ex)
        {
            Ctx.Notify(Flash.Error("The upload failed: " + ex.Message));
        }
    }

    private async Task RemoveCoverAsync()
    {
        await Media.DeleteAsync(Ctx.Campaign.Id, RavenMediaStore.CampaignCover);
        await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, campaign =>
        {
            campaign.HasCover = false;
            campaign.CoverVersion++;
        });
        Ctx.Notify(Flash.Success("Cover art removed."));
        await Ctx.ReloadAsync();
    }

    private async Task ExportAsync()
    {
        var bundle = await ExportService.ExportAsync(Ctx.Access);
        if (bundle == null)
        {
            Ctx.Notify(Flash.Error("Export failed."));
            return;
        }

        var json = CampaignExportService.Serialize(bundle);
        var href = "data:application/json;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
        await JS.InvokeVoidAsync("codex.download", href, $"{RavenHomebrewRepository.Slugify(Ctx.Campaign.Name)}-export.json");
        Ctx.Notify(Flash.Success("Export downloaded."));
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var bundle = CampaignExportService.Deserialize(await reader.ReadToEndAsync());
            if (bundle == null)
            {
                Ctx.Notify(Flash.Error("That file isn't a campaign export."));
                return;
            }

            if (bundle.Campaign?.Id != Ctx.Campaign.Id && !restoreAsNew)
            {
                Ctx.Notify(Flash.Error("That file is a backup of a different campaign. Tick “restore that one” if you meant to bring it back."));
                return;
            }

            if (await ExportService.ImportAsync(bundle, Ctx.UserId))
            {
                Ctx.Notify(Flash.Success($"Imported “{bundle.Campaign?.Name}”."));
                if (bundle.Campaign!.Id == Ctx.Campaign.Id)
                {
                    await Ctx.ReloadAsync();
                }
                else
                {
                    Nav.NavigateTo($"/campaigns/{bundle.Campaign.Id}");
                }
            }
            else
            {
                Ctx.Notify(Flash.Error("Import rejected: unrecognised format or you are not a DM of that campaign."));
            }
        }
        catch (Exception ex)
        {
            Ctx.Notify(Flash.Error($"Import failed: {ex.Message}"));
        }
    }

    private async Task DeleteAsync()
    {
        var ok = await confirm.ShowAsync($"Delete “{Ctx.Campaign.Name}”?",
            "This removes the campaign and everything in it. Export a backup first if you want to keep any of it. This cannot be undone.",
            "Delete campaign", isDestructive: true);
        if (!ok) return;

        var result = await CampaignRepo.DeleteAsync(Ctx.Campaign.Id, Ctx.UserId);
        if (result == CampaignDeleteResult.Deleted)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            Ctx.Notify(Flash.Error("Only the campaign's owner can delete it."));
        }
    }
}
