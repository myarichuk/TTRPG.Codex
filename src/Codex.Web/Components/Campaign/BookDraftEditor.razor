@using Codex.Core.Book
@using Codex.Persistence
@using Codex.Web.Book
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject BookDrafts Drafts
@inject BookDraftWebs Webs
@inject BookThemeCatalog Catalog
@inject IBookDraftRepository ThemeStore
@inject BookPdf Pdf
@inject BookDraftAi Ai
@inject BookDraftMerges Merges
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject ILogger<BookDraftEditor> Logger

@* The editable book (docs/BOOK_EXPORT.md 41): a chapter's Markdown on the left, the whole book on the right, drawn by the same script the PDF is
   printed with. The preview frame is sandboxed with no script; it allows same-origin only so this page can draw into it and measure what it
   drew, and its own policy fetches nothing. The draft is saved as the GM types; a save from an older copy (another tab) is refused, not merged. *@

<dialog id="book-draft-dialog" class="codex-dialog book-draft-dialog" aria-labelledby="book-draft-title" @oncancel="CloseAsync" data-testid="book-draft-dialog">
    @if (view != null)
    {
        @* Laid out like an IDE: one toolbar; the chapters, the Markdown and the preview side by side, the outer two collapsible to a strip;
           a panel below with tabs (Ask AI, Problems, Blocks), collapsible too. What is open is remembered in this browser. *@
        <div class="book-draft" data-book-editor>
            <header class="book-draft-bar">
                <h2 id="book-draft-title" class="h5 mb-0"><LucideIcon IconName="book-open" Size="18" Class="title-icon" /> @L["Campaign.Book.Draft.Title", EditionName]</h2>
                <span class="small-muted" role="status" aria-live="polite" data-testid="book-draft-save-state">@SaveText</span>
                <span class="flex-grow-1"></span>
                <div class="book-draft-tools" role="toolbar" aria-label="@L["Campaign.Book.Draft.Tools"]">
                    <label class="book-draft-theme">
                        <span>@L["Campaign.Book.Draft.Theme"]</span>
                        <select class="form-select form-select-sm" value="@view.Theme" @onchange="ThemeAsync" disabled="@(working || state == SaveState.Conflict)" data-testid="book-draft-theme">
                            @foreach (var theme in BookDraftThemes.All)
                            {
                                @* A theme whose faces lack this language's letters cannot be picked (the language gate); the GM sees why. *@
                                var prints = theme.Supports(language);
                                <option value="@theme.Id" disabled="@(!prints)">@L["Campaign.Book.Draft.Theme." + theme.Id]@(prints ? "" : " " + L["Campaign.Book.Draft.Theme.NotThisLanguage"])</option>
                            }
                            @if (customThemes.Count > 0)
                            {
                                @* The themes the GM brought into this campaign with the theme wizard (docs/BOOK_EXPORT.md 41.22). *@
                                <optgroup label="@L["Campaign.Book.Theme.Group"]">
                                    @foreach (var own in customThemes)
                                    {
                                        var prints = own.Languages.Contains(BookThemes.Primary(language));
                                        <option value="@(BookCustomTheme.Prefix + own.Key)" disabled="@(!prints)">@own.Name@(prints ? "" : " " + L["Campaign.Book.Draft.Theme.NotThisLanguage"])</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    <label class="book-draft-homebrewery" title="@L["Campaign.Book.Draft.Homebrewery.Hint"]">
                        <input type="checkbox" class="form-check-input" checked="@view.Homebrewery" @onchange="HomebreweryAsync" disabled="@(working || state == SaveState.Conflict)"
                               data-testid="book-draft-homebrewery" />
                        <span>@L["Campaign.Book.Draft.Homebrewery"]</span>
                    </label>
                    <span class="book-draft-sep" aria-hidden="true"></span>
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="FitAsync" Disabled="@(working || printing || state == SaveState.Conflict)"
                                 title="@L["Campaign.Book.Draft.FitHint"]" data-testid="book-draft-fit">
                        <LucideIcon IconName="layers" Size="14" /> @(fitting ? L["Campaign.Book.Draft.Fitting"] : L["Campaign.Book.Draft.Fit"])
                    </CodexButton>
                    <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => DownloadAsync(false)" Disabled="@printing" data-testid="book-draft-download">
                        <LucideIcon IconName="download" Size="14" /> @(printing ? L["Campaign.Book.Printing"] : L["Campaign.Book.Draft.Download"])
                    </CodexButton>
                    <div class="book-draft-more">
                        <button type="button" class="cx-btn cx-etched cx-sm" @onclick="ToggleMoreAsync" aria-haspopup="menu" aria-expanded="@(moreOpen ? "true" : "false")"
                                title="@L["Campaign.Book.Draft.More"]" aria-label="@L["Campaign.Book.Draft.More"]" data-testid="book-draft-more"><LucideIcon IconName="more-horizontal" Size="14" /></button>
                        @if (moreOpen)
                        {
                            <div class="book-draft-menu" role="menu" @onkeydown="@(e => { if (e.Key == "Escape") moreOpen = false; })">
                                <button type="button" role="menuitem" class="book-draft-menu-item" @onclick="() => { moreOpen = false; wizardOpen = true; }" disabled="@(AiBusy || working)"
                                        data-testid="book-draft-theme-wizard">
                                    <LucideIcon IconName="palette" Size="14" /> @L["Campaign.Book.Theme.Open"]
                                </button>
                                <button type="button" role="menuitemcheckbox" aria-checked="@(view.Edge ? "true" : "false")" class="book-draft-menu-item"
                                        @onclick="EdgeAsync" disabled="@(working || state == SaveState.Conflict)" title="@L["Campaign.Book.Draft.EdgeHint"]" data-testid="book-draft-edge">
                                    <LucideIcon IconName="@(view.Edge ? "check" : "square")" Size="14" /> @L["Campaign.Book.Draft.Edge"]
                                </button>
                                <button type="button" role="menuitem" class="book-draft-menu-item" @onclick="MarkdownAsync" disabled="@printing"
                                        title="@L["Campaign.Book.Draft.MarkdownHint"]" data-testid="book-draft-markdown">
                                    <LucideIcon IconName="file-text" Size="14" /> @L["Campaign.Book.Draft.Markdown"]
                                </button>
                                @if (edition == "party" && players.Count > 0)
                                {
                                    @* Each player's own copy (docs/BOOK_EXPORT.md 45): the party draft with what only their characters may read. *@
                                    <div class="book-draft-menu-label" role="presentation" id="book-draft-for-label">@L["Campaign.Book.Draft.ForPlayer"]</div>
                                    <div role="group" aria-labelledby="book-draft-for-label">
                                        @foreach (var player in players)
                                        {
                                            <button type="button" role="menuitem" class="book-draft-menu-item" @onclick="() => PlayerDownloadAsync(player)" disabled="@printing"
                                                    title="@L["Campaign.Book.Draft.ForPlayerHint"]" data-testid="book-draft-for-player" data-player="@player.UserId">
                                                <LucideIcon IconName="user" Size="14" /> <bdi>@string.Join(", ", player.Characters)</bdi>
                                            </button>
                                        }
                                    </div>
                                }
                                <button type="button" role="menuitem" class="book-draft-menu-item" @onclick="ShapeBookPrepareAsync" disabled="@(AiBusy || working)"
                                        title="@L["Campaign.Book.Draft.ShapeBook.Hint"]" data-testid="book-draft-shape-book">
                                    <LucideIcon IconName="sparkles" Size="14" /> @L["Campaign.Book.Draft.ShapeBook"]
                                </button>
                                <button type="button" role="menuitem" class="book-draft-menu-item" @onclick="StartOverAsync" disabled="@AiBusy" data-testid="book-draft-start-over">
                                    <LucideIcon IconName="rotate-ccw" Size="14" /> @L["Campaign.Book.Draft.StartOver"]
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <button type="button" class="book-draft-close" @onclick="CloseAsync" title="@L["Common.Close"]" aria-label="@L["Common.Close"]" data-testid="book-draft-close"><LucideIcon IconName="x" Size="18" /></button>
            </header>
            @if (wizardOpen)
            {
                <BookThemeWizard Access="Access" Language="@language" Font="Font" OnClose="WizardClosedAsync" />
            }
            @if (message != null)
            {
                <div class="field-error book-draft-infobar" role="alert" data-testid="book-draft-error">@message</div>
            }
            @if (confirmMarkdown)
            {
                @* The GM edition holds every secret (docs/BOOK_EXPORT.md 41.24): said before the file is made. *@
                <div class="book-draft-notice book-draft-infobar" role="alertdialog" aria-labelledby="book-draft-markdown-q" data-testid="book-draft-markdown-gm">
                    <span id="book-draft-markdown-q">@L["Campaign.Book.Draft.MarkdownGm"] @L["Campaign.Book.Draft.MarkdownHint"]</span>
                    <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => DownloadAsync(true, markdown: true)" data-testid="book-draft-markdown-yes">@L["Campaign.Book.Draft.MarkdownGmYes"]</CodexButton>
                    <CodexButton Small="true" OnClick="() => confirmMarkdown = false">@L["Common.Cancel"]</CodexButton>
                </div>
            }
            @if (confirmStartOver)
            {
                <div class="book-draft-notice book-draft-infobar" role="alertdialog" aria-labelledby="book-draft-start-over-q">
                    <span id="book-draft-start-over-q">@L["Campaign.Book.Draft.StartOverAsk"]</span>
                    <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="StartOverConfirmedAsync" data-testid="book-draft-start-over-yes">@L["Campaign.Book.Draft.StartOverYes"]</CodexButton>
                    <CodexButton Small="true" OnClick="() => confirmStartOver = false">@L["Common.Cancel"]</CodexButton>
                </div>
            }
            <div class="book-draft-main @(chaptersOpen ? null : "chapters-closed") @(previewOpen ? null : "preview-closed")">
                @* ---- Chapters ---- *@
                @if (chaptersOpen)
                {
                    <nav class="book-draft-pane book-draft-chapters" aria-label="@L["Campaign.Book.Draft.Chapters"]" data-testid="book-draft-chapters">
                        <div class="book-draft-pane-head">
                            <span>@L["Campaign.Book.Draft.Chapters"]</span>
                            <button type="button" class="book-draft-pane-btn" @onclick="() => TogglePaneAsync(Pane.Chapters)" aria-expanded="true"
                                    title="@L["Campaign.Book.Draft.Collapse"]" aria-label="@L["Campaign.Book.Draft.CollapseNamed", L["Campaign.Book.Draft.Chapters"]]" data-testid="book-draft-pane-chapters-toggle">
                                <LucideIcon IconName="panel-left-close" Size="14" />
                            </button>
                        </div>
                        <ul class="list-unstyled mb-0 book-draft-pane-body">
                            @foreach (var chapter in view.Chapters)
                            {
                                <li>
                                    <button type="button" class="book-draft-chapter @(current == chapter.Section ? "active" : null)" aria-current="@(current == chapter.Section ? "true" : null)"
                                            @onclick="() => ShowAsync(chapter.Section)" disabled="@AiBusy" data-testid="book-draft-chapter" data-section="@chapter.Section">
                                        <LucideIcon IconName="file-text" Size="14" />
                                        <bdi dir="auto">@Title(chapter)</bdi>
                                        @if (chapter.Stale || chapter.Gone)
                                        {
                                            <span class="badge book-draft-badge-stale" title="@L["Campaign.Book.Draft.Stale"]">@L["Campaign.Book.Draft.Badge.Stale"]</span>
                                        }
                                        else if (chapter.Edited)
                                        {
                                            <span class="badge book-draft-badge-edited">@L["Campaign.Book.Draft.Badge.Edited"]</span>
                                        }
                                    </button>
                                </li>
                            }
                            <li>
                                <button type="button" class="book-draft-chapter @(current == null ? "active" : null)" aria-current="@(current == null ? "true" : null)" @onclick="() => ShowAsync(null)" disabled="@AiBusy" data-testid="book-draft-css">
                                    <LucideIcon IconName="palette" Size="14" /> <bdi>@L["Campaign.Book.Draft.Stylesheet"]</bdi>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
                else
                {
                    <button type="button" class="book-draft-strip" @onclick="() => TogglePaneAsync(Pane.Chapters)" aria-expanded="false"
                            aria-label="@L["Campaign.Book.Draft.ExpandNamed", L["Campaign.Book.Draft.Chapters"]]" data-testid="book-draft-pane-chapters-toggle">
                        <LucideIcon IconName="panel-left-open" Size="14" /> <span>@L["Campaign.Book.Draft.Chapters"]</span>
                    </button>
                }

                @* ---- The Markdown (or the stylesheet) ---- *@
                <section class="book-draft-pane book-draft-edit" aria-labelledby="book-draft-edit-title">
                    <div class="book-draft-pane-head">
                        <span id="book-draft-edit-title"><LucideIcon IconName="@(Current == null ? "palette" : "file-text")" Size="14" /> <bdi dir="auto">@(Current is { } open ? Title(open) : L["Campaign.Book.Draft.Stylesheet"])</bdi></span>
                        @if (Current is { } c && (c.Stale || c.Gone))
                        {
                            <span class="badge book-draft-badge-stale">@L["Campaign.Book.Draft.Badge.Stale"]</span>
                        }
                        else if (Current is { Edited: true })
                        {
                            <span class="badge book-draft-badge-edited">@L["Campaign.Book.Draft.Badge.Edited"]</span>
                        }
                        <span class="flex-grow-1"></span>
                        @if (Current is { CanUndo: true } undoable)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => UndoAsync(undoable.Section)" disabled="@working" data-testid="book-draft-undo">@L["Campaign.Book.Draft.Undo"]</button>
                        }
                    </div>
                    <div class="book-draft-pane-body book-draft-edit-body">
                        @if (Current is { } shown)
                        {
                            @* While a merge is open its own bar says what is going on; the notice comes back if it is let go of. *@
                            @if (shown.Stale && mergeSection == null)
                            {
                                <div class="book-draft-notice" role="status" data-testid="book-draft-stale">
                                    <div>
                                        <strong>@L["Campaign.Book.Draft.Stale"]</strong>
                                        @if (shown.Changed.Count > 0)
                                        {
                                            <span class="small-muted"> @L["Campaign.Book.Draft.StaleEntries", string.Join(", ", shown.Changed)]</span>
                                        }
                                        <div class="small-muted">@L["Campaign.Book.Draft.StaleHint"]</div>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => MergePrepareAsync(shown.Section)" Disabled="@(working || AiBusy)" data-testid="book-draft-merge">
                                            <LucideIcon IconName="git-merge" Size="14" /> @L["Campaign.Book.Draft.Merge.Button"]
                                        </CodexButton>
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => RegenerateAsync(shown.Section)" Disabled="@(working || AiBusy)" data-testid="book-draft-regenerate">
                                            <LucideIcon IconName="refresh-cw" Size="14" /> @L["Campaign.Book.Draft.Regenerate"]
                                        </CodexButton>
                                        <CodexButton Small="true" OnClick="() => KeepAsync(shown.Section)" Disabled="@(working || AiBusy)" data-testid="book-draft-keep">@L["Campaign.Book.Draft.Keep"]</CodexButton>
                                    </div>
                                </div>
                            }
                            else if (shown.Gone)
                            {
                                <div class="book-draft-notice" role="status" data-testid="book-draft-gone">@L["Campaign.Book.Draft.Gone"]</div>
                            }
                        }
                        else
                        {
                            <div class="small-muted px-1 pb-1">@L["Campaign.Book.Draft.StylesheetHint"]</div>
                            <div class="small px-1 pb-1" role="status" aria-live="polite" data-testid="book-draft-web">
                                @if (fetching > 0)
                                {
                                    <span class="small-muted">@L["Campaign.Book.Draft.Web.Fetching"]</span>
                                }
                                else if (webReport is { Kept: > 0 } kept)
                                {
                                    <span class="small-muted">@L["Campaign.Book.Draft.Web.Kept", kept.Kept, Megabytes(kept.KeptBytes)]</span>
                                }
                            </div>
                        }
                        @* An AI request's pre-flight and its review sit on the Markdown they lock, not in a tab that could be folded away. *@
                        @if (AiBusy)
                        {
                        <div class="book-draft-ai-bar" data-testid="book-draft-ai-bar">
                        @if (reviewing)
                        {
                            <div class="book-draft-ai-review" role="group" aria-labelledby="book-draft-ai-title" data-testid="book-draft-review">
                                <strong id="book-draft-ai-title">@(mergeKey != null ? L["Campaign.Book.Draft.Merge.Review"] : L["Campaign.Book.Draft.Ai.Review"])</strong>
                                <span class="small-muted" role="status" aria-live="polite" data-review-left data-testid="book-draft-review-left"></span>
                                @if (shapeRun is { } running)
                                {
                                    <span class="small-muted" data-testid="book-draft-shape-progress">@L["Campaign.Book.Draft.ShapeBook.Progress", running.Next, running.Sections.Count]</span>
                                    <CodexButton Small="true" OnClick="ShapeBookStop" data-testid="book-draft-shape-stop">@L["Campaign.Book.Draft.ShapeBook.Stop"]</CodexButton>
                                }
                                <span class="flex-grow-1"></span>
                                <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="@(() => AiFinishAsync("accepted"))" data-testid="book-draft-review-keep">@L["Campaign.Book.Draft.Ai.KeepAccepted"]</CodexButton>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="@(() => AiFinishAsync("all"))" data-testid="book-draft-review-all">@L["Campaign.Book.Draft.Ai.AcceptRest"]</CodexButton>
                                <CodexButton Small="true" OnClick="@(() => AiFinishAsync("none"))" data-testid="book-draft-review-discard">@L["Campaign.Book.Draft.Ai.Discard"]</CodexButton>
                                <div class="small-muted w-100">@L["Campaign.Book.Draft.Ai.ReviewHint"]</div>
                            </div>
                        }
                        else if (shapePreview is { } book)
                        {
                            @* The whole book (docs/BOOK_EXPORT.md 42, step 3): the cost of every chapter first; then each chapter is asked and reviewed in turn. *@
                            <div class="book-draft-ai-confirm" role="group" aria-labelledby="book-draft-ai-title" data-testid="book-draft-shape-confirm">
                                <strong id="book-draft-ai-title">@L["Campaign.Book.Draft.ShapeBook.Confirm", book.Sections.Count, book.Model?.Label ?? string.Empty]</strong>
                                <div class="small-muted" data-testid="book-draft-shape-calls">@L["Campaign.Book.Draft.ShapeBook.Calls", book.Calls]</div>
                                @if (book.TooLong.Count > 0)
                                {
                                    <div class="small-muted" data-testid="book-draft-shape-too-long">@L["Campaign.Book.Draft.ShapeBook.TooLong", string.Join(", ", book.TooLong.Select(TitleOf))]</div>
                                }
                                @if (book.Preflight is { } flight)
                                {
                                    <div class="small-muted">@L["Campaign.Book.Draft.Ai.Tokens", Number(flight.InputLow), Number(flight.InputHigh), Number(flight.OutputHigh)]</div>
                                    @if (flight.CostLow is { } low && flight.CostHigh is { } high)
                                    {
                                        <div class="small-muted" data-testid="book-draft-shape-cost">@L["Campaign.Book.Draft.Ai.Cost", Money(low, book.Model?.Price), Money(high, book.Model?.Price)]</div>
                                    }
                                    else
                                    {
                                        <div class="small-muted">@L["Campaign.Book.Ai.Preflight.NoPrice"]</div>
                                    }
                                    @if (book.Model?.ServerUsedToday is { } server && server.Limit > 0)
                                    {
                                        <div class="small-muted">@L["Campaign.Book.Draft.Ai.Allowance", server.Used, server.Limit, BookEditWorker.MaxAttempts * book.Calls]</div>
                                    }
                                }
                                <div class="small-muted">@L["Campaign.Book.Draft.ShapeBook.Each"]</div>
                                <div class="d-flex gap-2 mt-1">
                                    <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="ShapeBookStartAsync" data-testid="book-draft-shape-start">@L["Campaign.Book.Draft.ShapeBook.Start"]</CodexButton>
                                    <CodexButton Small="true" OnClick="ShapeBookCancel" data-testid="book-draft-shape-cancel">@L["Common.Cancel"]</CodexButton>
                                </div>
                            </div>
                        }
                        else if (mergePreview is { } merge)
                        {
                            <div class="book-draft-ai-confirm" role="group" aria-labelledby="book-draft-ai-title" data-testid="book-draft-merge-confirm">
                                <strong id="book-draft-ai-title">@L["Campaign.Book.Draft.Merge.Confirm"]</strong>
                                <div class="small-muted" data-testid="book-draft-merge-summary">@L["Campaign.Book.Draft.Merge.Summary", merge.Theirs, merge.Mine, merge.Added, merge.Removed, merge.Restored]</div>
                                <div class="small" data-testid="book-draft-merge-conflicts">@L["Campaign.Book.Draft.Merge.Conflicts", merge.Conflicts]</div>
                                @if (merge.Sendable > 0 && merge.Model is { } model && merge.Preflight is { } flight)
                                {
                                    <div class="small-muted">@L["Campaign.Book.Draft.Merge.Send", merge.Sendable, model.Label]</div>
                                    <div class="small-muted">@L["Campaign.Book.Draft.Ai.Tokens", Number(flight.InputLow), Number(flight.InputHigh), Number(flight.OutputHigh)]</div>
                                    @if (flight.CostLow is { } low && flight.CostHigh is { } high)
                                    {
                                        <div class="small-muted" data-testid="book-draft-merge-cost">@L["Campaign.Book.Draft.Ai.Cost", Money(low, model.Price), Money(high, model.Price)]</div>
                                    }
                                    else
                                    {
                                        <div class="small-muted">@L["Campaign.Book.Ai.Preflight.NoPrice"]</div>
                                    }
                                    @if (model.ServerUsedToday is { } server && server.Limit > 0)
                                    {
                                        <div class="small-muted">@L["Campaign.Book.Draft.Ai.Allowance", server.Used, server.Limit, BookEditWorker.MaxAttempts * merge.Sendable]</div>
                                    }
                                }
                                else if (merge.Sendable > 0)
                                {
                                    <div class="small-muted" data-testid="book-draft-merge-nomodel">@L["Campaign.Book.Draft.Merge.NoModel"]</div>
                                }
                                @if (merge.Conflicts > merge.Sendable)
                                {
                                    <div class="small-muted">@L["Campaign.Book.Draft.Merge.NotSendable", merge.Conflicts - merge.Sendable]</div>
                                }
                                <div class="d-flex gap-2 mt-1 flex-wrap">
                                    @if (merge.Sendable > 0 && merge.Model != null)
                                    {
                                        <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => MergeRunAsync(true)" data-testid="book-draft-merge-ai">@L["Campaign.Book.Draft.Merge.WithAi"]</CodexButton>
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => MergeRunAsync(false)" data-testid="book-draft-merge-plain">@L["Campaign.Book.Draft.Merge.WithoutAi"]</CodexButton>
                                    }
                                    else
                                    {
                                        <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => MergeRunAsync(false)" data-testid="book-draft-merge-plain">@L["Campaign.Book.Draft.Merge.ShowChanges"]</CodexButton>
                                    }
                                    <CodexButton Small="true" OnClick="MergeCancelAsync" data-testid="book-draft-merge-cancel">@L["Common.Cancel"]</CodexButton>
                                </div>
                            </div>
                        }
                        else if (aiPreview is { } asking && aiPending is { } pending)
                        {
                            <div class="book-draft-ai-confirm" role="group" aria-labelledby="book-draft-ai-title" data-testid="book-draft-ai-confirm">
                                <strong id="book-draft-ai-title">@L["Campaign.Book.Draft.Ai.Confirm", pending.Whole ? L["Campaign.Book.Draft.Ai.Chapter"] : L["Campaign.Book.Draft.Ai.Selection"], asking.Model?.Label ?? string.Empty]</strong>
                                @if (!pending.Whole && (asking.From != pending.Selection.From || asking.To != pending.Selection.To))
                                {
                                    <div class="small-muted" data-testid="book-draft-ai-widened">@L["Campaign.Book.Draft.Ai.Widened"]</div>
                                }
                                @if (asking.Calls > 1)
                                {
                                    <div class="small-muted" data-testid="book-draft-ai-parts">@L["Campaign.Book.Draft.Ai.Parts", asking.Calls]</div>
                                }
                                @if (asking.Pieces > 0)
                                {
                                    <div class="small-muted" data-testid="book-draft-ai-kept">@L["Campaign.Book.Draft.Ai.Kept", asking.Pieces]</div>
                                }
                                @if (asking.Preflight is { } flight)
                                {
                                    <div class="small-muted">@L["Campaign.Book.Draft.Ai.Tokens", Number(flight.InputLow), Number(flight.InputHigh), Number(flight.OutputHigh)]</div>
                                    @if (flight.CostLow is { } low && flight.CostHigh is { } high)
                                    {
                                        <div class="small-muted" data-testid="book-draft-ai-cost">@L["Campaign.Book.Draft.Ai.Cost", Money(low, asking.Model?.Price), Money(high, asking.Model?.Price)]</div>
                                    }
                                    else
                                    {
                                        <div class="small-muted">@L["Campaign.Book.Ai.Preflight.NoPrice"]</div>
                                    }
                                    @if (asking.Model?.ServerUsedToday is { } server && server.Limit > 0)
                                    {
                                        <div class="small-muted">@L["Campaign.Book.Draft.Ai.Allowance", server.Used, server.Limit, BookEditWorker.MaxAttempts * asking.Calls]</div>
                                    }
                                }
                                <div class="d-flex gap-2 mt-1">
                                    <CodexButton Variant="CodexButtonVariant.Plaque" Small="true" OnClick="() => AiSendAsync()" data-testid="book-draft-ai-send">@L["Campaign.Book.Draft.Ai.Send"]</CodexButton>
                                    <CodexButton Small="true" OnClick="AiCancelAsync" data-testid="book-draft-ai-cancel">@L["Common.Cancel"]</CodexButton>
                                </div>
                            </div>
                        }
                        else if (aiAsking)
                        {
                            <div class="d-flex gap-2 align-items-center" role="status" aria-live="polite" data-testid="book-draft-ai-asking">
                                <span id="book-draft-ai-title">@L["Campaign.Book.Draft.Ai.Asking"]</span>
                                @if (shapeRun is { } asked)
                                {
                                    <span class="small-muted" data-testid="book-draft-shape-progress">@L["Campaign.Book.Draft.ShapeBook.Progress", asked.Next, asked.Sections.Count]</span>
                                }
                                <CodexButton Small="true" OnClick="() => aiStop?.Cancel()" data-testid="book-draft-ai-stop">@L["Campaign.Book.Draft.Ai.Stop"]</CodexButton>
                            </div>
                        }
                        </div>
                        }
                        @* The editor's own box: the review view is put beside the code by the script, never among Blazor's elements. *@
                        <div class="book-draft-codebox"><div class="book-draft-code" @ref="host" data-testid="book-draft-code"></div></div>
                    </div>
                </section>

                @* ---- The preview. Collapsed, it is still drawn (off the screen): the reports measure it. ---- *@
                @if (!previewOpen)
                {
                    <button type="button" class="book-draft-strip" @onclick="() => TogglePaneAsync(Pane.Preview)" aria-expanded="false"
                            aria-label="@L["Campaign.Book.Draft.ExpandNamed", L["Campaign.Book.Draft.Preview"]]" data-testid="book-draft-pane-preview-toggle">
                        <LucideIcon IconName="panel-right-open" Size="14" /> <span>@L["Campaign.Book.Draft.Preview"]</span>
                    </button>
                }
                <section class="book-draft-pane book-draft-preview @(previewOpen ? null : "offstage")" aria-labelledby="book-draft-preview-title" aria-hidden="@(previewOpen ? null : "true")">
                    <div class="book-draft-pane-head">
                        <span id="book-draft-preview-title"><LucideIcon IconName="eye" Size="14" /> @L["Campaign.Book.Draft.Preview"]</span>
                        <span class="flex-grow-1"></span>
                        <button type="button" class="book-draft-pane-btn" @onclick="() => TogglePaneAsync(Pane.Preview)" aria-expanded="true"
                                title="@L["Campaign.Book.Draft.Collapse"]" aria-label="@L["Campaign.Book.Draft.CollapseNamed", L["Campaign.Book.Draft.Preview"]]" data-testid="@(previewOpen ? "book-draft-pane-preview-toggle" : null)">
                            <LucideIcon IconName="panel-right-close" Size="14" />
                        </button>
                    </div>
                    <div class="field-error small px-2" data-overflow hidden data-testid="book-draft-overflow"></div>
                    <div class="small-muted small px-2" data-run-on hidden data-testid="book-draft-run-on"></div>
                    <iframe class="book-draft-frame" @ref="frame" sandbox="allow-same-origin" title="@L["Campaign.Book.PreviewTitle"]" data-testid="book-draft-preview"></iframe>
                </section>
            </div>

            @* ---- The panel: Ask AI, Problems, Blocks ---- *@
            <section class="book-draft-panel @(panelOpen ? null : "closed")" data-testid="book-draft-dock">
                <div class="book-draft-panel-tabs">
                    <div class="cx-tabs" role="tablist" aria-label="@L["Campaign.Book.Draft.Panel"]" @onkeydown="PanelKeyAsync">
                        @foreach (var (tab, icon, label) in PanelTabs)
                        {
                            var selected = panelOpen && panelTab == tab;
                            <button type="button" role="tab" id="@("book-draft-tab-" + tab)" class="cx-tab" aria-selected="@(selected ? "true" : "false")" aria-controls="@("book-draft-tabpanel-" + tab)"
                                    tabindex="@(panelTab == tab ? 0 : -1)" @onclick="() => ShowTabAsync(tab)" data-testid="@("book-draft-tab-" + tab)">
                                <LucideIcon IconName="@icon" Size="14" /> @label
                                @if (tab == "problems" && ProblemCount > 0)
                                {
                                    <span class="cx-tab-badge" data-testid="book-draft-problems-count">@ProblemCount</span>
                                }
                            </button>
                        }
                    </div>
                    <span class="flex-grow-1"></span>
                    <HomebreweryCredit Class="me-2" />
                    <button type="button" class="book-draft-pane-btn" @onclick="TogglePanelAsync" aria-expanded="@(panelOpen ? "true" : "false")"
                            title="@(panelOpen ? L["Campaign.Book.Draft.Collapse"] : L["Campaign.Book.Draft.Expand"])" aria-label="@L[panelOpen ? "Campaign.Book.Draft.CollapseNamed" : "Campaign.Book.Draft.ExpandNamed", L["Campaign.Book.Draft.Panel"]]" data-testid="book-draft-panel-toggle">
                        <LucideIcon IconName="@(panelOpen ? "chevron-down" : "chevron-up")" Size="14" />
                    </button>
                </div>

                <div id="book-draft-tabpanel-ai" role="tabpanel" aria-labelledby="book-draft-tab-ai" class="book-draft-panel-body" hidden="@(!panelOpen || panelTab != "ai")">
                    @if (Current is { } shownForAi)
                    {
                        @* AI edits (docs/BOOK_EXPORT.md 41.4): the selection, or the chapter, sent with its secrets, pictures and breaks kept back; the
                           cost shown before anything is sent; the reply reviewed change by change, and nothing saved until it is accepted. *@
                        <section class="book-draft-ai" aria-labelledby="book-draft-tab-ai" data-testid="book-draft-ai">
                            @if (AiBusy)
                            {
                                <div class="small-muted" role="status">@L["Campaign.Book.Draft.Ai.InPane"]</div>
                            }
                            else
                            {
                                <div class="book-draft-ai-row">
                                    @foreach (var preset in BookEditPrompts.Presets.Keys)
                                    {
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="@(() => AiPrepareAsync(preset))" Disabled="@(working || state == SaveState.Conflict)"
                                                     title="@L["Campaign.Book.Draft.Ai.Preset." + preset + ".Hint"]" data-testid="@("book-draft-ai-" + preset)">@L["Campaign.Book.Draft.Ai.Preset." + preset]</CodexButton>
                                    }
                                    <label for="book-draft-ai-ask" class="visually-hidden">@L["Campaign.Book.Draft.Ai.AskLabel"]</label>
                                    <input id="book-draft-ai-ask" class="form-control form-control-sm book-draft-ai-input" maxlength="@BookDraftEdits.MaxAskChars" placeholder="@L["Campaign.Book.Draft.Ai.AskPlaceholder"]"
                                           @bind="aiText" @bind:event="oninput" @onkeydown="AiKeyAsync" disabled="@(working || state == SaveState.Conflict)" data-testid="book-draft-ai-ask" />
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => AiPrepareAsync(null)" Disabled="@(working || state == SaveState.Conflict)" data-testid="book-draft-ai-go">
                                        <LucideIcon IconName="sparkles" Size="14" /> @L["Campaign.Book.Draft.Ai.Ask"]
                                    </CodexButton>
                                </div>
                                <div class="small-muted">@L["Campaign.Book.Draft.Ai.Hint"]</div>
                            }
                            @if (aiNote != null)
                            {
                                <div class="small @(aiNoteError ? "field-error" : "small-muted")" role="status" aria-live="polite" data-testid="book-draft-ai-note">@aiNote</div>
                            }
                        </section>
                    }
                    else
                    {
                        <div class="small-muted">@L["Campaign.Book.Draft.Ai.PickChapter"]</div>
                    }
                </div>

                <div id="book-draft-tabpanel-problems" role="tabpanel" aria-labelledby="book-draft-tab-problems" class="book-draft-panel-body book-draft-report" hidden="@(!panelOpen || panelTab != "problems")"
                     data-testid="book-draft-fit-report">
                    @if (ProblemCount == 0 && fitReport == null)
                    {
                        <div class="small-muted">@L["Campaign.Book.Draft.NoProblems"]</div>
                    }
                    @if (fitReport is { } fitted)
                    {
                        <div role="status" aria-live="polite">@(fitted.Chapters == 0 && fitted.Result == BookDraftSave.Saved ? L["Campaign.Book.Draft.Fit.Nothing"] : L["Campaign.Book.Draft.Fit.Done", fitted.Breaks, fitted.Chapters])</div>
                        @if (fitted.Overflow.Count > 0)
                        {
                            <div class="field-error" data-testid="book-draft-fit-too-tall">
                                @L["Campaign.Book.Draft.Fit.TooTall"]
                                <ul class="mb-0 ps-3">
                                    @foreach (var o in fitted.Overflow.Take(12))
                                    {
                                        <li>@Item(o)</li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (fitted.Unplaced.Count > 0)
                        {
                            <div class="small-muted" data-testid="book-draft-fit-unplaced">
                                @L["Campaign.Book.Draft.Fit.Unplaced"]
                                <ul class="mb-0 ps-3">
                                    @foreach (var o in fitted.Unplaced.Take(12))
                                    {
                                        <li>@Item(o)</li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                    @if (leakReport is { Total: > 0 } leaks)
                    {
                        @* The party leak check (docs/BOOK_EXPORT.md 41.19): a warning, not a refusal. Each hit opens its chapter. *@
                        <div class="field-error" role="alert" data-testid="book-draft-leaks">
                            @L["Campaign.Book.Draft.Leak.Found", leaks.Total]
                            <ul class="mb-1 ps-3">
                                @foreach (var hit in leaks.Hits)
                                {
                                    <li data-testid="book-draft-leak" data-kind="@hit.Kind">
                                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ShowAsync(hit.Section.Length == 0 ? null : hit.Section)"
                                                disabled="@AiBusy"><bdi>@(hit.Section.Length == 0 ? L["Campaign.Book.Draft.Stylesheet"] : TitleOf(hit.Section))</bdi></button>:
                                        @LeakLabel(hit) <bdi class="text-break">“@Snippet(hit.Text)”</bdi>
                                    </li>
                                }
                                @if (leaks.Total > leaks.Hits.Count)
                                {
                                    <li>@L["Campaign.Book.Draft.Leak.More", leaks.Total - leaks.Hits.Count]</li>
                                }
                            </ul>
                            <div class="small">@L["Campaign.Book.Draft.Leak.Hint"]</div>
                            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => DownloadAsync(true, leaksForMarkdown, leaksForPlayer)" Disabled="@printing" data-testid="book-draft-download-anyway">
                                <LucideIcon IconName="download" Size="14" /> @L["Campaign.Book.Draft.Leak.Anyway"]
                            </CodexButton>
                        </div>
                    }
                    @if (letters.Count > 0)
                    {
                        @* Characters no face of the theme draws (docs/BOOK_EXPORT.md 41.21): they print in a system font, or as boxes. *@
                        <div class="field-error" data-testid="book-draft-letters">
                            @L["Campaign.Book.Draft.Letters.Found"]
                            <ul class="mb-1 ps-3">
                                @foreach (var (section, characters, more) in letters)
                                {
                                    <li data-testid="book-draft-letter" data-section="@section">
                                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ShowAsync(section)" disabled="@AiBusy"><bdi>@TitleOf(section)</bdi></button>:
                                        <bdi class="text-break">@string.Join(" ", characters.EnumerateRunes())</bdi>@(more > 0 ? " " + L["Campaign.Book.Draft.Letters.More", more] : "")
                                    </li>
                                }
                            </ul>
                            <div class="small">@L["Campaign.Book.Draft.Letters.Hint"]</div>
                        </div>
                    }
                    @if (leftOut.Count > 0)
                    {
                        @* Pictures the book leaves out (docs/BOOK_EXPORT.md 31.1, item 4): the preview and the PDF leave out the same ones. *@
                        <div class="field-error" data-testid="book-draft-left-out">
                            @L["Campaign.Book.Draft.Pictures.LeftOut", leftOut.Count]
                            <ul class="mb-1 ps-3">
                                @foreach (var picture in leftOut.Take(24))
                                {
                                    <li data-testid="book-draft-left-out-item" data-reason="@picture.Reason">
                                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ShowAsync(picture.Section)" disabled="@AiBusy"><bdi>@TitleOf(picture.Section)</bdi></button>:
                                        <bdi>@picture.Label</bdi> (@(picture.Reason == "limit" ? L["Campaign.Book.Draft.Pictures.Limit"] : L["Campaign.Book.Draft.Pictures.Unreadable"]))
                                    </li>
                                }
                                @if (leftOut.Count > 24)
                                {
                                    <li>@L["Campaign.Book.Draft.Letters.More", leftOut.Count - 24]</li>
                                }
                            </ul>
                            <div class="small">@L["Campaign.Book.Draft.Pictures.Hint"]</div>
                        </div>
                    }
                    @if (aiKept.Count > 0)
                    {
                        @* An entry-by-entry AI edit (docs/BOOK_EXPORT.md 42): the entries whose reply failed kept their text. *@
                        <div class="field-error" data-testid="book-draft-ai-kept-parts">
                            @L["Campaign.Book.Draft.Ai.KeptParts", KeptCount]
                            <ul class="mb-1 ps-3">
                                @foreach (var (keptSection, part) in aiKept.SelectMany(k => k.Parts.Select(p => (k.Section, p))).Take(24))
                                {
                                    <li data-testid="book-draft-ai-kept-part" data-reason="@part.Reason">
                                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ShowAsync(keptSection)" disabled="@AiBusy"><bdi>@TitleOf(keptSection)</bdi></button>:
                                        <bdi>@part.Label</bdi> (@KeptReason(part.Reason))
                                    </li>
                                }
                            </ul>
                            <div class="small">@L["Campaign.Book.Draft.Ai.KeptPartsHint"]</div>
                        </div>
                    }
                    @if (printReport != null)
                    {
                        <div class="field-error" data-testid="book-draft-print-overflow">@printReport</div>
                    }
                    @if (webReport is { Failed.Count: > 0 } failedWeb)
                    {
                        <div class="field-error" data-testid="book-draft-web-failed">
                            @L["Campaign.Book.Draft.Web.Failed", failedWeb.Failed.Count]
                            <ul class="mb-0 ps-3">
                                @foreach (var failure in failedWeb.Failed.Take(8))
                                {
                                    <li><bdi dir="ltr" class="text-break">@failure.Url</bdi>: @Problem(failure)</li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                <div id="book-draft-tabpanel-blocks" role="tabpanel" aria-labelledby="book-draft-tab-blocks" class="book-draft-panel-body" hidden="@(!panelOpen || panelTab != "blocks")">
                    <p class="small mb-0">@L["Campaign.Book.Draft.BlocksHint"]</p>
                </div>
            </section>
        </div>
    }
</dialog>

@code {
    [Parameter, EditorRequired] public CampaignAccess Access { get; set; } = null!;
    [Parameter, EditorRequired] public string BasePath { get; set; } = string.Empty;

    private DotNetObjectReference<BookDraftEditor>? self;
    private IJSObjectReference? module;
    private ElementReference host;
    private ElementReference frame;
    private string? editorId;
    private int openings;
    private BookDraftView? view;
    private string edition = "party";
    private string language = "en";
    private string pageSize = "Letter";
    private string? current = BookDraftWriter.Front;
    private bool openRequested;
    private bool printing;
    private bool working;
    private bool fitting;
    private BookDraftFitReport? fitReport;
    private string? printReport;
    private BookLeakReport? leakReport;
    private IReadOnlyList<(string Section, string Characters, int More)> letters = [];
    private IReadOnlyList<BookDraftLeftOut> leftOut = [];
    private IReadOnlyList<BookThemeDocument> customThemes = [];
    private bool wizardOpen;

    /// <summary>The wizard closed: the campaign's themes read again, and the theme it saved, if any, chosen for this draft.</summary>
    private async Task WizardClosedAsync((string Id, bool Homebrewery)? chosen)
    {
        wizardOpen = false;
        customThemes = (await ThemeStore.ThemesAsync(Access)).Where(t => t.Ready).ToList();
        if (chosen is { } c && view != null) await SettingsAsync(c.Id, c.Homebrewery);
    }

    // Each bundled face's character map, read once per process (BookFontCoverage).
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, IReadOnlySet<int>?> FontMaps = new(StringComparer.Ordinal);

    /// <summary>The characters of the draft no face of its theme draws, by chapter (the Problems tab).</summary>
    private async Task CheckLettersAsync()
    {
        if (view == null)
        {
            letters = [];
            return;
        }

        var resolved = await Catalog.ResolveAsync(Access, view.Theme, language, Font);
        var chapters = view.Chapters.Select(c => (c.Section, c.Markdown));
        if (resolved.Faces is { } measured)
        {
            // A theme the GM brought in: its own faces, the layer's when it sits on it, and the stand-ins for this language.
            letters = BookFontCoverage.Uncovered(chapters, measured);
            return;
        }

        var theme = resolved.Theme;
        // A theme with no faces of its own (Homebrewery layout) draws in the layer's; checking against nothing would list every letter.
        var faces = theme.Fonts.Count > 0
            ? theme.FontsFor(language)
            : BookDraftThemes.LayerFaces.Select(f => new BookFontFace(f.Family, 400, f.Style, f.File, "U+0-10FFFF")).ToList();
        letters = BookFontCoverage.Uncovered(chapters, faces,
            file => FontMaps.GetOrAdd(file, f => Font(f) is { } bytes ? BookFontCoverage.Read(bytes) : null));
    }
    private bool confirmStartOver;
    private bool confirmMarkdown;
    // Which download the party leak check stopped: Download anyway makes that one.
    private bool leaksForMarkdown;
    private string? leaksForPlayer;

    // The players who have a book of their own, read when the menu opens (a player may have joined since the editor did).
    private IReadOnlyList<BookPlayer> players = [];

    private async Task ToggleMoreAsync()
    {
        moreOpen = !moreOpen;
        if (moreOpen && edition == "party") players = await Drafts.PlayersAsync(Access);
    }

    /// <summary>One player's own book as a PDF (docs/BOOK_EXPORT.md 45). The party draft is leak-checked first, as for the party's own PDF: their copy
    /// is that draft with their notes added.</summary>
    private async Task PlayerDownloadAsync(BookPlayer player)
    {
        moreOpen = false;
        await DownloadAsync(false, player: player.UserId);
    }
    private string? message;
    private SaveState state = SaveState.Saved;
    private readonly SemaphoreSlim saving = new(1, 1);
    private readonly HashSet<string> dirty = new(StringComparer.Ordinal);
    private bool cssDirty;

    // The draft's copies of the web addresses its stylesheet names (docs/BOOK_EXPORT.md 41.14), what the last fetch did, and the stylesheet as
    // last saved (a fetch that ends restyles the preview with it, not with the text it started from).
    private BookCssWeb web = new();
    private BookWebReport? webReport;
    private int fetching;
    private string savedCss = string.Empty;
    private readonly CancellationTokenSource closing = new();

    private string Megabytes(long bytes) => (bytes / 1048576.0).ToString(bytes < 1048576 ? "0.00" : "0.0", System.Globalization.CultureInfo.CurrentCulture);

    private string Problem(BookWebFailure failure) => failure.Problem switch
    {
        BookWebProblem.NotPublic => L["Campaign.Book.Draft.Web.NotPublic"],
        BookWebProblem.TimedOut => L["Campaign.Book.Draft.Web.TimedOut"],
        BookWebProblem.Refused => L["Campaign.Book.Draft.Web.Refused", failure.Status],
        BookWebProblem.TooLarge => L["Campaign.Book.Draft.Web.TooLarge"],
        BookWebProblem.NotWhatWasNamed => L["Campaign.Book.Draft.Web.NotWhatWasNamed"],
        BookWebProblem.TooManyRedirects => L["Campaign.Book.Draft.Web.TooManyRedirects"],
        BookWebProblem.Full => L["Campaign.Book.Draft.Web.Full"],
        BookWebProblem.NotListed => L["Campaign.Book.Draft.Web.NotListed", new Uri(failure.Url).Host],
        _ => L["Campaign.Book.Draft.Web.Unreachable"]
    };

    private enum SaveState { Saved, Saving, Conflict, Failed }

    private BookDraftChapterView? Current => current == null ? null : view?.Chapters.FirstOrDefault(c => c.Section == current);

    private string EditionName => edition == "dm" ? L["Campaign.Book.Edition.Dm"] : L["Campaign.Book.Edition.Party"];

    private string SaveText => state switch
    {
        SaveState.Saving => L["Campaign.Book.Draft.Saving"],
        SaveState.Conflict => L["Campaign.Book.Draft.Conflict"],
        SaveState.Failed => L["Campaign.Book.Draft.SaveFailed"],
        _ => dirty.Count > 0 || cssDirty ? L["Campaign.Book.Draft.Unsaved"] : L["Campaign.Book.Draft.Saved"]
    };

    private string Title(BookDraftChapterView chapter) => chapter.Section == BookDraftWriter.Front ? L["Campaign.Book.Draft.Front"] : chapter.Title;

    private string TitleOf(string? section) =>
        view?.Chapters.FirstOrDefault(c => c.Section == section) is { } chapter ? Title(chapter) : section ?? string.Empty;

    // A line of the Fit pages report: the page (when there is one), its chapter, and the first words of what it is about.
    private string Item(BookOverflow o) => o.Page > 0
        ? L["Campaign.Book.Draft.Fit.Item", o.Page, TitleOf(o.Section), o.Words ?? string.Empty]
        : L["Campaign.Book.Draft.Fit.ItemNoPage", TitleOf(o.Section), o.Words ?? string.Empty];

    /// <summary>Opens the editor on the GM's draft of an edition in a language, making the draft first if there is none.</summary>
    public async Task OpenAsync(string edition, string language, string pageSize)
    {
        this.edition = edition;
        this.language = language;
        this.pageSize = pageSize;
        message = null;
        confirmStartOver = false;
        closeWithoutSaving = false;
        view = await Drafts.OpenAsync(Access, edition, language, pageSize);
        customThemes = (await ThemeStore.ThemesAsync(Access)).Where(t => t.Ready).ToList();
        await CheckLettersAsync();
        if (view == null)
        {
            message = L["Campaign.Book.Draft.NotAllowed"];
            return;
        }

        current = view.Chapters.FirstOrDefault(c => c.Stale)?.Section ?? view.Chapters.FirstOrDefault()?.Section;
        web = await Drafts.WebAsync(Access, edition, language);
        webReport = null;
        leakReport = null;
        savedCss = view.Css;
        state = SaveState.Saved;
        dirty.Clear();
        cssDirty = false;
        openRequested = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!openRequested || view == null) return;
        openRequested = false;
        if (!layoutRead)
        {
            await ReadLayoutAsync();
            StateHasChanged();
        }

        await JS.InvokeVoidAsync("codex.guardModal", "book-draft-dialog");
        await JS.InvokeVoidAsync("codex.showModal", "book-draft-dialog");
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/" + Assets["lib/book/book-editor.js"]);
            self ??= DotNetObjectReference.Create(this);
            if (editorId != null) await module.InvokeVoidAsync("close", editorId);
            // Opening waits for the preview to draw; another opening may start meanwhile (a theme picked twice quickly). Only the last one's
            // editor is kept: the script closes an earlier one when the next starts, and an earlier one that ends last is not taken.
            var opening = ++openings;
            var asked = current;
            var shell = await ShellAsync();
            if (shell.Html == null)
            {
                // The only refusal is the language gate (a theme stored before the draft's language could use it, or one with Latin faces only).
                message = L["Campaign.Book.Failed.Language"];
                StateHasChanged();
                return;
            }

            var opened = await module.InvokeAsync<string>("open", host, frame, new
            {
                chapters = view.Chapters.Select(c => new { section = c.Section, markdown = c.Markdown }),
                css = view.Css,
                shell = shell.Html,
                artUrl = $"{BasePath}/book/{edition}/draft/{language}/art",
                current = asked,
                rtl = BookThemes.IsRtl(language)
            }, self, new
            {
                overflow = L["Campaign.Book.Draft.Overflow"].ToString(),
                runOn = L["Campaign.Book.Draft.RunOn"].ToString(),
                titles = view.Chapters.ToDictionary(c => c.Section, Title)
            });
            if (opening != openings) return;
            editorId = opened;
            if (current == null || current != asked) await module.InvokeVoidAsync("show", editorId, current);
            // An address the last fetch could not reach is tried again.
            _ = FetchWebAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The book editor could not start");
            message = L["Campaign.Book.Draft.EditorFailed"];
            StateHasChanged();
        }
    }

    private byte[]? Font(string file)
    {
        var fonts = Path.GetFullPath(Path.Combine(Env.WebRootPath, "fonts"));
        var path = Path.GetFullPath(Path.Combine(fonts, file));
        return path.StartsWith(fonts, StringComparison.Ordinal) && File.Exists(path) ? File.ReadAllBytes(path) : null;
    }

    private async Task<BookHtmlResult> ShellAsync()
    {
        // A built-in theme or one of the campaign's own (41.22), resolved as the PDF resolves it.
        var theme = await Catalog.ResolveAsync(Access, view!.Theme, language, Font);
        return BookDraftHtml.Shell(string.Empty, language, theme.Theme, view.PageSize, view.Css, theme.Homebrewery ?? view.Homebrewery, Font, web, view.Edge);
    }

    private async Task ShowAsync(string? section)
    {
        // Clicked before the editor has started: remembered, and shown once it has (a click was lost on a slow machine).
        if (module == null || editorId == null)
        {
            current = section;
            return;
        }

        await FlushAsync();
        await module.InvokeVoidAsync("show", editorId, section);
        current = section;
    }

    /// <summary>The editor says a chapter changed (typing stopped): its text is read as a stream and saved.</summary>
    [JSInvokable]
    public async Task Changed(string section)
    {
        dirty.Add(section);
        await SaveAsync(section);
    }

    /// <summary>The pictures the preview's art left out, as the server sent them with it.</summary>
    [JSInvokable]
    public Task ArtLeftOut(List<BookDraftLeftOut>? pictures)
    {
        leftOut = pictures ?? [];
