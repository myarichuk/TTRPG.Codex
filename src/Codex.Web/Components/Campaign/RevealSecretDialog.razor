@using Codex.Core
@using Codex.Persistence
@inject IJSRuntime JS

@* Reveals one secret block of a wiki page: the whole secret on top, so the DM reads what the players will read, then whom it
   goes to (the party, or some of the characters players play), then the reveal. It replaces asking twice (a picker in the
   side panel, then a confirmation), and has the room the side panel lacks. Its contents render only while it is asking. *@

<dialog id="reveal-secret-dialog" class="codex-dialog codex-dialog-wide" aria-labelledby="reveal-secret-title" @onclose="OnClosed" @oncancel="OnClosed" data-testid="reveal-dialog">
    @if (pending != null)
    {
        <form @onsubmit="Accept" @onsubmit:preventDefault="true">
            <div class="dialog-body">
                <h2 id="reveal-secret-title"><LucideIcon IconName="eye" Size="18" Class="title-icon" /> @L["Campaign.Wiki.Secrets.RevealTitle"]</h2>
                <div class="label-caps mb-1">@L["Campaign.Wiki.Secrets.TheSecret"]</div>
                <div class="secret-quote rules-text" data-testid="reveal-secret-text">@((MarkupString)secretHtml)</div>
                @if (characters.Count > 0)
                {
                    <fieldset class="mt-3 mb-2">
                        <legend class="field-label">@L["Campaign.Wiki.Secrets.Who"]</legend>
                        <div class="field-check">
                            <input id="reveal-to-party" type="radio" class="field-box" name="reveal-to" checked="@(!some)" @onchange="() => some = false" data-testid="reveal-to-party" />
                            <label for="reveal-to-party">@L["Campaign.Wiki.Secrets.ToParty"]</label>
                        </div>
                        <div class="field-check">
                            <input id="reveal-to-some" type="radio" class="field-box" name="reveal-to" checked="@some" @onchange="() => some = true" data-testid="reveal-to-some" />
                            <label for="reveal-to-some">@L["Campaign.Wiki.Secrets.ToSome"]</label>
                        </div>
                        @if (some)
                        {
                            <div class="reveal-picks" role="group" aria-label="@L["Campaign.Wiki.Secrets.ToSome"]" data-testid="reveal-picks">
                                @foreach (var pc in characters)
                                {
                                    <CodexCheck Checked="@picked.Contains(pc.Id)" OnChange="e => Toggle(pc.Id, e.Value is true)">@pc.Name</CodexCheck>
                                }
                            </div>
                        }
                    </fieldset>
                }
                <p class="field-hint mb-0 mt-2">@(pageShared ? L["Campaign.Wiki.Secrets.CannotUndo"] : L["Campaign.Wiki.Secrets.CannotUndoHidden"])</p>
            </div>
            <div class="dialog-actions">
                <CodexButton OnClick="() => Finish(null)">@L["Common.Cancel"]</CodexButton>
                <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Disabled="@(some && picked.Count == 0)" data-testid="reveal-accept">
                    <LucideIcon IconName="eye" Size="16" /> @(some ? L["Campaign.Wiki.Secrets.RevealToThem"] : L["Campaign.Wiki.Secrets.RevealToParty"])
                </CodexButton>
            </div>
        </form>
    }
</dialog>

@code {
    /// <summary>Whom the DM chose: the party (no knowers), or the characters picked.</summary>
    public sealed record Choice(SecretAudience To, IReadOnlyList<string>? Knowers);

    private string secretHtml = string.Empty;
    private bool pageShared;
    private IReadOnlyList<ActorDocument> characters = Array.Empty<ActorDocument>();
    private bool some;
    private HashSet<string> picked = new();
    private TaskCompletionSource<Choice?>? pending;
    private bool showRequested;

    /// <summary>Asks whom to reveal a block to. <paramref name="characters"/> are the ones players play (none: the party only);
    /// <paramref name="knowers"/> the ones it is revealed to now, ticked to begin with, and <paramref name="toSome"/> starts on
    /// "some characters". Null when the DM cancels.</summary>
    public async Task<Choice?> ShowAsync(string html, bool shared, IReadOnlyList<ActorDocument> pcs, IReadOnlyCollection<string> knowers, bool toSome)
    {
        if (pending != null) Finish(null);
        secretHtml = html;
        pageShared = shared;
        characters = pcs;
        picked = knowers.Where(id => pcs.Any(pc => pc.Id == id)).ToHashSet();
        some = toSome && pcs.Count > 0;
        pending = new TaskCompletionSource<Choice?>(TaskCreationOptions.RunContinuationsAsynchronously);
        showRequested = true;
        StateHasChanged();
        return await pending.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showRequested) return;
        showRequested = false;
        await JS.InvokeVoidAsync("codex.showModal", "reveal-secret-dialog");
    }

    private void Toggle(string id, bool on)
    {
        if (on) picked.Add(id); else picked.Remove(id);
    }

    private void Accept()
    {
        if (some && picked.Count == 0) return;
        // The picks in the order the characters are listed, so the "Revealed to" line reads the same every time.
        Finish(some ? new Choice(SecretAudience.Some, characters.Where(pc => picked.Contains(pc.Id)).Select(pc => pc.Id).ToList()) : new Choice(SecretAudience.Party, null));
    }

    private void Finish(Choice? choice)
    {
        var completion = pending;
        pending = null;
        _ = JS.InvokeVoidAsync("codex.closeModal", "reveal-secret-dialog");
        completion?.TrySetResult(choice);
    }

    private void OnClosed()
    {
        var completion = pending;
        pending = null;
        completion?.TrySetResult(null);
    }
}
