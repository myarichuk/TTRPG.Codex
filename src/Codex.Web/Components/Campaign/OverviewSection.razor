@using Codex.Persistence
@using Codex.Persistence.Runtime
@inject IUserRepository UserRepo
@inject Codex.Web.Services.ViewerClock Clock
@inject ISessionRepository SessionRepo
@inject ICampaignRepository CampaignRepo
@inject IWikiRepository WikiRepo
@inject IRegionRepository RegionRepo
@inject CampaignRuntimeManager RuntimeManager
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IJSRuntime JS
@inject Codex.Web.Services.AiFeatures Ai

<div class="row g-3">
    <div class="col-lg-8">
        @if (setup is { } steps)
        {
            <section class="panel setup-panel" aria-labelledby="setup-heading" data-testid="setup-checklist">
                <div class="panel-title">
                    <h2 id="setup-heading">@L["Campaign.Setup.Title"]</h2>
                    <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Icon="x" Label="@L["Campaign.Setup.Dismiss"]" title="@L["Campaign.Setup.Dismiss"]" OnClick="DismissSetupAsync" data-testid="setup-dismiss" />
                </div>
                <p class="small-muted mb-2">@L["Campaign.Setup.Progress", steps.Count(s => s.Done), steps.Count]</p>
                <ol class="setup-steps">
                    @foreach (var step in steps)
                    {
                        <li class="@(step.Done ? "setup-done" : null)" data-testid="@($"setup-{step.Key}")" data-done="@(step.Done ? "true" : "false")">
                            <LucideIcon IconName="@(step.Done ? "circle-check" : "circle")" Size="18" Class="setup-mark" />
                            <span class="visually-hidden">@(step.Done ? L["Campaign.Setup.Done"] : L["Campaign.Setup.ToDo"])</span>
                            <span class="setup-step">
                                @if (step.Key == "Invite")
                                {
                                    @* Not a link: the invite link is on this page already, so the step copies it. *@
                                    <button type="button" class="link-button" @onclick="InviteAsync" data-testid="setup-invite-copy">@L["Campaign.Setup.Invite"]</button>
                                }
                                else
                                {
                                    <a href="@step.Href">@L[$"Campaign.Setup.{step.Key}"]</a>
                                }
                                @if (!step.Done && step.Key == "Invite")
                                {
                                    <span class="setup-why">@L["Campaign.Setup.InviteWhen"]</span>
                                }
                                else if (!step.Done && step.Key == "Cast")
                                {
                                    <span class="setup-why">@L["Campaign.Setup.CastWhen"]</span>
                                }
                            </span>
                        </li>
                    }
                </ol>
                @if (steps.Any(s => !s.Done && s.Key is "Cast" or "Page" or "Place"))
                {
                    @* The world builder drafts pages, places and cast members in one go; what the DM accepts ticks these off. *@
                    <p class="small-muted mb-0 mt-2" data-testid="setup-builder">
                        <LucideIcon IconName="sparkles" Size="14" Class="title-icon" />
                        @if (aiReady)
                        {
                            <a href="@Ctx.BasePath/build">@L["Campaign.Setup.Builder"]</a>
                        }
                        else
                        {
                            <a href="/settings/ai">@L["Campaign.Setup.BuilderNoAi"]</a>
                        }
                    </p>
                }
            </section>
        }

        <section class="panel" aria-labelledby="about-heading">
            <div class="panel-title">
                <h2 id="about-heading">@L["Campaign.Overview.About"]</h2>
                @if (Ctx.IsDm)
                {
                    <a href="@Ctx.BasePath/settings" class="cx-btn cx-etched cx-sm"><LucideIcon IconName="edit-3" Size="14" /> @L["Campaign.Overview.Edit"]</a>
                }
            </div>
            @if (string.IsNullOrWhiteSpace(Ctx.Campaign.Description))
            {
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Ctx.Campaign.Tagline) ? L["Campaign.Overview.NoDescription"] : Ctx.Campaign.Tagline)</p>
            }
            else
            {
                <div class="rules-text mb-0" data-testid="campaign-description">@((MarkupString)Codex.Core.TextFormatting.ToHtml(Ctx.Campaign.Description))</div>
            }
        </section>

        <section class="panel" aria-labelledby="mine-heading">
            <div class="panel-title">
                <h2 id="mine-heading">@(Ctx.IsDm ? L["Campaign.Overview.Cast.Dm"] : L["Campaign.Overview.Cast.Player"])</h2>
                <a href="@Ctx.BasePath/cast" class="cx-btn cx-etched cx-sm">@L["Campaign.Overview.OpenCast"]</a>
            </div>
            @{
                var mine = Ctx.IsDm ? Ctx.Actors : Ctx.Actors.Where(a => a.OwnerUserId == Ctx.UserId).ToList();
            }
            @if (mine.Count == 0)
            {
                <p class="mb-2">@(Ctx.IsDm ? L["Campaign.Overview.Cast.EmptyDm"] : L["Campaign.Overview.Cast.EmptyPlayer"])</p>
                <a href="@Ctx.BasePath/cast" class="cx-btn cx-plaque cx-sm" data-testid="overview-create-character">@(Ctx.IsDm ? L["Campaign.Overview.Cast.AddDm"] : L["Campaign.Overview.Cast.AddPlayer"])</a>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var actor in mine.Take(8))
                    {
                        var hp = ActorSheetSync.PrimaryResource(actor, Ctx.System);
                        <li class="list-row">
                            <div class="row-main">
                                <div class="row-title"><a href="@Ctx.BasePath/actors/@actor.Id">@actor.Name</a></div>
                                <div class="row-sub">@KindLabel(actor.Kind)</div>
                            </div>
                            @if (hp.Max > 0)
                            {
                                <span class="hp-text small">@hp.Current/@hp.Max @hp.Label</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        @if (recent.Count > 0)
        {
            <section class="panel" aria-labelledby="recent-heading" data-testid="overview-recent">
                <div class="panel-title">
                    <h2 id="recent-heading">@L["Campaign.Overview.RecentPages"]</h2>
                    <a href="@Ctx.BasePath/wiki" class="cx-btn cx-etched cx-sm">@L["Campaign.Overview.OpenWiki"]</a>
                </div>
                <ul class="list-unstyled mb-0">
                    @foreach (var wp in recent)
                    {
                        <li class="list-row">
                            <div class="row-main">
                                <div class="row-title"><a class="wiki-link" href="@Ctx.BasePath/wiki/@wp.Slug">@wp.Title</a></div>
                                <div class="row-sub">@L[$"Campaign.Wiki.Kind.{wp.Kind}"]</div>
                            </div>
                            <span class="small-muted"><LocalTime Value="wp.UpdatedAt" Format="d MMM" /></span>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <div class="col-lg-4">
        <section class="panel" aria-labelledby="table-heading">
            <div class="panel-title"><h2 id="table-heading">@L["Campaign.Overview.Table"]</h2></div>
            @if (RuntimeManager.TryGet(Ctx.Campaign.Id) != null)
            {
                <p class="mb-2"><span class="pill pill-success me-2"><span class="live-dot" aria-hidden="true"></span>@L["Campaign.Overview.Live"]</span> @L["Campaign.Overview.TableRunning"]</p>
                <a href="@Ctx.BasePath/table" class="cx-btn cx-plaque cx-sm w-100">@L["Campaign.Overview.JoinTable"]</a>
            }
            else
            {
                <p class="mb-2 small-muted">@L["Campaign.Overview.NoSessionRunning"]</p>
                <a href="@Ctx.BasePath/table" class="cx-btn cx-etched cx-sm w-100">@(Ctx.IsDm ? L["Campaign.Overview.GoToTable"] : L["Campaign.Overview.WaitAtTable"])</a>
            }
            @if (latestSession != null)
            {
                <hr />
                <div class="small-muted">@L["Campaign.Overview.LatestSession"]</div>
                <a href="@Ctx.BasePath/sessions/@latestSession.Id">@(string.IsNullOrWhiteSpace(latestSession.Title) ? Clock.Format(latestSession.Date, "d MMM yyyy") : latestSession.Title)</a>
                <span class="pill ms-1">@StatusLabel(latestSession.Status)</span>
            }
        </section>

        <section class="panel" aria-labelledby="members-heading">
            <div class="panel-title"><h2 id="members-heading">@L["Campaign.Overview.Members", members.Count]</h2></div>
            <ul class="list-unstyled mb-0">
                @foreach (var member in members)
                {
                    <li class="list-row">
                        <span>@usernames.GetValueOrDefault(member.UserId, member.UserId)</span>
                        <span class="pill @(member.Role == CampaignRole.DM ? "pill-accent" : "")">@RoleLabel(member.Role)</span>
                    </li>
                }
            </ul>
            @if (Ctx.IsDm)
            {
                <hr />
                <label for="invite-link" class="field-label">@InviteLabel</label>
                <div class="input-group input-group-sm">
                    <input id="invite-link" class="field-input" readonly value="@InviteLink" data-testid="invite-link" />
                    <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => CopyInviteAsync(InviteLink)" aria-label="@L["Campaign.Overview.CopyInvite"]"><LucideIcon IconName="copy" Size="14" /></CodexButton>
                </div>
                @if (RemoteInviteLink is { } remoteLink)
                {
                    <label for="invite-link-remote" class="field-label mt-2">@L["Campaign.Overview.InviteLinkTailscale"]</label>
                    <div class="input-group input-group-sm">
                        <input id="invite-link-remote" class="field-input" readonly value="@remoteLink" data-testid="invite-link-remote" />
                        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="() => CopyInviteAsync(remoteLink)" aria-label="@L["Campaign.Overview.CopyInvite"]"><LucideIcon IconName="copy" Size="14" /></CodexButton>
                    </div>
                }
                <div class="field-hint">@L["Campaign.Overview.InviteHint"]</div>
            }
        </section>
    </div>
</div>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private Dictionary<string, string> usernames = new();
    // Who is in the campaign as stored now: a player who joined from the invite link since this campaign was opened is
    // missing from the context's copy, which is loaded once.
    private IReadOnlyList<CampaignMember> members = Array.Empty<CampaignMember>();
    private bool aiReady;
    private SessionDocument? latestSession;
    private List<WikiPageDocument> recent = new();
    // The DM's first steps in a new campaign, while some are left and the list is not put away.
    private List<SetupStep>? setup;

    private sealed record SetupStep(string Key, bool Done, string? Href);

    private string InviteLink => Codex.Web.Services.InviteLinks.Build(Nav.BaseUri, Config["Codex:PublicUrl"], Ctx.Campaign.InviteCode);

    private string? RemoteInviteLink => Codex.Web.Services.InviteLinks.BuildRemote(Config["Codex:RemoteUrl"], Ctx.Campaign.InviteCode);

    private string InviteLabel => RemoteInviteLink is null ? L["Campaign.Overview.InviteLink"] : L["Campaign.Overview.InviteLinkNetwork"];

    protected override async Task OnParametersSetAsync()
    {
        var stored = await CampaignRepo.GetAsync(Ctx.Campaign.Id) ?? Ctx.Campaign;
        members = stored.Members;
        usernames = await MemberNames.LoadAsync(UserRepo, stored);
        var sessions = (await SessionRepo.GetAllForCampaignAsync(Ctx.Campaign.Id)).ToList();
        latestSession = sessions.OrderByDescending(s => s.Date).FirstOrDefault();
        var pages = (await WikiRepo.GetVisibleForCampaignAsync(Ctx.Access)).ToList();
        recent = pages.OrderByDescending(p => p.UpdatedAt).Take(5).ToList();
        setup = null;
        if (Ctx.IsDm && !stored.SetupDismissed)
        {
            // Each step is done by what it asks for, however it came about: by hand, by the world builder (its pages, the
            // places it puts on the map, the people it adds to the cast) or by restoring a backup.
            var regions = await RegionRepo.GetVisibleForCampaignAsync(Ctx.Access);
            var steps = new List<SetupStep>
            {
                new("Describe", !string.IsNullOrWhiteSpace(stored.Description) || !string.IsNullOrWhiteSpace(stored.Tagline), $"{Ctx.BasePath}/settings"),
                new("Invite", members.Any(m => m.Role != CampaignRole.DM), null),
                new("Cast", Ctx.Actors.Any(a => a.Kind != ActorKind.PlayerCharacter), $"{Ctx.BasePath}/cast"),
                new("Page", pages.Count > 0, $"{Ctx.BasePath}/wiki/new"),
                new("Place", regions.Any(r => r.Locations.Count > 0), $"{Ctx.BasePath}/world"),
                new("Session", sessions.Count > 0, $"{Ctx.BasePath}/sessions")
            };
            if (steps.Any(s => !s.Done))
            {
                setup = steps;
                aiReady = await Ai.IsConfiguredAsync(Ctx.UserId);
            }
            else
            {
                // All done: the list is put away for good, so deleting the only page later does not bring it back.
                await DismissSetupAsync();
            }
        }
    }

    private async Task DismissSetupAsync()
    {
        if (!Ctx.IsDm) return;
        await CampaignRepo.UpdateAsync(Ctx.Campaign.Id, c => c.SetupDismissed = true);
        Ctx.Campaign.SetupDismissed = true;
        setup = null;
    }

    private string KindLabel(ActorKind kind) => kind switch
    {
        ActorKind.PlayerCharacter => L["Campaign.Overview.Kind.PlayerCharacter"],
        ActorKind.NonPlayerCharacter => L["Campaign.Overview.Kind.NonPlayerCharacter"],
        _ => L["Campaign.Overview.Kind.Monster"]
    };

    private string StatusLabel(SessionStatus status) => status switch
    {
        SessionStatus.Live => L["Campaign.Overview.Status.Live"],
        SessionStatus.Completed => L["Campaign.Overview.Status.Completed"],
        _ => L["Campaign.Overview.Status.Planned"]
    };

    private string RoleLabel(CampaignRole role) => role switch
    {
        CampaignRole.DM => L["Campaign.Overview.Role.DM"],
        CampaignRole.Player => L["Campaign.Overview.Role.Player"],
        _ => L["Campaign.Overview.Role.Observer"]
    };

    private async Task CopyInviteAsync(string link)
    {
        var ok = await JS.InvokeAsync<bool>("codex.copyText", link);
        Ctx.Notify(ok ? Flash.Success(L["Campaign.Overview.InviteCopied"]) : Flash.Error(L["Campaign.Overview.CopyFailed"]));
    }

    // The checklist's invite step: copies the link and shows it where it lives on the page, selected, for a DM who would
    // rather send it some other way (or when the browser refuses to copy).
    private async Task InviteAsync()
    {
        await JS.InvokeVoidAsync("codex.selectField", "invite-link");
        var ok = await JS.InvokeAsync<bool>("codex.copyText", InviteLink);
        Ctx.Notify(ok ? Flash.Success(L["Campaign.Setup.InviteCopied"]) : Flash.Error(L["Campaign.Overview.CopyFailed"]));
    }
}
