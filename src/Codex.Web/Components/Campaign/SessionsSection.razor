@using Codex.Persistence
@inject ISessionRepository SessionRepo
@inject Codex.Web.Services.ViewerClock Clock
@inject Codex.Persistence.Runtime.CampaignRuntimeManager RuntimeManager
@inject NavigationManager Nav

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["Campaign.Sessions.Title"]</h2>
        <p class="page-subtitle">@L["Campaign.Sessions.Subtitle"]</p>
    </div>
</div>

<div class="row g-3">
    <div class="@(Ctx.IsDm ? "col-lg-8" : "col-12")">
        @if (sessions == null)
        {
            <LoadingSkeleton />
        }
        else if (sessions.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon"><LucideIcon IconName="calendar" Size="28" /></div>
                <h3>@L["Campaign.Sessions.Empty.Title"]</h3>
                <p>@(Ctx.IsDm ? L["Campaign.Sessions.Empty.Dm"] : L["Campaign.Sessions.Empty.Player"])</p>
            </div>
        }
        else
        {
            <ul class="list-unstyled mb-0" data-testid="session-list">
                @foreach (var session in sessions)
                {
                    <li class="list-row">
                        <div class="row-main">
                            <div class="row-title"><a href="@Ctx.BasePath/sessions/@session.Id">@(string.IsNullOrWhiteSpace(session.Title) ? Clock.Format(session.Date, "d MMM yyyy") : session.Title)</a></div>
                            <div class="row-sub"><LocalTime Value="session.Date" Format="dddd d MMM yyyy" /> · @L["Campaign.Sessions.EventCount", session.Events.Count]</div>
                        </div>
                        <span class="pill @(session.Status == SessionStatus.Live ? "pill-success" : "")">@StatusLabel(session.Status)</span>
                        @if (Ctx.IsDm)
                        {
                            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="ms-2" data-testid="run-session" OnClick="() => RunAtTableAsync(session)">@RunLabel(session)</CodexButton>
                        }
                    </li>
                }
            </ul>
        }
    </div>
    @if (Ctx.IsDm)
    {
        <div class="col-lg-4">
            <section class="panel" aria-labelledby="plan-heading">
                <div class="panel-title"><h3 id="plan-heading">@L["Campaign.Sessions.Plan.Title"]</h3></div>
                <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
                    <div class="mb-2">
                        <label for="session-title" class="field-label">@L["Campaign.Sessions.Plan.TitleLabel"]</label>
                        <input id="session-title" class="field-input" @bind="newTitle" placeholder="@L["Campaign.Sessions.Plan.TitlePlaceholder"]" data-testid="new-session-title" />
                    </div>
                    <div class="mb-3">
                        <label for="session-date" class="field-label">@L["Campaign.Sessions.Plan.Date"]</label>
                        <input id="session-date" type="date" class="field-input" @bind="newDate" />
                    </div>
                    <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Class="w-100" data-testid="new-session-add">@L["Campaign.Sessions.Plan.Add"]</CodexButton>
                </form>
            </section>
        </div>
    }
</div>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private List<SessionDocument>? sessions;
    private string newTitle = string.Empty;
    private DateTime newDate = DateTime.Today;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        sessions = (await SessionRepo.GetAllForCampaignAsync(Ctx.Campaign.Id)).OrderByDescending(s => s.Date).ToList();

    private string RunLabel(SessionDocument session) =>
        RuntimeManager.TryGet(Ctx.Campaign.Id)?.ActiveSession?.Id == session.Id ? L["Campaign.Sessions.Run.GoTo"]
        : session.Status == SessionStatus.Completed ? L["Campaign.Sessions.Run.Reopen"] : L["Campaign.Sessions.Run.Start"];

    private string StatusLabel(SessionStatus status) => status switch
    {
        SessionStatus.Live => L["Campaign.Sessions.Status.Live"],
        SessionStatus.Completed => L["Campaign.Sessions.Status.Completed"],
        _ => L["Campaign.Sessions.Status.Planned"]
    };

    /// <summary>Starts the table on this session (a planned one begins, a completed one reopens) and goes there.</summary>
    private async Task RunAtTableAsync(SessionDocument session)
    {
        try
        {
            await RuntimeManager.GetOrStartAsync(Ctx.Campaign, Ctx.Access, session.Id);
            Nav.NavigateTo($"{Ctx.BasePath}/table");
        }
        catch (InvalidOperationException ex)
        {
            Ctx.Notify(Flash.Error(L.Describe(ex)));
        }
    }

    private async Task CreateAsync()
    {
        var session = new SessionDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = Ctx.Campaign.Id,
            Title = newTitle.Trim(),
            Date = DateTime.SpecifyKind(newDate, DateTimeKind.Local).ToUniversalTime(),
            Status = SessionStatus.Planned
        };
        await SessionRepo.SaveAsync(session);
        newTitle = string.Empty;
        Ctx.Notify(Flash.Success(L["Campaign.Sessions.Planned"]));
        await LoadAsync();
    }
}
