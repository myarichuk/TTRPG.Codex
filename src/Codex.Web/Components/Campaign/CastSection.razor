@using Codex.Core
@using Codex.Core.AI
@using Codex.Core.Systems
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject IActorRepository ActorRepo
@inject Codex.Persistence.Runtime.CampaignRuntimeManager RuntimeManager
@inject IContentRegistry Registry
@inject ComponentRegistry Components
@inject CampaignLibrary Library
@inject CastService Cast
@inject AiFeatures Ai
@inject ILogger<CastSection> Logger
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IUserRepository UserRepo

@{
    var pcs = Ctx.Actors.Where(a => a.Kind == ActorKind.PlayerCharacter).ToList();
    var others = Ctx.Actors.Where(a => a.Kind != ActorKind.PlayerCharacter).ToList();
}

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["Campaign.Cast.Title"]</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? L["Campaign.Cast.Subtitle.Dm"] : L["Campaign.Cast.Subtitle.Player"])</p>
    </div>
    <div class="row-actions">
        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="OpenCreateAsync" data-testid="create-character">
            <LucideIcon IconName="user-plus" Size="18" /> @(Ctx.IsDm ? L["Campaign.Cast.NewDm"] : L["Campaign.Cast.NewPlayer"])
        </CodexButton>
        <CodexButton Variant="CodexButtonVariant.Etched" Class="cx-arcane" OnClick="OpenAiCreateAsync" data-testid="create-character-ai">
            <LucideIcon IconName="sparkles" Size="18" /> @L["Campaign.Cast.CreateWithAi"]
        </CodexButton>
        @if (Ctx.IsDm)
        {
            <a href="@Ctx.BasePath/bestiary" class="cx-btn cx-etched"><LucideIcon IconName="paw-print" Size="18" /> @L["Campaign.Cast.Bestiary"]</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <section class="panel" aria-labelledby="pcs-heading">
            <div class="panel-title"><h3 id="pcs-heading"><LucideIcon IconName="crown" Size="18" Class="title-icon" /> @L["Campaign.Cast.PlayerCharacters", pcs.Count]</h3></div>
            @if (pcs.Count == 0)
            {
                <p class="small-muted mb-0">@L["Campaign.Cast.NoPlayerCharacters"]</p>
            }
            <ul class="list-unstyled mb-0" data-testid="pc-list">
                @foreach (var actor in pcs)
                {
                    @ActorRow(actor)
                }
            </ul>
        </section>
    </div>
    <div class="col-lg-6">
        <section class="panel" aria-labelledby="npcs-heading">
            <div class="panel-title"><h3 id="npcs-heading"><LucideIcon IconName="users" Size="18" Class="title-icon" /> @(Ctx.IsDm ? L["Campaign.Cast.Others.Dm", others.Count] : L["Campaign.Cast.Others.Player", others.Count])</h3></div>
            @if (others.Count == 0)
            {
                <p class="small-muted mb-0">@(Ctx.IsDm ? L["Campaign.Cast.OthersEmpty.Dm"] : L["Campaign.Cast.OthersEmpty.Player"])</p>
            }
            <ul class="list-unstyled mb-0" data-testid="npc-list">
                @foreach (var actor in others)
                {
                    @ActorRow(actor)
                }
            </ul>
        </section>
    </div>
</div>

<ConfirmDialog @ref="confirm" />

<dialog id="create-actor-dialog" class="codex-dialog" aria-labelledby="create-actor-title">
    <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
        <div class="dialog-body">
            <h2 id="create-actor-title">@(Ctx.IsDm ? L["Campaign.Cast.NewDm"] : L["Campaign.Cast.NewPlayer"])</h2>
            <div class="mb-3">
                <label for="ca-name" class="field-label">@L["Campaign.Cast.Name"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Campaign.Cast.Required"]</span></label>
                <input id="ca-name" class="field-input" @bind="newName" required maxlength="120" data-testid="create-character-name" />
            </div>
            @if (Ctx.IsDm)
            {
                <div class="mb-3">
                    <label for="ca-kind" class="field-label">@L["Campaign.Cast.Kind"]</label>
                    <select id="ca-kind" class="field-select" @bind="newKind" data-testid="create-character-kind">
                        <option value="@ActorKind.PlayerCharacter">@L["Campaign.Cast.Kind.PlayerCharacter"]</option>
                        <option value="@ActorKind.NonPlayerCharacter">@L["Campaign.Cast.Kind.NonPlayerCharacter"]</option>
                        <option value="@ActorKind.Monster">@L["Campaign.Cast.Kind.Monster"]</option>
                    </select>
                </div>
                @if (newKind == ActorKind.PlayerCharacter)
                {
                    <div class="mb-3">
                        <label for="ca-owner" class="field-label">@L["Campaign.Cast.PlayedBy"]</label>
                        <select id="ca-owner" class="field-select" @bind="newOwnerId">
                            <option value="">@L["Campaign.Cast.Nobody"]</option>
                            @foreach (var member in Ctx.Campaign.Members)
                            {
                                <option value="@member.UserId">@memberNames.GetValueOrDefault(member.UserId, member.UserId)</option>
                            }
                        </select>
                    </div>
                }
            }
            <p class="field-hint">@L["Campaign.Cast.SheetHint"]</p>
            @if (createError != null)
            {
                <p class="text-danger mb-0 mt-2" role="alert">@createError</p>
            }
        </div>
        <div class="dialog-actions">
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseCreateAsync">@L["Common.Cancel"]</CodexButton>
            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="create-character-submit">@L["Campaign.Cast.Create"]</CodexButton>
        </div>
    </form>
</dialog>

<dialog id="ai-actor-dialog" class="codex-dialog" aria-labelledby="ai-actor-title">
    <form @onsubmit="CreateWithAiAsync" @onsubmit:preventDefault="true">
        <div class="dialog-body">
            <h2 id="ai-actor-title"><LucideIcon IconName="sparkles" Size="18" Class="title-icon" /> @L["Campaign.Cast.CreateWithAi"]</h2>
            <p class="small-muted">@L["Campaign.Cast.Ai.Hint"]</p>
            <div class="mb-3">
                <label for="ai-concept" class="field-label">@L["Campaign.Cast.Ai.Concept"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Campaign.Cast.Required"]</span></label>
                <textarea id="ai-concept" class="field-input" rows="3" required @bind="aiConcept" placeholder="@L["Campaign.Cast.Ai.Placeholder"]" data-testid="ai-concept"></textarea>
            </div>
            @if (Ctx.IsDm)
            {
                <div class="mb-3">
                    <label for="ai-kind" class="field-label">@L["Campaign.Cast.Kind"]</label>
                    <select id="ai-kind" class="field-select" @bind="aiKind">
                        <option value="@ActorKind.PlayerCharacter">@L["Campaign.Cast.Kind.PlayerCharacter"]</option>
                        <option value="@ActorKind.NonPlayerCharacter">@L["Campaign.Cast.Kind.NonPlayerCharacter"]</option>
                        <option value="@ActorKind.Monster">@L["Campaign.Cast.Kind.Monster"]</option>
                    </select>
                </div>
            }
            @if (aiError != null)
            {
                <p class="text-danger mb-0 mt-2" role="alert">@aiError</p>
            }
        </div>
        <div class="dialog-actions">
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseAiCreateAsync" Disabled="@aiBusy">@L["Common.Cancel"]</CodexButton>
            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Disabled="@aiBusy" data-testid="ai-create-submit">@(aiBusy ? L["Campaign.Cast.Ai.Generating"] : L["Campaign.Cast.Ai.Generate"])</CodexButton>
        </div>
    </form>
</dialog>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private ConfirmDialog confirm = null!;
    private string newName = string.Empty;
    private ActorKind newKind = ActorKind.NonPlayerCharacter;
    private string newOwnerId = string.Empty;
    // Usernames for the DM's "Played by" picker, loaded when the create dialog opens.
    private Dictionary<string, string> memberNames = new();
    private string? createError;
    private string aiConcept = string.Empty;
    private ActorKind aiKind = ActorKind.PlayerCharacter;
    private string? aiError;
    private bool aiBusy;

    private RenderFragment ActorRow(ActorDocument actor) => @<li class="list-row" data-testid="actor-row" data-actor-id="@actor.Id">
        <ActorAvatar Actor="actor" DisplayName="@DisplayName(actor)" Size="md" />
        <div class="row-main">
            <div class="row-title">
                <a href="@Ctx.BasePath/actors/@actor.Id">@DisplayName(actor)</a>
                @if (actor.OwnerUserId == Ctx.UserId)
                {
                    <span class="pill pill-accent ms-1">@L["Campaign.Cast.Mine"]</span>
                }
                @if (Ctx.IsDm && actor.Visibility != ActorVisibility.Known)
                {
                    <span class="pill pill-warning ms-1">@(actor.Visibility == ActorVisibility.Hidden ? L["Campaign.Cast.HiddenFromPlayers"] : L["Campaign.Cast.IdentityUnknown"])</span>
                }
            </div>
            <div class="row-sub">@Summary(actor)</div>
        </div>
        @if (Ctx.IsDm)
        {
            <div class="row-actions">
                @if (actor.Visibility != ActorVisibility.Known)
                {
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => SetVisibilityAsync(actor, ActorVisibility.Known)" aria-label="@L["Campaign.Cast.RevealLabel", actor.Name]"><LucideIcon IconName="eye" Size="14" /> @L["Campaign.Cast.Reveal"]</CodexButton>
                }
                else if (actor.Kind != ActorKind.PlayerCharacter)
                {
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => SetVisibilityAsync(actor, ActorVisibility.Hidden)" aria-label="@L["Campaign.Cast.HideLabel", actor.Name]"><LucideIcon IconName="eye-off" Size="14" /> @L["Campaign.Cast.Hide"]</CodexButton>
                }
                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@L["Campaign.Cast.DeleteLabel", actor.Name]" OnClick="() => DeleteAsync(actor)" />
            </div>
        }
        else if (actor.Kind == ActorKind.PlayerCharacter && actor.OwnerUserId == Ctx.UserId)
        {
            <div class="row-actions">
                <a href="@Ctx.BasePath/actors/@actor.Id" class="cx-btn cx-etched cx-sm"><LucideIcon IconName="edit-3" Size="14" /> @L["Campaign.Cast.EditSheet"]</a>
                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@L["Campaign.Cast.RetireLabel", actor.Name]" title="@L["Campaign.Cast.RetireTitle"]" OnClick="() => DeleteAsync(actor)" data-testid="retire-character" />
            </div>
        }
    </li>;

    private string DisplayName(ActorDocument actor) => actor.NameFor(Ctx.IsDm);

    private string Summary(ActorDocument actor)
    {
        var parts = new List<string>();
        var hp = ActorSheetSync.PrimaryResource(actor, Ctx.System);
        foreach (var key in new[] { "level", "species", "class" })
        {
            var value = YamlValues.GetString(actor.Sheet, key);
            if (!string.IsNullOrWhiteSpace(value))
            {
                parts.Add(key == "level" ? L["Campaign.Cast.Level", value] : Registry.GetEntry(Ctx.Campaign.SystemId, key, value)?.Name ?? value);
            }
        }

        if (hp.Max > 0 && (Ctx.IsDm || actor.OwnerUserId == Ctx.UserId))
        {
            parts.Add($"{hp.Current}/{hp.Max} {hp.Label}");
        }

        if (!string.IsNullOrEmpty(actor.BlueprintId))
        {
            parts.Add(Registry.ActorName(actor.BlueprintId, L.Culture.Name) is { } from ? L["Campaign.Cast.From", from] : L["Campaign.Cast.MissingContent", actor.BlueprintId]);
        }

        return parts.Count == 0 ? KindLabel(actor.Kind) : string.Join(" · ", parts);
    }

    private string KindLabel(ActorKind kind) => kind switch
    {
        ActorKind.PlayerCharacter => L["Campaign.Cast.Kind.PlayerCharacter"],
        ActorKind.NonPlayerCharacter => L["Campaign.Cast.Kind.NonPlayerCharacter"],
        _ => L["Campaign.Cast.Kind.Monster"]
    };

    private async Task OpenCreateAsync()
    {
        createError = null;
        newName = string.Empty;
        newKind = Ctx.IsDm ? ActorKind.NonPlayerCharacter : ActorKind.PlayerCharacter;
        newOwnerId = Ctx.IsDm ? string.Empty : Ctx.UserId;
        if (Ctx.IsDm) memberNames = await MemberNames.LoadAsync(UserRepo, Ctx.Campaign);
        await JS.InvokeVoidAsync("codex.showModal", "create-actor-dialog");
        await JS.InvokeVoidAsync("codex.focus", "ca-name");
    }

    private Task CloseCreateAsync() => JS.InvokeVoidAsync("codex.closeModal", "create-actor-dialog").AsTask();

    private async Task OpenAiCreateAsync()
    {
        aiError = null;
        aiKind = Ctx.IsDm ? ActorKind.NonPlayerCharacter : ActorKind.PlayerCharacter;
        await JS.InvokeVoidAsync("codex.showModal", "ai-actor-dialog");
        await JS.InvokeVoidAsync("codex.focus", "ai-concept");
    }

    private Task CloseAiCreateAsync() => JS.InvokeVoidAsync("codex.closeModal", "ai-actor-dialog").AsTask();

    private ActorDocument NewActor(string name, ActorKind requestedKind, string? ownerId)
    {
        var kind = Ctx.IsDm ? requestedKind : ActorKind.PlayerCharacter;
        var actor = new ActorDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = Ctx.Campaign.Id,
            Kind = kind,
            Name = name.Trim(),
            OwnerUserId = kind == ActorKind.PlayerCharacter ? (Ctx.IsDm ? (string.IsNullOrEmpty(ownerId) ? null : ownerId) : Ctx.UserId) : null,
            Visibility = kind == ActorKind.PlayerCharacter ? ActorVisibility.Known : ActorVisibility.Hidden
        };

        Cast.SeedDefaults(actor, Ctx.Campaign.SystemId);
        return actor;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = L["Campaign.Cast.NameNeeded"];
            return;
        }

        var actor = NewActor(newName, newKind, newOwnerId);
        if (Ctx.System != null)
        {
            // Rule-driven systems start the sheet on the default attribute method (point buy at the
            // minimum, say) rather than the attributes' plain defaults.
            new Codex.Core.Rules.SheetRuleEngine(Ctx.System, Codex.Core.Rules.NullEntryResolver.Instance).InitializeSheet(actor.Sheet);
        }

        ActorSheetSync.ApplySheetToState(actor, Ctx.System, Components);

        if (!await RuntimeManager.TryCreateActorAsync(actor, Ctx.Access))
        {
            createError = L["Campaign.Cast.OwnOnly"];
            return;
        }

        await CloseCreateAsync();
        Nav.NavigateTo($"{Ctx.BasePath}/actors/{actor.Id}");
    }

    private async Task CreateWithAiAsync()
    {
        if (string.IsNullOrWhiteSpace(aiConcept) || aiBusy) return;
        aiBusy = true;
        aiError = null;
        try
        {
            var draft = await Ai.CreateCharacterAsync(aiConcept, Ctx.IsDm ? aiKind : ActorKind.PlayerCharacter, Ctx.Campaign, Ctx.System, Ctx.UserId,
                async type => (await Library.OptionsAsync(Ctx.Campaign, Ctx.Access, type, L.Culture.Name)).Select(i => (i.Entry.Id, i.Entry.Name)).ToList());

            var actor = NewActor(draft.Name, aiKind, Ctx.IsDm ? null : Ctx.UserId);
            foreach (var (key, value) in draft.Sheet)
            {
                actor.Sheet[key] = value;
            }

            actor.Biography = draft.Biography;
            ActorSheetSync.ApplySheetToState(actor, Ctx.System, Components);

            if (!await RuntimeManager.TryCreateActorAsync(actor, Ctx.Access))
            {
                aiError = L["Campaign.Cast.OwnOnly"];
                return;
            }

            await CloseAiCreateAsync();
            aiConcept = string.Empty;
            Ctx.Notify(Flash.Success(L["Campaign.Cast.AiReady", actor.Name]));
            Nav.NavigateTo($"{Ctx.BasePath}/actors/{actor.Id}");
        }
        catch (AiNotConfiguredException)
        {
            aiError = L["Campaign.Cast.NoAi"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI character creation failed");
            aiError = L["Campaign.Cast.AiFailed", L.Describe(ex)];
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task SetVisibilityAsync(ActorDocument actor, ActorVisibility visibility)
    {
        // A field-level patch: this list's copy of the actor may be minutes old, and saving it whole
        // would write back the hit points the table has changed since.
        if (Ctx.IsDm && actor.CampaignId == Ctx.Campaign.Id && await ActorRepo.UpdateAsync(actor.Id, stored => stored.Visibility = visibility) != null)
        {
            Ctx.Notify(Flash.Success(visibility == ActorVisibility.Known ? L["Campaign.Cast.NowVisible", actor.Name] : L["Campaign.Cast.NowHidden", actor.Name]));
            await Ctx.ReloadAsync();
        }
    }

    private async Task DeleteAsync(ActorDocument actor)
    {
        var retiring = !Ctx.IsDm;
        var ok = await confirm.ShowAsync(
            retiring ? L["Campaign.Cast.RetireQ", actor.Name] : L["Campaign.Cast.DeleteQ", actor.Name],
            retiring ? L["Campaign.Cast.RetireBody"] : L["Campaign.Cast.DeleteBody"],
            retiring ? L["Campaign.Cast.Retire"] : L["Campaign.Cast.Delete"], isDestructive: true);
        if (!ok)
        {
            return;
        }

        if (await RuntimeManager.TryDeleteActorAsync(actor.Id, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(retiring ? L["Campaign.Cast.HasRetired", actor.Name] : L["Campaign.Cast.Deleted", actor.Name]));
            await Ctx.ReloadAsync();
        }
        else
        {
            Ctx.Notify(Flash.Error(L["Campaign.Cast.RetireOwnOnly"]));
        }
    }
}
