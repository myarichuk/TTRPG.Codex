@using Codex.Core
@using Codex.Core.AI
@using Codex.Core.Systems
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject IActorRepository ActorRepo
@inject Codex.Persistence.Runtime.CampaignRuntimeManager RuntimeManager
@inject IContentRegistry Registry
@inject ComponentRegistry Components
@inject ISystemCatalog Catalog
@inject CampaignLibrary Library
@inject AiFeatures Ai
@inject ILogger<CastSection> Logger
@inject NavigationManager Nav
@inject IJSRuntime JS

@{
    var pcs = Ctx.Actors.Where(a => a.Kind == ActorKind.PlayerCharacter).ToList();
    var others = Ctx.Actors.Where(a => a.Kind != ActorKind.PlayerCharacter).ToList();
}

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">Cast</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? "Player characters, NPCs and monsters in this campaign." : "The party and everyone it has met.")</p>
    </div>
    <div class="row-actions">
        <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="OpenCreateAsync" data-testid="create-character">
            <LucideIcon IconName="user-plus" Size="18" /> @(Ctx.IsDm ? "New character or NPC" : "Create my character")
        </CodexButton>
        <CodexButton Variant="CodexButtonVariant.Etched" Class="cx-arcane" OnClick="OpenAiCreateAsync" data-testid="create-character-ai">
            <LucideIcon IconName="sparkles" Size="18" /> Create with AI
        </CodexButton>
        @if (Ctx.IsDm)
        {
            <a href="@Ctx.BasePath/bestiary" class="cx-btn cx-etched"><LucideIcon IconName="paw-print" Size="18" /> Bestiary</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <section class="panel" aria-labelledby="pcs-heading">
            <div class="panel-title"><h3 id="pcs-heading"><LucideIcon IconName="crown" Size="18" Class="title-icon" /> Player characters (@pcs.Count)</h3></div>
            @if (pcs.Count == 0)
            {
                <p class="small-muted mb-0">No player characters yet.</p>
            }
            <ul class="list-unstyled mb-0" data-testid="pc-list">
                @foreach (var actor in pcs)
                {
                    @ActorRow(actor)
                }
            </ul>
        </section>
    </div>
    <div class="col-lg-6">
        <section class="panel" aria-labelledby="npcs-heading">
            <div class="panel-title"><h3 id="npcs-heading"><LucideIcon IconName="users" Size="18" Class="title-icon" /> @(Ctx.IsDm ? "NPCs and monsters" : "People and creatures met") (@others.Count)</h3></div>
            @if (others.Count == 0)
            {
                <p class="small-muted mb-0">@(Ctx.IsDm ? "Nobody yet. Add NPCs here or creatures from the Bestiary." : "The party has not met anyone of note yet.")</p>
            }
            <ul class="list-unstyled mb-0" data-testid="npc-list">
                @foreach (var actor in others)
                {
                    @ActorRow(actor)
                }
            </ul>
        </section>
    </div>
</div>

<ConfirmDialog @ref="confirm" />

<dialog id="create-actor-dialog" class="codex-dialog" aria-labelledby="create-actor-title">
    <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
        <div class="dialog-body">
            <h2 id="create-actor-title">@(Ctx.IsDm ? "New character or NPC" : "Create my character")</h2>
            <div class="mb-3">
                <label for="ca-name" class="field-label">Name <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
                <input id="ca-name" class="field-input" @bind="newName" required maxlength="120" data-testid="create-character-name" />
            </div>
            @if (Ctx.IsDm)
            {
                <div class="mb-3">
                    <label for="ca-kind" class="field-label">Kind</label>
                    <select id="ca-kind" class="field-select" @bind="newKind" data-testid="create-character-kind">
                        <option value="@ActorKind.PlayerCharacter">Player character</option>
                        <option value="@ActorKind.NonPlayerCharacter">Non-player character</option>
                        <option value="@ActorKind.Monster">Monster</option>
                    </select>
                </div>
                @if (newKind == ActorKind.PlayerCharacter)
                {
                    <div class="mb-3">
                        <label for="ca-owner" class="field-label">Played by</label>
                        <select id="ca-owner" class="field-select" @bind="newOwnerId">
                            <option value="">— nobody yet —</option>
                            @foreach (var member in Ctx.Campaign.Members)
                            {
                                <option value="@member.UserId">@member.UserId</option>
                            }
                        </select>
                    </div>
                }
            }
            <p class="field-hint">Stats, class, species and the rest are filled in on the character sheet next.</p>
            @if (createError != null)
            {
                <p class="text-danger mb-0 mt-2" role="alert">@createError</p>
            }
        </div>
        <div class="dialog-actions">
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseCreateAsync">Cancel</CodexButton>
            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="create-character-submit">Create</CodexButton>
        </div>
    </form>
</dialog>

<dialog id="ai-actor-dialog" class="codex-dialog" aria-labelledby="ai-actor-title">
    <form @onsubmit="CreateWithAiAsync" @onsubmit:preventDefault="true">
        <div class="dialog-body">
            <h2 id="ai-actor-title"><LucideIcon IconName="sparkles" Size="18" Class="title-icon" /> Create with AI</h2>
            <p class="small-muted">Describe the character in a line or two. The AI fills in the sheet using only classes, species and backgrounds from this campaign's Library, plus a short history you can edit afterwards.</p>
            <div class="mb-3">
                <label for="ai-concept" class="field-label">Concept <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
                <textarea id="ai-concept" class="field-input" rows="3" required @bind="aiConcept" placeholder="e.g. A retired city guard turned reluctant cleric, haunted by a riot she failed to stop. Level 3." data-testid="ai-concept"></textarea>
            </div>
            @if (Ctx.IsDm)
            {
                <div class="mb-3">
                    <label for="ai-kind" class="field-label">Kind</label>
                    <select id="ai-kind" class="field-select" @bind="aiKind">
                        <option value="@ActorKind.PlayerCharacter">Player character</option>
                        <option value="@ActorKind.NonPlayerCharacter">Non-player character</option>
                        <option value="@ActorKind.Monster">Monster</option>
                    </select>
                </div>
            }
            @if (aiError != null)
            {
                <p class="text-danger mb-0 mt-2" role="alert">@aiError</p>
            }
        </div>
        <div class="dialog-actions">
            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CloseAiCreateAsync" Disabled="@aiBusy">Cancel</CodexButton>
            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Disabled="@aiBusy" data-testid="ai-create-submit">@(aiBusy ? "Generating…" : "Generate character")</CodexButton>
        </div>
    </form>
</dialog>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private ConfirmDialog confirm = null!;
    private string newName = string.Empty;
    private ActorKind newKind = ActorKind.NonPlayerCharacter;
    private string newOwnerId = string.Empty;
    private string? createError;
    private string aiConcept = string.Empty;
    private ActorKind aiKind = ActorKind.PlayerCharacter;
    private string? aiError;
    private bool aiBusy;

    private RenderFragment ActorRow(ActorDocument actor) => @<li class="list-row" data-testid="actor-row" data-actor-id="@actor.Id">
        <ActorAvatar Actor="actor" DisplayName="@DisplayName(actor)" Size="md" />
        <div class="row-main">
            <div class="row-title">
                <a href="@Ctx.BasePath/actors/@actor.Id">@DisplayName(actor)</a>
                @if (actor.OwnerUserId == Ctx.UserId)
                {
                    <span class="pill pill-accent ms-1">Mine</span>
                }
                @if (Ctx.IsDm && actor.Visibility != ActorVisibility.Known)
                {
                    <span class="pill pill-warning ms-1">@(actor.Visibility == ActorVisibility.Hidden ? "Hidden from players" : "Identity unknown")</span>
                }
            </div>
            <div class="row-sub">@Summary(actor)</div>
        </div>
        @if (Ctx.IsDm)
        {
            <div class="row-actions">
                @if (actor.Visibility != ActorVisibility.Known)
                {
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => SetVisibilityAsync(actor, ActorVisibility.Known)" aria-label="@($"Reveal {actor.Name} to players")"><LucideIcon IconName="eye" Size="14" /> Reveal</CodexButton>
                }
                else if (actor.Kind != ActorKind.PlayerCharacter)
                {
                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => SetVisibilityAsync(actor, ActorVisibility.Hidden)" aria-label="@($"Hide {actor.Name} from players")"><LucideIcon IconName="eye-off" Size="14" /> Hide</CodexButton>
                }
                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@($"Delete {actor.Name}")" OnClick="() => DeleteAsync(actor)" />
            </div>
        }
        else if (actor.Kind == ActorKind.PlayerCharacter && actor.OwnerUserId == Ctx.UserId)
        {
            <div class="row-actions">
                <a href="@Ctx.BasePath/actors/@actor.Id" class="cx-btn cx-etched cx-sm"><LucideIcon IconName="edit-3" Size="14" /> Edit sheet</a>
                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@($"Retire {actor.Name}")" title="Retire this character" OnClick="() => DeleteAsync(actor)" data-testid="retire-character" />
            </div>
        }
    </li>;

    private string DisplayName(ActorDocument actor) => actor.NameFor(Ctx.IsDm);

    private string Summary(ActorDocument actor)
    {
        var parts = new List<string>();
        var hp = ActorSheetSync.PrimaryResource(actor, Ctx.System);
        foreach (var key in new[] { "level", "species", "class" })
        {
            var value = YamlValues.GetString(actor.Sheet, key);
            if (!string.IsNullOrWhiteSpace(value))
            {
                parts.Add(key == "level" ? $"Level {value}" : Registry.GetEntry(Ctx.Campaign.SystemId, key, value)?.Name ?? value);
            }
        }

        if (hp.Max > 0 && (Ctx.IsDm || actor.OwnerUserId == Ctx.UserId))
        {
            parts.Add($"{hp.Current}/{hp.Max} {hp.Label}");
        }

        if (!string.IsNullOrEmpty(actor.BlueprintId))
        {
            parts.Add(Registry.GetActor(actor.BlueprintId) == null ? "Missing content: " + actor.BlueprintId : "From " + actor.BlueprintId.Split(':').Last());
        }

        return parts.Count == 0 ? actor.Kind.ToString() : string.Join(" · ", parts);
    }

    private async Task OpenCreateAsync()
    {
        createError = null;
        newName = string.Empty;
        newKind = Ctx.IsDm ? ActorKind.NonPlayerCharacter : ActorKind.PlayerCharacter;
        newOwnerId = Ctx.IsDm ? string.Empty : Ctx.UserId;
        await JS.InvokeVoidAsync("codex.showModal", "create-actor-dialog");
        await JS.InvokeVoidAsync("codex.focus", "ca-name");
    }

    private Task CloseCreateAsync() => JS.InvokeVoidAsync("codex.closeModal", "create-actor-dialog").AsTask();

    private async Task OpenAiCreateAsync()
    {
        aiError = null;
        aiKind = Ctx.IsDm ? ActorKind.NonPlayerCharacter : ActorKind.PlayerCharacter;
        await JS.InvokeVoidAsync("codex.showModal", "ai-actor-dialog");
        await JS.InvokeVoidAsync("codex.focus", "ai-concept");
    }

    private Task CloseAiCreateAsync() => JS.InvokeVoidAsync("codex.closeModal", "ai-actor-dialog").AsTask();

    private ActorDocument NewActor(string name, ActorKind requestedKind, string? ownerId)
    {
        var kind = Ctx.IsDm ? requestedKind : ActorKind.PlayerCharacter;
        var actor = new ActorDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = Ctx.Campaign.Id,
            Kind = kind,
            Name = name.Trim(),
            OwnerUserId = kind == ActorKind.PlayerCharacter ? (Ctx.IsDm ? (string.IsNullOrEmpty(ownerId) ? null : ownerId) : Ctx.UserId) : null,
            Visibility = kind == ActorKind.PlayerCharacter ? ActorVisibility.Known : ActorVisibility.Hidden
        };

        // Seed the sheet with the system's defaults so the first sheet view isn't a wall of blanks.
        var schema = Catalog.GetUISchemas(Ctx.Campaign.SystemId).FirstOrDefault(s => s.EntityType == DataDrivenSystemPlugin.ActorSchemaType);
        foreach (var field in schema?.Fields ?? new List<FieldDefinition>())
        {
            if (field.DefaultValue != null)
            {
                actor.Sheet[field.Key] = field.DefaultValue is int i ? (long)i : field.DefaultValue;
            }
        }

        return actor;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = "Give them a name.";
            return;
        }

        var actor = NewActor(newName, newKind, newOwnerId);
        if (Ctx.System != null)
        {
            // Rule-driven systems start the sheet on the default attribute method (point buy at the
            // minimum, say) rather than the attributes' plain defaults.
            new Codex.Core.Rules.SheetRuleEngine(Ctx.System, Codex.Core.Rules.NullEntryResolver.Instance).InitializeSheet(actor.Sheet);
        }

        ActorSheetSync.ApplySheetToState(actor, Ctx.System, Components);

        if (!await RuntimeManager.TryCreateActorAsync(actor, Ctx.Access))
        {
            createError = "You can only create a character you own.";
            return;
        }

        await CloseCreateAsync();
        Nav.NavigateTo($"{Ctx.BasePath}/actors/{actor.Id}");
    }

    private async Task CreateWithAiAsync()
    {
        if (string.IsNullOrWhiteSpace(aiConcept) || aiBusy) return;
        aiBusy = true;
        aiError = null;
        try
        {
            var draft = await Ai.CreateCharacterAsync(aiConcept, Ctx.IsDm ? aiKind : ActorKind.PlayerCharacter, Ctx.Campaign, Ctx.System, Ctx.UserId,
                async type => (await Library.OptionsAsync(Ctx.Campaign, Ctx.Access, type)).Select(i => (i.Entry.Id, i.Entry.Name)).ToList());

            var actor = NewActor(draft.Name, aiKind, Ctx.IsDm ? null : Ctx.UserId);
            foreach (var (key, value) in draft.Sheet)
            {
                actor.Sheet[key] = value;
            }

            actor.Biography = draft.Biography;
            ActorSheetSync.ApplySheetToState(actor, Ctx.System, Components);

            if (!await RuntimeManager.TryCreateActorAsync(actor, Ctx.Access))
            {
                aiError = "You can only create a character you own.";
                return;
            }

            await CloseAiCreateAsync();
            aiConcept = string.Empty;
            Ctx.Notify(Flash.Success($"{actor.Name} is ready. Check the sheet and adjust anything the AI got wrong."));
            Nav.NavigateTo($"{Ctx.BasePath}/actors/{actor.Id}");
        }
        catch (AiNotConfiguredException)
        {
            aiError = "No AI provider is set up. Add one under AI settings (top right).";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI character creation failed");
            aiError = "The AI could not produce a character: " + ex.Message;
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task SetVisibilityAsync(ActorDocument actor, ActorVisibility visibility)
    {
        // A field-level patch: this list's copy of the actor may be minutes old, and saving it whole
        // would write back the hit points the table has changed since.
        if (Ctx.IsDm && actor.CampaignId == Ctx.Campaign.Id && await ActorRepo.UpdateAsync(actor.Id, stored => stored.Visibility = visibility) != null)
        {
            Ctx.Notify(Flash.Success(visibility == ActorVisibility.Known ? $"{actor.Name} is now visible to players." : $"{actor.Name} is hidden from players."));
            await Ctx.ReloadAsync();
        }
    }

    private async Task DeleteAsync(ActorDocument actor)
    {
        var retiring = !Ctx.IsDm;
        var ok = await confirm.ShowAsync(
            retiring ? $"Retire {actor.Name}?" : $"Delete {actor.Name}?",
            retiring ? "Your character and their sheet are removed from this campaign. This cannot be undone; the DM can't restore them either." : "Their sheet and state are removed from this campaign. This cannot be undone.",
            retiring ? "Retire" : "Delete", isDestructive: true);
        if (!ok)
        {
            return;
        }

        if (await RuntimeManager.TryDeleteActorAsync(actor.Id, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(retiring ? $"{actor.Name} has retired." : $"Deleted {actor.Name}."));
            await Ctx.ReloadAsync();
        }
        else
        {
            Ctx.Notify(Flash.Error("You can only retire a character you own."));
        }
    }
}
