@using Codex.Core
@using Codex.Persistence
@inject IJSRuntime JS

@* The DM's list of a page's secrets beside the page: who may read each, when it was revealed, its players' version, and
   the reveal, hide and players' version buttons. The section does the changing (OnReveal, OnHide, OnWritePlayersVersion). *@
<section class="panel" aria-labelledby="wiki-secrets-heading" data-testid="wiki-secrets">
    <div class="panel-title"><h3 id="wiki-secrets-heading" class="h6"><LucideIcon IconName="eye-off" Size="14" Class="title-icon" /> @L["Campaign.Wiki.Secrets"]</h3></div>
    @if (Page.Visibility == WikiVisibility.DmOnly)
    {
        <p class="field-hint">@L["Campaign.Wiki.Secrets.PageHidden"]</p>
    }
    <ul class="secret-list">
        @foreach (var block in Secrets)
        {
            <li class="secret-item secret-item-@block.Marked.ToString().ToLowerInvariant()" data-testid="wiki-secret-@block.Block">
                <button type="button" class="secret-item-text" @onclick="@(() => JS.InvokeVoidAsync("codex.scrollToId", $"secret-{block.Block}"))">@Preview(block)</button>
                <div class="secret-item-meta">
                    <SecretStatusPill Block="block" Knowers="@KnowerNames(block.Knowers)" />
                    @if (block.RevealedAt is { } at && block.Marked != SecretAudience.Dm)
                    {
                        <span><LocalTime Value="at" Format="d MMM, HH:mm" /></span>
                    }
                </div>
                @if (block.Marked == SecretAudience.Dm && SecretText.PlayersVersionOf(Page.Body, block) is { } told)
                {
                    <div class="secret-told" data-testid="@($"wiki-secret-told-{block.Block}")"><LucideIcon IconName="users" Size="12" /><span>@L["Campaign.Wiki.Secrets.Told", Preview(told)]</span></div>
                }
                <div class="secret-item-actions">
                    @if (block.Marked != SecretAudience.Party)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => OnReveal.InvokeAsync((block, block.Marked == SecretAudience.Some))" data-testid="@($"wiki-secret-reveal-{block.Block}")"><LucideIcon IconName="eye" Size="14" /> @L["Campaign.Wiki.Secrets.RevealEllipsis"]</CodexButton>
                    }
                    @if (block.Marked != SecretAudience.Dm)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => OnHide.InvokeAsync(block)" data-testid="@($"wiki-secret-hide-{block.Block}")"><LucideIcon IconName="eye-off" Size="14" /> @L["Common.Secret.Hide"]</CodexButton>
                    }
                    @if (CanHavePlayersVersion(block))
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Class="@(AiReady ? "cx-arcane" : null)" OnClick="() => OnWritePlayersVersion.InvokeAsync(block)"
                                     title="@L["Campaign.Wiki.Secrets.PlayersVersionTitle"]" data-testid="@($"wiki-secret-players-{block.Block}")">
                            <LucideIcon IconName="@(AiReady ? "sparkles" : "users")" Size="14" /> @(SecretText.PlayersVersionOf(Page.Body, block) == null ? L["Campaign.Wiki.Secrets.PlayersVersion"] : L["Campaign.Wiki.Secrets.EditPlayersVersion"])
                        </CodexButton>
                    }
                </div>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired] public WikiPageDocument Page { get; set; } = null!;

    /// <summary>The blocks the DM can reveal or hide on the page.</summary>
    [Parameter] public IReadOnlyList<SecretBlock> Secrets { get; set; } = Array.Empty<SecretBlock>();

    /// <summary>The names of the characters (by id) a block was revealed to.</summary>
    [Parameter, EditorRequired] public Func<IReadOnlyList<string>, string> KnowerNames { get; set; } = null!;

    /// <summary>A block's text in one short line.</summary>
    [Parameter, EditorRequired] public Func<SecretBlock, string> Preview { get; set; } = null!;
    [Parameter] public bool AiReady { get; set; }

    /// <summary>Reveal a block: to the party, or (true) to some characters.</summary>
    [Parameter] public EventCallback<(SecretBlock Block, bool ToSome)> OnReveal { get; set; }
    [Parameter] public EventCallback<SecretBlock> OnHide { get; set; }
    [Parameter] public EventCallback<SecretBlock> OnWritePlayersVersion { get; set; }

    /// <summary>A DM block that can be given a players' version: one at the top level of the page (a version inside another
    /// block would be that block's), and closed (a block that runs to the end of the page has no "after").</summary>
    private static bool CanHavePlayersVersion(SecretBlock block) => block is { Marked: SecretAudience.Dm, Depth: 0, ClosingLine: not null };
}
