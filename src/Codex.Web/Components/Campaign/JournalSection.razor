@using Codex.Core
@using Codex.Persistence
@inject IJournalRepository JournalRepo
@inject Codex.Web.Services.ViewerClock Clock
@inject ISessionRepository SessionRepo
@inject MentionSources MentionSources
@inject IJSRuntime JS

@* The player's private notebook for this campaign: one entry per session plus free entries.
   Nobody but the owner can read these - the repository filters by owner in the query. *@

<ConfirmDialog @ref="confirm" />
<UnsavedChangesGuard @ref="guard" IsDirty="IsDirty" />

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["Campaign.Journal.Title"]</h2>
        <p class="page-subtitle">@L["Campaign.Journal.Subtitle"]</p>
    </div>
    <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="StartNew" data-testid="journal-new"><LucideIcon IconName="plus" Size="18" /> @L["Campaign.Journal.NewEntry"]</CodexButton>
</div>

@if (entries == null)
{
    <LoadingSkeleton />
}
else
{
    <div class="row g-3">
        <div class="col-lg-7">
            @if (entries.Count == 0 && editing == null)
            {
                <div class="empty">
                    <div class="empty-icon"><LucideIcon IconName="notebook-pen" Size="28" /></div>
                    <h3>@L["Campaign.Journal.Empty.Title"]</h3>
                    <p>@L["Campaign.Journal.Empty.Body"]</p>
                    <CodexButton Variant="CodexButtonVariant.Plaque" OnClick="StartNew">@L["Campaign.Journal.WriteFirst"]</CodexButton>
                </div>
            }
            @foreach (var entry in entries)
            {
                <article class="panel journal-entry" aria-labelledby="journal-@entry.Id" data-testid="journal-entry">
                    <div class="panel-title">
                        <div>
                            <h3 id="journal-@entry.Id" class="h6 mb-0">@(string.IsNullOrWhiteSpace(entry.Title) ? L["Campaign.Journal.Untitled"] : entry.Title)</h3>
                            <div class="small-muted">
                                <LocalTime Value="entry.UpdatedAt" Format="d MMM yyyy, HH:mm" />
                                @if (entry.SessionId != null && sessionTitles.TryGetValue(entry.SessionId, out var title))
                                {
                                    <span> · <a href="@Ctx.BasePath/sessions/@entry.SessionId">@title</a></span>
                                }
                            </div>
                        </div>
                        <div class="row-actions">
                            <CodexButton Variant="CodexButtonVariant.Rune" Icon="edit-3" Label="@L["Campaign.Journal.EditEntry"]" OnClick="() => StartEdit(entry)" />
                            <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@L["Campaign.Journal.DeleteEntry"]" OnClick="() => DeleteAsync(entry)" data-testid="delete-journal" />
                        </div>
                    </div>
                    <div class="rules-text mb-0">@((MarkupString)MentionLinks.ToHtml(entry.Body, mentions, Ctx.Campaign.Id))</div>
                </article>
            }
        </div>
        <div class="col-lg-5 @(editing != null ? "phone-sheet" : "")">
            @if (editing != null)
            {
                <SheetBar Title="@(editing.Id.Length == 0 ? L["Campaign.Journal.NewEntry"] : L["Campaign.Journal.EditEntry"])" CloseLabel="@L["Campaign.Journal.Cancel"]" OnClose="CancelAsync" />
                <section class="panel panel-journal" id="journal-editor" tabindex="-1" aria-labelledby="journal-editor-heading">
                    <div class="panel-title"><h3 id="journal-editor-heading" class="h6"><LucideIcon IconName="edit-3" Size="14" Class="title-icon" /> @(editing.Id.Length == 0 ? L["Campaign.Journal.NewEntry"] : L["Campaign.Journal.EditEntry"])</h3></div>
                    <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                        <div class="mb-2">
                            <label for="journal-title" class="field-label">@L["Campaign.Journal.Field.Title"]</label>
                            <input id="journal-title" class="field-input" @bind="editing.Title" @bind:event="oninput" maxlength="160" data-testid="journal-title" />
                        </div>
                        <div class="mb-2">
                            <label for="journal-session" class="field-label">@L["Campaign.Journal.Field.Session"]</label>
                            <select id="journal-session" class="field-select" @bind="editing.SessionId">
                                <option value="">@L["Campaign.Journal.General"]</option>
                                @foreach (var (id, title) in sessionTitles)
                                {
                                    <option value="@id">@title</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="journal-text" class="field-label">@L["Campaign.Journal.Field.Text"]</label>
                            <MarkdownEditor Id="journal-text" Title="@(string.IsNullOrWhiteSpace(editing.Title) ? L["Campaign.Journal.Field.Text"] : editing.Title)" Rows="10" @bind-Value="editing.Body"
                                            Mentions="@mentionsJson" DescribedBy="journal-mention-hint" TestId="journal-body"
                                            Preview="@(text => MentionLinks.ToHtml(mentions.Encode(text), mentions, Ctx.Campaign.Id))">
                                <p id="journal-mention-hint" class="field-hint">@L["Campaign.Journal.MentionHint"]</p>
                            </MarkdownEditor>
                        </div>
                        <div class="d-flex gap-2">
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="journal-save">@L["Campaign.Journal.Save"]</CodexButton>
                            <CodexButton Variant="CodexButtonVariant.Etched" OnClick="CancelAsync">@L["Campaign.Journal.Cancel"]</CodexButton>
                        </div>
                    </form>
                </section>
            }
            else
            {
                <section class="panel panel-plain">
                    <p class="small-muted mb-0"><LucideIcon IconName="lock" Size="14" /> @L["Campaign.Journal.PrivacyNote"]</p>
                </section>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private List<JournalEntryDocument>? entries;
    private JournalEntryDocument? editing;
    private readonly Dictionary<string, string> sessionTitles = new();
    private MentionDirectory mentions = MentionDirectory.Empty;
    private string mentionsJson = "[]";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        entries = (await JournalRepo.GetMineAsync(Ctx.Access)).ToList();
        mentions = await MentionSources.DirectoryAsync(Ctx.Campaign, Ctx.Access, Ctx.Actors);
        mentionsJson = MentionLinks.Json(mentions, Ctx.Actors);
        sessionTitles.Clear();
        foreach (var session in (await SessionRepo.GetAllForCampaignAsync(Ctx.Campaign.Id)).OrderByDescending(s => s.Date))
        {
            sessionTitles[session.Id] = string.IsNullOrWhiteSpace(session.Title) ? Clock.Format(session.Date, "d MMM yyyy") : session.Title;
        }
    }

    private UnsavedChangesGuard guard = null!;
    // The open entry as it was when editing started, to tell whether closing it would lose anything.
    private string editingSnapshot = string.Empty;

    private bool IsDirty() => editing != null && Snapshot(editing) != editingSnapshot;

    private static string Snapshot(JournalEntryDocument entry) => string.Join('\u0001', entry.Title, entry.SessionId ?? "", entry.Body);

    private async Task StartNew() => await OpenAsync(new JournalEntryDocument { CampaignId = Ctx.Campaign.Id });

    private async Task StartEdit(JournalEntryDocument entry) => await OpenAsync(new JournalEntryDocument
    {
        Id = entry.Id, CampaignId = entry.CampaignId, OwnerUserId = entry.OwnerUserId, SessionId = entry.SessionId, Title = entry.Title, Body = mentions.ForEditing(entry.Body), CreatedAt = entry.CreatedAt
    });

    private async Task OpenAsync(JournalEntryDocument entry)
    {
        if (!await guard.ConfirmDiscardAsync()) return;
        editing = entry;
        editingSnapshot = Snapshot(entry);
        focusEditor = true;
    }

    // Set when an entry opens, so the editor (a full-screen sheet on a phone) takes focus once it renders.
    private bool focusEditor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusEditor || editing == null) return;
        focusEditor = false;
        await JS.InvokeVoidAsync("codex.focusSheet", "journal-editor");
    }

    private async Task CancelAsync()
    {
        if (await guard.ConfirmDiscardAsync()) editing = null;
    }

    private async Task SaveAsync()
    {
        if (editing == null) return;
        if (string.IsNullOrEmpty(editing.SessionId)) editing.SessionId = null;
        editing.Body = mentions.Encode(editing.Body);
        if (await JournalRepo.TrySaveAsync(editing, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Journal.Saved"]));
            editing = null;
            await LoadAsync();
        }
        else
        {
            Ctx.Notify(Flash.Error(L["Campaign.Journal.SaveFailed"]));
        }
    }

    private ConfirmDialog confirm = null!;

    private async Task DeleteAsync(JournalEntryDocument entry)
    {
        if (!await confirm.ShowAsync(L["Campaign.Journal.Delete.Title"], L["Campaign.Journal.Delete.Body"], L["Campaign.Journal.DeleteEntry"], isDestructive: true)) return;
        if (await JournalRepo.TryDeleteAsync(entry.Id, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Journal.Deleted"]));
            await LoadAsync();
        }
    }
}
