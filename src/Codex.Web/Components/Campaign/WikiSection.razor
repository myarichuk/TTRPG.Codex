    /// <summary>"Region › Area › Town": where the page's place sits, the place itself left out.</summary>
    private static string PlacePath((RegionDocument Region, LocationDocument Place) on) =>
        string.Join(" › ", PlaceTree.Ancestors(on.Region.Locations, on.Place).Select(p => p.Name).Prepend(on.Region.Name));

    private string KindLabel(WikiPageKind kind) => L[$"Campaign.Wiki.Kind.{kind}"];

    private static string KindIcon(WikiPageKind kind) => kind switch
    {
        WikiPageKind.Person => "user",
        WikiPageKind.Place => "map-pin",
        WikiPageKind.Faction => "shield",
        WikiPageKind.Quest => "scroll",
        _ => "book-open"
    };
    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();

    private (RegionDocument Region, LocationDocument Place)? PlaceOf(WikiPageDocument page)
    {
        if (string.IsNullOrEmpty(page.PlaceId)) return null;
        foreach (var region in regions)
        {
            if (region.Locations.FirstOrDefault(l => l.Id == page.PlaceId) is { } place) return (region, place);
        }

        return null;
    }

    /// <summary>The picture a page shows: its place's when it is about one (a place has one picture), else its own.</summary>
    private string? IllustrationOf(WikiPageDocument page) =>
        PlaceOf(page) is { } on ? ArtService.Url(on.Region, on.Place) : ArtService.Url(page);

    private Task<ArtImage> GeneratePageArtAsync(CancellationToken ct)
    {
        var (subjectKind, shape) = draft.Kind switch
        {
            WikiPageKind.Person => ("person", ArtShape.Tall),
            WikiPageKind.Faction => ("faction: its people, colours and emblem", ArtShape.Wide),
            WikiPageKind.Quest => ("scene from an adventure", ArtShape.Wide),
            _ => ("scene, object or idea from a fantasy world", ArtShape.Wide)
        };
        return Art.GenerateAsync(Ctx.UserId, draft.Title, subjectKind, TextFormatting.Summary(mentions.Plain(draft.Body), 300), shape, ct);
    }

    private Task<ArtImage> GenerateArtAsync(CancellationToken ct) =>
        Art.GenerateAsync(Ctx.UserId, draft.Title, "place", TextFormatting.Summary(mentions.Plain(draft.Body), 300), ArtShape.Wide, ct);

    // At the caret the box last had (a textarea keeps its selection when the chip takes focus), as typing it would; the
    // box's input event brings the text back here.
    private async Task InsertLinkAsync(WikiPageDocument target) =>
