@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Microsoft.AspNetCore.WebUtilities
@inject IWikiRepository WikiRepo
@inject INoteRepository NoteRepo
@inject IUserRepository UserRepo
@inject AiFeatures Ai
@inject MentionSources MentionSources
@inject NavigationManager Nav
@inject ILogger<WikiSection> Logger

@* The world wiki: DM-written pages linked with [[Page title]], each DM-only or shared with the
   party; players discuss a page with notes (private to them and the DM, or for the whole party). *@

@if (pages == null)
{
    <LoadingSkeleton />
}
else if (Mode == "edit")
{
    <div class="page-header mb-3">
        <div>
            <nav aria-label="@L["Campaign.Wiki.Breadcrumb"]" class="breadcrumb-nav mb-1"><a href="@Ctx.BasePath/wiki">@L["Campaign.Wiki.Title"]</a>@if (current != null) { <span class="crumb-sep" aria-hidden="true">/</span><a href="@Ctx.BasePath/wiki/@current.Slug">@current.Title</a> }</nav>
            <h2 class="mb-0">@(current == null ? L["Campaign.Wiki.NewPage"] : L["Campaign.Wiki.EditPage", current.Title])</h2>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <section class="panel">
                <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" data-testid="wiki-editor">
                    <div class="field-grid mb-3">
                        <div class="field-wide">
                            <label for="wiki-title" class="field-label">@L["Campaign.Wiki.Field.Title"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Campaign.Wiki.Required"]</span></label>
                            <input id="wiki-title" class="field-input field-lg" @bind="draft.Title" required maxlength="160" data-testid="wiki-title" />
                        </div>
                        <div>
                            <label for="wiki-visibility" class="field-label">@L["Campaign.Wiki.Field.WhoCanRead"]</label>
                            <select id="wiki-visibility" class="field-select" @bind="draft.Visibility" data-testid="wiki-visibility">
                                <option value="@WikiVisibility.DmOnly">@L["Campaign.Wiki.Vis.DmOnly"]</option>
                                <option value="@WikiVisibility.Party">@L["Campaign.Wiki.Vis.Party"]</option>
                            </select>
                        </div>
                        <div>
                            <label for="wiki-tags" class="field-label">@L["Campaign.Wiki.Field.Tags"]</label>
                            <input id="wiki-tags" class="field-input" placeholder="@L["Campaign.Wiki.TagsPlaceholder"]" value="@string.Join(", ", draft.Tags)"
                                   @onchange="e => draft.Tags = (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()" />
                        </div>
                    </div>
                    <label for="wiki-body" class="field-label">@L["Campaign.Wiki.Field.Text"]</label>
                    <textarea id="wiki-body" class="field-input wiki-textarea mb-2" rows="18" @bind="draft.Body" @bind:event="oninput" data-testid="wiki-body" placeholder="@L["Campaign.Wiki.BodyPlaceholder"]"></textarea>
                    <div class="field-hint mb-3">@Rich(L["Campaign.Wiki.SyntaxHint"])</div>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="wiki-save"><LucideIcon IconName="check" Size="18" /> @L["Campaign.Wiki.SavePage"]</CodexButton>
                        <CodexButton Variant="CodexButtonVariant.Etched" Class="cx-arcane" OnClick="ExpandAsync" Disabled="@expanding"><LucideIcon IconName="sparkles" Size="14" /> @(expanding ? L["Campaign.Wiki.Writing"] : L["Campaign.Wiki.ExpandWithAi"])</CodexButton>
                        <a href="@(current == null ? $"{Ctx.BasePath}/wiki" : $"{Ctx.BasePath}/wiki/{current.Slug}")" class="cx-btn cx-etched">@L["Campaign.Wiki.Cancel"]</a>
                        @if (current != null)
                        {
                            <CodexButton Variant="CodexButtonVariant.Blood" Class="ms-auto" OnClick="DeleteAsync">@L["Campaign.Wiki.DeletePage"]</CodexButton>
                        }
                    </div>
                </form>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="panel">
                <div class="panel-title"><h3 class="h6"><LucideIcon IconName="link" Size="14" Class="title-icon" /> @L["Campaign.Wiki.LinkToPage"]</h3></div>
                <p class="small-muted">@L["Campaign.Wiki.ClickToAppend"]</p>
                <div class="chips">
                    @foreach (var wp in pages.Where(p => current == null || p.Id != current.Id).Take(40))
                    {
                        <button type="button" class="chip" @onclick="() => AppendLink(wp)">@wp.Title</button>
                    }
                </div>
                @if (pages.Count == 0)
                {
                    <p class="small-muted mb-0">@Rich(L["Campaign.Wiki.NoOtherPages"])</p>
                }
            </section>
            <section class="panel">
                <div class="panel-title"><h3 class="h6"><LucideIcon IconName="sparkles" Size="14" Class="title-icon" /> @L["Campaign.Wiki.AiInstruction"]</h3></div>
                <label for="wiki-ai-instruction" class="visually-hidden">@L["Campaign.Wiki.AiInstructionLabel"]</label>
                <textarea id="wiki-ai-instruction" class="field-input" rows="3" @bind="aiInstruction" placeholder="@L["Campaign.Wiki.AiInstructionPlaceholder"]"></textarea>
                <p class="field-hint">@L["Campaign.Wiki.AiSees"]</p>
            </section>
        </div>
    </div>
}
else if (Slug != null)
{
    @if (current == null)
    {
        <div class="empty">
            <div class="empty-icon"><LucideIcon IconName="globe" Size="28" /></div>
            <h3>@L["Campaign.Wiki.Missing.Title", Slug]</h3>
            <p>@(Ctx.IsDm ? L["Campaign.Wiki.Missing.Dm"] : L["Campaign.Wiki.Missing.Player"])</p>
            @if (Ctx.IsDm)
            {
                <a href="@Ctx.BasePath/wiki/new?title=@Uri.EscapeDataString(Slug.Replace('-', ' '))" class="cx-btn cx-plaque">@L["Campaign.Wiki.CreateIt"]</a>
            }
            else
            {
                <a href="@Ctx.BasePath/wiki" class="cx-btn cx-etched">@L["Campaign.Wiki.BackToWiki"]</a>
            }
        </div>
    }
    else
    {
        <div class="page-header mb-3">
            <div>
                <nav aria-label="@L["Campaign.Wiki.Breadcrumb"]" class="breadcrumb-nav mb-1"><a href="@Ctx.BasePath/wiki">@L["Campaign.Wiki.Title"]</a><span class="crumb-sep" aria-hidden="true">/</span><span>@current.Title</span></nav>
                <h2 class="mb-0" data-testid="wiki-page-title">@current.Title</h2>
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <span class="pill @(current.Visibility == WikiVisibility.Party ? "pill-success" : "pill-warning")"><LucideIcon IconName="@(current.Visibility == WikiVisibility.Party ? "users" : "eye-off")" Size="14" /> @(current.Visibility == WikiVisibility.Party ? L["Campaign.Wiki.Party"] : L["Campaign.Wiki.DmOnly"])</span>
                    @foreach (var tag in current.Tags)
                    {
                        <span class="pill">@tag</span>
                    }
                    <span class="pill"><LucideIcon IconName="clock" Size="14" /> <LocalTime Value="current.UpdatedAt" Format="d MMM yyyy" /></span>
                </div>
            </div>
            @if (Ctx.IsDm)
            {
                <div class="row-actions">
                    @if (current.Visibility == WikiVisibility.DmOnly)
                    {
                        <CodexButton Variant="CodexButtonVariant.Etched" OnClick="RevealAsync"><LucideIcon IconName="eye" Size="18" /> @L["Campaign.Wiki.SharePage"]</CodexButton>
                    }
                    <a href="@Ctx.BasePath/wiki/@current.Slug/edit" class="cx-btn cx-plaque" data-testid="wiki-edit"><LucideIcon IconName="edit-3" Size="18" /> @L["Campaign.Wiki.Edit"]</a>
                </div>
            }
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <article class="panel wiki-page" data-testid="wiki-page">
                    @if (string.IsNullOrWhiteSpace(current.Body))
                    {
                        <p class="small-muted mb-0">@L["Campaign.Wiki.PageEmpty"]</p>
                    }
                    else
                    {
                        <div class="rules-text wiki-body">@((MarkupString)WikiText.ToHtml(current.Body, ResolveLink, Ctx.IsDm ? CreateLink : null))</div>
                    }
                </article>

                <section class="panel" aria-labelledby="wiki-notes-heading">
                    <div class="panel-title"><h3 id="wiki-notes-heading" class="h6"><LucideIcon IconName="message-square" Size="14" Class="title-icon" /> @L["Campaign.Wiki.NotesOnPage"]</h3></div>
                    @if (notes.Count == 0)
                    {
                        <p class="small-muted">@(Ctx.IsDm ? L["Campaign.Wiki.NoNotes.Dm"] : L["Campaign.Wiki.NoNotes.Player"])</p>
                    }
                    @foreach (var note in notes)
                    {
                        <div class="list-row align-items-start">
                            <span class="avatar avatar-sm" aria-hidden="true">@Initial(usernames.GetValueOrDefault(note.AuthorId, "?"))</span>
                            <div class="row-main">
                                <div class="row-sub"><strong>@usernames.GetValueOrDefault(note.AuthorId, note.AuthorId)</strong> · <LocalTime Value="note.CreatedAt" Format="d MMM, HH:mm" /> · <span class="pill">@(note.Visibility == CommentVisibility.Public ? L["Campaign.Wiki.Party"] : L["Campaign.Wiki.Private"])</span></div>
                                <p class="mb-0 notes-text"><MentionText Text="@note.Content" Mentions="@(mentions ?? MentionDirectory.Empty)" CampaignId="@Ctx.Campaign.Id" /></p>
                            </div>
                            @if (note.AuthorId == Ctx.UserId || Ctx.IsDm)
                            {
                                <CodexButton Variant="CodexButtonVariant.Rune" Class="cx-blood" Icon="trash-2" Label="@L["Campaign.Wiki.DeleteNote"]" OnClick="() => DeleteNoteAsync(note)" />
                            }
                        </div>
                    }
                    <form class="mt-3" @onsubmit="AddNoteAsync" @onsubmit:preventDefault="true">
                        <label for="wiki-note" class="field-label">@L["Campaign.Wiki.AddNoteLabel"]</label>
                        <textarea id="wiki-note" class="field-input mb-2" rows="2" @bind="newNote" @bind:event="oninput" data-mentions="@mentionsJson" aria-describedby="wiki-note-hint" data-testid="wiki-note"></textarea>
                        <p id="wiki-note-hint" class="field-hint">@L["Campaign.Wiki.MentionHint"]</p>
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <label for="wiki-note-visibility" class="visually-hidden">@L["Campaign.Wiki.NoteVisibility"]</label>
                            <select id="wiki-note-visibility" class="field-select field-sm" @bind="newNoteVisibility">
                                <option value="@CommentVisibility.Private">@L["Campaign.Wiki.NoteVis.Private"]</option>
                                <option value="@CommentVisibility.Public">@L["Campaign.Wiki.NoteVis.Public"]</option>
                            </select>
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Small="true">@L["Campaign.Wiki.AddNote"]</CodexButton>
                        </div>
                    </form>
                </section>
            </div>
            <div class="col-lg-4">
                @{
                    var outgoing = current.Links.Select(slug => pages.FirstOrDefault(p => p.Slug == slug)).Where(p => p != null).Cast<WikiPageDocument>().ToList();
                    var incoming = pages.Where(p => p.Links.Contains(current.Slug) && p.Id != current.Id).ToList();
                }
                <section class="panel">
                    <div class="panel-title"><h3 class="h6"><LucideIcon IconName="link" Size="14" Class="title-icon" /> @L["Campaign.Wiki.LinksFrom"]</h3></div>
                    @if (outgoing.Count == 0)
                    {
                        <p class="small-muted mb-0">@L["Campaign.Wiki.None"]</p>
                    }
                    <ul class="link-list mb-0">
                        @foreach (var wp in outgoing)
                        {
                            <li><a href="@Ctx.BasePath/wiki/@wp.Slug">@wp.Title</a></li>
                        }
                    </ul>
                </section>
                <section class="panel">
                    <div class="panel-title"><h3 class="h6"><LucideIcon IconName="arrow-left" Size="14" Class="title-icon" /> @L["Campaign.Wiki.LinksHere"]</h3></div>
                    @if (incoming.Count == 0)
                    {
                        <p class="small-muted mb-0">@L["Campaign.Wiki.NothingLinksHere"]</p>
                    }
                    <ul class="link-list mb-0">
                        @foreach (var wp in incoming)
                        {
                            <li><a href="@Ctx.BasePath/wiki/@wp.Slug">@wp.Title</a></li>
                        }
                    </ul>
                </section>
            </div>
        </div>
    }
}
else
{
    <div class="page-header mb-3">
        <div>
            <h2 class="mb-0">@L["Campaign.Wiki.Title"]</h2>
            <p class="page-subtitle">@(Ctx.IsDm ? L["Campaign.Wiki.Subtitle.Dm"] : L["Campaign.Wiki.Subtitle.Player"])</p>
        </div>
        @if (Ctx.IsDm)
        {
            <a href="@Ctx.BasePath/wiki/new" class="cx-btn cx-plaque" data-testid="wiki-new"><LucideIcon IconName="plus" Size="18" /> @L["Campaign.Wiki.NewPageBtn"]</a>
        }
    </div>

    <div class="toolbar">
        <div class="search">
            <LucideIcon IconName="search" Size="18" Class="search-icon" />
            <label for="wiki-search" class="visually-hidden">@L["Campaign.Wiki.Search"]</label>
            <input id="wiki-search" type="search" class="field-input" placeholder="@L["Campaign.Wiki.SearchPlaceholder"]" @bind="search" @bind:event="oninput" />
        </div>
        @if (AllTags.Count > 0)
        {
            <div class="chips" role="group" aria-label="@L["Campaign.Wiki.FilterByTag"]">
                <button type="button" class="chip" aria-pressed="@((activeTag == null) ? "true" : "false")" @onclick="() => activeTag = null">@L["Campaign.Wiki.All"]</button>
                @foreach (var tag in AllTags)
                {
                    <button type="button" class="chip" aria-pressed="@((activeTag == tag) ? "true" : "false")" @onclick="() => activeTag = tag">@tag</button>
                }
            </div>
        }
    </div>

    @if (!Filtered.Any())
    {
        <div class="empty">
            <div class="empty-icon"><LucideIcon IconName="globe" Size="28" /></div>
            <h3>@(pages.Count == 0 ? L["Campaign.Wiki.Empty.None"] : L["Campaign.Wiki.Empty.NoMatch"])</h3>
            <p>@(Ctx.IsDm ? L["Campaign.Wiki.Empty.Dm"] : L["Campaign.Wiki.Empty.Player"])</p>
        </div>
    }
    else
    {
        <div class="card-grid" data-testid="wiki-list">
            @foreach (var wp in Filtered)
            {
                <article class="campaign-card wiki-card" aria-labelledby="wiki-@wp.Id">
                    <div class="card-head">
                        <h3 id="wiki-@wp.Id" class="h6"><a href="@Ctx.BasePath/wiki/@wp.Slug">@wp.Title</a></h3>
                        <span class="pill @(wp.Visibility == WikiVisibility.Party ? "pill-success" : "pill-warning")">@(wp.Visibility == WikiVisibility.Party ? L["Campaign.Wiki.Party"] : L["Campaign.Wiki.DmOnly"])</span>
                    </div>
                    <p class="mb-0 small">@TextFormatting.Summary(wp.Body.Replace("[[", "").Replace("]]", ""), 150)</p>
                    <div class="card-foot">
                        <span class="small-muted"><LucideIcon IconName="link" Size="14" /> @L["Campaign.Wiki.LinkCount", wp.Links.Count] · <LocalTime Value="wp.UpdatedAt" Format="d MMM" /></span>
                        <div class="chips">
                            @foreach (var tag in wp.Tags.Take(3))
                            {
                                <span class="pill">@tag</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
}

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    /// <summary>A page slug, or "new".</summary>
    [Parameter] public string? Slug { get; set; }

    /// <summary>"edit" to open the editor for <see cref="Slug"/>.</summary>
    [Parameter] public string? Action { get; set; }

    private List<WikiPageDocument>? pages;
    private WikiPageDocument? current;
    private WikiPageDocument draft = new();
    private List<NoteDocument> notes = new();
    // Names the mentions in this page's notes and feeds the note box's suggestions; loaded once, on the first page viewed.
    private MentionDirectory? mentions;
    private string mentionsJson = "[]";
    private readonly Dictionary<string, string> usernames = new();
    private string search = string.Empty;
    private string? activeTag;
    private string newNote = string.Empty;
    private CommentVisibility newNoteVisibility = CommentVisibility.Private;
    private string aiInstruction = string.Empty;
    private bool expanding;
    private string? loadedKey;

    private string Mode => (Slug == "new" && Ctx.IsDm) || (Action == "edit" && Ctx.IsDm) ? "edit" : "view";
    private List<string> AllTags => (pages ?? new()).SelectMany(p => p.Tags).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).ToList();

    private IEnumerable<WikiPageDocument> Filtered => (pages ?? new())
        .Where(p => activeTag == null || p.Tags.Contains(activeTag, StringComparer.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrWhiteSpace(search) || p.Title.Contains(search, StringComparison.OrdinalIgnoreCase) || p.Body.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Ctx.Campaign.Id}|{Slug}|{Action}";
        if (key == loadedKey) return;
        loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        pages = (await WikiRepo.GetVisibleForCampaignAsync(Ctx.Access)).ToList();
        current = null;
        notes = new List<NoteDocument>();

        if (Slug == "new")
        {
            var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
            draft = new WikiPageDocument { CampaignId = Ctx.Campaign.Id, Title = query.TryGetValue("title", out var t) ? t.ToString() : string.Empty };
            return;
        }

        if (Slug != null)
        {
            current = pages.FirstOrDefault(p => string.Equals(p.Slug, Slug, StringComparison.OrdinalIgnoreCase));
            if (current != null)
            {
                draft = new WikiPageDocument
                {
                    Id = current.Id, CampaignId = current.CampaignId, Slug = current.Slug, Title = current.Title,
                    Body = current.Body, Visibility = current.Visibility, Tags = new List<string>(current.Tags), AuthorUserId = current.AuthorUserId
                };
                notes = (await NoteRepo.GetNotesForTargetAsync(NotesTarget(current), Ctx.Access)).ToList();
                if (mentions == null)
                {
                    mentions = await MentionSources.DirectoryAsync(Ctx.Campaign, Ctx.Access, Ctx.Actors);
                    mentionsJson = MentionLinks.Json(mentions, Ctx.Actors);
                }
                foreach (var authorId in notes.Select(n => n.AuthorId).Distinct())
                {
                    if (!usernames.ContainsKey(authorId))
                    {
                        usernames[authorId] = (await UserRepo.GetUserByIdAsync(authorId))?.Username ?? authorId;
                    }
                }
            }
        }
    }

    /// <summary>Renders a localized sentence in which `backtick` segments are code samples.</summary>
    private static RenderFragment Rich(string template) => builder =>
    {
        var parts = template.Split('`');
        for (var i = 0; i < parts.Length; i++)
        {
            if (parts[i].Length == 0) continue;
            if (i % 2 == 1)
            {
                builder.OpenElement(0, "code");
                builder.AddContent(1, parts[i]);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(2, parts[i]);
            }
        }
    };

    private static string NotesTarget(WikiPageDocument page) => $"wiki:{page.Id}";
    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();

    private string? ResolveLink(string title)
    {
        var slug = WikiText.Slugify(title);
        var page = pages?.FirstOrDefault(p => p.Slug == slug || string.Equals(p.Title, title, StringComparison.OrdinalIgnoreCase));
        return page == null ? null : $"{Ctx.BasePath}/wiki/{page.Slug}";
    }

    private void AppendLink(WikiPageDocument target) => draft.Body = (draft.Body.TrimEnd() + $" [[{target.Title}]]").Trim();

    private string CreateLink(string title) => $"{Ctx.BasePath}/wiki/new?title={Uri.EscapeDataString(title)}";

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(draft.Title))
        {
            Ctx.Notify(Flash.Error(L["Campaign.Wiki.TitleNeeded"]));
            return;
        }

        if (await WikiRepo.TrySaveAsync(draft, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Wiki.Saved", draft.Title]));
            loadedKey = null;
            Nav.NavigateTo($"{Ctx.BasePath}/wiki/{draft.Slug}");
        }
        else
        {
            Ctx.Notify(Flash.Error(L["Campaign.Wiki.OnlyDm"]));
        }
    }

    private async Task RevealAsync()
    {
        if (current == null) return;
        draft.Visibility = WikiVisibility.Party;
        if (await WikiRepo.TrySaveAsync(draft, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Wiki.SharedWithParty"]));
            loadedKey = null;
            await LoadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        if (current == null) return;
        if (await WikiRepo.TryDeleteAsync(current.Id, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Wiki.Deleted", current.Title]));
            loadedKey = null;
            Nav.NavigateTo($"{Ctx.BasePath}/wiki");
        }
    }

    private async Task ExpandAsync()
    {
        if (expanding) return;
        expanding = true;
        try
        {
            var related = WikiText.ExtractLinks(draft.Body).Concat((pages ?? new()).Select(p => p.Title)).Distinct(StringComparer.OrdinalIgnoreCase);
            draft.Body = await Ai.ExpandWikiAsync(Ctx.Campaign, draft.Title, draft.Body, related, aiInstruction, draft.Visibility == WikiVisibility.Party ? AiAudience.Players : AiAudience.Dm, Ctx.UserId);
            Ctx.Notify(Flash.Info(L["Campaign.Wiki.AiDraftReady"]));
        }
        catch (AiNotConfiguredException)
        {
            Ctx.Notify(Flash.Error(L["Campaign.Wiki.NoAi"]));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Wiki AI expansion failed");
            Ctx.Notify(Flash.Error(L["Campaign.Wiki.AiFailed", L.Describe(ex)]));
        }
        finally
        {
            expanding = false;
        }
    }

    private async Task AddNoteAsync()
    {
        if (current == null || string.IsNullOrWhiteSpace(newNote)) return;
        await NoteRepo.CreateNoteAsync(new NoteDocument
        {
            Id = Guid.NewGuid().ToString(),
            CampaignId = Ctx.Campaign.Id,
            TargetId = NotesTarget(current),
            AuthorId = Ctx.UserId,
            Content = (mentions ?? MentionDirectory.Empty).Encode(newNote.Trim()),
            Visibility = newNoteVisibility
        });
        newNote = string.Empty;
        Ctx.Notify(Flash.Success(L["Campaign.Wiki.NoteAdded"]));
        loadedKey = null;
        await LoadAsync();
    }

    private async Task DeleteNoteAsync(NoteDocument note)
    {
        if (note.AuthorId != Ctx.UserId && !Ctx.IsDm) return;
        await NoteRepo.DeleteNoteAsync(note.Id);
        loadedKey = null;
        await LoadAsync();
    }
}
