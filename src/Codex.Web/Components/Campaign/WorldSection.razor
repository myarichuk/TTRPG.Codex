@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject IRegionRepository RegionRepo
@inject IContentRegistry Registry
@inject AiFeatures Ai
@inject ArtService Art
@inject IJSRuntime JS

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">World</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? "Regions and the places in them. Hidden places stay yours until you reveal them." : "Places the party has discovered.")</p>
    </div>
</div>

@if (regions == null)
{
    <LoadingSkeleton />
}
else
{
    <div class="row g-3">
        <div class="@(Ctx.IsDm ? "col-lg-8" : "col-12")">
            @if (regions.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon"><LucideIcon IconName="map" Size="28" /></div>
                    <h3>@(Ctx.IsDm ? "No regions yet" : "Nothing discovered yet")</h3>
                    <p>@(Ctx.IsDm ? "Add a region, then the places inside it." : "The DM will reveal places as the party explores.")</p>
                </div>
            }
            @foreach (var region in regions)
            {
                <section class="panel" aria-labelledby="region-@region.Id">
                    <div class="panel-title"><h3 id="region-@region.Id">@region.Name</h3></div>
                    @if (region.Locations.Count == 0)
                    {
                        <p class="small-muted mb-0">No places here yet.</p>
                    }
                    <ul class="list-unstyled mb-0">
                        @foreach (var location in region.Locations)
                        {
                            var art = ArtService.Url(region, location);
                            <li class="list-row align-items-start" data-testid="location-row">
                                @if (art != null)
                                {
                                    <img class="place-thumb" src="@art" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="avatar avatar-md avatar-flat" aria-hidden="true"><LucideIcon IconName="map-pin" Size="18" /></span>
                                }
                                <div class="row-main">
                                    <div class="row-title">@location.Name
                                        @if (Ctx.IsDm && location.Visibility != ActorVisibility.Known)
                                        {
                                            <span class="pill pill-warning ms-1">Hidden</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(location.Description))
                                    {
                                        <details class="place-details">
                                            <summary class="row-sub">@TextFormatting.Summary(location.Description, 140)</summary>
                                            <div class="rules-text mt-2">@((MarkupString)TextFormatting.ToHtml(location.Description))</div>
                                        </details>
                                    }
                                    else if (Ctx.IsDm)
                                    {
                                        <div class="row-sub">No description yet.</div>
                                    }
                                </div>
                                @if (Ctx.IsDm)
                                {
                                    <div class="row-actions">
                                        @if (location.Visibility != ActorVisibility.Known)
                                        {
                                            <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => RevealAsync(region.Id, location.Id)" aria-label="@($"Reveal {location.Name} to players")"><LucideIcon IconName="eye" Size="14" /> Reveal</CodexButton>
                                        }
                                        <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="edit-3" OnClick="() => EditLocationAsync(region, location)" aria-label="@($"Edit {location.Name}")" data-testid="edit-location">Edit</CodexButton>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                    @if (Ctx.IsDm)
                    {
                        <form class="input-group input-group-sm mt-3" @onsubmit="() => AddLocationAsync(region.Id)" @onsubmit:preventDefault="true">
                            <label for="loc-@region.Id" class="visually-hidden">New place in @region.Name</label>
                            <input id="loc-@region.Id" class="field-input" placeholder="New place…" @bind="newLocationNames[region.Id]" />
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Etched">Add place</CodexButton>
                        </form>
                    }
                </section>
            }
        </div>
        @if (Ctx.IsDm)
        {
            <div class="col-lg-4">
                <section class="panel" aria-labelledby="new-region-heading">
                    <div class="panel-title"><h3 id="new-region-heading">New region</h3></div>
                    <form @onsubmit="CreateRegionAsync" @onsubmit:preventDefault="true">
                        <label for="new-region" class="field-label">Name</label>
                        <div class="input-group input-group-sm">
                            <input id="new-region" class="field-input" @bind="newRegionName" required data-testid="new-region-name" />
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="new-region-add">Add</CodexButton>
                        </div>
                    </form>
                </section>
                @if (packLocations.Count > 0)
                {
                    <section class="panel" aria-labelledby="pack-places-heading">
                        <div class="panel-title"><h3 id="pack-places-heading">Places from packs</h3></div>
                        <p class="small-muted">Setting packs for this system ship these. Add one to a region to use it.</p>
                        <label for="pack-target-region" class="field-label">Add into</label>
                        <select id="pack-target-region" class="field-select field-sm mb-2" @bind="packTargetRegionId">
                            @foreach (var region in regions)
                            {
                                <option value="@region.Id">@region.Name</option>
                            }
                        </select>
                        <ul class="list-unstyled mb-0">
                            @foreach (var location in packLocations)
                            {
                                <li class="list-row">
                                    <div class="row-main">
                                        <div class="row-title">@location.Name</div>
                                        <div class="row-sub">@location.Description</div>
                                    </div>
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => AddFromPackAsync(location)" disabled="@(regions.Count == 0)" aria-label="@($"Add {location.Name} to the selected region")">Add</CodexButton>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
    </div>
}

@if (Ctx.IsDm)
{
    <dialog id="edit-location-dialog" class="codex-dialog codex-dialog-wide" aria-labelledby="edit-location-title" @oncancel="CloseLocationAsync">
        @if (editingLocation != null && editingRegion != null)
        {
            <form @onsubmit="SaveLocationAsync" @onsubmit:preventDefault="true">
                <div class="dialog-body">
                    <h2 id="edit-location-title"><LucideIcon IconName="map-pin" Size="18" Class="title-icon" /> @(string.IsNullOrWhiteSpace(editingLocation.Name) ? "Place" : editingLocation.Name)</h2>
                    <p class="small-muted">In @editingRegion.Name · @(editingLocation.Visibility == ActorVisibility.Known ? "players can see this place" : "hidden from players until you reveal it")</p>
                    <div class="mb-3">
                        <label for="loc-edit-name" class="field-label">Name <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
                        <input id="loc-edit-name" class="field-input" @bind="editingLocation.Name" required maxlength="120" data-testid="location-name" />
                    </div>
                    <div class="mb-3">
                        <AiTextField Id="loc-edit-desc" Label="Description" Rows="6" @bind-Value="editingLocation.Description" TestId="location-description"
                                     Placeholder="What the party sees, hears and smells on arrival…" Generate="DescribeLocationAsync"
                                     Hint="Players read this once the place is revealed, so the AI writes what a visitor would notice. **bold**, *italic* and &quot;- &quot; bullets are rendered." />
                    </div>
                    <ArtSlot ImageUrl="@ArtService.Url(editingRegion, editingLocation)" CanEdit="true" Landscape="true" Label="Art" Class="art-compact" Alt="@($"Art for {editingLocation.Name}")" TestId="location-art"
                             OnPicked="img => SetLocationArtAsync(img)" OnRemove="() => SetLocationArtAsync(null)" Generate="GenerateLocationArtAsync" />
                    @if (locationError != null)
                    {
                        <p class="text-danger mb-0 mt-2" role="alert">@locationError</p>
                    }
                </div>
                <div class="dialog-actions">
                    <CodexButton Variant="CodexButtonVariant.Etched" Icon="arrow-left" OnClick="CloseLocationAsync">Back</CodexButton>
                    <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Icon="check" data-testid="location-save">Save place</CodexButton>
                </div>
            </form>
        }
    </dialog>
}

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private RegionDocument? editingRegion;
    private LocationDocument? editingLocation;
    private string? locationError;

    private List<RegionDocument>? regions;
    private List<ILocationDefinition> packLocations = new();
    private string newRegionName = string.Empty;
    private readonly Dictionary<string, string> newLocationNames = new();
    private string packTargetRegionId = string.Empty;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        regions = (await RegionRepo.GetVisibleForCampaignAsync(Ctx.Access)).OrderBy(r => r.Name).ToList();
        foreach (var region in regions)
        {
            newLocationNames.TryAdd(region.Id, string.Empty);
        }

        if (string.IsNullOrEmpty(packTargetRegionId) || regions.All(r => r.Id != packTargetRegionId))
        {
            packTargetRegionId = regions.FirstOrDefault()?.Id ?? string.Empty;
        }

        packLocations = Ctx.IsDm ? Registry.GetLocationsBySystem(Ctx.Campaign.SystemId).OrderBy(l => l.Name).ToList() : new List<ILocationDefinition>();
    }

    private async Task CreateRegionAsync()
    {
        if (string.IsNullOrWhiteSpace(newRegionName)) return;
        var region = new RegionDocument { Id = Guid.NewGuid().ToString(), CampaignId = Ctx.Campaign.Id, Name = newRegionName.Trim() };
        if (await RegionRepo.SaveAsync(region, Ctx.Access))
        {
            Ctx.Notify(Flash.Success($"Added region “{region.Name}”."));
            newRegionName = string.Empty;
            await LoadAsync();
        }
    }

    private async Task AddLocationAsync(string regionId)
    {
        var name = newLocationNames.GetValueOrDefault(regionId, string.Empty);
        if (string.IsNullOrWhiteSpace(name)) return;
        var location = new LocationDocument { Id = Guid.NewGuid().ToString(), Name = name.Trim(), Visibility = ActorVisibility.Hidden };
        if (await RegionRepo.UpsertLocationAsync(regionId, location, Ctx.Access))
        {
            newLocationNames[regionId] = string.Empty;
            Ctx.Notify(Flash.Success($"Added “{location.Name}” (hidden from players until you reveal it)."));
            await LoadAsync();
        }
    }

    private async Task AddFromPackAsync(ILocationDefinition definition)
    {
        if (string.IsNullOrEmpty(packTargetRegionId)) return;
        var location = new LocationDocument
        {
            Id = Guid.NewGuid().ToString(),
            Name = definition.Name,
            Description = definition.Description,
            Visibility = ActorVisibility.Hidden,
            Metadata = new Dictionary<string, object>(definition.Metadata) { ["blueprintId"] = $"{definition.SystemId}:{definition.Id}" }
        };
        if (await RegionRepo.UpsertLocationAsync(packTargetRegionId, location, Ctx.Access))
        {
            Ctx.Notify(Flash.Success($"Added “{location.Name}” from the pack."));
            await LoadAsync();
        }
    }

    private async Task EditLocationAsync(RegionDocument region, LocationDocument location)
    {
        editingRegion = region;
        // A copy: Back must not leave half-typed text on the list.
        editingLocation = new LocationDocument
        {
            Id = location.Id,
            Name = location.Name,
            Description = location.Description,
            Connections = location.Connections,
            Metadata = location.Metadata,
            Visibility = location.Visibility,
            HasArt = location.HasArt,
            ArtVersion = location.ArtVersion
        };
        locationError = null;
        await JS.InvokeVoidAsync("codex.showModal", "edit-location-dialog");
        await JS.InvokeVoidAsync("codex.focus", "loc-edit-name");
    }

    private async Task CloseLocationAsync()
    {
        await JS.InvokeVoidAsync("codex.closeModal", "edit-location-dialog");
        editingLocation = null;
        editingRegion = null;
    }

    private async Task SaveLocationAsync()
    {
        if (editingRegion == null || editingLocation == null) return;
        if (string.IsNullOrWhiteSpace(editingLocation.Name))
        {
            locationError = "Give the place a name.";
            return;
        }

        editingLocation.Name = editingLocation.Name.Trim();
        if (await RegionRepo.UpsertLocationAsync(editingRegion.Id, editingLocation, Ctx.Access))
        {
            Ctx.Notify(Flash.Success($"Saved “{editingLocation.Name}”."));
            await CloseLocationAsync();
            await LoadAsync();
        }
        else
        {
            locationError = "Only the DM can edit places.";
        }
    }

    private Task<string> DescribeLocationAsync(string text, string instruction)
    {
        var facts = new List<string> { $"Region: {editingRegion!.Name}" };
        var neighbours = editingRegion.Locations.Where(l => l.Id != editingLocation!.Id).Select(l => l.Name).Take(12).ToList();
        if (neighbours.Count > 0) facts.Add("Other places in the region: " + string.Join(", ", neighbours));
        return Ai.DescribeAsync(Ctx.Campaign, string.IsNullOrWhiteSpace(editingLocation!.Name) ? "an unnamed place" : editingLocation.Name, "place on the world map", facts, text, instruction, AiAudience.Players, Ctx.UserId);
    }

    private async Task SetLocationArtAsync(ArtImage? image)
    {
        if (editingRegion == null || editingLocation == null) return;
        // Art is stored at once (like a portrait); the text fields still wait for Save.
        if (await Art.SetLocationAsync(editingRegion.Id, editingLocation, Ctx.Access, image))
        {
            var listed = regions?.FirstOrDefault(r => r.Id == editingRegion.Id)?.Locations.FirstOrDefault(l => l.Id == editingLocation.Id);
            if (listed != null)
            {
                listed.HasArt = editingLocation.HasArt;
                listed.ArtVersion = editingLocation.ArtVersion;
            }

            Ctx.Notify(Flash.Success(image == null ? "Art removed." : "Art saved."));
        }
        else
        {
            locationError = "That place no longer exists, or you can't change it.";
        }
    }

    private Task<ArtImage> GenerateLocationArtAsync() =>
        Art.GenerateAsync(Ctx.UserId, editingLocation!.Name, $"place in {editingRegion!.Name}", TextFormatting.Summary(editingLocation.Description, 300), landscape: true);

    private async Task RevealAsync(string regionId, string locationId)
    {
        if (await RegionRepo.SetLocationVisibilityAsync(regionId, locationId, ActorVisibility.Known, Ctx.Access))
        {
            Ctx.Notify(Flash.Success("Revealed to the party."));
            await LoadAsync();
        }
    }
}
