@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Codex.Plugin.Abstractions
@inject IRegionRepository RegionRepo
@inject IContentRegistry Registry
@inject AiFeatures Ai
@inject ArtService Art
@inject IJSRuntime JS
@inject MentionSources MentionSources
@inject IWikiRepository WikiRepo
@inject PlaceWikiSync PlaceSync
@inject ITemplateRepository TemplateRepo
@inject NavigationManager Nav
@implements IDisposable

<div class="page-header mb-3">
    <div>
        <h2 class="mb-0">@L["Campaign.World.Title"]</h2>
        <p class="page-subtitle">@(Ctx.IsDm ? L["Campaign.World.Subtitle.Dm"] : L["Campaign.World.Subtitle.Player"])</p>
    </div>
</div>

@if (regions == null)
{
    <LoadingSkeleton />
}
else
{
    <div class="row g-3">
        <div class="@(Ctx.IsDm ? "col-lg-8" : "col-12")">
            @if (regions.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon"><LucideIcon IconName="map" Size="28" /></div>
                    <h3>@(Ctx.IsDm ? L["Campaign.World.Empty.Dm.Title"] : L["Campaign.World.Empty.Player.Title"])</h3>
                    <p>@(Ctx.IsDm ? L["Campaign.World.Empty.Dm.Body"] : L["Campaign.World.Empty.Player.Body"])</p>
                </div>
            }
            @foreach (var region in regions)
            {
                <section class="panel" aria-labelledby="region-@region.Id">
                    <div class="panel-title">
                        @if (renamingRegionId == region.Id)
                        {
                            @* The heading stays for the section's accessible name; the field takes its place on screen. *@
                            <h3 id="region-@region.Id" class="visually-hidden">@region.Name</h3>
                            <form class="d-flex flex-wrap gap-2 align-items-center" @onsubmit="() => RenameRegionAsync(region)" @onsubmit:preventDefault="true">
                                <label for="rename-@region.Id" class="visually-hidden">@L["Campaign.World.NewNameFor", region.Name]</label>
                                <input id="rename-@region.Id" class="field-input field-sm" @bind="renameText" @onkeydown="e => OnRenameKey(e)" required data-testid="rename-region-input" />
                                <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Small="true" data-testid="rename-region-save">@L["Common.Save"]</CodexButton>
                                <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="CancelRename">@L["Common.Cancel"]</CodexButton>
                            </form>
                        }
                        else
                        {
                            <h3 id="region-@region.Id">@region.Name
                                @if (region.Kind != RegionKind.General)
                                {
                                    <span class="pill ms-2" data-testid="region-kind">@L[$"Campaign.Regions.Kind.{region.Kind}"]</span>
                                }
                            </h3>
                            @if (Ctx.IsDm)
                            {
                                <div class="d-flex gap-2">
                                    <label for="region-kind-@region.Id" class="visually-hidden">@L["Campaign.Regions.KindOf", region.Name]</label>
                                    <select id="region-kind-@region.Id" class="field-select field-sm" value="@region.Kind" @onchange="e => SetRegionKindAsync(region, e.Value)" data-testid="region-kind-select">
                                        @foreach (var kind in Enum.GetValues<RegionKind>())
                                        {
                                            <option value="@kind">@L[$"Campaign.Regions.Kind.{kind}"]</option>
                                        }
                                    </select>
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" Icon="edit-3" OnClick="() => StartRename(region)" aria-label="@L["Campaign.World.RenameLabel", region.Name]" data-testid="rename-region">@L["Campaign.World.Rename"]</CodexButton>
                                    <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Class="cx-blood" Icon="trash-2" Label="@L["Campaign.World.DeleteRegionLabel", region.Name]" OnClick="() => DeleteRegionAsync(region)" data-testid="delete-region" />
                                </div>
                            }
                        }
                    </div>
                    @if (region.Locations.Count == 0)
                    {
                        <p class="small-muted mb-0">@L["Campaign.World.NoPlaces"]</p>
                    }
                    <ul class="list-unstyled mb-0">
                        @foreach (var (location, depth) in PlaceTree.Ordered(region.Locations))
                        {
                            var art = ArtService.Url(region, location);
                            <li class="list-row align-items-start place-row" id="place-@location.Id" style="--depth: @depth" data-testid="location-row" data-depth="@depth">
                                @if (art != null)
                                {
                                    <img class="place-thumb" src="@art" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="avatar avatar-md avatar-flat" aria-hidden="true"><LucideIcon IconName="map-pin" Size="18" /></span>
                                }
                                <div class="row-main">
                                    <div class="row-title">@location.Name
                                        <span class="pill ms-2" data-testid="location-kind">@L[$"Campaign.Places.Kind.{location.Kind}"]</span>
                                        @if (Ctx.IsDm && location.Visibility != ActorVisibility.Known)
                                        {
                                            <span class="pill pill-warning ms-2">@L["Campaign.World.Hidden"]</span>
                                        }
                                    </div>
                                    @if (Ctx.IsDm && location.Feature is { IsEmpty: false } feature)
                                    {
                                        <PlaceFeatureNotes Feature="feature" Creature="@CreatureOf(feature)" CreatureHref="@(CreatureOf(feature) is { } creature ? $"{Ctx.BasePath}/actors/{creature.Id}" : null)" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(location.Description))
                                    {
                                        <details class="place-details">
                                            <summary class="row-sub">@WikiRender.Summary(location.Description, wikiPages, noteMentions, 140, Ctx.IsDm)</summary>
                                            <div class="rules-text mt-2">@((MarkupString)WikiRender.ToHtml(location.Description, wikiPages, noteMentions, Ctx.Campaign.Id, false, Ctx.IsDm ? DmView.From(L, noteMentions) : null))</div>
                                        </details>
                                    }
                                    else if (Ctx.IsDm)
                                    {
                                        <div class="row-sub">@L["Campaign.World.NoDescription"]</div>
                                    }
                                    @{ var mentioned = SessionMentions.NotesMentioning(noteSessions, MentionKind.Place, location.Id, Ctx.IsDm); var written = noteWritings.Mentioning(MentionKind.Place, location.Id); var mentionCount = mentioned.Count + written.Count; }
                                    @if (PageOf(location) is { } wikiPage)
                                    {
                                        <a class="row-sub d-inline-block mt-1" href="@Ctx.BasePath/wiki/@wikiPage.Slug" aria-label="@L["Campaign.World.OpenPageLabel", location.Name]" data-testid="place-page"><LucideIcon IconName="book-open" Size="14" /> @L["Campaign.World.OpenPage"]</a>
                                    }
                                    @if (mentionCount > 0)
                                    {
                                        <details class="place-details mt-1" data-testid="place-mentions">
                                            <summary class="row-sub">@L["Campaign.World.InNotes", mentionCount]</summary>
                                            <NotesMentioning Lines="mentioned" Written="written" Mentions="noteMentions" Actors="noteActors" IsDm="Ctx.IsDm" CampaignId="@Ctx.Campaign.Id" />
                                        </details>
                                    }
                                </div>
                                @if (Ctx.IsDm)
                                {
                                    <div class="row-actions">
                                        @if (PageOf(location) == null)
                                        {
                                            <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Icon="plus" Label="@L["Campaign.World.CreatePageLabel", location.Name]" title="@L["Campaign.World.CreatePage"]" OnClick="() => CreatePageAsync(region, location)" data-testid="create-place-page" />
                                        }
                                        @if (location.Visibility != ActorVisibility.Known)
                                        {
                                            <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Icon="eye" Label="@L["Campaign.World.RevealLabel", location.Name]" title="@L["Campaign.World.Reveal"]" OnClick="() => RevealAsync(region.Id, location.Id)" />
                                        }
                                        <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Icon="edit-3" Label="@L["Campaign.World.EditLabel", location.Name]" title="@L["Campaign.World.Edit"]" OnClick="() => EditLocationAsync(region, location)" data-testid="edit-location" />
                                        <CodexButton Variant="CodexButtonVariant.Rune" Small="true" Class="cx-blood" Icon="trash-2" Label="@L["Campaign.World.DeletePlaceLabel", location.Name]" OnClick="() => DeletePlaceAsync(region, location)" data-testid="delete-location" />
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                    @if (Ctx.IsDm)
                    {
                        <form class="input-group input-group-sm mt-3" @onsubmit="() => AddLocationAsync(region.Id)" @onsubmit:preventDefault="true">
                            <label for="loc-@region.Id" class="visually-hidden">@L["Campaign.World.NewPlaceIn", region.Name]</label>
                            <input id="loc-@region.Id" class="field-input" placeholder="@L["Campaign.World.NewPlacePlaceholder"]" @bind="newLocationNames[region.Id]" />
                            @if (region.Locations.Count > 0)
                            {
                                <label for="loc-parent-@region.Id" class="visually-hidden">@L["Campaign.Places.Inside"]</label>
                                <select id="loc-parent-@region.Id" class="field-select" @bind="newLocationParents[region.Id]" data-testid="new-location-parent">
                                    <option value="">@L["Campaign.Places.InRegion", region.Name]</option>
                                    @foreach (var (spot, depth) in PlaceTree.Ordered(region.Locations))
                                    {
                                        <option value="@spot.Id">@(new string(' ', depth))@L["Campaign.Places.InPlace", spot.Name]</option>
                                    }
                                </select>
                            }
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Etched">@L["Campaign.World.AddPlace"]</CodexButton>
                        </form>
                    }
                </section>
            }
        </div>
        @if (Ctx.IsDm)
        {
            <div class="col-lg-4">
                <section class="panel" aria-labelledby="new-region-heading">
                    <div class="panel-title"><h3 id="new-region-heading">@L["Campaign.World.NewRegion"]</h3></div>
                    <form @onsubmit="CreateRegionAsync" @onsubmit:preventDefault="true">
                        <label for="new-region" class="field-label">@L["Campaign.World.Name"]</label>
                        <div class="input-group input-group-sm">
                            <input id="new-region" class="field-input" @bind="newRegionName" required data-testid="new-region-name" />
                            <label for="new-region-kind" class="visually-hidden">@L["Campaign.Regions.Kind"]</label>
                            <select id="new-region-kind" class="field-select" @bind="newRegionKind" data-testid="new-region-kind">
                                @foreach (var kind in Enum.GetValues<RegionKind>())
                                {
                                    <option value="@kind">@L[$"Campaign.Regions.Kind.{kind}"]</option>
                                }
                            </select>
                            <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="new-region-add">@L["Campaign.World.Add"]</CodexButton>
                        </div>
                    </form>
                </section>
                @if (packLocations.Count > 0)
                {
                    <section class="panel" aria-labelledby="pack-places-heading">
                        <div class="panel-title"><h3 id="pack-places-heading">@L["Campaign.World.PackPlaces"]</h3></div>
                        <p class="small-muted">@L["Campaign.World.PackPlacesHint"]</p>
                        <label for="pack-target-region" class="field-label">@L["Campaign.World.AddInto"]</label>
                        <select id="pack-target-region" class="field-select field-sm mb-2" @bind="packTargetRegionId">
                            @foreach (var region in regions)
                            {
                                <option value="@region.Id">@region.Name</option>
                            }
                        </select>
                        <ul class="list-unstyled mb-0">
                            @foreach (var location in packLocations)
                            {
                                <li class="list-row">
                                    <div class="row-main">
                                        <div class="row-title">@location.Name</div>
                                        <div class="row-sub">@location.Description</div>
                                    </div>
                                    <CodexButton Variant="CodexButtonVariant.Etched" Small="true" OnClick="() => AddFromPackAsync(location)" disabled="@(regions.Count == 0)" aria-label="@L["Campaign.World.AddToRegionLabel", location.Name]">@L["Campaign.World.Add"]</CodexButton>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
    </div>
}

@if (Ctx.IsDm)
{
    <UnsavedChangesGuard @ref="guard" IsDirty="LocationDirty" />
    <ConfirmDialog @ref="confirm" />
    <dialog id="edit-location-dialog" class="codex-dialog codex-dialog-wide" aria-labelledby="edit-location-title" @oncancel="BackFromLocationAsync">
        @if (editingLocation != null && editingRegion != null)
        {
            <form @onsubmit="SaveLocationAsync" @onsubmit:preventDefault="true">
                <div class="dialog-body">
                    <h2 id="edit-location-title"><LucideIcon IconName="map-pin" Size="18" Class="title-icon" /> @(string.IsNullOrWhiteSpace(editingLocation.Name) ? L["Campaign.World.PlaceFallback"] : editingLocation.Name)</h2>
                    <p class="small-muted">@(editingLocation.Visibility == ActorVisibility.Known ? L["Campaign.World.PlaceVisible", editingRegion.Name] : L["Campaign.World.PlaceHidden", editingRegion.Name])</p>
                    <div class="mb-3">
                        <label for="loc-edit-name" class="field-label">@L["Campaign.World.Name"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Campaign.World.Required"]</span></label>
                        <input id="loc-edit-name" class="field-input" @bind="editingLocation.Name" @bind:event="oninput" required maxlength="120" data-testid="location-name" />
                    </div>
                    <div class="field-grid mb-3">
                        <div>
                            <label for="loc-edit-parent" class="field-label">@L["Campaign.Places.Inside"]</label>
                            <select id="loc-edit-parent" class="field-select" @bind="editingParentId" data-testid="location-parent">
                                <option value="">@L["Campaign.Places.InRegion", editingRegion.Name]</option>
                                @foreach (var (spot, depth) in PlaceTree.Ordered(editingRegion.Locations))
                                {
                                    @if (PlaceTree.CanParent(editingRegion.Locations, editingLocation.Id, spot.Id))
                                    {
                                        <option value="@spot.Id">@(new string(' ', depth))@spot.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label for="loc-edit-kind" class="field-label">@L["Campaign.Places.Kind"]</label>
                            <select id="loc-edit-kind" class="field-select" @bind="editingLocation.Kind" data-testid="location-kind-select">
                                @foreach (var kind in Enum.GetValues<PlaceKind>())
                                {
                                    <option value="@kind">@L[$"Campaign.Places.Kind.{kind}"]</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (editingLocation.Kind == PlaceKind.Feature || !editingFeature.IsEmpty)
                    {
                        <fieldset class="mb-3" data-testid="feature-fields">
                            <legend class="field-label">@L["Campaign.Places.Feature.Title"]</legend>
                            <p class="small-muted">@L["Campaign.Places.Feature.Hint"]</p>
                            <div class="field-check mb-2">
                                <input id="feat-container" type="checkbox" class="field-box" @bind="editingFeature.Container" data-testid="feature-container-check" />
                                <label for="feat-container">@L["Campaign.Places.Feature.IsContainer"]</label>
                            </div>
                            <div class="field-grid mb-2">
                                <div>
                                    <label for="feat-lock" class="field-label">@L["Campaign.Places.Feature.Lock"]</label>
                                    <input id="feat-lock" class="field-input" @bind="editingFeature.Lock" @bind:event="oninput" maxlength="300" placeholder="@L["Campaign.Places.Feature.LockPlaceholder"]" data-testid="feature-lock-input" />
                                </div>
                                <div>
                                    <label for="feat-trap" class="field-label">@L["Campaign.Places.Feature.Trap"]</label>
                                    <input id="feat-trap" class="field-input" @bind="editingFeature.Trap" @bind:event="oninput" maxlength="300" placeholder="@L["Campaign.Places.Feature.TrapPlaceholder"]" data-testid="feature-trap-input" />
                                </div>
                                <div>
                                    <label for="feat-hidden" class="field-label">@L["Campaign.Places.Feature.Concealment"]</label>
                                    <input id="feat-hidden" class="field-input" @bind="editingFeature.Concealment" @bind:event="oninput" maxlength="300" placeholder="@L["Campaign.Places.Feature.ConcealmentPlaceholder"]" data-testid="feature-concealment-input" />
                                </div>
                                <div>
                                    <label for="feat-creature" class="field-label">@L["Campaign.Places.Feature.Creature"]</label>
                                    <input id="feat-creature" class="field-input" @bind="editingFeature.Creature" @bind:event="oninput" maxlength="300" placeholder="@L["Campaign.Places.Feature.CreaturePlaceholder"]" data-testid="feature-creature-input" />
                                </div>
                            </div>
                            @if (CreatureChoices.Count > 0)
                            {
                                <label for="feat-creature-actor" class="field-label">@L["Campaign.Places.Feature.CreatureOnCast"]</label>
                                <select id="feat-creature-actor" class="field-select mb-2" @bind="editingCreatureActorId" data-testid="feature-creature-actor">
                                    <option value="">@L["Campaign.Places.Feature.NoCreatureOnCast"]</option>
                                    @foreach (var actor in CreatureChoices)
                                    {
                                        <option value="@actor.Id">@actor.Name</option>
                                    }
                                </select>
                            }
                            <label for="feat-contents" class="field-label">@L["Campaign.Places.Feature.Contents"]</label>
                            <textarea id="feat-contents" class="field-input" rows="3" @bind="editingFeature.Contents" @bind:event="oninput" maxlength="4000" placeholder="@L["Campaign.Places.Feature.ContentsPlaceholder"]" data-testid="feature-contents-input"></textarea>
                        </fieldset>
                    }
                    <div class="mb-3">
                        <AiTextField Id="loc-edit-desc" Label="@L["Campaign.World.Description"]" Rows="6" @bind-Value="editingLocation.Description" TestId="location-description"
                                     Placeholder="@L["Campaign.World.DescPlaceholder"]" Generate="DescribeLocationAsync" Mentions="@mentionsJson" Pages="wikiPages" Templates="templates" TemplatesHref="@($"{Ctx.BasePath}/templates")"
                                     Preview="@(text => WikiRender.ToHtml(noteMentions.Encode(text), wikiPages, noteMentions, Ctx.Campaign.Id, false, DmView.From(L, noteMentions)))" Secrets="true"
                                     Hint="@($"{L["Campaign.World.DescHint"]} {L["Campaign.Wiki.MentionHint"]}")" />
                    </div>
                    <ArtSlot ImageUrl="@ArtService.Url(editingRegion, editingLocation)" CanEdit="true" Landscape="true" Label="@L["Campaign.World.Art"]" Class="art-compact" Alt="@L["Campaign.World.ArtFor", editingLocation.Name]" TestId="location-art"
                             OnPicked="img => SetLocationArtAsync(img)" OnRemove="() => SetLocationArtAsync(null)" Generate="GenerateLocationArtAsync" />
                    @if (locationError != null)
                    {
                        <p class="text-danger mb-0 mt-2" role="alert">@locationError</p>
                    }
                </div>
                <div class="dialog-actions">
                    <CodexButton Variant="CodexButtonVariant.Etched" Icon="arrow-left" OnClick="BackFromLocationAsync">@L["Common.Back"]</CodexButton>
                    <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" Icon="check" data-testid="location-save" data-save-shortcut="" title="@L["Common.SaveShortcut"]">@L["Campaign.World.SavePlace"]</CodexButton>
                </div>
            </form>
        }
    </dialog>
}

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    private RegionDocument? editingRegion;
    private LocationDocument? editingLocation;
    private string? locationError;
    private UnsavedChangesGuard guard = null!;
    // The place's name and description as the dialog opened (its art is stored at once, so it never counts).
    private string locationSnapshot = string.Empty;

    // The select needs a string; an empty one is "straight in the region".
    private string editingParentId = string.Empty;

    // The feature's notes, edited apart so the place's own copy stays as it was until Save.
    private PlaceFeature editingFeature = new();
    private string editingCreatureActorId = string.Empty;

    private string LocationSnapshot() => editingLocation == null ? string.Empty : string.Join('\u0001', editingLocation.Name, editingLocation.Description, editingParentId, editingLocation.Kind,
        editingFeature.Container, editingFeature.Lock, editingFeature.Trap, editingFeature.Concealment, editingFeature.Contents, editingFeature.Creature, editingCreatureActorId);

    // Who a feature may really be: anyone on the cast but the players' own characters.
    private IReadOnlyList<ActorDocument> CreatureChoices =>
        Ctx.AllActors.Where(a => a.Kind != ActorKind.PlayerCharacter && (!a.Retired || a.Id == editingCreatureActorId)).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();

    private ActorDocument? CreatureOf(PlaceFeature feature) =>
        string.IsNullOrEmpty(feature.CreatureActorId) ? null : noteActors.GetValueOrDefault(feature.CreatureActorId);

    private bool LocationDirty() => editingLocation != null && LocationSnapshot() != locationSnapshot;

    private List<RegionDocument>? regions;
    private List<ILocationDefinition> packLocations = new();
    private string newRegionName = string.Empty;
    private RegionKind newRegionKind = RegionKind.General;
    private readonly Dictionary<string, string> newLocationNames = new();
    private readonly Dictionary<string, string> newLocationParents = new();
    private string packTargetRegionId = string.Empty;

    // Session notes, to list under each place the ones that mention it.
    private IReadOnlyList<SessionDocument> noteSessions = Array.Empty<SessionDocument>();
    private MentionWritings noteWritings = MentionWritings.Empty;
    private MentionDirectory noteMentions = MentionDirectory.Empty;
    private string mentionsJson = "[]";
    private IReadOnlyCollection<WikiPageDocument> wikiPages = Array.Empty<WikiPageDocument>();
    private IReadOnlyList<TextTemplate>? templates;
    private IReadOnlyDictionary<string, ActorDocument> noteActors = new Dictionary<string, ActorDocument>();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        regions = (await RegionRepo.GetVisibleForCampaignAsync(Ctx.Access)).OrderBy(r => r.Name).ToList();
        foreach (var region in regions)
        {
            newLocationNames.TryAdd(region.Id, string.Empty);
            newLocationParents.TryAdd(region.Id, string.Empty);
        }

        if (string.IsNullOrEmpty(packTargetRegionId) || regions.All(r => r.Id != packTargetRegionId))
        {
            packTargetRegionId = regions.FirstOrDefault()?.Id ?? string.Empty;
        }

        (noteSessions, noteWritings, noteMentions) = await MentionSources.NotesAsync(Ctx.Campaign, Ctx.Access, Ctx.AllActors, forWriting: Ctx.IsDm);
        noteActors = Ctx.AllActors.ToDictionary(a => a.Id);
        mentionsJson = MentionLinks.Json(noteMentions, Ctx.AllActors);
        wikiPages = (await WikiRepo.GetVisibleForCampaignAsync(Ctx.Access)).ToList();
        templates = Ctx.IsDm ? await TemplateRepo.GetAsync(Ctx.Access, L) : null;

        packLocations = Ctx.IsDm ? Registry.GetLocationsBySystem(Ctx.Campaign.SystemId).OrderBy(l => l.Name).ToList() : new List<ILocationDefinition>();
    }

    private WikiPageDocument? PageOf(LocationDocument location) =>
        string.IsNullOrEmpty(location.WikiPageId) ? null : wikiPages.FirstOrDefault(p => p.Id == location.WikiPageId);

    /// <summary>For a place from before places had pages: writes the page the others got when they were added.</summary>
    private async Task CreatePageAsync(RegionDocument region, LocationDocument location)
    {
        var page = await PlaceSync.CreatePageAsync(region.Id, location, L["WorldBuilder.Tag.place"], Ctx.Access);
        if (page == null) return;
        Ctx.Notify(Flash.Success(L["Campaign.World.PageCreated", location.Name]));
        await LoadAsync();
    }

    private string? renamingRegionId;
    private string renameText = string.Empty;

    // The field only exists after the next render, so it is focused from OnAfterRenderAsync.
    private bool focusRename;

    private void StartRename(RegionDocument region)
    {
        renamingRegionId = region.Id;
        renameText = region.Name;
        focusRename = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) Nav.LocationChanged += OnLocationChanged;

        if (focusRename && renamingRegionId != null)
        {
            focusRename = false;
            await JS.InvokeVoidAsync("codex.focus", $"rename-{renamingRegionId}");
        }

        // A link to a place (#place-ID) opens its row once the places are drawn, which is after the browser looked for the
        // anchor (U2). A row the reader cannot see is left alone, and tried again on the next render.
        var uri = Nav.Uri;
        if (regions != null && uri != revealedFor && uri.Contains("#place-", StringComparison.Ordinal)
            && await JS.InvokeAsync<bool>("codex.revealPlace", uri[(uri.IndexOf('#') + 1)..]))
        {
            revealedFor = uri;
        }
    }

    private string? revealedFor;

    // Another place link followed while Places is open changes only the anchor: no new parameters, so render to reveal it.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void CancelRename() => renamingRegionId = null;

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelRename();
    }

    private async Task RenameRegionAsync(RegionDocument region)
    {
        var name = renameText.Trim();
        if (name.Length == 0) return;
        if (name == region.Name)
        {
            CancelRename();
            return;
        }

        if (await RegionRepo.RenameAsync(region.Id, name, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.World.Renamed", region.Name, name]));
            renamingRegionId = null;
            await LoadAsync();
        }
        else
        {
            Ctx.Notify(Flash.Error(L["Campaign.World.RenameFailed"]));
        }
    }

    private async Task CreateRegionAsync()
    {
        if (string.IsNullOrWhiteSpace(newRegionName)) return;
        var region = new RegionDocument { Id = Guid.NewGuid().ToString(), CampaignId = Ctx.Campaign.Id, Name = newRegionName.Trim(), Kind = newRegionKind };
        if (await RegionRepo.SaveAsync(region, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.World.RegionAdded", region.Name]));
            newRegionName = string.Empty;
            newRegionKind = RegionKind.General;
            await LoadAsync();
        }
    }

    private async Task AddLocationAsync(string regionId)
    {
        var name = newLocationNames.GetValueOrDefault(regionId, string.Empty);
        if (string.IsNullOrWhiteSpace(name)) return;
        var region = regions?.FirstOrDefault(r => r.Id == regionId);
        var parent = region?.Locations.FirstOrDefault(l => l.Id == newLocationParents.GetValueOrDefault(regionId));
        var location = new LocationDocument
        {
            Id = Guid.NewGuid().ToString(), Name = name.Trim(), Visibility = ActorVisibility.Hidden, ParentId = parent?.Id, Kind = PlaceTree.ChildKind(parent, region?.Kind ?? RegionKind.General)
        };
        if (await RegionRepo.UpsertLocationAsync(regionId, location, Ctx.Access))
        {
            await PlaceSync.CreatePageAsync(regionId, location, L["WorldBuilder.Tag.place"], Ctx.Access);
            newLocationNames[regionId] = string.Empty;
            Ctx.Notify(Flash.Success(L["Campaign.World.PlaceAdded", location.Name]));
            await LoadAsync();
        }
    }

    private async Task AddFromPackAsync(ILocationDefinition definition)
    {
        if (string.IsNullOrEmpty(packTargetRegionId)) return;
        // The pack's own "inside" holds when its parent was added to this region already.
        var parentBlueprint = string.IsNullOrEmpty(definition.ParentId) ? null : $"{definition.SystemId}:{definition.ParentId}";
        var target = regions?.FirstOrDefault(r => r.Id == packTargetRegionId);
        var parent = parentBlueprint == null ? null : target?.Locations
            .FirstOrDefault(l => l.Metadata.TryGetValue("blueprintId", out var id) && id?.ToString() == parentBlueprint);
        var location = new LocationDocument
        {
            Id = Guid.NewGuid().ToString(),
            Name = definition.Name,
            Description = definition.Description,
            Visibility = ActorVisibility.Hidden,
            ParentId = parent?.Id,
            Kind = PlaceTree.ChildKind(parent, target?.Kind ?? RegionKind.General),
            Metadata = new Dictionary<string, object>(definition.Metadata) { ["blueprintId"] = $"{definition.SystemId}:{definition.Id}" }
        };
        if (await RegionRepo.UpsertLocationAsync(packTargetRegionId, location, Ctx.Access))
        {
            await PlaceSync.CreatePageAsync(packTargetRegionId, location, L["WorldBuilder.Tag.place"], Ctx.Access);
            Ctx.Notify(Flash.Success(L["Campaign.World.PackPlaceAdded", location.Name]));
            await LoadAsync();
        }
    }

    private async Task EditLocationAsync(RegionDocument region, LocationDocument location)
    {
        editingRegion = region;
        // A copy: Back must not leave half-typed text on the list.
        editingLocation = new LocationDocument
        {
            Id = location.Id,
            Name = location.Name,
            // The box takes "#Name"; the place stores the mention as an id.
            Description = location.Description == null ? null : noteMentions.ForEditing(location.Description),
            WikiPageId = location.WikiPageId,
            ParentId = location.ParentId,
            Kind = location.Kind,
            Feature = location.Feature,
            Metadata = location.Metadata,
            Visibility = location.Visibility,
            HasArt = location.HasArt,
            ArtVersion = location.ArtVersion
        };
        editingParentId = location.ParentId ?? string.Empty;
        var feature = location.Feature ?? new PlaceFeature();
        editingFeature = new PlaceFeature
        {
            Container = feature.Container, Lock = feature.Lock, Trap = feature.Trap, Concealment = feature.Concealment, Contents = feature.Contents, Creature = feature.Creature
        };
        editingCreatureActorId = feature.CreatureActorId ?? string.Empty;
        locationSnapshot = LocationSnapshot();
        locationError = null;
        // Escape goes through BackFromLocationAsync, which asks before throwing edits away.
        await JS.InvokeVoidAsync("codex.guardModal", "edit-location-dialog");
        await JS.InvokeVoidAsync("codex.showModal", "edit-location-dialog");
        await JS.InvokeVoidAsync("codex.focus", "loc-edit-name");
    }

    /// <summary>Back or Escape: closes the dialog, asking first when the name or description was changed.</summary>
    private async Task BackFromLocationAsync()
    {
        if (await guard.ConfirmDiscardAsync()) await CloseLocationAsync();
    }

    private async Task CloseLocationAsync()
    {
        await JS.InvokeVoidAsync("codex.closeModal", "edit-location-dialog");
        editingLocation = null;
        editingRegion = null;
    }

    // A second Save (a double click, Ctrl+S twice) while one is still being written does nothing.
    private readonly SaveGate saveGate = new();

    private Task SaveLocationAsync() => saveGate.RunAsync(SaveLocationNowAsync);

    private async Task SaveLocationNowAsync()
    {
        if (editingRegion == null || editingLocation == null) return;
        if (string.IsNullOrWhiteSpace(editingLocation.Name))
        {
            locationError = L["Campaign.World.NameRequired"];
            return;
        }

        editingLocation.Name = editingLocation.Name.Trim();
        // The list only offers parents that make no loop; the check stays for a region another tab changed meanwhile.
        editingLocation.ParentId = PlaceTree.CanParent(editingRegion.Locations, editingLocation.Id, editingParentId) && editingParentId.Length > 0 ? editingParentId : null;
        editingFeature.CreatureActorId = editingCreatureActorId.Length > 0 ? editingCreatureActorId : null;
        editingLocation.Feature = PlaceFeature.Tidy(editingFeature);
        var typed = editingLocation.Description;
        editingLocation.Description = typed == null ? null : noteMentions.Encode(typed);
        if (await RegionRepo.UpsertLocationAsync(editingRegion.Id, editingLocation, Ctx.Access))
        {
            await PlaceSync.RenamePageAsync(editingLocation, Ctx.Access);
            Ctx.Notify(Flash.Success(L["Campaign.World.PlaceSaved", editingLocation.Name]));
            await CloseLocationAsync();
            await LoadAsync();
        }
        else
        {
            editingLocation.Description = typed;
            locationError = L["Campaign.World.OnlyDm"];
        }
    }

    private Task<string> DescribeLocationAsync(string text, string instruction, CancellationToken ct)
    {
        var facts = new List<string> { $"Region: {editingRegion!.Name}" };
        var neighbours = editingRegion.Locations.Where(l => l.Id != editingLocation!.Id).Select(l => l.Name).Take(12).ToList();
        if (neighbours.Count > 0) facts.Add("Other places in the region: " + string.Join(", ", neighbours));
        return Ai.DescribeAsync(Ctx.Campaign, string.IsNullOrWhiteSpace(editingLocation!.Name) ? "an unnamed place" : editingLocation.Name, "place on the world map", facts, text, instruction, AiAudience.Players, Ctx.UserId, ct);
    }

    private async Task SetLocationArtAsync(ArtImage? image)
    {
        if (editingRegion == null || editingLocation == null) return;
        // Art is stored at once (like a portrait); the text fields still wait for Save.
        if (await Art.SetLocationAsync(editingRegion.Id, editingLocation, Ctx.Access, image))
        {
            var listed = regions?.FirstOrDefault(r => r.Id == editingRegion.Id)?.Locations.FirstOrDefault(l => l.Id == editingLocation.Id);
            if (listed != null)
            {
                listed.HasArt = editingLocation.HasArt;
                listed.ArtVersion = editingLocation.ArtVersion;
            }

            // The art is stored already, whatever happens to the text: say so, so a later "discard changes" is not read as the art (U6).
            Ctx.Notify(Flash.Success(LocationDirty() ? L["Campaign.World.ArtStoredTextNot"] : image == null ? L["Campaign.World.ArtRemoved"] : L["Campaign.World.ArtSaved"]));
        }
        else
        {
            locationError = L["Campaign.World.PlaceGone"];
        }
    }

    private Task<ArtImage> GenerateLocationArtAsync(CancellationToken ct) =>
        Art.GenerateAsync(Ctx.UserId, editingLocation!.Name, $"place in {editingRegion!.Name}", TextFormatting.Summary(editingLocation.Description, 300), ArtShape.Wide, ct);

    // ---- Deleting (U7): a place can be undone (its art stays on the region for an hour); a region, with its places and their art, cannot. ----

    private ConfirmDialog? confirm;

    private async Task DeletePlaceAsync(RegionDocument region, LocationDocument location)
    {
        var inside = region.Locations.Count(l => l.ParentId == location.Id);
        var body = inside > 0 ? L["Campaign.World.DeletePlaceBodyInside", inside] : L["Campaign.World.DeletePlaceBody"];
        if (confirm == null || !await confirm.ShowAsync(L["Campaign.World.DeletePlaceTitle", location.Name], body, L["Common.Delete"], isDestructive: true)) return;
        if (await RegionRepo.RemoveLocationAsync(region.Id, location.Id, Ctx.Access) is not { } removed) return;
        var regionId = region.Id;
        Ctx.Notify(Flash.Undoable(L["Campaign.World.PlaceDeleted", location.Name], async () =>
        {
            if (await RegionRepo.RestoreLocationAsync(regionId, removed, Ctx.Access))
            {
                Ctx.Notify(Flash.Success(L["Common.Undone"]));
                await LoadAsync();
                StateHasChanged();
            }
            else
            {
                Ctx.Notify(Flash.Error(L["Common.UndoGone"]));
            }
        }));
        await LoadAsync();
    }

    private async Task DeleteRegionAsync(RegionDocument region)
    {
        var body = region.Locations.Count > 0 ? L["Campaign.World.DeleteRegionBodyPlaces", region.Locations.Count] : L["Campaign.World.DeleteRegionBody"];
        if (confirm == null || !await confirm.ShowAsync(L["Campaign.World.DeleteRegionTitle", region.Name], body, L["Common.Delete"], isDestructive: true)) return;
        if (await RegionRepo.DeleteAsync(region.Id, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.World.RegionDeleted", region.Name]));
            await LoadAsync();
        }
    }

    private async Task SetRegionKindAsync(RegionDocument region, object? value)
    {
        if (!Enum.TryParse<RegionKind>(value?.ToString(), out var kind) || kind == region.Kind) return;
        if (await RegionRepo.SetKindAsync(region.Id, kind, Ctx.Access))
        {
            region.Kind = kind;
        }
        else
        {
            Ctx.Notify(Flash.Error(L["Campaign.World.OnlyDm"]));
        }
    }

    private async Task RevealAsync(string regionId, string locationId)
    {
        if (await RegionRepo.SetLocationVisibilityAsync(regionId, locationId, ActorVisibility.Known, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.World.RevealedToParty"]));
            await LoadAsync();
        }
    }
}
