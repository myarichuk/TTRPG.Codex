@using Codex.Core
@using Codex.Core.AI
@using Codex.Persistence
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject IWikiRepository WikiRepo
@inject ITemplateRepository TemplateRepo
@inject AiFeatures Ai
@inject PlaceWikiSync PlaceSync
@inject ArtService Art
@inject NavigationManager Nav
@inject ILogger<WikiEditor> Logger
@inject IJSRuntime JS

@* The DM's editor for one wiki page, or a new one: its title, kind, who reads it and tags; its text, with templates and
   the AI; its picture; and, for a page about a place, where the place is. The section loads what it shows; the editor
   keeps the copy being edited, saves it, and goes to the page. *@
<ConfirmDialog @ref="confirm" />
<UnsavedChangesGuard IsDirty="IsDirty" />

<div class="page-header mb-3">
    <div>
        <nav aria-label="@L["Campaign.Wiki.Breadcrumb"]" class="breadcrumb-nav mb-1"><a href="@Ctx.BasePath/wiki">@L["Campaign.Wiki.Title"]</a>@if (current != null) { <span class="crumb-sep" aria-hidden="true">/</span><a href="@Ctx.BasePath/wiki/@current.Slug">@current.Title</a> }</nav>
        <h2 class="mb-0">@(current == null ? L["Campaign.Wiki.NewPage"] : L["Campaign.Wiki.EditPage", current.Title])</h2>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <section class="panel">
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" data-testid="wiki-editor">
                <div class="field-grid mb-3">
                    <div class="field-wide">
                        <label for="wiki-title" class="field-label">@L["Campaign.Wiki.Field.Title"] <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">@L["Campaign.Wiki.Required"]</span></label>
                        <input id="wiki-title" class="field-input field-lg" @bind="draft.Title" @bind:event="oninput" required maxlength="160" data-testid="wiki-title" />
                    </div>
                    <div>
                        <label for="wiki-kind" class="field-label">@L["Campaign.Wiki.Field.Kind"]</label>
                        <select id="wiki-kind" class="field-select" @bind="draft.Kind" data-testid="wiki-kind-select">
                            @foreach (var kind in Enum.GetValues<WikiPageKind>())
                            {
                                <option value="@kind">@KindLabel(kind)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="wiki-visibility" class="field-label">@L["Campaign.Wiki.Field.WhoCanRead"]</label>
                        <select id="wiki-visibility" class="field-select" @bind="draft.Visibility" data-testid="wiki-visibility">
                            <option value="@WikiVisibility.DmOnly">@L["Campaign.Wiki.Vis.DmOnly"]</option>
                            <option value="@WikiVisibility.Party">@L["Campaign.Wiki.Vis.Party"]</option>
                        </select>
                    </div>
                    <div>
                        <label for="wiki-tags" class="field-label">@L["Campaign.Wiki.Field.Tags"]</label>
                        <input id="wiki-tags" class="field-input" placeholder="@L["Campaign.Wiki.TagsPlaceholder"]" value="@string.Join(", ", draft.Tags)"
                               @onchange="e => draft.Tags = (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()" />
                    </div>
                </div>
                <label for="wiki-body" class="field-label">@L["Campaign.Wiki.Field.Text"]</label>
                @if (templates != null && !expanding && string.IsNullOrWhiteSpace(draft.Body) && PageTemplates.Any())
                {
                    <div class="template-start" data-testid="wiki-start-from">
                        <span class="small-muted">@L["Campaign.Wiki.StartFrom"]</span>
                        @foreach (var template in PageTemplates)
                        {
                            <button type="button" class="chip" @onclick="() => StartFromAsync(template)" data-testid="@($"wiki-start-{template.Id}")"><LucideIcon IconName="@KindIcon(template.PageKind!.Value)" Size="14" /> @template.Name</button>
                        }
                    </div>
                }
                else if (!expanding && MissingSections() is { } withSections)
                {
                    <div class="template-start">
                        <button type="button" class="chip" @onclick="() => AddSections(withSections)" data-testid="wiki-add-sections"><LucideIcon IconName="list-plus" Size="14" /> @L["Campaign.Wiki.AddSections", KindTemplate!.Name]</button>
                    </div>
                }
                <MarkdownEditor Id="wiki-body" Title="@(string.IsNullOrWhiteSpace(draft.Title) ? L["Campaign.Wiki.Field.Text"] : draft.Title)" Rows="18" Class="wiki-editor"
                                Templates="templates" Pages="linkTargets" TemplatesHref="@($"{Ctx.BasePath}/templates")"
                                @bind-Value="draft.Body" Mentions="@MentionsJson" DescribedBy="wiki-body-hint" TestId="wiki-body" Placeholder="@L["Campaign.Wiki.BodyPlaceholder"]"
                                Preview="@(text => WikiRender.ToHtml(Mentions.Encode(text), Pages ?? new(), Mentions, Ctx.Campaign.Id, false, DmView.From(L, Mentions)))" Secrets="true"
                                Busy="expanding" BusyText="@L["Campaign.Wiki.Writing"]" OnStop="aiCall.Stop">
                    <div id="wiki-body-hint" class="field-hint mb-3">@Rich(L["Campaign.Wiki.SyntaxHint"]) @L["Campaign.Wiki.MentionHint"] @Rich(L["Campaign.Wiki.SecretHint"]) @Rich(L["Campaign.Wiki.TemplateHint"])</div>
                </MarkdownEditor>
                <SaveBar Dirty="IsDirty()" TestId="wiki-save-bar">
                    <CodexButton Type="submit" Variant="CodexButtonVariant.Plaque" data-testid="wiki-save" data-save-shortcut="" title="@L["Common.SaveShortcut"]"><LucideIcon IconName="check" Size="18" /> @L["Campaign.Wiki.SavePage"]</CodexButton>
                    <CodexButton Variant="CodexButtonVariant.Etched" Class="cx-arcane" Icon="sparkles" OnClick="ExpandAsync" Busy="@expanding" data-testid="wiki-expand">@L["Campaign.Wiki.ExpandWithAi"]</CodexButton>
                    <a href="@(current == null ? $"{Ctx.BasePath}/wiki" : $"{Ctx.BasePath}/wiki/{current.Slug}")" class="cx-btn cx-etched">@L["Campaign.Wiki.Cancel"]</a>
                    @if (current != null)
                    {
                        <CodexButton Variant="CodexButtonVariant.Blood" Class="ms-auto" OnClick="DeleteAsync">@L["Campaign.Wiki.DeletePage"]</CodexButton>
                    }
                </SaveBar>
            </form>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="panel">
            <div class="panel-title"><h3 class="h6"><LucideIcon IconName="link" Size="14" Class="title-icon" /> @L["Campaign.Wiki.LinkToPage"]</h3></div>
            <p class="small-muted">@L["Campaign.Wiki.ClickToAppend"]</p>
            <div class="chips">
                @foreach (var wp in Pages.Where(p => current == null || p.Id != current.Id).Take(40))
                {
                    <button type="button" class="chip" @onclick="() => InsertLinkAsync(wp)" data-testid="wiki-link-chip">@wp.Title</button>
                }
            </div>
            @if (Pages.Count == 0)
            {
                <p class="small-muted mb-0">@Rich(L["Campaign.Wiki.NoOtherPages"])</p>
            }
        </section>
        @if (!IsPlace)
        {
            <section class="panel" aria-labelledby="wiki-art-heading">
                <div class="panel-title"><h3 id="wiki-art-heading" class="h6"><LucideIcon IconName="image" Size="14" Class="title-icon" /> @L["Campaign.Wiki.Illustration"]</h3></div>
                <ArtSlot ImageUrl="@(removeArt || current == null ? null : ArtService.Url(current))" Pending="pendingArt" CanEdit="true" Landscape="@(draft.Kind != WikiPageKind.Person)"
                         Label="@L["Campaign.Wiki.Illustration"]" Class="art-compact" Alt="@L["Campaign.Wiki.ArtAlt", draft.Title]" TestId="wiki-art"
                         OnPicked="img => { pendingArt = img; removeArt = false; }" OnRemove="() => { pendingArt = null; removeArt = current?.HasArt == true; }"
                         Generate="GeneratePageArtAsync" />
                <p class="field-hint mb-0">@L["Campaign.Wiki.IllustrationHint"]</p>
            </section>
        }
        @if (IsPlace)
        {
        <section class="panel" aria-labelledby="wiki-place-heading" data-testid="wiki-place-panel">
            <div class="panel-title"><h3 id="wiki-place-heading" class="h6"><LucideIcon IconName="map-pin" Size="14" Class="title-icon" /> @L["Campaign.Wiki.OnMap"]</h3></div>
            <p class="field-hint">@L["Campaign.Wiki.IsPlaceHint"]</p>
            @if (Linked == null)
            {
                <label for="wiki-place-region" class="field-label">@L["Campaign.Wiki.PlaceRegion"]</label>
                <select id="wiki-place-region" class="field-select field-sm mb-2" @bind="placeRegionId" @bind:after="() => placeParentId = string.Empty">
                    @foreach (var region in Regions.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@region.Id">@region.Name</option>
                    }
                    @if (Regions.Count == 0)
                    {
                        <option value="">@L["Campaign.Wiki.DefaultRegion"]</option>
                    }
                </select>
            }
            <label for="wiki-place-parent" class="field-label">@L["Campaign.Places.Inside"]</label>
            <select id="wiki-place-parent" class="field-select field-sm mb-2" @bind="placeParentId" @bind:after="() => placeKind = PlaceTree.ChildKind(PlaceRegion?.Locations.FirstOrDefault(l => l.Id == placeParentId))" data-testid="wiki-place-parent">
                <option value="">@L["Campaign.Places.InRegion", PlaceRegion?.Name ?? L["Campaign.Wiki.DefaultRegion"]]</option>
                @foreach (var (spot, depth) in PlaceTree.Ordered(PlaceRegion?.Locations ?? new List<LocationDocument>()))
                {
                    @if (Linked == null || PlaceTree.CanParent(PlaceRegion!.Locations, Linked.Value.Place.Id, spot.Id))
                    {
                        <option value="@spot.Id">@(new string(' ', depth))@spot.Name</option>
                    }
                }
            </select>
            <label for="wiki-place-kind" class="field-label">@L["Campaign.Places.Kind"]</label>
            <select id="wiki-place-kind" class="field-select field-sm mb-2" @bind="placeKind" data-testid="wiki-place-kind">
                @foreach (var kind in Enum.GetValues<PlaceKind>())
                {
                    <option value="@kind">@L[$"Campaign.Places.Kind.{kind}"]</option>
                }
            </select>
                <ArtSlot ImageUrl="@(removeArt || Linked == null ? null : ArtService.Url(Linked.Value.Region, Linked.Value.Place))" Pending="pendingArt" CanEdit="true" Landscape="true"
                         Label="@L["Campaign.Wiki.PlaceArt"]" Class="art-compact" Alt="@L["Campaign.Wiki.PlaceArtAlt", draft.Title]" TestId="wiki-place-art"
                         OnPicked="img => { pendingArt = img; removeArt = false; }" OnRemove="() => { pendingArt = null; removeArt = Linked != null; }"
                         Generate="GenerateArtAsync" />
        </section>
        }
        <section class="panel">
            <div class="panel-title"><h3 class="h6"><LucideIcon IconName="sparkles" Size="14" Class="title-icon" /> @L["Campaign.Wiki.AiInstruction"]</h3></div>
            <label for="wiki-ai-instruction" class="visually-hidden">@L["Campaign.Wiki.AiInstructionLabel"]</label>
            <textarea id="wiki-ai-instruction" class="field-input" rows="3" @bind="aiInstruction" placeholder="@L["Campaign.Wiki.AiInstructionPlaceholder"]"></textarea>
            <p class="field-hint">@L["Campaign.Wiki.AiSees"]</p>
        </section>
    </div>
</div>

@code {
    [CascadingParameter] public CampaignContext Ctx { get; set; } = null!;

    /// <summary>The page being edited, or null for a new one.</summary>
    [Parameter] public WikiPageDocument? Page { get; set; }
    /// <summary>Every page the DM sees: links, the AI's related pages, and the preview's links.</summary>
    [Parameter, EditorRequired] public List<WikiPageDocument> Pages { get; set; } = new();
    [Parameter, EditorRequired] public List<RegionDocument> Regions { get; set; } = new();
    /// <summary>The place the page is about, if it has one.</summary>
    [Parameter] public (RegionDocument Region, LocationDocument Place)? Linked { get; set; }
    [Parameter, EditorRequired] public MentionDirectory Mentions { get; set; } = MentionDirectory.Empty;
    [Parameter] public string MentionsJson { get; set; } = "[]";

    // The page the draft replaces: the one opened, or the latest stored after a Save found it changed.
    private WikiPageDocument? current;
    private WikiPageDocument draft = new();
    private ConfirmDialog confirm = null!;
    // Where the page's place goes (or is): its region, the place it is inside, and its kind. A page about a place gets one on Save.
    private bool IsPlace => draft.Kind == WikiPageKind.Place || Linked != null;
    private string placeRegionId = string.Empty;
    private string placeParentId = string.Empty;
    private PlaceKind placeKind = PlaceKind.Site;
    private RegionDocument? PlaceRegion => Linked?.Region ?? Regions.FirstOrDefault(r => r.Id == placeRegionId);
    // The picture picked in the editor, held until Save; removeArt drops the place's picture on Save.
    private ArtImage? pendingArt;
    private bool removeArt;
    // The pages the editor offers after "[[": every other page.
    private List<WikiPageDocument> linkTargets = new();
    private string aiInstruction = string.Empty;
    private bool expanding;
    private readonly AiCall aiCall = new();

    // The editor's content as loaded or last saved, to tell whether leaving would lose anything.
    private string savedDraft = string.Empty;

    private bool IsDirty() => DraftSnapshot() != savedDraft;

    private string DraftSnapshot() => string.Join('\u0001', draft.Title, draft.Body, draft.Visibility, draft.Kind, string.Join(",", draft.Tags), placeParentId, placeKind, pendingArt != null, removeArt);

    protected override async Task OnInitializedAsync()
    {
        current = Page;
        placeRegionId = Regions.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase).FirstOrDefault()?.Id ?? string.Empty;
        linkTargets = current == null ? Pages : Pages.Where(p => p.Id != current.Id).ToList();
        // "?kind=place" opens the editor ready to put the page on the map.
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var asPlace = query.TryGetValue("kind", out var askedKind) && string.Equals(askedKind, "place", StringComparison.OrdinalIgnoreCase);
        if (current == null)
        {
            draft = new WikiPageDocument { CampaignId = Ctx.Campaign.Id, Title = query.TryGetValue("title", out var t) ? t.ToString() : string.Empty, Kind = asPlace ? WikiPageKind.Place : WikiPageKind.General };
            savedDraft = DraftSnapshot();
        }
        else
        {
            // The copy saves only over the version it was made from, so a reveal or another tab's edit is not undone.
            draft = DocumentVersions.Carry(new WikiPageDocument
            {
                Id = current.Id, CampaignId = current.CampaignId, Slug = current.Slug, Title = current.Title,
                Body = Mentions.ForEditing(current.Body), Visibility = current.Visibility, Tags = new List<string>(current.Tags), AuthorUserId = current.AuthorUserId,
                PlaceId = current.PlaceId, Kind = current.Kind, ActorId = current.ActorId
            }, current);
            if (Linked is { } on)
            {
                placeParentId = on.Place.ParentId ?? string.Empty;
                placeKind = on.Place.Kind;
            }

            savedDraft = DraftSnapshot();
            if (asPlace && Linked == null) draft.Kind = WikiPageKind.Place; // after the snapshot: Leave asks before dropping it
        }

        templates = await TemplateRepo.GetAsync(Ctx.Access, L);
    }

    private static RenderFragment Rich(string text) => RichText.Code(text);
    private string KindLabel(WikiPageKind kind) => WikiPageText.KindLabel(L, kind);
    private static string KindIcon(WikiPageKind kind) => WikiPageText.KindIcon(kind);

    private Task<ArtImage> GeneratePageArtAsync(CancellationToken ct)
    {
        var (subjectKind, shape) = draft.Kind switch
        {
            WikiPageKind.Person => ("person", ArtShape.Tall),
            WikiPageKind.Faction => ("faction: its people, colours and emblem", ArtShape.Wide),
            WikiPageKind.Quest => ("scene from an adventure", ArtShape.Wide),
            _ => ("scene, object or idea from a fantasy world", ArtShape.Wide)
        };
        return Art.GenerateAsync(Ctx.UserId, draft.Title, subjectKind, TextFormatting.Summary(Mentions.Plain(draft.Body), 300), shape, ct);
    }

    private Task<ArtImage> GenerateArtAsync(CancellationToken ct) =>
        Art.GenerateAsync(Ctx.UserId, draft.Title, "place", TextFormatting.Summary(Mentions.Plain(draft.Body), 300), ArtShape.Wide, ct);

    // At the caret the box last had (a textarea keeps its selection when the chip takes focus), as typing it would; the
    // box's input event brings the text back here.
    private async Task InsertLinkAsync(WikiPageDocument target) =>
        await JS.InvokeVoidAsync("codex.mdInsert", "wiki-body", $"[[{target.Title}]]");

    // A second Save (a double click, Ctrl+S twice) while one is still being written does nothing.
    private readonly SaveGate saveGate = new();

    private Task SaveAsync() => saveGate.RunAsync(SaveNowAsync);

    private async Task SaveNowAsync()
    {
        if (string.IsNullOrWhiteSpace(draft.Title))
        {
            Ctx.Notify(Flash.Error(L["Campaign.Wiki.TitleNeeded"]));
            return;
        }

        // The box holds "@Name"; the page stores the mention as an id, so a rename or a hidden character stays right.
        var typed = draft.Body;
        draft.Body = Mentions.Encode(typed);
        var saved = await WikiRepo.TrySaveAsync(draft, Ctx.Access);
        if (saved != SaveOutcome.Saved)
        {
            draft.Body = typed;
            if (saved == SaveOutcome.Changed)
            {
                await TakeLatestVersionAsync();
                return;
            }

            Ctx.Notify(Flash.Error(L["Campaign.Wiki.OnlyDm"]));
            return;
        }

        var placeOk = await SavePlaceAsync();
        Ctx.Notify(Flash.Success(L["Campaign.Wiki.Saved", draft.Title]));
        if (!placeOk) Ctx.Notify(Flash.Error(L["Campaign.Wiki.PlaceFailed"]));
        pendingArt = null;
        removeArt = false;
        savedDraft = DraftSnapshot();
        Nav.NavigateTo($"{Ctx.BasePath}/wiki/{draft.Slug}");
    }

    /// <summary>The page was saved (or a block revealed or hidden) since the editor opened it: the editor keeps what the DM typed,
    /// takes the stored page as the one it now replaces, and says so, so a second Save is a choice made knowing it.</summary>
    private async Task TakeLatestVersionAsync()
    {
        var stored = string.IsNullOrEmpty(draft.Slug) ? null : await WikiRepo.GetVisibleBySlugAsync(draft.Slug, Ctx.Access);
        if (stored != null)
        {
            current = stored;
        }

        DocumentVersions.Carry(draft, stored ?? new object());
        Ctx.Notify(Flash.Error(L["Campaign.Wiki.ChangedMeanwhile"]));
    }

    /// <summary>After the page is stored: puts it on the map when asked, or carries its name, sharing and picture to its place.</summary>
    private async Task<bool> SavePlaceAsync()
    {
        try
        {
            if (Linked is { } on)
            {
                await PlaceSync.UpdatePlaceAsync(draft, Ctx.Access, new PlacePlacement(placeParentId, placeKind));
                if (pendingArt != null || removeArt)
                {
                    return await Art.SetLocationAsync(on.Region.Id, on.Place, Ctx.Access, removeArt ? null : pendingArt);
                }

                return true;
            }

            if (draft.Kind == WikiPageKind.Place)
            {
                // The page's own picture moves to the place, which then is the one picture both show.
                var own = current?.HasArt == true ? current : null;
                var image = pendingArt ?? (own == null ? null : await Art.WikiPageArtAsync(own));
                var made = await PlaceSync.CreatePlaceAsync(draft, placeRegionId, L["Campaign.Wiki.DefaultRegion"], image, Ctx.Access, new PlacePlacement(placeParentId, placeKind));
                if (made != null && own != null) await Art.SetWikiPageAsync(own, Ctx.Access, null);
                return made != null;
            }

            if (pendingArt != null || removeArt)
            {
                return await Art.SetWikiPageAsync(draft, Ctx.Access, removeArt ? null : pendingArt);
            }

            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Linking a wiki page and its place failed");
            return false;
        }
    }

    private async Task DeleteAsync()
    {
        if (current == null) return;
        if (!await confirm.ShowAsync(L["Campaign.Wiki.Delete.Title", current.Title], L["Campaign.Wiki.Delete.Body"], L["Campaign.Wiki.DeletePage"], isDestructive: true)) return;
        if (await WikiRepo.TryDeleteAsync(current.Id, Ctx.Access))
        {
            Ctx.Notify(Flash.Success(L["Campaign.Wiki.Deleted", current.Title]));
            // the page is gone: nothing left to lose by leaving the editor
            savedDraft = DraftSnapshot();
            Nav.NavigateTo($"{Ctx.BasePath}/wiki");
        }
    }

    // ---- Templates ----

    /// <summary>The DM's templates (see LiveTemplate); null until they are loaded.</summary>
    private IReadOnlyList<TextTemplate>? templates;

    /// <summary>The outlines a new page can start from.</summary>
    private IEnumerable<TextTemplate> PageTemplates => TemplateSet.InUse(templates ?? Array.Empty<TextTemplate>()).Where(t => t.PageKind != null);

    /// <summary>The outline of Pages of this page's kind (a page on the map is a place's).</summary>
    private TextTemplate? KindTemplate => templates == null ? null : TemplateSet.ForKind(templates, Linked != null ? WikiPageKind.Place : draft.Kind);

    // The page with the sections of its kind's outline it lacks, or null when it lacks none (or is still empty: then it starts
    // from a template instead).
    private string? MissingSections() =>
        string.IsNullOrWhiteSpace(draft.Body) || KindTemplate is not { } template ? null : LiveTemplate.AddMissingSections(draft.Body, template.Body);

    // Puts the outline in the box as a template being filled (the script steps through its fields), and makes the page that kind.
    private async Task StartFromAsync(TextTemplate template)
    {
        if (Linked == null) draft.Kind = template.PageKind!.Value;
        var index = TemplateSet.InUse(templates!).ToList().FindIndex(t => t.Id == template.Id);
        await JS.InvokeVoidAsync("codex.mdTemplate", "wiki-body", index);
    }

    private void AddSections(string body)
    {
        draft.Body = body;
        Ctx.Notify(Flash.Info(L["Campaign.Wiki.SectionsAdded"]));
    }

    private async Task ExpandAsync()
    {
        if (expanding) return;
        expanding = true;
        var ct = aiCall.Begin();
        try
        {
            var related = WikiText.ExtractLinks(draft.Body).Concat((Pages ?? new()).Select(p => p.Title)).Distinct(StringComparer.OrdinalIgnoreCase);
            // The model's text replaces the box; what was there before can be had back from the toast (U3).
            var page = draft;
            var previous = draft.Body;
            draft.Body = await Ai.ExpandWikiAsync(Ctx.Campaign, draft.Title, Linked != null ? WikiPageKind.Place : draft.Kind, draft.Body, related, SubjectContext(), aiInstruction, Ctx.UserId, ct,
                KindTemplate?.Body);
            Ctx.Notify(Flash.Undoable(L["Campaign.Wiki.AiDraftReady"], () =>
            {
                if (!ReferenceEquals(draft, page))
                {
                    Ctx.Notify(Flash.Error(L["Common.UndoGone"]));
                    return Task.CompletedTask;
                }

                draft.Body = previous;
                StateHasChanged();
                Ctx.Notify(Flash.Info(L["Common.Undone"]));
                return Task.CompletedTask;
            }));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            Ctx.Notify(Flash.Info(L["Common.Ai.Stopped"]));
        }
        catch (AiNotConfiguredException)
        {
            Ctx.Notify(Flash.Error(L["Campaign.Wiki.NoAi"]));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Wiki AI expansion failed");
            Ctx.Notify(Flash.Error(L["Campaign.Wiki.AiFailed", AiFailureText.For(L, ex)]));
        }
        finally
        {
            aiCall.End(ct);
            expanding = false;
        }
    }

    /// <summary>What the campaign says about the page's subject outside the page: the history of the character it is about and
    /// the DM's notes on them, and the description of its place and where that is. The AI writes the page to agree with it.</summary>
    private List<string> SubjectContext()
    {
        var context = new List<string>();
        if (!string.IsNullOrEmpty(draft.ActorId) && Ctx.AllActors.FirstOrDefault(a => a.Id == draft.ActorId) is { } member)
        {
            if (!string.IsNullOrWhiteSpace(member.Biography)) context.Add($"History of {member.Name} (their character in the cast): {TextFormatting.Summary(Mentions.Plain(member.Biography), 1200)}");
            if (!string.IsNullOrWhiteSpace(member.DmNotes)) context.Add($"The DM's notes on {member.Name}: {TextFormatting.Summary(Mentions.Plain(member.DmNotes), 800)}");
        }

        if (Linked is { } on)
        {
            context.Add($"Where it is: {WikiPageText.PlacePath(on)}");
            if (!string.IsNullOrWhiteSpace(on.Place.Description)) context.Add($"Description of the place on the map: {TextFormatting.Summary(Mentions.Plain(on.Place.Description), 1200)}");
            var inside = on.Region.Locations.Where(l => l.ParentId == on.Place.Id).Select(l => l.Name).ToList();
            if (inside.Count > 0) context.Add($"Places inside it: {string.Join(", ", inside)}");
        }

        return context;
    }

    public void Dispose() => aiCall.Dispose();
}
