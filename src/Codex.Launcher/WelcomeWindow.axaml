<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codex.Launcher.WelcomeWindow"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#17120c">
  <!-- All visible text is set from WelcomeWindow.axaml.cs (Localize). -->
  <StackPanel Margin="30,26" Spacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="#e3bf63" TextWrapping="Wrap" VerticalAlignment="Center" />
      <ComboBox x:Name="LanguageBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" MinWidth="120"
                SelectionChanged="OnLanguageSelected" />
    </Grid>
    <TextBlock x:Name="IntroText" Foreground="#d4c8ae" FontSize="15" TextWrapping="Wrap" LineHeight="21" />

    <Button x:Name="HostButton" Classes="plaque" HorizontalAlignment="Stretch" Padding="18,12" Click="OnHost">
      <StackPanel Spacing="3">
        <TextBlock x:Name="HostTitle" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="HostBody" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Button>

    <Button Classes="etched" HorizontalAlignment="Stretch" Padding="18,12" Click="OnSolo">
      <StackPanel Spacing="3">
        <TextBlock x:Name="SoloTitle" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="SoloBody" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" TextAlignment="Center" Foreground="#cbbfa5" />
      </StackPanel>
    </Button>

    <TextBlock x:Name="FooterText" Foreground="#9d9078" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
  </StackPanel>
</Window>
