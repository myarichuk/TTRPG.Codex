<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codex.Launcher.CheckWindow"
        Width="540" Height="640"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#17120c">
  <!-- All visible text is set from CheckWindow.axaml.cs (Localize). -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22,26,8" Spacing="12">
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="#e3bf63" TextWrapping="Wrap" />
        <TextBlock x:Name="Summary" Foreground="#d4c8ae" FontSize="14" TextWrapping="Wrap" />
        <StackPanel x:Name="Results" Spacing="12" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="#EC17120c" BorderBrush="#9a7c36" BorderThickness="0,1,0,0" Padding="22,12">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="AgainButton" Classes="etched" Click="OnAgain" />
        <Button x:Name="DoneButton" Classes="plaque" MinWidth="100" Click="OnClose" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
