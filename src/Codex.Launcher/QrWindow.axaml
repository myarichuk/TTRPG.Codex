<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codex.Launcher.QrWindow"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#17120c">
  <!-- All visible text is set from QrWindow.axaml.cs (Localize). The code itself is pinned left-to-right: a mirrored QR code cannot be scanned. -->
  <Grid RowDefinitions="Auto,Auto">
    <StackPanel Grid.Row="0" Margin="26,22,26,12" Spacing="10" HorizontalAlignment="Center">
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Foreground="#e3bf63" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
      <TextBlock x:Name="Instruction" Foreground="#d4c8ae" FontSize="14"
                 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" />
      <Border BorderBrush="#9a7c36" BorderThickness="2" CornerRadius="4" Padding="6" Background="#f3e9d2" HorizontalAlignment="Center" FlowDirection="LeftToRight">
        <Image x:Name="Code" Width="280" Height="280" RenderOptions.BitmapInterpolationMode="None" />
      </Border>
      <SelectableTextBlock x:Name="UrlText" Foreground="#ffe9ae" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
      <TextBlock x:Name="SameWifi" Foreground="#b3a78d" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
    </StackPanel>
    <Border Grid.Row="1" Background="#EC17120c" BorderBrush="#9a7c36" BorderThickness="0,1,0,0" Padding="22,12">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CopyButton" Classes="etched" Click="OnCopy" />
        <Button x:Name="DoneButton" Classes="plaque" MinWidth="100" Click="OnClose" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
