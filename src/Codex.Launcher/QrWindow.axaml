<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codex.Launcher.QrWindow"
        Title="Scan to join"
        Width="400" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#17120c">
  <Grid RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Margin="26,22,26,8" Spacing="10" HorizontalAlignment="Center">
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Foreground="#e3bf63" HorizontalAlignment="Center" />
      <TextBlock Text="Point your phone's camera at this. It opens the table in the browser." Foreground="#d4c8ae" FontSize="14"
                 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
      <Border BorderBrush="#9a7c36" BorderThickness="2" CornerRadius="4" Padding="6" Background="#f3e9d2" HorizontalAlignment="Center">
        <Image x:Name="Code" Width="280" Height="280" RenderOptions.BitmapInterpolationMode="None" />
      </Border>
      <SelectableTextBlock x:Name="UrlText" Foreground="#ffe9ae" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
      <TextBlock Text="Phones must be on the same Wi-Fi as this computer." Foreground="#b3a78d" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
    </StackPanel>
    <Border Grid.Row="1" Background="#EC17120c" BorderBrush="#9a7c36" BorderThickness="0,1,0,0" Padding="22,12">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CopyButton" Classes="etched" Content="Copy link" Click="OnCopy" />
        <Button Classes="plaque" Content="Done" MinWidth="100" Click="OnClose" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
