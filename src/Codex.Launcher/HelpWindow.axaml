<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codex.Launcher.HelpWindow"
        Width="540" Height="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#17120c">
  <!-- The help text is built in HelpWindow.axaml.cs: it names the launcher's buttons using the same strings as the buttons. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Body" Margin="26,22,26,8" Spacing="10" />
    </ScrollViewer>
    <Border Grid.Row="1" Background="#EC17120c" BorderBrush="#9a7c36" BorderThickness="0,1,0,0" Padding="22,12">
      <Button x:Name="CloseButton" Classes="plaque" HorizontalAlignment="Right" MinWidth="110" Click="OnClose" />
    </Border>
  </Grid>
  <Window.Styles>
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#f3e9d2" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#d4c8ae" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#e3bf63" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>
</Window>
