<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Codex.ContentImport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\srd521-class-tables.json" LogicalName="srd521-class-tables.json" />
    <EmbeddedResource Include="Data\srd521-grants.yaml" LogicalName="srd521-grants.yaml" />
    <EmbeddedResource Include="Data\srd521-invocations.yaml" LogicalName="srd521-invocations.yaml" />
    <EmbeddedResource Include="Data\srd521-traps.yaml" LogicalName="srd521-traps.yaml" />
    <EmbeddedResource Include="Data\degrees-books.yaml" LogicalName="degrees-books.yaml" />
    <EmbeddedResource Include="Data\degrees-fonts.yaml" LogicalName="degrees-fonts.yaml" />
    <EmbeddedResource Include="Data\degrees-chapters.yaml" LogicalName="degrees-chapters.yaml" />
    <EmbeddedResource Include="Data\degrees-redactions.yaml" LogicalName="degrees-redactions.yaml" />
    <EmbeddedResource Include="Data\degrees-denylist.sha256" LogicalName="degrees-denylist.sha256" />
    <EmbeddedResource Include="Data\degrees-allowlist.txt" LogicalName="degrees-allowlist.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Codex.Core\Codex.Core.csproj" />
    <ProjectReference Include="..\..\src\Codex.Plugin.Abstractions\Codex.Plugin.Abstractions.csproj" />
  </ItemGroup>

</Project>
