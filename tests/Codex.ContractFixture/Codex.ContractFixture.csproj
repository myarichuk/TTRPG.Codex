<Project Sdk="Microsoft.NET.Sdk">

  <!-- The compiled supplier of the supplier contract fixture (tests/Codex.Tests/Fixtures/contract): the same functions, handler
       and widget the fixture's system.yaml also writes as formulas and rules.js writes as scripts. It is what a system author
       builds: a class library that references Codex.Plugin.Abstractions only, and is copied beside system.yaml. The tests copy
       its DLL into a temporary copy of the fixture's folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host's own copy is used at run time; a system's folder holds only its own DLLs. -->
    <ProjectReference Include="..\..\src\Codex.Plugin.Abstractions\Codex.Plugin.Abstractions.csproj" Private="false" />
  </ItemGroup>

</Project>
