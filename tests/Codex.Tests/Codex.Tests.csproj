<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.15.2" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Testcontainers.Ollama" Version="4.11.0" />
    <!-- B19: pin above the SSH.NET version Testcontainers pulls in transitively (known CVE). -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Codex.Core\Codex.Core.csproj" />
    <ProjectReference Include="..\..\src\Codex.Persistence\Codex.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Codex.Plugin.Abstractions\Codex.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Codex.Localization\Codex.Localization.csproj" />
    <ProjectReference Include="..\..\src\Codex.Launcher\Codex.Launcher.csproj" />
    <ProjectReference Include="..\..\src\Codex.Web\Codex.Web.csproj" />
    <ProjectReference Include="..\..\tools\Codex.ContentImport\Codex.ContentImport.csproj" />
    <ProjectReference Include="..\..\tools\Codex.TranslationCheck\Codex.TranslationCheck.csproj" />
    <ProjectReference Include="..\..\tools\Codex.SystemCheck\Codex.SystemCheck.csproj" />
    <!-- Built, not referenced: SupplierContractTests copies its DLL beside the contract fixture's system.yaml, as an author would. -->
    <ProjectReference Include="..\Codex.ContractFixture\Codex.ContractFixture.csproj" ReferenceOutputAssembly="false" OutputItemType="ContractFixtureAssembly" />
  </ItemGroup>

  <Target Name="CopyContractFixture" AfterTargets="Build">
    <Copy SourceFiles="@(ContractFixtureAssembly)" DestinationFolder="$(OutDir)contract-fixture" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Cases both template parsers (LiveTemplate.cs and app-startup.js) are run against. -->
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>